#. en: <$comeff(1,10)><$facial(1,1)><$motion(1,805)><$voicel(1,6)>This town has really gotten brighter thanks to you and<br>your friends, <$cdef(27)><pname;0></color>!
msgctxt "2661:15"
msgid "<$comeff(1,10)><$facial(1,1)><$motion(1,805)><$voicel(1,6)>¡Muy buen trabajo, <$cdef(27)><pname;0></color> y compañía!<br>El vecindario está ahora mucho mejor iluminado."
msgstr ""

#. en: <$comeff(1,7)><$facial(1,9)><$motion(1,663)><$voicel(1,3)>But we’re still not seeing a fully bloomed flower field on<br><$cdef(27)>Snorlax</color>’s head.<clear><br><$comeff(1,6)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>It seems like we’re almost there, but... What else can we<br>possibly do?
msgctxt "2661:16"
msgid "<$comeff(1,7)><$facial(1,9)><$motion(1,663)><$voicel(1,3)>Y, sin embargo, la cabeza de <$cdef(27)>Snorlax</color> aún dista mucho de<br>ser un lecho de flores...<clear><br><$facial(1,1)><$motion(1,666)><$voicel(1,5)>Aunque parece que la cosa avanza... <$comeff(1,6)>¿Qué más podríamos<br>hacer?"
msgstr ""

#. en: <$comeff(1,14)><$facial(1,1)><$motion(1,807)><$voicel(1,4)>Hmmm... I’m not certain we could make it much brighter<br>if we tried.
msgctxt "2661:17"
msgid "<$comeff(1,14)><$facial(1,1)><$motion(1,807)><$voicel(1,4)>Hm... No, yo creo que ya es suficiente. Incrementar<br>la luminosidad aún más no parece una opción."
msgstr ""

#. en: <$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,2)>Urk! That seems a little harsh...
msgctxt "2661:18"
msgid "<$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,2)>Oh, ¡pero qué ocurrencias! ¡Pobrecillo!"
msgstr "<$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,2)>Oh, ¡pero qué ocurrencias! ¡Pobrecito!"

#. en: <$comeff(2,3)><$facial(2,1)><$motion(2,661)><$voicel(2,6)>Pardon me, if I may?
msgctxt "2661:19"
msgid "<$comeff(2,3)><$facial(2,1)><$motion(2,661)><$voicel(2,6)>Esto... Si me permitís..."
msgstr "<$comeff(2,3)><$facial(2,1)><$motion(2,661)><$voicel(2,6)>Esto... Si me permiten..."

#. en: <$comeff(2,14)><$facial(2,1)><$motion(2,805)><$voicel(2,8)>While I was out and about in town, I stumbled upon quite<br>an intriguing device.
msgctxt "2661:20"
msgid "<$comeff(2,14)><$facial(2,1)><$motion(2,805)><$voicel(2,8)>He estado investigando las inmediaciones y he dado con<br>un dispositivo que me ha llamado mucho la atención."
msgstr "<$comeff(2,14)><$facial(2,1)><$motion(2,805)><$voicel(2,8)>Estuve investigando las inmediaciones y di con<br>un dispositivo que me llamó mucho la atención."

#. en: <$comeff(2,3)><$facial(2,1)><$motion(2,666)><$voicel(2,5)>Now, if this device does what I THINK it does...<clear><br><$comeff(2,21)><$facial(2,4)><$motion(2,661)><$voicel(2,7)>It may be just what we need to finally wake <$cdef(27)>Snorlax</color>!
msgctxt "2661:21"
msgid "<$comeff(2,3)><$facial(2,1)><$motion(2,666)><$voicel(2,5)>Si es justo lo que yo pienso que es...<clear><br><$comeff(2,21)><$facial(2,4)><$motion(2,661)><$voicel(2,7)>Es posible que nos ayude a darle el último empujoncillo<br>a <$cdef(27)>Snorlax</color>."
msgstr "<$comeff(2,3)><$facial(2,1)><$motion(2,666)><$voicel(2,5)>Si es justo lo que yo pienso que es...<clear><br><$comeff(2,21)><$facial(2,4)><$motion(2,661)><$voicel(2,7)>Es posible que nos ayude a darle el último empujoncito<br>a <$cdef(27)>Snorlax</color>."

#. en: <$comeff(1,5)><$facial(1,1)><$motion(1,805)><$voicel(1,7)>Oho! Now that IS intriguing! Where is this device?
msgctxt "2661:22"
msgid "<$comeff(1,5)><$facial(1,1)><$motion(1,805)><$voicel(1,7)>¡Jo, jo! En ese caso, ¡tienes toda mi atención, jovencita!<br>Dinos, ¿dónde se encuentra el susodicho dispositivo?"
msgstr ""

#. en: <$comeff(2,3)><$facial(2,1)><$motion(2,805)><$voicel(2,7)>It’s right this way. Please, follow me!
msgctxt "2661:23"
msgid "<$comeff(2,3)><$facial(2,1)><$motion(2,805)><$voicel(2,7)>Un poco más allá. Venid conmigo."
msgstr "<$comeff(2,3)><$facial(2,1)><$motion(2,805)><$voicel(2,7)>Un poco más allá. Vengan conmigo."

#. en: <$comeff(2,3)><$facial(2,1)><$motion(2,661)><$voicel(2,6)>Yes, this device may be just what we need...
msgctxt "2661:32"
msgid "<$comeff(2,3)><$facial(2,1)><$motion(2,661)><$voicel(2,6)>Estoy convencid<gen;-3(o,a)> de que funcionará..."
msgstr ""

#. en: <$comeff(2,5)><$facial(2,1)><$motion(2,664)><$voicel(2,8)>It’s this way. Please, follow me!
msgctxt "2661:33"
msgid "<$comeff(2,5)><$facial(2,1)><$motion(2,664)><$voicel(2,8)>Es por aquí. Seguidme."
msgstr "<$comeff(2,5)><$facial(2,1)><$motion(2,664)><$voicel(2,8)>Es por aquí. Síganme."

#. en: <$comeff(1,5)><$facial(1,1)><$motion(1,805)><$voicel(1,8)>Follow <$cdef(27)>Peakychu</color>!
msgctxt "2661:39"
msgid "<$comeff(1,5)><$facial(1,1)><$motion(1,805)><$voicel(1,8)>¡Sigamos a <$cdef(27)>Palidachu</color>!"
msgstr ""

#. en: <$comeff(2,3)><$facial(2,1)><$motion(2,661)><$voicel(2,6)>And here we are—the device in question!
msgctxt "2661:46"
msgid "<$comeff(2,3)><$facial(2,1)><$motion(2,661)><$voicel(2,6)>Este es el dispositivo del que hablaba."
msgstr ""

#. en: <$facial(1,1)><$voicel(1,6)>Fascinating... How exactly does one use it?
msgctxt "2661:47"
msgid "<$facial(1,1)><$voicel(1,6)>¡Jo, jo! Extraordinario... ¿Y cómo se usa?"
msgstr ""

#. en: <$facial(2,1)><$voicel(2,6)>If my theory is correct, we must first connect this machine<br>to <$voicel(2,8)>an electrical current.
msgctxt "2661:48"
msgid "<$facial(2,1)><$voicel(2,6)>Si es como me imagino, lo primero que hay que hacer...<br><$voicel(2,8)>es suministrarle una gran cantidad de energía eléctrica."
msgstr ""

#. en: <$voicel(2,7)>Look here—this shape indicates it should be able<br>to store electricity.
msgctxt "2661:49"
msgid "<$voicel(2,7)>Si os fijáis, esto de aquí tiene aspecto de ser la entrada<br>de suministro eléctrico."
msgstr "<$voicel(2,7)>Si se fijan, esto de aquí tiene aspecto de ser la entrada<br>de suministro eléctrico."

#. en: <$voicel(1,5)><$comeff(1,3)><$facial(1,4)>I see. So first we run electricity into this device, correct?<clear><br><$voicel(1,8)><$facial(1,1)><$lookat(1,0,0)><$lookat(2,0,0)>Do you know how to do that, <$cdef(27)><pname;0></color>?
msgctxt "2661:50"
msgid "<$voicel(1,5)><$comeff(1,3)><$facial(1,4)>Hmm... Ya veo. Así que primero debemos suministrarle<br>electricidad.<clear><br><$voicel(1,8)><$facial(1,1)><$lookat(1,0,0)><$lookat(2,0,0)>¿Se te ocurre cómo, <$cdef(27)><pname;0></color>?"
msgstr ""

#. en: <$lookat(2,0,0)><$comeff(2,21)><$facial(2,4)><$motion(2,661)><$voicel(2,6)>Exactly right! This machine requires a large amount of<br>electricity, you see.<clear><br><$comeff(2,14)><$facial(2,1)><$motion(2,807)><$voicel(2,3)>Instead of relying on a Pokémon for just a temporary<br>charge, <wait(0.8)><$comeff(2,3)><$facial(2,1)><$motion(2,664)><$voicel(2,7)>I would like you to use <$cdef(27)><fqty(2)><$ifull(1396)> </color>to<slide><br>connect this to a <$cdef(27)>generator</color>.
msgctxt "2661:51"
msgid "<$lookat(2,0,0)><$comeff(2,21)><$facial(2,4)><$motion(2,661)><$voicel(2,6)>Efectivamente, esa es la única forma... Este dispositivo<br>necesita unas cantidades ingentes de energía.<clear><br><$comeff(2,14)><$facial(2,1)><$motion(2,807)><$voicel(2,3)>Para que funcione, en esta ocasión no bastará con pedirle<br>ayuda a un Pokémon...<clear><br><$comeff(2,3)><$facial(2,1)><$motion(2,664)><$voicel(2,7)>Debes conectar <$cdef(27)><fqty(2)><class><$ifull(1396)> </color>para traer la energía<br>producida por un <$cdef(27)>generador</color> hasta aquí."
msgstr ""

#. en: <$lookat(2,0,0)><$comeff(2,3)><$facial(2,9)><$motion(2,663)><$voicel(2,6)>Errr, not quite. This device requires a great deal of<br>electricity, you see.<clear><br><$comeff(2,14)><$facial(2,1)><$motion(2,807)><$voicel(2,3)>Instead of relying on a Pokémon for just a temporary<br>charge, <$comeff(2,21)><$facial(2,1)><$motion(2,664)><$voicel(2,7)>I would like you to use <$cdef(27)><fqty(2)><$ifull(1396)> </color>to<slide><br>connect this to <$cdef(27)>generators</color>.
msgctxt "2661:52"
msgid "<$lookat(2,0,0)><$comeff(2,3)><$facial(2,9)><$motion(2,663)><$voicel(2,6)>No, me temo que con eso no bastaría... Este dispositivo<br>necesita unas cantidades ingentes de energía.<clear><br><$comeff(2,14)><$facial(2,1)><$motion(2,807)><$voicel(2,3)>Para que funcione, no bastará con que un Pokémon nos<br>brinde su ayuda, aunque se me ocurre otra solución...<clear><br><$comeff(2,21)><$facial(2,1)><$motion(2,664)><$voicel(2,7)>Debes conectar <$cdef(27)><fqty(2)><class><$ifull(1396)> </color>para traer la energía<br>producida por un <$cdef(27)>generador</color> hasta aquí."
msgstr ""

#. en: <$lookat(1,0,0)><$comeff(1,10)><$facial(1,4)><$motion(1,666)><$voicel(1,9)>Understood. Thanks for explaining so clearly!
msgctxt "2661:53"
msgid "<$lookat(1,0,0)><$comeff(1,10)><$facial(1,4)><$motion(1,666)><$voicel(1,9)>Oh, entiendo..."
msgstr ""

#. en: <oneline><$comeff(1,3)><$facial(1,1)><$motion(1,806)><$voicel(1,6)>Right then, <$cdef(27)><pname;0></color>. It sounds like<br><$cdef(27)>Peakychu</color>’s<slide><br>got<slide><br>a<slide><br>plan<slide><br>of sorts.<clear><br><$comeff(1,3)><$motion(1,661)><$voicel(1,8)>So, do you think you could set up some <$cdef(27)><fqty(2)><$ifull(1396)></color> <$comeff(1,6)><$motion(1,664)><$voicel(1,9)>to<br>carry a lot of electricity from the <$cdef(27)>generators </color>to this device?
msgctxt "2661:54"
msgid "<oneline><$comeff(1,3)><$facial(1,1)><$motion(1,806)><$voicel(1,6)>Hagamos caso a nuestra amiga <$cdef(27)>Palidachu</color>,<br><$cdef(27)><pname;0></color>.<clear><br><$comeff(1,6)><$motion(1,661)><$voicel(1,8)>¿Puedes crear un tendido de <$cdef(27)><fqty(2)><class><$ifull(1396)> </color>para<br>conectar <$cdef(27)>generadores </color>a esta máquina y así suministrarle<slide><br><$comeff(1,3)><$motion(1,664)><$voicel(1,9)>toda la energía que necesita?"
msgstr ""

#. en: <$lookat(2,0,0)><$comeff(2,3)><$facial(2,1)><$motion(2,661)><$voicel(2,8)>I’m sorry to trouble you so, but we’re relying on your<br>help, <$cdef(27)><pname;0></color>!
msgctxt "2661:55"
msgid "<oneline><$lookat(2,0,0)><$comeff(2,3)><$facial(2,1)><$motion(2,661)><$voicel(2,8)>Podemos contar contigo, ¿verdad,<br><$cdef(27)><pname;0></color>?"
msgstr ""

#. en: <$comeff(2,5)><$facial(2,1)><$motion(2,661)><$voicel(2,6)>I would like you to send lots of electricity from the<br><$cdef(27)>generators </color>to this device!
msgctxt "2661:65"
msgid "<$comeff(2,5)><$facial(2,1)><$motion(2,661)><$voicel(2,6)>Debes conectar el dispositivo a un <$cdef(27)>generador </color>para que<br>reciba toda la energía eléctrica que necesita."
msgstr ""

#. en: <$comeff(2,3)><$facial(2,1)><$motion(2,666)><$voicel(2,8)>In order to do that, you’ll need to use <$cdef(27)><fqty(2)><$ifull(1396)> </color>to<br>connect this device to the <$cdef(27)>generators</color>.
msgctxt "2661:66"
msgid "<$comeff(2,3)><$facial(2,1)><$motion(2,666)><$voicel(2,8)>Para ello, tienes que colocar varios <$cdef(27)><fqty(2)><class><$ifull(1396)><br></color>seguidos desde el <$cdef(27)>generador </color>hasta aquí."
msgstr ""

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,8)>Oho! It lit up! What do you think, <$cdef(27)>Peakychu</color>? <$lookat(1,0,2)><$comeff(1,6)><$facial(1,1)><$motion(1,666)><$voicel(1,6)>Think this<br>device is usable now?
msgctxt "2661:73"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,8)>¡Se ha encendido!<clear><br><$lookat(1,0,2)><$comeff(1,6)><$facial(1,1)><$motion(1,666)><$voicel(1,6)>¿Crees que con esto bastará para que funcione,<br><$cdef(27)>Palidachu</color>?"
msgstr "<$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,8)>¡Se encendió!<clear><br><$lookat(1,0,2)><$comeff(1,6)><$facial(1,1)><$motion(1,666)><$voicel(1,6)>¿Crees que con esto bastará para que funcione,<br><$cdef(27)>Palidachu</color>?"

#. en: <$comeff(2,5)><$facial(2,1)><$motion(2,664)><$voicel(2,8)>Let us test it out right away!
msgctxt "2661:74"
msgid "<$comeff(2,5)><$facial(2,1)><$motion(2,664)><$voicel(2,8)>Comprobémoslo."
msgstr ""

#. en: <$comeff(2,14)><$facial(2,9)><$voicel(2,3)>... ... ...
msgctxt "2661:81"
msgid "<$comeff(2,14)><$facial(2,9)><$voicel(2,3)>..."
msgstr ""

#. en: <$comeff(1,6)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>Well? Is it working?
msgctxt "2661:82"
msgid "<$comeff(1,6)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>¿Y bien? ¿Ha funcionado?"
msgstr "<$comeff(1,6)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>¿Y bien? ¿Funcionó?"

#. en: <$comeff(2,7)><$facial(2,9)><$motion(2,667)><$voicel(2,1)>My apologies. It appears we still need more electricity...
msgctxt "2661:83"
msgid "<$comeff(2,7)><$facial(2,9)><$motion(2,667)><$voicel(2,1)>No... Me temo que no tiene suficiente energía."
msgstr ""

#. en: <$comeff(1,14)><$facial(1,1)><$motion(1,807)><$voicel(1,4)>Is that so...
msgctxt "2661:84"
msgid "<$comeff(1,14)><$facial(1,1)><$motion(1,807)><$voicel(1,4)>Oh, lianas..."
msgstr ""

#. en: <$comcan(1)><$comeff(2,3)><$facial(2,1)><$motion(2,661)><$voicel(2,6)>It appears we’ll need to increase the volume of<br>electricity by using more <$cdef(27)>generators</color>...
msgctxt "2661:85"
msgid "<$comcan(1)><$comeff(2,3)><$facial(2,1)><$motion(2,661)><$voicel(2,6)>Hmm... Me parece que va a hacer falta conectarlo a más<br><$cdef(27)>generadores</color> para suministrarle la corriente que necesita."
msgstr ""

#. en: <oneline><$lookat(2,0,0)><$comeff(2,4)><$facial(2,1)><$motion(2,807)><$voicel(2,4)>I am so sorry to ask for your help again and again,<br><$cdef(27)><pname;0></color>...<clear><br><$comeff(2,6)><$facial(2,1)><$motion(2,661)><$voicel(2,6)>But could I ask you to connect even more <$cdef(27)>generators </color>to<br>this device?
msgctxt "2661:86"
msgid "<oneline><$lookat(2,0,0)><$comeff(2,4)><$facial(2,1)><$motion(2,807)><$voicel(2,4)>Ya lo siento, <$cdef(27)><pname;0></color>, pero tenemos que<br>valernos de<slide><br>tu ayuda nuevamente...<clear><br><$comeff(2,6)><$facial(2,1)><$motion(2,661)><$voicel(2,6)>¿Podrías hacer lo mismo con otros <$cdef(27)>generadores</color>? Vamos<br>a necesitar toda la electricidad que podamos conseguir..."
msgstr "<oneline><$lookat(2,0,0)><$comeff(2,4)><$facial(2,1)><$motion(2,807)><$voicel(2,4)>Lo siento, <$cdef(27)><pname;0></color>, pero tenemos que<br>valernos de<slide><br>tu ayuda nuevamente...<clear><br><$comeff(2,6)><$facial(2,1)><$motion(2,661)><$voicel(2,6)>¿Podrías hacer lo mismo con otros <$cdef(27)>generadores</color>? Vamos<br>a necesitar toda la electricidad que podamos conseguir..."

#. en: There are a few different <$cdef(27)>generators </color>in this town.<clear><br>If one doesn’t produce enough electricity, try to find a<br>second <$cdef(27)>generator</color>—or even a third—and connect their<slide><br>electrical currents to this machine.
msgctxt "2661:87"
msgid "Este vecindario cuenta con varios <$cdef(27)>generadores</color>.<clear><br>Parece que uno solo no es capaz de suministrar toda la<br>energía necesaria para la máquina, de modo que tendrás<slide><br>que conectarla a unos cuantos <$cdef(27)>generadores </color>más."
msgstr ""

#. en: You can also buy <$cdef(27)>building kits</color> at the <$cdef(27)>PC </color>and use them to<br>build <$cdef(27)>generators </color>anywhere you please!
msgctxt "2661:88"
msgid "¡Otra opción es comprar <$cdef(27)>kits de construcción </color>en la tienda<br>del <$cdef(27)>PC </color>y construir tus propios <$cdef(27)>generadores </color>en el lugar que<slide><br>te resulte más práctico!"
msgstr ""

#. en: <$comeff(1,5)><$facial(1,1)><$motion(1,665)><$voicel(1,8)>Wh-what was that?! I just heard a zap—was that you?
msgctxt "2661:97"
msgid "<$comeff(1,5)><$facial(1,1)><$motion(1,665)><$voicel(1,8)>¡¿E-estás bien?! ¡Estás chisporroteando de lo lindo!"
msgstr ""

#. en: <oneline><$comeff(2,17)><$facial(2,1)><$motion(2,807)><$voicel(2,6)>Phew!<clear><br><$comeff(2,3)><$facial(2,4)><$motion(2,661)><$voicel(2,8)>Thanks to <$cdef(27)><pname;0></color>, it seems this device<br>was<slide><br>already<slide><br><$comeff(2,9)><$motion(2,806)><$voicel(2,9)>linked<slide><br>to<slide><br>a<slide><br>sufficient<slide><br>electrical<slide><br>current!<clear><br><$comeff(2,10)><$facial(2,1)><$motion(2,664)><$voicel(2,7)>And as a result, I was able to charge my cheeks with plenty<br>of electricity!
msgctxt "2661:98"
msgid "<oneline><$comeff(2,17)><$facial(2,1)><$motion(2,807)><$voicel(2,6)>Fiu...<clear><br><$comeff(2,3)><$facial(2,4)><$motion(2,661)><$voicel(2,8)>Parece que <$cdef(27)><pname;0> </color>tenía todo bajo<br>control.<slide><br><$comeff(2,9)><$motion(2,806)><$voicel(2,9)>¡La máquina está recibiendo la energía necesaria!<clear><br><$comeff(2,10)><$facial(2,1)><$motion(2,664)><$voicel(2,7)>Y eso ha hecho que mis mofletes se hayan recargado de<br>electricidad."
msgstr "<oneline><$comeff(2,17)><$facial(2,1)><$motion(2,807)><$voicel(2,6)>Fiu...<clear><br><$comeff(2,3)><$facial(2,4)><$motion(2,661)><$voicel(2,8)>Parece que <$cdef(27)><pname;0> </color>tenía todo bajo<br>control.<slide><br><$comeff(2,9)><$motion(2,806)><$voicel(2,9)>¡La máquina está recibiendo la energía necesaria!<clear><br><$comeff(2,10)><$facial(2,1)><$motion(2,664)><$voicel(2,7)>Y eso hizo que mis mejillas se recargaran de<br>electricidad."

#. en: <$comeff(1,3)><$facial(1,1)><$motion(1,666)><$voicel(1,8)>Oho! Are you saying you can use electricity again?!
msgctxt "2661:99"
msgid "<$comeff(1,3)><$facial(1,1)><$motion(1,666)><$voicel(1,8)>¡Oh, jo, jo! ¿Significa eso que ya puedes producir<br>electricidad por ti misma?"
msgstr ""

#. en: <$comeff(2,4)><$facial(2,1)><$motion(2,807)><$voicel(2,4)>Well, as I had guessed, I still cannot GENERATE<br>electricity...<clear><br><$comeff(2,3)><$motion(2,803)><$voicel(2,6)>But this device has allowed me to ABSORB plenty of it!<clear><br><$lookat(2,0,0)><$comeff(2,9)><$facial(2,4)><$motion(2,806)><$voicel(2,7)>And now I have a very special move in mind—one I’ve<br>been waiting a very long time to use!
msgctxt "2661:100"
msgid "<$comeff(2,4)><$facial(2,1)><$motion(2,807)><$voicel(2,4)>N-no... Me temo que no.<clear><br><$comeff(2,3)><$motion(2,803)><$voicel(2,6)>Pero, al menos, ahora puedo valerme de la máquina para<br>cargarme de electricidad.<clear><br><$lookat(2,0,0)><$comeff(2,9)><$facial(2,4)><$motion(2,806)><$voicel(2,7)>¡Y eso me permite usar mi movimiento especial otra vez!"
msgstr ""

#. en: <$comeff(1,6)><$facial(1,1)><$motion(1,666)><$voicel(1,3)>What in the world are you planning?
msgctxt "2661:101"
msgid "<$facial(1,1)><$motion(1,666)><$voicel(1,3)>Así que guardas un as en la manga... <$comeff(1,6)>¿Cuál es, por cierto?"
msgstr ""

#. en: <$lookat(2,0,0)><$comeff(2,3)><$facial(2,1)><$motion(2,661)><$voicel(2,6)>This particular move ought to light up the town even<br>brighter than it already is! <$comeff(2,14)><$facial(2,7)><$motion(2,666)><$voicel(2,3)>Well, without further ado...
msgctxt "2661:102"
msgid "<$lookat(2,0,0)><$comeff(2,3)><$facial(2,1)><$motion(2,661)><$voicel(2,6)>Es un movimiento que permitirá iluminar el vecindario<br>aún más si cabe.<clear><br><$comeff(2,14)><$facial(2,7)><$motion(2,666)><$voicel(2,3)>Os lo enseñaré..."
msgstr "<$lookat(2,0,0)><$comeff(2,3)><$facial(2,1)><$motion(2,661)><$voicel(2,6)>Es un movimiento que permitirá iluminar el vecindario<br>aún más si cabe.<clear><br><$comeff(2,14)><$facial(2,7)><$motion(2,666)><$voicel(2,3)>Se los mostraré..."

#. en: <$comeff(2,5)><$facial(2,7)><$voicel(2,9)><$textsize(2)>PIIIKAAA...CHUUUUUU!!!</textsize>
msgctxt "2661:103"
msgid "<$comeff(2,5)><$facial(2,7)><$voicel(2,9)><$textsize(2)>Pika... ¡chuuuuuu!</textsize>"
msgstr ""

#. en: <$comeff(2,5)><$facial(2,1)><$motion(2,661)><$voicel(2,6)>I would like you to send lots of electricity from the<br><$cdef(27)>generators </color>to this device!
msgctxt "2661:109"
msgid "<$comeff(2,5)><$facial(2,1)><$motion(2,661)><$voicel(2,6)>Debes conectar el dispositivo a más <$cdef(27)>generadores </color>para que<br>reciba toda la energía eléctrica que necesita."
msgstr ""

#. en: <$comeff(2,14)><$facial(2,1)><$motion(2,666)><$voicel(2,4)>In order to do that, you’ll need to use <$cdef(27)><fqty(2)><$ifull(1396)> </color>to<br>connect this device to the <$cdef(27)>generators</color>.
msgctxt "2661:110"
msgid "<$comeff(2,14)><$facial(2,1)><$motion(2,666)><$voicel(2,4)>Para ello, tienes que colocar varios <$cdef(27)><fqty(2)><class><$ifull(1396)><br></color>seguidos desde los <$cdef(27)>generadores </color>hasta aquí."
msgstr ""

#. en: <$comeff(2,5)><$facial(2,1)><$motion(2,805)><$voicel(2,8)>I can sense it... This time we have plenty of electricity<br>stored up!
msgctxt "2661:117"
msgid "<$facial(2,1)><$motion(2,805)><$voicel(2,8)>Esta vez está a rebosar de electricidad... <$comeff(2,5)>¡Puedo sentirlo!"
msgstr ""

#. en: <$comeff(2,3)><$facial(2,1)><$motion(2,803)><$voicel(2,7)>Well, I had better try it out posthaste. I’m so nervous my<br>cheeks are tingling!
msgctxt "2661:118"
msgid "<$comeff(2,3)><$facial(2,1)><$motion(2,803)><$voicel(2,7)>Pongámosla en marcha cuanto antes. Ay, los mofletes<br>me tiemblan de los nervios..."
msgstr "<$comeff(2,3)><$facial(2,1)><$motion(2,803)><$voicel(2,7)>Pongámosla en marcha cuanto antes. Ay, las mejillas<br>me tiemblan de los nervios..."

#. en: <$comeff(2,14)><$facial(2,1)><$motion(2,666)><$voicel(2,3)>I hope this works...
msgctxt "2661:124"
msgid "<$comeff(2,14)><$facial(2,1)><$motion(2,666)><$voicel(2,3)>Espero que funcione..."
msgstr ""

#. en: <$comeff(1,5)><$facial(1,1)><$motion(1,665)><$voicel(1,8)>Wh-what was that?! I just heard a zap—was that you?
msgctxt "2661:130"
msgid "<$comeff(1,5)><$facial(1,1)><$motion(1,665)><$voicel(1,8)>¡¿E-estás bien?! ¡Estás chisporroteando de lo lindo!"
msgstr ""

#. en: <oneline><$comeff(2,17)><$facial(2,1)><$motion(2,807)><$voicel(2,6)>Phew!<clear><br><$comeff(2,3)><$facial(2,4)><$motion(2,661)><$voicel(2,8)><$cdef(27)><pname;0></color> sent all the energy we needed<br>to<slide><br>this device!<clear><br><$comeff(2,10)><$facial(2,1)><$motion(2,664)><$voicel(2,7)>As a result, I was able to charge my cheeks with plenty<br>of electricity!
msgctxt "2661:131"
msgid "<oneline><$comeff(2,17)><$facial(2,1)><$motion(2,807)><$voicel(2,6)>Fiu...<clear><br><$comeff(2,3)><$facial(2,4)><$motion(2,661)><$voicel(2,8)>Parece que <$cdef(27)><pname;0> </color>lo ha conseguido<br>por fin.<slide><br>¡La máquina está recibiendo la energía necesaria!<clear><br><$comeff(2,10)><$facial(2,1)><$motion(2,664)><$voicel(2,7)>Y eso ha hecho que mis mofletes se hayan recargado de<br>electricidad."
msgstr "<oneline><$comeff(2,17)><$facial(2,1)><$motion(2,807)><$voicel(2,6)>Fiu...<clear><br><$comeff(2,3)><$facial(2,4)><$motion(2,661)><$voicel(2,8)>Parece que <$cdef(27)><pname;0> </color>lo consiguió<br>por fin.<slide><br>¡La máquina está recibiendo la energía necesaria!<clear><br><$comeff(2,10)><$facial(2,1)><$motion(2,664)><$voicel(2,7)>Y eso hizo que mis mejillas se recargaran de<br>electricidad."

#. en: <$comeff(1,3)><$facial(1,1)><$motion(1,666)><$voicel(1,8)>Oho! Are you saying you can use electricity again?!
msgctxt "2661:132"
msgid "<$comeff(1,3)><$facial(1,1)><$motion(1,666)><$voicel(1,8)>¡Oh, jo, jo! ¿Significa eso que ya puedes producir<br>electricidad por ti misma?"
msgstr ""

#. en: <$comeff(2,4)><$facial(2,1)><$motion(2,807)><$voicel(2,4)>Well, as I had guessed, I still cannot GENERATE<br>electricity...<clear><br><$comeff(2,3)><$motion(2,803)><$voicel(2,6)>But this device has allowed me to ABSORB plenty of it!<clear><br><$lookat(2,0,0)><$comeff(2,9)><$facial(2,4)><$motion(2,806)><$voicel(2,7)>And now I have a very special move in mind—one I’ve<br>been waiting a very long time to use!
msgctxt "2661:133"
msgid "<$comeff(2,4)><$facial(2,1)><$motion(2,807)><$voicel(2,4)>N-no... Me temo que no.<clear><br><$comeff(2,3)><$motion(2,803)><$voicel(2,6)>Pero, al menos, ahora puedo valerme de la máquina para<br>cargarme de electricidad.<clear><br><$lookat(2,0,0)><$comeff(2,9)><$facial(2,4)><$motion(2,806)><$voicel(2,7)>¡Y eso me permite usar mi movimiento especial otra vez!"
msgstr ""

#. en: <$comeff(1,6)><$facial(1,1)><$motion(1,666)><$voicel(1,3)>What in the world are you planning?
msgctxt "2661:134"
msgid "<$facial(1,1)><$motion(1,666)><$voicel(1,3)>Así que guardas un as en la manga... <$comeff(1,6)>¿Cuál es, por cierto?"
msgstr ""

#. en: <$lookat(2,0,0)><$comeff(2,3)><$facial(2,1)><$motion(2,661)><$voicel(2,6)>This particular move ought to light up the town even<br>brighter than it already is! <$comeff(2,14)><$facial(2,7)><$motion(2,666)><$voicel(2,3)>Well, without further ado...
msgctxt "2661:135"
msgid "<$lookat(2,0,0)><$comeff(2,3)><$facial(2,1)><$motion(2,661)><$voicel(2,6)>Es un movimiento que permitirá iluminar el vecindario<br>aún más si cabe.<clear><br><$comeff(2,14)><$facial(2,7)><$motion(2,666)><$voicel(2,3)>Os lo enseñaré..."
msgstr "<$lookat(2,0,0)><$comeff(2,3)><$facial(2,1)><$motion(2,661)><$voicel(2,6)>Es un movimiento que permitirá iluminar el vecindario<br>aún más si cabe.<clear><br><$comeff(2,14)><$facial(2,7)><$motion(2,666)><$voicel(2,3)>Se los mostraré..."

#. en: <$comeff(2,5)><$facial(2,7)><$voicel(2,9)><$textsize(2)>PIIIKAAA...CHUUUUUU!!!</textsize>
msgctxt "2661:136"
msgid "<$comeff(2,5)><$facial(2,7)><$voicel(2,9)><$textsize(2)>Pika... ¡chuuuuuu!</textsize>"
msgstr ""

#. en: <$comeff(1,5)><$facial(1,1)><$motion(1,665)><$voicel(1,10)>Oho! Would you look at that! So incredibly bright!
msgctxt "2661:138"
msgid "<$comeff(1,5)><$facial(1,1)><$motion(1,665)><$voicel(1,10)>¡Oh! ¡Menudo fulgor!"
msgstr "<$comeff(1,5)><$facial(1,1)><$motion(1,665)><$voicel(1,10)>¡Oh! ¡Qué fulgor!"

#. en: <$lookat(2,0,0)><$comeff(2,3)><$facial(2,4)><$motion(2,661)><$voicel(2,9)>Phew! That went well, I think. Was I of any help at all?
msgctxt "2661:139"
msgid "<$lookat(2,0,0)><$comeff(2,3)><$facial(2,4)><$motion(2,661)><$voicel(2,9)>¡Ha funcionado! Espero que esto nos ayude."
msgstr "<$lookat(2,0,0)><$comeff(2,3)><$facial(2,4)><$motion(2,661)><$voicel(2,9)>¡Funcionó! Espero que esto nos ayude."

#. en: <$lookat(1,0,2)><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Most certainly! I had no idea you could use a move<br>like that!
msgctxt "2661:140"
msgid "<$lookat(1,0,2)><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Sin ninguna duda! Desconocía por completo que podías<br>usar un movimiento como ese..."
msgstr ""

#. en: <$lookat(4,0,2)><$comeff(5,10)><$facial(5,4)><$motion(5,801)><$voicel(5,7)>You’re AMAZING, <$cdef(27)>Peakychu</color>!
msgctxt "2661:141"
msgid "<$lookat(4,0,2)><$comeff(5,10)><$facial(5,4)><$motion(5,801)><$voicel(5,7)>¡Qué pasada, <$cdef(27)>Palidachu</color>!"
msgstr "<$lookat(4,0,2)><$comeff(5,10)><$facial(5,4)><$motion(5,801)><$voicel(5,7)>¡Increíble, <$cdef(27)>Palidachu</color>!"

#. en: <$lookat(5,0,2)><$comeff(4,21)><$facial(4,4)><$motion(4,801)><$voicel(4,9)>My coin’s all shiny too!
msgctxt "2661:142"
msgid "<$lookat(5,0,2)><$comeff(4,21)><$facial(4,4)><$motion(4,801)><$voicel(4,9)>¡Cómo reluce mi moneda!"
msgstr ""

#. en: <$lookat(6,0,2)><$comeff(6,9)><$facial(6,4)><$motion(6,803)><$voicel(6,8)>Yooo! It’s BEAUTIFUL, <$cdef(27)>Peakychu</color>! And so bright!
msgctxt "2661:143"
msgid "<$lookat(6,0,2)><$comeff(6,9)><$facial(6,4)><$motion(6,803)><$voicel(6,8)>¡<$cdef(27)>Palidachu</color>, estás on fire! Y con eso quiero decir que<br>brillas tela."
msgstr "<$lookat(6,0,2)><$comeff(6,9)><$facial(6,4)><$motion(6,803)><$voicel(6,8)>¡<$cdef(27)>Palidachu</color>, estás on fire! Y con eso quiero decir que<br>brillas un montón."

#. en: <$lookat(2,0,0)><$comeff(2,10)><$facial(2,4)><$motion(2,664)><$voicel(2,8)>Tee-hee! Thank you all for your kind words. I’m just glad I<br>was able to be of use...
msgctxt "2661:144"
msgid "<$lookat(2,0,0)><$comeff(2,10)><$facial(2,4)><$motion(2,664)><$voicel(2,8)>Ji, ji. Gracias por los cumplidos. Tan solo espero poder<br>seros de ayuda."
msgstr "<$lookat(2,0,0)><$comeff(2,10)><$facial(2,4)><$motion(2,664)><$voicel(2,8)>Ji, ji. Gracias por los cumplidos. Tan solo espero poder<br>serles de ayuda."

#. en: <$comeff(2,3)><$facial(2,1)><$motion(2,661)><$voicel(2,6)>Well then, shall we go check in on <$cdef(27)>Snorlax </color>and see how<br>they’re doing?
msgctxt "2661:145"
msgid "<$comeff(2,3)><$facial(2,1)><$motion(2,661)><$voicel(2,6)>Vayamos junto a <$cdef(27)>Snorlax</color> a comprobar su estado."
msgstr ""
