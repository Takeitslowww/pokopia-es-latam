msgid "Esta Isla Nube no es pública ahora mismo."
msgstr ""

#. en: What would you like to do?
msgctxt "2328:501"
msgid "¿Qué quieres hacer?"
msgstr ""

#. en: Who would you like to send home?
msgctxt "2328:502"
msgid "¿A quién quieres expulsar?"
msgstr ""

#. en: <$cdef(27)><$strpname;0(lstr1,lnum1)></color> was sent home.
msgctxt "2328:503"
msgid "Se ha expulsado a <$cdef(27)><$strpname;0(lstr1,lnum1)></color>."
msgstr "Se expulsó a <$cdef(27)><$strpname;0(lstr1,lnum1)></color>."

