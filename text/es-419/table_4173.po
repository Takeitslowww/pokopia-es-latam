msgid "Qué frondoso..."
msgstr ""

#. en: I hope to see you around lots!
msgctxt "4173:25"
msgid "Me alegro de conocerte."
msgstr ""

#. en: Work, work, work! ♪
msgctxt "4173:28"
msgid "¡M-manos a la obra!"
msgstr ""

#. en: Heave-ho!
msgctxt "4173:29"
msgid "Uf, uf..."
