msgid "Venga, vamos."
msgstr "Bien, vamos."

#. en: Bye-byeee!
msgctxt "4173:74"
msgid "Hasta lueguito..."
msgstr ""

#. en: OK! Let’s give it our all!
msgctxt "4173:75"
msgid "¡Qué chuli! Déjamelo a mí."
msgstr "¡Qué bien! Déjamelo a mí."

#. en: Gosh, that smells great!
msgctxt "4173:76"
msgid "Qué rico huele..."
msgstr ""

