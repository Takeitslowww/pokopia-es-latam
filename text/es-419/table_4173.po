msgstr ""

#. en: Gosh, that’s amazing!
msgctxt "4173:86"
msgid "Haaala..."
msgstr "Guaaau..."

#. en: Heave-ho!
msgctxt "4173:87"
msgid "A ver..."
msgstr ""

#. en: So nice and warm...
msgctxt "4173:88"
msgid "Qué calentita..."
msgstr ""

#. en: H-hey! Wait up!
