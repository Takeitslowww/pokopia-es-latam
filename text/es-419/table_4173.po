msgstr ""

#. en: Um, leave it to me!
msgctxt "4173:79"
msgid "Ya me encargo yo."
msgstr ""

#. en: This place looks fun!
msgctxt "4173:80"
msgid "Parece un lugar muy animado..."
msgstr ""

#. en: Whatcha got there?
msgctxt "4173:81"
msgid "Uy, ¿qué es eso?"
msgstr ""

#. en: OK, ready or not, here I cooome!
msgctxt "4173:83"
msgid "Te voy a encontraaar..."
msgstr ""

#. en: My tummy’s too empty...
msgctxt "4173:84"
msgid "Ay, me muero de hambre..."
msgstr ""

#. en: Ummm... Is someone there?
msgctxt "4173:85"
