msgid "Me gustaría vivir aquí..."
msgstr ""

#. en: This house is perfect! ♪
msgctxt "4173:70"
msgid "Cómo me gusta esta casa humana..."
msgstr ""

#. en: Hey! Come check this out!
msgctxt "4173:71"
msgid "Mira lo que tengo, porfi."
msgstr "Mira lo que tengo, porfa."

#. en: Hmmm, maybe it’s a little small?
