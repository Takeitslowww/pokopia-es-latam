#. en: <$voicel(1,5)><$motion(1,803)><$comeff(1,9)>Oh, heyyy. Nice to meet you... Let’s be friends. <$voicel(1,8)><$emotion(1,39)>We can<br>take it easy together. It’ll be greeeaaat.
msgctxt "2022:3"
msgid "<$voicel(1,5)><$motion(1,803)><$comeff(1,9)>¡Andaaa! ¡Encantad<gen;-3(o,a)> de conocerte! <$voicel(1,8)><$emotion(1,39)>Pa cuando te apetezca<br>un ratico de relax, ¡aquí estoy!"
msgstr "<$voicel(1,5)><$motion(1,803)><$comeff(1,9)>¡Vayaaa! ¡Encantad<gen;-3(o,a)> de conocerte! <$voicel(1,8)><$emotion(1,39)>Pa cuando quieras<br>un ratito de relax, ¡aquí estoy!"

#. en: <$voicel(1,5)><$motion(1,803)><$comeff(1,9)>Hmmmmmm? I don’t think I’ve seen you before. Nice to<br>meet you...<clear><br><$voicel(1,7)><$comeff(1,10)>I’m friends with <$cdef(27)><nowner;1></color>, you knooow?<clear><br><$voicel(1,10)><$emotion(1,39)>I hope we can be friends too, and have lots of fun<br>conversaaations.
msgctxt "2022:4"
msgid "<$voicel(1,5)><$motion(1,803)><$comeff(1,9)>¡Anda! Si no me suena tu cara. ¿Qué taaal?<br><$voicel(1,7)><$comeff(1,10)>Yo soy paisan<gen;-3(o,a)> de <$cdef(27)><nowner;1></color>.<clear><br><$voicel(1,10)><$emotion(1,39)>¡A ver si un día de estos nos liamos a hablar un ratico<br>y nos conocemos mejor!"
msgstr "<$voicel(1,5)><$motion(1,803)><$comeff(1,9)>¡Vaya! No me suena tu cara. ¿Qué taaal?<br><$voicel(1,7)><$comeff(1,10)>Yo soy amig<gen;-3(o,a)> de <$cdef(27)><nowner;1></color>.<clear><br><$voicel(1,10)><$emotion(1,39)>¡A ver si un día de estos charlamos un ratito<br>y nos conocemos mejor!"

#. en: <$voicel(1,5)><$motion(1,803)><$comeff(1,9)>Hmmmmmm? I don’t think I’ve seen you before. Nice to<br>meet you...<clear><br><$voicel(1,7)><$comeff(1,10)>I’m friends with <$cdef(27)><acqpname;1></color>, you knooow?<clear><br><$voicel(1,10)><$emotion(1,39)>I hope we can be friends too, and have lots of fun<br>conversaaations.
msgctxt "2022:5"
msgid "<$voicel(1,5)><$motion(1,803)><$comeff(1,9)>¡Anda! Si no me suena tu cara. ¿Qué taaal?<br><$voicel(1,7)><$comeff(1,10)>Yo soy paisan<gen;-3(o,a)> de <$cdef(27)><acqpname;1></color>.<clear><br><$voicel(1,10)><$emotion(1,39)>¡A ver si un día de estos nos liamos a hablar un ratico<br>y nos conocemos mejor!"
msgstr "<$voicel(1,5)><$motion(1,803)><$comeff(1,9)>¡Vaya! No me suena tu cara. ¿Qué taaal?<br><$voicel(1,7)><$comeff(1,10)>Yo soy amig<gen;-3(o,a)> de <$cdef(27)><acqpname;1></color>.<clear><br><$voicel(1,10)><$emotion(1,39)>¡A ver si un día de estos charlamos un ratito<br>y nos conocemos mejor!"

#. en: <$voicel(1,5)><$motion(1,803)><$comeff(1,9)>Hmmmmmm? I don’t think I’ve seen you before. Nice to<br>meet you...<clear><br><$voicel(1,7)><$emotion(1,39)>I’m friends with that Pokémon over there, you knooow?<clear><br>I hope we can be friends too, and have lots of fun<br>conversaaations.
msgctxt "2022:6"
msgid "<$voicel(1,5)><$motion(1,803)><$comeff(1,9)>¡Anda! Si no me suena tu cara. ¿Qué taaal?<br>Yo soy paisan<gen;-3(o,a)> de otro Ditto.<clear><br><$voicel(1,7)><$emotion(1,39)>¡A ver si un día de estos nos liamos a hablar un ratico<br>y nos conocemos mejor!"
msgstr "<$voicel(1,5)><$motion(1,803)><$comeff(1,9)>¡Vaya! No me suena tu cara. ¿Qué taaal?<br>Yo soy amig<gen;-3(o,a)> de otro Ditto.<clear><br><$voicel(1,7)><$emotion(1,39)>¡A ver si un día de estos charlamos un ratito<br>y nos conocemos mejor!"

#. en: <$voicel(1,7)><$emotion(1,8)>Mmmmmm... Something smells really gooood. Makes me<br>want to hang around here at home...
msgctxt "2022:8"
msgid "<$voicel(1,7)><$emotion(1,8)>Mmm... Qué bien huele por aquíii... Me han entrado ganas<br>de estar en casica..."
msgstr "<$voicel(1,7)><$emotion(1,8)>Mmm... Qué bien huele por aquíii... Me dieron ganas<br>de estar en casita..."

#. en: <oneline><$comeff(1,13)><$voicel(1,7)><$motion(1,803)><$facial(1,4)>Oh, heyyy, <$cdef(27)><pname;0></color>. How long’s it been?<br>Let’s<slide><br>go<slide><br>have<slide><br>some<slide><br>fun<slide><br>together sometime.
msgctxt "2022:9"
msgid "<oneline><$comeff(1,13)><$voicel(1,7)><$motion(1,803)><$facial(1,4)>¡Ahí va, pero si es <gen;-2(el bueno,la buena)> de <$cdef(27)><pname;0></color>!<br>¿Qué tal te va, maj<gen;-2(o,a)>?<slide><br>A ver si quedamos algún día."
msgstr "<oneline><$comeff(1,13)><$voicel(1,7)><$motion(1,803)><$facial(1,4)>¡Vaya, pero si es <gen;-2(el bueno,la buena)> de <$cdef(27)><pname;0></color>!<br>¿Qué tal te va, amig<gen;-2(o,a)>?<slide><br>A ver si nos vemos algún día."

#. en: <$voicel(1,7)><$motion(1,803)><$comeff(1,9)>Hmmmmmm? I don’t think I’ve seen you before. Nice to<br>meet you...<clear><br><$voicel(1,5)><$motion(1,805)><$comeff(1,6)>Are you out here going for a walk? It does seem like a<br>nice place for it. <$voicel(1,8)><$emotion(1,39)>Maybe I’ll go for a little walk toooo...
msgctxt "2022:10"
msgid "<$voicel(1,7)><$motion(1,803)><$comeff(1,9)>¡Anda! No me suena tu cara. ¿Qué taaal?<clear><br><$voicel(1,5)><$motion(1,805)><$comeff(1,6)>¿Has venido a pasear? La verdad es que esta zona es muy<br>agradable.<clear><br><$voicel(1,8)><$emotion(1,39)>Creo que yo también voy a darme una vueltecica..."
msgstr "<$voicel(1,7)><$motion(1,803)><$comeff(1,9)>¡Vaya! No me suena tu cara. ¿Qué taaal?<clear><br><$voicel(1,5)><$motion(1,805)><$comeff(1,6)>¿Viniste a pasear? La verdad es que esta zona es muy<br>agradable.<clear><br><$voicel(1,8)><$emotion(1,39)>Creo que yo también voy a darme una vueltecita..."

#. en: <$emotion(1,39)><$voicel(1,7)><$pkcry;0(1,2)>. ♪ My friend said I have a reeeaaally<br>nice smell. Hehehe...
msgctxt "2022:46"
msgid "<oneline><$emotion(1,39)><$voicel(1,7)>Estaba hablando con una amistad ¡y me ha dicho que<br>huelo que da gusto! Me ha alegrao el día, oye.<slide><br>¡<$pkcry;0(1,2)>!"
msgstr "<oneline><$emotion(1,39)><$voicel(1,7)>Estaba hablando con una amistad ¡y me dijo que<br>huelo que da gusto! Me alegró el día, oye.<slide><br>¡<$pkcry;0(1,2)>!"

#. en: <$motion(1,817)><$comeff(1,9)><$facial(1,4)><$voicel(1,7)>Sometimes, when I’m near the surface of the waaater, I can<br>see the shadows of flying Pokémon...<clear><br><$emotion(1,55)><$voicel(1,6)>Do you think they get hot being so close to the suuun?
msgctxt "2022:50"
msgid "<$motion(1,817)><$comeff(1,9)><$facial(1,4)><$voicel(1,7)>A veces, cuando estoy cerca de la superficie, veo pasar<br>las sombras de los Pokémon que vueeelan por el cielo...<clear><br><$emotion(1,55)><$voicel(1,6)>Me pregunto si no pasarán calorcico al acercase tanto<br>al sol."
msgstr "<$motion(1,817)><$comeff(1,9)><$facial(1,4)><$voicel(1,7)>A veces, cuando estoy cerca de la superficie, veo pasar<br>las sombras de los Pokémon que vueeelan por el cielo...<clear><br><$emotion(1,55)><$voicel(1,6)>Me pregunto si no pasarán calorcito al acercase tanto<br>al sol."

#. en: <oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Look at the <$cdef(27)><fqty(1)><class><usingp;0></color>...<br>We<slide><br>worked<slide><br>reeeaaally<slide><br>hard<slide><br>to<slide><br>make it.
msgctxt "2022:53"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Qué majic<genqty;0(o,a,os,as)> <dart;0()><$cdef(27)><fqty(1)><usingp;0></color>, ¿eh?<br>Me he esforzado un montón pa que quedar<genqty;0(a,a,an,an)> bien."
msgstr "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Qué bonit<genqty;0(o,a,os,as)> <dart;0()><$cdef(27)><fqty(1)><usingp;0></color>, ¿eh?<br>Me esforcé un montón pa que quedar<genqty;0(a,a,an,an)> bien."

#. en: <oneline><$voicel(1,5)><$emotion(1,14)>I can’t help staring at the<br><$cdef(27)><fqty(1)><class><usingp;0></color>...<slide><br><$voicel(1,8)><$emotion(1,39)>Must<slide><br>be<slide><br>because<slide><br>it’s<slide><br>so prettyyy.
msgctxt "2022:54"
msgid "<oneline><$voicel(1,5)><$emotion(1,14)>No puedo dejar de contemplar<br><dart;0()><fqty(1)><$cdef(27)><usingp;0></color>...<slide><br><$voicel(1,8)><$emotion(1,39)>¡Qué cosa más bonica!"
msgstr "<oneline><$voicel(1,5)><$emotion(1,14)>No puedo dejar de contemplar<br><dart;0()><fqty(1)><$cdef(27)><usingp;0></color>...<slide><br><$voicel(1,8)><$emotion(1,39)>¡Qué cosa más bonita!"

#. en: <$comeff(1,3)><$facial(1,3)><$motion(1,803)><$voicel(1,5)>Let me knooow if you need some logs cut or something...<br>I’ll work hard if yooouuu’re the one asking.
msgctxt "2022:55"
msgid "<$comeff(1,3)><$facial(1,3)><$motion(1,803)><$voicel(1,5)>Si necesitas que corte leña, maj<gen;-2(o,a)>, pide por esa boquita.<br>¡Ya sabes que estoy aquí p'ayudar!"
msgstr "<$comeff(1,3)><$facial(1,3)><$motion(1,803)><$voicel(1,5)>Si necesitas que corte leña, amig<gen;-2(o,a)>, pide por esa boquita.<br>¡Ya sabes que estoy aquí p'ayudar!"

#. en: <$comeff(1,3)><$facial(1,3)><$motion(1,803)><$voicel(1,5)>You can see some really pretty colooors when you crush<br>berries. I can show you sometime if you waaant.
msgctxt "2022:57"
msgid "<$comeff(1,3)><$facial(1,3)><$motion(1,803)><$voicel(1,5)>Cuando pulverizas bayas, salen unos colores la mar de<br>bonicos. Si quieres verlos, dímelo, que te los enseño."
msgstr "<$comeff(1,3)><$facial(1,3)><$motion(1,803)><$voicel(1,5)>Cuando pulverizas bayas, salen unos colores bien<br>bonitos. Si quieres verlos, dímelo, que te los enseño."

#. en: <$comeff(1,3)><$facial(1,3)><$motion(1,803)><$voicel(1,5)>It’s good to <$cdef(27)><$spwfull(17)> </color>things... Let me take care of any<br>trash you don’t neeeed.
msgctxt "2022:58"
msgid "<$comeff(1,3)><$facial(1,3)><$motion(1,803)><$voicel(1,5)>Es muy importante <$cdef(27)><$spwfull(17)></color>. Cualquier basurica que<br>tengas por ahí, tráemela y yo me encargo."
msgstr "<$comeff(1,3)><$facial(1,3)><$motion(1,803)><$voicel(1,5)>Es muy importante <$cdef(27)><$spwfull(17)></color>. Cualquier basurita que<br>tengas por ahí, tráemela y yo me encargo."

#. en: <$comeff(1,3)><$facial(1,4)><$motion(1,801)><$voicel(1,5)>Demolishing buildings is hard wooork...but it can be fun<br>if we work together. <$motion(1,803)><$voicel(1,6)>Let me know if you ever need to<slide><br><$cdef(27)><$spwfull(33)> </color>something...
msgctxt "2022:59"
msgid "<$comeff(1,3)><$facial(1,4)><$motion(1,801)><$voicel(1,5)>Demoler estructuras es muy trabajoso, ¿eh? ¡Pero se hace<br>más llevadero cuando un<gen;-3(o,a)> tiene compañía!<clear><br><$motion(1,803)><$voicel(1,6)>Cuando necesites <$cdef(27)><$spwfull(33)></color> algo, avísame."
msgstr ""

#. en: <$comeff(1,3)><$facial(1,3)><$motion(1,803)><$voicel(1,5)>Let me knooow if you’re ever looking for a specific<br>Pokémon. I can take you to theeem.
msgctxt "2022:60"
msgid "<$comeff(1,3)><$facial(1,3)><$motion(1,803)><$voicel(1,5)>Si alguna vez buscas a algún Pokémon, pregúntame, que<br>te llevo adonde esté en un periquete."
msgstr "<$comeff(1,3)><$facial(1,3)><$motion(1,803)><$voicel(1,5)>Si alguna vez buscas a algún Pokémon, pregúntame, que<br>te llevo adonde esté en un santiamén."

#. en: <oneline><$comeff(1,9)><$facial(1,4)><$motionoff(1,804)><$voicel(1,7)>Oh heyyy, good morning, <$cdef(27)><pname;0></color>.<br>You’re<slide><br>up<slide><br>eeeaaarly<slide><br>today, huh?
msgctxt "2022:101"
msgid "<$cdef(27)><$comeff(1,9)></color><$facial(1,4)><$motionoff(1,804)><$voicel(1,7)>Buenos días, majet<gen;-2(e,a)>. A quien madruga, Arceus le ayuda."
msgstr "<$cdef(27)><$comeff(1,9)></color><$facial(1,4)><$motionoff(1,804)><$voicel(1,7)>Buenos días, jef<gen;-2(e,a)>. A quien madruga, Arceus lo ayuda."

#. en: <oneline><$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Gooooood morning, <$cdef(27)><pname;0></color>. Ready for<br>another<slide><br>nice,<slide><br>slooow day?
msgctxt "2022:102"
msgid "<oneline><$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Buenos días, <$cdef(27)><pname;0></color>. Hoy también<br>es un día<slide><br>estupendo<slide><br>pa vaguear."
msgstr "<oneline><$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Buenos días, <$cdef(27)><pname;0></color>. Hoy también<br>es un día<slide><br>estupendo<slide><br>pa holgazanear."

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>The afternoon is sooo busy... Afternoon snack, afternoon<br>walk, afternoon nap. Phew...
msgctxt "2022:103"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Los mediodías estoy muy ocupad<gen;-3(o,a)>: la comida, la siesta<br>pa coger fuerzas, el paseo pa desperezarme..."
msgstr "<$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Los mediodías estoy muy ocupad<gen;-3(o,a)>: la comida, la siesta<br>pa recuperar fuerzas, el paseo pa desperezarme..."

#. en: <$comeff(1,14)><$voicel(1,5)>I’ve been thinking aaall morning about what to do today...<br><$comeff(1,9)><$facial(1,4)><$motion(1,803)>and already it’s afternoon.
msgctxt "2022:104"
msgid "<$comeff(1,14)><$voicel(1,5)>He estado pensando qué hacer hoy... y de tanto pensar,<$comeff(1,9)><$facial(1,4)><$motion(1,803)><br>ya verás como al final no hago nada."
msgstr ""

#. en: <$comeff(1,13)><$facial(1,4)><$motion(1,805)><$voicel(1,7)>I reeeaaally like the sunset, so I reeeaaally like clear skies in<br>the evening.
msgctxt "2022:105"
msgid "<$comeff(1,13)><$facial(1,4)><$motion(1,805)><$voicel(1,7)>Me encaaanta ver el atardecer, por eso me gusta cuando<br>el cielo está despejado por las tardes."
msgstr ""

#. en: <$comeff(1,6)><$motion(1,666)><$voicel(1,5)>Do you always get huuungry around this time too? Or is it<br>just me?
msgctxt "2022:106"
msgid "<$comeff(1,6)><$motion(1,666)><$voicel(1,5)>No sé a ti, pero a mí me entra un hambre a estas horas..."
msgstr ""

#. en: <oneline><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Gooooood evening, <$cdef(27)><pname;0></color>. Even at<br>night<slide><br>you’re<slide><br>sooo<slide><br>full<slide><br>of energy.
msgctxt "2022:107"
msgid "<oneline><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Hola, <$cdef(27)><pname;0></color>. Pa ser de noche, tienes<br>una energía..."
msgstr ""

#. en: <$comeff(1,14)><$facial(1,4)><$motion(1,803)><$voicel(1,5)>Nighttime is so niiice and quiet. Maybe we should all<br>gather around a niiiice campfire...
msgctxt "2022:108"
msgid "<$comeff(1,14)><$facial(1,4)><$motion(1,803)><$voicel(1,5)>Qué tranquil<gen;-3(o,a)> se está por la noche. Estaría bien encender<br>una fogata y ponernos todos alrededor..."
msgstr ""

#. en: <$comeff(1,14)><$facial(1,14)><$motion(1,803)><$voicel(1,7)>I’m thinking reeeaaally hard about something right now...<clear><br>I wonder how many different vegetables there are that<br>I’ve neeever eaten before?
msgctxt "2022:109"
msgid "<$comeff(1,14)><$facial(1,14)><$motion(1,803)><$voicel(1,7)>No puedo dejar de pensar en una cosa... Me pregunto<br>si existirá alguna verdura que no haya probado nunca."
msgstr ""

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>All riiight. Today’s a good day to just plop down and<br>do nothing...
msgctxt "2022:110"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Bueno, pues... hoy creo que me voy a echar a la bartola."
msgstr "<$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Bueno, pues... hoy creo que me voy a tirar a descansar."

#. en: <oneline><$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Heyyy, <$cdef(27)><pname;0></color>. What are you planning<br>to<slide><br>do today?
msgctxt "2022:111"
msgid "<oneline><$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Hola, <$cdef(27)><pname;0></color>. ¿Qué vas a hacer hoy,<br>maj<gen;-2(o,a)>?"
msgstr "<oneline><$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Hola, <$cdef(27)><pname;0></color>. ¿Qué vas a hacer hoy,<br>amig<gen;-2(o,a)>?"

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,807)><$voicel(1,7)>You maybe can’t tell just looking at me, but I took a<br>baaath recently...
msgctxt "2022:112"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,807)><$voicel(1,7)>Igual no se nota a primera vista, pero me acabo de lavar<br>el cuerpo a conciencia."
msgstr "<$comeff(1,10)><$facial(1,4)><$motion(1,807)><$voicel(1,7)>Tal vez no se nota a primera vista, pero me acabo de<br>lavar el cuerpo a conciencia."

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>I’m not gonna do aaanything today. Oh, but I guess I could<br>help you out if yooouuu need me, <$cdef(27)><pname;0></color>.
msgctxt "2022:113"
msgid "<$cdef(27)><$comeff(1,10)></color><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Hoy no voy a dar palo al agua. Bueno, a no ser que<br>necesites algo, claro."
msgstr "<$cdef(27)><$comeff(1,10)></color><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Hoy no pienso mover ni un dedo. Bueno, a no ser que<br>necesites algo, claro."

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Heyyy. What do you need?
msgctxt "2022:114"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Dimeee. ¿Querías algo?"
msgstr ""

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Hehehe... It makes me haaappy to see you all full of<br>energy, <$cdef(27)><pname;0></color>.
msgctxt "2022:115"
msgid "<$cdef(27)><$comeff(1,9)></color><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Ja, ja, ja. Me alegra verte tan llen<gen;-2(o,a)> de energía."
msgstr ""

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>We should have some niiiice, lazy talks sometimes. Just<br>running around all the time is tiring, you knooow?
msgctxt "2022:116"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Párate a hablar un rato conmigo de vez en cuando, ¿sí?<br>Es que correr todo el día de aquí p'allá cansa mucho."
msgstr "<$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Ven a hablar un rato conmigo de vez en cuando, ¿sí?<br>Es que correr todo el día de aquí p'allá cansa mucho."

#. en: <$comeff(1,14)><$motion(1,666)><$facial(1,14)><$voicel(1,7)>Should I go for a walk or just be laaazy? Hmmm...<br>Maybe I’ll have a lazy think about it.
msgctxt "2022:117"
msgid "<$comeff(1,14)><$motion(1,666)><$facial(1,14)><$voicel(1,7)>No sé si darme un paseo o descansar un ratico...<br>Voy a tumbarme mientras me lo pienso."
msgstr "<$comeff(1,14)><$motion(1,666)><$facial(1,14)><$voicel(1,7)>No sé si darme un paseo o descansar un ratito...<br>Voy a acostarme mientras me lo pienso."

#. en: <$comeff(1,6)><$facial(1,4)><$motion(1,666)><$voicel(1,7)>What are we gonna do today? Whatever it is, we should<br>take it niiice and slooow...
msgctxt "2022:118"
msgid "<$comeff(1,6)><$facial(1,4)><$motion(1,666)><$voicel(1,7)>¿Qué vas a hacer hoy? Ya sabes, no te estreses, maj<gen;-2(o,a)>."
msgstr "<$comeff(1,6)><$facial(1,4)><$motion(1,666)><$voicel(1,7)>¿Qué vas a hacer hoy? Ya sabes, no te estreses, amig<gen;-2(o,a)>."

#. en: <$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>It’s kinda niiice to take little detours here and there—even<br>if you don’t find anything suuuper interesting...
msgctxt "2022:119"
msgid "<$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Me encanta desviarme del camino aposta. Da igual que<br>encuentre algo o no, es taaan divertido."
msgstr "<$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Me encanta desviarme del camino adrede. Da igual que<br>encuentre algo o no, es taaan divertido."

#. en: <$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Have something for me to do? Don’t be shy, just let<br>me knooow.
msgctxt "2022:120"
msgid "<$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¿Tienes algún favorcico que pedirme? Pide por esa boca."
msgstr "<$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¿Tienes algún favorcito que pedirme? Pide por esa boca."

#. en: <oneline><$comeff(1,16)><$facial(1,14)><$voicel(1,3)>Zzzzzz... Ah... <$cdef(27)><pname;0></color>? Still staying up<br>for a while?
msgctxt "2022:121"
msgid "<$comeff(1,16)><$facial(1,14)><$voicel(1,3)>Uaaah... ¿<$cdef(27)><pname;0></color>? ¿Tú nunca duermes?"
msgstr ""

#. en: <$comeff(1,15)><$facial(1,14)><$voicel(1,5)>I’m awaaake. I’m...aaaw...ake... <wait(0.8)><$facial(1,13)><$motion(1,803)><$comcan(1)>Ah! <wait(0.2)><$facial(1,1)>Phew, almost went<br>back to sleep...
msgctxt "2022:122"
msgid "<$comeff(1,15)><$facial(1,14)><$voicel(1,5)>Hooola. Ya estoy... <wait(0.8)>despier... <wait(0.8)><$facial(1,13)><$motion(1,803)><$comcan(1)>¡Despiert<gen;-3(o,a)>!<wait(0.2)><$facial(1,1)> Uf, por poco...<br>Casi me quedo sopa otra vez."
msgstr "<$comeff(1,15)><$facial(1,14)><$voicel(1,5)>Hooola. Ya estoy... <wait(0.8)>despier... <wait(0.8)><$facial(1,13)><$motion(1,803)><$comcan(1)>¡Despiert<gen;-3(o,a)>!<wait(0.2)><$facial(1,1)> Uf, por poco...<br>Casi me vuelvo a dormir."

#. en: <$comeff(1,21)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>I hope there are some Pokémon around here. Sure would<br>be nice to maaake some friends.
msgctxt "2022:123"
msgid "<$comeff(1,21)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>¿Qué Pokémon habrá por aquíii? Me llevaría una<br>gran alegría si pudiese hacer buenas migas con ellos..."
msgstr ""

#. en: <$comeff(1,14)><$motion(1,827)><$voicel(1,5)>I dunno much about this place yet, so first things first...<br>Gotta find a nap spot. Yeeeaaah.
msgctxt "2022:124"
msgid "<$comeff(1,14)><$motion(1,827)><$voicel(1,5)>No me manejo muy bien por esta zona todavía, pero lo<br>principal es buscar el lugar ideal pa una buena siestecica."
msgstr "<$comeff(1,14)><$motion(1,827)><$voicel(1,5)>No me manejo muy bien por esta zona todavía, pero lo<br>principal es buscar el lugar ideal pa una buena siestecita."

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>What a niiice place. Good place to just take it easy...
msgctxt "2022:125"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>¡Este lugar es muy pero que muy resultón! Me da que voy<br>a poder tomarme las cosicas con caaalma."
msgstr "<$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>¡Este lugar es muy pero muy bonito! Me parece que voy<br>a poder tomarme las cositas con caaalma."

#. en: <$comeff(1,10)><$motion(1,803)><$voicel(1,7)>Whoa... Everybody’s working reeeaaal hard <$cdef(27)><$spwfull(1)>ing </color>stuff.
msgctxt "2022:126"
msgid "<$comeff(1,10)><$motion(1,803)><$voicel(1,7)>Jo, hay que ver cómo se esfuerzan tooodos con esto de<br>ponerse a <$cdef(27)><$spwfull(1)> </color>cosas, trabajando ahí a destajo."
msgstr "<$comeff(1,10)><$motion(1,803)><$voicel(1,7)>Ay, hay que ver cómo se esfuerzan tooodos con esto de<br>ponerse a <$cdef(27)><$spwfull(1)> </color>cosas, trabajando ahí a destajo."

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Is it time to <$cdef(27)><$spwfull(1)> </color>something? This is kinda excitiiing!
msgctxt "2022:127"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>¿Cuándo empezamos a <$cdef(27)><$spwfull(1)></color>? ¡Tengo unas ganicas!"
msgstr "<$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>¿Cuándo empezamos a <$cdef(27)><$spwfull(1)></color>? ¡Tengo unas ganitas!"

#. en: <$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>I’ve met sooo many Pokémon recently. It’s definitely<br>thanks to all your hard work, <$cdef(27)><pname;0></color>.
msgctxt "2022:128"
msgid "<$cdef(27)><$comeff(1,13)></color><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Últimamente veo muchas caras nuevas por aquí. Sí, sí.<br>Seguro que es por tu don de gentes, al ser tan majet<gen;-2(e,a)>."
msgstr "<$cdef(27)><$comeff(1,13)></color><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Últimamente veo muchas caras nuevas por aquí. Sí, sí.<br>Seguro que es por tu don de gentes, jef<gen;-2(e,a)>."

#. en: <$comeff(1,14)><$motion(1,827)><$voicel(1,5)>Hmmm. I wonder what would make my home mooore cozy.
msgctxt "2022:129"
msgid "<$comeff(1,14)><$motion(1,827)><$voicel(1,5)>¿Cómo podría hacer de mi casica un lugar más acogedor<br>y apacible?"
msgstr "<$comeff(1,14)><$motion(1,827)><$voicel(1,5)>¿Cómo podría hacer de mi casita un lugar más acogedor<br>y apacible?"

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>My home is slooowly getting cozier and cozier.
msgctxt "2022:130"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Mi casica se ha vuelto mucho más acogedora."
msgstr "<$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Mi casita se ha vuelto mucho más acogedora."

#. en: <$comeff(1,13)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>My home is sooo cozy now. <$comeff(1,8)><$motion(1,801)><$voicel(1,9)>It’s definitely allll thanks to<br>you, <$cdef(27)><pname;1></color>.
msgctxt "2022:131"
msgid "<$comeff(1,13)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>En mi casica estoy a cuerpo de <gen;-3(rey,reina)>. <$comeff(1,8)><$motion(1,801)><$voicel(1,9)>Y todo gracias a ti,<br><$cdef(27)><pname;1></color>."
msgstr "<$comeff(1,13)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>En mi casita estoy a cuerpo de <gen;-3(rey,reina)>. <$comeff(1,8)><$motion(1,801)><$voicel(1,9)>Y todo gracias a ti,<br><$cdef(27)><pname;1></color>."

#. en: <$comeff(1,6)><$motion(1,805)><$voicel(1,7)>Why does seeing your face make me feel so relaxed,<br><$cdef(27)><pname;0></color>? Weeeiiird.
msgctxt "2022:132"
msgid "<$comeff(1,6)><$motion(1,805)><$voicel(1,7)>¿Sabes qué? Es verte la carica y ya como que me siento<br>más relajad<gen;-3(o,a)>, <$cdef(27)><pname;0></color>. ¿Por qué será?"
msgstr "<$comeff(1,6)><$motion(1,805)><$voicel(1,7)>¿Sabes qué? Es verte la carita y ya como que me siento<br>más relajad<gen;-3(o,a)>, <$cdef(27)><pname;0></color>. ¿Por qué será?"

#. en: <oneline><$comeff(1,21)><$facial(1,4)><$motion(1,803)><$voicel(1,5)>You’re suuuch a hard worker, <$cdef(27)><pname;0></color>.<br><$comeff(1,9)><$motion(1,801)><$voicel(1,8)>Don’t<slide><br>forget<slide><br>to<slide><br>chill<slide><br>sometimes, yeah?
msgctxt "2022:133"
msgid "<oneline><$comeff(1,21)><$facial(1,4)><$motion(1,803)><$voicel(1,5)>¡Cómo te dejas la piel en esto, <$cdef(27)><pname;0></color>!<br><$comeff(1,9)><$motion(1,801)><$voicel(1,8)>Un descansico<slide><br>de vez<slide><br>en cuando te vendría estupendo."
msgstr "<oneline><$comeff(1,21)><$facial(1,4)><$motion(1,803)><$voicel(1,5)>¡Cómo te esfuerzas en esto, <$cdef(27)><pname;0></color>!<br><$comeff(1,9)><$motion(1,801)><$voicel(1,8)>Un descansito<slide><br>de vez<slide><br>en cuando te vendría estupendo."

#. en: <$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Seeing a new place was kinda fuuun. Let’s do it<br>again sometime.
msgctxt "2022:134"
msgid "<$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Visitar tierras desconocidas también tiene su aquel.<br>Habrá que repetir la experiencia, ¿eeeh?"
msgstr "<$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Visitar tierras nuevas también tiene su encanto.<br>Habrá que repetir la experiencia, ¿eeeh?"

#. en: <oneline><$comeff(1,1)><$facial(1,4)><$motion(1,805)><$voicel(1,7)>Heyyy, <$cdef(27)><pname;0></color>. Welcome back. Did<br>you<slide><br>find<slide><br>anything<slide><br>nice todaaay?
msgctxt "2022:135"
msgid "<oneline><$comeff(1,1)><$facial(1,4)><$motion(1,805)><$voicel(1,7)>¡<$cdef(27)><pname;0></color>! ¿Qué tal te va hoy?<br>¿Has descubierto algo guay?"
msgstr "<oneline><$comeff(1,1)><$facial(1,4)><$motion(1,805)><$voicel(1,7)>¡<$cdef(27)><pname;0></color>! ¿Qué tal te va hoy?<br>¿Descubriste algo genial?"

#. en: <oneline><$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Heyyy, <$cdef(27)><pname;0></color>. Welcome back. Looks<br>like<slide><br>you<slide><br>went<slide><br>out<slide><br>really<slide><br>far today.<clear><br><$comeff(1,13)><$motion(1,806)><$voicel(1,6)>Don’t forget to chill sometimes, yeeeaaah?
msgctxt "2022:136"
msgid "<oneline><$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>¿Qué tal, <$cdef(27)><pname;0></color>? Jo, hoy te has ido<br>hasta vete tú<slide><br>a saber dónde, ¿eh?<clear><br><$comeff(1,13)><$motion(1,806)>¡<$voicel(1,6)>Te vendría bien tumbarte a la bartola de vez en cuando!"
msgstr "<oneline><$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>¿Qué tal, <$cdef(27)><pname;0></color>? Ay, hoy te fuiste<br>hasta quién<slide><br>sabe dónde, ¿eh?<clear><br><$comeff(1,13)><$motion(1,806)>¡<$voicel(1,6)>Te vendría bien echarte a descansar de vez en cuando!"

#. en: <$comeff(1,13)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>If I find something niiice, I’ll be sure to put it in the<br><$cdef(27)><fqty(1)><$ifull(1460)></color>, OK?
msgctxt "2022:137"
msgid "<$comeff(1,13)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Si encuentro algo majo por ahí, tranquil<gen;-2(o,a)>, que lo meteré<br>en una <$cdef(27)><fqty(1)><$ifull(1460)></color>."
msgstr "<$comeff(1,13)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Si encuentro algo lindo por ahí, tranquil<gen;-2(o,a)>, que lo meteré<br>en una <$cdef(27)><fqty(1)><$ifull(1460)></color>."

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>I’m good at lighting fires... Let me know if you wanna<br>buuurn anything.
msgctxt "2022:139"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Se me da como a nadie prender fuego. Si tienes algo que<br>quemar, yo me encargo."
msgstr ""

#. en: <$facial(1,4)><$comeff(1,3)><$motion(1,803)><$voicel(1,7)>How’s the waaater situation around here? Just let me<br>know if you need help watering things...
msgctxt "2022:140"
msgid "<$facial(1,4)><$comeff(1,3)><$motion(1,803)><$voicel(1,7)>¿Tienes suficiente agüica? Si necesitas más, yo te ayudo."
msgstr "<$facial(1,4)><$comeff(1,3)><$motion(1,803)><$voicel(1,7)>¿Tienes suficiente agüita? Si necesitas más, yo te ayudo."

#. en: <$comeff(1,6)><$motion(1,666)><$voicel(1,9)>Machines like electricity, riiight? I wonder if my electricity<br>could power some of them?
msgctxt "2022:141"
msgid "<$motion(1,666)><$voicel(1,9)>Cómo les gusta la electricidad a las maquinicas, ¿eeeh?<br><$comeff(1,6)>¿Crees que si les doy de la mía se pondrán en marcha?"
msgstr "<$motion(1,666)><$voicel(1,9)>Cómo les gusta la electricidad a las maquinitas, ¿eeeh?<br><$comeff(1,6)>¿Crees que si les doy de la mía se pondrán en marcha?"

#. en: <$comeff(1,21)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>I’m a big fan of grass and veggies and aaall that... Take me<br>with you if there’s anything you need help growing.
msgctxt "2022:142"
msgid "<$comeff(1,21)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Uf, es ver planticas o verduricas y tengo que abonarlas,<br>es superior a mí. Si necesitas abonar algo, llévame allí."
msgstr "<$comeff(1,21)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Uf, es ver plantitas o verduritas y tengo que abonarlas,<br>es superior a mí. Si necesitas abonar algo, llévame allá."

#. en: <oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,14)>I reeeaaally wanna give you some<br><$cdef(27)><fqty(2)><class><pdcitem;2></color>.<slide><br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>I’ll<slide><br>put<slide><br>some<slide><br>out<slide><br>around<slide><br>my<slide><br>home<slide><br>sometimes, OK?
msgctxt "2022:143"
msgid "<oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,14)>Tengo un montón de<br><$cdef(27)><fqty(2)><class><pdcitem;2></color><slide><br>pa ti.<clear><br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Te <gen;2(los,las)> voy dejando por mi casica, ¿eh?"
msgstr "<oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,14)>Tengo un montón de<br><$cdef(27)><fqty(2)><class><pdcitem;2></color><slide><br>pa ti.<clear><br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Te <gen;2(los,las)> voy dejando por mi casita, ¿eh?"

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Have you heeeaaard? Doing <$cdef(27)><$spwfull(12)>s </color>at the<br><$cdef(27)><fqty(1)><$ifull(1325)> </color>is gonna be the next biiig thing.
msgctxt "2022:144"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>¿Sabes qué? La nueva moda será ponerse a <$cdef(27)><$spwfull(12)></color><br>en la <$cdef(27)><fqty(1)><$ifull(1325)></color>, te lo digo yo."
msgstr ""

#. en: <oneline><$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,5)>You sure have a lot of stuuuff, <$cdef(27)><pname;0></color>.<br>I<slide><br>can<slide><br>help<slide><br>you<slide><br>store<slide><br>some<slide><br>if<slide><br>you want.
msgctxt "2022:145"
msgid "<$cdef(27)><$comeff(1,1)></color><$facial(1,4)><$motion(1,803)><$voicel(1,5)>Veo que tienes un montón de cacharros... Si quieres, yo<br>te guardo algo."
msgstr ""

#. en: <$comeff(1,10)><$facial(1,4)><$motionoff(1,804)><$voicel(1,9)>You might not believe me, but I’m really good at<br>singing and daaancing and hyping everybody up. ♪
msgctxt "2022:146"
msgid "<$comeff(1,10)><$facial(1,4)><$motionoff(1,804)><$voicel(1,9)>Se me da de cine animar el guateque con mis canciones<br>y bailecicos, aunque no lo parezca."
msgstr "<$comeff(1,10)><$facial(1,4)><$motionoff(1,804)><$voicel(1,9)>Se me da genial animar la fiesta con mis canciones<br>y bailecitos, aunque no lo parezca."

#. en: <oneline><$comeff(1,6)><$facial(1,2)><$motion(1,666)><$voicel(1,6)>This place has really strong <$cdef(27)><wndhmownerpk;0><br></color>vibes.<clear><br><$comeff(1,12)><$facial(1,3)><$motion(1,803)><$voicel(1,5)>Oh waaaiiit... Is this <$cdef(27)><wndhmownerpk;1></color>’s home?
msgctxt "2022:148"
msgid "<oneline><$comeff(1,6)><$facial(1,2)><$motion(1,666)><$voicel(1,6)>Esto me recuerda <esa;0()><$cdef(27)><wndhmownerpk;0></color>,<br>¿a ti no?<clear><br><$comeff(1,12)><$facial(1,3)><$motion(1,803)><$voicel(1,5)>Anda, leñe... No me digas que...<br>¿<dart;1()><$cdef(27)><wndhmownerpk;1></color><slide><br>vive aquí?"
msgstr "<oneline><$comeff(1,6)><$facial(1,2)><$motion(1,666)><$voicel(1,6)>Esto me recuerda <esa;0()><$cdef(27)><wndhmownerpk;0></color>,<br>¿a ti no?<clear><br><$comeff(1,12)><$facial(1,3)><$motion(1,803)><$voicel(1,5)>Vaya, vaya... No me digas que...<br>¿<dart;1()><$cdef(27)><wndhmownerpk;1></color><slide><br>vive aquí?"

#. en: <$comeff(1,9)><$facial(1,2)><$motion(1,805)><$voicel(1,7)>This area’s kind of interestiiing, isn’t it? I’ll have to come<br>have some fun here again sometime...
msgctxt "2022:149"
msgid "<$comeff(1,9)><$facial(1,2)><$motion(1,805)><$voicel(1,7)>Esta zona tiene su aquel, ¿eh? Voy a tener que venir<br>a echar el rato aquí más a menudo."
msgstr "<$comeff(1,9)><$facial(1,2)><$motion(1,805)><$voicel(1,7)>Esta zona tiene su encanto, ¿eh? Voy a tener que<br>venir a pasar el rato aquí más a menudo."

#. en: <oneline><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Hehehe. This <$cdef(27)><fqty(1)><class><usingp;0><br></color>is<slide><br>reeeaaally<slide><br>fun.<slide><br>I<slide><br>could<slide><br>play<slide><br>with<slide><br>it foreeever.
msgctxt "2022:150"
msgid "<oneline><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Ja, ja! Qué divertid<genqty;0(o,a,os,as)><br><dart;0()><$cdef(27)><fqty(1)><class><usingp;0></color>.<slide><br>Si es que<slide><br>no me canso."
msgstr ""

#. en: <oneline><$comeff(1,6)><$motion(1,666)><$voicel(1,7)>This is...<iart;0()><$cdef(27)><fqty(1)><class><usingp;0></color>?<br>What’s<slide><br>it fooor?
msgctxt "2022:151"
msgid "<oneline><$comeff(1,6)><$motion(1,666)><$voicel(1,7)>¿<fcap><iart;0()><$cdef(27)><fqty(1)><class><usingp;0></color>?<br>¿Y esto cómo se usa?"
msgstr ""

#. en: <oneline><$comeff(1,8)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>This <$cdef(27)><fqty(1)><class><usingp;0> </color>is<br>sooo<slide><br>cute.<slide><br>Don’t<slide><br>you think?
msgctxt "2022:152"
msgid "<oneline><$comeff(1,8)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>¡Qué cosa más majica est<genqty;0(e,a,os,as)><br><$cdef(27)><fqty(1)><class><usingp;0></color>!<slide><br>¿Verdad que sí?"
msgstr "<oneline><$comeff(1,8)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>¡Qué cosa más bonita est<genqty;0(e,a,os,as)><br><$cdef(27)><fqty(1)><class><usingp;0></color>!<slide><br>¿Verdad que sí?"

#. en: <$comeff(1,14)>...<wait(1.0)><$comeff(1,5)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Oh, heyyy. Sorry...I’m just really interested in this<br><$cdef(27)><fqty(1)><class><usingp;0></color>.
msgctxt "2022:153"
msgid "<oneline><$comeff(1,14)>...<wait(1.0)> <$comeff(1,5)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Uy, si no te había visto siquiera. Perdona, es que me<br>he quedado anonadad<gen;-3(o,a)> mirando est<genqty;0(e,a,os,as)><slide><br><$cdef(27)><fqty(1)><class><usingp;0></color>."
msgstr "<oneline><$comeff(1,14)>...<wait(1.0)> <$comeff(1,5)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Uy, si no te había visto siquiera. Perdona, es que me<br>quedé anonadad<gen;-3(o,a)> mirando est<genqty;0(e,a,os,as)><slide><br><$cdef(27)><fqty(1)><class><usingp;0></color>."

#. en: <oneline><$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>I think eeeverybody should have<br><iart;0()><$cdef(27)><fqty(1)><class><usingp;0></color><slide><br>in<slide><br>their life.
msgctxt "2022:155"
msgid "<oneline><$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>La vida es mejor con<br><iart;0()><$cdef(27)><fqty(1)><class><usingp;0></color>,<slide><br>siiin duda."
msgstr ""

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Heyyy... Doesn’t this sort of look like me? That makes me<br>kind of happy.
msgctxt "2022:156"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>¡Ahí va! ¿No crees que esto se parece un montón a mí?<br>Qué ilusióoon."
msgstr "<$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>¡Vaya! ¿No crees que esto se parece un montón a mí?<br>Qué emocióoon."

#. en: <$comeff(1,13)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>*munch munch munch* Mmm... This is yuuummy.
msgctxt "2022:157"
msgid "<$comeff(1,13)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>Mmm... Bueno, bueno. Esto está de vicio."
msgstr "<$comeff(1,13)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>Mmm... Bueno, bueno. Esto está buenísimo."

#. en: <$comeff(1,6)><$facial(1,4)><$voicel(1,5)>Hm? This iiis...not yummy? <wait(0.3)>Hmmm... <wait(0.5)><$comeff(1,9)><$motion(1,801)>Well, I guess it’s all<br>the same once it’s in my tummy.
msgctxt "2022:158"
msgid "<$comeff(1,6)><$facial(1,4)><$voicel(1,5)>¿Hmm? Pues no me agrada mucho...<wait(0.3)><br><wait(0.5)><$comeff(1,9)><$motion(1,801)>Pero bueno, mientras calme las tripas..."
msgstr ""

#. en: <oneline><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>Heyyy, <$cdef(27)><pname;0></color>. Doin’ cool stuff as<br>usual<slide><br>today,<slide><br>huh? Yaaay!
msgctxt "2022:159"
msgid "<$cdef(27)><$comeff(1,10)></color><$facial(1,4)><$motion(1,801)><$voicel(1,10)>Hola, majet<gen;-2(e,a)>. Jo, hoy también dándolo todo, ¿eeeh?"
msgstr "<$cdef(27)><$comeff(1,10)></color><$facial(1,4)><$motion(1,801)><$voicel(1,10)>Hola, jef<gen;-2(e,a)>. Vaya, hoy también dándolo todo, ¿eeeh?"

#. en: <$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Whoooaaa, did you see that? That was a pretty cool thing<br><$cdef(27)><blsspwkpk;0> </color>did.
msgctxt "2022:160"
msgid "<oneline><$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>¿Has visto eso? Jo con <dart;0()><$cdef(27)><blsspwkpk;0></color>, me ha<br>dejado<slide><br>patidifus<gen;-3(o,a)>."
msgstr "<oneline><$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>¿Viste eso? Vaya con <dart;0()><$cdef(27)><blsspwkpk;0></color>, me<br>dejó<slide><br>boquiabiert<gen;-3(o,a)>."

#. en: <$comeff(1,10)><$facial(1,4)><$motionoff(1,804)><$voicel(1,9)>Heheheee... You’d never know it, but I’m actually<br>kinda fast.
msgctxt "2022:161"
msgid "<$comeff(1,10)><$facial(1,4)><$motionoff(1,804)><$voicel(1,9)>Ja, ja, ja. Esto no te lo esperabas, ¿verdad que no?<br>¡Raud<gen;-3(o,a)> y veloooz!"
msgstr ""

#. en: <oneline><$comeff(1,13)><$facial(1,4)><$motion(1,803)><$voicel(1,7)><$cdef(27)><nnowpairpk;0> </color>and I kinda go about life at<br>the<slide><br>saaame pace.
msgctxt "2022:162"
msgid "<oneline><$comeff(1,13)><$facial(1,4)><$motion(1,803)><$voicel(1,7)><fcap><esa;0()><$cdef(27)><nnowpairpk;0></color> y a mí nos gusta ir<br>al mismo ritmo,<slide><br>por eso<slide><br>nos llevamos tan bien."
msgstr ""

#. en: <$comeff(1,16)><$facial(1,14)><$motion(1,807)><$voicel(1,5)>*yaaawn* I wonder what kind of dreams I’ll have toniiight.
msgctxt "2022:163"
msgid "<$comeff(1,16)><$facial(1,14)><$motion(1,807)><$voicel(1,5)>Uaaah... A ver si sueño algo bonico hoy..."
msgstr "<$comeff(1,16)><$facial(1,14)><$motion(1,807)><$voicel(1,5)>Uaaah... A ver si sueño algo bonito hoy..."

#. en: <$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Dinner sure was yummy today. I wonder what I’ll have<br>for breakfast tomorrow...
msgctxt "2022:164"
msgid "<$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Válgame, qué rica estaba la cena. Ahora toca pensar en<br>el desayuno de mañana."
msgstr ""

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,5)>Everybody else is starting to wake up... Guess it’s time<br>for me to gooo to sleep.
msgctxt "2022:165"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,5)>Se están empezando a despertar todos. Eso es que me<br>toca irme al catre a mí."
msgstr "<$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,5)>Se están empezando a despertar todos. Eso es que me<br>toca irme a la cama a mí."

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Hey, you knooow... My own snoring woke me up the<br>other day...
msgctxt "2022:166"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>El otro día me desperté con mis propios ronquidos,<br>¿te lo puedes creer?"
msgstr ""

#. en: <$comeff(1,3)><$motion(1,666)><$voicel(1,5)>I’ve flown reeeaaally high before, but I can’t seem to fly<br>higher than the sky...
msgctxt "2022:167"
msgid "<$comeff(1,3)><$motion(1,666)><$voicel(1,5)>Por muy alto que vuele, nunca he llegado más alto que<br>el cielo..."
msgstr ""

#. en: <$comeff(1,14)><$motion(1,803)><$voicel(1,5)>My body gets reeeaaally hot on hot days and reeeaaally<br>cold on cold days, <$comeff(1,7)><$motion(1,802)><$facial(1,9)><$voicel(1,3)>so nobody wants to cuddle with me...
msgctxt "2022:168"
msgid "<$comeff(1,14)><$motion(1,803)><$voicel(1,5)>Los días de calor tengo el cuerpo ardiendo, y los días<br>fríos lo tengo helado...<clear><br><$comeff(1,7)><$motion(1,802)><$facial(1,9)><$voicel(1,3)>Nadie quiere arrejuntarse conmigo..."
msgstr "<$comeff(1,14)><$motion(1,803)><$voicel(1,5)>Los días de calor tengo el cuerpo ardiendo, y los días<br>fríos lo tengo helado...<clear><br><$comeff(1,7)><$motion(1,802)><$facial(1,9)><$voicel(1,3)>Nadie quiere acurrucarse conmigo..."

#. en: <$comeff(1,14)><$voicel(1,4)>My poison is reeeaaal dangerous, so you don’t wanna<br>make me mad... <wait(0.6)><$voicel(1,7)><$comeff(1,9)><$motion(1,803)><$facial(1,4)>Juuust kidding. Heheheee!
msgctxt "2022:169"
msgid "<$comeff(1,14)><$voicel(1,4)>Mi veneno es muy peligroso, así que más te vale no<br>hacerme enfadar... <wait(0.6)><$voicel(1,7)><$comeff(1,9)><$motion(1,803)><$facial(1,4)>♪Que es brooomaaa, <gen;-2(hombre,mujer)>.♪"
msgstr "<$comeff(1,14)><$voicel(1,4)>Mi veneno es muy peligroso, así que más te vale no<br>hacerme enojar... <wait(0.6)><$voicel(1,7)><$comeff(1,9)><$motion(1,803)><$facial(1,4)>♪Que es brooomaaa, <gen;-2(hombre,mujer)>.♪"

#. en: <$comeff(1,14)><$voicel(1,5)><$motion(1,805)>Sometimes, when I wake up, I have little rocks and<br>things stuck in my squishy skin...
msgctxt "2022:170"
msgid "<$comeff(1,14)><$voicel(1,5)><$motion(1,805)>A veces, cuando me despierto, me encuentro piedricas<br>metidas en el cuerpo."
msgstr "<$comeff(1,14)><$voicel(1,5)><$motion(1,805)>A veces, cuando me despierto, me encuentro piedritas<br>metidas en el cuerpo."

#. en: <$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>My body’s made of really hard stuff, you knooow? So you<br>can totally count on me during hard times. Heheheee!
msgctxt "2022:171"
msgid "<$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Que sepas que tengo el cuerpo durísimo, así que puedes<br>contar conmigo si necesitas a alguien robust<gen;-3(o,a)>. Ja, ja."
msgstr ""

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,805)><$voicel(1,5)>Please forgive me if I lag behind a little when I follow you<br>around, <$cdef(27)><pname;0></color>...
msgctxt "2022:172"
msgid "<$cdef(27)><$comeff(1,10)></color><$facial(1,4)><$motion(1,805)><$voicel(1,5)>Si me quedo atrás cuando te sigo, no me lo tengas en<br>cuenta, maj<gen;-2(o,a)>, que hago lo que puedo."
msgstr "<$cdef(27)><$comeff(1,10)></color><$facial(1,4)><$motion(1,805)><$voicel(1,5)>Si me quedo atrás cuando te sigo, no me lo tengas en<br>cuenta, amig<gen;-2(o,a)>, que hago lo que puedo."

#. en: <$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>I’m finding all kinds of food really yummy recently...<br>Maybe I’ll grow eeeven bigger?
msgctxt "2022:173"
msgid "<$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Últimamente estoy probando todo tipo de comida.<br>Voy a acabar más grandull<gen;-3(ón,ona)> aún."
msgstr "<$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Últimamente estoy probando todo tipo de comida.<br>Voy a acabar más grandul<gen;-3(ón,ona)> aún."

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>You can come hang out with me on cold days. I’ll keep<br>you waaarm.
msgctxt "2022:174"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Cuando haga frío, ven a mi vera, que conmigo se está<br>calentico."
msgstr "<$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Cuando haga frío, ven a mi lado, que conmigo se está<br>calientito."

#. en: <$comeff(1,14)><$facial(1,4)><$motion(1,666)><$voicel(1,7)>Why is the sound of flowing water sooo comforting?
msgctxt "2022:175"
msgid "<$comeff(1,14)><$facial(1,4)><$motion(1,666)><$voicel(1,7)>No se me ocurre na más placentero que el sonido<br>del agua que corre."
msgstr ""

#. en: <$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Getting some sunlight makes the body really haaappy,<br>you know? You should try it...
msgctxt "2022:176"
msgid "<$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>¿Sabías que la luz del sol es buena pa crecer fuerte?<br>Ya verás, majet<gen;-2(e,a)>, pruébalo."
msgstr "<$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>¿Sabías que la luz del sol es buena pa crecer fuerte?<br>Ya verás, jef<gen;-2(e,a)>, pruébalo."

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>I feel like I move way faaaster than usual when my body’s<br>charged with electricity.
msgctxt "2022:177"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Cuando tengo el cuerpo cargadico de electricidad,<br>me da la sensación de que me muevo más deprisa."
msgstr "<$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Cuando tengo el cuerpo cargadito de electricidad,<br>me da la sensación de que me muevo más rápido."

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>Life is good, and it will keep being good tomooorrow and<br>the next day and the next day and the next day...<clear><br><$emotion(1,38)><$voicel(1,10)>I don’t have to read the future to know thaaat...
msgctxt "2022:178"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>Mañana estaré feliz que da gusto y pasao mañana será<br>aún mejor. <$emotion(1,38)><$voicel(1,10)>No me hace falta ver el futuro pa saberlo."
msgstr ""

#. en: <$comeff(1,7)><$motion(1,802)><$voicel(1,5)>It’s kind of saaad to have no humans around to be scared<br>of me...
msgctxt "2022:180"
msgid "<$comeff(1,7)><$motion(1,802)><$voicel(1,5)>Sin humanos a los que asustar, me aburro cosa mala."
msgstr "<$comeff(1,7)><$motion(1,802)><$voicel(1,5)>Sin humanos a los que asustar, me aburro muchísimo."

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>Ooooh. Looks like more Pokémon have come around...<br>I wonder what they’re like.
msgctxt "2022:181"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>¡Dicen que tenemos algún Pokémon nuevo en<br>el vecindario! ¿Qué tal será?"
msgstr ""

#. en: <$comeff(1,3)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>You’re <$cdef(27)><pname;0></color>, riiight? Hellooo.
msgctxt "2022:182"
msgid "<$comeff(1,3)><$facial(1,4)><$motion(1,803)><$voicel(1,7)><$cdef(27)><pname;0></color>, ¿no? ¡Me alegro de verte!"
msgstr ""

#. en: <oneline><$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Good mooorning, <$cdef(27)><pname;0></color>. I see you’re<br>working<slide><br>hard<slide><br>again today.
msgctxt "2022:183"
msgid "<oneline><$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Buenos días, <$cdef(27)><pname;0></color>. Déjame adivinar...<br>Hoy también<slide><br>vas a darlo todo, ¿no?"
msgstr ""

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>It’s sooo sunny and nice. Perfect day for a nap. Yeeeaaah.
msgctxt "2022:184"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>Qué gusto da cuando hace este tiempo tan despejado.<br>Se presta estupendamente pa echarse una siestecica."
msgstr "<$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>Qué gusto da cuando hace este tiempo tan despejado.<br>Se presta estupendamente pa echarse una siestecita."

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>Ahhh... The moon is so pretty. Maybe it’s a good night for<br>me to stay up laaate.
msgctxt "2022:185"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>Aaah, la luna está hoy tan bonica que da gusto verla.<br>Hasta da rabia tener que irse a dormir."
msgstr "<$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>Aaah, la luna está hoy tan bonita que da gusto verla.<br>Hasta da rabia tener que irse a dormir."

#. en: <$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Yaaay, rain! I wonder if somebody used Raaaiiin Dance!
msgctxt "2022:186"
msgid "<$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>♪¡Por fin, lluviaaa!♪ ¿Estará desafinando alguien?<br>¿O habrán usado Danza Lluvia?"
msgstr "<$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>♪¡Por fin, lluviaaa!♪ ¿Estará desafinando alguien?<br>¿O habrán usado Danza de Lluvia?"

#. en: <$comeff(1,4)><$motion(1,803)><$voicel(1,5)>Oh nooo, it’s raaaiiining! Gotta find shelter. Gotta<br>find shelter...
msgctxt "2022:187"
msgid "<$comeff(1,4)><$motion(1,803)><$voicel(1,5)>¡Menudos chuzos están cayendo! ¡A cubiertooo!"
msgstr "<$comeff(1,4)><$motion(1,803)><$voicel(1,5)>¡Está lloviendo a cántaros! ¡A cubiertooo!"

#. en: <$comeff(1,16)><$motion(1,803)><$voicel(1,5)>Sooo many clouds today... Seems like a good day to just<br>take it easy.
msgctxt "2022:188"
msgid "<$comeff(1,16)><$motion(1,803)><$voicel(1,5)>Buf, qué nublado está hoy. En días como este, lo que me<br>apetece es tomarme las cosicas con muuucha calma."
msgstr "<$comeff(1,16)><$motion(1,803)><$voicel(1,5)>Buf, qué nublado está hoy. En días como este, lo que<br>quiero es tomarme las cositas con muuucha calma."

#. en: <$comeff(1,6)><$motion(1,666)><$voicel(1,5)>That thingy on <$cdef(27)>Professor Tangrowth</color>’s<$cdef(27)> </color>head is kinda fancy...<br>Don’t you thiiink?
msgctxt "2022:189"
msgid "<$comeff(1,6)><$motion(1,666)><$voicel(1,5)>Eso que lleva el<$cdef(27)> Profesor Tangrowth</color> en la cabeza...<br>no sé qué es, pero le queda bien, ¿no?"
msgstr ""

#. en: <$voicel(1,7)><$motion(1,803)><$comeff(1,10)>Here we gooo. It’s demolition tiiime.
msgctxt "2022:190"
msgid "<$voicel(1,7)><$motion(1,803)><$comeff(1,10)>¡Haaale! A demoler toca."
msgstr "<$voicel(1,7)><$motion(1,803)><$comeff(1,10)>¡Vaaamos! A demoler toca."

#. en: <$voicel(1,5)><$motion(1,807)><$comeff(1,10)>Ohhh, I’m so hungry... I hope we can start cooking soooon.
msgctxt "2022:191"
msgid "<$voicel(1,5)><$motion(1,807)><$comeff(1,10)>¡Qué haaambre! Habrá que ponerse al lío."
msgstr "<$voicel(1,5)><$motion(1,807)><$comeff(1,10)>¡Qué haaambre! ¡Manos a la obra!"

#. en: <oneline><$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)><$pkcry;0(1,1)>... <$pkcry;1(1,1)>! I’m having so much<br>fuuun!<$comcan(1)>
msgctxt "2022:192"
msgid "<oneline><$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡<$pkcry;0(1,1)>, <flow><$pkcry;1(1,1)>!<br>¡Qué emocionante todo!<$comcan(1)>"
msgstr ""

#. en: <oneline><$comeff(1,8)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>This is so much fuuun, <$cdef(27)><pname;0></color>! I wish<br>we<slide><br>could<slide><br>hang<slide><br>out<slide><br>foreeever.
msgctxt "2022:193"
msgid "<oneline><$comeff(1,8)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>¡Estoy disfrutando como <gen;-3(un,una)> enan<gen;-3(o,a)>,<br><$cdef(27)><pname;0></color>!<clear><br>¡Me pasaría todos los días yendo contigo de aquí p'allá!"
msgstr "<oneline><$comeff(1,8)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>¡Estoy disfrutando como <gen;-3(un,una)> niñ<gen;-3(o,a)>,<br><$cdef(27)><pname;0></color>!<clear><br>¡Me pasaría todos los días yendo contigo de aquí p'allá!"

#. en: <oneline><$comeff(1,6)><$facial(1,2)><$motion(1,803)><$voicel(1,5)>Hm? What’s uuup, <$cdef(27)><pname;0></color>? Are you<br>getting<slide><br>hungry?
msgctxt "2022:194"
msgid "<oneline><$comeff(1,6)><$facial(1,2)><$motion(1,803)><$voicel(1,5)>¿Qué te pasa, <$cdef(27)><pname;0></color>? ¿Tienes<br>hambre, granujilla?"
msgstr "<oneline><$comeff(1,6)><$facial(1,2)><$motion(1,803)><$voicel(1,5)>¿Qué te pasa, <$cdef(27)><pname;0></color>? ¿Tienes<br>hambre, granujita?"

#. en: <$comeff(1,9)><$facial(1,5)><$motion(1,801)><$voicel(1,9)>Hehehe... Sitting around at home is greeeaaat for a nice,<br>relaxing little talk.
msgctxt "2022:195"
msgid "<$comeff(1,9)><$facial(1,5)><$motion(1,801)><$voicel(1,9)>Ja, ja, ja. ¡Hasta en casa acabamos de parloteo tú y yo!"
msgstr ""

#. en: <$comeff(1,6)><$facial(1,2)><$motion(1,805)><$voicel(1,7)>Heyyy, have you seen the craaazy feathers you can<br>find on the ground here every now and then?<clear><br><$comeff(1,3)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Sometimes they’re on fiiire, sometimes they’re creating<br>their own little gusts of wiiind... Really surprising to see...
msgctxt "2022:196"
msgid "<$comeff(1,6)><$facial(1,2)><$motion(1,805)><$voicel(1,7)>Por aquí, de vez en cuando cae alguna plumica bien rara,<br>¿lo sabías, pillastre?<clear><br><$comeff(1,3)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Algunas, cubiertas por las llamas... Otras, por el viento...<br>Me llevé una sorpresa de aúpa la primera vez que vi una."
msgstr "<$comeff(1,6)><$facial(1,2)><$motion(1,805)><$voicel(1,7)>Por aquí, de vez en cuando cae alguna plumita bien rara,<br>¿lo sabías?<clear><br><$comeff(1,3)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Algunas, cubiertas por las llamas... Otras, por el viento...<br>Me llevé una sorpresa enorme la primera vez que vi una."

#. en: <$comeff(1,7)><$facial(1,9)><$motion(1,806)><$voicel(1,3)>I scared someone the other day just by looooking them<br>in the eyes for a second...<clear><br><$comeff(1,3)><$facial(1,2)><$motion(1,807)><$voicel(1,4)>I didn’t meeeaaan to... It made me kind of saaad...
msgctxt "2022:200"
msgid "<$comeff(1,7)><$facial(1,9)><$motion(1,806)><$voicel(1,3)>El otro día crucé la mirada con otro Pokémon un<br>momentico de na, y no sabes el tembleque que le entró<slide><br>al paisano... <$comeff(1,3)><$facial(1,2)><$motion(1,807)><$voicel(1,4)>¡Y el mal cuerpo que se me quedó a mí!"
msgstr "<$comeff(1,7)><$facial(1,9)><$motion(1,806)><$voicel(1,3)>El otro día crucé la mirada con otro Pokémon un<br>momentito de na, y no sabes el tembleque que le entró<slide><br>al pobre... <$comeff(1,3)><$facial(1,2)><$motion(1,807)><$voicel(1,4)>¡Y lo mal que me sentí yo!"

#. en: <oneline><$voicel(1,5)><$emotion(1,14)>I really waaaant <$cdef(27)><nquestinum;1><br><class><nquestitem;0></color>...<clear><br><$voicel(1,8)><$emotion(1,8)>I would be sooo happy if you could share...
msgctxt "2022:201"
msgid "<oneline><$voicel(1,5)><$emotion(1,14)>Me hac<qty;1(e,en)> falta <$cdef(27)><nquestinum;1></color><br><$cdef(27)><class><nquestitem;0></color>.<slide><br><$voicel(1,8)><$emotion(1,8)>¿No tendrás por ahí pa darme?"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,8)>Ohhh, for meee? Thank you so much.
msgctxt "2022:202"
msgid "<$voicel(1,7)><$emotion(1,8)>¡Ah! ¡Graaacias! Qué maj<gen;-2(o,a)> que eres."
msgstr "<$voicel(1,7)><$emotion(1,8)>¡Ah! ¡Graaacias! Qué lind<gen;-2(o,a)> que eres."

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>Aren’t places like this niiice? I would be sooo happy if you<br>would make something like this for me.
msgctxt "2022:203"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>¡Sería la repera si pudieras buscarme un lugar así de chulo!"
msgstr "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>¡Sería genial si pudieras buscarme un lugar así de bonito!"

#. en: <$voicel(1,7)><$emotion(1,39)>Thanks sooo much, <$cdef(27)><pname;0></color>.
msgctxt "2022:204"
msgid "<$voicel(1,7)><$emotion(1,39)>Muchas gracias, <$cdef(27)><pname;0></color>."
msgstr ""

#. en: <$comeff(1,3)><$facial(1,2)><$motion(1,803)><$voicel(1,7)>It would be so niiice if you could clear a path for me to<br>have a nice, leisurely walk...
msgctxt "2022:205"
msgid "<$comeff(1,3)><$facial(1,2)><$motion(1,803)><$voicel(1,7)>Quería que arreglases el caminico para que se pueda<br>pasear en condiciones..."
msgstr "<$comeff(1,3)><$facial(1,2)><$motion(1,803)><$voicel(1,7)>Quería que arreglases el caminito para que se pueda<br>pasear en condiciones..."

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Yaaay, I made it... And it’s all thanks to you.
msgctxt "2022:206"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>De no haber sido por ti, no lo habría conseguido.<br>¡Muchas gracias, maj<gen;-2(o,a)>!"
msgstr "<$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>De no haber sido por ti, no lo habría conseguido.<br>¡Muchas gracias, amig<gen;-2(o,a)>!"

#. en: <$comeff(1,3)><$facial(1,3)><$motion(1,803)><$voicel(1,5)>Ohhh... You already have what I wanted? If you wouldn’t<br>mind, <$motion(1,806)><$voicel(1,8)>could you shaaare with me?
msgctxt "2022:209"
msgid "<$comeff(1,3)><$facial(1,3)><$motion(1,803)><$voicel(1,5)>Aúpa, no sabía que ya tuvieras eso guardaíco en la Bolsa.<br><$motion(1,806)><$voicel(1,8)>¿Me lo puedes dar, <$cdef(27)><pname;0></color>?"
msgstr "<$comeff(1,3)><$facial(1,3)><$motion(1,803)><$voicel(1,5)>Vaya, no sabía que ya tenías eso guardadito en la Bolsa.<br><$motion(1,806)><$voicel(1,8)>¿Me lo puedes dar, <$cdef(27)><pname;0></color>?"

#. en: <$facial(1,2)><$motion(1,802)><$voicel(1,5)>OK... I guess that’s just how it goooeees sometimes...
msgctxt "2022:210"
msgid "<$facial(1,2)><$motion(1,802)><$voicel(1,5)>¡Vaya, hombre! Menudo chasco me he llevao."
msgstr "<$facial(1,2)><$motion(1,802)><$voicel(1,5)>¡Vaya, hombre! Qué chasco me llevé."

#. en: <oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,6)>Do you know where <$cdef(27)><nquestappk;0></color> is? I wanna go<br>and<slide><br>hang out...<clear><br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>If you knooow, could you take me there?
msgctxt "2022:212"
msgid "<oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,6)>¿Sabes por dónde anda <dart;0()><$cdef(27)><nquestappk;0></color>? Tenía ganas<br>de charlar<slide><br>con <gen;0(él,ella)> un ratico...<clear><br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¿Me llevas hasta <gen;0(él,ella)>?"
msgstr "<oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,6)>¿Sabes por dónde anda <dart;0()><$cdef(27)><nquestappk;0></color>? Tenía ganas<br>de charlar<slide><br>con <gen;0(él,ella)> un ratito...<clear><br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¿Me llevas hasta <gen;0(él,ella)>?"

#. en: <$voicel(1,7)><$emotion(1,8)>We maaade it. Thank you, <$cdef(27)><pname;0></color>.
msgctxt "2022:213"
msgid "<$voicel(1,7)><$emotion(1,8)>¡Aquí está! Gracias, <$cdef(27)><pname;0></color>."
msgstr ""

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>Do you wanna take a picture with me? Come ooon, it’ll<br>be suuuper fun...
msgctxt "2022:214"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>¿Nos sacamos una foto? Ya verás qué risaaas."
msgstr ""

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Wowww. This is the picture we took together? It sure is a<br>good picture. <$voicel(1,10)><$emotion(1,7)>Thanks, <$cdef(27)><pname;0></color>!
msgctxt "2022:215"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>¿A veeer? ¿Es la fotico que nos hemos hecho antes?<br>Mira qué bien hemos salido.<clear><br><$voicel(1,10)><$emotion(1,7)>¡Gracias, <$cdef(27)><pname;0></color>!"
msgstr "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>¿A veeer? ¿Es la fotito que nos tomamos antes?<br>Mira qué bien salimos.<clear><br><$voicel(1,10)><$emotion(1,7)>¡Gracias, <$cdef(27)><pname;0></color>!"

#. en: <$comeff(1,6)><$motion(1,666)><$voicel(1,5)>Waaaiiit... <$cdef(27)><nquestappk;0> </color>is right over there...
msgctxt "2022:217"
msgid "<$comeff(1,6)><$motion(1,666)><$voicel(1,5)>Andaaa, ¿pero cómo estoy tan cegat<gen;-3(o,a)>?<br>¡Si <dart;0()><$cdef(27)><nquestappk;0> </color>está ahí mismo!"
msgstr "<$comeff(1,6)><$motion(1,666)><$voicel(1,5)>Vayaaa, ¿pero cómo estoy tan cieg<gen;-3(o,a)>?<br>¡Si <dart;0()><$cdef(27)><nquestappk;0> </color>está ahí mismo!"

#. en: <$comeff(1,10)><$facial(1,3)><$motionoff(1,804)><$voicel(1,7)>Ummm... Heyyy, I have a favor I want to ask you.
msgctxt "2022:224"
msgid "<$comeff(1,10)><$facial(1,3)><$motionoff(1,804)><$voicel(1,7)>Oye, maj<gen;-2(o,a)>, te quería pedir un favorcico. ¿Me ayudas?"
msgstr "<$comeff(1,10)><$facial(1,3)><$motionoff(1,804)><$voicel(1,7)>Oye, amig<gen;-2(o,a)>, te quería pedir un favorcito. ¿Me ayudas?"

#. en: <$comeff(1,3)><$facial(1,2)><$motion(1,803)><$voicel(1,3)>That’s OK... I would be reeeaaally happy if you could help<br>me out some other time, though.
msgctxt "2022:225"
msgid "<$comeff(1,3)><$facial(1,2)><$motion(1,803)><$voicel(1,3)>Bueno, no pasa na. Si luego tienes un ratico pa<br>escucharme, me dices."
msgstr "<$comeff(1,3)><$facial(1,2)><$motion(1,803)><$voicel(1,3)>Bueno, no pasa na. Si luego tienes un ratito pa<br>escucharme, me dices."

#. en: <oneline><$voicel(1,7)><$motion(1,805)><$comeff(1,10)>It would be sooo fun if I had<br><iart;0()><$cdef(27)><fqty(1)><class><nquestitem;0></color><slide><br>in<slide><br>my home...
msgctxt "2022:226"
msgid "<oneline><$voicel(1,7)><$motion(1,805)><$comeff(1,10)>Me encantaría tener<br><iart;0()><$cdef(27)><fqty(1)><class><nquestitem;0></color><slide><br>en casica..."
msgstr "<oneline><$voicel(1,7)><$motion(1,805)><$comeff(1,10)>Me encantaría tener<br><iart;0()><$cdef(27)><fqty(1)><class><nquestitem;0></color><slide><br>en casita..."

#. en: <$voicel(1,9)><$emotion(1,39)>You got me what I asked for. Yaaayyy! You’re so niiice.
msgctxt "2022:227"
msgid "<$voicel(1,9)><$emotion(1,39)>Anda, mira que eres majet<gen;-2(e,a)>. ¡Si es que vales lo que no<br>está escrito! ¡Gracias!"
msgstr "<$voicel(1,9)><$emotion(1,39)>Ay, jef<gen;-2(e,a)>, qué amable eres. ¡Si es que vales oro!<br>¡Gracias!"

#. en: <$comeff(1,5)><$facial(1,3)><$motion(1,803)><$voicel(1,7)>Wait... Whoooaaa, did you already make what I wanted?
msgctxt "2022:232"
msgid "<$comeff(1,5)><$facial(1,3)><$motion(1,803)><$voicel(1,7)>No me digas que... ¿ya has hecho lo que te quería pedir?"
msgstr "<$comeff(1,5)><$facial(1,3)><$motion(1,803)><$voicel(1,7)>No me digas que... ¿ya hiciste lo que te quería pedir?"

#. en: <$comeff(1,5)><$facial(1,3)><$motion(1,803)><$voicel(1,7)>Ohhh, heyyy, did you already get me what I asked for?
msgctxt "2022:233"
msgid "<$comeff(1,5)><$facial(1,3)><$motion(1,803)><$voicel(1,7)>Jo, no sé por qué me da que... ya me has colocado eso,<br>¿no?"
msgstr "<$comeff(1,5)><$facial(1,3)><$motion(1,803)><$voicel(1,7)>Ay, no sé por qué siento que... ya me colocaste eso,<br>¿no?"

#. en: <$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Whoooaaa... You already did exaaactly what I wanted...
msgctxt "2022:234"
msgid "<$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>¡La leche! ¡Si ya te has encargado de lo que te quería<br>pedir! ¡Eres de lo que no hay, brib<gen;-2(ón,ona)>!"
msgstr "<$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>¡Increíble! ¡Si ya te encargaste de lo que te quería<br>pedir! ¡Eres de lo que no hay, brib<gen;-2(ón,ona)>!"

#. en: <$voicel(1,6)><$emotion(1,14)>Heyyy, I have something I want to ask you about...<clear><br><$voicel(1,3)><$comeff(1,14)>Everybody’s helping me out with something right now,<br><$voicel(1,6)><$motion(1,805)><$comeff(1,6)>and I was wooondering if you could help out too.<slide><br>What do you saaay?
msgctxt "2022:235"
msgid "<$voicel(1,6)><$emotion(1,14)>Oye, <$cdef(27)><pname;0></color>, quería pedirte algo.<clear><br><$voicel(1,3)><$comeff(1,14)>Verás, aquí todo el mundo me está ayudando con una<br>cosica y, como eres tan maj<gen;-2(o,a)>, pues me preguntaba si...<slide><br><$voicel(1,6)><$motion(1,805)><$comeff(1,6)>¿podrías echarme una mano tú también?"
msgstr "<$voicel(1,6)><$emotion(1,14)>Oye, <$cdef(27)><pname;0></color>, quería pedirte algo.<clear><br><$voicel(1,3)><$comeff(1,14)>Verás, aquí todo el mundo me está ayudando con una<br>cosita y, como eres tan buen<gen;-2(o,a)>, pues me preguntaba si...<slide><br><$voicel(1,6)><$motion(1,805)><$comeff(1,6)>¿podrías echarme una mano tú también?"

#. en: <$voicel(1,5)><$motion(1,805)><$comeff(1,14)>You know that thiiing everybody was helping me with?<br><$voicel(1,8)><$emotion(1,39)>We juuust finished... Yaaay!<clear><br><$voicel(1,6)><$motion(1,803)><$comeff(1,9)>I sure hope you’ll help me out again sometime.
msgctxt "2022:236"
msgid "<$voicel(1,5)><$motion(1,805)><$comeff(1,14)>¿Recuerdas esa cosica con la que me estabais ayudando?<br><$voicel(1,8)><$emotion(1,39)>¡Pues ya está lista!<clear><br><$voicel(1,6)><$motion(1,803)><$comeff(1,9)>¡Cuento contigo pa la próxima!"
msgstr "<$voicel(1,5)><$motion(1,805)><$comeff(1,14)>¿Recuerdas esa cosita con la que me estaban ayudando?<br><$voicel(1,8)><$emotion(1,39)>¡Pues ya está lista!<clear><br><$voicel(1,6)><$motion(1,803)><$comeff(1,9)>¡Cuento contigo pa la próxima!"

#. en: <$emotion(1,60)><$voicel(1,5)>I would looove to see a new house in this town. Everyone<br>gets so haaappy when new houses pop up.<clear><br><$emotion(1,39)><$voicel(1,8)>I would be super happy, too...
msgctxt "2022:237"
msgid "<$emotion(1,60)><$voicel(1,5)>Estaría muy bien que hubiese alguna casica humana<br>a estrenar por aquí.<clear><br><$emotion(1,39)><$voicel(1,8)>Me alegraría el día, si te digo la verdad."
msgstr "<$emotion(1,60)><$voicel(1,5)>Estaría muy bien que hubiese alguna casita humana<br>a estrenar por aquí.<clear><br><$emotion(1,39)><$voicel(1,8)>Me alegraría el día, si te digo la verdad."

#. en: <$comeff(1,9)><$motion(1,801)><$voicel(1,9)>Whoooaaa... You built a house? That’s so awesome.<br>Thank yooouuu.
msgctxt "2022:238"
msgid "<$comeff(1,9)><$motion(1,801)><$voicel(1,9)>¡Jo, qué alegría me has dao! ¡Gracias por construir<br>una casica!"
msgstr "<$comeff(1,9)><$motion(1,801)><$voicel(1,9)>¡Ay, qué alegría me diste! ¡Gracias por construir<br>una casita!"

#. en: <oneline><$comeff(1,6)><$motion(1,806)><$voicel(1,7)>I reeeaaally want<br><iart;0()><$cdef(27)><class><nquestitem;0></color>...<slide><br>Do<slide><br>you<slide><br>have any?
msgctxt "2022:239"
msgid "<oneline><$motion(1,806)><$voicel(1,7)>Tengo unas ganas de<br><iart;0()><$cdef(27)><fqty(1)><class><nquestitem;0></color><br>que no veas.<slide><br><$comeff(1,6)>¿No tendrás tú en tu Bolsa?"
msgstr "<oneline><$motion(1,806)><$voicel(1,7)>Tengo unas ganas de<br><iart;0()><$cdef(27)><fqty(1)><class><nquestitem;0></color><br>que no te imaginas.<slide><br><$comeff(1,6)>¿No tendrás tú en tu Bolsa?"

#. en: <oneline><$comeff(1,13)><$facial(1,4)><$motion(1,661)><$voicel(1,9)>You’re so niiice,<$cdef(27)> <pname;0></color>. Thank you<br>for sharing.
msgctxt "2022:240"
msgid "<oneline><$comeff(1,13)><$facial(1,4)><$motion(1,661)><$voicel(1,9)>Si es que eres más maj<gen;-2(o,a)> que las monevitas,<br><$cdef(27)><pname;0></color>.<slide><br>¡Gracias por el tentempié!"
msgstr "<oneline><$comeff(1,13)><$facial(1,4)><$motion(1,661)><$voicel(1,9)>Si es que eres más lind<gen;-2(o,a)> que las monevitas,<br><$cdef(27)><pname;0></color>.<slide><br>¡Gracias por el tentempié!"

#. en: <$comeff(1,3)><$motion(1,801)><$voicel(1,9)>That didn’t take long... Niiice.
msgctxt "2022:241"
msgid "<$comeff(1,3)><$motion(1,801)><$voicel(1,9)>¡Qué pronto se ha solucionao! Mira que me alegro."
msgstr "<$comeff(1,3)><$motion(1,801)><$voicel(1,9)>¡Qué pronto se solucionó! Cómo me alegro."

#. en: <oneline><$comeff(1,9)><$motion(1,801)><$voicel(1,9)>You sure are amaaazing, <$cdef(27)><pname;0></color>.<br>Thank you...
msgctxt "2022:242"
msgid "<oneline><$comeff(1,9)><$motion(1,801)><$voicel(1,9)>¡<$cdef(27)><pname;0></color>, vales pa to! ¡Gracias por<br>encargarte!"
msgstr "<oneline><$comeff(1,9)><$motion(1,801)><$voicel(1,9)>¡<$cdef(27)><pname;0></color>, eres genial! ¡Gracias por<br>encargarte!"

#. en: <$comeff(1,6)><$facial(1,1)><$motion(1,666)><$voicel(1,7)>Whaaat? Whoooaaa... You already had some made? Could<br>I have some if you have any extra?
msgctxt "2022:243"
msgid "<$comeff(1,6)><$facial(1,1)><$motion(1,666)><$voicel(1,7)>¿Cómo? ¿Te me has adelantao? Pos oye, si te sobra,<br>yo no le haría ascos."
msgstr "<$comeff(1,6)><$facial(1,1)><$motion(1,666)><$voicel(1,7)>¿Cómo? ¿Te me adelantaste? Pues oye, si te sobra,<br>yo no diría que no."

#. en: <oneline><$comeff(1,13)><$facial(1,4)><$motion(1,661)><$voicel(1,9)>You’re so niiice,<$cdef(27)> <pname;0></color>. Thank you for<br>sharing.
msgctxt "2022:244"
msgid "<oneline><$comeff(1,13)><$facial(1,4)><$motion(1,661)><$voicel(1,9)>¡<$cdef(27)><pname;0></color>, además de maj<gen;-2(o,a)> eres<br>generos<gen;-2(o,a)>!<slide><br>¡Muchas gracias!"
msgstr "<oneline><$comeff(1,13)><$facial(1,4)><$motion(1,661)><$voicel(1,9)>¡<$cdef(27)><pname;0></color>, además de lind<gen;-2(o,a)> eres<br>generos<gen;-2(o,a)>!<slide><br>¡Muchas gracias!"

#. en: <oneline><$voicel(1,5)><$motion(1,824)><$comeff(1,3)>Heyyy, <$cdef(27)><pname;0></color>. Got a second? I wanna<br>give<slide><br>you<slide><br>this<slide><br>present.<slide><br><$voicel(1,8)><$motion(1,801)><$comeff(1,21)><$facial(1,5)>Thanks<slide><br>for<slide><br>everything<slide><br>you do.<slide><br>I really<slide><br>appreciate<slide><br>it,<slide><br>you knooow?
msgctxt "2022:301"
msgid "<oneline><$voicel(1,5)><$motion(1,824)><$comeff(1,3)>Ey, <$cdef(27)><pname;0></color>, ¿tienes un segundo?<br>Quería darte un detallico<slide><br>por ser tan enrollad<gen;-2(o,a)>.<slide><br><$voicel(1,8)><$motion(1,801)><$comeff(1,21)><$facial(1,5)>¡Gracias mil por todo lo que haces!"
msgstr "<oneline><$voicel(1,5)><$motion(1,824)><$comeff(1,3)>Ey, <$cdef(27)><pname;0></color>, ¿tienes un segundo?<br>Quería darte un detallito<slide><br>por ser tan buen<gen;-2(o,a)>.<slide><br><$voicel(1,8)><$motion(1,801)><$comeff(1,21)><$facial(1,5)>¡Gracias mil por todo lo que haces!"

#. en: <$comeff(1,6)><$motion(1,805)><$voicel(1,5)>You already have sooo many Pokémon walking with you...<br>If you get many more, it might be hard to keep track<slide><br>of everyone...<clear><br><$comeff(1,3)><$motion(1,803)><$voicel(1,6)>I can join you some other tiiime...
msgctxt "2022:302"
msgid "<oneline><$comeff(1,6)><$motion(1,805)><$voicel(1,5)>¿Qué, <$cdef(27)><pname;0></color>? ¿Has salío a estirar las<br>paticas?<clear><br>Te veo mu bien acompañ<gen;-2(ao,á)>, pero como aumente<br>más la comitiva, ¡te me vas a agobiar!<clear><br><$comeff(1,3)><$motion(1,803)><$voicel(1,6)>Ea, disfruta del paseo. Ya te pillaré en otro momento."
msgstr "<oneline><$comeff(1,6)><$motion(1,805)><$voicel(1,5)>¿Qué, <$cdef(27)><pname;0></color>? ¿Saliste a estirar las<br>patitas?<clear><br>Te veo mu bien acompañ<gen;-2(ao,á)>, pero como aumente<br>más la comitiva, ¡te me vas a agobiar!<clear><br><$comeff(1,3)><$motion(1,803)><$voicel(1,6)>Bueno, disfruta del paseo. Ya te alcanzo luego."

#. en: <$comeff(1,4)><$motion(1,802)><$voicel(1,3)>I’m a little busy right now... Can we maybe do it laaater?
msgctxt "2022:303"
msgid "<$comeff(1,4)><$motion(1,802)><$voicel(1,3)>Ay, majet<gen;-2(e,a)>, me has pillao ocupadic<gen;-3(o,a)>. ¿Te importa volver<br>más tarde?"
msgstr "<$comeff(1,4)><$motion(1,802)><$voicel(1,3)>Ay, jef<gen;-2(e,a)>, me agarraste ocupadit<gen;-3(o,a)>. ¿Te importa volver<br>más tarde?"

#. en: <$voicel(1,7)><$emotion(1,8)>Heave-hooo. I guess even working hard is kinda fun<br>sometimes. Wooo.
msgctxt "2022:304"
msgid "<$voicel(1,7)><$emotion(1,8)>¡Un, dos, un dos! Esto de <$cdef(27)><$spwfull(1)> </color>dándolo todo<br>también tiene su gracia."
msgstr ""

#. en: <$voicel(1,6)><$emotion(1,50)>OK, here we gooo.
msgctxt "2022:305"
msgid "<$voicel(1,6)><$emotion(1,50)>Contigo adonde haga falta."
msgstr ""

#. en: <$voicel(1,5)><$emotion(1,14)>Is this as far as we’re going? OK... See you laaater, then.
msgctxt "2022:306"
msgid "<$voicel(1,5)><$emotion(1,14)>¿Ya está? Pues hala, haaasta otra."
msgstr "<$voicel(1,5)><$emotion(1,14)>¿Ya está? Pues bueno, haaasta otra."

#. en: <$comeff(1,7)><$facial(1,9)><$motion(1,806)><$voicel(1,3)>I reeeaaally want to go with you, but I’m too huuungry to<br>move... Sorry...
msgctxt "2022:307"
msgid "<$comeff(1,7)><$facial(1,9)><$motion(1,806)><$voicel(1,3)>Mira que me gustaría darme un paseíco contigo, pero es<br>que con la panza vacía no tengo fuerzas pa moverme..."
msgstr "<$comeff(1,7)><$facial(1,9)><$motion(1,806)><$voicel(1,3)>Mira que me gustaría darme un paseíto contigo, pero es<br>que con la panza vacía no tengo fuerzas pa moverme..."

#. en: <$comeff(1,18)><$facial(1,9)><$motion(1,802)><$voicel(1,1)>Ohhh nooo, I’m so huuungry all of a sudden... I can’t<br>take another step...
msgctxt "2022:308"
msgid "<$comeff(1,18)><$facial(1,9)><$motion(1,802)><$voicel(1,1)>Jo, qué hambre, no puedo dar ni un paso más... Aquí me<br>quedo..."
msgstr "<$comeff(1,18)><$facial(1,9)><$motion(1,802)><$voicel(1,1)>Ay, qué hambre, no puedo dar ni un paso más... Aquí me<br>quedo..."

#. en: <$comeff(1,3)><$motion(1,805)><$voicel(1,5)>It’s raaaiiining... Guess I’ll head home for the day...
msgctxt "2022:311"
msgid "<$comeff(1,3)><$motion(1,805)><$voicel(1,5)>¡Cómo cae! ¡Cuando llueve así, lo mejor es refugiarse<br>cada uno en su casica!"
msgstr "<$comeff(1,3)><$motion(1,805)><$voicel(1,5)>¡Cómo cae! ¡Cuando llueve así, lo mejor es refugiarse<br>cada uno en su casita!"

#. en: <$voicel(1,3)><$motion(1,807)><$comeff(1,5)><$facial(1,13)>Whoooaaa! That really surprised me... Maybe don’t do that<br>to any other Pokémon, OK?
msgctxt "2022:315"
msgid "<$voicel(1,3)><$motion(1,807)><$comeff(1,5)><$facial(1,13)>¡Vaya susto me has dado! No hagas eso, ¿vale?<br>Podrías hacerle daño a alguien..."
msgstr "<$voicel(1,3)><$motion(1,807)><$comeff(1,5)><$facial(1,13)>¡Vaya susto me diste! No hagas eso, ¿sí?<br>Podrías hacerle daño a alguien..."

#. en: <oneline><$voicel(1,7)><$emotion(1,39)>This <$cdef(27)><fqty(1)><class><aireactp;0> </color>is<br>reeeaaally neat...<clear><br><$voicel(1,5)><$motion(1,805)><$comeff(1,14)><$facial(1,1)>But could you move it a little closer to my home?
msgctxt "2022:317"
msgid "<$voicel(1,7)><$emotion(1,39)>¡Eh, qué maravilla de <$cdef(27)><fqty(1)><aireactp;0></color>!<clear><br><$voicel(1,5)><$motion(1,805)><$comeff(1,14)><$facial(1,1)>Y más maravillos<genqty;0(o,a,os,as)> serí<qty;0(a,an)> si estuvier<qty;0(a,an)> en mi casica."
msgstr "<$voicel(1,7)><$emotion(1,39)>¡Eh, qué maravilla de <$cdef(27)><fqty(1)><aireactp;0></color>!<clear><br><$voicel(1,5)><$motion(1,805)><$comeff(1,14)><$facial(1,1)>Y más maravillos<genqty;0(o,a,os,as)> serí<qty;0(a,an)> si estuvier<qty;0(a,an)> en mi casita."

#. en: <oneline><$voicel(1,7)><$emotion(1,8)><fcap><iart;0()><$cdef(27)><fqty(1)><class><aireactp;0></color>? Heyyy,<br>thanks! I’ll take gooood care of it.
msgctxt "2022:318"
msgid "<oneline><$voicel(1,7)><$emotion(1,8)>¡Gracias! Trataré <dart;0()><$cdef(27)><fqty(1)><aireactp;0></color><br>con mucho cariño."
msgstr ""

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Hehehe... That actually feels kinda gooood...
msgctxt "2022:319"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Ja, ja... Pues quejarme no me quejaré."
msgstr ""

#. en: <$voicel(1,5)><$motion(1,803)><$comeff(1,6)><$pkcry;0(1,3)>? That kinda tiiickles...
msgctxt "2022:320"
msgid "<$voicel(1,5)><$motion(1,803)><$comeff(1,6)>¿<$pkcry;0(1,3)>? Noto como unas cosquillas..."
msgstr ""

#. en: <oneline><$voicel(1,3)><$motion(1,805)><$comeff(1,7)><$facial(1,9)>Huh? The <$cdef(27)><fqty(1)><class><aireactp;0></color><br>is<slide><br>gone?<slide><br>I<slide><br>wonder<slide><br>where<slide><br>it weeent...
msgctxt "2022:322"
msgid "<oneline><$voicel(1,3)><$motion(1,805)><$comeff(1,7)><$facial(1,9)>Vaya... Juraría que aquí había<br><iart;0()><$cdef(27)><fqty(1)><class><aireactp;0></color>."
msgstr ""

#. en: <$voicel(1,5)><$emotion(1,14)>My home feels a biiit warmer now. <$voicel(1,8)><$emotion(1,39)>Now it’s juuust right<br>for a little nap...
msgctxt "2022:323"
msgid "<$voicel(1,5)><$emotion(1,14)>En mi casa ahora hace un calorcico bien bueno,<br><$voicel(1,8)><$emotion(1,39)>perfecto pa echarse una siesta."
msgstr "<$voicel(1,5)><$emotion(1,14)>En mi casa ahora hace un calorcito bien bueno,<br><$voicel(1,8)><$emotion(1,39)>perfecto pa echarse una siesta."

#. en: <$voicel(1,3)><$motion(1,807)><$comeff(1,4)>My home’s kiiinda hot now... This heat really saps my<br>energy, you knooow?
msgctxt "2022:324"
msgid "<$voicel(1,3)><$motion(1,807)><$comeff(1,4)>Uf, en casica hace un calor que no veas últimamente.<br>Dan ganas de no mover un dedo..."
msgstr "<$voicel(1,3)><$motion(1,807)><$comeff(1,4)>Uf, en casita hace un calor tremendo últimamente.<br>Dan ganas de no mover un dedo..."

#. en: <$voicel(1,5)><$emotion(1,14)>Feels like my home’s a liiittle cooler now... <$voicel(1,4)><$emotion(1,39)>It’s the<br>perfect temperature to just zone out and relaaax...
msgctxt "2022:325"
msgid "<$voicel(1,5)><$emotion(1,14)>Ahora se está bien fresquito por casa, ¿o es cosa mía?<br><$voicel(1,4)><$emotion(1,39)>¡Es perfecto pa estar de relax!"
msgstr ""

#. en: <$voicel(1,3)><$motion(1,807)><$comeff(1,23)>My home’s a little cold now... I know sooome Pokémon<br>like it like this, <$voicel(1,6)><$motion(1,805)><$comeff(1,14)>but I don’t think I do...
msgctxt "2022:326"
msgid "<$voicel(1,3)><$motion(1,807)><$comeff(1,23)>Brrr... En casica hace un frío que pela. ¿Así quién puede<br>estar a gusto?<clear><br><$voicel(1,6)><$motion(1,805)><$comeff(1,14)>Bueno, se me ocurre alguno que otro... pero ya te digo<br>que no es mi caso."
msgstr "<$voicel(1,3)><$motion(1,807)><$comeff(1,23)>Brrr... En casita hace un frío que pela. ¿Así quién puede<br>estar a gusto?<clear><br><$voicel(1,6)><$motion(1,805)><$comeff(1,14)>Bueno, se me ocurre alguno que otro... pero ya te digo<br>que no es mi caso."

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>The amount of liiight in my living space right now really<br>suits me...
msgctxt "2022:327"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>En casica ahora entra una luz que me da la vida."
msgstr "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>En casita ahora entra una luz que me encanta."

#. en: <$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>Whoooaaa! My home’s a little too bright now...<br>I dunno if I can relax like this...
msgctxt "2022:328"
msgid "<$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>Hay demasiada luz en casa... ¿Así quién puede pegar ojo?"
msgstr ""

#. en: <$voicel(1,5)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Yaaay! My living space is a little darker now. <$voicel(1,8)><$emotion(1,8)>I bet I can<br>get some reeeaaally good sleep now...
msgctxt "2022:329"
msgid "<$voicel(1,5)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Ahora me entra menos luz en casica y se está de fábula.<br><$voicel(1,8)><$emotion(1,8)>Me veo durmiendo hasta las tantas, je, je."
msgstr "<$voicel(1,5)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Ahora me entra menos luz en casita y se está de fábula.<br><$voicel(1,8)><$emotion(1,8)>Me veo durmiendo hasta las tantas, je, je."

#. en: <$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>My home’s now a bit too dark for me... <$voicel(1,6)><$motion(1,805)><$comeff(1,14)><$facial(1,1)>A little brighter<br>would be peeerfect.
msgctxt "2022:330"
msgid "<$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>Mi casica está demasiado oscura pa mi gusto ahora...<br><$voicel(1,6)><$motion(1,805)><$comeff(1,14)><$facial(1,1)>Un pelín más de luz no vendría mal."
msgstr "<$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>Mi casita está demasiado oscura pa mi gusto ahora...<br><$voicel(1,6)><$motion(1,805)><$comeff(1,14)><$facial(1,1)>Un poquito más de luz no vendría mal."

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>My home’s gotten a little more humid recently. It’s<br>soooooo comfy...
msgctxt "2022:331"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>En casica se nota ahora más humedad en el ambiente<br>y es la mar de agradable."
msgstr "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>En casita se nota ahora más humedad en el ambiente<br>y es muy agradable."

#. en: <$comeff(1,19)><$voicel(1,5)>All the humidity here really saps my energy. <$comeff(1,14)><$voicel(1,3)><$motion(1,802)><$facial(1,9)>It would be<br>suuuper cool if the air were a bit more dry.
msgctxt "2022:332"
msgid "<$comeff(1,19)><$voicel(1,5)>El ambiente por aquí está tan húmedo que me encuentro<br>un poquico cansad<gen;-3(o,a)>... <$comeff(1,14)><$voicel(1,3)><$motion(1,802)><$facial(1,9)>Ojalá el aire estuviese más seco."
msgstr "<$comeff(1,19)><$voicel(1,5)>El ambiente por aquí está tan húmedo que me encuentro<br>un poquito cansad<gen;-3(o,a)>... <$comeff(1,14)><$voicel(1,3)><$motion(1,802)><$facial(1,9)>Ojalá el aire estuviese más seco."

#. en: <$comeff(1,1)><$voicel(1,7)><$facial(1,4)>Ahhh. The air here has been sooo nice and dry recently.<br><$comeff(1,13)><$voicel(1,9)><$motion(1,801)>Every day is a perfect day for a niiice nap.
msgctxt "2022:333"
msgid "<$comeff(1,1)><$voicel(1,7)><$facial(1,4)>Aaah... Últimamente el aire está tan seco que da gusto<br>estar por aquí.<clear><br><$comeff(1,13)><$voicel(1,9)><$motion(1,801)>Todos los días te pide el cuerpo pegarte una cabezadica<br>bien reparadora."
msgstr "<$comeff(1,1)><$voicel(1,7)><$facial(1,4)>Aaah... Últimamente el aire está tan seco que da gusto<br>estar por aquí.<clear><br><$comeff(1,13)><$voicel(1,9)><$motion(1,801)>Todos los días te pide el cuerpo echarte una siestecita<br>bien reparadora."

#. en: <$comeff(1,19)><$motion(1,802)><$voicel(1,3)><$facial(1,9)>Heyyy, it’s real dry around here, isn’t it? I would love a<br>little bit more humidity, you knooow?
msgctxt "2022:334"
msgid "<$comeff(1,19)><$motion(1,802)><$voicel(1,3)><$facial(1,9)>Aquí el ambiente está demasiado seco para mi gusto...<br>Anda que no le vendría bien un pelíiin de humedad."
msgstr "<$comeff(1,19)><$motion(1,802)><$voicel(1,3)><$facial(1,9)>Aquí el ambiente está demasiado seco para mi gusto...<br>Cómo le vendría bien un poquiiito de humedad."

#. en: <$voicel(1,5)><$motion(1,805)><$comeff(1,14)>That thing you got for me is over this way, riiight?<clear><br><$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>I really wanna go take a look, but I don’t know if I can<br>get by here... <$voicel(1,6)><$motion(1,803)><$comeff(1,10)><$facial(1,1)>Could you clear the paaath for me?
msgctxt "2022:335"
msgid "<$cdef(27)><$voicel(1,5)><$motion(1,805)><$comeff(1,14)></color>Aquello que habías colocado está por ahí, ¿verdad?<clear><br><$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>Pues tenemos un problema, porque por aquí no puedo<br>pasar ni en sueños...<clear><br><$voicel(1,6)><$motion(1,803)><$comeff(1,10)><$facial(1,1)>¿Te importaría abrirme camino, <gen;-2(majo,maja)>?"
msgstr ""

#. en: <$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Yaaay! Just leave it to me...
msgctxt "2022:336"
msgid "<$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Ya me encargo yo."
msgstr ""

#. en: <$comeff(1,6)><$voicel(1,5)>Something is weeeiiird about this spot...<br>Heyyy, <$cdef(27)><pname;0></color>, let’s check it out.
msgctxt "2022:337"
msgid "<oneline><$comeff(1,6)><$voicel(1,5)>Aquí veo yo algo raro, <$cdef(27)><pname;0></color>.<br>¡Echa un ojo!"
msgstr ""

#. en: <$voicel(1,3)><$motion(1,805)><$comeff(1,14)>Down it goooeees. It’s kinda sad in a way, isn’t it?
msgctxt "2022:338"
msgid "<$voicel(1,3)><$motion(1,805)><$comeff(1,14)>Ay... Mira cómo se va desmoronando poooco a poooco...<br>Da penica, ¿no?"
msgstr "<$voicel(1,3)><$motion(1,805)><$comeff(1,14)>Ay... Mira cómo se va desmoronando poooco a poooco...<br>Da penita, ¿no?"

#. en: <$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,10)>*rumble rumble* So huuungry... But I need to be<br>paaatient... <$pkcry;0(1,4)>...
msgctxt "2022:339"
msgid "<$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,10)>Ayyy... Me rugen las tripaaas... Pero tengo que ser fuerte<br>y aguantar la tentación... <$pkcry;0(1,4)>..."
msgstr ""

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,8)>Parties are niiice...
msgctxt "2022:340"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,8)>¡Vivan las fiestas!"
msgstr ""

#. en: <$comeff(1,8)><$facial(1,4)><$voicel(1,8)>So nice and waaarm... I want to stay here foreeever...
msgctxt "2022:341"
msgid "<$comeff(1,8)><$facial(1,4)><$voicel(1,8)>Qué bien sienta el agua calentica, oye..."
msgstr "<$comeff(1,8)><$facial(1,4)><$voicel(1,8)>Qué bien sienta el agua calientita, oye..."

#. en: <oneline><$voicel(1,7)><$emotion(1,14)>I bet that <$cdef(27)><fqty(1)><class><aireactp;0></color><br>would<slide><br>be<slide><br>wayyy<slide><br>easier<slide><br>to<slide><br>use<slide><br><$voicel(1,6)>if<slide><br>it<slide><br>was<slide><br>farther<slide><br>from<slide><br>the<slide><br>water, you know?<clear><br><$voicel(1,8)><$comeff(1,21)><$motion(1,805)>I would be suuuper happy if you could move it somewhere<br>else for me.
msgctxt "2022:343"
msgid "<$voicel(1,7)><$emotion(1,14)>Yo creo que tiene más sentido colocar en un lugar sin<br>agua <$voicel(1,6)><dart;0()><$cdef(27)><fqty(1)><aireactp;0></color>.<clear><br><$voicel(1,8)><$comeff(1,21)><$motion(1,805)>Ay, si l<genqty;0(o,a,os,as)> pudieses mover a otro sitio, sería todo un<br>detallico."
msgstr "<$voicel(1,7)><$emotion(1,14)>Yo creo que tiene más sentido colocar en un lugar sin<br>agua <$voicel(1,6)><dart;0()><$cdef(27)><fqty(1)><aireactp;0></color>.<clear><br><$voicel(1,8)><$comeff(1,21)><$motion(1,805)>Ay, si l<genqty;0(o,a,os,as)> pudieses mover a otro lugar, sería todo un<br>detallito."

#. en: <oneline><$comeff(1,9)><$motion(1,801)><$voicel(1,9)>Thaaanks, <$cdef(27)><pname;0></color>. Now I can reeeaaally<br>take<slide><br>it<slide><br>easy<slide><br>and relax...
msgctxt "2022:344"
msgid "<oneline><$comeff(1,9)><$motion(1,801)><$voicel(1,9)>Gracias, <$cdef(27)><pname;0></color>. Ahora sí que voy a<br>estar<slide><br>en la gloria."
msgstr ""

#. en: <$comeff(1,21)><$motion(1,806)><$voicel(1,7)>The area around my home is getting kinda niiice. Just a<br>little more and it will be peeerfect...
msgctxt "2022:345"
msgid "<$comeff(1,21)><$motion(1,806)><$voicel(1,7)>¡La zona de mi casica está quedando bien hermosota!<br>¡Sigue esforzándote como hasta ahora, maj<gen;-2(o,a)>!"
msgstr "<$comeff(1,21)><$motion(1,806)><$voicel(1,7)>¡La zona de mi casita está quedando bien bonita!<br>¡Sigue esforzándote como hasta ahora, amig<gen;-2(o,a)>!"

#. en: <oneline><$comeff(1,6)><$facial(1,1)><$motion(1,805)><$voicel(1,5)>Heyyy,<$cdef(27)> <pname;0></color>... Wanna do some<br>treasure hunting?<clear><br><$comeff(1,21)><$facial(1,4)><$motion(1,661)><$voicel(1,7)>I feel like you could find some reeeaaally neat stuff if you<br>used a<$cdef(27)> <fqty(1)><$ifull(2793)></color>...
msgctxt "2022:400"
msgid "<oneline><$comeff(1,6)><$facial(1,1)><$motion(1,805)><$voicel(1,5)>¿Te animas a buscar tesoros conmigo,<br><$cdef(27)><pname;0></color>?<clear><br><$comeff(1,21)><$facial(1,4)><$motion(1,661)><$voicel(1,7)>Si usamos tu <$cdef(27)><fqty(1)><$ifull(2793)></color>, seguro que aparece algo bonico..."
msgstr "<oneline><$comeff(1,6)><$facial(1,1)><$motion(1,805)><$voicel(1,5)>¿Te animas a buscar tesoros conmigo,<br><$cdef(27)><pname;0></color>?<clear><br><$comeff(1,21)><$facial(1,4)><$motion(1,661)><$voicel(1,7)>Si usamos tu <$cdef(27)><fqty(1)><$ifull(2793)></color>, seguro que aparece algo bonito..."

#. en: <oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,6)>Heyyy,<$cdef(27)> <pname;0></color>. Did you clear a path<br>for<slide><br>me alreeeaaady?
msgctxt "2022:402"
msgid "<$voicel(1,5)><$motion(1,805)><$comeff(1,6)>¿Qué, ya puedo pasar?"
msgstr ""

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>Thaaank you! Let’s go together, then...
msgctxt "2022:403"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>¡Me alegra oírlo! Hala, vamos p'allá."
msgstr "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>¡Me alegra oírlo! Bueno, vamos p'allá."

#. en: <$voicel(1,5)><$emotion(1,14)>Take your tiiime. I’ll just be relaaaxing while I wait...
msgctxt "2022:404"
msgid "<$voicel(1,5)><$emotion(1,14)>Tómate el tiempo que necesites. Aquí te espero yo<br>mientras tanto."
msgstr ""

#. en: <$voicel(1,3)><$motion(1,807)><$comeff(1,7)><$pkcry;0(1,4)>... I still don’t think I can get by...<clear><br><$motion(1,805)><$comeff(1,6)><$voicel(1,5)>Could you clean up the road just a liiittle bit more for<br>me, <$cdef(27)><pname;1></color>?
msgctxt "2022:405"
msgid "<oneline><$voicel(1,3)><$motion(1,807)><$comeff(1,7)><$pkcry;0(1,4)>... Yo no veo nada claro que pueda pasar<br>por aquí.<clear><br><$motion(1,805)><$voicel(1,5)>Si abrieras camino un poquiiico más, me harías un favor.<br><$comeff(1,6)>¿Te importa?"
msgstr "<oneline><$voicel(1,3)><$motion(1,807)><$comeff(1,7)><$pkcry;0(1,4)>... Yo no veo nada claro que pueda pasar<br>por aquí.<clear><br><$motion(1,805)><$voicel(1,5)>Si abrieras camino un poquiiito más, me harías un favor.<br><$comeff(1,6)>¿Te importa?"

#. en: <$comeff(1,7)><$motion(1,805)><$voicel(1,3)>Oh nooo... I can’t get by... Can you do anything to<br>heeelp, <$cdef(27)><pname;0></color>?
msgctxt "2022:408"
msgid "<oneline><$comeff(1,7)><$motion(1,805)><$voicel(1,3)>Por aquí no hay quien pase...<clear><br><$cdef(27)><pname;0></color>, ¿no puedes adecentar esto,<br>maj<gen;-2(o,a)>?"
msgstr "<oneline><$comeff(1,7)><$motion(1,805)><$voicel(1,3)>Por aquí no hay quien pase...<clear><br><$cdef(27)><pname;0></color>, ¿no puedes adecentar esto,<br>amig<gen;-2(o,a)>?"

#. en: <oneline><$voicel(1,5)><$emotion(1,14)>You have a friend named<$cdef(27)> <wowner;0><br></color>living<slide><br>near<slide><br>here, riiight?<clear><br><$voicel(1,7)><$emotion(1,39)>I hope we can meet and have a chat sometime. I bet all<br>your friends are reeeaaally cool...
msgctxt "2022:409"
msgid "<$voicel(1,5)><$emotion(1,14)><$cdef(27)><wowner;0></color> vive por aquí cerca, ¿verdad?<clear><br><$voicel(1,7)><$emotion(1,39)>Pues a ver si nos conocemos, que alguien tan maj<gen;-2(o,a)> como<br>tú solo puede rodearse de buena gente."
msgstr "<$voicel(1,5)><$emotion(1,14)><$cdef(27)><wowner;0></color> vive por aquí cerca, ¿verdad?<clear><br><$voicel(1,7)><$emotion(1,39)>Pues a ver si nos conocemos, que alguien tan buen<gen;-2(o,a)> como<br>tú solo puede rodearse de buena gente."

#. en: <$comeff(1,3)><$motion(1,803)><$voicel(1,5)>OK. Gooot it... I’ll be at home, then.
msgctxt "2022:410"
msgid "<$comeff(1,3)><$motion(1,803)><$voicel(1,5)>Pos na, no me queda más remedio que volver pa casa."
msgstr "<$comeff(1,3)><$motion(1,803)><$voicel(1,5)>Bueno, no me queda más remedio que volver pa casa."

#. en: <$voicel(1,5)><$motion(1,805)><$comeff(1,6)>Hmmm? What’s thaaat, <$cdef(27)><pname;0></color>?
msgctxt "2022:411"
msgid "<$voicel(1,5)><$motion(1,805)><$comeff(1,6)>Oye, <$cdef(27)><pname;0></color>, ¿qué llevas ahí?"
msgstr ""

#. en: <$voicel(1,6)><$emotion(1,14)>Oh... Thaaat’s OK.
msgctxt "2022:412"
msgid "<$voicel(1,6)><$emotion(1,14)>Hmm... Vale, vale."
msgstr "<$voicel(1,6)><$emotion(1,14)>Hmm... Bueno, bueno."

#. en: <$voicel(1,7)><$emotion(1,8)>Whoooaaa. I’m so happy! Thank you.
msgctxt "2022:413"
msgid "<$voicel(1,7)><$emotion(1,8)>¿Eeeh? Pues mira tú qué bien. ¡Graaacias!"
msgstr ""

#. en: <oneline><$comeff(1,9)><$motion(1,801)><$voicel(1,10)><$pkcry;0(1,2)>! That’s a niiice<br><$cdef(27)><fqty(1)><class><refmateid;1></color>...
msgctxt "2022:414"
msgid "<oneline><$comeff(1,9)><$motion(1,801)><$voicel(1,10)>¡<$pkcry;0(1,2)>!<br>¡Qué <$cdef(27)><class><fqty(1)><refmateid;1><slide><br></color>tan hermos<genqty;1(ote,ota,otes,otas)>!"
msgstr ""

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Time for a treeeaaasure hunt? Let’s make it a really<br>chiiill one.
msgctxt "2022:415"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¿Vas a buscar tesoros? Venga, así pasamos el rato..."
msgstr "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¿Vas a buscar tesoros? Vamos, así pasamos el rato..."

#. en: <$comeff(1,8)><$facial(1,2)><$motion(1,801)><$voicel(1,9)>I feel like we keep getting closer and closer as friends,<br><$cdef(27)><pname;0></color>. So here...<clear><br><$comeff(1,3)><$facial(1,4)><$motion(1,803)><$voicel(1,10)>This is a friendship gift from me to yooouuu.
msgctxt "2022:416"
msgid "<oneline><$comeff(1,8)><$facial(1,2)><$motion(1,801)><$voicel(1,9)>Jo, <$cdef(27)><pname;0></color>, ¡cada día me caes más<br>simpátic<gen;-2(o,a)>!<clear><br>Así que: ¡toma, pa ti! <$comeff(1,3)><$facial(1,4)><$motion(1,803)><$voicel(1,10)>¡Es un regalo de mi parte!"
msgstr "<oneline><$comeff(1,8)><$facial(1,2)><$motion(1,801)><$voicel(1,9)>Ay, <$cdef(27)><pname;0></color>, ¡cada día me caes más<br>simpátic<gen;-2(o,a)>!<clear><br>Así que: ¡toma, pa ti! <$comeff(1,3)><$facial(1,4)><$motion(1,803)><$voicel(1,10)>¡Es un regalo de mi parte!"

#. en: <oneline><$comeff(1,8)><$facial(1,5)><$motion(1,801)><$voicel(1,9)>My favorite times are the times I get to spend with<br>yooouuu, <$cdef(27)><pname;0></color>. I hope we can hang<slide><br>out<slide><br>more<slide><br>and<slide><br>more<slide><br>and mooore...
msgctxt "2022:417"
msgid "<oneline><$comeff(1,8)><$facial(1,5)><$motion(1,801)><$voicel(1,9)>Contigo lo paso mejor que con nadie,<br><$cdef(27)><pname;0></color>.<clear><br>¡Quiero que sigas siendo mi amig<gen;-2(o,a)> pa siempre!"
msgstr "<oneline><$comeff(1,8)><$facial(1,5)><$motion(1,801)><$voicel(1,9)>Contigo la paso mejor que con nadie,<br><$cdef(27)><pname;0></color>.<clear><br>¡Quiero que sigas siendo mi amig<gen;-2(o,a)> pa siempre!"

#. en: <$voicel(1,9)><$motion(1,801)><$facial(1,4)><$comeff(1,10)>Wowww. Yayyy! We found some treasure...<clear><br><$voicel(1,7)><$motion(1,803)><$comeff(1,9)>Hanging out with you is so much fuuun. I hope you’ll invite<br>me next time too...
msgctxt "2022:418"
msgid "<$voicel(1,9)><$motion(1,801)><$facial(1,4)><$comeff(1,10)>¡Anda! Hemos encontrado un tesoro bien majo, ¿eh?<br><$voicel(1,7)><$motion(1,803)><$comeff(1,9)>Qué bien me lo paso contigo... ¡A ver si lo repetimos!"
msgstr "<$voicel(1,9)><$motion(1,801)><$facial(1,4)><$comeff(1,10)>¡Vaya! Encontramos un tesoro bien bonito, ¿eh?<br><$voicel(1,7)><$motion(1,803)><$comeff(1,9)>Qué bien la paso contigo... ¡A ver si lo repetimos!"

#. en: <oneline><$voicel(1,9)><$emotion(1,7)><$pkcry;0(1,2)>! I really, reeeaaally like this. <$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>Thank you<br>sooo much.
msgctxt "2022:419"
msgid "<$voicel(1,9)><$emotion(1,7)>Me encanta, me fascina, me maravilla. <$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>¡Graaacias!<br>♪¡<$pkcry;0(1,2)>!♪"
msgstr ""

#. en: <$comeff(1,14)><$facial(1,2)><$motion(1,805)><$voicel(1,6)>I’m trying to get over there, but...
msgctxt "2022:420"
msgid "<$comeff(1,14)><$facial(1,2)><$motion(1,805)><$voicel(1,6)>Yo quería irme a dar un garbeo por allí..."
msgstr "<$comeff(1,14)><$facial(1,2)><$motion(1,805)><$voicel(1,6)>Yo quería irme a dar una vuelta por allá..."

#. en: <$comeff(1,4)><$facial(1,9)><$motion(1,802)><$voicel(1,3)>Oh, uhhh... Sorry, I kind of want to stay in this area a<br>little while longer... <$facial(1,3)><$motion(1,803)><$voicel(1,6)>I’ll find you again laaater.
msgctxt "2022:421"
msgid "<$comeff(1,4)><$facial(1,9)><$motion(1,802)><$voicel(1,3)>Perdona, maj<gen;-2(o,a)>. Yo estoy la mar de a gusto por esta zona,<br><$facial(1,3)><$motion(1,803)><$voicel(1,6)>así que si quieres tirar pa otro sitio, aquí me despido."
msgstr "<$comeff(1,4)><$facial(1,9)><$motion(1,802)><$voicel(1,3)>Perdona, amig<gen;-2(o,a)>. Yo estoy muy a gusto por esta zona,<br><$facial(1,3)><$motion(1,803)><$voicel(1,6)>así que si quieres ir pa otro lado, aquí me despido."

#. en: <$comeff(1,7)><$facial(1,9)><$motion(1,802)><$voicel(1,3)>It’s always so tiiiring... I think it might be because the<br>path over that way isn’t too great...
msgctxt "2022:422"
msgid "<$comeff(1,7)><$facial(1,9)><$motion(1,802)><$voicel(1,3)>¡Pero no sabes tú el desastre que está hecho el camino!<br>Que así no se puede ir a ninguna parte, majet<gen;-2(e,a)>."
msgstr "<$comeff(1,7)><$facial(1,9)><$motion(1,802)><$voicel(1,3)>¡Pero no sabes tú el desastre que está hecho el camino!<br>Que así no se puede ir a ninguna parte, jef<gen;-2(e,a)>."

#. en: <$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>Hmmmmmm... This home seems a little too smaaall for me.<br>I would really like one that’s a little bigger...
msgctxt "2022:426"
msgid "<$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>Hmm... Esta casica es un poco chiquitaja para mí, ¿no?<br>Podría ser un poco más grande..."
msgstr "<$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>Hmm... Esta casita es un poco chiquita para mí, ¿no?<br>Podría ser un poco más grande..."

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Whoooaaa... This home is amaaazing...
msgctxt "2022:427"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>¡Bueno, bueno! Esta casica humana es la reperaaa."
msgstr "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>¡Bueno, bueno! Esta casita humana es geniaaal."

#. en: <$voicel(1,7)><$emotion(1,8)>Seriouslyyy? I can live here? Awesome. I’m excited to<br>relax in my new home right away...
msgctxt "2022:428"
msgid "<$voicel(1,7)><$emotion(1,8)>¿En serio? Qué alegría más grande. Con permisooo...<br>Voy a ponerme cómod<gen;-3(ooo,aaa)>..."
msgstr ""

#. en: <oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>You really worked haaard on it, didn’t you,<br><$cdef(27)><pname;0></color>?
msgctxt "2022:429"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¡Pues sí! Menuda mano tienes, <$cdef(27)><pname;0></color>."
msgstr "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¡Pues sí! Qué buena mano tienes, <$cdef(27)><pname;0></color>."

#. en: <$voicel(1,7)><$motion(1,805)><$facial(1,4)><$comeff(1,6)>Really? I can move in? I’m toootally gonna move in...
msgctxt "2022:430"
msgid "<$voicel(1,7)><$motion(1,805)><$facial(1,4)><$comeff(1,6)>¿Eeeh? ¿De verdad me puedo mudar aquíii?"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,39)>Thaaank you. I’m so happyyy!
msgctxt "2022:431"
msgid "<$voicel(1,7)><$emotion(1,39)>¡Esta alegría no me la esperaba yo! Ja, ja, ja."
msgstr ""

#. en: <$voicel(1,6)><$motion(1,803)><$comeff(1,10)>I guess that’s just how it goooeees sometimes...
msgctxt "2022:432"
msgid "<$voicel(1,6)><$motion(1,803)><$comeff(1,10)>Ya... No se puede tener todo en esta vida..."
msgstr ""

#. en: <$voicel(1,3)><$motion(1,805)><$comeff(1,14)>Ohhh... But if I move in, the home will be too craaamped...<br><$voicel(1,6)><$emotion(1,14)>I guess I’ll pass...
msgctxt "2022:433"
msgid "<$voicel(1,3)><$motion(1,805)><$comeff(1,14)>Pero... si me instalo aquí, vamos a estar un poooco<br>apretujadicos, ¿no?<clear><br><$voicel(1,6)><$emotion(1,14)>Creo que mejor otro sitio..."
msgstr "<$voicel(1,3)><$motion(1,805)><$comeff(1,14)>Pero... si me instalo aquí, vamos a estar un poooco<br>apretujaditos, ¿no?<clear><br><$voicel(1,6)><$emotion(1,14)>Creo que mejor otro lugar..."

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Hehe. Aaawesome. You can have what we found...<clear><br><$voicel(1,9)><$emotion(1,8)>That was a lot of fun. Let’s hang out agaaaiiin sometime.
msgctxt "2022:434"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¡Ja, ja, qué hallazgo! Venga, para ti, por ser tan sal<gen;-2(aooo,áaa)>.<clear><br><$voicel(1,9)><$emotion(1,8)>Oye, pues me ha gustado mucho esto de buscar cosicas...<br>A ver si repetimos."
msgstr "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¡Ja, ja, qué hallazgo! Toma, para ti, por ser tan sal<gen;-2(aooo,áaa)>.<clear><br><$voicel(1,9)><$emotion(1,8)>Oye, pues me gustó mucho esto de buscar cositas...<br>A ver si repetimos."

#. en: <oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,6)>Heyyy... What’s that shiiiny thing you have there,<br><$cdef(27)><pname;0></color>?
msgctxt "2022:435"
msgid "<oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,6)>¡Ahí va! ¿Qué es eso tan brillante que tienes ahí,<br><$cdef(27)><pname;0></color>?"
msgstr "<oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,6)>¡Vaya! ¿Qué es eso tan brillante que tienes ahí,<br><$cdef(27)><pname;0></color>?"

#. en: <$voicel(1,7)><$emotion(1,8)>You want to give it to me? Wowww... How about I give<br>you thiiis in return?
msgctxt "2022:436"
msgid "<$voicel(1,7)><$emotion(1,8)>¡Hala! ¿Me lo regalas por mi cara bonita? Pues toma esto<br>a cambio, que no se diga."
msgstr "<$voicel(1,7)><$emotion(1,8)>¡Guau! ¿Me lo regalas por mi cara bonita? Pues toma esto<br>a cambio, que no se diga."

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Ohhh... I don’t need any preeesents. You can give it to<br>another Pokémon <$voicel(1,6)><$motion(1,805)><$comeff(1,9)>who might want it more than me.
msgctxt "2022:437"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Se agradece la intención, pero a mí no me hace falta.<br>Dáselo a otro Pokémon. <$voicel(1,6)><$motion(1,805)><$comeff(1,9)>¡Seguro que le alegras el día!"
msgstr ""

#. en: <$voicel(1,5)><$motion(1,805)><$comeff(1,14)>Wowww. I’m really happy...but I don’t know if I neeeed<br>that right now...<clear><br><$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>I don’t know what I would use it for, you know?
msgctxt "2022:438"
msgid "<$voicel(1,5)><$motion(1,805)><$comeff(1,14)>Te agradezco el detalle, pero ahora mismo no me hace<br>ninguna falta... <wait(0.4)><$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>¡Es que no sabría ni qué hacer con eso!"
msgstr ""

#. en: <$voicel(1,5)><$motion(1,805)><$comeff(1,6)>Waaaiiit... This is the home I already liiive in. I wish you<br>would show me a new place...
msgctxt "2022:439"
msgid "<$voicel(1,5)><$motion(1,805)><$comeff(1,6)>¿Eeeh...? ¿No te acuerdas? Pero... si yo ya vivo aquí...<br>¿Tienes otro sitio que me puedas enseñar?"
msgstr "<$voicel(1,5)><$motion(1,805)><$comeff(1,6)>¿Eeeh...? ¿No te acuerdas? Pero... si yo ya vivo aquí...<br>¿Tienes otro lugar que me puedas enseñar?"

#. en: <$comeff(1,10)><$facial(1,2)><$motion(1,806)><$voicel(1,7)>I would be reeeaaally happy if you could clear a path for<br>me to take, <$cdef(27)><pname;0></color>...<clear><br><$comeff(1,6)><$motion(1,803)><$voicel(1,6)>Pretty pleeeaaase?
msgctxt "2022:442"
msgid "<$comeff(1,10)><$facial(1,2)><$motion(1,806)><$voicel(1,7)>Pero tú que eres muy apañ<gen;-2(ao,á)> seguro que podrías<br>adecentarlo un poco.<clear><br><$comeff(1,6)><$motion(1,803)><$voicel(1,6)>¿Qué me dices, granujilla?"
msgstr "<$comeff(1,10)><$facial(1,2)><$motion(1,806)><$voicel(1,7)>Pero tú que eres muy avisp<gen;-2(ao,á)> seguro que podrías<br>adecentarlo un poco.<clear><br><$comeff(1,6)><$motion(1,803)><$voicel(1,6)>¿Qué me dices, granujita?"

#. en: <$cdef(27)><oneline><$voicel(1,5)><$motion(1,803)><$comeff(1,10)><pname;0></color>, time’s uuup. Guess that’s the<br>end<slide><br>of<slide><br>our gaaame.
msgctxt "2022:443"
msgid "<oneline><$voicel(1,5)><$motion(1,803)><$comeff(1,10)>Has tardado mucho, <$cdef(27)><pname;0></color>.<br>Aquí se acaba el juego<slide><br>y <gen;-3(el,la)> ganad<gen;-3(or,ora)> es... ¡<gen;-3(un,una)> servid<gen;-3(or,ora)>!"
msgstr "<oneline><$voicel(1,5)><$motion(1,803)><$comeff(1,10)>Tardaste mucho, <$cdef(27)><pname;0></color>.<br>Aquí se acaba el juego<slide><br>y <gen;-3(el,la)> ganad<gen;-3(or,ora)> es... ¡<gen;-3(un,una)> servid<gen;-3(or,ora)>!"

#. en: <$voicel(1,5)><$motion(1,803)><$comeff(1,10)>Awww... We did our best to win, but you’re just toooo<br>good, <$cdef(27)><pname;0></color>.<clear><br><$voicel(1,8)><$emotion(1,8)>Here’s a really niiice prize for doing so well today.
msgctxt "2022:444"
msgid "<$voicel(1,5)><$motion(1,803)><$comeff(1,10)>Mira que hemos buscado hasta en el último rincón...<br>Pero a ti no hay quien te gane, <$cdef(27)><pname;0></color>.<clear><br><$voicel(1,8)><$emotion(1,8)>Toma, te has ganado un regalico bien majooo."
msgstr "<$voicel(1,5)><$motion(1,803)><$comeff(1,10)>Mira que buscamos hasta en el último rincón...<br>Pero a ti no hay quien te gane, <$cdef(27)><pname;0></color>.<clear><br><$voicel(1,8)><$emotion(1,8)>Toma, te ganaste un regalito bien bonitooo."

#. en: <$voicel(1,7)><$motion(1,805)><$facial(1,4)><$comeff(1,6)>Oh, heyyy... How do you feel about playing agaaaiiin?
msgctxt "2022:445"
msgid "<$voicel(1,7)><$motion(1,805)><$facial(1,4)>Diiicho eso, <$comeff(1,6)>¿te apetece jugar otra vez?"
msgstr "<$voicel(1,7)><$motion(1,805)><$facial(1,4)>Diiicho eso, <$comeff(1,6)>¿quieres jugar otra vez?"

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>Yaaayyy. I’m gonna wiiin...
msgctxt "2022:446"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>¡Vamos ahíii! Ya verás como gano yo."
msgstr "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>¡Vamooos! Ya verás como gano yo."

#. en: <$voicel(1,3)><$motion(1,803)><$comeff(1,3)>Oh, OK. That’s all riiight. But let’s play again some other<br>time, yeeeaaah?
msgctxt "2022:447"
msgid "<$voicel(1,3)><$motion(1,803)><$comeff(1,3)>Vale. Cuando te apetezca, ¡dame un silbidito!"
msgstr "<$voicel(1,3)><$motion(1,803)><$comeff(1,3)>Bueno. Cuando quieras, ¡dame un silbidito!"

#. en: <oneline><$voicel(1,5)><$comeff(1,14)><$motion(1,666)><$facial(1,9)>Ummmmmm... It doesn’t seem quite reeeaaady...<clear><br><$voicel(1,3)><$comeff(1,4)><$motion(1,807)>Yeah... I don’t think I’ll move in here. Sorryyy,<br><$cdef(27)><pname;0></color>.
msgctxt "2022:449"
msgid "<$voicel(1,5)><$comeff(1,14)><$motion(1,666)><$facial(1,9)>Hmm... Jo, la verdad es que no me acaba de convencer<br>del todo, si te soy sincer<gen;-3(o,a)>.<clear><br><$voicel(1,3)><$comeff(1,4)><$motion(1,807)>Así queee... creo que casi mejor no me mudo aquí.<br>¡No es nada personal, <$cdef(27)><pname;0></color>!"
msgstr "<$voicel(1,5)><$comeff(1,14)><$motion(1,666)><$facial(1,9)>Hmm... Ay, la verdad es que no me acaba de convencer<br>del todo, si te soy sincer<gen;-3(o,a)>.<clear><br><$voicel(1,3)><$comeff(1,4)><$motion(1,807)>Así queee... creo que casi mejor no me mudo aquí.<br>¡No es nada personal, <$cdef(27)><pname;0></color>!"

#. en: <$voicel(1,5)><$motion(1,805)><$comeff(1,6)>I can store aaanything for you. What will it be?
msgctxt "2022:451"
msgid "<$voicel(1,5)><$motion(1,805)>Claaaro, para eso estoy. <$comeff(1,6)>¿Qué quieres hacer?"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,14)>Sure thiiing. Come check in with me later...
msgctxt "2022:452"
msgid "<$voicel(1,7)><$emotion(1,14)>Vale, ven a verme dentro de un ratico..."
msgstr "<$voicel(1,7)><$emotion(1,14)>Bueno, ven a verme dentro de un ratito..."

#. en: <$voicel(1,5)><$motion(1,805)><$comeff(1,10)>I’m not done yet... Can you wait just a liiittle longer?
msgctxt "2022:453"
msgid "<$voicel(1,5)><$motion(1,805)><$comeff(1,10)>Es que aún no he terminado... ¿Puedes esperar un poco<br>más?"
msgstr ""

#. en: <oneline><$voicel(1,7)><$motion(1,824)><$comeff(1,3)><$facial(1,4)>I finished the <$cdef(27)><class><reftarid;1></color><br>you<slide><br>asked<slide><br>me<slide><br>for. Yayyy.
msgctxt "2022:454"
msgid "<oneline><$voicel(1,7)><$motion(1,824)><$comeff(1,3)><$facial(1,4)>Ya teeengo<br><dart;1()><$cdef(27)><class><reftarid;1></color><slide><br>que me pediste,<slide><br><$cdef(27)><pname;0></color>."
msgstr ""

#. en: <$voicel(1,3)><$motion(1,807)><$comeff(1,4)><$facial(1,9)>Sooorryyy...I have too much other stuff to do right now...
msgctxt "2022:455"
msgid "<$voicel(1,3)><$motion(1,807)><$comeff(1,4)><$facial(1,9)>Perdona, maj<gen;-2(o,a)>, pero ahora mismo ando muy liad<gen;-3(o,a)> con<br>otras cosas."
msgstr "<$voicel(1,3)><$motion(1,807)><$comeff(1,4)><$facial(1,9)>Perdona, amig<gen;-2(o,a)>, pero ahora mismo ando muy ocupad<gen;-3(o,a)><br>con otras cosas."

#. en: <$comeff(1,6)><$voicel(1,3)>Ohhh nooo. Where did my home go? It was right here...
msgctxt "2022:459"
msgid "<$comeff(1,6)><$voicel(1,3)>Ahí va... Pueees mi casica tendría que andar por aquí..."
msgstr "<$comeff(1,6)><$voicel(1,3)>Vaya... Pueees mi casita tendría que andar por aquí..."

#. en: <$comeff(1,14)><$voicel(1,1)><$motion(1,827)><$facial(1,9)>Hmmmm. Where could it have gone? Do homes just<br>disappear like that? Weeeiiird.
msgctxt "2022:460"
msgid "<$comeff(1,14)><$voicel(1,1)><$motion(1,827)><$facial(1,9)>¿Pero qué le habrá pasado? ¿Le han salido paticas<br>y se ha ido corriendo o qué?"
msgstr "<$comeff(1,14)><$voicel(1,1)><$motion(1,827)><$facial(1,9)>¿Pero qué le habrá pasado? ¿Le salieron patitas<br>y se fue corriendo o qué?"

#. en: <$voicel(1,3)><$facial(1,9)>I guess that’s just how it goes.<clear><br><$voicel(1,7)><$facial(1,1)><$motion(1,803)><$comeff(1,9)>Maybe I’ll find an even better home. I’ll just take it easy<br>and keep an eye out. Yeeeaaah.
msgctxt "2022:461"
msgid "<$voicel(1,3)><$facial(1,9)>Pues si mi casica no está por ninguna parte, es lo que<br>hay... Tendré que apechugar con las consecuencias.<clear><br><$voicel(1,7)><$facial(1,1)><$motion(1,803)><$comeff(1,9)>Quién sabe, igual acabo encontrando un hogar aún mejor.<br>No hay prisa, buscaré con toooda la pachorra del mundo."
msgstr "<$voicel(1,3)><$facial(1,9)>Pues si mi casita no está por ninguna parte, es lo que<br>hay... Tendré que apechugar con las consecuencias.<clear><br><$voicel(1,7)><$facial(1,1)><$motion(1,803)><$comeff(1,9)>Quién sabe, quizás encuentre un hogar aún mejor.<br>No hay prisa, buscaré con toooda la calma del mundo."

#. en: <oneline><$comeff(1,9)><$motion(1,803)><$voicel(1,7)><$facial(1,4)>Whoooaaa. What a nice spot. I think I’ll live here.<clear><br><$comeff(1,21)><$motion(1,801)><$voicel(1,9)>You made this, didn’t you, <$cdef(27)><pname;0></color>?<br>That’s<slide><br>sooo<slide><br>cool!<slide><br>Thank you!
msgctxt "2022:462"
msgid "<oneline><$comeff(1,9)><$motion(1,803)><$voicel(1,7)><$facial(1,4)>Guaaau, qué lugar más bonico, <$cdef(27)><pname;0></color>.<br>Pues a vivir en él,<slide><br>que son dos días.<clear><br><$comeff(1,21)><$motion(1,801)><$voicel(1,9)>¿Lo has preparado tú? Jo, eres todo un solete. ¡Graaacias!"
msgstr "<oneline><$comeff(1,9)><$motion(1,803)><$voicel(1,7)><$facial(1,4)>Guaaau, qué lugar más bonito, <$cdef(27)><pname;0></color>.<br>Pues a vivir en él,<slide><br>que la vida es corta.<clear><br><$comeff(1,21)><$motion(1,801)><$voicel(1,9)>¿Lo preparaste tú? Ay, eres un sol. ¡Graaacias!"

#. en: <oneline><$comeff(1,1)><$facial(1,4)><$voicel(1,7)><$motion(1,803)><$pkcry;0(1,2)>! ♪ You set me up with<br><iart;1()><$cdef(27)><fqty(1)><class><stfrevp;1></color>,<slide><br>huh?<slide><br><$comeff(1,13)><$motion(1,801)><$voicel(1,10)>Thank<slide><br>you<slide><br>so<slide><br>muuuch.<slide><br>I<slide><br>gotta<slide><br>check<slide><br>it out...
msgctxt "2022:463"
msgid "<oneline><$comeff(1,1)><$facial(1,4)><$voicel(1,7)><$motion(1,803)>¿Dices que has colocado<br><iart;1()><fqty(1)><class><$cdef(27)><stfrevp;1></color>?<slide><br>♪¡<$pkcry;0(1,2)>!♪<clear><br><$comeff(1,13)><$motion(1,801)><$voicel(1,10)>Jo, muchas gracias. Tendré que ir a echarl<qty;1(e,es)> un vistazo."
msgstr "<oneline><$comeff(1,1)><$facial(1,4)><$voicel(1,7)><$motion(1,803)>¿Dices que colocaste<br><iart;1()><fqty(1)><class><$cdef(27)><stfrevp;1></color>?<slide><br>♪¡<$pkcry;0(1,2)>!♪<clear><br><$comeff(1,13)><$motion(1,801)><$voicel(1,10)>Ay, muchas gracias. Tendré que ir a echarl<qty;1(e,es)> un vistazo."

#. en: <$comeff(1,13)><$facial(1,4)><$motion(1,805)><$voicel(1,7)>Yayyy, I’m all moved in. Time to relax in my new<br>hooouuuse...
msgctxt "2022:464"
msgid "<$comeff(1,13)><$facial(1,4)><$motion(1,805)><$voicel(1,7)>Mudarse es mu cansao. ¡Ahora toca tumbarme a la<br>bartola en mi nueva casica!"
msgstr "<$comeff(1,13)><$facial(1,4)><$motion(1,805)><$voicel(1,7)>Mudarse cansa mucho. ¡Ahora toca relajarme<br>en mi nueva casita!"

#. en: <$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,5)>Heyyy, I’m glad I ran into you... Can you give this to<br><$cdef(27)><refpname;0> </color>for me?<clear><br><$comeff(1,21)><$voicel(1,7)>It’s what they aaasked me for.
msgctxt "2022:465"
msgid "<oneline><$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,5)>¡Uy, pillastre, qué bien me vas a venir! Justo buscaba<br>a alguien pa llevarle esto a <$cdef(27)><refpname;0></color>,<slide><br><$comeff(1,21)><$voicel(1,7)>que me lo pidió."
msgstr "<oneline><$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,5)>¡Uy, granujita, qué bien me vas a venir! Justo buscaba<br>a alguien pa llevarle esto a <$cdef(27)><refpname;0></color>,<slide><br><$comeff(1,21)><$voicel(1,7)>que me lo pidió."

#. en: <$voicel(1,5)><$emotion(1,29)>Heyyy, I know this is kinda sudden, but how do you feel<br>about doing a quiz I thought up?
msgctxt "2022:466"
msgid "<$voicel(1,5)><$emotion(1,29)>Perdona que te pille un poco así de sopetón, maj<gen;-2(o,a)>, pero...<br>¿qué me dices de una pequeña adivinanza?"
msgstr "<$voicel(1,5)><$emotion(1,29)>Perdona que te agarre así de sopetón, amig<gen;-2(o,a)>, pero...<br>¿qué me dices de una pequeña adivinanza?"

#. en: <$voicel(1,10)><$emotion(1,2)>All riiight! Here we gooo.<clear><br><$voicel(1,5)><$emotion(1,33)>Who is taller? Me or <$cdef(27)><sizecmppk;1></color>?
msgctxt "2022:467"
msgid "<$voicel(1,10)><$emotion(1,2)>Estupeeendo. Venga, vamos allá.<clear><br><$voicel(1,5)><$emotion(1,33)>¿Quién mide más, <dart;1()><$cdef(27)><sizecmppk;1></color> o yo?"
msgstr "<$voicel(1,10)><$emotion(1,2)>Estupeeendo. Bueno, adelante.<clear><br><$voicel(1,5)><$emotion(1,33)>¿Quién mide más, <dart;1()><$cdef(27)><sizecmppk;1></color> o yo?"

#. en: <$voicel(1,3)><$motion(1,803)><$comeff(1,3)><$facial(1,9)>Ohhh, OK. Maybe next time, then.
msgctxt "2022:468"
msgid "<$voicel(1,3)><$motion(1,803)><$comeff(1,3)><$facial(1,9)>Jo, qué peeena. Va, lo dejamos pa la próxima."
msgstr "<$voicel(1,3)><$motion(1,803)><$comeff(1,3)><$facial(1,9)>Ay, qué peeena. Bueno, lo dejamos pa la próxima."

#. en: <oneline>...<wait(0.4)><$voicel(1,10)><$motion(1,801)><$comeff(1,20)><$facial(1,5)>That’s riiight!<clear><br><$voicel(1,7)><$motionoff(1,804)><$comeff(1,21)><$facial(1,4)>I expected no less from you, <$cdef(27)><pname;0></color>.<br>You’re<slide><br>real<slide><br>observant, huuuh?
msgctxt "2022:469"
msgid "... <wait(0.4)><$voicel(1,10)><$motion(1,801)><$comeff(1,20)><$facial(1,5)>¡Bingooo!<clear><br><$voicel(1,7)><$motionoff(1,804)><$comeff(1,21)><$facial(1,4)>Ya sabía yo que ibas a acertar... Si es que te conoces<br>a todos al dedillo, <$cdef(27)><pname;0></color>."
msgstr ""

#. en: ...<wait(0.4)><$voicel(1,3)><$motion(1,824)><$comeff(1,3)><$facial(1,9)>Nooope. That’s not right. Was it a hard question?<clear><br><$voicel(1,7)><$emotion(1,39)>But thanks for playin’. I’m sure you’ll get it next time.
msgctxt "2022:470"
msgid "... <wait(0.4)><$voicel(1,3)><$motion(1,824)><$comeff(1,3)><$facial(1,9)>Uyyy, no es correcto. Bueno, quizá te lo había puesto<br>algo difícil, ¿no?<clear><br><$voicel(1,7)><$emotion(1,39)>Pero, oye, muchas gracias por hacerme compañía un rato.<br>Seguro que a la próxima aciertas, ya verás."
msgstr "... <wait(0.4)><$voicel(1,3)><$motion(1,824)><$comeff(1,3)><$facial(1,9)>Uyyy, no es correcto. Bueno, tal vez te lo puse<br>algo difícil, ¿no?<clear><br><$voicel(1,7)><$emotion(1,39)>Pero, oye, muchas gracias por hacerme compañía un rato.<br>Seguro que a la próxima aciertas, ya verás."

#. en: <$comeff(1,1)><$facial(1,4)><$voicel(1,7)><$motion(1,801)>OK! This can be my new home. How exciiiting.
msgctxt "2022:471"
msgid "<$comeff(1,1)><$facial(1,4)><$voicel(1,7)><$motion(1,801)>Esta será mi casica a partir de hoy. ¡Jo, qué ilusión!"
msgstr "<$comeff(1,1)><$facial(1,4)><$voicel(1,7)><$motion(1,801)>Esta será mi casita a partir de hoy. ¡Ay, qué emoción!"

#. en: <$voicel(1,7)><$emotion(1,53)>Wowww! You can do so many transformations! That’s<br>way cooool.
msgctxt "2022:472"
msgid "<$voicel(1,7)><$emotion(1,53)>Guaaau, menudas transformaciones logras, maj<gen;-2(o,a)>.<br>¡Cómo mooolas!"
msgstr "<$voicel(1,7)><$emotion(1,53)>Guaaau, qué transformaciones logras, amig<gen;-2(o,a)>.<br>¡Qué geniaaal!"

#. en: <oneline><$comeff(1,6)><$facial(1,2)><$voicel(1,5)>Huhhh? Hmmm... It looks like there isn’t enough space<br>to play hide-and-sneak...<clear><br><$comeff(1,3)><$motion(1,803)><$voicel(1,5)>Can you do anything about that,<br><$cdef(27)><pname;0></color>?
msgctxt "2022:476"
msgid "<$comeff(1,6)><$facial(1,2)><$voicel(1,5)>Aúpa, maj<gen;-2(o,a)>, que aquí no hay hueco pa jugar al escondite<br>camuflado. <$comeff(1,3)><$motion(1,803)><$voicel(1,5)>¡Menuda faena! ¿No puedes hacer espacio?"
msgstr "<$comeff(1,6)><$facial(1,2)><$voicel(1,5)>Oye, amig<gen;-2(o,a)>, que aquí no hay hueco pa jugar al escondite<br>camuflado. <$comeff(1,3)><$motion(1,803)><$voicel(1,5)>¡Qué problema! ¿No puedes hacer espacio?"

#. en: <$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>Sooorry, but I don’t think I would do so well living here...
msgctxt "2022:477"
msgid "<$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>Hmm... No me veo viviendo aquí, ¿eh?"
msgstr ""

#. en: <$voicel(1,5)><$motion(1,803)><$comeff(1,17)><$facial(1,4)>Hey, thaaanks. But I’m kinda full right now... <$voicel(1,8)><$emotion(1,1)>Thank you<br>anyway, though!
msgctxt "2022:478"
msgid "<$voicel(1,5)><$motion(1,803)><$comeff(1,17)><$facial(1,4)>Pues ahora mismo estoy bien llen<gen;-3(o,a)>, ¡pero la intención<br>es lo que cuenta! <$voicel(1,8)><$emotion(1,1)>Gracias por el ofrecimiento, maj<gen;-2(ete,eta)>."
msgstr ""

#. en: <$voicel(1,6)><$emotion(1,29)>Where should I liiive?
msgctxt "2022:481"
msgid "<$voicel(1,6)><$emotion(1,29)>¿Y dónde podría vivir?"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,14)>Oh, yayyy. So that’s gonna be my new home?
msgctxt "2022:482"
msgid "<$voicel(1,7)><$emotion(1,14)>Aaah, vaaale. ¿Esta es mi nueva casica, pues?"
msgstr "<$voicel(1,7)><$emotion(1,14)>Aaah, bueeeno. ¿Esta es mi nueva casita, pues?"

#. en: <$voicel(1,8)><$emotion(1,50)>All riiight! Here we go...<clear><br><$voicel(1,5)><$emotion(1,33)>Who is heavier? Me or <$cdef(27)><weightcmppk;1></color>?
msgctxt "2022:484"
msgid "<$voicel(1,8)><$emotion(1,50)>Geniaaal. Pues prepárate, que va...<clear><br><$voicel(1,5)><$emotion(1,33)>¿Quién pesa más, <dart;1()><$cdef(27)><weightcmppk;1> </color>o yo?"
msgstr ""

#. en: <$comeff(1,1)><$facial(1,4)><$voicel(1,7)>Oh, <$cdef(27)><pname;0></color>, do you want thaaat?
msgctxt "2022:489"
msgid "<$comeff(1,1)><$facial(1,4)><$voicel(1,7)>¿Te tienta ese artículo, <$cdef(27)><pname;0></color>?"
msgstr ""

#. en: <$comeff(1,9)><$facial(1,5)><$voicel(1,10)><$motion(1,803)>Sounds good, sounds gooood. What do you want to trade?
msgctxt "2022:490"
msgid "<$comeff(1,9)><$facial(1,5)><$voicel(1,10)><$motion(1,803)>Venga, va. ¿Por qué te gustaría intercambiarlo?"
msgstr "<$comeff(1,9)><$facial(1,5)><$voicel(1,10)><$motion(1,803)>Muy bien. ¿Por qué te gustaría intercambiarlo?"

#. en: <$comeff(1,9)><$voicel(1,8)><$facial(1,4)>Hahaha. Weeell, just let me know if you change your mind.
msgctxt "2022:491"
msgid "<$comeff(1,9)><$voicel(1,8)><$facial(1,4)>Ja, ja, ja. Siiin problema, oye. Si te lo piensas mejor,<br>¡aquí me tendrás!"
msgstr ""

#. en: <$comeff(1,21)><$motion(1,801)><$facial(1,5)><$voicel(1,9)>Hey thaaanks. I think we made a good <$cdef(27)><$spwfull(12)></color>.
msgctxt "2022:492"
msgid "<$comeff(1,21)><$motion(1,801)><$facial(1,5)><$voicel(1,9)>¡Gracias, maj<gen;-2(o,a)>! Ha sido un gustazo <$cdef(27)><$spwfull(12)></color> contigo."
msgstr "<$comeff(1,21)><$motion(1,801)><$facial(1,5)><$voicel(1,9)>¡Gracias, amig<gen;-2(o,a)>! Fue un gustazo <$cdef(27)><$spwfull(12)></color> contigo."

#. en: <$comeff(1,6)><$motion(1,803)><$voicel(1,9)>Oh, you don’t want it? All riiight. Just let me know if you<br>change your mind.
msgctxt "2022:493"
msgid "<$comeff(1,6)><$motion(1,803)><$voicel(1,9)>¿Prefieres no hacerlo? No pasa na. Si cambias de idea,<br>seré toood<gen;-3(o,a)> oídos."
msgstr ""

#. en: <$comeff(1,21)><$motion(1,801)><$facial(1,5)><$voicel(1,9)>Hey thaaanks. I think we made a good <$cdef(27)><$spwfull(12)></color>.<clear><br><$motion(1,803)><$comeff(1,13)><$voicel(1,7)>Oh heyyy... I guess I’m out of things now. I’ll get some<br>more stuff later, OK?
msgctxt "2022:494"
msgid "<$comeff(1,21)><$motion(1,801)><$facial(1,5)><$voicel(1,9)>Graaacias. Así da gusto <$cdef(27)><$spwfull(12)></color>.<clear><br><$motion(1,803)><$comeff(1,13)><$voicel(1,7)>Uy, ahora que lo pienso... ¡Esa era la última unidad!<clear><br>No te preocupes, que pienso proveerme de lo lindo<br>para la próxima vez."
msgstr ""

#. en: <$facial(1,4)><$voicel(1,7)><$comeff(1,13)><$motion(1,801)>Heyyy. I’m going to be at the <$cdef(27)><fqty(1)><$ifull(1325)></color> today. Why<br>don’t you come check it out, <$cdef(27)><pname;0></color>?
msgctxt "2022:495"
msgid "<$facial(1,4)><$voicel(1,7)><$comeff(1,13)><$motion(1,801)>Para variar, hoy me toca ir a la <$cdef(27)><fqty(1)><$ifull(1325)></color>.<br>¿Te apetece acompañarme, <$cdef(27)><pname;0></color>?"
msgstr "<$facial(1,4)><$voicel(1,7)><$comeff(1,13)><$motion(1,801)>Para variar, hoy me toca ir a la <$cdef(27)><fqty(1)><$ifull(1325)></color>.<br>¿Quieres acompañarme, <$cdef(27)><pname;0></color>?"

#. en: <$facial(1,4)><$motion(1,803)><$voicel(1,7)><$comeff(1,13)>I’m aaall done for today. Come see me again sometime.
msgctxt "2022:496"
msgid "<$facial(1,4)><$motion(1,803)><$voicel(1,7)><$comeff(1,13)>Ya he cerrado el chiringuito por hoy, maj<gen;-2(ete,a)>, pero espero<br>verte cuando reabra."
msgstr "<$facial(1,4)><$motion(1,803)><$voicel(1,7)><$comeff(1,13)>Ya cerré el puesto por hoy, maj<gen;-2(ete,a)>, pero espero<br>verte cuando reabra."

#. en: <$voicel(1,7)><$comeff(1,21)><$motion(1,803)><$facial(1,5)>Oooh, how prettyyy.
msgctxt "2022:497"
msgid "<$voicel(1,7)><$comeff(1,21)><$motion(1,803)><$facial(1,5)>Jo, qué cosa más bonica..."
msgstr "<$voicel(1,7)><$comeff(1,21)><$motion(1,803)><$facial(1,5)>Ay, qué cosa más bonita..."

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Wow, thaaanks! I was just starting to get kinda hungry...
msgctxt "2022:500"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Justo ahora me estaba entrando un poco de gusa.<br>¡Gracias!"
msgstr "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Justo ahora me estaba entrando un poco de hambre.<br>¡Gracias!"

#. en: <$voicel(1,10)><$emotion(1,6)>I really like morning sounds...<clear><br><$voicel(1,5)><$facial(1,1)><$motion(1,805)><$comeff(1,14)>Things are gettin’ buuusy, but it’s still kinda quiet.<br>So different from afternoon and evening.<slide><br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Isn’t it niiice?
msgctxt "2022:501"
msgid "<$voicel(1,10)><$emotion(1,6)>Nada como los sonidos mañaneros.<clear><br><$voicel(1,5)><$facial(1,1)><$motion(1,805)><$comeff(1,14)>Es como mitad alboroto y mitad tranquilidad, ¿no?<br>Y luego eso no pasa ni por la tarde ni por la noche...<clear><br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>¡Da mucho gustico, oye!"
msgstr "<$voicel(1,10)><$emotion(1,6)>Nada como los sonidos mañaneros.<clear><br><$voicel(1,5)><$facial(1,1)><$motion(1,805)><$comeff(1,14)>Es como mitad alboroto y mitad tranquilidad, ¿no?<br>Y luego eso no pasa ni por la tarde ni por la noche...<clear><br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>¡Da mucho gustito, oye!"

#. en: <$voicel(1,7)><$emotion(1,39)><$pkcry;0(1,2)>... Afternoon is soooooo...warm and nice.<clear><br><$voicel(1,4)><$motion(1,805)><$facial(1,14)><$comeff(1,16)>I can sleep and sleep and sleep and still be sleeeepyyy...
msgctxt "2022:502"
msgid "<oneline><$voicel(1,7)><$emotion(1,39)>¡<$pkcry;0(1,2)>! Se está muy a gusto con el calorcico<br>a esta hora...<clear><br><$voicel(1,4)><$motion(1,805)><$facial(1,14)><$comeff(1,16)>Tanto, que me entran unas ganas de siesta..."
msgstr "<oneline><$voicel(1,7)><$emotion(1,39)>¡<$pkcry;0(1,2)>! Se está muy a gusto con el calorcito<br>a esta hora...<clear><br><$voicel(1,4)><$motion(1,805)><$facial(1,14)><$comeff(1,16)>Tanto, que me entran unas ganas de siesta..."

#. en: <$voicel(1,5)><$motion(1,803)><$comeff(1,3)>I’ve been zoning out almost aaall day. It’s going to be<br>nighttime before you know it...<clear><br><$voicel(1,8)><$emotion(1,8)>I guess it’s OK to have days like this every now<br>and then...
msgctxt "2022:503"
msgid "<$voicel(1,5)><$motion(1,803)><$comeff(1,3)>Hay días que me dedico a contemplar la vida y se me<br>hace de noche enseguida...<clear><br><$voicel(1,8)><$emotion(1,8)>No te digo que me disguste, ¿eh?"
msgstr ""

#. en: <$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Woooooow... It’s like there’s a party going on in the sky<br>at night...<clear><br><$voicel(1,5)><$motion(1,805)><$facial(1,1)><$comeff(1,6)>Do you think all those twinkly stars are sleeping during<br>the day?
msgctxt "2022:504"
msgid "<$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Cuando cae la noche, ¡parece que hay un guateque<br>en el cielo con tanta actividad! Ja, ja, ja.<clear><br><$voicel(1,5)><$motion(1,805)><$facial(1,1)><$comeff(1,6)>¿Y dónde andarán las estrellas de día? Seguro que<br>echándose una siestecica después de tanto baile."
msgstr "<$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Cuando cae la noche, ¡parece que hay una fiesta<br>en el cielo con tanta actividad! Ja, ja, ja.<clear><br><$voicel(1,5)><$motion(1,805)><$facial(1,1)><$comeff(1,6)>¿Y dónde andarán las estrellas de día? Seguro que<br>echándose una siestecita después de tanto baile."

#. en: <$voicel(1,5)><$motion(1,805)><$comeff(1,14)>All the humans are gone from around here, but...<clear><br><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Maaaybe they just went out for a walk and forgot how to<br>get back...
msgctxt "2022:507"
msgid "<$voicel(1,5)><$motion(1,805)><$comeff(1,14)>Qué raro eso de que ya no haya humanos por aquí...<clear><br><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¿Y si se fueron a dar un paseíco y luego no supieron<br>cómo volver a casa?"
msgstr "<$voicel(1,5)><$motion(1,805)><$comeff(1,14)>Qué raro eso de que ya no haya humanos por aquí...<clear><br><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¿Y si se fueron a dar un paseíto y luego no supieron<br>cómo volver a casa?"

#. en: <oneline><$comeff(1,10)><$facial(1,4)><$motion(1,661)><$voicel(1,7)>Heyyy. I was just looking up at the sky and found a bunch<br>of clouds that look like you, <$cdef(27)><pname;0></color>.<clear><br><$motion(1,666)><$voicel(1,7)>There were biiig <$cdef(27)><pname;1> </color>clouds and<br>liiittle<slide><br><$cdef(27)><pname;2> </color>clouds...<clear><br><$comeff(1,1)><$motion(1,803)><$voicel(1,7)>I even saw one cloud that looked like you when<br>you’re <$cdef(27)><$spwfull(36)>ed</color>.<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,10)>I hope I can find some clouds that are shaped like<br>me sometime...
msgctxt "2022:508"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,661)><$voicel(1,7)>Antes estaba yo mirando al cielo, y he visto unas nubes<br>que eran clavadicas a ti, <$cdef(27)><pname;0></color>.<clear><br><$motion(1,666)><$voicel(1,7)>Las había hermosotas y las había chiquiticas, y todas se<br>daban un aire. <$comeff(1,1)><$motion(1,803)><$voicel(1,7)>¡Hasta he visto una o dos que se parecían<slide><br>a ti después de <$cdef(27)>transformarte<nbs2><$spwicon(36)></color>!<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,10)>A ver si otro día veo alguna que se parezca a mí..."
msgstr "<$comeff(1,10)><$facial(1,4)><$motion(1,661)><$voicel(1,7)>Antes estaba yo mirando al cielo, y vi unas nubes<br>que eran igualitas a ti, <$cdef(27)><pname;0></color>.<clear><br><$motion(1,666)><$voicel(1,7)>Las había grandotas y las había chiquititas, y todas se<br>te parecían. <$comeff(1,1)><$motion(1,803)><$voicel(1,7)>¡Hasta vi una o dos que eran igualitas<slide><br>a ti después de <$cdef(27)>transformarte<nbs2><$spwicon(36)></color>!<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,10)>A ver si otro día veo alguna que se parezca a mí..."

#. en: <oneline><$comeff(1,10)><$facial(1,4)><$motionoff(1,804)><$voicel(1,7)>Heyyy, <$cdef(27)><pname;0></color>. I just had a dream<br>where<slide><br>we<slide><br>were<slide><br>eating<slide><br>berries<slide><br>together.<clear><br><$facial(1,3)><$motion(1,803)><$voicel(1,8)>But they were spiky and had weeeiiird markings on them...<clear><br><$comeff(1,23)><$facial(1,9)><$motion(1,802)><$voicel(1,3)>And they smelled reeeaaally funny, like maybe they weren’t<br>safe to eat...<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,8)>But they were super yuuummy...<clear><br><$comeff(1,3)><$voicel(1,7)>If I ever actually find one in real life, I’ll come show you<br>first before aaanyone else.
msgctxt "2022:509"
msgid "<oneline><$comeff(1,10)><$facial(1,4)><$motionoff(1,804)><$voicel(1,7)>He soñao que estábamos tú y yo comiendo bayas, <$facial(1,3)><$motion(1,803)><$voicel(1,8)>unas<br>con pinchos que tenían un dibujo muy raro en la piel.<clear><br><$comeff(1,23)><$facial(1,9)><$motion(1,802)><$voicel(1,3)>Su olor también venía siendo sospechoso, y pa mí que<br>igual no debíamos comérnoslas, <$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,8)>pero estaban tan ricas...<clear><br><$comeff(1,3)><$voicel(1,7)>Si encuentro esas bayas de verdad, te las traigo pa que<br>las veas."
msgstr "<oneline><$comeff(1,10)><$facial(1,4)><$motionoff(1,804)><$voicel(1,7)>Soñé que estábamos tú y yo comiendo bayas, <$facial(1,3)><$motion(1,803)><$voicel(1,8)>unas<br>con pinchos que tenían un dibujo muy raro en la piel.<clear><br><$comeff(1,23)><$facial(1,9)><$motion(1,802)><$voicel(1,3)>Su olor también venía siendo sospechoso, y pa mí que<br>no debíamos comérnoslas, <$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,8)>pero estaban tan ricas...<clear><br><$comeff(1,3)><$voicel(1,7)>Si encuentro esas bayas de verdad, te las traigo pa que<br>las veas."

#. en: <$voicel(1,5)><$emotion(1,14)>OK... That’s all for today, huh? Please come back<br>and see me next time too...
msgctxt "2022:516"
msgid "<$voicel(1,5)><$emotion(1,14)>Creo que ya va siendo hora de cerrar y descansar, sí.<br>Pásate por aquí otro día, ¿vale?"
msgstr "<$voicel(1,5)><$emotion(1,14)>Creo que ya va siendo hora de cerrar y descansar, sí.<br>Pásate por aquí otro día, ¿sí?"

#. en: <oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Heyyy, <$cdef(27)><pname;0></color>. You should come<br><$cdef(27)><$spwfull(12)></color><slide><br>with meee...
msgctxt "2022:517"
msgid "<oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¡Eh, <$cdef(27)><pname;0></color>! Vente p'aquí un ratico,<br>que vamos<slide><br>a <$cdef(27)><$spwfull(12)></color><slide><br>tú y yo."
msgstr "<oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¡Eh, <$cdef(27)><pname;0></color>! Vente p'aquí un ratito,<br>que vamos<slide><br>a <$cdef(27)><$spwfull(12)></color><slide><br>tú y yo."

#. en: <oneline><$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>I saw <$cdef(27)><shoppk;0> </color>over at the <$cdef(27)><fqty(1)><$ifull(1325)><br></color>doing<slide><br>some<slide><br><$cdef(27)><$spwfull(12)>s</color><slide><br>or sooomething.
msgctxt "2022:518"
msgid "<$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,9)><fcap><dart;0()><$cdef(27)><shoppk;0> </color>está en la <$cdef(27)><fqty(1)><$ifull(1325)></color> hoy,<br>¡y se le da muy bien <$cdef(27)><$spwfull(12)></color>! A ver qué me llevo..."
msgstr ""

#. en: <$emotion(1,8)><$voicel(1,5)>I used to run into huuumans swimming around back in<br>the day...<clear><br><$comeff(1,10)><$facial(1,9)><$voicel(1,3)>They were so good at it, but they always just swam around<br>a whiiile and then went back to the land...<clear><br><$emotion(1,55)><$voicel(1,6)>Why didn’t they just live in the waaater?
msgctxt "2022:520"
msgid "<$emotion(1,8)><$voicel(1,5)>Antes era normal encontrarse a montones de humanos<br>nadando en el mar.<clear><br><$comeff(1,10)><$facial(1,9)><$voicel(1,3)>A todos se les daba tan bien que nunca entendí por qué<br>siempre terminaban regresando a tierra firme.<clear><br><$emotion(1,55)><$voicel(1,6)>¿Qué tiene de malo vivir en el agua?"
msgstr ""

#. en: <oneline><$comeff(1,10)><$facial(1,3)><$motion(1,661)><$voicel(1,7)>Heyyy, I heard you’re going around watering lots of<br>things for all us Pokémon.<clear><br><$comeff(1,8)><$facial(1,4)><$motionoff(1,804)><$voicel(1,9)>Hehehe... That’s really greeeaaat of you,<br><$cdef(27)><pname;0></color>.
msgctxt "2022:521"
msgid "<$comeff(1,10)><$facial(1,3)><$motion(1,661)><$voicel(1,7)>Me han contao que estás riega que te riega pa que<br>podamos vivir todos más a gusto.<clear><br><$comeff(1,8)><$facial(1,4)><$motionoff(1,804)><$voicel(1,9)>Ja, ja, ja, ¡sigue así, brib<gen;-2(ón,ona)>, que haces muy bien! ¡Yo te<br>animo las veces que haga falta!"
msgstr "<$comeff(1,10)><$facial(1,3)><$motion(1,661)><$voicel(1,7)>Me contaron que estás riega que te riega pa que<br>podamos vivir todos más a gusto.<clear><br><$comeff(1,8)><$facial(1,4)><$motionoff(1,804)><$voicel(1,9)>Ja, ja, ja, ¡sigue así, brib<gen;-2(ón,ona)>, que haces muy bien! ¡Yo te<br>animo las veces que haga falta!"

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>I picked up some of these a minute ago... I’ll share with<br>you, <$cdef(27)><pname;0></color>.
msgctxt "2022:522"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Acabo de encontrar esto tirao en el suelo. ¡Toma, pa ti!"
msgstr ""

#. en: <oneline><$voicel(1,9)><$emotion(1,8)>I have fun with <$cdef(27)><nlpairpk;0> </color>no matter what we<br>do together.<clear><br><$voicel(1,8)><$motion(1,803)><$comeff(1,10)>We even have fun just doing nooothing together...
msgctxt "2022:523"
msgid "<oneline><$voicel(1,9)><$emotion(1,8)>Con <dart;0()><$cdef(27)><nlpairpk;0></color> siempre me lo paso<br>estupendamente,<slide><br>hagamos lo que hagamos.<clear><br><$voicel(1,8)><$motion(1,803)><$comeff(1,10)>¡Incluso si no hacemos nada!"
msgstr "<oneline><$voicel(1,9)><$emotion(1,8)>Con <dart;0()><$cdef(27)><nlpairpk;0></color> siempre la paso<br>estupendamente,<slide><br>hagamos lo que hagamos.<clear><br><$voicel(1,8)><$motion(1,803)><$comeff(1,10)>¡Incluso si no hacemos nada!"

#. en: <oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,14)>You know <qty;0(that,those)><br><$cdef(27)><fqty(1)><class><nlqueitem;0></color><slide><br>you<slide><br>gave<slide><br>me<slide><br>earlier?<slide><br><$voicel(1,10)><$emotion(1,39)><qty;0(It’s,They’re)><slide><br>really<slide><br>nice.<slide><br>Thaaank you.<clear><br><$voicel(1,7)><$motion(1,803)><$comeff(1,9)>I can’t thank you enough... <qty;0(It,They)> made me so haaappy!
msgctxt "2022:524"
msgid "<oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,14)><fcap><dart;0()><$cdef(27)><fqty(1)><class><nlqueitem;0></color> que me<br>diste...<clear><br><$voicel(1,10)><$emotion(1,39)>¡Me gust<qty;0(ó,aron)> una barbaridad, oye! Muchas gracias, maj<gen;-2(o,a)>.<br><$voicel(1,7)><$motion(1,803)><$comeff(1,9)>No me cansaré nunca de agradecértelo."
msgstr "<oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,14)><fcap><dart;0()><$cdef(27)><fqty(1)><class><nlqueitem;0></color> que me<br>diste...<clear><br><$voicel(1,10)><$emotion(1,39)>¡Me gust<qty;0(ó,aron)> una barbaridad, oye! Muchas gracias, amig<gen;-2(o,a)>.<br><$voicel(1,7)><$motion(1,803)><$comeff(1,9)>No me cansaré nunca de agradecértelo."

#. en: <$voicel(1,5)><$emotion(1,14)>Heyyy, I heard that you can make houses juuust like the<br>ones humans lived in, <$cdef(27)><pname;0></color>.<clear><br><$voicel(1,7)><$emotion(1,39)>That’s so cooool... If I could make a house like that, I bet I<br>could relax and take it easy anywhere in the wooorld.<clear><br><$voicel(1,6)><$motion(1,805)><$comeff(1,14)>I sure would like to try living in a hooouuuse...
msgctxt "2022:525"
msgid "<$voicel(1,5)><$emotion(1,14)>Oye, me han dicho que tú sabes construir casas como<br>las de los humanos.<clear><br><$voicel(1,7)><$emotion(1,39)>Qué maravilla... Si yo tuviera una así, las siestecicas que<br>me pegaría serían de aúpa.<clear><br><$voicel(1,6)><$motion(1,805)><$comeff(1,14)>Hmm... Cuanto más lo pienso, más me gusta la idea."
msgstr "<$voicel(1,5)><$emotion(1,14)>Oye, me dijeron que tú sabes construir casas como<br>las de los humanos.<clear><br><$voicel(1,7)><$emotion(1,39)>Qué maravilla... Si yo tuviera una así, las siestecitas que<br>me echaría serían increíbles.<clear><br><$voicel(1,6)><$motion(1,805)><$comeff(1,14)>Hmm... Cuanto más lo pienso, más me gusta la idea."

#. en: <$voicel(1,7)><$motion(1,805)><$comeff(1,10)>It feels suuuper great to just go straight to sleep when a<br>wave of sleepiness hits, you know?<clear><br><$voicel(1,5)><$emotion(1,14)>So, aaanyway...it’s time for me to sleep, I think... We can<br>keep playing in my dreams...
msgctxt "2022:526"
msgid "<$voicel(1,7)><$motion(1,805)><$comeff(1,10)>Cuando te entra el sueño, na mejor que irse a planchar<br>la oreja, sin pensárselo dos veces.<clear><br><$voicel(1,5)><$emotion(1,14)>Así que voy a predicar con el ejemplo. ¡Buenas noches,<br>y nos vemos en mis sueños! Ja, ja."
msgstr "<$voicel(1,7)><$motion(1,805)><$comeff(1,10)>Cuando te entra el sueño, nada mejor que irse a echar<br>una siesta, sin pensárselo dos veces.<clear><br><$voicel(1,5)><$emotion(1,14)>Así que voy a predicar con el ejemplo. ¡Buenas noches,<br>y nos vemos en mis sueños! Ja, ja."

#. en: <oneline><$voicel(1,3)><$motion(1,805)><$facial(1,14)><$comeff(1,16)>*yaaaaawn* I would reeeaaally like to sit and talk with you<br>more, <$cdef(27)><pname;0></color>...but I’m a little sleepy.<slide><br><$voicel(1,6)><$motion(1,807)><$facial(1,1)><$comeff(1,14)>I<slide><br>wish<slide><br>someone<slide><br>could<slide><br>just<slide><br>siphon<slide><br>out<slide><br>all<slide><br>my sleepiness...<clear><br><$voicel(1,7)><$emotion(1,8)>Oh... Sleeping is actually pretty great though, huh?<br>Maybe sleepiness is a good thing after all...
msgctxt "2022:527"
msgid "<$voicel(1,3)><$motion(1,805)><$facial(1,14)><$comeff(1,16)>Uaaah... Me encantaría hablar, maj<gen;-2(o,a)>, pero estoy que<br>me caigo de sueño...<clear><br><$voicel(1,6)><$motion(1,807)><$facial(1,1)><$comeff(1,14)>Ojalá viniese alguien a robarme todo el sueño<br>y quedárselo...<clear><br><$voicel(1,7)><$emotion(1,8)>¿Pero qué digo? Con el gustico que da dormir..."
msgstr "<$voicel(1,3)><$motion(1,805)><$facial(1,14)><$comeff(1,16)>Uaaah... Me encantaría hablar, amig<gen;-2(o,a)>, pero estoy que<br>me caigo de sueño...<clear><br><$voicel(1,6)><$motion(1,807)><$facial(1,1)><$comeff(1,14)>Ojalá viniera alguien a robarme todo el sueño<br>y quedárselo...<clear><br><$voicel(1,7)><$emotion(1,8)>¿Pero qué digo? Con el gustito que da dormir..."

#. en: <$voicel(1,10)><$emotion(1,6)>I love the orange color of the sky in the evening...<clear><br><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>If I’m just chillin’ in the air around that time, it’s almost<br>like I become the same color and blend into the skyyy...
msgctxt "2022:528"
msgid "<$voicel(1,10)><$emotion(1,6)>El tono anaranjado del cielo al atardecer es bien bonico.<clear><br><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Al volar a esas horas, siento que hasta yo mism<gen;-3(o,a)> voy a<br>acabar teñid<gen;-3(o,a)> de ese color."
msgstr "<$voicel(1,10)><$emotion(1,6)>El tono anaranjado del cielo al atardecer es bien bonito.<clear><br><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Al volar a esas horas, siento que hasta yo mism<gen;-3(o,a)> voy a<br>acabar teñid<gen;-3(o,a)> de ese color."

#. en: <$voicel(1,5)><$emotion(1,14)>The more I polish my shiny body, the shinier it gets...<br><$voicel(1,8)><$motion(1,807)><$comeff(1,10)>It just keeps getting shinier and shiiinier...<clear><br><$voicel(1,3)><$motion(1,805)><$comeff(1,6)>If my body gets much shinier...it might get so<br>blinding that I won’t sleep well...
msgctxt "2022:529"
msgid "<$voicel(1,5)><$emotion(1,14)>De tanto pulirme, tengo el cuerpo cada vez más y más<br>lustroso, <$voicel(1,8)><$motion(1,807)><$comeff(1,10)>¿has visto?<clear><br><$voicel(1,3)><$motion(1,805)><$comeff(1,6)>Si sigo así ¿crees que me volveré tan reflectante que<br>nadie podrá dormir a mi alrededor?"
msgstr "<$voicel(1,5)><$emotion(1,14)>De tanto pulirme, tengo el cuerpo cada vez más y más<br>lustroso, <$voicel(1,8)><$motion(1,807)><$comeff(1,10)>¿lo notaste?<clear><br><$voicel(1,3)><$motion(1,805)><$comeff(1,6)>Si sigo así ¿crees que me volveré tan reflectante que<br>nadie podrá dormir a mi alrededor?"

#. en: <$voicel(1,5)><$motion(1,805)><$comeff(1,14)>I once wilted my favorite flower on accident with my<br>poison... <$voicel(1,2)><$motion(1,802)><$facial(1,9)><$comeff(1,18)>It made me so sad...<clear><br><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,3)>But, before long, another of the saaame flower grew up in<br>the saaame spot as the first one. <$voicel(1,10)><$motion(1,801)><$facial(1,5)><$comeff(1,21)>And I was so happy...
msgctxt "2022:530"
msgid "<$voicel(1,5)><$motion(1,805)><$comeff(1,14)>Una vez, se me acabó marchitando una flor preciosa<br>que tenía <$voicel(1,2)><$motion(1,802)><$facial(1,9)><$comeff(1,18)>por culpa de mi veneno...<clear><br><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,3)>Pero, fíjate tú, ¡enseguida salió otra flor igualica en el<br>mismo sitio!<clear><br><$voicel(1,10)><$motion(1,801)><$facial(1,5)><$comeff(1,21)>Eso sí que me alegró el día."
msgstr "<$voicel(1,5)><$motion(1,805)><$comeff(1,14)>Una vez, se me acabó marchitando una flor preciosa<br>que tenía <$voicel(1,2)><$motion(1,802)><$facial(1,9)><$comeff(1,18)>por culpa de mi veneno...<clear><br><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,3)>Pero, fíjate tú, ¡enseguida salió otra flor igualita en el<br>mismo lugar!<clear><br><$voicel(1,10)><$motion(1,801)><$facial(1,5)><$comeff(1,21)>Eso sí que me alegró el día."

#. en: <$voicel(1,5)><$motion(1,805)><$comeff(1,6)>You know how you can bump into things when you’re<br>zoning out on a walk?<clear><br><$voicel(1,7)><$motion(1,803)><$comeff(1,10)>That doesn’t bother me because my body’s soft<br>and I just bounce off... <$voicel(1,10)><$emotion(1,8)>I sure am glad I’m so soooft.
msgctxt "2022:531"
msgid "<$voicel(1,5)><$motion(1,805)><$comeff(1,6)>¿No te pasa que te golpeas con todo tipo de cosas al<br>caminar por ahí sin prestar atención?<clear><br><$voicel(1,7)><$motion(1,803)><$comeff(1,10)>A mí, mucho, pero como soy tan blandic<gen;-3(o,a)> no me doy ni<br>cuenta, ja, ja.<clear><br><$voicel(1,10)><$emotion(1,8)>Menos mal, oye... ¡Qué sufrimiento si no!"
msgstr "<$voicel(1,5)><$motion(1,805)><$comeff(1,6)>¿No te pasa que te golpeas con todo tipo de cosas al<br>caminar por ahí sin prestar atención?<clear><br><$voicel(1,7)><$motion(1,803)><$comeff(1,10)>A mí, mucho, pero como soy tan blandit<gen;-3(o,a)> no me doy ni<br>cuenta, ja, ja.<clear><br><$voicel(1,10)><$emotion(1,8)>Menos mal, oye... ¡Qué sufrimiento si no!"

#. en: <$voicel(1,5)><$motion(1,805)><$comeff(1,3)>My body’s really tough, you knooow? So even walking<br>through grass with prickly bits <$voicel(1,8)><$motion(1,803)><$comeff(1,9)><$facial(1,4)>doesn’t hurt me at all.<clear><br><$voicel(1,9)><$motion(1,801)><$facial(1,4)><$comeff(1,10)>It actually kinda tickles. Heheheee...
msgctxt "2022:532"
msgid "<$voicel(1,5)><$motion(1,805)><$comeff(1,3)>Con lo dur<gen;-3(o,a)> que soy, puedo pasar entre arbustos con<br>pinchos <$voicel(1,8)><$motion(1,803)><$comeff(1,9)><$facial(1,4)>y no me hago na de daño.<clear><br><$voicel(1,9)><$motion(1,801)><$facial(1,4)><$comeff(1,10)>¡De hecho, hasta me hacen algo de cosquillicas! Ja, ja."
msgstr "<$voicel(1,5)><$motion(1,805)><$comeff(1,3)>Con lo dur<gen;-3(o,a)> que soy, puedo pasar entre arbustos con<br>espinas <$voicel(1,8)><$motion(1,803)><$comeff(1,9)><$facial(1,4)>y no me hago nada de daño.<clear><br><$voicel(1,9)><$motion(1,801)><$facial(1,4)><$comeff(1,10)>¡De hecho, hasta me hacen algo de cosquillitas! Ja, ja."

#. en: <$voicel(1,5)><$motion(1,803)><$comeff(1,10)>When biiig Pokémon jump into the water...<clear><br><$voicel(1,7)><$motion(1,805)><$comeff(1,6)>it makes a huuuuuuge splash, right?<clear><br><$voicel(1,9)><$emotion(1,39)>I secretly kinda wish I could do that too...
msgctxt "2022:533"
msgid "<$voicel(1,5)><$motion(1,803)><$comeff(1,6)>¿Alguna vez has visto un Pokémon grandote saltar<br>al agua?<clear><br><$voicel(1,7)><$motion(1,805)><$comeff(1,10)>¡Menudas olas crean cuando lo hacen! ¡Son tremebundas!<br><$voicel(1,9)><$emotion(1,39)>Si te digo la verdad, me dan algo de envidia..."
msgstr "<$voicel(1,5)><$motion(1,803)><$comeff(1,6)>¿Alguna vez has visto un Pokémon grandote saltar<br>al agua?<clear><br><$voicel(1,7)><$motion(1,805)><$comeff(1,10)>¡Vaya olas crean cuando lo hacen! ¡Son tremebundas!<br><$voicel(1,9)><$emotion(1,39)>Si te digo la verdad, me dan algo de envidia..."

#. en: <$voicel(1,5)><$motion(1,803)><$comeff(1,10)>I like the berries way up high... Not too many<br>Pokémon can reach so high, you know?<clear><br><$voicel(1,7)><$emotion(1,8)>I get a looot of berries that way. It sure is nice to be taaall.<clear><br><$voicel(1,3)><$motion(1,805)><$comeff(1,7)><$facial(1,1)>But I also have to eat a lot to support this big body...<br>So I run out of berries fast...<clear><br><$voicel(1,2)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>Maybe being tall isn’t the best after all...
msgctxt "2022:534"
msgid "<$voicel(1,5)><$motion(1,803)><$comeff(1,10)>Yo siempre voy a por las bayas que estén en la parte más<br>alta de los árboles.<clear><br><$voicel(1,7)><$emotion(1,8)>¿Que por qué? ¡Pues porque hay menos competencia<br>y así toco a más! Esto de ser tan alt<gen;-3(o,a)> es una gozada.<clear><br><$voicel(1,3)><$motion(1,805)><$comeff(1,7)><$facial(1,1)>Aunque, también te digo, por culpa de mi altura tengo<br>que comer muchas más bayas, así que me las zampo<slide><br>todas enseguida...<clear><br><$voicel(1,2)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>Pensándolo bien, esto de ser tan alt<gen;-3(o,a)> es un petardo."
msgstr "<$voicel(1,5)><$motion(1,803)><$comeff(1,10)>Yo siempre voy por las bayas que estén en la parte más<br>alta de los árboles.<clear><br><$voicel(1,7)><$emotion(1,8)>¿Que por qué? ¡Pues porque hay menos competencia<br>y así me tocan más! Esto de ser tan alt<gen;-3(o,a)> es genial.<clear><br><$voicel(1,3)><$motion(1,805)><$comeff(1,7)><$facial(1,1)>Aunque, también te digo, por culpa de mi altura tengo<br>que comer muchas más bayas, así que me las acabo<slide><br>todas enseguida...<clear><br><$voicel(1,2)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>Pensándolo bien, esto de ser tan alt<gen;-3(o,a)> es un fastidio."

#. en: <$voicel(1,5)><$emotion(1,14)>You use moves like <$cdef(27)><$sklfull(1)> </color>and <$cdef(27)><$sklfull(3)> </color>to<br>make living spaces, yeeeaaah? <$voicel(1,4)><$motion(1,805)><$comeff(1,6)>But don’t you use any fiiire?<clear><br><$voicel(1,7)><$emotion(1,8)>Let me know if you ever need any fiiire. I would be sooo<br>happy to help you out like you help us out...
msgctxt "2022:535"
msgid "<$voicel(1,5)><$emotion(1,14)>Tú sueles usar <$cdef(27)><$sklfull(1)></color> y <$cdef(27)><$sklfull(3)></color> para<br>prepararle casicas a la gente, ¿no?<clear><br><$voicel(1,4)><$motion(1,805)><$comeff(1,6)>¿Pero sabes usar también movimientos con fuego?<clear><br><$voicel(1,7)><$emotion(1,8)>Si necesitas ayuda con eso, avísame cuando sea.<br>Yo encantad<gen;-3(o,a)> de ayudar."
msgstr "<$voicel(1,5)><$emotion(1,14)>Tú sueles usar <$cdef(27)><$sklfull(1)></color> y <$cdef(27)><$sklfull(3)></color> para<br>prepararle casitas a la gente, ¿no?<clear><br><$voicel(1,4)><$motion(1,805)><$comeff(1,6)>¿Pero sabes usar también movimientos con fuego?<clear><br><$voicel(1,7)><$emotion(1,8)>Si necesitas ayuda con eso, avísame cuando sea.<br>Yo encantad<gen;-3(o,a)> de ayudar."

#. en: <$voicel(1,9)><$emotion(1,7)>My faaavorite thing to do is just stare out at the sea and<br>do nooothing.<clear><br><$voicel(1,5)><$motion(1,805)><$facial(1,1)><$comeff(1,14)>The surface of the water gets all sparkly with the sun’s bright<br>light <$voicel(1,8)><$facial(1,4)><$comeff(1,21)>and the cooool light of the moon...<clear><br><$voicel(1,10)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>Ahhhhhh... I could stare at it foreeever...
msgctxt "2022:536"
msgid "<$voicel(1,9)><$emotion(1,7)>Para mí, el mayor placer de esta vida es contemplar<br>el mar.<clear><br><$voicel(1,5)><$motion(1,805)><$facial(1,1)><$comeff(1,14)>La intensa luz del sol y el tenue brillo de la luna <$voicel(1,8)><$facial(1,4)><$comeff(1,21)>reflejados<br>en la superficie del agua...<clear><br><$voicel(1,10)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>No me canso nunca de admirarlo."
msgstr ""

#. en: <$voicel(1,9)><$emotion(1,6)>I love getting caught in the rain. But I looove<br>sunbathing too...<clear><br><$voicel(1,7)><$motion(1,803)><$facial(1,1)><$comeff(1,10)>Either way, I feel great and forget aaall my worries.
msgctxt "2022:537"
msgid "<$voicel(1,9)><$emotion(1,6)>Adoro tanto el cosquilleo de la lluvia como el calorcico<br>del sol.<clear><br><$voicel(1,7)><$motion(1,803)><$facial(1,1)><$comeff(1,10)>Me dan tanto gustirrinín que me relajo y me olvido<br>de todo."
msgstr "<$voicel(1,9)><$emotion(1,6)>Adoro tanto el cosquilleo de la lluvia como el calorcito<br>del sol.<clear><br><$voicel(1,7)><$motion(1,803)><$facial(1,1)><$comeff(1,10)>Me dan tanto gustito que me relajo y me olvido<br>de todo."

#. en: <$voicel(1,5)><$emotion(1,14)>Feel free to wake me up if you find me sleeping<br>somewhere...<clear><br><$voicel(1,3)><$motion(1,807)><$comeff(1,10)>But wake me geeently, OK? Sometimes I get startled and<br>discharge a bunch of electricity...
msgctxt "2022:538"
msgid "<$voicel(1,5)><$emotion(1,14)>Oye, no me importa nada si necesitas despertarme para<br>lo que sea.<clear><br><$voicel(1,3)><$motion(1,807)><$comeff(1,10)>Eso sí, a veces se me saltan las chispas del susto si no se<br>me despierta con cuidado... ¡<gen;-3(El,La)> que avisa no es trai<gen;-3(dor,dora)>!"
msgstr ""

#. en: <$emotion(1,14)><$voicel(1,7)>Psychic powers are really convenient... I can get berries<br>from faaaaar away <$emotion(1,8)><$voicel(1,10)>even while lying down and relaxing.<clear><br><$comeff(1,17)><$facial(1,1)><$motion(1,807)><$voicel(1,5)>But using the powers does make me a little tiiired. That’s<br>the only downside...
msgctxt "2022:539"
msgid "<$emotion(1,14)><$voicel(1,7)>Tener poderes psíquicos es una gozada. Puedes atraer<br>bayas con la mente hasta ti, <$emotion(1,8)><$voicel(1,10)>incluso estando tumbadic<gen;-3(o,a)>.<clear><br><$comeff(1,17)><$facial(1,1)><$motion(1,807)><$voicel(1,5)>Eso sí, después de usarlos te quedas pa'l arrastre...<br>No se puede tener todo en esta vida."
msgstr "<$emotion(1,14)><$voicel(1,7)>Tener poderes psíquicos es genial. Puedes atraer<br>bayas con la mente hasta ti, <$emotion(1,8)><$voicel(1,10)>incluso estando echadit<gen;-3(o,a)>.<clear><br><$comeff(1,17)><$facial(1,1)><$motion(1,807)><$voicel(1,5)>Eso sí, después de usarlos te quedas sin energía...<br>No se puede tener todo en esta vida."

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>I used to be friends with humans too when they were<br>still around.<clear><br><$voicel(1,5)><$motion(1,805)><$facial(1,1)><$comeff(1,14)>But I tried talking to them on a daaark night once, and they<br>all just ran away...<clear><br><$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>I just wanted to tell them to watch out for things lurking<br>in the dark, you knooow?
msgctxt "2022:541"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>No me creerás, pero yo antes me llevaba de maravilla<br>con los humanos.<clear><br><$voicel(1,5)><$motion(1,805)><$facial(1,1)><$comeff(1,14)>Aunque me acuerdo de una vez que me aparecí ante uno<br>por la noche y... ¡salió por patas!<clear><br><$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>Yo lo único que quería era preguntarle la hora..."
msgstr "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>No me creerás, pero yo antes me llevaba de maravilla<br>con los humanos.<clear><br><$voicel(1,5)><$motion(1,805)><$facial(1,1)><$comeff(1,14)>Aunque me acuerdo de una vez que me aparecí ante uno<br>por la noche y... ¡salió corriendo!<clear><br><$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>Yo lo único que quería era preguntarle la hora..."

#. en: <$voicel(1,7)><$motion(1,805)><$comeff(1,14)>Different Pokémon do things at different paces, riiight?<br>Like walking or eating...<clear><br><$voicel(1,5)><$emotion(1,14)>But you knooow...as long as we can all make it back home<br>in the end, <$voicel(1,8)><$emotion(1,8)>I don’t think our pace matters much.
msgctxt "2022:542"
msgid "<$voicel(1,7)><$motion(1,805)><$comeff(1,14)>Caminar, comer... Cada cual hace las cosas a su ritmo.<clear><br><$voicel(1,5)><$emotion(1,14)>Si es que al final da igual a qué velocidad hagas las cosas,<br><$voicel(1,8)><$emotion(1,8)>siempre y cuando puedas volver a casica al final del día."
msgstr "<$voicel(1,7)><$motion(1,805)><$comeff(1,14)>Caminar, comer... Cada cual hace las cosas a su ritmo.<clear><br><$voicel(1,5)><$emotion(1,14)>Si es que al final da igual a qué velocidad hagas las cosas,<br><$voicel(1,8)><$emotion(1,8)>siempre y cuando puedas volver a casita al final del día."

#. en: <$voicel(1,7)><$motion(1,805)><$comeff(1,3)>I kiiinda freaked out a Pokémon passing by the other day<br><$voicel(1,6)><$motion(1,803)><$comeff(1,10)>when I was reeeaaally zoning out... But all I did was say “hi.”<clear><br><$voicel(1,3)><$motion(1,807)><$comeff(1,4)>Guess I looked like a statue or something since I<br>wasn’t moving at all...
msgctxt "2022:543"
msgid "<$voicel(1,7)><$motion(1,805)><$comeff(1,3)>Ayer estaba pensando en mis cosas, como sieeempre,<br><$voicel(1,6)><$motion(1,803)><$comeff(1,10)>cuando saludé a unos Pokémon que pasaban por ahí...<clear><br><$voicel(1,3)><$motion(1,807)><$comeff(1,4)>Vaya susto se llevaron todos... Supongo que ni me habían<br>visto, como estaba ahí quiet<gen;-3(o,a)>..."
msgstr ""

#. en: <$voicel(1,7)><$motion(1,805)><$comeff(1,6)>No matter hooow full I get, I’m always hungry again after I<br>get a little sleep...<clear><br><$voicel(1,5)><$emotion(1,14)>So when I have a looot of things I want to eat but can’t<br>eat them all, <$voicel(1,8)><$motion(1,801)><$facial(1,4)><$comeff(1,10)>I just take a quick nap. Hehehe...
msgctxt "2022:544"
msgid "<$voicel(1,7)><$motion(1,805)><$comeff(1,6)>¿No te pasa que, aunque te vayas a dormir con la panza<br>llena, te despiertas con hambre?<clear><br><$voicel(1,5)><$emotion(1,14)>Cuando tengo mucha comida que no me puedo acabar,<br><$voicel(1,8)><$motion(1,801)><$facial(1,4)><$comeff(1,10)>¡me echo una siestecica y me la como al despertar!"
msgstr "<$voicel(1,7)><$motion(1,805)><$comeff(1,6)>¿No te pasa que, aunque te vayas a dormir con la panza<br>llena, te despiertas con hambre?<clear><br><$voicel(1,5)><$emotion(1,14)>Cuando tengo mucha comida que no me puedo acabar,<br><$voicel(1,8)><$motion(1,801)><$facial(1,4)><$comeff(1,10)>¡me echo una siestecita y me la como al despertar!"

#. en: <$voicel(1,8)><$emotion(1,14)>I ranked the top three things that make me happy.<clear><br><$voicel(1,6)><$comeff(1,10)>In third is sleeping a lot...<clear><br><$voicel(1,8)><$facial(1,4)><$comeff(1,9)><$motion(1,805)>In seeecond is sleeping a lot...on something soft<br>and fluffy.<clear><br><$voicel(1,6)><$comeff(1,14)><$facial(1,1)>And fiiirst place goes to...<wait(0.9)><$voicel(1,10)><$motion(1,801)><$facial(1,5)><$comeff(1,21)>being asked by you to do<br>important stuff,<$cdef(27)> <pname;0></color>.<clear><br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,8)>Congratulaaations. You topped my list. So ask me to do<br>lots of important stuuuff, OK?
msgctxt "2022:545"
msgid "<$voicel(1,8)><$emotion(1,14)>Tengo una lista de las cosas que más feliz me hacen:<br><$voicel(1,6)><$comeff(1,10)>En tercer lugar, dormir a pierna suelta.<clear><br><$voicel(1,8)><$facial(1,4)><$comeff(1,9)><$motion(1,805)>En segundo lugar, dormir a pierna suelta sobre algo<br>blandico y cómodo.<clear><br><$voicel(1,6)><$comeff(1,14)><$facial(1,1)>Y en primer lugar...<wait(0.9)> <$cdef(27)><$voicel(1,10)><$motion(1,801)><$facial(1,5)><$comeff(1,21)></color>¡que me pidas que te ayude!<clear><br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,8)>Enhorabuena, eres lo primero primerito en mi lista.<br>Pídeme cualquier cosa que necesites, ¿eeeh?"
msgstr "<$voicel(1,8)><$emotion(1,14)>Tengo una lista de las cosas que más feliz me hacen:<br><$voicel(1,6)><$comeff(1,10)>En tercer lugar, dormir a pierna suelta.<clear><br><$voicel(1,8)><$facial(1,4)><$comeff(1,9)><$motion(1,805)>En segundo lugar, dormir a pierna suelta sobre algo<br>blandito y cómodo.<clear><br><$voicel(1,6)><$comeff(1,14)><$facial(1,1)>Y en primer lugar...<wait(0.9)> <$cdef(27)><$voicel(1,10)><$motion(1,801)><$facial(1,5)><$comeff(1,21)></color>¡que me pidas que te ayude!<clear><br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,8)>Felicidades, eres lo primero primerito en mi lista.<br>Pídeme cualquier cosa que necesites, ¿eeeh?"

#. en: <$voicel(1,7)><$emotion(1,14)><$cdef(27)><nlpairpk;0> </color>and I are so alike... It’s weeeiiird.<clear><br><$voicel(1,9)><$emotion(1,39)>The other day, we both yawned at the exact same time...
msgctxt "2022:546"
msgid "<oneline><$voicel(1,7)><$emotion(1,14)><fcap><dart;0()><$cdef(27)><nlpairpk;0></color> y yo nos compenetramos<br>perfectamente.<slide><br><$voicel(1,9)><$emotion(1,39)>El otro día, hasta bostezamos a la vez."
msgstr ""

#. en: <oneline><$voicel(1,9)><$emotion(1,7)>Thank you sooo much for the<br><$cdef(27)><fqty(1)><class><nlqueitem;0></color><slide><br>you<slide><br>gave me...<clear><br><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)><qty;0(It was,They were)> so gooood. I really took my time enjoying<br><qty;0(it,them)>...
msgctxt "2022:547"
msgid "<oneline><$voicel(1,9)><$emotion(1,7)>Muchas gracias por <dart;0()><$cdef(27)><fqty(1)><nlqueitem;0></color><br>que me regalaste,<slide><br>majet<gen;-2(e,a)>.<clear><br><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Estab<qty;0(a,an)> tan ric<genqty;0(o,a,os,as)> que no me quedó otra que saborearl<genqty;0(o,a,os,as)><br>muuuy despacio."
msgstr "<oneline><$voicel(1,9)><$emotion(1,7)>Muchas gracias por <dart;0()><$cdef(27)><fqty(1)><nlqueitem;0></color><br>que me regalaste,<slide><br>jef<gen;-2(e,a)>.<clear><br><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Estab<qty;0(a,an)> tan ric<genqty;0(o,a,os,as)> que no me quedó otra que saborearl<genqty;0(o,a,os,as)><br>muuuy despacio."

#. en: <oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>I really want to have a niiice, slooow chat with<br><$cdef(27)><crstlktar;0></color><slide><br>sometime, but...<clear><br><$voicel(1,5)><$motion(1,805)><$facial(1,1)><$comeff(1,14)>We live so faaar away from each other... We might be too<br>tired to even talk <$voicel(1,4)><$motion(1,807)><$facial(1,9)><$comeff(1,17)>if we have to go so far just to meet up...
msgctxt "2022:548"
msgid "<oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>Me encantaría poder charlar más con<br><dart;0()><$cdef(27)><crstlktar;0></color><slide><br>y conocerl<gen;0(o,a)> mejor.<clear><br><$voicel(1,5)><$motion(1,805)><$facial(1,1)><$comeff(1,14)>Pero vive taaan lejos, que solo con ir hasta su casica me<br>agoto y se me quitan <$voicel(1,4)><$motion(1,807)><$facial(1,9)><$comeff(1,17)>hasta las ganas de parlotear..."
msgstr "<oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>Me encantaría poder charlar más con<br><dart;0()><$cdef(27)><crstlktar;0></color><slide><br>y conocerl<gen;0(o,a)> mejor.<clear><br><$voicel(1,5)><$motion(1,805)><$facial(1,1)><$comeff(1,14)>Pero vive taaan lejos, que solo con ir hasta su casita me<br>agoto y se me quitan <$voicel(1,4)><$motion(1,807)><$facial(1,9)><$comeff(1,17)>hasta las ganas de parlotear..."

#. en: <$voicel(1,5)><$motion(1,805)><$comeff(1,6)>Heyyy, do you know <$cdef(27)><crstlktar;1></color>?<clear><br><$voicel(1,3)><$motion(1,807)><$comeff(1,7)><$facial(1,9)>We never get to see each other... Maybe if we lived<br>closer together <$voicel(1,8)><$motion(1,803)><$comeff(1,10)><$facial(1,4)>we could hang out and taaalk more.
msgctxt "2022:549"
msgid "<$voicel(1,5)><$motion(1,805)><$comeff(1,6)>¿Conoces <esa;1()><$cdef(27)><crstlktar;1></color>?<clear><br><$voicel(1,3)><$motion(1,807)><$comeff(1,7)><$facial(1,9)>Pues no coincidimos nunca... Ojalá nuestras casas<br>estuvieran una chispina más cerca...<clear><br><$voicel(1,8)><$motion(1,803)><$comeff(1,10)><$facial(1,4)>Así, a lo mejor podríamos quedar para charlar un ratico<br>más a menudo..."
msgstr "<$voicel(1,5)><$motion(1,805)><$comeff(1,6)>¿Conoces <esa;1()><$cdef(27)><crstlktar;1></color>?<clear><br><$voicel(1,3)><$motion(1,807)><$comeff(1,7)><$facial(1,9)>Pues no coincidimos nunca... Ojalá nuestras casas<br>estuvieran un poquito más cerca...<clear><br><$voicel(1,8)><$motion(1,803)><$comeff(1,10)><$facial(1,4)>Así, a lo mejor podríamos vernos para charlar un ratito<br>más a menudo..."

#. en: <oneline><$voicel(1,7)><$emotion(1,8)>Yayyy, <$cdef(27)><pname;0></color>. Here’s a present just<br>for you.
msgctxt "2022:550"
msgid "<$voicel(1,7)><$emotion(1,8)>Toma, te mereces un regalico."
msgstr "<$voicel(1,7)><$emotion(1,8)>Toma, te mereces un regalito."

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Mmmmmm... It’s so relaaaxing to sit around at home.<clear><br><$voicel(1,10)><$emotion(1,8)>Thanks so much for making me such a niiice place.
msgctxt "2022:551"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Aaah... Qué gustico estar en casa tranquiiil<gen;-3(o,a)>...<br><$voicel(1,10)><$emotion(1,8)>¡Gracias por regalarme esta casica tan estupenda!"
msgstr "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Aaah... Qué gustito estar en casa tranquiiil<gen;-3(o,a)>...<br><$voicel(1,10)><$emotion(1,8)>¡Gracias por regalarme esta casita tan estupenda!"

#. en: <$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Yaaay! OK, here’s a question...<clear><br><$voicel(1,5)><$motion(1,805)><$comeff(1,6)><$facial(1,1)>What is <$cdef(27)><qtargetpk;0></color>’s faaavorite flavor?
msgctxt "2022:552"
msgid "<$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Ja, ja. Sabía que te gustaría el reto. Ahí va.<clear><br><$voicel(1,5)><$motion(1,805)><$comeff(1,6)><$facial(1,1)>¿Cuál es el sabor preferido <esde;0()><$cdef(27)><qtargetpk;0></color>?"
msgstr ""

#. en: ...<wait(0.4)><$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,20)>That’s riiight! Well done, <$cdef(27)><pname;0></color>.
msgctxt "2022:554"
msgid "...<wait(0.4)> <$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,20)>¡Bingooo! Ya sabía yo que ibas a acertar."
msgstr ""

#. en: ...<wait(0.4)><$voicel(1,5)><$motion(1,803)><$comeff(1,10)>Oh nooo. That’s not correct... The right answer was<br><$cdef(27)><ltasteq;0></color>.<clear><br><$voicel(1,8)><$emotion(1,8)>But heyyy, I hope we can do this quiz thing again<br>sometime.
msgctxt "2022:555"
msgid "<oneline>...<wait(0.4)> <$voicel(1,5)><$motion(1,803)><$comeff(1,10)>Uyyy, ¡no es correcto! La respuesta es<br>el <$cdef(27)><ltasteq;0></color>.<clear><br><$voicel(1,8)><$emotion(1,8)>No pasa na, seguro que a la próxima aciertas."
msgstr "<oneline>...<wait(0.4)> <$voicel(1,5)><$motion(1,803)><$comeff(1,10)>Uyyy, ¡no es correcto! La respuesta es<br>el <$cdef(27)><ltasteq;0></color>.<clear><br><$voicel(1,8)><$emotion(1,8)>No pasa nada, seguro que a la próxima aciertas."

#. en: <$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Yaaay! OK, here’s a question...<clear><br><$voicel(1,5)><$motion(1,805)><$comeff(1,6)><$facial(1,1)>What flavor does <$cdef(27)><qtargetpk;0> </color>reeeaaally dislike?
msgctxt "2022:557"
msgid "<$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>A ver si esta te la sabes...<clear><br><$voicel(1,5)><$motion(1,805)><$comeff(1,6)><$facial(1,1)>¿Cuál es el sabor que no soporta <dart;0()><$cdef(27)><qtargetpk;0></color>?"
msgstr ""

#. en: ...<wait(0.4)><$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,20)>That’s riiight! Well done, <$cdef(27)><pname;0></color>.
msgctxt "2022:559"
msgid "<oneline>...<wait(0.4)> <$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,20)>¡Bingooo! Si es que te las sabes todas,<br><$cdef(27)><pname;0></color>."
msgstr ""

#. en: ...<wait(0.4)><$voicel(1,5)><$motion(1,803)><$comeff(1,10)>Oh nooo. That’s not correct... The right answer was<br><$cdef(27)><htasteq;0></color>.<clear><br><$voicel(1,8)><$emotion(1,8)>But heyyy, I hope we can do this quiz thing again<br>sometime.
msgctxt "2022:560"
msgid "<oneline>...<wait(0.4)> <$voicel(1,5)><$motion(1,803)><$comeff(1,10)>Uyyy, ¡no es correcto! La respuesta es<br><dart;0()><$cdef(27)><htasteq;0></color>.<clear><br><$voicel(1,8)><$emotion(1,8)>Otro día puedes probar suerte de nuevo."
msgstr ""

#. en: <$voicel(1,8)><$motion(1,803)><$comeff(1,10)>Yaaay! OK, here’s a question...<clear><br><$voicel(1,5)><$motion(1,805)><$comeff(1,6)>What’s <$cdef(27)><qtargetpk;0></color>’s faaavorite thing?
msgctxt "2022:562"
msgid "<$voicel(1,8)><$motion(1,803)><$comeff(1,10)>Venga, pues, a ver qué tiene dentro esa cabecica...<clear><br><$voicel(1,5)><$motion(1,805)><$comeff(1,6)>¿Qué es lo que más le gusta <esa;0()><$cdef(27)><qtargetpk;0></color>?"
msgstr "<$voicel(1,8)><$motion(1,803)><$comeff(1,10)>Bueno, pues, a ver qué tiene adentro esa cabecita...<clear><br><$voicel(1,5)><$motion(1,805)><$comeff(1,6)>¿Qué es lo que más le gusta <esa;0()><$cdef(27)><qtargetpk;0></color>?"

#. en: ...<wait(0.4)><$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,20)>That’s riiight! Well done, <$cdef(27)><pname;0></color>.
msgctxt "2022:564"
msgid "<oneline>... <wait(0.4)><$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,20)>¡Eeeso es! Sabía que acertarías,<br><$cdef(27)><pname;0></color>."
msgstr ""

#. en: ...<wait(0.4)><$voicel(1,3)><$motion(1,805)><$comeff(1,10)>Oh nooo. That’s not correct... The right answer was<br><$cdef(27)><likemtag;0></color>.<clear><br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>But heyyy, I hope we can do this quiz thing again<br>sometime.
msgctxt "2022:565"
msgid "... <wait(0.4)><$voicel(1,3)><$motion(1,805)><$comeff(1,10)>No, te has equivocado. Lo que más le gusta <qty;0(es,son)><br><dart;0()><$cdef(27)><likemtag;0></color>.<clear><br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>A ver si volvemos a jugar a las adivinanzas otro día, ¿eh?"
msgstr "... <wait(0.4)><$voicel(1,3)><$motion(1,805)><$comeff(1,10)>No, te equivocaste. Lo que más le gusta <qty;0(es,son)><br><dart;0()><$cdef(27)><likemtag;0></color>.<clear><br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>A ver si volvemos a jugar a las adivinanzas otro día, ¿eh?"

#. en: <$voicel(1,9)><$motion(1,801)><$comeff(1,8)><$facial(1,5)>Thanks for playing with me today! I’d love to do it<br>again sometime.
msgctxt "2022:566"
msgid "<$voicel(1,9)><$motion(1,801)><$comeff(1,8)><$facial(1,5)>Gracias por hacerme compañía hoy. Ojalá nos veamos<br>pronto de nuevo."
msgstr ""

#. en: <oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,6)>Heyyy, do you have any<br><$cdef(27)><fqty(2)><class><refmateid;1></color>?<clear><br><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>If you do, I can turn them into<br><$cdef(27)><fqty(2)><class><reftarid;3></color>,<slide><br>you know?
msgctxt "2022:569"
msgid "<oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,6)>Oye, <$cdef(27)><pname;0></color>, ¿tienes<br><$cdef(27)><fqty(2)><class><refmateid;1></color>?<clear><br><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Si sí, podría procesarl<gen;0(os,as)> y darte<br><$cdef(27)><fqty(2)><class><reftarid;3></color>..."
msgstr ""

#. en: <oneline><$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>Hmmmmm... I dunno much about<br><$cdef(27)><fqty(2)><class><referrmate;0></color>.<clear><br><$voicel(1,6)><$emotion(1,14)><$facial(1,1)><$cdef(27)><referrpk;1></color> might, though...
msgctxt "2022:570"
msgid "<oneline><$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>Uf... Yo no tengo ni pajolera idea de<br><$cdef(27)><fqty(2)><class><referrmate;0></color>.<slide><br><$voicel(1,6)><$emotion(1,14)><$facial(1,1)>¿Por qué no se lo pides <esa;1()><$cdef(27)><referrpk;1></color>?"
msgstr "<oneline><$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>Uf... Yo no tengo ni la menor idea de<br><$cdef(27)><fqty(2)><class><referrmate;0></color>.<slide><br><$voicel(1,6)><$emotion(1,14)><$facial(1,1)>¿Por qué no se lo pides <esa;1()><$cdef(27)><referrpk;1></color>?"

#. en: <oneline><$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>Hmmmmm... I dunno much about<br><$cdef(27)><fqty(2)><class><referrmate;0></color>.<clear><br><$voicel(1,2)><$motion(1,805)><$comeff(1,14)><$facial(1,1)>And I dunno any other Pokémon who would, eeeiiither...
msgctxt "2022:571"
msgid "<oneline><$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>Uf... Yo no tengo ni pajolera idea de<br><$cdef(27)><fqty(2)><class><referrmate;0></color>.<slide><br><$voicel(1,2)><$motion(1,805)><$comeff(1,14)><$facial(1,1)>Y tampoco sé quién te podría ayudar con eso..."
msgstr "<oneline><$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>Uf... Yo no tengo ni la menor idea de<br><$cdef(27)><fqty(2)><class><referrmate;0></color>.<slide><br><$voicel(1,2)><$motion(1,805)><$comeff(1,14)><$facial(1,1)>Y tampoco sé quién te podría ayudar con eso..."

#. en: <oneline><$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>Hmmmmm... I dunno much about<br><$cdef(27)><fqty(2)><class><referrmate;0></color>.<clear><br><$voicel(1,5)><$emotion(1,14)>Buuut if you’ve got any<br><$cdef(27)><fqty(2)><class><refmateid;2></color>...<slide><br>I<slide><br>can<slide><br>turn<slide><br>those<slide><br>into<slide><br><$voicel(1,8)><$comeff(1,10)><$cdef(27)><fqty(2)><class><reftarid;3></color><slide><br>if<slide><br>you liiike.<clear><br><$voicel(1,6)><$motion(1,805)><$comeff(1,6)>How about it?
msgctxt "2022:572"
msgid "<oneline><$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>Uf... Yo no tengo ni pajolera idea de<br><fqty(2)><$cdef(27)><class><referrmate;0></color>...<slide><br><$voicel(1,5)><$emotion(1,14)>pero si me das<slide><br><$cdef(27)><fqty(2)><class><refmateid;2></color>,<slide><br>te <gen;2(los,las)> proceso y te doy<slide><br><$voicel(1,8)><$comeff(1,10)><$cdef(27)><fqty(2)><class><reftarid;3></color>.<clear><br><$voicel(1,6)><$motion(1,805)><$comeff(1,6)>¿Cómo lo ves?"
msgstr "<oneline><$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>Uf... Yo no tengo ni la menor idea de<br><fqty(2)><$cdef(27)><class><referrmate;0></color>...<slide><br><$voicel(1,5)><$emotion(1,14)>pero si me das<slide><br><$cdef(27)><fqty(2)><class><refmateid;2></color>,<slide><br>te <gen;2(los,las)> proceso y te doy<slide><br><$voicel(1,8)><$comeff(1,10)><$cdef(27)><fqty(2)><class><reftarid;3></color>.<clear><br><$voicel(1,6)><$motion(1,805)><$comeff(1,6)>¿Cómo lo ves?"

#. en: <oneline><$voicel(1,8)><$emotion(1,14)>You want some<br><$cdef(27)><fqty(2)><class><reftarid;0></color>?<clear><br><$voicel(1,5)><$motion(1,805)><$comeff(1,10)>OK. Just put some<br><$cdef(27)><fqty(2)><class><refmateid;2></color><slide><br>in<slide><br>the<slide><br><$cdef(27)><fqty(1)><reftable;1></color>,<slide><br>all riiight?<clear><br><$voicel(1,8)><$emotion(1,8)>I’ll process them up later...
msgctxt "2022:573"
msgid "<oneline><$voicel(1,8)><$emotion(1,14)>¿Quieres<br><$cdef(27)><fqty(2)><class><reftarid;0></color>?<clear><br><$voicel(1,5)><$motion(1,805)><$comeff(1,10)>Pues deja<br><dart;2()><$cdef(27)><fqty(1)><class><refmateid;2></color><slide><br>en<slide><br><dart;1()><$cdef(27)><fqty(1)><class><reftable;1></color><slide><br><$voicel(1,8)><$emotion(1,8)>y yo me encargo."
msgstr ""

#. en: <oneline><$voicel(1,7)><$motion(1,803)><$comeff(1,6)>In order to make<br><$cdef(27)><fqty(2)><class><reftarid;0></color>,<slide><br>I<slide><br>gotta<slide><br>have<slide><br><iart;1()><$cdef(27)><fqty(1)><reftable;1></color>.<clear><br><$voicel(1,5)><$motion(1,805)><$comeff(1,6)>Can you get me <iart;2()><$cdef(27)><fqty(1)><reftable;2><br></color>fiiirst?
msgctxt "2022:574"
msgid "<$cdef(27)><oneline></color><$voicel(1,7)><$motion(1,803)><$comeff(1,6)>¿<fqty(2)><fcap><$cdef(27)><class><reftarid;0></color>?<br>Para hacértel<genqty;0(o,a,os,as)><slide><br>necesitaría<slide><br><iart;1()><$cdef(27)><fqty(1)><class><reftable;1></color>.<slide><br><$voicel(1,5)><$motion(1,805)><$comeff(1,6)>¿Podrías traerme <genqty;1(uno,una,unos,unas)>?"
msgstr ""

#. en: <$voicel(1,9)><$emotion(1,39)>Whoooaaa... Somehow I made something even cooler, too.<br><$voicel(1,8)><$motion(1,803)><$comeff(1,10)><$facial(1,4)>Look at it. Looook...
msgctxt "2022:575"
msgid "<$voicel(1,9)><$emotion(1,39)>¡Ah! Ademáaas... no sé cómo, pero me ha salido algo<br>muuucho más costoso que de costumbre...<clear><br><$voicel(1,8)><$motion(1,803)><$comeff(1,10)><$facial(1,4)>¡Mira, mira!"
msgstr "<$voicel(1,9)><$emotion(1,39)>¡Ah! Ademáaas... no sé cómo, pero me salió algo<br>muuucho más costoso que de costumbre...<clear><br><$voicel(1,8)><$motion(1,803)><$comeff(1,10)><$facial(1,4)>¡Mira, mira!"

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>Heeere, you can have this. I picked it up while I was on my<br>way ooover...
msgctxt "2022:576"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>Toma, me he encontrado esto viniendo p'aquí.<br>Te lo regalo."
msgstr "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>Toma, me encontré esto viniendo pa'cá.<br>Te lo regalo."

#. en: <oneline><$emotion(1,39)><$voicel(1,7)>Heyyy,<$cdef(27)> <pname;0></color>. Thanks for waiting...<br>The<slide><br><$cdef(27)><cdirbname;1></color><slide><br>is finished.<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,6)>You should take a look. You know, if you waaant to...
msgctxt "2022:585"
msgid "<oneline><$emotion(1,39)><$voicel(1,7)>Ah, aquí estás. Ya hemos terminado con<br><dart;1()><$cdef(27)><cdirbname;1><slide><br></color>que querías.<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,6)>Échal<qty;1(e,es)> un vistazo, que <qty;1(ha,han)> quedao bien maj<genqty;1(o,a,os,as)>."
msgstr "<oneline><$emotion(1,39)><$voicel(1,7)>Ah, aquí estás. Ya terminamos con<br><dart;1()><$cdef(27)><cdirbname;1><slide><br></color>que querías.<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,6)>Échal<qty;1(e,es)> un vistazo, que <qty;1(ha,han)> quedado bien lind<genqty;1(o,a,os,as)>."

#. en: <$emotion(1,49)><$voicel(1,7)>Time to show off our hard wooork. Here it is...
msgctxt "2022:586"
msgid "<$emotion(1,49)><$voicel(1,7)>Hora de ver los resultados de nuestro esfueeerzo.<br>¡Uno, dos, y...!"
msgstr ""

#. en: <$emotion(1,39)><$voicel(1,7)>We did such a good job... Everyone worked suuuper hard.<clear><br><$comeff(1,3)><$facial(1,1)><$voicel(1,5)>I hope you’ll call on me again next time you want to<br><$cdef(27)><$spwfull(1)> </color>something. I reeeaaally want to help out...
msgctxt "2022:587"
msgid "<$emotion(1,39)><$voicel(1,7)>¡Pardiez! ¡Ha quedado niquelao! El esfuerzo ha merecido<br>la pena.<clear><br><$comeff(1,3)><$facial(1,1)><$voicel(1,5)>Avísame cuando necesites <$cdef(27)><$spwfull(1)></color> cualquier otra<br>cosica, ¿eh?"
msgstr "<$emotion(1,39)><$voicel(1,7)>¡Caramba! ¡Quedó impecable! El esfuerzo valió<br>la pena.<clear><br><$comeff(1,3)><$facial(1,1)><$voicel(1,5)>Avísame cuando necesites <$cdef(27)><$spwfull(1)></color> cualquier otra<br>cosita, ¿eh?"

#. en: <$comeff(1,3)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>Heyyy, sorry if this is kind of sudden, but you should<br>play “look that way” with me...
msgctxt "2022:593"
msgid "<$comeff(1,3)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>Igual te pillo de sopetón, pero es que me han entrao<br>ganas de jugar a \"esquiva la baya\"..."
msgstr "<$comeff(1,3)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>Tal vez es muy de repente, pero es que me dieron<br>ganas de jugar a \"esquiva la baya\"..."

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Yayyy! OK, let’s plaaay...
msgctxt "2022:594"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>¡Di que sí! ¡Vamos a jugar, pillastre!"
msgstr "<$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>¡Di que sí! ¡Vamos a jugar, granujita!"

#. en: <$comeff(1,3)><$facial(1,3)><$motion(1,803)><$voicel(1,3)>Ohhh, OK... Well, let’s play games some other time,<br>when you’re free...
msgctxt "2022:595"
msgid "<$comeff(1,3)><$facial(1,3)><$motion(1,803)><$voicel(1,3)>¡Vaya! Pues na, cuando te apetezca y tengas tiempo,<br>jugamos un ratico."
msgstr "<$comeff(1,3)><$facial(1,3)><$motion(1,803)><$voicel(1,3)>¡Vaya! Pues nada, cuando quieras y tengas tiempo,<br>jugamos un ratito."

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>Whoooaaa... You win. You did reeeaaally well.<clear><br><$comeff(1,9)><$motion(1,801)><$voicel(1,9)>That was a lot of fun. I hope we can hang out more in<br>the future, <$cdef(27)><pname;0></color>.
msgctxt "2022:596"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>¡Ganaste, <$cdef(27)><pname;0></color>!<br>Eres dur<gen;-2(o,a)> de pelar, vaya que sí.<clear><br><$comeff(1,9)><$motion(1,801)><$voicel(1,9)>Lo he disfrutao un montón, granujilla. ¡A ver si jugamos<br>más otro día!"
msgstr "<$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>¡Ganaste, <$cdef(27)><pname;0></color>!<br>Eres dur<gen;-2(o,a)> de pelar, vaya que sí.<clear><br><$comeff(1,9)><$motion(1,801)><$voicel(1,9)>Lo disfruté un montón, granujita. ¡A ver si jugamos<br>más otro día!"

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Wowww, I won? Maybe today is my lucky day...<clear><br><$comeff(1,10)><$facial(1,3)><$motion(1,803)><$voicel(1,7)>That was a lot of fuuun. I hope we can hang out more in<br>the future...
msgctxt "2022:597"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Gané! ¡Qué alegría, oye! Yo creo que hoy es mi día.<clear><br><$comeff(1,10)><$facial(1,3)><$motion(1,803)><$voicel(1,7)>Qué bien se lo pasa <gen;-2(uno,una)> jugando contigo. ¡Ya me estás<br>haciendo otra visita otro día pa repetir!"
msgstr "<$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Gané! ¡Qué alegría, oye! Yo creo que hoy es mi día.<clear><br><$comeff(1,10)><$facial(1,3)><$motion(1,803)><$voicel(1,7)>Qué bien se la pasa <gen;-2(uno,una)> jugando contigo. ¡Ya me estás<br>haciendo otra visita otro día pa repetir!"

#. en: <oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,6)>Heyyy, <$cdef(27)><pname;0></color>. Do you wanna play<br>hide-and-sneak<slide><br>with me?<clear><br>I wanna be the one who goes seeeaaarching, <$voicel(1,8)><$motion(1,803)><$comeff(1,10)>so you can be<br>the one who hides.
msgctxt "2022:610"
msgid "<oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,6)><$cdef(27)><pname;0></color>, ¿quieres jugar al escondite<br>camuflado?<clear><br><$voicel(1,8)><$motion(1,803)><$comeff(1,10)>Te toca esconderte a ti, ¿valeee?"
msgstr "<oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,6)><$cdef(27)><pname;0></color>, ¿quieres jugar al escondite<br>camuflado?<clear><br><$voicel(1,8)><$motion(1,803)><$comeff(1,10)>Te toca esconderte a ti, ¿de acuerdooo?"

#. en: <$voicel(1,7)><$motion(1,803)><$comeff(1,9)><$facial(1,4)>Yaaayyy. I’m gonna try hard to win...
msgctxt "2022:611"
msgid "<$voicel(1,7)><$motion(1,803)><$comeff(1,9)><$facial(1,4)>¡Así me gusta! Ya verás como no me ganas."
msgstr ""

#. en: <$comeff(1,3)><$facial(1,3)><$motion(1,803)><$voicel(1,3)>Ohhh, OK... Well, let’s play games some other time,<br>when you’re free...
msgctxt "2022:612"
msgid "<$comeff(1,3)><$facial(1,3)><$motion(1,803)><$voicel(1,3)>Vaya chasco... Otro día que te venga bien, jugamos."
msgstr ""

#. en: <oneline><$voicel(1,5)><$emotion(1,14)>Oh nooo, I lost... You’re gooood at this, huh,<br><$cdef(27)><pname;0></color>?
msgctxt "2022:617"
msgid "<oneline><$voicel(1,5)><$emotion(1,14)>Pues he perdidooo... Sí que sabes esconderte bien,<br>pillastre..."
msgstr "<oneline><$voicel(1,5)><$emotion(1,14)>Pues perdíiii... Sí que sabes esconderte bien,<br>granujita..."

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Time really fliiieees when you’re having fun, huh? Here,<br>this is a prize for a game well played today...
msgctxt "2022:618"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Cuando te diviertes, el tiempo pasa que ni te enteras,<br>¿eh? Toma, te has ganado esto."
msgstr "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Cuando te diviertes, el tiempo pasa que ni te enteras,<br>¿eh? Toma, te ganaste esto."

#. en: <$voicel(1,7)><$emotion(1,8)>It sure was fun to play that game together. I’m kinda sad<br>it’s ooover...
msgctxt "2022:619"
msgid "<$voicel(1,7)><$emotion(1,8)>Me lo paso tan bien con este juego... Qué pena que se<br>haya acabado..."
msgstr "<$voicel(1,7)><$emotion(1,8)>Me la paso tan bien con este juego... Qué pena que se<br>haya acabado..."

#. en: <oneline><$comeff(1,3)><$facial(1,2)><$voicel(1,5)>It feels kinda weird to ask this, but...<$comeff(1,8)><$facial(1,4)><$motion(1,801)><$voicel(1,8)>we’re suuuper good<br>friends now, right? Riiight?<clear><br><$comeff(1,9)><$motion(1,803)><$voicel(1,9)>Sooo...I hope it’s fine if I call you<br><$cdef(27)><pname;2> </color>now.
msgctxt "2022:620"
msgid "<$comeff(1,3)><$facial(1,2)><$voicel(1,5)>No tengo ni que preguntarlo, pero...<$comeff(1,8)><$facial(1,4)><$motion(1,801)><$voicel(1,8)> tú y yo nos estamos<br>volviendo como uña y carne, ¿eh, brib<gen;-2(ón,ona)>?<clear><br><$comeff(1,9)><$motion(1,803)><$voicel(1,9)>¡Pues pa que se note lo bien que nos llevamos, a partir de<br>ahora te voy a llamar <$cdef(27)><pname;2></color>!"
msgstr ""

#. en: <oneline><$voicel(1,7)><$emotion(1,8)>That was fuuun... I’m glad we got to play together,<br><$cdef(27)><pname;0></color>.
msgctxt "2022:622"
msgid "<oneline><$voicel(1,7)><$emotion(1,8)>¡Qué divertido! Me lo paso pipa jugando contigo,<br>brib<gen;-2(ón,ona)>."
msgstr "<oneline><$voicel(1,7)><$emotion(1,8)>¡Qué divertido! Me la paso genial jugando contigo,<br>brib<gen;-2(ón,ona)>."

#. en: <$voicel(1,7)><$emotion(1,8)>Yaaay... There’s no way I’ll lose.
msgctxt "2022:623"
msgid "<$voicel(1,7)><$emotion(1,8)>¡Así me gusta! Ganaré yo, yaaa verás."
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,14)>OK, got iiit... I hope we can play together sometime<br>when you’re free.
msgctxt "2022:624"
msgid "<$voicel(1,7)><$emotion(1,14)>Vaaaya, qué penica. Pues ya me dirás cuándo te viene<br>bien."
msgstr "<$voicel(1,7)><$emotion(1,14)>Vaaaya, qué penita. Pues ya me dirás cuándo te viene<br>bien."

#. en: <$voicel(1,3)><$motion(1,805)><$comeff(1,7)>Uhhhhhh... Is the <$cdef(27)><fqty(1)><$ifull(1325)> </color>taking a breeeaaak?<br>It won’t turn on...<clear><br><$voicel(1,5)><$motion(1,803)><$comeff(1,6)>I can’t do any <$cdef(27)><$spwfull(12)>s </color>like thiiis. Maybe I’ll take a little<br>break toooo...
msgctxt "2022:667"
msgid "<$voicel(1,3)><$motion(1,805)><$comeff(1,7)>Vaya, hombre... La <$cdef(27)><fqty(1)><$ifull(1325)> </color>no funciona...<br><$comeff(1,6)>¿Se habrá escacharrado?<clear><br><$voicel(1,5)><$motion(1,803)>Pues así no se puede <$cdef(27)><$spwfull(12)></color> en condiciones, oye.<br>Me tendré que tomar un descansico hasta que la arregles.<slide><br>Qué pena más grande..."
msgstr "<$voicel(1,3)><$motion(1,805)><$comeff(1,7)>Vaya, hombre... La <$cdef(27)><fqty(1)><$ifull(1325)> </color>no funciona...<br><$comeff(1,6)>¿Se habrá descompuesto?<clear><br><$voicel(1,5)><$motion(1,803)>Pues así no se puede <$cdef(27)><$spwfull(12)></color> en condiciones, oye.<br>Me tendré que tomar un descansito hasta que la arregles.<slide><br>Qué pena más grande..."

#. en: <oneline><$comeff(1,3)><$motion(1,801)><$voicel(1,7)>Here are all the<br><$cdef(27)><fqty(2)><class><reftarid;0></color><slide><br>I<slide><br>have<slide><br>ready<slide><br>so far...<clear><br><$comeff(1,9)><$facial(1,2)><$motion(1,803)><$voicel(1,6)>I can give you the rest later when they’re dooone...
msgctxt "2022:670"
msgid "<oneline><$comeff(1,3)><$motion(1,801)><$voicel(1,7)>¡Epa, ahí v<qty;0(a,an)> <genqty;0(un,una,algunos,algunas)><br><$cdef(27)><class><reftarid;0><slide><br></color><gen;-2(pa'l,pa la)> granujilla!<clear><br><$comeff(1,9)><$facial(1,2)><$motion(1,803)><$voicel(1,6)>El resto te lo doy cuando termine, en un ratico."
msgstr "<oneline><$comeff(1,3)><$motion(1,801)><$voicel(1,7)>¡Epa, ahí v<qty;0(a,an)> <genqty;0(un,una,algunos,algunas)><br><$cdef(27)><class><reftarid;0><slide><br></color><gen;-2(pa'l,pa la)> granujita!<clear><br><$comeff(1,9)><$facial(1,2)><$motion(1,803)><$voicel(1,6)>El resto te lo doy cuando termine, en un ratito."

#. en: <oneline><$emotion(1,1)><$voicel(1,7)>Yeeeaaaah. I know where <$cdef(27)><pksrchtar;0> </color>is,<br>I think...<clear><br><$emotion(1,29)><$voicel(1,6)>Do you want me to fly you over there?
msgctxt "2022:680"
msgid "<$cdef(27)><$emotion(1,1)></color><$voicel(1,7)>Hombreee, pues creo que sé por dónde podría andar.<br><$emotion(1,29)><$voicel(1,6)>¿Quieres que te lleve allí volando o qué?"
msgstr "<$cdef(27)><$emotion(1,1)></color><$voicel(1,7)>Hombreee, pues creo que sé por dónde podría andar.<br><$emotion(1,29)><$voicel(1,6)>¿Quieres que te lleve allá volando o qué?"

#. en: <oneline><$comeff(1,3)><$motion(1,803)><$voicel(1,7)>Yeeeaaah. I think <$cdef(27)><pksrchtar;0></color> is<br>at home...<clear><br><$comeff(1,6)><$motion(1,666)><$voicel(1,6)>Do you want me to fly you over there?
msgctxt "2022:681"
msgid "<oneline><$comeff(1,3)><$motion(1,803)><$voicel(1,7)>Pues está en su casica. Si no me equivoco, al menos.<br><$comeff(1,6)><$motion(1,666)><$voicel(1,6)>¿Quieres que te lleve allí volando o qué?"
msgstr "<oneline><$comeff(1,3)><$motion(1,803)><$voicel(1,7)>Pues está en su casita. Si no me equivoco, al menos.<br><$comeff(1,6)><$motion(1,666)><$voicel(1,6)>¿Quieres que te lleve allá volando o qué?"

#. en: <oneline><$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,3)>Hmmm... I don’t think I’ve seen<br><$voicel(1,6)><$cdef(27)><pksrchtar;0></color> today...<clear><br><$comeff(1,6)><$facial(1,2)><$motion(1,666)><$voicel(1,3)>Do you want me to fly you over to their home?
msgctxt "2022:682"
msgid "<oneline><$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,3)>Jo, pues... <$voicel(1,6)>hoy no he visto<br><esa;0()><$cdef(27)><pksrchtar;0></color>,<slide><br>majet<gen;-2(e,a)>...<slide><br><$comeff(1,6)><$facial(1,2)><$motion(1,666)><$voicel(1,3)>Pero si quieres, te puedo llevar volando a su casica."
msgstr "<oneline><$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,3)>Ay, pues... <$voicel(1,6)>hoy no vi<br><esa;0()><$cdef(27)><pksrchtar;0></color>,<slide><br>jef<gen;-2(e,a)>...<slide><br><$comeff(1,6)><$facial(1,2)><$motion(1,666)><$voicel(1,3)>Pero si quieres, te puedo llevar volando a su casita."

#. en: <$comeff(1,3)><$motion(1,666)><$voicel(1,5)>I haven’t seen <$cdef(27)><pksrchtar;0></color> around here...<clear><br><$voicel(1,4)><$emotion(1,29)>Maybe they live really faaar away?
msgctxt "2022:683"
msgid "<oneline><$comeff(1,3)><$motion(1,666)><$voicel(1,5)>No me suena haber visto<br><esa;0()><$cdef(27)><pksrchtar;0><slide><br></color>por aquí.<slide><br><$voicel(1,4)><$emotion(1,29)>¿No será que vive por ahí lejos?"
msgstr ""

#. en: <$comeff(1,3)><$motion(1,803)><$voicel(1,5)>OK, coooool... Let’s get goooing.
msgctxt "2022:684"
msgid "<$comeff(1,3)><$motion(1,803)><$voicel(1,5)>Ea, pues vamos que nos vamos."
msgstr "<$comeff(1,3)><$motion(1,803)><$voicel(1,5)>Bueno, ¡pues vámonos!"

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Phew... We made iiit. I’m glad I was able to help.
msgctxt "2022:685"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>¡Llegamos! Y mira, sin despeinarnos. Ja, ja, ja."
msgstr ""

#. en: <oneline><$emotion(1,14)><$voicel(1,5)>Huuuh? Looks like <$cdef(27)><pksrchtar;0></color>’s<br>not heeere...<clear><br><$voicel(1,4)><$comeff(1,6)><$motion(1,666)>Maybe they’re out doing something somewhere else...
msgctxt "2022:686"
msgid "<$emotion(1,14)><$voicel(1,5)>¡Me parece a mí que no está en casica! <$voicel(1,4)><$comeff(1,6)><$motion(1,666)>¿Estará de paseo<br>o algo?"
msgstr "<$emotion(1,14)><$voicel(1,5)>¡Me parece a mí que no está en casita! <$voicel(1,4)><$comeff(1,6)><$motion(1,666)>¿Estará de paseo<br>o algo?"

#. en: <$comeff(1,3)><$motion(1,803)><$voicel(1,5)>Got iiit... Let me knooow if you ever want to<br>fly somewhere.
msgctxt "2022:687"
msgid "<$comeff(1,3)><$motion(1,803)><$voicel(1,5)>Pues nah, majet<gen;-2(e,a)>, abur. Si luego cambias de idea y quieres<br>volar, ya me dices."
msgstr "<$comeff(1,3)><$motion(1,803)><$voicel(1,5)>Pues nada, jef<gen;-2(e,a)>, nos vemos. Si luego cambias de idea<br>y quieres volar, me avisas."

#. en: <oneline><$emotion(1,1)><$voicel(1,7)>Yeeeaaah. I know where <$cdef(27)><pksrchtar;0></color> is,<br>I think...<clear><br><$emotion(1,29)><$voicel(1,6)>Do you want me to <$cdef(27)><$spwfull(35)></color> you over there?
msgctxt "2022:688"
msgid "<oneline><$cdef(27)><$emotion(1,1)></color><$voicel(1,7)>Hombreee, pues creo que sé por dónde podría andar.<br><$emotion(1,29)><$voicel(1,6)>¿Quieres que nos <$cdef(27)>teletransportemos<nbs2><$spwicon(35)> </color>allí o qué?"
msgstr "<oneline><$cdef(27)><$emotion(1,1)></color><$voicel(1,7)>Hombreee, pues creo que sé por dónde podría andar.<br><$emotion(1,29)><$voicel(1,6)>¿Quieres que nos <$cdef(27)>teletransportemos<nbs2><$spwicon(35)> </color>allá o qué?"

#. en: <oneline><$comeff(1,3)><$motion(1,803)><$voicel(1,7)>Yeeeaaah. I think <$cdef(27)><pksrchtar;0></color> is<br>at home...<clear><br><$comeff(1,6)><$facial(1,2)><$motion(1,666)><$voicel(1,6)>Do you want me to <$cdef(27)><$spwfull(35)></color> you over there?
msgctxt "2022:689"
msgid "<$comeff(1,3)><$motion(1,803)><$voicel(1,7)>Si no ando yo equivocad<gen;-3(o,a)>, está en su casica.<br><$comeff(1,6)><$facial(1,2)><$motion(1,666)><$voicel(1,6)>¿Nos <$cdef(27)>teletransportamos<nbs2><$spwicon(35)> </color>allí? ¿Quieres?"
msgstr "<$comeff(1,3)><$motion(1,803)><$voicel(1,7)>Si no ando yo equivocad<gen;-3(o,a)>, está en su casita.<br><$comeff(1,6)><$facial(1,2)><$motion(1,666)><$voicel(1,6)>¿Nos <$cdef(27)>teletransportamos<nbs2><$spwicon(35)> </color>allá? ¿Quieres?"

#. en: <oneline><$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,3)>Hmmm... I don’t think I’ve seen<br><$voicel(1,5)><$cdef(27)><pksrchtar;0></color> today...<clear><br><$comeff(1,6)><$motion(1,666)><$voicel(1,3)>Do you want me to <$cdef(27)><$spwfull(35)></color> you over to their home?
msgctxt "2022:690"
msgid "<oneline><$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,3)>Mira tú por dónde, <$voicel(1,5)>hoy no he visto<br><esa;0()><$cdef(27)><pksrchtar;0></color>...<clear><br><$motion(1,666)><$voicel(1,3)>Pero vaya, te puedo <$cdef(27)><$spwfull(35)> </color>a su casica.<br><$comeff(1,6)>¿Quieres?"
msgstr "<oneline><$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,3)>Mira tú por dónde, <$voicel(1,5)>hoy no vi<br><esa;0()><$cdef(27)><pksrchtar;0></color>...<clear><br><$motion(1,666)><$voicel(1,3)>Pero vaya, te puedo <$cdef(27)><$spwfull(35)> </color>a su casita.<br><$comeff(1,6)>¿Quieres?"

#. en: <$comeff(1,3)><$motion(1,666)><$voicel(1,5)>I haven’t seen <$cdef(27)><pksrchtar;0></color> around here...<clear><br><$voicel(1,4)><$emotion(1,29)>Maybe they live really faaar away?
msgctxt "2022:691"
msgid "<oneline><$comeff(1,3)><$motion(1,666)><$voicel(1,5)>No me suena haber visto<br><esa;0()><$cdef(27)><pksrchtar;0></color><slide><br>por aquí.<slide><br><$voicel(1,4)><$emotion(1,29)>¿No será que vive por ahí lejos?"
msgstr ""

#. en: <$comeff(1,3)><$motion(1,803)><$voicel(1,5)>OK, coooool... Let’s get goooing.
msgctxt "2022:692"
msgid "<$comeff(1,3)><$motion(1,803)><$voicel(1,5)>Ea, ¡pues arreando!"
msgstr "<$comeff(1,3)><$motion(1,803)><$voicel(1,5)>Bueno, ¡pues en marcha!"

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Phew... We made iiit. I’m glad I was able to help.
msgctxt "2022:693"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>¡Llegamos! ¿Has visto qué velocidad? Ja, ja, ja."
msgstr "<$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>¡Llegamos! ¿Viste qué velocidad? Ja, ja, ja."

#. en: <oneline><$emotion(1,14)><$voicel(1,5)>Huuuh? Looks like <$cdef(27)><pksrchtar;0></color>’s<br>not here...<clear><br><$voicel(1,4)><$comeff(1,6)><$motion(1,666)>Maybe they’re out doing something somewhere else...
msgctxt "2022:694"
msgid "<$emotion(1,14)><$voicel(1,5)>Mecachis, si no está en casica. <$voicel(1,4)><$comeff(1,6)><$motion(1,666)>¿Estará por ahí dándose<br>un garbeo?"
msgstr "<$emotion(1,14)><$voicel(1,5)>Rayos, si no está en casita. <$voicel(1,4)><$comeff(1,6)><$motion(1,666)>¿Estará por ahí dando<br>un paseo?"

#. en: <$comeff(1,3)><$motion(1,803)><$voicel(1,5)>Got iiit... Let me knooow if you ever want to<br><$cdef(27)><$spwfull(35)> </color>somewhere.
msgctxt "2022:695"
msgid "<$comeff(1,3)><$motion(1,803)><$voicel(1,5)>¡Pos en otra ocasión! Tú ya me dices, que vengo yo<br>y te <$cdef(27)>teletransporto</color><nbs2><$spwicon(35)> en un visto y no visto."
msgstr "<$comeff(1,3)><$motion(1,803)><$voicel(1,5)>¡Pues en otra ocasión! Tú me avisas, que vengo yo<br>y te <$cdef(27)>teletransporto</color><nbs2><$spwicon(35)> en un dos por tres."

#. en: <oneline><$comeff(1,3)><$motion(1,806)><$voicel(1,7)><$cdef(27)><pksrchtar;0></color>? They’re over thaaat way,<br>I think...
msgctxt "2022:696"
msgid "<$cdef(27)><$comeff(1,3)></color><$motion(1,806)><$voicel(1,7)>¡Me imagino dónde anda! Tira to tieso to tieso en esa<br>dirección y a ver si os cruzáis, majet<gen;-2(e,a)>."
msgstr "<$cdef(27)><$comeff(1,3)></color><$motion(1,806)><$voicel(1,7)>¡Me imagino dónde anda! Sigue derecho, derecho en esa<br>dirección y a ver si se cruzan, jef<gen;-2(e,a)>."

#. en: <$comeff(1,3)><$motion(1,806)><$voicel(1,7)><$cdef(27)><pksrchtar;0></color>? I think they’re at hooome.
msgctxt "2022:697"
msgid "<$cdef(27)><$comeff(1,3)></color><$motion(1,806)><$voicel(1,7)>Me suena que está en su casica, majet<gen;-2(e,a)>."
msgstr "<$cdef(27)><$comeff(1,3)></color><$motion(1,806)><$voicel(1,7)>Me suena que está en su casita, jef<gen;-2(e,a)>."

#. en: <oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,3)><$cdef(27)><pksrchtar;0></color>? Hmmm... I haven’t seen<br>them today...
msgctxt "2022:698"
msgid "<$comeff(1,14)><$motion(1,666)><$voicel(1,3)>Jo, justo hoy no nos hemos cruzao..."
msgstr "<$comeff(1,14)><$motion(1,666)><$voicel(1,3)>Ay, justo hoy no nos cruzamos..."

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>I haven’t seen <$cdef(27)><pksrchtar;0></color> around here...<clear><br><$voicel(1,4)><$emotion(1,29)>Maybe they live really faaar away?
msgctxt "2022:699"
msgid "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Pooos... No me he quedao yo con su cara. <$voicel(1,4)><$emotion(1,29)>Pa mí que<br>vive lejos de aquí, ¿eh?"
msgstr "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Pueees... No me acuerdo yo de su cara. <$voicel(1,4)><$emotion(1,29)>Pa mí que<br>vive lejos de aquí, ¿eh?"

#. en: <oneline><$comeff(1,6)><$motion(1,666)><$voicel(1,5)>Heyyy, <$cdef(27)><pname;0></color>. Are you maybe looking<br>for someone?
msgctxt "2022:700"
msgid "<oneline><$comeff(1,6)><$motion(1,666)><$voicel(1,5)>Tienes cara de que estás buscando a alguien, granujilla,<br>¿sí o no?"
msgstr "<oneline><$comeff(1,6)><$motion(1,666)><$voicel(1,5)>Tienes cara de que estás buscando a alguien, granujita,<br>¿sí o no?"

#. en: <$comeff(1,4)><$motion(1,806)><$voicel(1,3)>Ohhh, OK... I thought maybe you were. My bad...
msgctxt "2022:701"
msgid "<$comeff(1,4)><$motion(1,806)><$voicel(1,3)>Aúpa, pues será que me dio esa impresión... No me hagas<br>caso. Ja, ja, ja."
msgstr "<$comeff(1,4)><$motion(1,806)><$voicel(1,3)>Vaya, pues será que me dio esa impresión... No me hagas<br>caso. Ja, ja, ja."

#. en: <oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Ohhh, <$cdef(27)><pksrchtar;0></color>? Hmmm... I don’t<br>know<slide><br>where<slide><br>they are...
msgctxt "2022:702"
msgid "<$cdef(27)><$comeff(1,14)></color><$motion(1,666)><$voicel(1,5)>Esto... Pues no tengo ni idea de dónde andará..."
msgstr ""

#. en: <$voicel(1,1)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>My comfort leeevel? Hmmm... <$cdef(27)><$stflevel;0(1)></color>, I guess...
msgctxt "2022:750"
msgid "<$voicel(1,1)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>Pueees diría que <wait(1.0)><$cdef(27)><$stflevel;0(1)></color>, granujilla..."
msgstr "<$voicel(1,1)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>Pueees diría que <wait(1.0)><$cdef(27)><$stflevel;0(1)></color>, granujita..."

#. en: <$voicel(1,5)><$emotion(1,14)>My comfort leeevel? Hmmm... <$cdef(27)><$stflevel;0(2)></color>, I guess.
msgctxt "2022:751"
msgid "<$voicel(1,5)><$emotion(1,14)>Majet<gen;-2(e,a)>, me parece <$cdef(27)><$stflevel;0(2)></color>."
msgstr "<$voicel(1,5)><$emotion(1,14)>Jef<gen;-2(e,a)>, me parece <$cdef(27)><$stflevel;0(2)></color>."

#. en: <$voicel(1,5)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>My comfort level? Things are preeeetty <$cdef(27)><flow><$stflevel;0(3)></color>.
msgctxt "2022:752"
msgid "<$voicel(1,5)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>A veeer...<wait(1.0)> ¡yo diría que <$cdef(27)><$stflevel;0(3)></color>!"
msgstr ""

#. en: <$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,21)>My comfort level? Pretty <$cdef(27)><flow><$stflevel;0(4)></color>, I thiiink...
msgctxt "2022:753"
msgid "<$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,21)>¡Ay, pillastre, es <$cdef(27)><$stflevel;0(4)></color>!"
msgstr "<$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,21)>¡Ay, granujita, es <$cdef(27)><$stflevel;0(4)></color>!"

#. en: <$voicel(1,9)><$motion(1,801)><$facial(1,5)><$comeff(1,8)>My comfort level? Things are toootally <$cdef(27)><flow><$stflevel;0(5)></color>...<br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>I feel super comfy every day.
msgctxt "2022:754"
msgid "<$voicel(1,9)><$motion(1,801)><$facial(1,5)><$comeff(1,8)>¡Ja, ja, ja!<wait(1.0)> ¡Si es <$cdef(27)><$stflevel;0(5)> </color>ahora mismo!<br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¡Estoy de un a gustico todos los días que no veas!"
msgstr "<$voicel(1,9)><$motion(1,801)><$facial(1,5)><$comeff(1,8)>¡Ja, ja, ja!<wait(1.0)> ¡Si es <$cdef(27)><$stflevel;0(5)> </color>ahora mismo!<br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¡Estoy de lo más a gustito todos los días!"

#. en: <$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Things are beeetter than they were before, I thiiink...
msgctxt "2022:756"
msgid "<$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Se está mejor que antes, no se puede negar..."
msgstr ""

#. en: <$voicel(1,9)><$emotion(1,8)>Things are waaay better now. Thank you sooo much for all<br>you do for me...
msgctxt "2022:757"
msgid "<$voicel(1,9)><$emotion(1,8)>Está todo mucho mejor que antes, ¿eh? ¡Muchas gracias!"
msgstr ""

#. en: <oneline><$voicel(1,3)><$motion(1,805)><$comeff(1,7)>This <$cdef(27)><fqty(1)><class><aireactp;0> </color>might<br>be<slide><br>a<slide><br>liiittle<slide><br>small<slide><br>for me...<clear><br><$voicel(1,6)><$motion(1,803)><$comeff(1,10)>Something sliiightly bigger would probably be better.
msgctxt "2022:758"
msgid "<oneline><$voicel(1,3)><$motion(1,805)><$comeff(1,7)>Uuuy, <genqty;0(este,esta,estos,estas)> <$cdef(27)><fqty(1)><aireactp;0> </color><qty;0(es,son)><br>un poco<slide><br>trist<qty;0(e,es)>, ¿no?<clear><br><$voicel(1,6)><$motion(1,803)><$comeff(1,10)>¿No había na más grande?"
msgstr "<oneline><$voicel(1,3)><$motion(1,805)><$comeff(1,7)>Uuuy, <genqty;0(este,esta,estos,estas)> <$cdef(27)><fqty(1)><aireactp;0> </color><qty;0(es,son)><br>un poco<slide><br>trist<qty;0(e,es)>, ¿no?<clear><br><$voicel(1,6)><$motion(1,803)><$comeff(1,10)>¿No había nada más grande?"

#. en: <oneline><$voicel(1,7)><$emotion(1,8)>Thaaanks for the<br><$cdef(27)><fqty(1)><class><aireactp;0></color>.
msgctxt "2022:761"
msgid "<$voicel(1,7)><$emotion(1,8)>¡Gracias por <dart;0()><$cdef(27)><fqty(1)><aireactp;0></color>!"
msgstr ""

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>My comfort level? Hmmm... I would know for sure if I was<br>at hooome, but...<clear><br><$comeff(1,7)><$motion(1,802)><$voicel(1,4)><$cdef(27)><$stflevel;0(1)></color>, I guess...
msgctxt "2022:762"
msgid "<oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Jo, si estuviera ahora en mi casica, no tendría que hacer<br>memoria para describírtelo...<wait(1.0)> <$comeff(1,7)><$motion(1,802)><$voicel(1,4)>pero diría que es<slide><br><$cdef(27)><$stflevel;0(1)></color>..."
msgstr "<oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Ay, si estuviera ahora en mi casita, no tendría que hacer<br>memoria para describírtelo...<wait(1.0)> <$comeff(1,7)><$motion(1,802)><$voicel(1,4)>pero diría que es<slide><br><$cdef(27)><$stflevel;0(1)></color>..."

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>My comfort level? Hmmm... I would know for sure if I was<br>at hooome, but...<clear><br><$comeff(1,3)><$motion(1,803)><$voicel(1,6)>Probably <$cdef(27)><flow><$stflevel;0(2)></color>...
msgctxt "2022:763"
msgid "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Atiza, y yo lejos de casica... <wait(1.0)><$comeff(1,3)><$motion(1,803)><$voicel(1,6)>Pues mira, es <$cdef(27)><$stflevel;0(2)></color>."
msgstr "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Caray, y yo lejos de casita... <wait(1.0)><$comeff(1,3)><$motion(1,803)><$voicel(1,6)>Pues mira, es <$cdef(27)><$stflevel;0(2)></color>."

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>My comfort level? Hmmm... I would know for sure if I was<br>at hooome, but...<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,8)>I’m pretty sure it was <$cdef(27)><flow><$stflevel;0(3)></color>...
msgctxt "2022:764"
msgid "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Qué difícil pensar en eso estando fuera de casica...<br><wait(1.0)><$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,8)>Pos mira que te diga, ¡es <$cdef(27)><$stflevel;0(3)></color>!"
msgstr "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Qué difícil pensar en eso estando fuera de casita...<br><wait(1.0)><$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,8)>Pues déjame decirte, ¡es <$cdef(27)><$stflevel;0(3)></color>!"

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>My comfort level? Hmmm... I would know for sure if I was<br>at hooome, but...<clear><br><$comeff(1,21)><$motion(1,801)><$voicel(1,10)><$cdef(27)><$stflevel;0(4)></color>. ♪ Yeeeah...
msgctxt "2022:765"
msgid "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Ay, qué aprieto, que tengo que pensarlo bien al no estar<br>en casica... <wait(1.0)><$comeff(1,21)><$motion(1,801)><$voicel(1,10)>La verdad, ¡es <$cdef(27)><$stflevel;0(4)></color>, majet<gen;-2(e,a)>!"
msgstr "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Ay, qué aprieto, que tengo que pensarlo bien al no estar<br>en casita... <wait(1.0)><$comeff(1,21)><$motion(1,801)><$voicel(1,10)>La verdad, ¡es <$cdef(27)><$stflevel;0(4)></color>, jef<gen;-2(e,a)>!"

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>My comfort level? Hmmm... I would know for sure if I was<br>at hooome, but...<clear><br><$comeff(1,8)><$motion(1,801)><$voicel(1,9)>It’s <$cdef(27)><flow><$stflevel;0(5)></color>, I bet. I really, reeeaaally like my home. ♪
msgctxt "2022:766"
msgid "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Anda que preguntarme eso estando lejos de mi casica...<br>¡Ay, majet<gen;-2(e,a)>! <wait(1.0)><$comeff(1,8)><$motion(1,801)><$voicel(1,9)>No tengas miedo, ¡porque es <$cdef(27)><$stflevel;0(5)></color>!<slide><br>¡No hay que pensar mucho, que mi casica es inigualable!"
msgstr "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Mira que preguntarme eso estando lejos de mi casita...<br>¡Ay, jef<gen;-2(e,a)>! <wait(1.0)><$comeff(1,8)><$motion(1,801)><$voicel(1,9)>No tengas miedo, ¡porque es <$cdef(27)><$stflevel;0(5)></color>!<slide><br>¡No hay que pensar mucho, que mi casita es inigualable!"

#. en: <$comeff(1,9)><$motion(1,803)><$voicel(1,8)>I think it’s beeetter than it was before.
msgctxt "2022:767"
msgid "<$comeff(1,9)><$motion(1,803)><$voicel(1,8)>Te digo, además, que está mejor que antes."
msgstr ""

#. en: <$comeff(1,8)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>I think it’s wayyy better now. Thank you for everything<br>you do for me.
msgctxt "2022:768"
msgid "<$comeff(1,8)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡La cosa ha pegado un cambio para bien muy grande!<br>¡Gracias por afanarte tanto por mí, pillastre!"
msgstr "<$comeff(1,8)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡La cosa dio un cambio para bien muy grande!<br>¡Gracias por esforzarte tanto por mí, granujita!"

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>My hooome? It’s over this way. I can take you there...
msgctxt "2022:769"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>¿Que dónde tengo la casica? Pues vente, que te llevo en<br>un momento allí."
msgstr "<$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>¿Que dónde tengo la casita? Pues vente, que te llevo en<br>un momento allá."

#. en: <$comeff(1,3)><$motion(1,803)><$voicel(1,5)>My hooome? It’s over that way. I would looove to take you<br>there, <$comeff(1,4)><$facial(1,9)><$motion(1,802)><$voicel(1,4)>but I’m kind of busy right now... Sorry...
msgctxt "2022:770"
msgid "<$comeff(1,3)><$motion(1,803)><$voicel(1,5)>¿Que dónde tengo la casica? Pues tirando p'allá, maj<gen;-2(o,a)>...<br>Te acompañaría, <$comeff(1,4)><$facial(1,9)><$motion(1,802)><$voicel(1,4)>pero es que ahora estoy ocupad<gen;-3(o,a)>."
msgstr "<$comeff(1,3)><$motion(1,803)><$voicel(1,5)>¿Que dónde tengo la casita? Pues por allá, amig<gen;-2(o,a)>...<br>Te acompañaría, <$comeff(1,4)><$facial(1,9)><$motion(1,802)><$voicel(1,4)>pero es que ahora estoy ocupad<gen;-3(o,a)>."

#. en: <oneline><$comeff(1,8)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Thanks a buuunch for putting that<br><$cdef(27)><fqty(1)><class><stfrevp;0></color><slide><br>in<slide><br>my home.
msgctxt "2022:771"
msgid "<oneline><$comeff(1,8)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Gracias por dejarme<br><dart;0()><$cdef(27)><fqty(1)><class><stfrevp;0></color><slide><br>en la casica!"
msgstr "<oneline><$comeff(1,8)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Gracias por dejarme<br><dart;0()><$cdef(27)><fqty(1)><class><stfrevp;0></color><slide><br>en la casita!"

#. en: <oneline><$voicel(1,7)><$emotion(1,8)><fcap><iart;0()><$cdef(27)><fqty(1)><class><stfrevp;0></color>? Yayyy...<br>I bet<slide><br>it’s<slide><br>even<slide><br>nicer<slide><br>outside<slide><br>now.<slide><br>Thaaank you.
msgctxt "2022:772"
msgid "<oneline><$voicel(1,7)><$emotion(1,8)>¡<fcap><iart;0()><fqty(1)><class><$cdef(27)><stfrevp;0></color>,<br>qué alegría!<slide><br>La parte de fuera<slide><br>quedará más bonica,<slide><br>graaacias."
msgstr "<oneline><$voicel(1,7)><$emotion(1,8)>¡<fcap><iart;0()><fqty(1)><class><$cdef(27)><stfrevp;0></color>,<br>qué alegría!<slide><br>La parte de afuera<slide><br>quedará más bonita,<slide><br>graaacias."

#. en: <$comeff(1,6)><$motion(1,666)><$voicel(1,5)>My comfort level? Hmmm. I need more time to relaaax<br>and figure that out... <$comeff(1,3)><$motion(1,803)><$voicel(1,8)>Ask me again in a little while...
msgctxt "2022:773"
msgid "<$motion(1,666)><$voicel(1,5)>A ver, maj<gen;-2(o,a)>, que me acabo de mudar a mi casica, déjame<br>que me acostumbre, <$comeff(1,6)>¿no? Ja, ja, ja.<clear><br><$comeff(1,3)><$motion(1,803)><$voicel(1,8)>Ya tendrás tiempo de preguntarme."
msgstr "<$motion(1,666)><$voicel(1,5)>A ver, amig<gen;-2(o,a)>, que me acabo de mudar a mi casita, déjame<br>que me acostumbre, <$comeff(1,6)>¿no? Ja, ja, ja.<clear><br><$comeff(1,3)><$motion(1,803)><$voicel(1,8)>Ya tendrás tiempo de preguntarme."

#. en: <oneline><$comeff(1,3)><$facial(1,4)><$motion(1,806)><$voicel(1,8)>Thaaanks, <$cdef(27)><pname;0></color>.<clear><br><$comeff(1,14)><$facial(1,9)><$motion(1,805)><$voicel(1,3)>But I actually don’t really liiike stuff like that<br><$cdef(27)><fqty(1)><class><stfrevp;2></color>...<clear><br><$emotion(1,29)><$voicel(1,6)>Is there anything else I could haaave?
msgctxt "2022:774"
msgid "<$comeff(1,3)><$facial(1,4)><$motion(1,806)><$voicel(1,8)>¡Qué majet<gen;-2(e,a)> eres, <$cdef(27)><pname;0></color>! ¡Graciaaas!<clear><br><$comeff(1,14)><$facial(1,9)><$motion(1,805)><$voicel(1,3)>Ay, espero que no te lo tomes a mal, pero no es que me<br>chifl<qty;2(e,en)> <dart;2()><$cdef(27)><fqty(2)><class><stfrevp;2></color>...<clear><br><$emotion(1,29)><$voicel(1,6)>¿No tendrás alguna otra cosica por ahí?"
msgstr "<$comeff(1,3)><$facial(1,4)><$motion(1,806)><$voicel(1,8)>¡Qué amable eres, <$cdef(27)><pname;0></color>! ¡Graciaaas, jef<gen;-2(e,a)>!<clear><br><$comeff(1,14)><$facial(1,9)><$motion(1,805)><$voicel(1,3)>Ay, espero que no te lo tomes a mal, pero no es que me<br>encant<qty;2(e,en)> <dart;2()><$cdef(27)><fqty(2)><class><stfrevp;2></color>...<clear><br><$emotion(1,29)><$voicel(1,6)>¿No tendrás alguna otra cosita por ahí?"

#. en: <oneline><$voicel(1,3)><$motion(1,805)><$comeff(1,7)>That <$cdef(27)><fqty(1)><class><stfrevp;0> </color>might<br>be<slide><br>a<slide><br>liiittle<slide><br>small<slide><br>for me...<clear><br><$voicel(1,6)><$motion(1,803)><$comeff(1,10)>Something sliiightly bigger would probably be better...
msgctxt "2022:775"
msgid "<$voicel(1,3)><$motion(1,805)><$comeff(1,7)>Hmm, me da a mí que <qty;0(es,son)> algo pequeñic<genqty;0(o,a,os,as)> para mí<br><dart;0()><fqty(1)><$cdef(27)><class><stfrevp;0></color>.<clear><br><$voicel(1,6)><$motion(1,803)><$comeff(1,10)>¡Anda que no estaría bien si hubiera otra cosa parecida<br>más grande!"
msgstr "<$voicel(1,3)><$motion(1,805)><$comeff(1,7)>Hmm, me parece a mí que <qty;0(es,son)> algo pequeñit<genqty;0(o,a,os,as)> para mí<br><dart;0()><fqty(1)><$cdef(27)><class><stfrevp;0></color>.<clear><br><$voicel(1,6)><$motion(1,803)><$comeff(1,10)>¡Qué bien estaría si hubiera otra cosa parecida<br>más grande!"

#. en: <$comeff(1,3)><$motion(1,661)><$voicel(1,7)>You’re always picking up all sooorts of things off the<br>ground, aren’t you, <$cdef(27)><pname;0></color>?<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,4)>I like collecting things too, you know... But I always<br>forget I’ve picked things up for my collections...
msgctxt "2022:801"
msgid "<$comeff(1,3)><$motion(1,661)><$voicel(1,7)>No hago más que verte recogiendo las cosas que hay por<br>ahí ciscadas, <$cdef(27)><pname;0></color>.<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,4)>A mí también me fascina acumular trastos, lo que pasa es<br>que, según los guardo, me olvido de que los tengo..."
msgstr "<$comeff(1,3)><$motion(1,661)><$voicel(1,7)>No hago más que verte recogiendo las cosas que hay por<br>ahí tiradas, <$cdef(27)><pname;0></color>.<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,4)>A mí también me fascina acumular trastos, lo que pasa es<br>que, en cuanto los guardo, me olvido de que los tengo..."

#. en: <oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>I’ve been seeing you sooo often lately,<br><$cdef(27)><pname;0></color>.<clear><br><$voicel(1,9)><$motion(1,801)><$facial(1,5)><$comeff(1,21)>I love seeing yooouuu around. You’re always so full<br>of energy!
msgctxt "2022:802"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Te veo mucho por aquí últimamente.<clear><br><$voicel(1,9)><$motion(1,801)><$facial(1,5)><$comeff(1,21)>Si te digo la verdad, verte siempre tan lozan<gen;-2(o,a)> me llena<br>de alegría."
msgstr ""

#. en: <oneline><$voicel(1,9)><$emotion(1,8)>The <$cdef(27)><asnbname;0> </color>is<br>reeeaaally<slide><br>nice<slide><br>now<slide><br>that<slide><br>it’s<slide><br>finished, huh?<clear><br><$voicel(1,7)><$motion(1,803)><$comeff(1,21)>We built it bit by bit... And I felt so accomplished when it<br>was fiiinally done.
msgctxt "2022:803"
msgid "<oneline><$voicel(1,9)><$emotion(1,8)>¿No te parece que<br><dart;0()><$cdef(27)><asnbname;0></color><$cdef(27)></color><slide><br>h<qty;0(a,an)> quedado estupend<genqty;0(o,a,os,as)>?<clear><br><$voicel(1,7)><$motion(1,803)><$comeff(1,21)>Construir algo así poco a poco y por fin verlo terminado<br>da mucha satisfacción."
msgstr ""

#. en: <oneline><$comeff(1,3)><$motion(1,803)><$voicel(1,7)>Whoa... That <$cdef(27)><rctbname;0></color><br>just<slide><br>kind<slide><br>of<slide><br>popped<slide><br>up<slide><br>out<slide><br>of nooowhere...<clear><br><$comeff(1,14)><$facial(1,2)><$motion(1,666)><$voicel(1,5)>I guess the scenery around here is really going to<br>change, huh?<clear><br><$comcan(1)><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>I should take a gooood look around to be sure I don’t<br>forget what it used to look like here...
msgctxt "2022:804"
msgid "<$comeff(1,3)><$motion(1,803)><$voicel(1,7)>¡Cuando quise darme cuenta, ya habían terminado de<br>construir <dart;0()><$cdef(27)><rctbname;0></color>!<clear><br><$comeff(1,14)><$facial(1,2)><$motion(1,666)><$voicel(1,5)>¡Este vecindario está cambiando a un ritmo de aúpa!<br>¿No te lo parece?<clear><br><$comcan(1)><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Voy a darme un paseíco por la zona, p'acordarme bien<br>de cómo está ahora..."
msgstr "<$comeff(1,3)><$motion(1,803)><$voicel(1,7)>¡Cuando quise darme cuenta, ya habían terminado de<br>construir <dart;0()><$cdef(27)><rctbname;0></color>!<clear><br><$comeff(1,14)><$facial(1,2)><$motion(1,666)><$voicel(1,5)>¡Este vecindario está cambiando a un ritmo increíble!<br>¿No te lo parece?<clear><br><$comcan(1)><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Voy a darme un paseíto por la zona, pa acordarme bien<br>de cómo está ahora..."

#. en: <oneline><$voicel(1,7)><$motion(1,805)><$comeff(1,6)>Do you remeeember <$cdef(27)><acqpname;0></color>? We<br>played<slide><br>together<slide><br>a<slide><br>while baaack...<clear><br><$voicel(1,9)><$emotion(1,8)>That was so much fun! I hope we can do it agaaaiiin.
msgctxt "2022:805"
msgid "<oneline><$voicel(1,7)><$motion(1,805)><$comeff(1,6)>¿Te acuerdas de <$cdef(27)><acqpname;0></color>? Le hicimos<br>una visita<slide><br>hace no mucho...<clear><br><$voicel(1,9)><$emotion(1,8)>Jo, qué bien me lo pasé... Ojalá podamos repetir pronto."
msgstr "<oneline><$voicel(1,7)><$motion(1,805)><$comeff(1,6)>¿Te acuerdas de <$cdef(27)><acqpname;0></color>? Le hicimos<br>una visita<slide><br>hace no mucho...<clear><br><$voicel(1,9)><$emotion(1,8)>Ay, qué bien me la pasé... Ojalá podamos repetir pronto."

#. en: <$voicel(1,7)><$motion(1,803)><$comeff(1,10)><$facial(1,4)>Hehe... It’s always so much fun to see your ever-changing<br>seeelf, <$cdef(27)><pname;0></color>...<clear><br><$voicel(1,9)><$emotion(1,8)>Your previous transformation was pretty cool, but this<br>one’s neat toooo!
msgctxt "2022:806"
msgid "<$voicel(1,7)><$motion(1,803)><$comeff(1,10)><$facial(1,4)>Ja, ja, me entretiene mucho ver cómo cambias de aspecto<br>de vez en cuando.<clear><br><$voicel(1,9)><$emotion(1,8)>Estabas muy bien antes, pero esto también te queda<br>estupendamente."
msgstr ""

#. en: <oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,6)>Hmmm? You’ve changed something small about your<br>appearance, haven’t you?<clear><br><$voicel(1,7)><$emotion(1,8)>You have a reeeaaally cool sense of style,<br><$cdef(27)><pname;0></color>.
msgctxt "2022:807"
msgid "<$voicel(1,5)><$motion(1,805)><$comeff(1,6)>¿Te has cambiado un poco el atuendo? Diría yo que sí...<br><$voicel(1,7)><$emotion(1,8)>Pues te queda muy bien, maj<gen;-2(o,a)>."
msgstr "<$voicel(1,5)><$motion(1,805)><$comeff(1,6)>¿Te cambiaste un poco el atuendo? Diría yo que sí...<br><$voicel(1,7)><$emotion(1,8)>Pues te queda muy bien, amig<gen;-2(o,a)>."

#. en: <$voicel(1,5)><$motion(1,805)><$comeff(1,14)>I wonder what things would be like if I had never met<br>you, <$cdef(27)><pname;0></color>...<clear><br><$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>Thinking about it made me kinda sad... Heyyy, let’s hang<br>out a little bit longer today, OK?
msgctxt "2022:808"
msgid "<$voicel(1,5)><$motion(1,805)><$comeff(1,14)>¿Qué habría sido de mí si no te hubiese conocido?<clear><br><$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>Ay, me pongo trist<gen;-3(ón,ona)> solo de pensarlo... ¿Te quedas<br>conmigo un ratico más?"
msgstr "<$voicel(1,5)><$motion(1,805)><$comeff(1,14)>¿Qué habría sido de mí si no te hubiera conocido?<clear><br><$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>Ay, me pongo trist<gen;-3(ón,ona)> solo de pensarlo... ¿Te quedas<br>conmigo un ratito más?"

#. en: <$voicel(1,3)><$motion(1,805)><$comeff(1,14)>What are dreeeaaams? Why do we haaave them?<clear><br><$voicel(1,5)><$emotion(1,14)>And why was my last dream about a huge group of<br><$voicel(1,4)><$motion(1,807)><$comeff(1,6)><$cdef(27)>Professor Tangrowth </color>clones? So weeeiiird...
msgctxt "2022:809"
msgid "<$voicel(1,3)><$motion(1,805)><$comeff(1,14)>¿Por qué soñamos cuando dormimos? Siempre me lo he<br>preguntado...<clear><br><$voicel(1,5)><$emotion(1,14)>Anoche soñé que iba y me encontraba con un porrón<br>de clones del <$cdef(27)>Profesor Tangrowth</color>...<clear><br><$voicel(1,4)><$motion(1,807)><$comeff(1,6)>A ver ahora quién me sabe explicar eso a mí, ¿eh?"
msgstr "<$voicel(1,3)><$motion(1,805)><$comeff(1,14)>¿Por qué soñamos cuando dormimos? Siempre me lo he<br>preguntado...<clear><br><$voicel(1,5)><$emotion(1,14)>Anoche soñé que iba y me encontraba con un montón<br>de clones del <$cdef(27)>Profesor Tangrowth</color>...<clear><br><$voicel(1,4)><$motion(1,807)><$comeff(1,6)>A ver ahora quién me sabe explicar eso a mí, ¿eh?"

#. en: <oneline><$comeff(1,1)><$motion(1,803)><$voicel(1,7)>We leave from the same house to go out exploring and<br>come back to the same house when we’re done...<clear><br><$comeff(1,8)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>That’s so cooool, <$cdef(27)><pname;0></color>. I hope we<br>can<slide><br>always<slide><br>live<slide><br>like this...
msgctxt "2022:810"
msgid "<$comeff(1,1)><$motion(1,803)><$voicel(1,7)>Día tras día, tú y yo salimos y volvemos a la misma casica.<br><$comeff(1,8)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Da gusto vivir así... ¡Ojalá sigamos igual muuucho tiempo!"
msgstr "<$comeff(1,1)><$motion(1,803)><$voicel(1,7)>Día tras día, tú y yo salimos y volvemos a la misma casita.<br><$comeff(1,8)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Da gusto vivir así... ¡Ojalá sigamos igual muuucho tiempo!"

#. en: <$comeff(1,10)><$facial(1,2)><$motion(1,661)><$voicel(1,7)>Everyone thinks I’m so different from what they<br>imagined once <$comeff(1,3)><$motion(1,803)><$voicel(1,8)>they really get to know me...<clear><br><$comeff(1,14)><$facial(1,14)><$motion(1,666)><$voicel(1,5)>Maybe I should just change my personality to be<br>scaaary, like my face. Hehehe...<clear><br><$comeff(1,7)><$facial(1,2)><$motion(1,803)><$voicel(1,4)>Hmmm... That does seem kind of difficult, though...
msgctxt "2022:814"
msgid "<$comeff(1,10)><$facial(1,2)><$motion(1,661)><$voicel(1,7)>Los demás Pokémon me dicen siempre que soy distint<gen;-3(o,a)> a<br>como pensaban que sería <$comeff(1,3)><$motion(1,803)><$voicel(1,8)>antes de conocerme mejor...<clear><br><$comeff(1,14)><$facial(1,14)><$motion(1,666)><$voicel(1,5)>¿Cómo puedo hacer pa que se me vea en la cara que soy<br>majet<gen;-3(e,a)>?... <$comeff(1,7)><$facial(1,2)><$motion(1,803)><$voicel(1,4)>Na, igual no hay na que hacer."
msgstr "<$comeff(1,10)><$facial(1,2)><$motion(1,661)><$voicel(1,7)>Los demás Pokémon me dicen siempre que soy distint<gen;-3(o,a)> a<br>como pensaban que sería <$comeff(1,3)><$motion(1,803)><$voicel(1,8)>antes de conocerme mejor...<clear><br><$comeff(1,14)><$facial(1,14)><$motion(1,666)><$voicel(1,5)>¿Cómo puedo hacer pa que se me vea en la cara que soy<br>majet<gen;-3(e,a)>?... <$comeff(1,7)><$facial(1,2)><$motion(1,803)><$voicel(1,4)>Nah, tal vez no hay nada que hacer."

#. en: <oneline><$comeff(1,3)><$facial(1,2)><$motion(1,803)><$voicel(1,8)><$cdef(27)><$tonepk;0(3)> </color>may be young, but they’re<br>reeeaaally smart.<clear><br><$comeff(1,10)><$motion(1,805)><$voicel(1,7)>I didn’t know half as much stuff when I was little... <$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>I think<br>they’re really amazing, you knooow?
msgctxt "2022:820"
msgid "<$comeff(1,3)><$facial(1,2)><$motion(1,803)><$voicel(1,8)><fcap><dart;0()><$cdef(27)><$tonepk;0(3)></color> es muy inteligente, ¿eh?<br><$comeff(1,10)><$motion(1,805)><$voicel(1,7)>¡Cuando yo era chic<gen;-3(o,a)>, no sabía ni la mitad de cosas!<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>Tiene mucho mérito que se esfuerce tanto por aprender."
msgstr ""

#. en: <$comeff(1,10)><$motion(1,803)><$voicel(1,7)><$cdef(27)><$tonepk;0(9)> </color>is sooo full of energy...<clear><br>We hang out together a lot, <$comeff(1,4)><$facial(1,9)><$motion(1,806)><$voicel(1,6)>and I’m always the first one<br>to get tiiired.<clear><br><$comeff(1,6)><$facial(1,4)><$motion(1,666)><$voicel(1,7)>Where do you think all their energy comes from?
msgctxt "2022:826"
msgid "<oneline><$comeff(1,10)><$motion(1,803)><$voicel(1,7)><fcap><dart;0()><$cdef(27)><$tonepk;0(9)></color> no se cansa nunca, ¿eh?<clear><br>¡Menudo peligro tiene! Cuando jugamos, no para, <$comeff(1,4)><$facial(1,9)><$motion(1,806)><$voicel(1,6)>y soy yo<br><gen;-3(el,la)> que acaba rot<gen;-3(o,a)>... <$comeff(1,6)><$facial(1,4)><$motion(1,666)><$voicel(1,7)>¿De dónde sacará tanta energía?"
msgstr "<oneline><$comeff(1,10)><$motion(1,803)><$voicel(1,7)><fcap><dart;0()><$cdef(27)><$tonepk;0(9)></color> no se cansa nunca, ¿eh?<clear><br>¡Es todo un peligro! Cuando jugamos, no para, <$comeff(1,4)><$facial(1,9)><$motion(1,806)><$voicel(1,6)>y soy yo<br><gen;-3(el,la)> que acaba agotad<gen;-3(o,a)>... <$comeff(1,6)><$facial(1,4)><$motion(1,666)><$voicel(1,7)>¿De dónde sacará tanta energía?"

#. en: <$emotion(1,8)><$voicel(1,7)>They say my smell is really strooong but really gooood.<clear><br><$emotion(1,55)><$voicel(1,3)>Think I could meet up with other Pokémon who have<br><$comeff(1,21)><$facial(1,4)><$voicel(1,8)>strong smells and make an even beeetter smell?<clear><br><$comeff(1,10)><$motion(1,805)><$facial(1,1)><$voicel(1,6)>I’m really cuuurious...
msgctxt "2022:837"
msgid "<$emotion(1,8)><$voicel(1,7)>Todos me dicen que mi aroma es la mar de intenso,<br>pero placentero al mismo tiempo.<clear><br><$emotion(1,55)><$voicel(1,3)>¿Qué pasaría si me juntase con otro Pokémon que oliese<br>igual de potente o más? ¿Se mezclarían nuestros olores?<clear><br><$comeff(1,21)><$facial(1,4)><$voicel(1,8)>¿Descubriríamos quizá el mejor aroma habido y por<br>haber?... <wait(1.0)><$comeff(1,10)><$motion(1,805)><$facial(1,1)><$voicel(1,6)>¡Ahora necesito comprobarlo!"
msgstr "<$emotion(1,8)><$voicel(1,7)>Todos me dicen que mi aroma es de lo más intenso,<br>pero placentero al mismo tiempo.<clear><br><$emotion(1,55)><$voicel(1,3)>¿Qué pasaría si me juntara con otro Pokémon que oliera<br>igual de potente o más? ¿Se mezclarían nuestros olores?<clear><br><$comeff(1,21)><$facial(1,4)><$voicel(1,8)>¿Descubriríamos quizás el mejor aroma habido y por<br>haber?... <wait(1.0)><$comeff(1,10)><$motion(1,805)><$facial(1,1)><$voicel(1,6)>¡Ahora necesito comprobarlo!"

#. en: <$voicel(1,5)><$comeff(1,3)><$motion(1,805)><$cdef(27)><gevcmainpk;0></color>’s been reeeaaally excited about something<br>recently. <$voicel(1,7)><$emotion(1,49)>They said there’s something they want to do<slide><br>with you, <$cdef(27)><pname;1></color>...
msgctxt "2022:851"
msgid "<oneline><$voicel(1,5)><$comeff(1,3)><$motion(1,805)>Últimamente <dart;0()><$cdef(27)><gevcmainpk;0> </color>tiene un entusiasmo encima<br>que<slide><br>pa qué.<slide><br><$voicel(1,7)><$emotion(1,49)>Es más, por lo visto, quiere proponerte algo."
msgstr "<oneline><$voicel(1,5)><$comeff(1,3)><$motion(1,805)>Últimamente <dart;0()><$cdef(27)><gevcmainpk;0> </color>tiene un entusiasmo encima<br>que<slide><br>da gusto.<slide><br><$voicel(1,7)><$emotion(1,49)>Es más, por lo visto, quiere proponerte algo."

#. en: <$emotion(1,38)><$voicel(1,10)>Hehe...<clear><br><$emotion(1,29)><$voicel(1,7)>It sure is haaard to imitate the way other Pokémon talk...<br>Could you tell who I was imitating?
msgctxt "2022:853"
msgid "...<clear><br><$emotion(1,38)><$voicel(1,10)>Bueeeno, sanseacabó la gracia.<clear><br><$emotion(1,29)><$voicel(1,7)>Madre, qué cansao es imitar a alguien tan diferente.<br>Dime, maj<gen;-2(o,a)>: ¿sabes a quién copiaba?"
msgstr "...<clear><br><$emotion(1,38)><$voicel(1,10)>Bueeeno, se acabó la gracia.<clear><br><$emotion(1,29)><$voicel(1,7)>Cielos, qué cansado es imitar a alguien tan diferente.<br>Dime, amig<gen;-2(o,a)>: ¿sabes a quién copiaba?"

#. en: <oneline><$comeff(1,20)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>That’s riiight. You sure are amazing,<br><$cdef(27)><pname;0></color>...
msgctxt "2022:854"
msgid "<$comeff(1,20)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Ni más ni menos! Hay que ver, qué espabil<gen;-2(ao,á)> eres."
msgstr "<$comeff(1,20)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Ni más ni menos! Vaya, qué despabil<gen;-2(ao,á)> eres."

#. en: <$emotion(1,1)><$voicel(1,9)>Nooo... I was imitating <$cdef(27)><apfquizpk;0(0)></color>...<clear><br><$emotion(1,60)><$voicel(1,8)>It sure is hard to copy the way other Pokémon talk... I like<br>listening to them, though.
msgctxt "2022:855"
msgid "<oneline><$emotion(1,1)><$voicel(1,9)>Ja, ja, ja. No, <gen;-2(hombre,mujer)>, no... Estaba imitando<br><esa;0()><$cdef(27)><apfquizpk;0(0)></color>.<clear><br><$emotion(1,60)><$voicel(1,8)>Mira que disfruto fijándome en cómo hablan los demás,<br>pero imitarlos tiene su miga."
msgstr "<oneline><$emotion(1,1)><$voicel(1,9)>Ja, ja, ja. No, <gen;-2(hombre,mujer)>, no... Estaba imitando<br><esa;0()><$cdef(27)><apfquizpk;0(0)></color>.<clear><br><$emotion(1,60)><$voicel(1,8)>Mira que disfruto fijándome en cómo hablan los demás,<br>pero imitarlos tiene lo suyo."

#. en: <$emotion(1,14)><$voicel(1,3)>I seeee... You want me to hold on to that<$voicel(1,6)><$facial(1,4)><$comeff(1,10)> <$cdef(27)><fqty(1)><$ifull(432)> </color>for<br>you? Sure thiiing.
msgctxt "2022:859"
msgid "<$emotion(1,14)><$voicel(1,3)>Ah, ¿estás segur<gen;-2(o,a)>? Buenooo...<clear><br><$voicel(1,6)><$facial(1,4)><$comeff(1,10)>Yo te guardo ese <$cdef(27)><fqty(1)><$ifull(432)></color> sin problema,<br>granujilla."
msgstr "<$emotion(1,14)><$voicel(1,3)>Ah, ¿estás segur<gen;-2(o,a)>? Buenooo...<clear><br><$voicel(1,6)><$facial(1,4)><$comeff(1,10)>Yo te guardo ese <$cdef(27)><fqty(1)><$ifull(432)></color> sin problema,<br>granujita."

#. en: <$voicel(1,9)><$facial(1,4)><$comeff(1,8)><$motion(1,801)>Woooooow, it’s so pretty... I bet you want to stare at it too,<br>huh, <$cdef(27)><pname;0></color>? <$emotion(1,37)><$voicel(1,6)>You can have it baaack...
msgctxt "2022:860"
msgid "<$voicel(1,9)><$facial(1,4)><$comeff(1,8)><$motion(1,801)>Hala, qué cosa más bonica... Seguro que tú también<br>quieres verlo de cerca, <$cdef(27)><pname;0></color>.<clear><br><$emotion(1,37)><$voicel(1,6)>Toma, aquí lo tienes."
msgstr "<$voicel(1,9)><$facial(1,4)><$comeff(1,8)><$motion(1,801)>Guau, qué cosa más bonita... Seguro que tú también<br>quieres verlo de cerca, <$cdef(27)><pname;0></color>.<clear><br><$emotion(1,37)><$voicel(1,6)>Toma, aquí lo tienes."

#. en: <$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>Whoooaaa... I’m so surprised. You’re pretty good at<br>transforming into stuff, huh, <$cdef(27)><pname;0></color>?<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,8)>Heeere, have some <$cdef(27)><fqty(1)><$ifull(532)></color>.
msgctxt "2022:862"
msgid "<$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>¡Aaah! <wait(1.0)>Madre, qué susto me he llevado... <wait(1.0)>Así que eras tú,<br>que te habías transformado, so <gen;-2(bribón,bribona)>.<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,8)>Anda, que te aproveche esta <$cdef(27)><fqty(1)><$ifull(532)></color>."
msgstr "<$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>¡Aaah! <wait(1.0)>Cielos, qué susto me llevé... <wait(1.0)>Así que eras tú,<br>que te habías transformado, <gen;-2(bribón,bribona)>.<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,8)>Toma, que te aproveche esta <$cdef(27)><fqty(1)><$ifull(532)></color>."

#. en: <$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>Whoooaaa... I’m so surprised. You’re pretty good at<br>transforming into stuff, huh, <$cdef(27)><pname;0></color>?<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,8)>Heeere, have some <$cdef(27)><fqty(1)><$ifull(532)></color>.
msgctxt "2022:863"
msgid "<$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>¡Aaah! <wait(1.0)>Madre, qué susto me he llevado... <wait(1.0)>Así que eras tú,<br>que te habías transformado, so <gen;-2(bribón,bribona)>.<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,8)>Anda, que te aprovechen estas <$cdef(27)><fqty(2)><$ifull(532)></color>."
msgstr "<$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>¡Aaah! <wait(1.0)>Cielos, qué susto me llevé... <wait(1.0)>Así que eras tú,<br>que te habías transformado, <gen;-2(bribón,bribona)>.<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,8)>Toma, que te aprovechen estas <$cdef(27)><fqty(2)><$ifull(532)></color>."

#. en: <$voicel(1,8)><$emotion(1,8)>Yayyy, thanks for the invite.<clear><br><$voicel(1,5)><$motion(1,805)><$comeff(1,14)><$facial(1,1)>But it seems there are looots of other Pokémon who<br>would like to go too...<clear><br><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Maybe invite me again once things calm down a<br>little bit...
msgctxt "2022:902"
msgid "<$voicel(1,8)><$emotion(1,8)>Se agradece la invitación, majet<gen;-2(e,a)>...<wait(0.4)> <$voicel(1,5)><$motion(1,805)><$comeff(1,14)><$facial(1,1)>pero creo que tienes<br>a muchos otros Pokémon haciendo cola.<clear><br><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¿Qué tal si esperas a que la cosa se calme un poco?"
msgstr "<$voicel(1,8)><$emotion(1,8)>Se agradece la invitación, jef<gen;-2(e,a)>...<wait(0.4)> <$voicel(1,5)><$motion(1,805)><$comeff(1,14)><$facial(1,1)>pero creo que tienes<br>a muchos otros Pokémon haciendo fila.<clear><br><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¿Qué tal si esperas a que la cosa se calme un poco?"

#. en: <oneline><$voicel(1,5)><$emotion(1,14)>That was a lot of fun, <$cdef(27)><pname;0></color>, but I<br>think<slide><br>it’s<slide><br>about<slide><br>time<slide><br>for<slide><br>me<slide><br>to<slide><br>head hooome...<clear><br><$voicel(1,8)><$emotion(1,8)>Let’s hang out together again sometime, OK?
msgctxt "2022:903"
msgid "<oneline><$voicel(1,5)><$emotion(1,14)>Me lo he pasado en grande, <$cdef(27)><pname;0></color>,<br>pero ya es hora<slide><br>de ir volviendo a casica.<clear><br><$voicel(1,8)><$emotion(1,8)>Cuando quieras, repetimos."
msgstr "<oneline><$voicel(1,5)><$emotion(1,14)>Me la pasé en grande, <$cdef(27)><pname;0></color>,<br>pero ya es hora<slide><br>de ir volviendo a casita.<clear><br><$voicel(1,8)><$emotion(1,8)>Cuando quieras, repetimos."

#. en: <$voicel(1,6)><$emotion(1,14)>Whoooaaa, yeah? You want me to visit?<clear><br><$voicel(1,7)><$emotion(1,39)>Cooool. I’ll go over to play sometime soon, then...
msgctxt "2022:904"
msgid "<$voicel(1,6)><$emotion(1,14)>¡Hala! ¿En serio me invitas? ¿De verdad de la buena?<br><$voicel(1,7)><$emotion(1,39)>Pues, en cuanto pueda, p'allá que voy."
msgstr "<$voicel(1,6)><$emotion(1,14)>¡Guau! ¿En serio me invitas? ¿De verdad de la buena?<br><$voicel(1,7)><$emotion(1,39)>Pues, en cuanto pueda, voy para allá."

#. en: <$comeff(1,3)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Oooh... Are you getting ready to go somewhere? I want<br>to go toooo...
msgctxt "2022:905"
msgid "<$comeff(1,3)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>¿Vas a alguna parte, brib<gen;-2(ón,ona)>? Pues ea, no se hable más.<br>¡Llévame contigo!"
msgstr "<$comeff(1,3)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>¿Vas a alguna parte, brib<gen;-2(ón,ona)>? Pues no se hable más.<br>¡Llévame contigo!"

#. en: <$comeff(1,9)><$motionoff(1,806)><$voicel(1,5)>OK... Got iiit. I’ll hold down the fort here...
msgctxt "2022:906"
msgid "<$comeff(1,9)><$motionoff(1,806)><$voicel(1,5)>Andaaa, qué chasco... Pues na, me quedo solic<gen;-3(o,a)> en casa."
msgstr "<$comeff(1,9)><$motionoff(1,806)><$voicel(1,5)>Ayyy, qué chasco... Pues nada, me quedo solit<gen;-3(o,a)> en casa."

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Thaaanks! That was so much fuuun. I hope we can go out<br>on an adventure again sometime...
msgctxt "2022:907"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Hoy me lo he pasado estupendamente, majet<gen;-2(e,a)>, gracias<br>por el paseíco. ¡Otro día repetimos!"
msgstr "<$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Hoy me la pasé estupendamente, jef<gen;-2(e,a)>, gracias<br>por el paseíto. ¡Otro día repetimos!"

#. en: <oneline><$voicel(1,6)><$facial(1,4)><$emotion(1,14)>Heyyy, <$cdef(27)><pname;0></color>. Here I am...<clear><br><$voicel(1,3)><$comeff(1,6)><$motion(1,805)><$facial(1,1)>Um... Do you remember me? I’m<br><$cdef(27)><nowner;2></color>’s friend...<clear><br><$voicel(1,7)><$comeff(1,21)><$motion(1,806)><$facial(1,4)>This place is really relaxing... It’s nice in a way that’s <$voicel(1,10)><$emotion(1,8)>kinda<br>diiifferent than where I live.
msgctxt "2022:921"
msgid "<oneline><$voicel(1,6)><$facial(1,4)><$emotion(1,14)>Hooolaaa, <$cdef(27)><pname;0></color>.<clear><br><$voicel(1,3)><$comeff(1,6)><$motion(1,805)><$facial(1,1)>¿Te acuerdas de mí? Soy amig<gen;-3(o,a)> de tu amig<gen;2(o,a)><br><$cdef(27)><nowner;2></color>.<clear><br><$voicel(1,7)><$comeff(1,21)><$motion(1,806)><$facial(1,4)>Ay, qué tranquilidad se respira aquí. Es todo muy distinto<br>a donde yo vivo, <$voicel(1,10)><$emotion(1,8)>lo que le da un encanto propio..."
msgstr ""
