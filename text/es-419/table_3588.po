#. en: <$voicel(2,7)><$emotion(2,8)>That Pokémon loves big pieces of coral and cute<br>flower beds!
msgctxt "3588:0"
msgid "<$voicel(2,7)><$emotion(2,8)>A ese Pokémon le encaaantan los corales grandes,<br>¡y también las flores bonitaaas! Cuantas más, mejor."
msgstr ""

#. en: <$voicel(2,10)>Maybe you should try looking around there!
msgctxt "3588:1"
msgid "<$voicel(2,10)>Quizá sería buena idea que buscaras por allí."
msgstr "<$voicel(2,10)>Quizás sería buena idea que buscaras por allá."

#. en: <$voicel(2,10)><$facial(2,5)><$motion(2,661)><$comeff(2,21)>Oooh, you met <$cdef(27)><$cname(577)></color>? YAY! If they need anything,<br>make sure to help ’em out!
msgctxt "3588:7"
msgid "<$voicel(2,10)><$facial(2,5)><$motion(2,661)><$comeff(2,21)>¡Oooh! ¡Qué chachi que hayas encontrado a <$cdef(27)><$cname(577)></color>!<br>Si por lo que sea necesita ayuda, échale una mano, ¿vale?"
msgstr "<$voicel(2,10)><$facial(2,5)><$motion(2,661)><$comeff(2,21)>¡Oooh! ¡Qué genial que hayas encontrado a <$cdef(27)><$cname(577)></color>!<br>Si por lo que sea necesita ayuda, échale una mano, ¿sí?"
