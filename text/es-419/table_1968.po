#. en: <$voicel(1,8)><$emotion(1,14)>Whoa, hey! Nice to meetcha!<clear><br><$voicel(1,5)><$emotion(1,38)>You seem pretty rad. Let’s be pals!
msgctxt "1968:3"
msgid "<$voicel(1,8)><$emotion(1,14)>¡Buenas! ¿Qué pasa?<clear><br><$voicel(1,5)><$emotion(1,38)>Tienes pinta de ser buena gente, así que creo que nos<br>llevaremos fenómeno."
msgstr "<$voicel(1,8)><$emotion(1,14)>¡Buenas! ¿Qué tal?<clear><br><$voicel(1,5)><$emotion(1,38)>Pareces buena gente, así que creo que nos<br>llevaremos de maravilla."

#. en: <oneline><$voicel(1,5)><$comeff(1,6)><$motion(1,666)>Huh? Who are you? You know <$cdef(27)><nowner;1></color>?<clear><br><$voicel(1,7)><$emotion(1,49)>I’m pretty good pals with them, so <$voicel(1,6)><$comeff(1,9)>you and me should be<br>pals too!
msgctxt "1968:4"
msgid "<oneline><$voicel(1,5)><$comeff(1,6)><$motion(1,666)>Oye, es la primera vez que te veo por aquí...<wait(0.5)><br>Ah, ¿que conoces a <$cdef(27)><nowner;1></color>?<clear><br><$voicel(1,7)><$emotion(1,49)>Pues si eres colega de <$cdef(27)><nowner;3></color>, seguro<br>que nos<slide><br>llevamos fetén. <$voicel(1,6)><$comeff(1,9)>¡Encantad<gen;-3(o,a)> y tal!"
msgstr "<oneline><$voicel(1,5)><$comeff(1,6)><$motion(1,666)>Oye, es la primera vez que te veo por aquí...<wait(0.5)><br>Ah, ¿que conoces a <$cdef(27)><nowner;1></color>?<clear><br><$voicel(1,7)><$emotion(1,49)>Pues si eres compa de <$cdef(27)><nowner;3></color>, seguro<br>que nos<slide><br>llevamos genial. <$voicel(1,6)><$comeff(1,9)>¡Encantad<gen;-3(o,a)> de conocerte!"

#. en: <oneline><$voicel(1,5)><$comeff(1,6)><$motion(1,666)>Huh? Who are you? You know <$cdef(27)><acqpname;1></color>?<clear><br><$voicel(1,7)><$emotion(1,49)>I’m pretty good pals with them, so <$voicel(1,6)><$comeff(1,9)>you and me should be<br>pals too!
msgctxt "1968:5"
msgid "<oneline><$voicel(1,5)><$comeff(1,6)><$motion(1,666)>Oye, es la primera vez que te veo por aquí...<wait(0.5)><br>Ah, ¿que conoces a <$cdef(27)><acqpname;1></color>?<clear><br><$voicel(1,7)><$emotion(1,49)>Pues si eres colega de <$cdef(27)><acqpname;3></color>, seguro<br>que nos<slide><br>llevamos fetén. <$voicel(1,6)><$comeff(1,9)>¡Encantad<gen;-3(o,a)> y tal!"
msgstr "<oneline><$voicel(1,5)><$comeff(1,6)><$motion(1,666)>Oye, es la primera vez que te veo por aquí...<wait(0.5)><br>Ah, ¿que conoces a <$cdef(27)><acqpname;1></color>?<clear><br><$voicel(1,7)><$emotion(1,49)>Pues si eres compa de <$cdef(27)><acqpname;3></color>, seguro<br>que nos<slide><br>llevamos genial. <$voicel(1,6)><$comeff(1,9)>¡Encantad<gen;-3(o,a)> de conocerte!"

#. en: <$voicel(1,5)><$comeff(1,6)><$motion(1,666)>Huh? Who are you? You’re pals with my pal?<clear><br><$voicel(1,7)><$emotion(1,49)>Well then, I think <$voicel(1,6)><$comeff(1,9)>you and I should probably be pals too!
msgctxt "1968:6"
msgid "<$voicel(1,5)><$comeff(1,6)><$motion(1,666)>Oye, es la primera vez que te veo por estos lares...<wait(0.5)><br>Ah, ¿que conoces a alguien de aquí?<clear><br><$voicel(1,7)><$emotion(1,49)>Mira tú qué casualidad, ¡yo también! Seguro que nos<br>llevamos bien entonces. ¡Un placer, colega!"
msgstr "<$voicel(1,5)><$comeff(1,6)><$motion(1,666)>Oye, es la primera vez que te veo por estos lares...<wait(0.5)><br>Ah, ¿que conoces a alguien de aquí?<clear><br><$voicel(1,7)><$emotion(1,49)>Mira tú qué casualidad, ¡yo también! Seguro que nos<br>llevamos bien entonces. ¡Un placer, compa!"

#. en: <$voicel(1,7)><$comeff(1,8)><$motion(1,805)><$facial(1,5)>Whoa, hey, what smells so good? I followed my nose all<br>the way home to find out!
msgctxt "1968:8"
msgid "<$voicel(1,7)><$comeff(1,8)><$motion(1,805)><$facial(1,5)>Buah, ¿qué es ese olor tan rico? Huele tan bien que he<br>terminado aquí sin darme cuenta."
msgstr "<$voicel(1,7)><$comeff(1,8)><$motion(1,805)><$facial(1,5)>Guau, ¿qué es ese olor tan rico? Huele tan bien que<br>terminé aquí sin darme cuenta."

#. en: <oneline><$comeff(1,10)><$voicel(1,9)><$facial(1,4)><$motion(1,801)>Yo, <$cdef(27)><pname;0></color>! Long time, no see. Wanna<br>hang out?
msgctxt "1968:9"
msgid "<$cdef(27)><$comeff(1,10)></color><$voicel(1,9)><$facial(1,4)><$motion(1,801)>¡Buah, <gen;-2(chaval,chavala)>, si hace siglos que no te veía por aquí!<br>¿Damos una vuelta y nos ponemos al día?"
msgstr "<$cdef(27)><$comeff(1,10)></color><$voicel(1,9)><$facial(1,4)><$motion(1,801)>¡Vaya, <gen;-2(chaval,chavala)>, si hace siglos que no te veía por aquí!<br>¿Damos una vuelta y nos ponemos al día?"

#. en: <$voicel(1,6)><$comeff(1,6)><$motion(1,666)>Huh? Who are you?<clear><br><$voicel(1,7)><$emotion(1,14)>Out for a walk? I can’t blame ya—it’s pretty dang scenic<br>around here! <$voicel(1,5)><$comeff(1,10)><$motion(1,805)><$facial(1,4)>Maybe I’ll have a li’l look around too.
msgctxt "1968:10"
msgid "<$voicel(1,6)><$comeff(1,6)><$motion(1,666)>No me suena tu cara...<clear><br><$voicel(1,7)><$emotion(1,14)>¿Has venido a darte un garbeo por aquí? La verdad es<br>que está guapo este sitio.<clear><br><$voicel(1,5)><$comeff(1,10)><$motion(1,805)><$facial(1,4)>Creo que me quedaré un rato a curiosear."
msgstr "<$voicel(1,6)><$comeff(1,6)><$motion(1,666)>No me suena tu cara...<clear><br><$voicel(1,7)><$emotion(1,14)>¿Viniste a dar una vuelta por aquí? La verdad es<br>que está bonito este lugar.<clear><br><$voicel(1,5)><$comeff(1,10)><$motion(1,805)><$facial(1,4)>Creo que me quedaré un rato a curiosear."

#. en: <$comeff(1,3)><$motion(1,803)><$voicel(1,5)>Huh? You’re not from around here, are ya?<clear><br><$comeff(1,6)><$motion(1,666)><$voicel(1,7)>Hey, if you know anyone who’s familiar with these parts,<br>wouldja mind introducing me?
msgctxt "1968:11"
msgid "<$comeff(1,3)><$motion(1,803)><$voicel(1,5)>Tú vienes de mazo lejos, ¿no? <$comeff(1,6)><$motion(1,666)><$voicel(1,7)>¿No sabrás de alguien que<br>se conozca a fondo esta zona? Si eso preséntamelo, anda."
msgstr "<$comeff(1,3)><$motion(1,803)><$voicel(1,5)>Tú vienes de muy lejos, ¿no? <$comeff(1,6)><$motion(1,666)><$voicel(1,7)>¿No sabrás de alguien que<br>se conozca a fondo esta zona? Si es así, preséntamelo."

#. en: <$emotion(1,39)><$voicel(1,7)>My jaw’s pretty impressive, right? I can <$motionoff(1,804)><$comeff(1,10)><$facial(1,2)><$voicel(1,9)>chomp anything to<br>bits, no matter how hard it is!
msgctxt "1968:47"
msgid "<$emotion(1,39)><$voicel(1,7)>¿Qué pasa, chava<gen;-2(l,la)>? ¿Te flipa mi mandíbula o qué?<br>Es tan poderosa que, de un solo bocado, puedo...<slide><br><wait(1.0)><$motionoff(1,804)><$comeff(1,10)><$facial(1,2)><$voicel(1,9)>¡ÑACA!, hacer papilla cualquier cosa."
msgstr "<$emotion(1,39)><$voicel(1,7)>¿Qué pasa, chava<gen;-2(l,la)>? ¿Te asombra mi mandíbula o qué?<br>Es tan poderosa que, de un solo bocado, puedo...<slide><br><wait(1.0)><$motionoff(1,804)><$comeff(1,10)><$facial(1,2)><$voicel(1,9)>¡ÑACA!, hacer papilla cualquier cosa."

#. en: <$comeff(1,21)><$motion(1,803)><$facial(1,14)><$voicel(1,5)>Sunsets reflecting off the water’s surface are nice, but<br>seeing one from underwater is pretty great, too!
msgctxt "1968:50"
msgid "<$comeff(1,21)><$motion(1,803)><$facial(1,14)><$voicel(1,5)>Si crees que un atardecer reflejado en la superficie del<br>mar es bonito, ¡espera a verlo desde debajo del agua!"
msgstr ""

#. en: <$voicel(1,5)><$emotion(1,29)>When I get bigger, that means I’ll be able to eat way more<br>than I can now, yeah?<clear><br><$voicel(1,8)><$emotion(1,38)>I’m lookin’ forward to that! <$pkcry;0(1,1)>!
msgctxt "1968:52"
msgid "<$voicel(1,5)><$emotion(1,29)>Cuando me haga más grande, voy a tener hueco para<br>comer mucho más que ahora, ¿no?<clear><br><$voicel(1,8)><$emotion(1,38)>¡<$pkcry;0(1,1)>, qué ganas!"
msgstr "<$voicel(1,5)><$emotion(1,29)>Cuando me haga más grande, voy a tener espacio para<br>comer mucho más que ahora, ¿no?<clear><br><$voicel(1,8)><$emotion(1,38)>¡<$pkcry;0(1,1)>, qué ganas!"

#. en: <oneline><$voicel(1,7)><$emotion(1,39)>This<$cdef(27)> <fqty(1)><class><usingp;0></color>’s<br>awesome,<slide><br>huh?<slide><br>Glad<slide><br>I<slide><br>pulled<slide><br>out<slide><br>all<slide><br>the stops!
msgctxt "1968:53"
msgid "<$voicel(1,7)><$emotion(1,39)>Igual está feo que lo diga yo, pero qué guap<genqty;0(o,a,os,as)> nos <qty;0(ha,han)><br>quedado <dart;0()><$cdef(27)><fqty(1)><usingp;0></color>.<clear><br>¡Ha merecido la pena el esfuerzo!"
msgstr "<$voicel(1,7)><$emotion(1,39)>Quizás está feo que lo diga yo, pero qué bonit<genqty;0(o,a,os,as)> nos <qty;0(ha,han)><br>quedado <dart;0()><$cdef(27)><fqty(1)><usingp;0></color>.<clear><br>¡Valió la pena el esfuerzo!"

#. en: <$voicel(1,7)><$emotion(1,38)>This <$cdef(27)><fqty(1)><class><usingp;0> </color>rules!<clear><br><$voicel(1,6)><$emotion(1,50)>I wanna make one myself someday!
msgctxt "1968:54"
msgid "<oneline><$voicel(1,7)><$emotion(1,38)>No veas lo guap<genqty;0(o,a,os,as)> que <qty;0(ha,han)> quedado<br><dart;0()><$cdef(27)><fqty(1)><usingp;0></color>.<clear><br><$voicel(1,6)><$emotion(1,50)>¡La próxima vez tengo que apuntarme y currar yo<br>también!"
msgstr "<oneline><$voicel(1,7)><$emotion(1,38)>No sabes lo bonit<genqty;0(o,a,os,as)> que <qty;0(ha,han)> quedado<br><dart;0()><$cdef(27)><fqty(1)><usingp;0></color>.<clear><br><$voicel(1,6)><$emotion(1,50)>¡La próxima vez tengo que unirme y trabajar yo<br>también!"

#. en: <$comeff(1,10)><$facial(1,1)><$motion(1,661)><$voicel(1,7)>What’s up, pal? Need me to cut some logs for ya?<br>Whatever ya need, just say the word!
msgctxt "1968:55"
msgid "<$comeff(1,10)><$facial(1,1)><$motion(1,661)><$voicel(1,7)>¿Qué quieres? ¿Cortar troncos? Buah, me flipa, así que no<br>te cortes y avísame cuando quieras que te eche un cable."
msgstr "<$comeff(1,10)><$facial(1,1)><$motion(1,661)><$voicel(1,7)>¿Qué quieres? ¿Cortar troncos? Guau, me encanta, así que no<br>dudes en avisarme cuando quieras que te eche una mano."

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,661)><$voicel(1,7)>You know who rules at finding cool stuff? <wait(0.5)>Me! If you ever<br>wanna hunt for treasure, let me know!
msgctxt "1968:56"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,661)><$voicel(1,7)>¡Cuenta conmigo para buscar tesoros! Se me da tela<br>de bien."
msgstr "<$comeff(1,10)><$facial(1,4)><$motion(1,661)><$voicel(1,7)>¡Cuenta conmigo para buscar tesoros! Se me da súper<br>bien."

#. en: <$comeff(1,3)><$facial(1,1)><$motion(1,803)><$voicel(1,5)>When you’re looking for a Pokémon, come find me first.<br>I can take ya right to ’em!
msgctxt "1968:60"
msgid "<$comeff(1,3)><$facial(1,1)><$motion(1,803)><$voicel(1,5)>Cuando quieras buscar a un Pokémon, avísame y te llevo<br>adonde esté en un plis, ¿vale? No es broma, ¡de verdad!"
msgstr "<$comeff(1,3)><$facial(1,1)><$motion(1,803)><$voicel(1,5)>Cuando quieras buscar a un Pokémon, avísame y te llevo<br>adonde esté en un segundo, ¿ok? No es broma, ¡de verdad!"

#. en: <oneline><$voicel(1,7)><$motion(1,801)><$comeff(1,5)><$facial(1,4)><$cdef(27)><pname;0></color>! You ready to make today<br>another<slide><br>awesome day?!
msgctxt "1968:101"
msgid "<$cdef(27)><$voicel(1,7)><$motion(1,801)><$comeff(1,5)><$facial(1,4)></color>¡Com<gen;-2(padre,adre)>! ¡Qué buen día para empezar con ganas!"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,14)><$facial(1,4)>GOOOOOOD MORNING! <wait(0.8)>Nothin’ gets the day started<br>like some shouting, am I right?
msgctxt "1968:102"
msgid "<$voicel(1,7)><$emotion(1,14)><$facial(1,4)>¡¡BUENAAAS!! ¡Si es que hay que empezar el día con<br>energía!"
msgstr "<$voicel(1,7)><$emotion(1,14)><$facial(1,4)>¡¡BUENAAAS!! ¡Es que hay que empezar el día con<br>energía!"

#. en: <$voicel(1,5)><$motion(1,807)><$comeff(1,14)>Whoa, how’s it lunchtime already?
msgctxt "1968:103"
msgid "<$voicel(1,5)><$motion(1,807)><$comeff(1,14)>Buf... ¡Se me está pasando el día rapidísimo!"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,49)>Yo! You’re lookin’ pretty chipper, huh? Maybe I should go<br>for walks now and then too.
msgctxt "1968:104"
msgid "<$voicel(1,7)><$emotion(1,49)>¿Qué pasa, com<gen;-2(padre,adre)>? Tienes buena cara. Yo también<br>debería darme un paseo de vez en cuando."
msgstr "<$voicel(1,7)><$emotion(1,49)>¿Qué tal, com<gen;-2(padre,adre)>? Tienes buena cara. Yo también<br>debería darme un paseo de vez en cuando."

#. en: <$voicel(1,7)><$comeff(1,3)><$facial(1,4)><$motion(1,806)>All right, I’m ready to give 110 percent...tomorrow.
msgctxt "1968:105"
msgid "<$voicel(1,7)><$comeff(1,3)><$facial(1,4)><$motion(1,806)>¡Ya verás, mañana empiezo a tomarme las cosas en serio!<br>¡Prometido!"
msgstr ""

#. en: <$voicel(1,3)><$comeff(1,14)><$motion(1,807)><$facial(1,9)>Something about seein’ the sun set always makes me<br>wanna yell for some reason... <wait(1.3)><$comeff(1,10)><$voicel(1,7)><$motionoff(1,804)><$facial(1,3)><$pkcry;0(1,3)>!
msgctxt "1968:106"
msgid "<$voicel(1,3)><$comeff(1,14)><$motion(1,807)><$facial(1,9)>Cuando veo el sol al atardecer, me entran unas ganas<br>de gritar que no veas...<clear><br><$comeff(1,10)><$voicel(1,7)><$motionoff(1,804)><$facial(1,3)>¡<$pkcry;0(1,3)>!"
msgstr "<$voicel(1,3)><$comeff(1,14)><$motion(1,807)><$facial(1,9)>Cuando veo el sol al atardecer, me entran unas ganas<br>de gritar tremendas...<clear><br><$comeff(1,10)><$voicel(1,7)><$motionoff(1,804)><$facial(1,3)>¡<$pkcry;0(1,3)>!"

#. en: <$voicel(1,5)><$emotion(1,16)><$motion(1,666)>You seem like the type that gets hyped when it’s night...<br>Am I right?
msgctxt "1968:107"
msgid "<$voicel(1,5)><$emotion(1,16)><$motion(1,666)>¿Tú eres de l<gen;-2(o,a)>s que se ponen hiperactiv<gen;-2(o,a)>s por la noche?"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,49)>Whoa, you’re still up? Pullin’ an all-nighter, huh?
msgctxt "1968:108"
msgid "<$voicel(1,7)><$emotion(1,49)>¿Qué pasa, chava<gen;-2(l,la)>? ¿Hoy no vas a dormir, o qué?"
msgstr ""

#. en: <$voicel(1,7)><$comeff(1,10)><$motion(1,805)><$facial(1,4)><$pkcry;0(1,4)>! Where should I scope out today?
msgctxt "1968:109"
msgid "<$voicel(1,7)><$comeff(1,10)><$motion(1,805)><$facial(1,4)>¡<$pkcry;0(1,4)>! A ver adónde voy a explorar hoy..."
msgstr ""

#. en: <$voicel(1,7)><$motion(1,661)><$facial(1,4)><$comeff(1,9)>Oh, hey! Need somethin’? Go on then, lay it on me!
msgctxt "1968:110"
msgid "<$voicel(1,7)><$motion(1,661)><$facial(1,4)><$comeff(1,9)>¿Qué pasa, herman<gen;-2(o,a)>? ¿Querías algo? Dispara."
msgstr ""

#. en: <$voicel(1,5)><$emotion(1,14)>I bet there’s a bunch of stuff you wanna do, right? <$voicel(1,8)><$comeff(1,9)><$motion(1,661)><$facial(1,4)>How’s<br>about lettin’ me help you out?
msgctxt "1968:111"
msgid "<$voicel(1,5)><$emotion(1,14)>Siempre hay mazo de cosas que quieres hacer, ¿no?<clear><br><$voicel(1,8)><$comeff(1,9)><$motion(1,661)><$facial(1,4)>Pues tranqui, que yo te echo un cable."
msgstr "<$voicel(1,5)><$emotion(1,14)>Siempre hay muchas cosas que quieres hacer, ¿no?<clear><br><$voicel(1,8)><$comeff(1,9)><$motion(1,661)><$facial(1,4)>Pues tranqui, que yo te echo una mano."

#. en: <$voicel(1,7)><$emotion(1,49)>What’s up, <$cdef(27)><pname;0></color>? You eat yet?
msgctxt "1968:112"
msgid "<oneline><$voicel(1,7)><$emotion(1,49)>¡Que no me entere yo que est<gen;-2(e,a)> <$cdef(27)><pname;0><br></color>pasa hambre!"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,14)><$facial(1,4)>Whoa, hey! I was JUST thinkin’ about how much I wanted<br>to chat with you!
msgctxt "1968:113"
msgid "<$voicel(1,7)><$emotion(1,14)><$facial(1,4)>¡Buah, chava<gen;-2(l,la)>! ¡Justo estaba pensando que quería hablar<br>contigo!"
msgstr "<$voicel(1,7)><$emotion(1,14)><$facial(1,4)>¡Vaya, chava<gen;-2(l,la)>! ¡Justo estaba pensando que quería hablar<br>contigo!"

#. en: <oneline><$voicel(1,5)><$emotion(1,49)>Know what I like about you, <$cdef(27)><pname;0></color>?<br>You’ve<slide><br>got<slide><br>a<slide><br>real<slide><br>laid-back attitude.
msgctxt "1968:114"
msgid "<$cdef(27)><$voicel(1,5)><$emotion(1,49)></color>Me encanta que vayas siempre a tu bola, ¡jua, jua!"
msgstr "<$cdef(27)><$voicel(1,5)><$emotion(1,49)></color>Me encanta que vayas siempre a tu ritmo, ¡jua, jua!"

#. en: <$comeff(1,16)><$facial(1,9)>*yaaawn*<wait(0.65)> <$voicel(1,8)><$emotion(1,27)>Hey! Don’t look at me when I’m yawning!
msgctxt "1968:115"
msgid "<$comeff(1,16)><$facial(1,9)>Buah, qué sueñooo...<wait(0.65)> <$voicel(1,8)><$emotion(1,27)>¡Oye, no me mires cuando estoy<br>bostezando!"
msgstr "<$comeff(1,16)><$facial(1,9)>Uf, qué sueñooo...<wait(0.65)> <$voicel(1,8)><$emotion(1,27)>¡Oye, no me mires cuando estoy<br>bostezando!"

#. en: <$voicel(1,7)><$comeff(1,3)><$motion(1,805)>Y’know, it feels like this area’s gettin’ nicer and nicer.
msgctxt "1968:116"
msgid "<$voicel(1,7)><$comeff(1,3)><$motion(1,805)>Oye, pues me da la impresión de que esta zona cada vez<br>está mejor."
msgstr ""

#. en: <$voicel(1,5)><$emotion(1,55)>Time sure passes fast when you spend the whole day just<br>lazin’ around, huh?
msgctxt "1968:117"
msgid "<$voicel(1,5)><$emotion(1,55)>Si no haces nada en to'l día, se pasa rapidísimo."
msgstr "<$voicel(1,5)><$emotion(1,55)>Si no haces nada en todo el día, se pasa rapidísimo."

#. en: <$voicel(1,7)><$emotion(1,8)>Aw, did you wanna talk to me? Well, I guess I can make<br>time for you, pal! <$pkcry;1(1,2)>! ♪
msgctxt "1968:118"
msgid "<$voicel(1,7)><$emotion(1,8)>¿Querías hablar conmigo? Bueno, si me lo pides así...<br>¡Te haré el favor! ¡<$pkcry;1(1,2)>!"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,8)>Ha! I can always see you comin’ from a mile away.
msgctxt "1968:119"
msgid "<$cdef(27)><$voicel(1,7)><$emotion(1,8)></color>Aunque estés todavía superlejos, siempre te noto llegar.<br>¡Qué cosas!"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,38)>Know what I’ve been thinkin’? It’d be great if things could<br>be fun like this forever.
msgctxt "1968:120"
msgid "<$voicel(1,7)><$emotion(1,38)>Oye... Tú y yo panas para siempre. Que nos quedan<br>muchas risas que echar. Jua, jua."
msgstr "<$voicel(1,7)><$emotion(1,38)>Oye... Tú y yo amigos para siempre. Que nos quedan<br>muchas risas por compartir. Jua, jua."

#. en: <$voicel(1,3)><$comeff(1,16)><$facial(1,9)><$motion(1,807)>*yaaawn* Oh... Mornin’, <$cdef(27)><pname;0></color>.
msgctxt "1968:121"
msgid "<oneline><$voicel(1,3)><$comeff(1,16)><$facial(1,9)><$motion(1,807)>Uaaah... Toca levantarse... ¡Ah, buenas,<br><$cdef(27)><pname;0></color>!"
msgstr ""

#. en: <$voicel(1,2)><$comeff(1,16)><$facial(1,9)><$motion(1,807)>...Hwuh?
msgctxt "1968:122"
msgid "<$voicel(1,2)><$comeff(1,16)><$facial(1,9)><$motion(1,807)>¿Ein?..."
msgstr "<$voicel(1,2)><$comeff(1,16)><$facial(1,9)><$motion(1,807)>¿Eh?..."

#. en: <$voicel(1,7)><$emotion(1,49)>I’m still gettin’ the lay of the land, so I’m comin’ to you<br>if I need help. That cool?
msgctxt "1968:123"
msgid "<$voicel(1,7)><$emotion(1,49)>Buah, no tengo ni pajolera idea de qué hay por esta zona.<br>¡Tendrás que ayudarme, <gen;-2(bro,sis)>!"
msgstr "<$voicel(1,7)><$emotion(1,49)>Uf, no tengo ni la menor idea de qué hay por esta zona.<br>¡Tendrás que ayudarme, <gen;-2(bro,sis)>!"

#. en: <$voicel(1,7)><$emotion(1,32)>There’s a bunch of stuff that’s new to me around here.<br>Maybe I’ll go for a li’l walk and check it all out!
msgctxt "1968:124"
msgid "<$voicel(1,7)><$emotion(1,32)>¡Buah, todavía no me empano de lo que hay por aquí!<br>Debería ir a dar una vuelta."
msgstr "<$voicel(1,7)><$emotion(1,32)>¡Uf, todavía no sé bien lo que hay por aquí!<br>Debería ir a dar una vuelta."

#. en: <$voicel(1,5)><$motion(1,806)><$comeff(1,6)>What kind of Pokémon are there around here? Are they<br>stronger than me?<wait(0.60)><$emotion(1,1)> Ha! As if!
msgctxt "1968:125"
msgid "<$voicel(1,5)><$motion(1,806)><$comeff(1,6)>¿Qué otros Pokémon viven por aquí? ¿Hay alguno más<br>fuerte que yo?"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,49)>Oh, hey, what’s gettin’ built here? Wait, don’t tell<br>me—it’ll be a fun surprise!
msgctxt "1968:126"
msgid "<$voicel(1,7)><$emotion(1,49)>A ver, ¿qué estáis liando? ¡Qué ganas de ver cómo<br>queda, <gen;-2(bro,sis)>!"
msgstr "<$voicel(1,7)><$emotion(1,49)>A ver, ¿qué están tramando? ¡Qué ganas de ver cómo<br>queda, <gen;-2(bro,sis)>!"

#. en: <$voicel(1,7)><$emotion(1,8)>Hey hey hey! Let’s get this <$cdef(27)><$spwfull(1)>in’</color> party started! ♪
msgctxt "1968:127"
msgid "<$voicel(1,7)><$emotion(1,8)>¡Venga, vengaaa! ¡Que esto no se va a <$cdef(27)><$spwfull(1)></color> solo!"
msgstr "<$voicel(1,7)><$emotion(1,8)>¡Vamos, vamooos! ¡Que esto no se va a <$cdef(27)><$spwfull(1)></color> solo!"

#. en: <$voicel(1,7)><$emotion(1,8)>Aw yeah, things’re really poppin’ around here now that<br>there are so many more Pokémon!
msgctxt "1968:128"
msgid "<$voicel(1,7)><$emotion(1,8)>¡Uala, qué de peña hay aquí! ¡Qué buen ambiente!"
msgstr "<$voicel(1,7)><$emotion(1,8)>¡Guau, cuánta gente hay aquí! ¡Qué buen ambiente!"

#. en: <$voicel(1,3)><$emotion(1,13)>Wonder if my home could get a little more comfortable...
msgctxt "1968:129"
msgid "<$voicel(1,3)><$emotion(1,13)>Mi keli es como... un poco básica. No sé, le falta algo..."
msgstr "<$voicel(1,3)><$emotion(1,13)>Mi casa es como... un poco básica. No sé, le falta algo..."

#. en: <$voicel(1,9)><$emotion(1,1)>I’m loving how comfortable my home’s gettin’ lately!<br>Thanks a bunch, <$cdef(27)><pname;1></color>!
msgctxt "1968:130"
msgid "<$cdef(27)><$voicel(1,9)></color><$emotion(1,1)>¡Cómo ha mejorado mi keli! ¡Muchas gracias, herman<gen;-2(o,a)>!"
msgstr "<$cdef(27)><$voicel(1,9)></color><$emotion(1,1)>¡Cómo mejoró mi casa! ¡Muchas gracias, herman<gen;-2(o,a)>!"

#. en: <$voicel(1,9)><$emotion(1,62)>Lemme tell ya—my home is A-MA-ZING! Nothing beats<br>time spent chillin’ at home.
msgctxt "1968:131"
msgid "<$voicel(1,9)><$emotion(1,62)>¡Buah, qué flipe de keli, <gen;-2(chaval,chavala)>! ¡Se está de lujo!"
msgstr "<$voicel(1,9)><$emotion(1,62)>¡Guau, qué casa tan increíble, <gen;-2(chaval,chavala)>! ¡Se está de lujo!"

#. en: <oneline><$voicel(1,7)><$emotion(1,32)>Hey, <$cdef(27)><pname;0></color>! I was just thinking about<br>how<slide><br>much<slide><br>I<slide><br>wanted<slide><br>to<slide><br>see you!
msgctxt "1968:132"
msgid "<$cdef(27)><$voicel(1,7)></color><$emotion(1,32)>¡Buah, <gen;-2(chaval,chavala)>, qué casualidad! Justo estaba pensando<br>en quedar contigo."
msgstr "<$cdef(27)><$voicel(1,7)></color><$emotion(1,32)>¡Vaya, <gen;-2(chaval,chavala)>, qué casualidad! Justo estaba pensando<br>en ir a verte."

#. en: <$voicel(1,7)><$emotion(1,49)>Y’know, I never get bored when I’m spendin’ time with<br>you. <$voicel(1,10)><$emotion(1,8)>I’m glad we’re pals!
msgctxt "1968:133"
msgid "<$voicel(1,7)><$emotion(1,49)>Cuando estoy contigo, no hay momento aburrido.<clear><br><$voicel(1,10)><$emotion(1,8)>¡Eres justo la clase de amig<gen;-2(o,a)> que me mola tener, <gen;-2(bro,sis)>!"
msgstr "<$voicel(1,7)><$emotion(1,49)>Cuando estoy contigo, no hay momento aburrido.<clear><br><$voicel(1,10)><$emotion(1,8)>¡Eres justo la clase de amig<gen;-2(o,a)> que me gusta tener, <gen;-2(bro,sis)>!"

#. en: <$voicel(1,7)><$emotion(1,60)>Phew, made it back safely. It ain’t half bad, headin’ off<br>on a long journey every now and then.
msgctxt "1968:134"
msgid "<$voicel(1,7)><$emotion(1,60)>¡Pues ya estamos de vuelta! Me mola irnos de excursión<br>de vez en cuando."
msgstr "<$voicel(1,7)><$emotion(1,60)>¡Pues ya estamos de vuelta! Me gusta irnos de excursión<br>de vez en cuando."

#. en: <oneline><$voicel(1,5)><$emotion(1,49)>You’re back, <$cdef(27)><pname;0></color>! Find anything<br>cool?
msgctxt "1968:135"
msgid "<oneline><$voicel(1,5)><$emotion(1,49)>¡Pero si es <$cdef(27)><pname;0></color>! ¿Has encontrado<br>algo interesante<slide><br>por ahí?"
msgstr "<oneline><$voicel(1,5)><$emotion(1,49)>¡Pero si es <$cdef(27)><pname;0></color>! ¿Encontraste<br>algo interesante<slide><br>por ahí?"

#. en: <oneline><$voicel(1,7)><$comeff(1,3)>Yo, <$cdef(27)><pname;0></color>. I hear you went someplace<br>really<slide><br>far<slide><br>away,<slide><br>huh?<slide><br><$voicel(1,5)><$emotion(1,29)>Didja<slide><br>have fun?
msgctxt "1968:136"
msgid "<oneline><$voicel(1,7)><$comeff(1,3)>¡Buenas, <$cdef(27)><pname;0></color>! ¡Esta vez te has ido<br>de viaje lejísimos!<clear><br><$voicel(1,5)><$emotion(1,29)>¿Qué tal el quinto pino, divertido?"
msgstr "<oneline><$voicel(1,7)><$comeff(1,3)>¡Buenas, <$cdef(27)><pname;0></color>! ¡Esta vez te fuiste<br>de viaje lejísimos!<clear><br><$voicel(1,5)><$emotion(1,29)>¿Qué tal por allá lejos, divertido?"

#. en: <$comeff(1,6)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>What kinda stuff do you like, <$cdef(27)><pname;0></color>?<clear><br><$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,8)>How ’bout this—if I find anything rad, I’ll throw it in the<br><$cdef(27)><fqty(1)><$ifull(1460)></color> for ya!
msgctxt "1968:137"
msgid "<$facial(1,1)><$motion(1,666)><$voicel(1,5)>Oye, <$comeff(1,6)>¿qué clase de materiales te molan? <$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,8)>Si me topo con<br>alguno chulo por ahí: ¡a la <$cdef(27)><fqty(1)><$ifull(1460)></color> se ha dicho!"
msgstr "<$facial(1,1)><$motion(1,666)><$voicel(1,5)>Oye, <$comeff(1,6)>¿qué clase de materiales te gustan? <$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,8)>Si me topo con<br>alguno genial por ahí: ¡a la <$cdef(27)><fqty(1)><$ifull(1460)></color> se ha dicho!"

#. en: <$voicel(1,7)><$emotion(1,8)>You lookin’ to <$cdef(27)><$spwfull(1)></color> something? Lemme know if you<br>are—I’m pretty great at makin’ stuff!
msgctxt "1968:138"
msgid "<$voicel(1,7)><$emotion(1,8)>¡Se me da genial <$cdef(27)><$spwfull(1)></color>! Si necesitas ayuda con<br>algún edificio, me avisas."
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,49)>If you need fire, look no further! Got anythin’ to burn?
msgctxt "1968:139"
msgid "<$voicel(1,7)><$emotion(1,49)>¡Si quieres prenderle fuego a algo, aquí está <gen;-3(el,la)> menda!<br>¿No hay nada que quieras quemar?"
msgstr "<$voicel(1,7)><$emotion(1,49)>¡Si quieres prenderle fuego a algo, aquí está <gen;-3(el,la)> crack!<br>¿No hay nada que quieras quemar?"

#. en: <$voicel(1,7)><$emotion(1,49)>Any spots around here lookin’ a little too dry? I can water<br>’em, if you need me to.
msgctxt "1968:140"
msgid "<$voicel(1,7)><$emotion(1,49)>¿No te hará falta algo de agua, por casualidad? Si eso,<br>lo arreglo yo en un momento."
msgstr "<$voicel(1,7)><$emotion(1,49)>¿No te hará falta algo de agua, por casualidad?<br>Si es así, lo arreglo yo en un momento."

#. en: <$voicel(1,7)><$emotion(1,49)>Need me to power up any machines with my electricity?
msgctxt "1968:141"
msgid "<$voicel(1,7)><$emotion(1,49)>¿Quieres que use mi electricidad para encender alguna<br>máquina?"
msgstr ""

#. en: <$voicel(1,7)><$motion(1,661)><$comeff(1,9)><$facial(1,4)>Point me to any plant, flower, or tree and I’ll make ’em<br>nice and healthy!
msgctxt "1968:142"
msgid "<$voicel(1,7)><$motion(1,661)><$comeff(1,9)><$facial(1,4)>¡Si dejas que me encargue de tus árboles y tus flores,<br>estarán llenos de vida!"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,49)>Lemme know if you wanna get folks hyped up, yeah?<br>I’ll help get the party started!
msgctxt "1968:146"
msgid "<$voicel(1,7)><$emotion(1,49)>Si quieres pasarlo bien, avísame. ¡Soy el alma de la fiesta!"
msgstr "<$voicel(1,7)><$emotion(1,49)>Si quieres pasarla bien, avísame. ¡Soy el alma de la fiesta!"

#. en: <oneline><$voicel(1,7)><$emotion(1,49)>So this is where <$cdef(27)><wndhmownerpk;0></color> lives, huh? <wait(0.9)><br>Yeah,<slide><br>I<slide><br>can<slide><br>see it!
msgctxt "1968:148"
msgid "<oneline><$voicel(1,7)><$emotion(1,49)>¿Aquí vive <dart;0()><$cdef(27)><wndhmownerpk;0></color>? Buah, sí que<br>le pega,<slide><br>¡es <$cdef(27)><wndhmownerpk;1></color> total!"
msgstr "<oneline><$voicel(1,7)><$emotion(1,49)>¿Aquí vive <dart;0()><$cdef(27)><wndhmownerpk;0></color>? Vaya, sí que<br>le queda,<slide><br>¡es <$cdef(27)><wndhmownerpk;1></color> total!"

#. en: <oneline><$voicel(1,7)><$emotion(1,14)>Is that <$cdef(27)><pname;0></color>? Dang, fancy seein’<br>you here!
msgctxt "1968:149"
msgid "<oneline><$voicel(1,7)><$emotion(1,14)>¿Eh? ¡Si es <$cdef(27)><pname;0></color>! ¡Buah, qué<br>casualidad!"
msgstr "<oneline><$voicel(1,7)><$emotion(1,14)>¿Eh? ¡Si es <$cdef(27)><pname;0></color>! ¡Vaya, qué<br>casualidad!"

#. en: <oneline><$voicel(1,7)><$emotion(1,1)>Ha! This <$cdef(27)><fqty(1)><class><usingp;0></color> is<br>surprisingly<slide><br>fun!
msgctxt "1968:150"
msgid "<oneline><$voicel(1,7)><$emotion(1,1)>¡Buah, qué guap<genqty;0(o,a,os,as)><br><dart;0()><$cdef(27)><fqty(1)><class><usingp;0></color>!<slide><br>¿Quién lo iba<slide><br>a decir?"
msgstr "<oneline><$voicel(1,7)><$emotion(1,1)>¡Guau, qué bonit<genqty;0(o,a,os,as)><br><dart;0()><$cdef(27)><fqty(1)><class><usingp;0></color>!<slide><br>¿Quién lo iba<slide><br>a decir?"

#. en: <$voicel(1,5)><$emotion(1,16)><$motion(1,666)>Hey, what the heck is this? No matter how much I stare,<br>I just can’t figure it out...
msgctxt "1968:151"
msgid "<$voicel(1,5)><$emotion(1,16)><$motion(1,666)>¡Uala! ¿Y esto qué es? Por más que lo mire, no lo pillo."
msgstr "<$voicel(1,5)><$emotion(1,16)><$motion(1,666)>¡Guau! ¿Y esto qué es? Por más que lo mire, no lo entiendo."

#. en: <oneline><$voicel(1,5)><$emotion(1,6)>Dang... This <$cdef(27)><fqty(1)><class><usingp;0><br></color>is<slide><br>pretty cute.
msgctxt "1968:152"
msgid "<oneline><$voicel(1,5)><$emotion(1,6)>¡Buah, chava<gen;-2(l,la)>, qué monada de<br><$cdef(27)><fqty(1)><class><usingp;0></color>!"
msgstr "<oneline><$voicel(1,5)><$emotion(1,6)>¡Guau, chava<gen;-2(l,la)>, qué belleza de<br><$cdef(27)><fqty(1)><class><usingp;0></color>!"

#. en: <$voicel(1,7)><$emotion(1,14)>So this is <iart;0()><$cdef(27)><fqty(1)><class><usingp;0></color>...
msgctxt "1968:153"
msgid "<oneline><$voicel(1,7)><$emotion(1,14)>O sea que esto es<br><iart;0()><$cdef(27)><fqty(1)><class><usingp;0></color>..."
msgstr ""

#. en: <oneline><$voicel(1,7)><$emotion(1,38)>Nothing beats <iart;0()><$cdef(27)><fqty(1)><class><usingp;0></color>,<br>amirite?!
msgctxt "1968:155"
msgid "<$voicel(1,7)><$emotion(1,38)>¡Qué flipe de <$cdef(27)><fqty(1)><usingp;0></color>!"
msgstr "<$voicel(1,7)><$emotion(1,38)>¡Qué maravilla de <$cdef(27)><fqty(1)><usingp;0></color>!"

#. en: <$voicel(1,5)><$emotion(1,55)>Doesn’t this thing kinda look like me? Except I’m cooler.
msgctxt "1968:156"
msgid "<$voicel(1,5)><$emotion(1,55)>¡Pero si se parece a mí! Bueno, aunque yo molo más."
msgstr "<$voicel(1,5)><$emotion(1,55)>¡Pero si se parece a mí! Bueno, aunque yo soy más genial."

#. en: <oneline><$voicel(1,7)><$emotion(1,6)>Dang, <qty;0(this,these)><br><$cdef(27)><fqty(1)><noweating;0></color> sure <qty;0(is,are)> tasty!
msgctxt "1968:157"
msgid "<oneline><$voicel(1,7)><$emotion(1,6)>¡Buah, est<genqty;0(e,a,os,as)> <$cdef(27)><fqty(1)><noweating;0><br></color>est<qty;0(á,án)> buenísim<genqty;0(o,a,os,as)>!"
msgstr "<oneline><$voicel(1,7)><$emotion(1,6)>¡Guau, est<genqty;0(e,a,os,as)> <$cdef(27)><fqty(1)><noweating;0><br></color>est<qty;0(á,án)> buenísim<genqty;0(o,a,os,as)>!"

#. en: <$voicel(1,7)><$motion(1,807)><$comeff(1,7)>I can eat anything! I can... I really... Ugh...
msgctxt "1968:158"
msgid "<$voicel(1,7)><$motion(1,807)><$comeff(1,7)>¡A mí me gusta alimentarme con todo lo que pille!<br>Que lo digo en serio... De verdad que... sí... Uuugh..."
msgstr "<$voicel(1,7)><$motion(1,807)><$comeff(1,7)>¡A mí me gusta alimentarme con todo lo que encuentre!<br>Que lo digo en serio... De verdad que... sí... Uuugh..."

#. en: <$voicel(1,10)><$comeff(1,3)><$motion(1,801)><$facial(1,5)>Heck yeah, <$cdef(27)><pname;0></color>! Way to go!
msgctxt "1968:159"
msgid "<$voicel(1,10)><$comeff(1,3)><$motion(1,801)><$cdef(27)><$facial(1,5)></color>¡Buah, herman<gen;-2(o,a)>, no esperaba menos de ti!"
msgstr "<$voicel(1,10)><$comeff(1,3)><$motion(1,801)><$cdef(27)><$facial(1,5)></color>¡Guau, herman<gen;-2(o,a)>, no esperaba menos de ti!"

#. en: <$voicel(1,10)><$comeff(1,10)><$motion(1,803)><$facial(1,4)>Dang, check out <$cdef(27)><blsspwkpk;0></color>! I’m impressed!
msgctxt "1968:160"
msgid "<$voicel(1,10)><$comeff(1,10)><$motion(1,803)><$facial(1,4)>¡Qué flipe lo <esde;0()><$cdef(27)><blsspwkpk;0></color>!"
msgstr "<$voicel(1,10)><$comeff(1,10)><$motion(1,803)><$facial(1,4)>¡Qué increíble lo <esde;0()><$cdef(27)><blsspwkpk;0></color>!"

#. en: <$voicel(1,7)><$emotion(1,14)>Huh? No, we’re not fighting—we’re just playin’ tag!
msgctxt "1968:161"
msgid "<$voicel(1,7)><$emotion(1,14)>¿Eeeh? ¡Que no es una pelea, es el pillapilla!"
msgstr "<$voicel(1,7)><$emotion(1,14)>¿Eeeh? ¡Que no es una pelea, solo estamos jugando!"

#. en: <oneline><$voicel(1,7)><$facial(1,4)><$comeff(1,9)><$motion(1,806)>I’ve only got nice stuff to say about<br><$cdef(27)><nnowpairpk;0></color>.<slide><br>We<slide><br>just<slide><br>vibe, y’know?
msgctxt "1968:162"
msgid "<oneline><$voicel(1,7)><$facial(1,4)><$comeff(1,9)><$motion(1,806)><fcap><dart;0()><$cdef(27)><nnowpairpk;0> </color>y yo somos panitas.<br>Se nota que<slide><br>nos llevamos<slide><br>genial, ¿no?"
msgstr "<oneline><$voicel(1,7)><$facial(1,4)><$comeff(1,9)><$motion(1,806)><fcap><dart;0()><$cdef(27)><nnowpairpk;0> </color>y yo somos compas.<br>Se nota que<slide><br>nos llevamos<slide><br>genial, ¿no?"

#. en: <oneline><$voicel(1,3)><$comeff(1,16)><$motion(1,807)><$facial(1,9)>*yaaawn* You headin’ off to bed soon too,<br><$cdef(27)><pname;0></color>?<slide><br>Hope<slide><br>you<slide><br>have<slide><br>some<slide><br>good dreams.
msgctxt "1968:163"
msgid "<$cdef(27)><$voicel(1,3)></color><$comeff(1,16)><$motion(1,807)><$facial(1,9)>Qué sueñooo... ¿Tú también pliegas ya? Que sueñes<br>cosas bonitas."
msgstr "<$cdef(27)><$voicel(1,3)></color><$comeff(1,16)><$motion(1,807)><$facial(1,9)>Qué sueñooo... ¿Tú también te retiras ya?<br>Que sueñes cosas bonitas."

#. en: <$voicel(1,3)><$emotion(1,65)>Guess I’ll head off to bed soon. See ya tomorrow!
msgctxt "1968:164"
msgid "<$voicel(1,3)><$emotion(1,65)>¿Te vas a la cama? Porque yo sí... Mañana nos vemos."
msgstr ""

#. en: <$voicel(1,5)><$emotion(1,14)>Looks like the others are gettin’ up. Guess that means it’s<br>time for me to get some shut-eye.
msgctxt "1968:165"
msgid "<$voicel(1,5)><$emotion(1,14)>Ya se está levantando la peña. Pues nada, tendré que<br>irme a la cama. ¡Buenas noches, <gen;-2(bro,sis)>!"
msgstr "<$voicel(1,5)><$emotion(1,14)>Ya se está levantando la gente. Pues nada, tendré que<br>irme a la cama. ¡Buenas noches, <gen;-2(bro,sis)>!"

#. en: <$voicel(1,3)><$comeff(1,16)><$motion(1,807)><$facial(1,9)>Ugh, it’s so bright... I’m going to bed. <$pkcry;1(1,4)>!
msgctxt "1968:166"
msgid "<$voicel(1,3)><$comeff(1,16)><$motion(1,807)><$facial(1,9)>Buah, qué de luz... Me voy a dormir. <$pkcry;1(1,4)>..."
msgstr "<$voicel(1,3)><$comeff(1,16)><$motion(1,807)><$facial(1,9)>Uf, cuánta luz... Me voy a dormir. <$pkcry;1(1,4)>..."

#. en: <$voicel(1,7)><$emotion(1,49)>When I wanna spend some time alone, I head to the skies.<br>I feel totally refreshed after flying around for a bit!
msgctxt "1968:167"
msgid "<$voicel(1,7)><$emotion(1,49)>Cuando me apetece estar sol<gen;-3(o,a)>, me voy un rato a volar.<br>Siempre me hace sentir mejor."
msgstr "<$voicel(1,7)><$emotion(1,49)>Cuando quiero estar sol<gen;-3(o,a)>, me voy un rato a volar.<br>Siempre me hace sentir mejor."

#. en: <$comeff(1,5)><$motionoff(1,804)><$voicel(1,10)>AAACHOO!<clear><br><$comeff(1,4)><$motion(1,807)><$voicel(1,5)>Phew, that was close! I nearly sprayed poison everywhere.
msgctxt "1968:169"
msgid "<$comeff(1,5)><$motionoff(1,804)><$voicel(1,10)>A... <wait(1.0)>a... <wait(1.0)>¡¡achís!!<clear><br><$comeff(1,4)><$motion(1,807)><$voicel(1,5)>Buah, qué liada... ¡He estado a nada de echar veneno<br>por todos lados!"
msgstr "<$comeff(1,5)><$motionoff(1,804)><$voicel(1,10)>A... <wait(1.0)>a... <wait(1.0)>¡¡achís!!<clear><br><$comeff(1,4)><$motion(1,807)><$voicel(1,5)>Uf, qué desastre... ¡Estuve a nada de echar veneno<br>por todos lados!"

#. en: <$voicel(1,7)><$emotion(1,49)>My body might be rock-hard, but you better not use Rock<br>Smash on me, got it?
msgctxt "1968:171"
msgid "<$voicel(1,7)><$emotion(1,49)>¡Puede que tenga el cuerpo duro, pero ni se te ocurra<br>usar Golpe Roca contra mí, eeeh!"
msgstr ""

#. en: <$voicel(1,7)><$motion(1,806)><$comeff(1,3)>You better not underestimate me just ’cause I’m small—I’ll<br>run circles around ya when it comes to cheerin’ and hidin’!
msgctxt "1968:172"
msgid "<$voicel(1,7)><$motion(1,806)><$comeff(1,3)>¡Soy pequeñ<gen;-3(o,a)>, pero tiene sus ventajas! ¡Al escondite no<br>me gana nadie!"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,48)>Being this big takes a surprising amount of mental<br>energy—I’m always worried that I’m in the way, y’know?
msgctxt "1968:173"
msgid "<$voicel(1,7)><$emotion(1,48)>Ser grande también es una movida. Si me descuido,<br>termino taponando los caminos..."
msgstr "<$voicel(1,7)><$emotion(1,48)>Ser grande también es un lío. Si me descuido,<br>termino taponando los caminos..."

#. en: <$voicel(1,7)><$emotion(1,14)>Whoa, careful! Don’t go burnin’ yourself on my fire, got it?
msgctxt "1968:174"
msgid "<$voicel(1,7)><$emotion(1,14)>¡Cuidado, chava<gen;-2(l,la)>! No te vayas a quemar con mi fuego."
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,8)>I sure could go for a swim right now. <$pkcry;0(1,1)>! ♪
msgctxt "1968:175"
msgid "<oneline><$voicel(1,7)><$emotion(1,8)>¡Buah, qué ganas de darme un bañito!<br>♪¡<$pkcry;0(1,1)>!♪"
msgstr "<oneline><$voicel(1,7)><$emotion(1,8)>¡Ay, qué ganas de darme un bañito!<br>♪¡<$pkcry;0(1,1)>!♪"

#. en: <$voicel(1,5)><$comeff(1,14)><$motion(1,805)>Humans must’ve used a ton of electricity, huh? <$voicel(1,8)><$emotion(1,49)>They left<br>behind so many cool machines!
msgctxt "1968:177"
msgid "<$voicel(1,5)><$comeff(1,14)><$motion(1,805)>Que yo sepa, los humanos usaban mazo de electricidad...<clear><br><$voicel(1,8)><$emotion(1,49)>No me extraña que haya tantas máquinas bizarras por ahí."
msgstr "<$voicel(1,5)><$comeff(1,14)><$motion(1,805)>Que yo sepa, los humanos usaban muchísima electricidad...<clear><br><$voicel(1,8)><$emotion(1,49)>No me extraña que haya tantas máquinas bizarras por ahí."

#. en: <$voicel(1,5)><$comeff(1,6)><$motion(1,806)>Looks like there are even more Pokémon around here now,<br>huh? Wonder what they’re all like.
msgctxt "1968:181"
msgid "<$voicel(1,5)><$comeff(1,6)><$motion(1,806)>Qué de peña hay por aquí, ¿no? ¡Qué ganas de conocer<br>a los nuevos!"
msgstr "<$voicel(1,5)><$comeff(1,6)><$motion(1,806)>Cuánta gente hay por aquí, ¿no? ¡Qué ganas de conocer<br>a los nuevos!"

#. en: <$voicel(1,5)><$emotion(1,14)>Oh... <$cdef(27)><pname;0></color>, right? How’s it goin’?
msgctxt "1968:182"
msgid "<oneline><$voicel(1,5)><$emotion(1,14)>Tú eras <$cdef(27)><pname;0></color>, ¿no?<br>¿Qué tal, herman<gen;-2(o,a)>?"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,8)>Aw yeah, this sunny weather feels awesome! Today’s<br>lookin’ like a good day for gettin’ stuff done!
msgctxt "1968:183"
msgid "<$voicel(1,7)><$emotion(1,8)>¡Cómo me motiva este tiempazo, com<gen;-2(padre,adre)>!"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,49)>Nice weather, huh? I think today I might go for an even<br>longer walk than usual!
msgctxt "1968:184"
msgid "<$voicel(1,7)><$emotion(1,49)>¡Qué buen día! ¡Voy a patearme la zona más que nunca!"
msgstr "<$voicel(1,7)><$emotion(1,49)>¡Qué buen día! ¡Voy a recorrer la zona más que nunca!"

#. en: <$voicel(1,5)><$emotion(1,13)>Y’know how the moon’s always moving just a little bit,<br>even though it’s night? It should get some rest instead!
msgctxt "1968:185"
msgid "<$voicel(1,5)><$emotion(1,13)>La luna se mueve poco a poco, sin importar la hora...<br>¿Por qué no se va a dormir como hacemos todos?"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,8)>Nothing beats rainy days, am I right? <$pkcry;0(1,2)>! ♪
msgctxt "1968:186"
msgid "<$voicel(1,7)><$emotion(1,8)>♪¡<$pkcry;0(1,2)>!♪ ¡No hay nada mejor que la lluvia!"
msgstr ""

#. en: <$voicel(1,3)><$emotion(1,45)>Ugh, great, it’s raining. Looks like I won’t be going out<br>much today...
msgctxt "1968:187"
msgid "<$voicel(1,3)><$emotion(1,45)>¿Está lloviendo? Pues ya me he quedao sin paseo..."
msgstr "<$voicel(1,3)><$emotion(1,45)>¿Está lloviendo? Pues ya me quedé sin paseo..."

#. en: <$voicel(1,5)><$emotion(1,14)>Yeesh, it’s super cloudy today. Think it’ll rain<br>or something?
msgctxt "1968:188"
msgid "<$voicel(1,5)><$emotion(1,14)>¡Está nubladísimo! ¿Crees que va a llover?"
msgstr ""

#. en: <$voicel(1,5)><$emotion(1,55)>Y’know, <$cdef(27)>Professor Tangrowth</color> seems pretty smart, but I bet<br>that’s not all they’ve got going on... <$voicel(1,8)><$emotion(1,49)>They’re probably super<slide><br>strong too!
msgctxt "1968:189"
msgid "<$voicel(1,5)><$emotion(1,55)>El <$cdef(27)>Profesor Tangrowth</color> tiene pinta de ser superlisto,<br>pero eso no es todo...<clear><br><$voicel(1,8)><$emotion(1,49)>¡Me da que también es mazo fuerte!"
msgstr "<$voicel(1,5)><$emotion(1,55)>El <$cdef(27)>Profesor Tangrowth</color> parece ser superlisto,<br>pero eso no es todo...<clear><br><$voicel(1,8)><$emotion(1,49)>¡Me parece que también es superfuerte!"

#. en: <$voicel(1,9)><$comeff(1,10)><$motion(1,806)><$facial(1,4)><$pkcry;0(1,1)>! I’ll tidy this place up in no time!
msgctxt "1968:190"
msgid "<$voicel(1,9)><$comeff(1,10)><$motion(1,806)><$facial(1,4)>¡<$pkcry;0(1,1)>! ¡Yo me encargo! ¡No va a quedar ni<br>un escombro!"
msgstr ""

#. en: <$voicel(1,8)><$comeff(1,9)><$motion(1,806)><$facial(1,4)>I’m gonna cook up the best thing you ever tasted!
msgctxt "1968:191"
msgid "<$voicel(1,8)><$comeff(1,9)><$motion(1,806)><$facial(1,4)>¡Vas a ver! ¡Va a quedar de rechupete!"
msgstr "<$voicel(1,8)><$comeff(1,9)><$motion(1,806)><$facial(1,4)>¡Vas a ver! ¡Va a quedar de maravilla!"

#. en: <oneline><$voicel(1,5)><$comeff(1,6)><$motion(1,666)>What’s up, <$cdef(27)><pname;0></color>? Don’t worry, I’m<br>right<slide><br>here<slide><br>with ya!
msgctxt "1968:192"
msgid "<oneline><$voicel(1,5)><$comeff(1,6)><$motion(1,666)>¿Qué pasa, <$cdef(27)><pname;0></color>? ¡Tranqui, que te<br>voy siguiendo!"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,38)>Y’know what’d be great? If we found something tasty lyin’<br>around here. Ha!
msgctxt "1968:193"
msgid "<$voicel(1,7)><$emotion(1,38)>¡Ya se te podía caer algo rico de la Bolsa para comérmelo<br>yo! Jua, jua."
msgstr "<$voicel(1,7)><$emotion(1,38)>¡Ojalá se te cayera algo rico de la Bolsa para comérmelo<br>yo! Jua, jua."

#. en: <$voicel(1,10)><$emotion(1,8)>Let’s go, go, go!
msgctxt "1968:194"
msgid "<$voicel(1,10)><$emotion(1,8)>¡Vamos, que nos vamos, <gen;-2(chaval,chavala)>!"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,14)>Aw, look who it is! What’s up, roomie? You wanna chat?
msgctxt "1968:195"
msgid "<oneline><$voicel(1,7)><$emotion(1,14)>Jua, qué bien te caigo, ¿eh, <$cdef(27)><pname;0></color>?<br>¡Hasta en nuestra keli estás pendiente de mí!"
msgstr "<oneline><$voicel(1,7)><$emotion(1,14)>Jua, qué bien te caigo, ¿eh, <$cdef(27)><pname;0></color>?<br>¡Hasta en nuestra casa estás pendiente de mí!"

#. en: <$voicel(1,5)><$comeff(1,14)><$motion(1,805)>Sometimes I spot feathers I can’t identify on the ground.<br>You know the ones?<clear><br><$voicel(1,7)><$emotion(1,38)>They’ve gotta belong to a super massive Pokémon!
msgctxt "1968:196"
msgid "<$voicel(1,5)><$comeff(1,14)><$motion(1,805)>¡De vez en cuando, caen unas plumas muy raras del cielo!<clear><br><$voicel(1,7)><$emotion(1,38)>Fliparías si las vieras, <gen;-2(bro,sis)>. ¡Fijo que son de un Pokémon<br>enorme!"
msgstr "<$voicel(1,5)><$comeff(1,14)><$motion(1,805)>¡De vez en cuando, caen unas plumas muy raras del cielo!<clear><br><$voicel(1,7)><$emotion(1,38)>Alucinarías si las vieras, <gen;-2(bro,sis)>. ¡Seguro que son<br>de un Pokémon enorme!"

#. en: <$voicel(1,9)><$comeff(1,13)><$motion(1,806)><$facial(1,4)><$pkcry;0(1,1)>! ♪ <$pkcry;1(1,2)>! ♪<clear><br>Singin’ really helps me forget about all my troubles! ♪ <wait(1.0)><br><$voicel(1,8)><$motion(1,801)>Not that I’ve got that many troubles to begin with. Ha! ♪
msgctxt "1968:197"
msgid "<$voicel(1,9)><$comeff(1,13)><$motion(1,806)><$facial(1,4)>♪<$pkcry;0(1,1)>... <flow><$pkcry;1(1,2)>...♪<clear><br>♪¡Cantando todo el día me lleno de alegría!♪<br><$voicel(1,8)><$motion(1,801)>♪¡Aunque quien aquí habita, no conoce la desdicha!♪"
msgstr ""

#. en: <$voicel(1,9)><$comeff(1,5)><$motionoff(1,804)>I’m gonna train super hard and get WAY stronger! You<br>better cheer me on, <$cdef(27)><pname;0></color>!
msgctxt "1968:198"
msgid "<oneline><$voicel(1,9)><$comeff(1,5)><$motionoff(1,804)>¡Voy a entrenar a tope para ponerme aún más fuerte,<br>ya lo verás!<clear><br>¡Cuento contigo para jalearme y darme ánimos,<br><$cdef(27)><pname;0></color>!"
msgstr "<oneline><$voicel(1,9)><$comeff(1,5)><$motionoff(1,804)>¡Voy a entrenar con todo para ponerme aún más fuerte,<br>ya lo verás!<clear><br>¡Cuento contigo para apoyarme y darme ánimos,<br><$cdef(27)><pname;0></color>!"

#. en: <$voicel(1,8)><$comeff(1,9)><$facial(1,4)>Hee hee heeeeee!<clear><br><$voicel(1,9)><$emotion(1,49)>My face sometimes freaks folks out, so today I decided to<br>serve up some smiles!
msgctxt "1968:200"
msgid "<$voicel(1,8)><$comeff(1,9)><$facial(1,4)>¡Te regalo una sonrisa!<clear><br><$voicel(1,9)><$emotion(1,49)>Los hay que dicen que tengo cara de pocos amigos,<br>¡pero eso es que no me han visto sonreír así!"
msgstr "<$voicel(1,8)><$comeff(1,9)><$facial(1,4)>¡Te regalo una sonrisa!<clear><br><$voicel(1,9)><$emotion(1,49)>Hay quienes dicen que tengo cara de pocos amigos,<br>¡pero es que no me han visto sonreír así!"

#. en: <oneline><$voicel(1,7)><$emotion(1,14)>Got <$cdef(27)><nquestinum;1> <class><nquestitem;0></color>?
msgctxt "1968:201"
msgid "<oneline><$voicel(1,7)><$emotion(1,14)>Necesito <$cdef(27)><nquestinum;1></color><br><$cdef(27)><class><nquestitem;0></color>.<slide><br>¿Me <genqty;0(lo,la,los,las)> traes, porfa? Va, pórtate."
msgstr "<oneline><$voicel(1,7)><$emotion(1,14)>Necesito <$cdef(27)><nquestinum;1></color><br><$cdef(27)><class><nquestitem;0></color>.<slide><br>¿Me <genqty;0(lo,la,los,las)> traes, porfa? ¡Te lo pido!"

#. en: <$voicel(1,8)><$emotion(1,49)>Aw yeah! Thanks, pal—this is a huge help!
msgctxt "1968:202"
msgid "<$voicel(1,8)><$emotion(1,49)>Uf, justo lo que necesitaba. Gracias, <gen;-2(bro,sis)>."
msgstr ""

#. en: <$voicel(1,5)><$comeff(1,14)><$motion(1,805)>I’m interested in places like this. I’d like to see one at<br>least once, y’know?
msgctxt "1968:203"
msgid "<$voicel(1,5)><$comeff(1,14)><$motion(1,805)>Me fliparía poder ver un sitio como este algún día..."
msgstr "<$voicel(1,5)><$comeff(1,14)><$motion(1,805)>Me encantaría poder ver un lugar como este algún día..."

#. en: <$voicel(1,7)><$emotion(1,38)>You made it? For real?! Wow, you just made my day!<br>Thanks a bunch, <$cdef(27)><pname;0></color>!
msgctxt "1968:204"
msgid "<oneline><$voicel(1,7)><$emotion(1,38)>¡Ostras, lo has hecho realidad! ¡Te sales,<br><$cdef(27)><pname;0></color>!"
msgstr "<oneline><$voicel(1,7)><$emotion(1,38)>¡Rayos, lo hiciste realidad! ¡Eres genial,<br><$cdef(27)><pname;0></color>!"

#. en: <$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,8)>Any chance you can help clear a path for me?
msgctxt "1968:205"
msgid "<$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,8)>¿Me podrías hacer un camino por el que se pueda...<br>caminar? Jua, jua."
msgstr ""

#. en: <$comeff(1,9)><$facial(1,1)><$motion(1,806)><$voicel(1,8)>Ayyy, I made it!<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>I couldn’t have done it without that sweet path you<br>made, <$cdef(27)><pname;0></color>!
msgctxt "1968:206"
msgid "<$comeff(1,9)><$facial(1,1)><$motion(1,806)><$voicel(1,8)>¡Ya está aquí <gen;-3(el,la)> mendaaa!<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Menos mal que has despejado el camino, ¡que si no...!"
msgstr "<$comeff(1,9)><$facial(1,1)><$motion(1,806)><$voicel(1,8)>¡Ya está aquí <gen;-3(el,la)> craaack!<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Menos mal que despejaste el camino, ¡que si no...!"

#. en: <$voicel(1,7)><$emotion(1,14)>Oh, hey, you already have what I wanted! Wanna be a pal<br>and hook me up?
msgctxt "1968:209"
msgid "<$voicel(1,7)><$emotion(1,14)>¡No me digas que ya tienes lo que quiero! Pues de lujo,<br><gen;-2(bro,sis)>. ¿Me lo puedes dar?"
msgstr ""

#. en: <$voicel(1,5)><$emotion(1,14)>Oh, OK. Just come find me if you change your mind!
msgctxt "1968:210"
msgid "<$voicel(1,5)><$emotion(1,14)>¡Pues vaya! Bueno, si cambias de idea, ¡me avisas!"
msgstr "<$voicel(1,5)><$emotion(1,14)>¡Qué lástima! Bueno, si cambias de idea, ¡me avisas!"

#. en: <oneline><$voicel(1,7)><$emotion(1,14)>Do you know where <$cdef(27)><nquestappk;0></color>’s at? Any chance<br>you<slide><br>could<slide><br>take<slide><br>me there?
msgctxt "1968:212"
msgid "<oneline><$voicel(1,7)><$emotion(1,14)>¿Sabes dónde anda <dart;0()><$cdef(27)><nquestappk;0></color>?<br>Me harías<slide><br>un favorazo si me llevas allí."
msgstr "<oneline><$voicel(1,7)><$emotion(1,14)>¿Sabes dónde anda <dart;0()><$cdef(27)><nquestappk;0></color>?<br>Me harías<slide><br>un favorazo si me llevas allá."

#. en: <$voicel(1,7)><$emotion(1,8)>Ayyy, look who it is! Thanks for bringin’ us together, pal!
msgctxt "1968:213"
msgid "<$voicel(1,7)><$emotion(1,8)>¡Por fin nos hemos podido encontrar! Gracias a ti."
msgstr "<$voicel(1,7)><$emotion(1,8)>¡Por fin pudimos encontrarnos! Gracias a ti."

#. en: <$voicel(1,7)><$emotion(1,49)>You know who’s lookin’ good today? <wait(0.5)>Us! Let’s snap a photo<br>together so we’ll always remember how cool we are!
msgctxt "1968:214"
msgid "<$voicel(1,7)><$emotion(1,49)>Tú y yo desbordamos carisma, ¡así que estaría guay<br>inmortalizarlo con una foto!"
msgstr "<$voicel(1,7)><$emotion(1,49)>Tú y yo desbordamos carisma, ¡así que estaría genial<br>inmortalizarlo con una foto!"

#. en: <$voicel(1,7)><$emotion(1,39)>Oh, is this our photo? Dang, we look even cooler than I<br>thought! <$voicel(1,6)><$emotion(1,50)>Thanks a bunch, <$cdef(27)><pname;0></color>.
msgctxt "1968:215"
msgid "<$voicel(1,7)><$emotion(1,39)>¡Fua! ¿Habrá Pokémon más fotogénicos que nosotros?<clear><br><$voicel(1,6)><$emotion(1,50)>¡Salimos genial! Gracias, <$cdef(27)><pname;0></color>."
msgstr "<$voicel(1,7)><$emotion(1,39)>¡Guau! ¿Habrá Pokémon más fotogénicos que nosotros?<clear><br><$voicel(1,6)><$emotion(1,50)>¡Salimos genial! Gracias, <$cdef(27)><pname;0></color>."

#. en: <$comeff(1,3)><$motion(1,803)><$voicel(1,5)>Huh? Looks like <$cdef(27)><nquestappk;0></color>’s right over there...
msgctxt "1968:217"
msgid "<$comeff(1,3)><$motion(1,803)><$voicel(1,5)>¡Uala, pero si ya está ahí <dart;0()><$cdef(27)><nquestappk;0></color>!"
msgstr "<$comeff(1,3)><$motion(1,803)><$voicel(1,5)>¡Guau, pero si ya está ahí <dart;0()><$cdef(27)><nquestappk;0></color>!"

#. en: <$voicel(1,5)><$comeff(1,6)><$motion(1,666)>Hey, hey. You got a minute? There’s somethin’ I need your<br>help with, <$cdef(27)><pname;0></color>!
msgctxt "1968:224"
msgid "<$voicel(1,5)><$motion(1,666)>Ey, herman<gen;-2(o,a)>, <$comeff(1,6)>¿tienes un momento? ¡Tengo que pedirte<br>un favor!"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,49)>Aw, too bad! Maybe next time, yeah?
msgctxt "1968:225"
msgid "<$voicel(1,7)><$emotion(1,49)>¡Qué le vamos a hacer! ¡Otra vez será!"
msgstr ""

#. en: <oneline><$voicel(1,7)><$comeff(1,21)><$motion(1,805)><$facial(1,5)>I want <iart;0()><$cdef(27)><fqty(1)><class><nquestitem;0></color><br>SO<slide><br>bad... <slide><br>Could<slide><br>you<slide><br>put<slide><br>one<slide><br>where<slide><br>I live?
msgctxt "1968:226"
msgid "<oneline><$voicel(1,7)><$comeff(1,21)><$motion(1,805)><$facial(1,5)>Me muero por tener<br><iart;0()><fqty(1)><$cdef(27)><class><nquestitem;0></color>.<clear><br>Te pongo un altar si me traes <genqty;0(uno,una,unos,unas)> a mi keli."
msgstr "<oneline><$voicel(1,7)><$comeff(1,21)><$motion(1,805)><$facial(1,5)>Me muero por tener<br><iart;0()><fqty(1)><$cdef(27)><class><nquestitem;0></color>.<clear><br>Te pongo un altar si me traes <genqty;0(uno,una,unos,unas)> a mi casa."

#. en: <$voicel(1,7)><$emotion(1,8)>Wow, you got one for me? That’s awesome! You’re the<br>best, <$cdef(27)><pname;0></color>!
msgctxt "1968:227"
msgid "<oneline><$voicel(1,7)><$emotion(1,8)>¡Has cumplido! ¡Eres la leche, <$cdef(27)><pname;0></color>!<br>Gracias."
msgstr "<oneline><$voicel(1,7)><$emotion(1,8)>¡Cumpliste! ¡Eres lo máximo, <$cdef(27)><pname;0></color>!<br>Gracias."

#. en: <$voicel(1,9)><$comeff(1,5)><$motion(1,805)><$facial(1,4)>Huh? No way—you made it already?!
msgctxt "1968:232"
msgid "<$voicel(1,9)><$comeff(1,5)><$motion(1,805)><$facial(1,4)>¿Cómo? ¡¿Que ya lo has hecho?!"
msgstr "<$voicel(1,9)><$comeff(1,5)><$motion(1,805)><$facial(1,4)>¿Cómo? ¡¿Que ya lo hiciste?!"

#. en: <$voicel(1,10)><$comeff(1,5)><$motion(1,805)><$facial(1,4)>No way—you already put it out for me?!
msgctxt "1968:233"
msgid "<$voicel(1,10)><$comeff(1,5)><$motion(1,805)><$facial(1,4)>¿En serio, <gen;-2(bro,sis)>? ¿Ya me has colocado eso?"
msgstr "<$voicel(1,10)><$comeff(1,5)><$motion(1,805)><$facial(1,4)>¿En serio, <gen;-2(bro,sis)>? ¿Ya me colocaste eso?"

#. en: <$voicel(1,9)><$comeff(1,5)><$motion(1,805)><$facial(1,4)>Huh? Don’t tell me you already took care of it?!
msgctxt "1968:234"
msgid "<$voicel(1,9)><$comeff(1,5)><$motion(1,805)><$facial(1,4)>¿Eh? Venga ya, cómo te sales, <gen;-2(bro,sis)>... ¡Solo tú eres capaz<br>de conseguirme lo que quiero antes de pedírtelo!"
msgstr "<$voicel(1,9)><$comeff(1,5)><$motion(1,805)><$facial(1,4)>¿Eh? En serio, eres genial, <gen;-2(bro,sis)>... ¡Solo tú eres capaz<br>de conseguirme lo que quiero antes de pedírtelo!"

#. en: <$voicel(1,7)><$emotion(1,14)>Hey, it’s <$cdef(27)><pname;0></color>! You got a sec?<clear><br>Thing is, <$voicel(1,6)><$emotion(1,8)>some folks just agreed to help me with somethin’.<br><$voicel(1,4)><$emotion(1,29)>You wanna get in on the fun too?
msgctxt "1968:235"
msgid "<$cdef(27)><$voicel(1,7)></color><$emotion(1,14)>¡Pero si eres tú, <gen;-2(bro,sis)>! Pues mira, justo ahora les estaba<br>comentando una cosilla al resto.<clear><br><$voicel(1,6)><$emotion(1,8)>Os tengo que pedir un favor, pero de los grandes, ¿eh?<br><$voicel(1,4)><$emotion(1,29)>¿Crees que podrías echarme un cable?"
msgstr "<$cdef(27)><$voicel(1,7)></color><$emotion(1,14)>¡Pero si eres tú, <gen;-2(bro,sis)>! Pues mira, justo ahora les estaba<br>comentando una cosita al resto.<clear><br><$voicel(1,6)><$emotion(1,8)>Les tengo que pedir un favor, pero de los grandes, ¿eh?<br><$voicel(1,4)><$emotion(1,29)>¿Crees que podrías echarme una mano?"

#. en: <$voicel(1,5)><$emotion(1,14)>Oh yeah—remember that thing folks were helpin’ me with?<br><$voicel(1,8)><$emotion(1,8)>It’s all taken care of!<clear><br><$voicel(1,6)><$emotion(1,49)>Next time I need help, I’m comin’ to you!
msgctxt "1968:236"
msgid "<$voicel(1,5)><$emotion(1,14)>Por cierto, aquel favor enorme que os había pedido...<br><$voicel(1,8)><$emotion(1,8)>resulta que ya está solucionado.<clear><br><$voicel(1,6)><$emotion(1,49)>Gracias, mi pana. Si necesito que me vuelvas a echar<br>una mano, te doy un toque."
msgstr "<$voicel(1,5)><$emotion(1,14)>Por cierto, aquel favor enorme que les había pedido...<br><$voicel(1,8)><$emotion(1,8)>resulta que ya está solucionado.<clear><br><$voicel(1,6)><$emotion(1,49)>Gracias, compa. Si necesito que me vuelvas a echar<br>una mano, te aviso."

#. en: <$emotion(1,29)><$voicel(1,5)>Think you could build a new house? <wait(0.3)>I feel like we need<br>more houses <$emotion(1,8)><$voicel(1,8)>to liven things up around here!
msgctxt "1968:237"
msgid "<$emotion(1,29)><$voicel(1,5)>¡Me fliparía que construyeses alguna casa humana nueva,<br><gen;-2(bro,sis)>! <wait(1.0)><$emotion(1,8)><$voicel(1,8)>Buah, nos alegraría el día a todos que no veas."
msgstr "<$emotion(1,29)><$voicel(1,5)>¡Me encantaría que construyeras alguna casa humana nueva,<br><gen;-2(bro,sis)>! <wait(1.0)><$emotion(1,8)><$voicel(1,8)>Guau, nos alegraría el día a todos un montón."

#. en: <$comeff(1,9)><$motion(1,801)><$voicel(1,7)>Dang, you really built me a house? You rock! Thanks for<br>doin’ that, <$cdef(27)><pname;0></color>!
msgctxt "1968:238"
msgid "<$comeff(1,9)><$motion(1,801)><$voicel(1,7)>¡Gracias por construir una keli, <$cdef(27)><pname;0></color>!"
msgstr "<$comeff(1,9)><$motion(1,801)><$voicel(1,7)>¡Gracias por construir una casa, <$cdef(27)><pname;0></color>!"

#. en: <oneline><$comeff(1,10)><$motion(1,803)><$voicel(1,5)>I’ve got a craving for<br><iart;0()><$cdef(27)><class><nquestitem;0></color>.<slide><br><$comeff(1,6)><$motion(1,666)><$voicel(1,8)>If<slide><br>ya<slide><br>have<slide><br>any<slide><br>to<slide><br>spare,<slide><br>wanna share?
msgctxt "1968:239"
msgid "<oneline><$comeff(1,10)><$motion(1,803)><$voicel(1,5)>Buah, se me <qty;0(ha,han)> antojado<br><iart;0()><$cdef(27)><fqty(1)><class><nquestitem;0></color><slide><br>de repente.<clear><br><$motion(1,666)><$voicel(1,8)>Si tienes de sobra, <$comeff(1,6)>¿compartes conmigo?"
msgstr "<oneline><$comeff(1,10)><$motion(1,803)><$voicel(1,5)>Uf, se me <qty;0(ha,han)> antojado<br><iart;0()><$cdef(27)><fqty(1)><class><nquestitem;0></color><slide><br>de repente.<clear><br><$motion(1,666)><$voicel(1,8)>Si tienes de sobra, <$comeff(1,6)>¿compartes conmigo?"

#. en: <oneline><$comeff(1,10)><$facial(1,4)><$motion(1,661)><$voicel(1,7)>Aw yeah! I knew you’d come through,<br><$cdef(27)><pname;0></color>!<slide><br>Thanks<slide><br>for sharing!
msgctxt "1968:240"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,661)><$voicel(1,7)>¡Ya sabía yo que podía contar con mi com<gen;-2(padre,adre)>!"
msgstr ""

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,661)><$voicel(1,5)>Whoops, my bad! Next time I’ll make sure to check the<br>area before askin’ for help.<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,8)>I’ll let ya know if anything else comes up!
msgctxt "1968:241"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,661)><$voicel(1,5)>¡Perdona, que no me he dado cuenta! <$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,8)>La próxima vez<br>miraré bien antes de ponerme a pedir favores por ahí."
msgstr "<$comeff(1,10)><$facial(1,4)><$motion(1,661)><$voicel(1,5)>¡Perdón, no me di cuenta! <$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,8)>La próxima vez<br>miraré bien antes de ponerme a pedir favores por ahí."

#. en: <$comeff(1,9)><$motion(1,801)><$voicel(1,9)>Dang, you must know me pretty well, huh? Thanks a<br>ton, <$cdef(27)><pname;1></color>.
msgctxt "1968:242"
msgid "<oneline><$comeff(1,9)><$motion(1,801)><$voicel(1,9)>¡Qué bien me conoces! ¡Gracias,<br><$cdef(27)><pname;1></color>!"
msgstr ""

#. en: <$comeff(1,3)><$facial(1,1)><$motion(1,666)><$voicel(1,6)>Hey, you’ve got some already! Wanna be a pal and hook<br>me up? It’d really help me out!
msgctxt "1968:243"
msgid "<$comeff(1,3)><$facial(1,1)><$motion(1,666)><$voicel(1,6)>¡Uala, pero si ya tienes! ¿No me podrás dar una<br>porcioncilla?"
msgstr "<$comeff(1,3)><$facial(1,1)><$motion(1,666)><$voicel(1,6)>¡Guau, pero si ya tienes! ¿No me podrás dar una<br>porcioncita?"

#. en: <oneline><$comeff(1,10)><$facial(1,4)><$motion(1,661)><$voicel(1,7)>Aw yeah! I knew you’d come through,<br><$cdef(27)><pname;0></color>!<slide><br>Thanks<slide><br>for sharing!
msgctxt "1968:244"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,661)><$voicel(1,7)>¡Muchas gracias, eres <gen;-2(el,la)> mejor!"
msgstr ""

#. en: <$voicel(1,5)><$emotion(1,14)>Yo, <$cdef(27)><pname;0></color>. Here’s a little gift for ya.<clear><br><$voicel(1,8)><$emotion(1,38)>Thanks for always helpin’ me out!
msgctxt "1968:301"
msgid "<oneline><$voicel(1,5)><$emotion(1,14)>¡Buenas, <$cdef(27)><pname;0></color>! Toma esto,<$voicel(1,8)><$emotion(1,38)> es un<br>regalillo.<slide><br>Gracias por prestarte a ayudar siempre. Jua, jua."
msgstr "<oneline><$voicel(1,5)><$emotion(1,14)>¡Buenas, <$cdef(27)><pname;0></color>! Toma esto,<$voicel(1,8)><$emotion(1,38)> es un<br>regalito.<slide><br>Gracias por prestarte a ayudar siempre. Jua, jua."

#. en: <$comeff(1,14)><$facial(1,1)><$motion(1,805)><$voicel(1,3)>Aren’t there enough Pokémon walkin’ with ya already?<br>I’m gonna have to pass, pal.
msgctxt "1968:302"
msgid "<$comeff(1,14)><$facial(1,1)><$motion(1,805)><$voicel(1,3)>¿Pero a cuántos has invitado al paseo? ¡Ni que fueseis a<br>hacer la conga! Casi que mejor lo dejo pa la próxima."
msgstr "<$comeff(1,14)><$facial(1,1)><$motion(1,805)><$voicel(1,3)>¿Pero a cuántos invitaste al paseo? ¡Ni que fueran a<br>hacer la conga! Casi que mejor lo dejo pa la próxima."

#. en: <$comeff(1,4)><$motion(1,807)><$voicel(1,6)>Sorry, pal, but I gotta pass! Maybe later?
msgctxt "1968:303"
msgid "<$comeff(1,4)><$motion(1,807)><$voicel(1,6)>Perdona, pana, ahora no puedo. ¿Hablamos luego?"
msgstr "<$comeff(1,4)><$motion(1,807)><$voicel(1,6)>Perdón, compa, ahora no puedo. ¿Hablamos luego?"

#. en: <$voicel(1,7)><$emotion(1,1)><$pkcry;0(1,2)>! We’re gettin’ there, bit by bit!
msgctxt "1968:304"
msgid "<oneline><$voicel(1,7)><$emotion(1,1)>Sin prisa pero sin pausa, <flow><$pkcry;0(1,2)>.<br>¡Qué bien va la cosa!"
msgstr ""

#. en: <$voicel(1,8)><$emotion(1,1)>Aw yeah, let’s go!
msgctxt "1968:305"
msgid "<$voicel(1,8)><$emotion(1,1)>¡Contigo adonde quieras, <gen;-2(compadre,comadre)>!"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,14)>Oh, are we done? OK—later, pal!
msgctxt "1968:306"
msgid "<$voicel(1,7)><$emotion(1,14)>¡Pues se acabó la fiesta! ¡Chao, pescao!"
msgstr ""

#. en: <$voicel(1,3)><$comeff(1,7)><$motion(1,807)><$facial(1,9)>As much as I wanna tag along with ya, I’m ridiculously<br>hungry right now...
msgctxt "1968:307"
msgid "<$voicel(1,3)><$comeff(1,7)><$motion(1,807)><$facial(1,9)>Si por mí fuera, pana, te seguiría al fin del mundo, pero<br>es que... ¡con la panza vacía no hay quien camine!"
msgstr "<$voicel(1,3)><$comeff(1,7)><$motion(1,807)><$facial(1,9)>Si por mí fuera, compa, te seguiría al fin del mundo, pero<br>es que... ¡con la panza vacía no hay quien camine!"

#. en: <$voicel(1,7)><$comeff(1,7)><$motion(1,807)><$facial(1,9)>Oof, I gotta stop, pal. I can’t even move, I’m so hungry...
msgctxt "1968:308"
msgid "<$voicel(1,7)><$comeff(1,7)><$motion(1,807)><$facial(1,9)>¡Buah, no puedo más! ¡Tengo tanta hambre que me voy a<br>caer redond<gen;-3(o,a)>!"
msgstr "<$voicel(1,7)><$comeff(1,7)><$motion(1,807)><$facial(1,9)>¡Uf, no puedo más! ¡Tengo tanta hambre que me voy a<br>caer redond<gen;-3(o,a)>!"

#. en: <$voicel(1,6)><$comeff(1,14)><$motion(1,806)>Yeesh, when’s this rain gonna stop?
msgctxt "1968:311"
msgid "<$voicel(1,6)><$comeff(1,14)><$motion(1,806)>Buah, ya podía dejar de llover, ¿eh?"
msgstr "<$voicel(1,6)><$comeff(1,14)><$motion(1,806)>Uf, ojalá dejara de llover, ¿eh?"

#. en: <$voicel(1,7)><$comeff(1,7)><$motion(1,803)><$facial(1,13)>OW! Hey! Watch it, will ya?
msgctxt "1968:315"
msgid "<$voicel(1,7)><$comeff(1,7)><$motion(1,803)><$facial(1,13)>¡Ay, qué dañooo! Cómo te pasas, ¿no?"
msgstr "<$voicel(1,7)><$comeff(1,7)><$motion(1,803)><$facial(1,13)>¡Ay, qué dañooo! Te pasaste, ¿no?"

#. en: <oneline><$voicel(1,7)><$emotion(1,14)>Dang, this is one nice-lookin’<br><$cdef(27)><fqty(1)><class><aireactp;0></color>...<clear><br><$voicel(1,5)><$comeff(1,7)><$motion(1,666)>But it’s kinda far away. Think you could move it closer to<br>my place? Sorry for the trouble, pal!
msgctxt "1968:317"
msgid "<$voicel(1,7)><$emotion(1,14)>¡Me flip<qty;0(a,an)> est<genqty;0(e,a,os,as)> <$cdef(27)><fqty(1)><aireactp;0></color>!<clear><br><$voicel(1,5)><$comeff(1,7)><$motion(1,666)>Aunque... eh... est<qty;0(á,án)> un tanto lejos. Oye, ¿me harías<br>el favor de ponerl<genqty;0(o,a,os,as)> en mi keli?"
msgstr "<$voicel(1,7)><$emotion(1,14)>¡Me encant<qty;0(a,an)> est<genqty;0(e,a,os,as)> <$cdef(27)><fqty(1)><aireactp;0></color>!<clear><br><$voicel(1,5)><$comeff(1,7)><$motion(1,666)>Aunque... eh... est<qty;0(á,án)> un tanto lejos. Oye, ¿me harías<br>el favor de ponerl<genqty;0(o,a,os,as)> en mi casa?"

#. en: <oneline><$voicel(1,7)><$emotion(1,1)>Is that <iart;0()><$cdef(27)><fqty(1)><class><aireactp;0></color>?<br>Did<slide><br>you<slide><br>put<slide><br>it<slide><br>here?<slide><br>Thanks,<slide><br>pal—you<slide><br>just<slide><br>made<slide><br>my day!
msgctxt "1968:318"
msgid "<oneline><$voicel(1,7)><$emotion(1,1)>¡Qué ilusión, muchas gracias por traerme<br><iart;0()><$cdef(27)><fqty(1)><class><aireactp;0></color>!"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,8)>Aw yeah, that feels GREAT! <$pkcry;0(1,2)>! ♪
msgctxt "1968:319"
msgid "<$voicel(1,7)><$emotion(1,8)>♪¡<$pkcry;0(1,2)>!♪ ¡Qué gustirrinín!"
msgstr "<$voicel(1,7)><$emotion(1,8)>♪¡<$pkcry;0(1,2)>!♪ ¡Qué gusto!"

#. en: <$voicel(1,3)><$comeff(1,6)><$motion(1,666)>Whoa, hey! That tickles!
msgctxt "1968:320"
msgid "<$voicel(1,3)><$comeff(1,6)><$motion(1,666)>¿Es una broma o qué? ¡Que me haces cosquillaaas!"
msgstr ""

#. en: <oneline><$voicel(1,7)><$comeff(1,4)><$motion(1,805)><$facial(1,13)>Whoa! What the heck happened to the<br><$cdef(27)><fqty(1)><class><aireactp;0></color>?<slide><br>It’s gone!
msgctxt "1968:322"
msgid "<oneline><$voicel(1,7)><$comeff(1,4)><$motion(1,805)><$facial(1,13)>¿Qué? ¡¿Quién me ha mangao<br><dart;0()><$cdef(27)><fqty(1)><aireactp;0></color>?!"
msgstr "<oneline><$voicel(1,7)><$comeff(1,4)><$motion(1,805)><$facial(1,13)>¿Qué? ¡¿Quién me robó<br><dart;0()><$cdef(27)><fqty(1)><aireactp;0></color>?!"

#. en: <$voicel(1,7)><$comeff(1,21)><$motion(1,801)><$facial(1,4)>Ahhh, feels great to get all warm and toasty like this!
msgctxt "1968:323"
msgid "<$voicel(1,7)><$comeff(1,21)><$motion(1,801)><$facial(1,4)>¡No hay nada como una keli calentita, sí, seño<gen;-2(r,ra)>!"
msgstr "<$voicel(1,7)><$comeff(1,21)><$motion(1,801)><$facial(1,4)>¡No hay nada como una casa calentita, sí, seño<gen;-2(r,ra)>!"

#. en: <$voicel(1,7)><$comeff(1,4)><$motion(1,805)><$facial(1,13)>Ooof... It’s pretty hot, but I can totally handle it.<clear><br>... ... ...<clear><br>Seriously, I can.<clear><br>... ... ...<wait(0.5)>OK, I can’t.
msgctxt "1968:324"
msgid "<$voicel(1,7)><$comeff(1,4)><$motion(1,805)><$facial(1,13)>Buah... Qué calor... Pero no me daré por vencid<gen;-3(o,a)>...<br>No me daré por... <wait(0.4)>Por favor, no puedo más."
msgstr "<$voicel(1,7)><$comeff(1,4)><$motion(1,805)><$facial(1,13)>Uf... Qué calor... Pero no me daré por vencid<gen;-3(o,a)>...<br>No me daré por... <wait(0.4)>Por favor, no puedo más."

#. en: <$voicel(1,7)><$comeff(1,21)><$motion(1,805)><$facial(1,4)>Aw yeah, it’s so nice and cool! Why don’t we chill here<br>for a while, <$cdef(27)><pname;0></color>?
msgctxt "1968:325"
msgid "<$voicel(1,7)><$comeff(1,21)><$motion(1,805)><$facial(1,4)>Buah, ¡qué bien se está con el ambiente así más fresquito!<br>Qué, ¿hacemos algo?"
msgstr "<$voicel(1,7)><$comeff(1,21)><$motion(1,805)><$facial(1,4)>Ah, ¡qué bien se está con el ambiente así más fresquito!<br>Qué, ¿hacemos algo?"

#. en: <oneline><$voicel(1,3)><$comeff(1,23)><$motion(1,807)><$cdef(27)><$facial(1,9)><pname;0></color>... Come closer... We gotta keep<br>warm...<slide><br>This<slide><br>place...<slide><br>It’s<slide><br>way<slide><br>too cold...
msgctxt "1968:326"
msgid "<oneline><$voicel(1,3)><$comeff(1,23)><$motion(1,807)><$cdef(27)><$facial(1,9)><pname;0></color>, vamos a arrejuntarnos,<br>que hace<slide><br>una rasca..."
msgstr "<oneline><$voicel(1,3)><$comeff(1,23)><$motion(1,807)><$cdef(27)><$facial(1,9)><pname;0></color>, vamos a juntarnos,<br>que hace<slide><br>un frío..."

#. en: <$voicel(1,7)><$comeff(1,1)><$motion(1,805)><$facial(1,4)>Lemme tell ya, I’m lovin’ this light! Couldn’t ask for better.
msgctxt "1968:327"
msgid "<$voicel(1,7)><$comeff(1,1)><$motion(1,805)><$facial(1,4)>Hay mazo de luz ahora, ¡me flipa!"
msgstr "<$voicel(1,7)><$comeff(1,1)><$motion(1,805)><$facial(1,4)>Hay muchísima luz ahora, ¡me encanta!"

#. en: <$voicel(1,3)><$comeff(1,7)><$motion(1,805)>I have to scrunch up my face when it’s this bright. <$facial(1,9)>It makes<br>me look like a loser...
msgctxt "1968:328"
msgid "<$voicel(1,3)><$comeff(1,7)><$motion(1,805)><$facial(1,9)>Buah, chava<gen;-2(l,la)>, me ciega esta luz. Se me va a quedar<br>la cara torcida."
msgstr "<$voicel(1,3)><$comeff(1,7)><$motion(1,805)><$facial(1,9)>Uf, chava<gen;-2(l,la)>, me ciega esta luz. Se me va a quedar<br>la cara torcida."

#. en: <$voicel(1,7)><$comeff(1,8)><$motion(1,805)><$facial(1,4)>This darker home is perfect...<wait(0.7)>for plotting pranks! Ha!
msgctxt "1968:329"
msgid "<$voicel(1,7)><$comeff(1,8)><$motion(1,805)><$facial(1,4)>Con tanta oscuridad ahora... voy a tramar de todo.<br>¡Jua, jua!"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,47)>Ugh, it’s too dark! I can’t get anythin’ done like this!
msgctxt "1968:330"
msgid "<$voicel(1,7)><$emotion(1,47)>Buah, ¡pero qué oscuro está esto! ¡Así no hay quien haga<br>nada!"
msgstr "<$voicel(1,7)><$emotion(1,47)>Uf, ¡pero qué oscuro está esto! ¡Así no hay quien haga<br>nada!"

#. en: <$voicel(1,8)><$comeff(1,21)><$motion(1,661)><$facial(1,4)>A little humidity’s not so bad, huh?
msgctxt "1968:331"
msgid "<$voicel(1,8)><$comeff(1,21)><$motion(1,661)><$facial(1,4)>¡Oye, pues se está de lujo con un poco de humedad<br>en el ambiente!"
msgstr ""

#. en: <$comeff(1,14)><$motion(1,802)><$voicel(1,7)><$facial(1,9)>Yeesh, what’s with the humidity around here? I sure wish<br>it was a little drier...
msgctxt "1968:332"
msgid "<$comeff(1,14)><$motion(1,802)><$voicel(1,7)><$facial(1,9)>Buah, menuda humedad hay por esta zona, ¿no?<br>Hasta echo de menos un poco de siroco."
msgstr "<$comeff(1,14)><$motion(1,802)><$voicel(1,7)><$facial(1,9)>Uf, cuánta humedad hay por esta zona, ¿no?<br>Hasta extraño un poco de siroco."

#. en: <$comeff(1,10)><$voicel(1,7)>Aw yeah, it’s WAY less humid around here now! <wait(1.5)><$facial(1,4)><$comeff(1,13)><$motion(1,801)><$voicel(1,10)>Was that<br>you, <$cdef(27)><pname;0></color>? Thanks, pal!
msgctxt "1968:333"
msgid "<$comeff(1,10)><$voicel(1,7)>¡Nada como un buen soplo de aire seco, <gen;-2(bro,sis)>!<br><$facial(1,4)><$comeff(1,13)><$motion(1,801)><$voicel(1,10)>¿Has tenido tú algo que ver en esto? ¡Gracias!"
msgstr "<$comeff(1,10)><$voicel(1,7)>¡Nada como un buen soplo de aire seco, <gen;-2(bro,sis)>!<br><$facial(1,4)><$comeff(1,13)><$motion(1,801)><$voicel(1,10)>¿Tuviste tú algo que ver en esto? ¡Gracias!"

#. en: <$comeff(1,14)><$motion(1,802)><$voicel(1,7)><$facial(1,9)>Yeesh, the air’s kinda dry around here, ain’t it? A little<br>more moisture wouldn’t hurt.
msgctxt "1968:334"
msgid "<$comeff(1,14)><$motion(1,802)><$voicel(1,7)><$facial(1,9)>El aire aquí está más seco que la mojama. Estaría guay<br>tener un poco más de humedad."
msgstr "<$comeff(1,14)><$motion(1,802)><$voicel(1,7)><$facial(1,9)>El aire aquí está más seco que un desierto.<br>Estaría genial tener un poco más de humedad."

#. en: <$voicel(1,5)><$comeff(1,14)><$motion(1,805)>Doesn’t look like I can make it over to see that thing you<br>put out for me, <$cdef(27)><pname;1></color>...<clear><br><$voicel(1,4)><$emotion(1,47)>I wanna check it out so bad, though!<clear><br><$voicel(1,5)><$emotion(1,14)>Sorry to put you on the spot, but could you make a path<br>for me to get there?
msgctxt "1968:335"
msgid "<$voicel(1,5)><$comeff(1,14)><$motion(1,805)>Buah, lo veo chungo pa pasar por aquí, com<gen;-2(padre,adre)>...<br><wait(0.4)><$voicel(1,4)><$emotion(1,47)>Con las ganas que tengo de ver qué has colocado...<clear><br><$voicel(1,5)><$emotion(1,14)>Oye, mira, ¿te importa hacerme un caminito para que<br>pueda pasar, así, en un pispás?"
msgstr "<$voicel(1,5)><$comeff(1,14)><$motion(1,805)>Uf, lo veo difícil pa pasar por aquí, com<gen;-2(padre,adre)>...<br><wait(0.4)><$voicel(1,4)><$emotion(1,47)>Con las ganas que tengo de ver qué has colocado...<clear><br><$voicel(1,5)><$emotion(1,14)>Oye, mira, ¿te importa hacerme un caminito para que<br>pueda pasar, así, rapidito?"

#. en: <$voicel(1,8)><$comeff(1,5)><$motion(1,806)>Aw yeah! Leave it to me, pal!
msgctxt "1968:336"
msgid "<$voicel(1,8)><$comeff(1,5)><$motion(1,806)>¡Abran paso, que voy!"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,49)>What the heck’s goin’ on over here? Let’s check it<br>out, <$cdef(27)><pname;0></color>!
msgctxt "1968:337"
msgid "<$voicel(1,7)><$emotion(1,49)>Aquí tiene que haber algo, ¿no te lo parece? ¡Venga, <gen;-2(bro,sis)>,<br>echa un vistazo!"
msgstr "<$voicel(1,7)><$emotion(1,49)>Aquí tiene que haber algo, ¿no te lo parece? ¡Vamos, <gen;-2(bro,sis)>,<br>echa un vistazo!"

#. en: <$voicel(1,7)><$comeff(1,10)><$motion(1,806)><$facial(1,4)><$pkcry;0(1,2)>! I’m knockin’ this thing down!
msgctxt "1968:338"
msgid "<oneline><$voicel(1,7)><$comeff(1,10)><$motion(1,806)><$facial(1,4)>¡<$pkcry;0(1,2)>! Aún hay mucho que tirar abajo aquí.<br>Calma, <gen;-2(compadre,comadre)>."
msgstr ""

#. en: <$voicel(1,3)><$comeff(1,14)><$motion(1,805)>Dang, that smells great! I’m gettin’ hungry...
msgctxt "1968:339"
msgid "<$voicel(1,3)><$comeff(1,14)><$motion(1,805)>El olor me está haciendo salivar que da gusto... Menuda<br>hambre tengo ya."
msgstr "<$voicel(1,3)><$comeff(1,14)><$motion(1,805)>El olor me está haciendo salivar que da gusto... Qué<br>hambre tengo ya."

#. en: <$voicel(1,8)><$emotion(1,8)><$pkcry;0(1,2)>! I’m feelin’ festive!
msgctxt "1968:340"
msgid "<$voicel(1,8)><$emotion(1,8)>¡<$pkcry;0(1,2)>! ¡Viva la fiestaaa!"
msgstr ""

#. en: <$voicel(1,6)><$comeff(1,8)><$motion(1,805)><$facial(1,14)>Ahhh... <wait(0.8)>I could stay here forever.
msgctxt "1968:341"
msgid "<$voicel(1,6)><$comeff(1,8)><$motion(1,805)><$facial(1,14)>No quiero moverme de aquí..."
msgstr ""

#. en: <oneline><$voicel(1,5)><$comeff(1,6)><$motion(1,805)>So that <$cdef(27)><fqty(1)><class><aireactp;0></color>...<br>Any<slide><br>chance<slide><br>you<slide><br>could<slide><br>move<slide><br>it<slide><br>away<slide><br>from<slide><br>the water?<clear><br><$voicel(1,8)><$emotion(1,14)>I can’t really use it where it is now. Thanks!
msgctxt "1968:343"
msgid "<oneline><$voicel(1,5)><$comeff(1,6)><$motion(1,805)>Oye, com<gen;-2(padre,adre)>, ¿no puedes poner<br><dart;0()><fqty(1)><$cdef(27)><aireactp;0></color><slide><br>en un sitio<slide><br>sin agua?<slide><br><$voicel(1,8)><$emotion(1,14)>¡Aquí va a estar chungo usar<genqty;0(lo,la,los,las)>!"
msgstr "<oneline><$voicel(1,5)><$comeff(1,6)><$motion(1,805)>Oye, com<gen;-2(padre,adre)>, ¿no puedes poner<br><dart;0()><fqty(1)><$cdef(27)><aireactp;0></color><slide><br>en un lugar<slide><br>sin agua?<slide><br><$voicel(1,8)><$emotion(1,14)>¡Aquí va a estar difícil usar<genqty;0(lo,la,los,las)>!"

#. en: <$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>It’s wild how much nicer the area around my place is.<br><$pkcry;0(1,2)>! You’re seriously the best!
msgctxt "1968:344"
msgid "<$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡<$pkcry;0(1,2)>! Buah, mi keli ha quedado brutal.<br>¡Muchas gracias, eh!"
msgstr "<$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡<$pkcry;0(1,2)>! Guau, mi casa quedó brutal.<br>¡Muchas gracias, eh!"

#. en: <$comeff(1,3)><$facial(1,1)><$motion(1,805)><$voicel(1,7)>The area around my home’s gettin’ real nice! Just a little<br>more and it’ll be perfect.
msgctxt "1968:345"
msgid "<$comeff(1,3)><$facial(1,1)><$motion(1,805)><$voicel(1,7)>¡Uala, qué guapa me estás dejando la keli! Un poco más<br>y la dejas níquel."
msgstr "<$comeff(1,3)><$facial(1,1)><$motion(1,805)><$voicel(1,7)>¡Guau, qué bonita me estás dejando la casa! Un poco más<br>y la dejas impecable."

#. en: <$comeff(1,6)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>Wanna do something fun, <$cdef(27)><pname;0></color>?<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>Then grab your<$cdef(27)> <fqty(1)><$ifull(2793)> </color>and let’s go find<br>some treasure!
msgctxt "1968:400"
msgid "<$comeff(1,6)><$facial(1,1)><$motion(1,666)><$voicel(1,5)><$cdef(27)><pname;0></color>, ¿te apetece jugar un rato?<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>¡Saca el <$cdef(27)><fqty(1)><$ifull(2793)></color> y vamos a buscar tesoros!"
msgstr "<$comeff(1,6)><$facial(1,1)><$motion(1,666)><$voicel(1,5)><$cdef(27)><pname;0></color>, ¿quieres jugar un rato?<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>¡Saca el <$cdef(27)><fqty(1)><$ifull(2793)></color> y vamos a buscar tesoros!"

#. en: <$cdef(27)><$voicel(1,7)><$comeff(1,6)><$motion(1,803)><pname;0></color>! You got that path ready?
msgctxt "1968:402"
msgid "<$voicel(1,7)><$comeff(1,6)><$motion(1,803)>¡<$cdef(27)><pname;0></color>! ¿Ya está el camino?"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,38)>Ha! I knew you’d say that. OK, let’s go!
msgctxt "1968:403"
msgid "<$voicel(1,7)><$emotion(1,38)>¡No esperaba menos! ¡Pues arreando, que es gerundio!"
msgstr "<$voicel(1,7)><$emotion(1,38)>¡No esperaba menos! ¡Pues vámonos, que se hace tarde!"

#. en: <$voicel(1,7)><$emotion(1,14)>No prob! Take your time.
msgctxt "1968:404"
msgid "<$voicel(1,7)><$emotion(1,14)>A este paso me saldrán telarañas. Pues nada, ¿eh?<br>Ya me vas contando, con la calma."
msgstr ""

#. en: <$voicel(1,3)><$emotion(1,47)><$pkcry;0(1,4)>... I’m totally spent...<clear><br><$voicel(1,5)><$comeff(1,6)><$motion(1,805)>Real sorry, but could you clear the path a little more for<br>me, <$cdef(27)><pname;1></color>?<clear><br><$voicel(1,7)><$emotion(1,48)><$facial(1,1)>Gimme a holler when you’re done, OK? I’ll go wait.
msgctxt "1968:405"
msgid "<$voicel(1,3)><$emotion(1,47)><$pkcry;0(1,4)>... ¡Buah, qué reventada!<clear><br><$voicel(1,5)><$motion(1,805)>Ya lo siento, <$comeff(1,6)>¿pero crees que podrías mejorar un poco<br>más el camino?<clear><br><$voicel(1,7)><$emotion(1,48)><$facial(1,1)>Yo aquí te espero. Cuando esté, me dices."
msgstr "<$voicel(1,3)><$emotion(1,47)><$pkcry;0(1,4)>... ¡Uf, qué cansancio!<clear><br><$voicel(1,5)><$motion(1,805)>Lo siento, <$comeff(1,6)>¿pero crees que podrías mejorar un poco<br>más el camino?<clear><br><$voicel(1,7)><$emotion(1,48)><$facial(1,1)>Yo aquí te espero. Cuando esté, me dices."

#. en: <$comeff(1,6)><$motion(1,666)><$voicel(1,5)>Yikes, looks like I can’t go any further... Think you could<br>help me out here, <$cdef(27)><pname;0></color>?
msgctxt "1968:408"
msgid "<$motion(1,666)><$voicel(1,5)>Hasta aquí he llegao... Creo que no voy a poder seguir.<br><$cdef(27)><pname;0></color>, <$comeff(1,6)>¿se te ocurre algo?"
msgstr "<$motion(1,666)><$voicel(1,5)>Hasta aquí llegué... Creo que no voy a poder seguir.<br><$cdef(27)><pname;0></color>, <$comeff(1,6)>¿se te ocurre algo?"

#. en: <oneline><$voicel(1,5)><$comeff(1,14)><$motion(1,805)>Apparently someone called<$cdef(27)> <wowner;0><br></color>lives<slide><br>around here.<clear><br><$voicel(1,7)><$emotion(1,49)>You’re friends, right? Let’s go say hi!
msgctxt "1968:409"
msgid "<oneline><$voicel(1,5)><$comeff(1,14)><$motion(1,805)>¡Me han dicho que <$cdef(27)><wowner;0></color> vive por<br>esta zona!<clear><br><$voicel(1,7)><$emotion(1,49)>Os conocéis, ¿no? ¿Crees que podrías presentármel<gen;0(o,a)>?"
msgstr "<oneline><$voicel(1,5)><$comeff(1,14)><$motion(1,805)>¡Me dijeron que <$cdef(27)><wowner;0></color> vive por<br>esta zona!<clear><br><$voicel(1,7)><$emotion(1,49)>Se conocen, ¿no? ¿Crees que podrías presentármel<gen;0(o,a)>?"

#. en: <$comeff(1,3)><$motion(1,803)><$voicel(1,5)>Gotcha. I’ll head back home.
msgctxt "1968:410"
msgid "<$comeff(1,3)><$motion(1,803)><$voicel(1,5)>¡Vale, me piro a mi keli!"
msgstr "<$comeff(1,3)><$motion(1,803)><$voicel(1,5)>¡Bueno, me voy a mi casa!"

#. en: <$voicel(1,4)><$emotion(1,29)>Hm? Whatcha got, pal?
msgctxt "1968:411"
msgid "<$voicel(1,4)><$emotion(1,29)>¿Eh? ¿Qué llevas ahí?"
msgstr ""

#. en: <$voicel(1,8)><$emotion(1,49)>Ha! Figures.
msgctxt "1968:412"
msgid "<$voicel(1,8)><$emotion(1,49)>Ah, tranqui. No te rayes."
msgstr "<$voicel(1,8)><$emotion(1,49)>Ah, tranqui. No te preocupes."

#. en: <$voicel(1,7)><$emotion(1,1)>Whoa, for real? Dang, that’s awesome! Thanks a<br>bunch, <$cdef(27)><pname;0></color>!
msgctxt "1968:413"
msgid "<$voicel(1,7)><$emotion(1,1)>¿Para mí? ¿De veras? ¡Buah, muchísimas gracias, <gen;-2(bro,sis)>!"
msgstr "<$voicel(1,7)><$emotion(1,1)>¿Para mí? ¿De veras? ¡Guau, muchísimas gracias, <gen;-2(bro,sis)>!"

#. en: <$comeff(1,5)><$facial(1,1)><$motion(1,803)><$voicel(1,8)>Hey, <iart;0()><$cdef(27)><fqty(1)><class><refmateid;0></color>!
msgctxt "1968:414"
msgid "<oneline><$comeff(1,5)><$facial(1,1)><$motion(1,803)><$voicel(1,8)>¡Uala,<br><iart;0()><$cdef(27)><fqty(1)></color><class><$cdef(27)><refmateid;0></color>!"
msgstr "<oneline><$comeff(1,5)><$facial(1,1)><$motion(1,803)><$voicel(1,8)>¡Guau,<br><iart;0()><$cdef(27)><fqty(1)></color><class><$cdef(27)><refmateid;0></color>!"

#. en: <$voicel(1,7)><$emotion(1,49)>Oooh, a treasure hunt? Aw yeah, let’s find something epic!
msgctxt "1968:415"
msgid "<$voicel(1,7)><$emotion(1,49)>¿Quieres que vayamos a buscar tesoros? ¡Eso está hecho!<br>Volveremos a casa con algo chulísimo, ya verás."
msgstr "<$voicel(1,7)><$emotion(1,49)>¿Quieres que vayamos a buscar tesoros? ¡Eso está hecho!<br>Volveremos a casa con algo increíble, ya verás."

#. en: <$voicel(1,9)><$emotion(1,38)>Anybody ever tell you that you’ve got a real big heart,<br><$cdef(27)><pname;0></color>? <wait(0.4)>Thanks for always being rad!<clear><br><$voicel(1,8)><$comeff(1,9)><$motion(1,661)>I got ya somethin’—think fast!
msgctxt "1968:416"
msgid "<oneline><$voicel(1,9)><$emotion(1,38)><$cdef(27)><pname;0></color>, ¡eres mi Ditto favorito!<br>¡Gracias por todo, pana!<clear><br><$voicel(1,8)><$comeff(1,9)><$motion(1,661)>Toma, un regalo por ser lo más."
msgstr "<oneline><$voicel(1,9)><$emotion(1,38)><$cdef(27)><pname;0></color>, ¡eres mi Ditto favorito!<br>¡Gracias por todo, compa!<clear><br><$voicel(1,8)><$comeff(1,9)><$motion(1,661)>Toma, un regalo por ser lo más."

#. en: <$voicel(1,7)><$emotion(1,8)>Wanna know something? My best pal in the whole wide<br>world...<wait(0.6)>is you, <$cdef(27)><pname;1></color>!
msgctxt "1968:417"
msgid "<oneline><$voicel(1,7)><$emotion(1,8)>¡Tú para mí eres mi herman<gen;-2(o,a)> del alma,<br><$cdef(27)><pname;1></color>!<clear><br>¡Mi mejor amig<gen;-2(o,a)> del mundo!"
msgstr ""

#. en: <$voicel(1,9)><$emotion(1,27)><$pkcry;0(1,2)>! Aw yeah, check out that treasure!<clear><br><$voicel(1,7)><$emotion(1,8)>Nothing beats a treasure hunt, am I right? I can’t wait to<br>see what we find next time!
msgctxt "1968:418"
msgid "<$voicel(1,9)><$emotion(1,27)>¡<$pkcry;0(1,2)>! ¡Jua, jua, hemos dado con el tesoro!<clear><br><$voicel(1,7)><$emotion(1,8)>Me lo he pasado increíble. ¡La próxima vez también<br>pienso ir a tope!"
msgstr "<$voicel(1,9)><$emotion(1,27)>¡<$pkcry;0(1,2)>! ¡Jua, jua, dimos con el tesoro!<clear><br><$voicel(1,7)><$emotion(1,8)>Me la pasé increíble. ¡La próxima vez también<br>pienso ir con todo!"

#. en: <oneline><$voicel(1,9)><$emotion(1,7)><$pkcry;0(1,2)>! I love this stuff! <$voicel(1,8)><$emotion(1,49)>Thanks a bunch,<br><$cdef(27)><pname;2></color>!
msgctxt "1968:419"
msgid "<oneline><$voicel(1,9)><$emotion(1,7)>¡<$pkcry;0(1,2)>! ¡Pero bueno,<br><$cdef(27)><pname;2></color>!<wait(0.4)><slide><br>¡Tú sí que me conoces!<clear><br><$voicel(1,8)><$emotion(1,49)>¡Me flipaaa!"
msgstr "<oneline><$voicel(1,9)><$emotion(1,7)>¡<$pkcry;0(1,2)>! ¡Pero bueno,<br><$cdef(27)><pname;2></color>!<wait(0.4)><slide><br>¡Tú sí que me conoces!<clear><br><$voicel(1,8)><$emotion(1,49)>¡Me encantaaa!"

#. en: <$comeff(1,14)><$facial(1,1)><$motion(1,805)><$voicel(1,5)>There’s a place over there I wanna get to, but I need you<br>to clear a way.
msgctxt "1968:420"
msgid "<$comeff(1,14)><$facial(1,1)><$motion(1,805)><$voicel(1,5)>Hay un sitio por ahí al que tengo unas ganas locas de ir."
msgstr "<$comeff(1,14)><$facial(1,1)><$motion(1,805)><$voicel(1,5)>Hay un lugar por ahí al que tengo unas ganas locas de ir."

#. en: <$voicel(1,7)><$emotion(1,14)>Oh, you wanna go that way? I’m gonna call it here, then.<br>Later, pal!
msgctxt "1968:421"
msgid "<$voicel(1,7)><$emotion(1,14)>Buah, ¿tan lejos quieres ir? ¡Pues nada, que lo disfrutes!<br>¡Yo me quedo por aquí, pana!"
msgstr "<$voicel(1,7)><$emotion(1,14)>Guau, ¿tan lejos quieres ir? ¡Pues nada, que lo disfrutes!<br>¡Yo me quedo por aquí, compa!"

#. en: <$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,3)>Not gonna lie, the road to get there looks pretty gnarly.
msgctxt "1968:422"
msgid "<$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,3)>Pero es que el camino que lleva hasta allí está hecho<br>un desastre, pana. No hay quien lo use."
msgstr "<$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,3)>Pero es que el camino que lleva hasta allá está hecho<br>un desastre, compa. No hay quien lo use."

#. en: <$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Uh, this place is kinda small for me... You got any houses<br>that’re bigger, maybe?
msgctxt "1968:426"
msgid "<$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Oye, ¿no te parece que es un poco pequeña para mí?<br>Mejor buscamos algo más espacioso."
msgstr ""

#. en: <$voicel(1,7)><$comeff(1,3)><$motion(1,805)>Dang, that’s one nice-lookin’ house.
msgctxt "1968:427"
msgid "<$voicel(1,7)><$comeff(1,3)><$motion(1,805)>¡No veas! ¡Esta es la casa humana más flipante que<br>he visto en mi vida!"
msgstr "<$voicel(1,7)><$comeff(1,3)><$motion(1,805)>¡Guau! ¡Esta es la casa humana más increíble que<br>he visto en mi vida!"

#. en: <$voicel(1,7)><$emotion(1,8)>For real?! That’d be awesome, <$cdef(27)><pname;0></color>!
msgctxt "1968:428"
msgid "<oneline><$voicel(1,7)><$emotion(1,8)>¿Lo dices en serio? ¡Eres la repera,<br><$cdef(27)><pname;0></color>!"
msgstr "<oneline><$voicel(1,7)><$emotion(1,8)>¿Lo dices en serio? ¡Eres lo máximo,<br><$cdef(27)><pname;0></color>!"

#. en: <$voicel(1,7)><$emotion(1,49)>Ha! You’ve got great taste, <$cdef(27)><pname;0></color>!
msgctxt "1968:429"
msgid "<$voicel(1,7)><$emotion(1,49)>¡Pues sí! ¡Se nota que tú también tienes buen gusto, <gen;-2(bro,sis)>!"
msgstr ""

#. en: <$voicel(1,9)><$comeff(1,5)><$motion(1,805)>For real?! I can live here, in this house?
msgctxt "1968:430"
msgid "<$voicel(1,9)><$comeff(1,5)><$motion(1,805)>¿Eh? ¡¿En serio puedo mudarme a esta keli humana?!"
msgstr "<$voicel(1,9)><$comeff(1,5)><$motion(1,805)>¿Eh? ¡¿En serio puedo mudarme a esta casa humana?!"

#. en: <$voicel(1,7)><$emotion(1,39)>Wow... Thanks a bunch, pal! I’m super excited to live here!
msgctxt "1968:431"
msgid "<$voicel(1,7)><$emotion(1,39)>¡Qué pasote! ¡Vivir aquí va a ser la leche!"
msgstr "<$voicel(1,7)><$emotion(1,39)>¡Qué genial! ¡Vivir aquí va a ser increíble!"

#. en: <$voicel(1,7)><$emotion(1,49)>No sweat! I’m good to move whenever.
msgctxt "1968:432"
msgid "<$voicel(1,7)><$emotion(1,49)>Bueh, tampoco es que me corra prisa mudarme."
msgstr "<$voicel(1,7)><$emotion(1,49)>Bueh, tampoco es que tenga prisa por mudarme."

#. en: <$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Wait... That house already looks pretty full, huh? <$voicel(1,8)><$emotion(1,14)>You got<br>any other spots for me to live?
msgctxt "1968:433"
msgid "<$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Hmm... Si me mudo ya seremos demasiada peña aquí,<br>¿no te parece?<clear><br><$voicel(1,8)><$emotion(1,14)>Mejor buscamos otro lugar."
msgstr "<$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Hmm... Si me mudo ya seremos demasiada gente aquí,<br>¿no te parece?<clear><br><$voicel(1,8)><$emotion(1,14)>Mejor buscamos otro lugar."

#. en: <$voicel(1,9)><$emotion(1,53)>Aw yeah! Looks like we scored some sweet loot!<clear><br><$voicel(1,8)><$emotion(1,49)>Hit me up next time you wanna treasure hunt, yeah?
msgctxt "1968:434"
msgid "<$voicel(1,9)><$emotion(1,53)>Nos vamos a casa con las manos llenas. ¡Ha sido<br>una búsqueda muy productiva!<clear><br><$voicel(1,8)><$emotion(1,49)>Avísame cuando te apetezca salir en busca de más cosas<br>chulas."
msgstr "<$voicel(1,9)><$emotion(1,53)>Nos vamos a casa con las manos llenas. ¡Fue<br>una búsqueda muy productiva!<clear><br><$voicel(1,8)><$emotion(1,49)>Avísame cuando quieras salir en busca de más cosas<br>geniales."

#. en: <$voicel(1,7)><$emotion(1,29)>Huh? What’s that shiny thing, <$cdef(27)><pname;0></color>?
msgctxt "1968:435"
msgid "<$cdef(27)><$voicel(1,7)></color><$emotion(1,29)>Uala, ¿adónde vas con eso tan brillante?"
msgstr "<$cdef(27)><$voicel(1,7)></color><$emotion(1,29)>Guau, ¿adónde vas con eso tan brillante?"

#. en: <$voicel(1,7)><$emotion(1,1)>Wow, for me? Thanks, pal! You can take this in exchange.
msgctxt "1968:436"
msgid "<$voicel(1,7)><$emotion(1,1)>¿Cómo que me lo das? ¡Buah, pues se agradece, <gen;-2(bro,sis)>!<br>¡Toma esto entonces!"
msgstr "<$voicel(1,7)><$emotion(1,1)>¿Cómo que me lo das? ¡Guau, pues se agradece, <gen;-2(bro,sis)>!<br>¡Toma esto entonces!"

#. en: <$voicel(1,3)><$comeff(1,4)><$motion(1,666)>Uh, I’m not sure I can accept somethin’ that nice. But <$voicel(1,6)><$emotion(1,14)>it’s<br>cool of you to offer!
msgctxt "1968:437"
msgid "<$voicel(1,3)><$comeff(1,4)><$motion(1,666)>Hmm, ¿estás segur<gen;-2(o,a)>? ¿No crees que habrá alguien más<br>adecuado por ahí?<clear><br><$voicel(1,6)><$emotion(1,14)>¡Gracias, pero mejor dáselo a otro!"
msgstr ""

#. en: <$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Huh? Hmmm... Y’know, that’s real nice of you, but I’ve<br>gotta pass.<clear><br><$voicel(1,7)><$emotion(1,49)><$facial(1,4)>I don’t know how I’d use it right now, but I appreciate you<br>thinkin’ of me, pal!
msgctxt "1968:438"
msgid "<$voicel(1,5)><$comeff(1,14)><$motion(1,666)>¿Eh? Lo siento, com<gen;-2(padre,adre)>, pero no puedo aceptarlo...<br><$voicel(1,7)><$emotion(1,49)><$facial(1,4)>No sabría qué hacer con eso, ¡aunque te lo agradezco!"
msgstr ""

#. en: <$voicel(1,5)><$comeff(1,6)><$motion(1,666)>Uh... I’m pretty sure I already live here, pal.
msgctxt "1968:439"
msgid "<$voicel(1,5)><$comeff(1,6)><$motion(1,666)>Herman<gen;-2(o,a)>, ¿se te ha ido la flapa? ¡Ya vivo aquí!"
msgstr "<$voicel(1,5)><$comeff(1,6)><$motion(1,666)>Herman<gen;-2(o,a)>, ¿se te olvidó? ¡Ya vivo aquí!"

#. en: <$comeff(1,10)><$facial(1,1)><$motion(1,806)><$voicel(1,7)>I’m countin’ on ya, <$cdef(27)><pname;0></color>!
msgctxt "1968:442"
msgid "<$comeff(1,10)><$facial(1,1)><$motion(1,806)><$voicel(1,7)>¡<$cdef(27)><pname;0></color>, encárgate de arreglarlo, va!"
msgstr "<$comeff(1,10)><$facial(1,1)><$motion(1,806)><$voicel(1,7)>¡<$cdef(27)><pname;0></color>, encárgate de arreglarlo, porfa!"

#. en: <$voicel(1,8)><$emotion(1,27)>Time’s up, <$cdef(27)><pname;0></color>!
msgctxt "1968:443"
msgid "<$voicel(1,8)><$emotion(1,27)>¡Se acabó el tiempo, <$cdef(27)><pname;0></color>!"
msgstr ""

#. en: <oneline><$voicel(1,5)><$comeff(1,14)><$motion(1,666)>I gave it my all, but I still came up short... You some kinda<br>secret hide-and-sneak pro?<clear><br><$voicel(1,8)><$emotion(1,38)>Well, I think my pro pal deserves a prize! Take<br>this, <$cdef(27)><pname;1></color>!
msgctxt "1968:444"
msgid "<$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Buf, y mira que íbamos con intenciones de ganar...<br>Eres <gen;-2(un,una)> <gen;-2(dios,diosa)> del escondite camuflado.<clear><br><$voicel(1,8)><$emotion(1,38)>¡Te mereces un premio de lujo!"
msgstr ""

#. en: <$voicel(1,4)><$emotion(1,29)>You up for another round?
msgctxt "1968:445"
msgid "<$voicel(1,4)><$emotion(1,29)>¿Te hace otra partida?"
msgstr "<$voicel(1,4)><$emotion(1,29)>¿Jugamos otra partida?"

#. en: <$voicel(1,7)><$emotion(1,1)>Aw yeah, bring it on! No way am I gonna lose!
msgctxt "1968:446"
msgid "<$voicel(1,7)><$emotion(1,1)>¡Genial! ¡No pienso perder!"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,49)>No sweat! Maybe another time, huh?
msgctxt "1968:447"
msgid "<$voicel(1,7)><$emotion(1,49)>¿No? Está bien. Tú avisa cuando quieras volver a jugar."
msgstr ""

#. en: <$voicel(1,3)><$comeff(1,14)><$motion(1,666)><$facial(1,9)>I’m not totally sure what, but this house feels like it’s<br>missing something...<clear><br><$voicel(1,7)><$emotion(1,14)>Maybe I won’t move here. Sorry for makin’ ya go through<br>the trouble of showin’ me this place.
msgctxt "1968:449"
msgid "<$voicel(1,3)><$comeff(1,14)><$motion(1,666)><$facial(1,9)>Eeeh... Tiene un estilo muy... minimalista, por así decirlo.<br><$voicel(1,7)><$emotion(1,14)>Va a ser que paso, pero gracias por la oferta."
msgstr "<$voicel(1,3)><$comeff(1,14)><$motion(1,666)><$facial(1,9)>Eeeh... Tiene un estilo muy... minimalista, por así decirlo.<br><$voicel(1,7)><$emotion(1,14)>Creo que paso, pero gracias por la oferta."

#. en: <$voicel(1,8)><$emotion(1,14)><$facial(1,4)>Sweet! Just leave it to me.<clear><br><$voicel(1,5)><$comeff(1,9)><$motion(1,806)>This’ll take a while, so come back later to grab your stuff!
msgctxt "1968:452"
msgid "<$voicel(1,8)><$emotion(1,14)><$facial(1,4)>Venga, yo me encargo.<clear><br><$voicel(1,5)><$comeff(1,9)><$motion(1,806)>Vuelve dentro de un rato."
msgstr "<$voicel(1,8)><$emotion(1,14)><$facial(1,4)>Bueno, yo me encargo.<clear><br><$voicel(1,5)><$comeff(1,9)><$motion(1,806)>Vuelve dentro de un rato."

#. en: <$voicel(1,7)><$emotion(1,14)>I need a little more time—it’ll be worth the wait, promise!
msgctxt "1968:453"
msgid "<$voicel(1,7)><$emotion(1,14)>¡La calidad requiere tiempo, pana! ¡Ten paciencia!"
msgstr "<$voicel(1,7)><$emotion(1,14)>¡La calidad requiere tiempo, compa! ¡Ten paciencia!"

#. en: <oneline><$voicel(1,5)><$emotion(1,14)><$facial(1,4)>Remember when you asked for<br><$cdef(27)><fqty(2)><class><reftarid;1></color>?<slide><br>Well,<slide><br>I<slide><br>got<slide><br>you<slide><br>covered.<slide><br>Here<slide><br>ya go!
msgctxt "1968:454"
msgid "<oneline><$voicel(1,5)><$emotion(1,14)><$facial(1,4)>Oye, ya tengo<br><dart;1()><$cdef(27)><class><reftarid;1></color><slide><br>que me pediste.<slide><br>Son 10<nbs4>000. Que nooo. Jua, jua."
msgstr "<oneline><$voicel(1,5)><$emotion(1,14)><$facial(1,4)>Oye, ya tengo<br><dart;1()><$cdef(27)><class><reftarid;1></color><slide><br>que me pediste.<slide><br>Son 10<nbs4>000. Es bromaaa. Jua, jua."

#. en: <$voicel(1,7)><$comeff(1,4)><$motion(1,807)>Wish I could, but I gotta take care of something else now...<br>Sorry, pal!
msgctxt "1968:455"
msgid "<$voicel(1,7)><$comeff(1,4)><$motion(1,807)>Puf, lo siento, chic<gen;-2(o,a)>, pero me pillas en muy mal<br>momento..."
msgstr "<$voicel(1,7)><$comeff(1,4)><$motion(1,807)>Puf, lo siento, chic<gen;-2(o,a)>, pero me agarras en muy mal<br>momento..."

#. en: <$comeff(1,6)><$voicel(1,3)><$motion(1,827)><$facial(1,9)>Hold up... Wasn’t my home somewhere around here?
msgctxt "1968:459"
msgid "<$comeff(1,6)><$voicel(1,3)><$motion(1,827)><$facial(1,9)>¿Eh? ¿Dónde está mi keli?"
msgstr "<$comeff(1,6)><$voicel(1,3)><$motion(1,827)><$facial(1,9)>¿Eh? ¿Dónde está mi casa?"

#. en: <$comeff(1,5)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>Wait, seriously?! My home just...vanished? Is this a prank?<br>No one pranks the prankster and gets off un-pranked!
msgctxt "1968:460"
msgid "<$comeff(1,5)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>¡Buah, qué movida! ¡Que no está mi keli, <gen;-2(chaval,chavala)>!"
msgstr "<$comeff(1,5)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>¡Uf, qué lío! ¡Que no está mi casa, <gen;-2(chaval,chavala)>!"

#. en: <$comeff(1,14)><$facial(1,2)><$voicel(1,7)>Yeesh... Guess I’ve gotta find a new, better place to live.
msgctxt "1968:461"
msgid "<$comeff(1,14)><$facial(1,2)><$voicel(1,7)>¡Bah, qué más da! Fijo que encuentro otro sitio donde<br>vivir."
msgstr "<$comeff(1,14)><$facial(1,2)><$voicel(1,7)>¡Bah, qué más da! Seguro que encuentro otro lugar donde<br>vivir."

#. en: <$comeff(1,10)><$motion(1,803)><$voicel(1,10)>Well now, lookie here! What a snazzy little spot. Seems<br>kinda empty, though... Guess I’d better move right in!<clear><br><$voicel(1,9)><$motion(1,801)><$comeff(1,13)><$facial(1,5)>You made this place, right? Thanks a bunch, pal. You’re a<br>real lifesaver!
msgctxt "1968:462"
msgid "<$comeff(1,10)><$motion(1,803)><$voicel(1,10)>¡Qué sitio más guapo! ¡Voy a vivir aquí a partir de hoy!<clear><br><$voicel(1,9)><$motion(1,801)><$comeff(1,13)><$facial(1,5)>Lo has preparado tú, ¿verdad? ¡Me haces un favorazo!<br>¡Gracias! Jua, jua."
msgstr "<$comeff(1,10)><$motion(1,803)><$voicel(1,10)>¡Qué lugar tan bonito! ¡Voy a vivir aquí a partir de hoy!<clear><br><$voicel(1,9)><$motion(1,801)><$comeff(1,13)><$facial(1,5)>Lo preparaste tú, ¿verdad? ¡Me haces un favorazo!<br>¡Gracias! Jua, jua."

#. en: <oneline><$comeff(1,5)><$voicel(1,8)><$facial(1,13)>You got me<br><iart;0()><$cdef(27)><fqty(1)><class><stfrevp;0></color>?<slide><br>For<slide><br>real?<clear><br><$comeff(1,10)><$voicel(1,10)><$facial(1,4)><$motion(1,801)>Whoa, you rock, pal! I can’t wait to see what it’s like!
msgctxt "1968:463"
msgid "<oneline><$comeff(1,5)><$voicel(1,8)><$facial(1,13)>¿En serio me has puesto<br><iart;0()><fqty(1)><class><$cdef(27)><stfrevp;0></color>?<slide><br><$comeff(1,10)><$voicel(1,10)><$facial(1,4)><$motion(1,801)>¡Gracias!<slide><br>Voy a ir a <genqty;0(echarle,echarle,echarles,echarles)> un vistazo."
msgstr "<oneline><$comeff(1,5)><$voicel(1,8)><$facial(1,13)>¿En serio me pusiste<br><iart;0()><fqty(1)><class><$cdef(27)><stfrevp;0></color>?<slide><br><$comeff(1,10)><$voicel(1,10)><$facial(1,4)><$motion(1,801)>¡Gracias!<slide><br>Voy a ir a <genqty;0(echarle,echarle,echarles,echarles)> un vistazo."

#. en: <$comeff(1,14)><$facial(1,4)><$motion(1,661)><$voicel(1,7)>Dang, this is one nice house. The closer I look, the more<br>impressive it gets!
msgctxt "1968:464"
msgid "<$comeff(1,14)><$facial(1,4)><$motion(1,661)><$voicel(1,7)>Si es que cuanto más la miro, más me gusta.<br>¡Qué flipe de keli, chava<gen;-2(l,la)>!"
msgstr "<$comeff(1,14)><$facial(1,4)><$motion(1,661)><$voicel(1,7)>Es que cuanto más la miro, más me gusta.<br>¡Qué casa tan increíble, chava<gen;-2(l,la)>!"

#. en: <oneline><$comeff(1,3)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>Give this to <$cdef(27)><refpname;0></color> for me, will ya? Tell<br>’em<slide><br>it’s<slide><br>from<slide><br>me.<slide><br>They’ll<slide><br>know<slide><br>what it is!
msgctxt "1968:465"
msgid "<oneline><$comeff(1,3)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>¡Dale esto a <$cdef(27)><refpname;0></color>, anda! Dile que es<br>de mi parte."
msgstr "<oneline><$comeff(1,3)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>¡Dale esto a <$cdef(27)><refpname;0></color>, porfa! Dile que es<br>de mi parte."

#. en: <$voicel(1,5)><$emotion(1,48)>Yo, <$cdef(27)><pname;0></color>! You up for a quiz right now?
msgctxt "1968:466"
msgid "<oneline><$voicel(1,5)><$emotion(1,48)>¡<$cdef(27)><pname;0></color>! Tengo una preguntilla para ti,<br>a ver si te atreves."
msgstr "<oneline><$voicel(1,5)><$emotion(1,48)>¡<$cdef(27)><pname;0></color>! Tengo una preguntita para ti,<br>a ver si te atreves."

#. en: <$voicel(1,7)><$emotion(1,1)>Ha! I knew you’d be down to clown. OK, question time...<clear><br><$voicel(1,5)>Between me and <$cdef(27)><sizecmppk;1></color>, who’s taller?
msgctxt "1968:467"
msgid "<$voicel(1,7)><$emotion(1,1)>¡Esa es la actitud! Pues ahí va.<clear><br><$voicel(1,5)>¿Quién gana en altura, <dart;1()><$cdef(27)><sizecmppk;1> </color>o yo?"
msgstr ""

#. en: <$emotion(1,14)><$voicel(1,7)><$comeff(1,3)><$facial(1,1)>Whaaat?! Oh well, maybe another time!
msgctxt "1968:468"
msgid "<$emotion(1,14)><$voicel(1,7)><$comeff(1,3)><$facial(1,1)>¡Vaya, <gen;-2(chico,chica)>! Pues otra vez será."
msgstr ""

#. en: ...<wait(0.4)><$voicel(1,7)><$emotion(1,40)>Bingo! You got it right!<clear><br>Nicely done, <$cdef(27)><pname;0></color>!
msgctxt "1968:469"
msgid "<oneline>... <wait(0.4)><$voicel(1,7)><$emotion(1,40)>¡Has acertado! ¡Si es que no fallas una,<br><$cdef(27)><pname;0></color>!"
msgstr "<oneline>... <wait(0.4)><$voicel(1,7)><$emotion(1,40)>¡Acertaste! ¡Es que no fallas una,<br><$cdef(27)><pname;0></color>!"

#. en: ...<wait(0.4)><$comeff(1,3)><$voicel(1,7)>Womp wommmp, wrong answer! Was that question a<br>little too tricky?<clear><br><$voicel(1,5)><$emotion(1,49)>I’ll try and think up some more, so you better get the next<br>one right!
msgctxt "1968:470"
msgid "...<wait(0.4)><$comeff(1,3)><$voicel(1,7)> Bua, Bua, Buaaa. No es correcto.<clear><br>Igual me he pasado un poco. <$voicel(1,5)><$emotion(1,49)>Voy a ver si se me ocurre<br>otra y te digo. ¡Talué!"
msgstr "...<wait(0.4)><$comeff(1,3)><$voicel(1,7)> Bua, Bua, Buaaa. No es correcto.<clear><br>Tal vez me pasé un poco. <$voicel(1,5)><$emotion(1,49)>Voy a ver si se me ocurre<br>otra y te digo. ¡Nos vemos!"

#. en: <$comeff(1,5)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Ha! Now THIS is one sweet spot. Did you make it just for<br>me,<$cdef(27)> <pname;0></color>?<clear><br><$comeff(1,10)><$motion(1,801)><$voicel(1,10)>Wow, thanks a bunch, pal! I’m gonna move right in!
msgctxt "1968:471"
msgid "<$comeff(1,5)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>¡Qué flipe de sitio! ¿Me lo has preparado tú? Graciaaas.<br><$comeff(1,10)><$motion(1,801)><$voicel(1,10)>¡Pues me quedo a vivir aquí! Jua, jua."
msgstr "<$comeff(1,5)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>¡Qué lugar tan genial! ¿Me lo preparaste tú? Graciaaas.<br><$comeff(1,10)><$motion(1,801)><$voicel(1,10)>¡Pues me quedo a vivir aquí! Jua, jua."

#. en: <oneline><$voicel(1,5)><$emotion(1,14)>Do I know you, pal? Wait... <$cdef(27)><pname;1></color>?!<br><$voicel(1,7)><$emotion(1,38)>Ha! You<slide><br>really<slide><br>had me<slide><br>there!<slide><br>Shoulda<slide><br>known<slide><br>you<slide><br>could <$cdef(27)><$spwfull(36)></color>!
msgctxt "1968:472"
msgid "<oneline><$voicel(1,5)><$emotion(1,14)>¿Y tú quién eres?<clear><br>Aaah, ¿<$cdef(27)><pname;1></color>? <$voicel(1,7)><$emotion(1,38)>¡Casi me trago tu<br><$cdef(27)>transformación<nbs2><$spwicon(36)></color>,<slide><br>tí<gen;-2(o,a)>!"
msgstr "<oneline><$voicel(1,5)><$emotion(1,14)>¿Y tú quién eres?<clear><br>Aaah, ¿<$cdef(27)><pname;1></color>? <$voicel(1,7)><$emotion(1,38)>¡Casi me trago tu<br><$cdef(27)>transformación<nbs2><$spwicon(36)></color>,<slide><br>amig<gen;-2(o,a)>!"

#. en: <$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Huh? I got a feeling we’re gonna need more room to hide-<br>and-sneak around in!<clear><br><$voicel(1,4)><$emotion(1,29)>Can you help with that, <$cdef(27)><pname;0></color>?
msgctxt "1968:476"
msgid "<$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Eh... Creo que aquí no hay sitio para jugar al escondite<br>camuflado...<clear><br><$voicel(1,4)><$emotion(1,29)><$cdef(27)><pname;0></color>, ¿no puedes hacer un apaño?"
msgstr "<$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Eh... Creo que aquí no hay espacio para jugar al escondite<br>camuflado...<clear><br><$voicel(1,4)><$emotion(1,29)><$cdef(27)><pname;0></color>, ¿no puedes hacer algo?"

#. en: <$voicel(1,7)><$comeff(1,7)><$motion(1,807)>Hmmm... I dunno, pal. Not sure I could live here!
msgctxt "1968:477"
msgid "<$voicel(1,7)><$comeff(1,7)><$motion(1,807)>Eeeh... ¡Va a ser que no! ¡Yo aquí no me mudo ni loc<gen;-3(o,a)>!"
msgstr "<$voicel(1,7)><$comeff(1,7)><$motion(1,807)>Eeeh... ¡Creo que no! ¡Yo aquí no me mudo ni loc<gen;-3(o,a)>!"

#. en: <$voicel(1,8)><$emotion(1,14)>Hm? Is that for me?<clear><br><$voicel(1,5)><$facial(1,4)>Thanks, pal, but I’m kinda full right now. I appreciate you<br>thinkin’ of me, though!
msgctxt "1968:478"
msgid "<$voicel(1,8)><$emotion(1,14)>¿Me has traído algo? <$voicel(1,5)><$facial(1,4)>Pues lo siento, pero estoy que voy<br>a explotar. Si eso, otro día."
msgstr "<$voicel(1,8)><$emotion(1,14)>¿Me trajiste algo? <$voicel(1,5)><$facial(1,4)>Pues lo siento, pero estoy que voy<br>a explotar. Mejor otro día."

#. en: <$voicel(1,6)><$emotion(1,29)>Got a spot in mind for me to move to?
msgctxt "1968:481"
msgid "<$voicel(1,6)><$emotion(1,29)>¿Y adónde quieres que vaya, <gen;-2(bro,sis)>?"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,49)>Whoa! Is that seriously gonna be my new home?
msgctxt "1968:482"
msgid "<$voicel(1,7)><$emotion(1,49)>¡Uala! ¿Esta es mi nueva keli?"
msgstr "<$voicel(1,7)><$emotion(1,49)>¡Guau! ¿Esta es mi nueva casa?"

#. en: <$voicel(1,7)><$emotion(1,1)>Ha! I knew you’d be down to clown. OK, question time...<clear><br><$voicel(1,5)>Between me and <$cdef(27)><weightcmppk;1></color>, who’s heavier?
msgctxt "1968:484"
msgid "<$voicel(1,7)><$emotion(1,1)>¡Ahí estamooos! Pues esta es...<clear><br><$voicel(1,5)>¿Quién crees que pesa más, <$cdef(27)><weightcmppk;1> </color>o yo?"
msgstr ""

#. en: <oneline><$motion(1,827)><$voicel(1,7)>Hey there, <$cdef(27)><pname;0></color>. <$comeff(1,6)>You interested<br>in that?
msgctxt "1968:489"
msgid "<$cdef(27)><$comeff(1,6)></color><$motion(1,827)><$voicel(1,7)>¿Qué, te llevas eso?"
msgstr ""

#. en: <$comeff(1,10)><$facial(1,4)><$voicel(1,7)><$motion(1,803)>Ha! I figured. OK, what’ll you trade me for it?
msgctxt "1968:490"
msgid "<$comeff(1,10)><$facial(1,4)><$voicel(1,7)><$motion(1,803)>¡No me extraña! Vale, ¿y tú qué me das a cambio?"
msgstr "<$comeff(1,10)><$facial(1,4)><$voicel(1,7)><$motion(1,803)>¡No me extraña! Bueno, ¿y tú qué me das a cambio?"

#. en: <$comeff(1,1)><$motion(1,803)><$voicel(1,7)>No worries, just holler if you change your mind!
msgctxt "1968:491"
msgid "<$comeff(1,1)><$motion(1,803)><$voicel(1,7)>Vale, cuando te decidas, avísame."
msgstr "<$comeff(1,1)><$motion(1,803)><$voicel(1,7)>Bueno, cuando te decidas, avísame."

#. en: <$comeff(1,13)><$motion(1,801)><$voicel(1,9)><$facial(1,5)>Thanks, pal! I’ll take real good care of this.
msgctxt "1968:492"
msgid "<$comeff(1,13)><$motion(1,801)><$voicel(1,9)><$facial(1,5)>¡Gracias! Cuidaré bien de esto."
msgstr ""

#. en: <$comeff(1,1)><$motion(1,803)><$voicel(1,7)>Cold feet, huh? Well, just shout if you change your mind!
msgctxt "1968:493"
msgid "<$comeff(1,1)><$motion(1,803)><$voicel(1,7)>¿Qué, te rajas? No pasa nada. Si eso, me das un toque."
msgstr "<$comeff(1,1)><$motion(1,803)><$voicel(1,7)>¿Qué, te rajas? No pasa nada. Si cambias de idea, me avisas."

#. en: <$comeff(1,13)><$motion(1,801)><$voicel(1,9)><$facial(1,5)>Aw yeah, thanks a bunch!<clear><br><$comeff(1,5)><$voicel(1,7)><$facial(1,1)>Huh? Oh... Looks like I’m outta stuff to trade right now.<br><$comeff(1,1)><$voicel(1,8)><$facial(1,4)>I’ll be sure to stock some cool things for your next visit,<slide><br>so come see me again sometime!
msgctxt "1968:494"
msgid "<$comeff(1,13)><$motion(1,801)><$voicel(1,9)><$facial(1,5)>¡Gracias, chic<gen;-2(o,a)>! <$comeff(1,5)><$voicel(1,7)><$facial(1,1)>Ya te he cambiado todo lo cambiable.<br><$comeff(1,1)><$voicel(1,8)><$facial(1,4)>Vuelve otro día y tendré más cosas guapas, ya verás."
msgstr "<$comeff(1,13)><$motion(1,801)><$voicel(1,9)><$facial(1,5)>¡Gracias, chic<gen;-2(o,a)>! <$comeff(1,5)><$voicel(1,7)><$facial(1,1)>Ya te cambié todo lo cambiable.<br><$comeff(1,1)><$voicel(1,8)><$facial(1,4)>Vuelve otro día y tendré más cosas bonitas, ya verás."

#. en: <$voicel(1,8)><$comeff(1,1)>I’m gonna head over to the <$cdef(27)><fqty(1)><$ifull(1325)></color> in a sec.<clear><br><$facial(1,4)><$voicel(1,9)><$motion(1,801)><$comeff(1,13)>You oughta drop by later!
msgctxt "1968:495"
msgid "<$voicel(1,8)><$comeff(1,1)>Voy a estar un rato en la <$cdef(27)><fqty(1)><$ifull(1325)></color>.<br><$facial(1,4)><$voicel(1,9)><$motion(1,801)><$comeff(1,13)>Si eso, pásate luego por allí."
msgstr "<$voicel(1,8)><$comeff(1,1)>Voy a estar un rato en la <$cdef(27)><fqty(1)><$ifull(1325)></color>.<br><$facial(1,4)><$voicel(1,9)><$motion(1,801)><$comeff(1,13)>Si quieres, pásate luego por allá."

#. en: <$facial(1,4)><$motion(1,803)><$voicel(1,7)><$comeff(1,10)>Sorry, pal, but I’m done for the day. Swing by another time!
msgctxt "1968:496"
msgid "<$facial(1,4)><$motion(1,803)><$voicel(1,7)><$comeff(1,10)>No me queda na de na. Ya lo siento, chic<gen;-2(o,a)>.<br>Vuelve otro día."
msgstr "<$facial(1,4)><$motion(1,803)><$voicel(1,7)><$comeff(1,10)>No me queda nada de nada. Lo siento, chic<gen;-2(o,a)>.<br>Vuelve otro día."

#. en: <$voicel(1,10)><$motion(1,801)><$comeff(1,13)><$facial(1,5)>Ha! Get a load of this!
msgctxt "1968:497"
msgid "<$voicel(1,10)><$motion(1,801)><$comeff(1,13)><$facial(1,5)>¡Uala! ¡Cómo mola esto!"
msgstr "<$voicel(1,10)><$motion(1,801)><$comeff(1,13)><$facial(1,5)>¡Guau! ¡Esto me encanta!"

#. en: <$voicel(1,7)><$emotion(1,1)>Whoa, thanks, pal! I’m gonna eat this right away!
msgctxt "1968:500"
msgid "<$voicel(1,7)><$emotion(1,1)>¡Muchas gracias! ¡Tenía un antojo tremendo de esto!"
msgstr ""

#. en: <oneline><$voicel(1,7)><$emotion(1,49)>You look so sleepy in the morning,<br><$cdef(27)><pname;0></color>.<clear><br><$voicel(1,5)><$comeff(1,16)><$motion(1,806)><$facial(1,14)>Not me—I’m always energized and ready to...go...<clear><br>...<wait(0.3)>Zzz...
msgctxt "1968:501"
msgid "<$voicel(1,7)><$emotion(1,49)>Menuda cara de sueño traes, com<gen;-2(adre,padre)>. Se nota que te<br>cuesta levantarte, ¿eh? ¡No como a mí!<clear><br><$voicel(1,5)><$comeff(1,16)><$motion(1,806)><$facial(1,14)>Yo siempre empiezo la mañana a tope... de... energí... a...<br>Zzz... Zzz..."
msgstr "<$voicel(1,7)><$emotion(1,49)>Qué cara de sueño traes, com<gen;-2(adre,padre)>. Se nota que te<br>cuesta levantarte, ¿eh? ¡No como a mí!<clear><br><$voicel(1,5)><$comeff(1,16)><$motion(1,806)><$facial(1,14)>Yo siempre empiezo la mañana con... mucha... energí... a...<br>Zzz... Zzz..."

#. en: <$voicel(1,5)><$emotion(1,14)>I spotted the perfect nap spot earlier, but... <$voicel(1,4)><$comeff(1,14)><$motion(1,666)>Hm.<br>Where was it?<clear><br><$voicel(1,5)>Should I go look for it? Or maybe just lie down and nap<br>wherever? <$voicel(1,7)><$emotion(1,49)>Sunny day problems, am I right?
msgctxt "1968:502"
msgid "<$voicel(1,5)><$emotion(1,14)>El otro día encontré un sitio que flipas para echarse<br>la siesta. <$voicel(1,4)><$comeff(1,14)><$motion(1,666)>La cosa es que... no recuerdo dónde está.<clear><br><$voicel(1,5)>No sé si debería buscarlo o echarme en cualquier lao.<br><$voicel(1,7)><$emotion(1,49)>Con el tiempazo que hace y yo aquí sin saber qué hacer."
msgstr "<$voicel(1,5)><$emotion(1,14)>El otro día encontré un lugar increíble para echarse<br>la siesta. <$voicel(1,4)><$comeff(1,14)><$motion(1,666)>La cosa es que... no recuerdo dónde está.<clear><br><$voicel(1,5)>No sé si debería buscarlo o echarme en cualquier lado.<br><$voicel(1,7)><$emotion(1,49)>Con el tiempazo que hace y yo aquí sin saber qué hacer."

#. en: <$voicel(1,7)><$emotion(1,14)>Y’know, daytime and nighttime are pretty long, but<br>evening’s pretty short, huh?<clear><br><$voicel(1,5)><$emotion(1,39)>It’s too bad—sunsets are so dang pretty, but they’re over<br>so dang fast.
msgctxt "1968:503"
msgid "<$voicel(1,7)><$emotion(1,14)>Con lo largos que son el día y la noche, la tarde se acaba<br>en un plis plas.<clear><br><$voicel(1,5)><$emotion(1,39)>Qué injusticia, ¡los atardeceres son bien chulos!"
msgstr "<$voicel(1,7)><$emotion(1,14)>Con lo largos que son el día y la noche, la tarde se acaba<br>en un dos por tres.<clear><br><$voicel(1,5)><$emotion(1,39)>Qué injusticia, ¡los atardeceres son bien bonitos!"

#. en: <$voicel(1,5)><$emotion(1,48)>Y’know, I like talkin’ to you at night. It’s kinda... I dunno...<br>Relaxing? <wait(1.2)><$voicel(1,4)><$facial(1,14)><$comeff(1,21)>Yeah, that’s it...
msgctxt "1968:504"
msgid "<$voicel(1,5)><$emotion(1,48)>Cuando hablo contigo por la noche, no sé, me resulta<br>relajante y todo...<clear><br><$voicel(1,4)><$facial(1,14)><$comeff(1,21)>Tanto que me qued... <wait(0.4)>Zzz..."
msgstr ""

#. en: <$voicel(1,5)><$comeff(1,14)><$motion(1,666)>A while back, some rando showed up where I was living.<br><$voicel(1,8)><$emotion(1,27)>It took me by surprise and we ended up gettin’ in a fight.<clear><br><$voicel(1,9)><$comeff(1,3)><$motion(1,806)>But then they pulled out this crazy move!<clear><br><$voicel(1,7)><$emotion(1,8)>Anyway, after all that, I figured I’d let ’em off easy and<br>play nice instead.<clear><br><$voicel(1,8)><$emotion(1,49)>Not ’cause I was scared or anything. Got it?
msgctxt "1968:507"
msgid "<$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Una vez, hace tiempo, me encontré a un desconocido<br>en mi keli... ¡No veas qué movida!<clear><br><$voicel(1,8)><$emotion(1,27)>Del susto empezamos un combate y todo.<clear><br><$voicel(1,9)><$comeff(1,3)><$motion(1,806)>Entonces el tío hizo un movimiento que me dejó flipando<br>y, bueno, <$voicel(1,7)><$emotion(1,8)>le pedí que mejor nos hiciésemos colegas.<clear><br><$voicel(1,8)><$emotion(1,49)>Me cayó bien. No es que me achantara ni nada, eeeh."
msgstr "<$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Una vez, hace tiempo, me encontré a un desconocido<br>en mi casa... ¡Imagínate qué lío!<clear><br><$voicel(1,8)><$emotion(1,27)>Del susto empezamos un combate y todo.<clear><br><$voicel(1,9)><$comeff(1,3)><$motion(1,806)>Entonces el tipo hizo un movimiento que me impresionó<br>y, bueno, <$voicel(1,7)><$emotion(1,8)>le pedí que mejor nos hiciéramos amigos.<clear><br><$voicel(1,8)><$emotion(1,49)>Me cayó bien. No es que me asustara ni nada, eeeh."

#. en: <$voicel(1,5)><$emotion(1,14)>Someone was tryin’ to get past this huge boulder blocking<br>the road, <$voicel(1,8)><$comeff(1,9)><$motion(1,806)>so I figured I’d help ’em out.<clear><br><$voicel(1,5)><$emotion(1,49)>Turned out some flowers were hiding under it, so I guess<br>I helped them out too!
msgctxt "1968:508"
msgid "<$voicel(1,5)><$emotion(1,14)>Un día voy y me encuentro una roca enorme en mitad<br>del camino, así, de gratis. Total, que como la gente no<slide><br>podía pasar, <$voicel(1,8)><$comeff(1,9)><$motion(1,806)>les eché un cable.<clear><br><$voicel(1,5)><$emotion(1,49)>En eso que la muevo a un lado... y resulta que debajo<br>había unas flores. ¡Hoy, dos por uno en buenas acciones!"
msgstr "<$voicel(1,5)><$emotion(1,14)>Un día voy y me encuentro una roca enorme en mitad<br>del camino, así, de gratis. Total, que como la gente no<slide><br>podía pasar, <$voicel(1,8)><$comeff(1,9)><$motion(1,806)>les eché una mano.<clear><br><$voicel(1,5)><$emotion(1,49)>En eso que la muevo a un lado... y resulta que debajo<br>había unas flores. ¡Hoy, dos por uno en buenas acciones!"

#. en: <$voicel(1,5)><$comeff(1,5)><$motion(1,803)>You’re pretty handy, huh? Seems like you can make just<br>about anything!<clear><br><$voicel(1,7)><$emotion(1,38)>Maybe you can make something for me sometime, huh?
msgctxt "1968:509"
msgid "<$voicel(1,5)><$comeff(1,5)><$motion(1,803)>¡Estás hech<gen;-2(o,a)> <gen;-2(un,una)> manitas, <gen;-2(bro,sis)>! ¡No hay objeto que se<br>te resista! <$voicel(1,7)><$emotion(1,38)>Si eso, fabrícame algo a mí también, anda."
msgstr "<$voicel(1,5)><$comeff(1,5)><$motion(1,803)>¡Estás hech<gen;-2(o,a)> <gen;-2(un,una)> crack, <gen;-2(bro,sis)>! ¡No hay objeto que se<br>te resista! <$voicel(1,7)><$emotion(1,38)>Si puedes, fabrícame algo a mí también."

#. en: <$voicel(1,7)><$emotion(1,14)>So I’m all done for the day? OK! I hope ya come and see<br>me next time, pal!
msgctxt "1968:516"
msgid "<$voicel(1,7)><$emotion(1,14)>¡Se acabó lo que se daba! Cierro el chiringuito, pues,<br>pero no te preocupes, ¡que volveré a abrir otro día!"
msgstr "<$voicel(1,7)><$emotion(1,14)>¡Se acabó lo que se daba! Cierro el puesto, pues,<br>pero no te preocupes, ¡que volveré a abrir otro día!"

#. en: <$voicel(1,7)><$emotion(1,49)>Well look who it is! You wanna come <$cdef(27)><$spwfull(12)></color> with<br>me, <$cdef(27)><pname;0></color>?
msgctxt "1968:517"
msgid "<oneline><$voicel(1,7)><$emotion(1,49)>¡Pero si es <$cdef(27)><pname;0></color>! ¿Te animas<br>a <$cdef(27)><$spwfull(12)></color> un poco?"
msgstr ""

#. en: <oneline><$voicel(1,7)><$emotion(1,49)>Yo, sounds like <$cdef(27)><shoppk;0></color>’s at the <$cdef(27)><fqty(1)><$ifull(1325)></color>!<br>Who<slide><br>knows<slide><br>what’s<slide><br>up<slide><br>for grabs.
msgctxt "1968:518"
msgid "<$cdef(27)><oneline><$voicel(1,7)><$emotion(1,49)></color>¡He oído que está <dart;0()><$cdef(27)><shoppk;0></color> en<br>la <$cdef(27)><fqty(1)><$ifull(1325)></color>!<slide><br>Me pregunto qué habrá traído..."
msgstr "<$cdef(27)><oneline><$voicel(1,7)><$emotion(1,49)></color>¡Oí que está <dart;0()><$cdef(27)><shoppk;0></color> en<br>la <$cdef(27)><fqty(1)><$ifull(1325)></color>!<slide><br>Me pregunto qué habrá traído..."

#. en: <$comeff(1,10)><$facial(1,4)><$voicel(1,7)>It’s nice to just go with the flow every now and then and<br>let the waves carry you wherever, y’know?<clear><br><$emotion(1,65)><$voicel(1,5)>Sometimes you can even find cool stuff in spots you don’t<br>usually pay attention to.
msgctxt "1968:520"
msgid "<$comeff(1,10)><$facial(1,4)><$voicel(1,7)>De vez en cuando me mola dejar que las olas me lleven<br>adonde ellas quieran.<clear><br><$emotion(1,65)><$voicel(1,5)>Es una buena forma de llegar a sitios a los que no me<br>había planteado ir. ¡Incluso encuentro cosas guapísimas!"
msgstr "<$comeff(1,10)><$facial(1,4)><$voicel(1,7)>De vez en cuando me gusta dejar que las olas me lleven<br>adonde ellas quieran.<clear><br><$emotion(1,65)><$voicel(1,5)>Es una buena forma de llegar a lugares a los que no me<br>había planteado ir. ¡Incluso encuentro cosas increíbles!"

#. en: <$voicel(1,7)><$emotion(1,38)>Hey, there’s way more grass and stuff now, thanks to all<br>your watering. Nice work, pal!
msgctxt "1968:521"
msgid "<$voicel(1,7)><$emotion(1,38)>¡Gracias a ti, está todo verde que flipas!"
msgstr "<$voicel(1,7)><$emotion(1,38)>¡Gracias a ti, todo está verde como nunca!"

#. en: <$voicel(1,7)><$emotion(1,14)>Hey, check out this thing I found. You want it? Take it!
msgctxt "1968:522"
msgid "<$voicel(1,7)><$emotion(1,14)>¡Mira lo que he encontrado! ¡Te lo regalo, herman<gen;-2(o,a)>!"
msgstr "<$voicel(1,7)><$emotion(1,14)>¡Mira lo que encontré! ¡Te lo regalo, herman<gen;-2(o,a)>!"

#. en: <oneline><$voicel(1,9)><$emotion(1,8)>Me and <$cdef(27)><nlpairpk;0></color> get along real well! We always<br>have<slide><br>fun<slide><br>together,<slide><br>no<slide><br>matter<slide><br>what<slide><br>we do!<clear><br><$voicel(1,7)><$emotion(1,49)>We usually end up talkin’ about you. Like how cool and<br>amazing you are!
msgctxt "1968:523"
msgid "<oneline><$voicel(1,9)><$emotion(1,8)><fcap><dart;0()><$cdef(27)><nlpairpk;0></color> y yo nos lo pasamos genial siempre<br>haciendo<slide><br>cualquier cosa.<clear><br><$voicel(1,7)><$emotion(1,49)>Y solemos acabar chismorreando de ti, en plan:<br>\"Buah, pero cómo se puede ser tan crack, ya quisiera yo\"."
msgstr "<oneline><$voicel(1,9)><$emotion(1,8)><fcap><dart;0()><$cdef(27)><nlpairpk;0></color> y yo nos la pasamos genial siempre<br>haciendo<slide><br>cualquier cosa.<clear><br><$voicel(1,7)><$emotion(1,49)>Y solemos acabar chismeando de ti, algo como:<br>\"Guau, pero cómo se puede ser tan crack, ya quisiera yo\"."

#. en: <oneline><$voicel(1,7)><$comeff(1,9)><$motion(1,661)><$facial(1,4)>I’m lovin’ <qty;1(that,those)><br><$cdef(27)><fqty(1)><class><nlqueitem;1></color><slide><$cdef(27)><br></color>you<slide><br>gave<slide><br>me, pal!<clear><br><$voicel(1,5)><$comeff(1,10)><$motion(1,806)>No clue why, but just lookin’ at <qty;1(it,them)> fills me with energy!
msgctxt "1968:524"
msgid "<oneline><$voicel(1,7)><$comeff(1,9)><$motion(1,661)><$facial(1,4)>¡Buah, me flip<qty;1(a,an)><br><dart;1()><$cdef(27)><fqty(1)><class><nlqueitem;1></color><slide><br>que me diste!<slide><br><$voicel(1,5)><$comeff(1,10)><$motion(1,806)>¡Solo con verl<genqty;1(o,a,os,as)>, me motivo mazo!"
msgstr "<oneline><$voicel(1,7)><$comeff(1,9)><$motion(1,661)><$facial(1,4)>¡Guau, me encant<qty;1(a,an)><br><dart;1()><$cdef(27)><fqty(1)><class><nlqueitem;1></color><slide><br>que me diste!<slide><br><$voicel(1,5)><$comeff(1,10)><$motion(1,806)>¡Solo verl<genqty;1(o,a,os,as)> me motiva un montón!"

#. en: <$voicel(1,5)><$emotion(1,14)>Hey, you know how to make houses like the ones humans<br>lived in, right, <$cdef(27)><pname;0></color>?<clear><br><$voicel(1,9)><$emotion(1,39)>Dang, that’s super cool! I’d love <$voicel(1,8)><$emotion(1,49)>to try livin’ in a house like<br>that, even if it’s not forever!
msgctxt "1968:525"
msgid "<oneline><$voicel(1,5)><$emotion(1,14)>Ey, <$cdef(27)><pname;0></color>, tú sabes construir casas<br>como esas que<slide><br>tenían los humanos,<slide><br>¿verdad?<clear><br><$voicel(1,9)><$emotion(1,39)>¡Qué flipe! A mí me haría una ilusión loca vivir en una<br>casa así, <$voicel(1,8)><$emotion(1,49)>¡aunque fuera solo un día o dos!"
msgstr "<oneline><$voicel(1,5)><$emotion(1,14)>Ey, <$cdef(27)><pname;0></color>, tú sabes construir casas<br>como esas que<slide><br>tenían los humanos,<slide><br>¿verdad?<clear><br><$voicel(1,9)><$emotion(1,39)>¡Qué increíble! A mí me encantaría vivir en una<br>casa así, <$voicel(1,8)><$emotion(1,49)>¡aunque fuera solo un día o dos!"

#. en: <$voicel(1,5)><$comeff(1,14)><$motion(1,805)>Last night, I dreamed I had a real tasty snack—but I woke<br>up before I could take a bite...<clear><br><$voicel(1,7)><$emotion(1,49)>Guess I’ve gotta dream up part two of the snack<br>saga tonight!
msgctxt "1968:526"
msgid "<$voicel(1,5)><$comeff(1,14)><$motion(1,805)>Buah, anoche soñé que me iba a dar un festín flipante<br>y de repente me he despertado.<clear><br><$voicel(1,7)><$emotion(1,49)>¡Qué rabia! A ver si continúa esta noche..."
msgstr "<$voicel(1,5)><$comeff(1,14)><$motion(1,805)>Uf, anoche soñé que me iba a dar un festín increíble<br>y de repente me desperté.<clear><br><$voicel(1,7)><$emotion(1,49)>¡Qué rabia! A ver si continúa esta noche..."

#. en: <oneline><$voicel(1,5)><$emotion(1,14)>You always look so peaceful, <$cdef(27)><pname;0></color>. I<br>get<slide><br>sleepy<slide><br>just<slide><br>lookin’<slide><br>at ya...<clear><br><$voicel(1,3)><$comeff(1,16)><$motion(1,805)><$facial(1,9)>*yawn* Not sure I’m gonna make it till morning...
msgctxt "1968:527"
msgid "<$cdef(27)><$voicel(1,5)></color><$emotion(1,14)>Cuando veo ese careto tuyo sin preocupaciones me entra<br>un sueño...<clear><br><$voicel(1,3)><$comeff(1,16)><$motion(1,805)><$facial(1,9)>Uaaah... A ver si aguanto un par de horitas más al menos..."
msgstr "<$cdef(27)><$voicel(1,5)></color><$emotion(1,14)>Cuando veo esa cara tuya sin preocupaciones me entra<br>un sueño...<clear><br><$voicel(1,3)><$comeff(1,16)><$motion(1,805)><$facial(1,9)>Uaaah... A ver si aguanto un par de horitas más al menos..."

#. en: <$voicel(1,7)><$comeff(1,10)><$motion(1,803)><$facial(1,4)>Pro tip: the best time to go flying is right before dawn.<clear><br><$voicel(1,5)><$emotion(1,39)>You watch the sky get brighter and brighter, then BAM!<br>Your own personal sunrise.
msgctxt "1968:528"
msgid "<$voicel(1,7)><$comeff(1,10)><$motion(1,803)><$facial(1,4)>Si vas a volar, te recomiendo hacerlo al amanecer.<br>No hay nada como ver el cielo iluminarse poco a poco.<slide><br><$voicel(1,5)><$emotion(1,39)>¡Es como si saliera el sol solo para ti!"
msgstr ""

#. en: <$comeff(1,3)><$motion(1,806)><$voicel(1,5)>I like hangin’ out with my poisonous pals! Feels like I can<br>really let loose.<clear><br><$emotion(1,37)><$voicel(1,7)>Even if I slip up and get some poison on ’em, they never<br>look too upset about it.
msgctxt "1968:530"
msgid "<$comeff(1,3)><$motion(1,806)><$voicel(1,5)>Me flipa jugar con otros Pokémon venenosos como yo.<br>¿Adivinas por qué?<clear><br><$emotion(1,37)><$voicel(1,7)>¡Es que así no tengo que rayarme si los rocío con veneno<br>sin querer!"
msgstr "<$comeff(1,3)><$motion(1,806)><$voicel(1,5)>Me encanta jugar con otros Pokémon venenosos como yo.<br>¿Adivinas por qué?<clear><br><$emotion(1,37)><$voicel(1,7)>¡Es que así no tengo que preocuparme si los rocío<br>con veneno sin querer!"

#. en: <$voicel(1,7)><$emotion(1,14)>Sometimes fluffy Pokémon cuddle up and fall asleep<br>right next to me.<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,666)><$facial(1,14)>Not gonna lie... I’m a little jealous of how cozy they look.
msgctxt "1968:532"
msgid "<$voicel(1,7)><$emotion(1,14)>A veces vienen Pokémon de cuerpo blandito a dormirse<br>a mis costados.<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,666)><$facial(1,14)>Me dan mucha envidia, todos durmiendo como angelitos<br>acurrucados entre sí."
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,27)>If a big Pokémon asks you for “just a bite” of something,<br>watch out.<clear><br><$voicel(1,5)><$comeff(1,7)><$motion(1,806)>Their “bites” are on a whole other level!
msgctxt "1968:533"
msgid "<$voicel(1,7)><$emotion(1,27)>Mucho cuidado con dar a probar tu comida a un Pokémon<br>grandullón.<clear><br><$voicel(1,5)><$comeff(1,7)><$motion(1,806)>Te dicen que es solo un bocadito, pero con ese tamaño,<br>¡menudos bocados pegan!"
msgstr "<$voicel(1,7)><$emotion(1,27)>Mucho cuidado con dar a probar tu comida a un Pokémon<br>grandullón.<clear><br><$voicel(1,5)><$comeff(1,7)><$motion(1,806)>Te dicen que es solo un bocadito, pero con ese tamaño,<br>¡qué bocados dan!"

#. en: <$voicel(1,7)><$comeff(1,3)><$motion(1,806)>Gotta say, I like being big and all, but <$voicel(1,5)><$comeff(1,14)><$motion(1,666)>sometimes it can<br>be a hassle.<clear><br><$voicel(1,4)><$comeff(1,7)><$facial(1,9)>Like not bein’ able to squeeze through narrow spaces, or<br>breakin’ stuff when I move around in my sleep...<clear><br><$voicel(1,7)><$emotion(1,49)>Times like that make me wonder if being small’s the way<br>to go, y’know?
msgctxt "1968:534"
msgid "<$voicel(1,7)><$comeff(1,3)><$motion(1,806)>A mí no me importa ser de cuerpo grande, pero tiene<br>sus inconvenientes.<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,666)>A veces no puedo pasar por caminos estrechos,<br>y, si me muevo al dormir, aplasto cosas sin querer.<clear><br><$voicel(1,4)><$comeff(1,7)><$facial(1,9)>Puede ser una verdadera movida, com<gen;-2(padre,adre)>.<br><$voicel(1,7)><$emotion(1,49)>A veces me pregunto si sería mejor ser pequeñ<gen;-3(o,a)>."
msgstr "<$voicel(1,7)><$comeff(1,3)><$motion(1,806)>A mí no me importa ser de cuerpo grande, pero tiene<br>sus inconvenientes.<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,666)>A veces no puedo pasar por caminos estrechos,<br>y, si me muevo al dormir, aplasto cosas sin querer.<clear><br><$voicel(1,4)><$comeff(1,7)><$facial(1,9)>Puede ser un verdadero lío, com<gen;-2(padre,adre)>.<br><$voicel(1,7)><$emotion(1,49)>A veces me pregunto si sería mejor ser pequeñ<gen;-3(o,a)>."

#. en: <$voicel(1,7)><$comeff(1,3)><$motion(1,803)>Y’know, folks tend to huddle around me on cold days.<clear><br><$voicel(1,7)><$comeff(1,17)><$facial(1,14)><$motion(1,805)>But on hot ones, they keep their distance... Gotta say, that<br>makes me feel a little sad.
msgctxt "1968:535"
msgid "<$voicel(1,7)><$comeff(1,3)><$motion(1,803)>Los días fríos, la gente se me pega como si no hubiera<br>un mañana.<clear><br><$voicel(1,7)><$comeff(1,17)><$facial(1,14)><$motion(1,805)>Ah, pero los días de calor... Entonces nadie quiere saber<br>nada de mí. Es un poco triste."
msgstr ""

#. en: <$voicel(1,5)><$emotion(1,14)>You ever notice how the ocean never runs outta water,<br>not even after a streak of ridiculously hot weather?<clear><br><$voicel(1,3)><$comeff(1,6)><$motion(1,666)>I’m not complainin’, but like, what the heck’s up with that?
msgctxt "1968:536"
msgid "<$voicel(1,5)><$emotion(1,14)>Por mucho que pegue el sol sin parar, el agua del mar<br>nunca desaparece...<clear><br><$voicel(1,3)><$motion(1,666)>Y menos mal, oye, pero... <$comeff(1,6)>¿tú sabes por qué?"
msgstr ""

#. en: <$voicel(1,9)><$comeff(1,5)><$motionoff(1,804)>When I’m feelin’ annoyed or frustrated, I just charge up<br>my electricity, then let it all out!<clear><br><$voicel(1,7)><$emotion(1,49)>It helps clear my mind, plus all my electric-lovin’ pals get a<br>real kick out of it! Win-win!
msgctxt "1968:538"
msgid "<$voicel(1,9)><$comeff(1,5)><$motionoff(1,804)>¡Cuando me pillo un cabreo, lanzo unas descargas<br>que no veas!<clear><br><$voicel(1,7)><$emotion(1,49)>Me quedo muy a gusto, y como a algunos Pokémon<br>les mola absorber electricidad, salimos todos ganando."
msgstr "<$voicel(1,9)><$comeff(1,5)><$motionoff(1,804)>¡Cuando me enojo, lanzo unas descargas<br>tremendas!<clear><br><$voicel(1,7)><$emotion(1,49)>Me quedo muy a gusto, y como a algunos Pokémon<br>les gusta absorber electricidad, salimos todos ganando."

#. en: <$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Y’know what rules? Spendin’ the whooole day gazin’ at the<br>sky. <wait(1.0)><$voicel(1,4)><$comeff(1,17)><$motion(1,806)><$facial(1,14)>You just kick back, relax, and let time drift by...<clear><br><$voicel(1,5)><$emotion(1,29)><$facial(1,1)>Now I kinda wanna know what it’s like spendin’ all day<br>gazin’ at the ground.
msgctxt "1968:542"
msgid "<$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Pasarse un día entero mirando al cielo tampoco está<br>nada mal, eeeh. <$voicel(1,4)><$comeff(1,17)><$motion(1,806)><$facial(1,14)>Dejar pasar los segundos uno a uno...<clear><br><$voicel(1,5)><$emotion(1,29)><$facial(1,1)>¿Cómo será pasarse el día entero mirando al suelo?"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,49)>Seems like whenever I see ya, you’re always runnin’ around<br>doin’ something.<clear><br><$voicel(1,5)><$comeff(1,6)><$motion(1,666)>Lemme guess—you’re tryin’ to copy how humans look AND<br>how they act, right?
msgctxt "1968:543"
msgid "<$voicel(1,7)><$emotion(1,49)>Madre mía, siempre andas de aquí p'allá, com<gen;-2(padre,adre)>.<clear><br><$voicel(1,5)><$comeff(1,6)><$motion(1,666)>No será que estás imitando a los humanos también<br>en eso, ¿no?"
msgstr "<$voicel(1,7)><$emotion(1,49)>Cielos, siempre andas de aquí para allá, com<gen;-2(padre,adre)>.<clear><br><$voicel(1,5)><$comeff(1,6)><$motion(1,666)>No será que estás imitando a los humanos también<br>en eso, ¿no?"

#. en: <$voicel(1,7)><$emotion(1,49)>The best way to eat a berry is...<wait(0.8)>slowly! That way you can<br>enjoy the taste longer AND it’ll make ya feel full!<clear><br><$voicel(1,4)><$comeff(1,14)><$motion(1,805)><$facial(1,1)>That said... <wait(1.5)><$voicel(1,7)><$comeff(1,5)><$motionoff(1,804)><$facial(1,4)>I just can’t resist when there’s berries in front<br>of me! I always gobble ’em right up!
msgctxt "1968:544"
msgid "<$voicel(1,7)><$emotion(1,49)>Deberías comerte las bayas despacio y masticando bien,<br>así las saboreas mejor y, además, llenan más.<clear><br><$voicel(1,4)><$comeff(1,14)><$motion(1,805)><$facial(1,1)>Bueno, esa es la teoría... <wait(0.9)><$voicel(1,7)><$comeff(1,5)><$motionoff(1,804)><$facial(1,4)>¡porque a mí me pones bayas<br>delante y me las zampo de un bocao sin pensarlo!"
msgstr "<$voicel(1,7)><$emotion(1,49)>Deberías comerte las bayas despacio y masticando bien,<br>así las saboreas mejor y, además, llenan más.<clear><br><$voicel(1,4)><$comeff(1,14)><$motion(1,805)><$facial(1,1)>Bueno, esa es la teoría... <wait(0.9)><$voicel(1,7)><$comeff(1,5)><$motionoff(1,804)><$facial(1,4)>¡porque a mí me pones bayas<br>delante y me las trago de un bocado sin pensarlo!"

#. en: <$voicel(1,5)><$emotion(1,14)>Y’know, it feels like everything tastes better when I eat it<br>in my own home.<clear><br><$voicel(1,7)><$emotion(1,8)>I’m eatin’ good every day now, and it’s all thanks to you,<br><$cdef(27)><pname;0></color>! You rock, pal.
msgctxt "1968:545"
msgid "<$voicel(1,5)><$emotion(1,14)>Yo qué quieres que te diga, la comida sabe mil veces<br>mejor si no te tienes que mover de casa.<clear><br><$voicel(1,7)><$emotion(1,8)>¡Así que gracias por hacer de repartid<gen;-2(or,ora)> todos los días!<br>Haces a mis papilas gustativas muy felices."
msgstr ""

#. en: <$voicel(1,7)><$comeff(1,21)><$facial(1,4)><$motion(1,806)><$cdef(27)><nlpairpk;0></color>’s a good pal of mine.<clear><br><$voicel(1,5)><$emotion(1,49)>Sure, we clash sometimes, but usually we’re back on<br>speaking terms before we know it!
msgctxt "1968:546"
msgid "<oneline><$voicel(1,7)><$comeff(1,21)><$facial(1,4)><$motion(1,806)><fcap><dart;0()><$cdef(27)><nlpairpk;0> </color>y yo somos panas.<clear><br><$voicel(1,5)><$emotion(1,49)>A veces nos peleamos, pero volvemos a hablarnos sin<br>darnos ni cuenta."
msgstr "<oneline><$voicel(1,7)><$comeff(1,21)><$facial(1,4)><$motion(1,806)><fcap><dart;0()><$cdef(27)><nlpairpk;0> </color>y yo somos compas.<clear><br><$voicel(1,5)><$emotion(1,49)>A veces nos peleamos, pero volvemos a hablarnos sin<br>darnos ni cuenta."

#. en: <oneline><$voicel(1,5)><$emotion(1,14)>Hey, <$cdef(27)><pname;0></color>. Remember <qty;1(that,those)><br><$cdef(27)><fqty(1)><class><nlqueitem;1></color><slide><br>you<slide><br>gave<slide><br>me? Well...<clear><br><$voicel(1,7)><$emotion(1,7)><qty;1(It was,They were)> SUPER tasty! Didn’t last long either, that’s<br>for sure!
msgctxt "1968:547"
msgid "<oneline><$voicel(1,5)><$emotion(1,14)>Oye, <gen;-2(bro,sis)>, ¿te acuerdas<br><esde;1()><$cdef(27)><fqty(1)><nlqueitem;1><slide><br></color>que me diste?<slide><br>¡Buah, qué delicia!<slide><br><$voicel(1,7)><$emotion(1,7)>No me dur<qty;1(ó,aron)> ni un segundo."
msgstr "<oneline><$voicel(1,5)><$emotion(1,14)>Oye, <gen;-2(bro,sis)>, ¿te acuerdas<br><esde;1()><$cdef(27)><fqty(1)><nlqueitem;1><slide><br></color>que me diste?<slide><br>¡Guau, qué delicia!<slide><br><$voicel(1,7)><$emotion(1,7)>No me dur<qty;1(ó,aron)> ni un segundo."

#. en: <oneline><$voicel(1,7)><$emotion(1,48)>Y’know, I wanna chat with <$cdef(27)><crstlktar;0></color><br>some more.<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Where do they live, again? Pretty sure it’s nowhere near<br>my place...
msgctxt "1968:548"
msgid "<oneline><$voicel(1,7)><$emotion(1,48)>Me molaría charlar un poco más con<br><dart;0()><$cdef(27)><crstlktar;0></color>.<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,666)>¿Tú no sabrás dónde vive o algo? Me suena que estaba<br>en el quinto pino..."
msgstr "<oneline><$voicel(1,7)><$emotion(1,48)>Me gustaría charlar un poco más con<br><dart;0()><$cdef(27)><crstlktar;0></color>.<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,666)>¿Tú no sabrás dónde vive o algo? Me suena que estaba<br>lejísimos..."

#. en: <oneline><$voicel(1,7)><$emotion(1,14)>I wanna get to know <$cdef(27)><crstlktar;0> </color>better,<br>but<slide><br>it’s<slide><br>rough<slide><br>since<slide><br>they<slide><br>live<slide><br>so<slide><br>far away...<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Wonder if we could figure out a way to get our homes<br>closer to each other...
msgctxt "1968:549"
msgid "<oneline><$voicel(1,7)><$emotion(1,14)>Siempre he querido conocer mejor<br><esa;0()><$cdef(27)><crstlktar;0></color>,<slide><br>pero vive lejos, no, lo siguiente.<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Si viviésemos algo más cerca..."
msgstr "<oneline><$voicel(1,7)><$emotion(1,14)>Siempre he querido conocer mejor<br><esa;0()><$cdef(27)><crstlktar;0></color>,<slide><br>pero vive lejísimos, de verdad.<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Si viviéramos un poco más cerca..."

#. en: <$voicel(1,7)><$emotion(1,49)>Thanks for playin’ along, pal. Here, take this!
msgctxt "1968:550"
msgid "<$voicel(1,7)><$emotion(1,49)>¡Gracias por jugar! Toma, un regalillo por participar<br>y darme bola."
msgstr "<$voicel(1,7)><$emotion(1,49)>¡Gracias por jugar! Toma, un regalito por participar<br>y hacerme caso."

#. en: <$voicel(1,7)><$comeff(1,21)><$motion(1,805)><$facial(1,5)>Gotta say, this house RULES! I love it here, pal!<clear><br><$voicel(1,6)><$emotion(1,49)>Big thanks for making it, <$cdef(27)><pname;1></color>!
msgctxt "1968:551"
msgid "<$voicel(1,7)><$comeff(1,21)><$motion(1,805)><$facial(1,5)>¡Me flipa mi keli, la verdad!<clear><br><$voicel(1,6)><$emotion(1,49)>Y sin ti nunca habría sido una realidad. ¡Te lo agradezco<br>en el alma, <$cdef(27)><pname;1></color>!"
msgstr "<$voicel(1,7)><$comeff(1,21)><$motion(1,805)><$facial(1,5)>¡Me encanta mi casa, la verdad!<clear><br><$voicel(1,6)><$emotion(1,49)>Y sin ti nunca habría sido una realidad. ¡Te lo agradezco<br>en el alma, <$cdef(27)><pname;1></color>!"

#. en: <$voicel(1,8)><$emotion(1,14)>OK, try and guess this one!<clear><br><$voicel(1,5)><$comeff(1,6)>What’s <$cdef(27)><qtargetpk;0></color>’s favorite flavor?
msgctxt "1968:552"
msgid "<$voicel(1,8)><$emotion(1,14)>¡Vaaa! ¡Que está tirada!<clear><br><$voicel(1,5)><$comeff(1,6)>¿Cuál es el sabor favorito <esde;0()><$cdef(27)><qtargetpk;0></color>?"
msgstr "<$voicel(1,8)><$emotion(1,14)>¡Vamooos! ¡Que está facilísima!<clear><br><$voicel(1,5)><$comeff(1,6)>¿Cuál es el sabor favorito <esde;0()><$cdef(27)><qtargetpk;0></color>?"

#. en: That’s...<wait(0.4)><$voicel(1,7)><$comeff(1,20)><$motion(1,803)><$facial(1,4)>right! Way to go, <$cdef(27)><pname;0></color>!
msgctxt "1968:554"
msgid "<oneline>...<wait(0.4)><$voicel(1,7)><$comeff(1,20)><$motion(1,803)><$facial(1,4)> ¡Correcto! ¡Vaya listill<gen;-2(o,a)> estás hech<gen;-2(o,a)>,<br><$cdef(27)><pname;0></color>!"
msgstr "<oneline>...<wait(0.4)><$voicel(1,7)><$comeff(1,20)><$motion(1,803)><$facial(1,4)> ¡Correcto! ¡Qué list<gen;-2(o,a)>,<br>estás hech<gen;-2(o,a)> un crack, <$cdef(27)><pname;0></color>!"

#. en: That’s...<wait(0.4)><$voicel(1,8)><$comeff(1,3)><$motion(1,803)>not the right answer. Too bad!<clear><br><$voicel(1,6)><$comeff(1,10)>It’s actually <$cdef(27)><ltasteq;0></color>! Wild, right?<clear><br><$voicel(1,7)><$emotion(1,8)>I’ll think up more questions for next time!
msgctxt "1968:555"
msgid "...<wait(0.4)><$voicel(1,8)><$comeff(1,3)><$motion(1,803)> ¡Pues nop!<clear><br><$voicel(1,6)><$comeff(1,10)>¡La respuesta correcta era el <$cdef(27)><ltasteq;0></color>!<br><$voicel(1,7)><$emotion(1,8)>Voy a ir pensando la próxima pregunta, ¿ok?"
msgstr ""

#. en: <$voicel(1,8)><$emotion(1,14)>OK, try and guess this one!<clear><br><$voicel(1,5)><$comeff(1,6)>What flavor does <$cdef(27)><qtargetpk;0></color> hate the most?
msgctxt "1968:557"
msgid "<oneline><$voicel(1,8)><$emotion(1,14)>Fijo que te la sabes... ¡Pero vamos allá!<clear><br><$voicel(1,5)><$comeff(1,6)>¿Cuál es el sabor que menos le gusta<br><esa;0()><$cdef(27)><qtargetpk;0></color>?"
msgstr "<oneline><$voicel(1,8)><$emotion(1,14)>Seguro que te la sabes... ¡Pero ahí va!<clear><br><$voicel(1,5)><$comeff(1,6)>¿Cuál es el sabor que menos le gusta<br><esa;0()><$cdef(27)><qtargetpk;0></color>?"

#. en: That’s...<wait(0.4)><$voicel(1,7)><$comeff(1,20)><$motion(1,801)><$facial(1,4)>right! Way to go, <$cdef(27)><pname;0></color>!
msgctxt "1968:559"
msgid "<oneline>...<wait(0.4)><$voicel(1,7)><$comeff(1,20)><$motion(1,801)><$facial(1,4)> ¡Correcto! ¡Ya sabía yooo!"
msgstr ""

#. en: That’s...<wait(0.4)><$voicel(1,8)><$comeff(1,3)><$motion(1,803)>not the right answer. Too bad!<clear><br><$voicel(1,6)><$comeff(1,10)>It’s actually <$cdef(27)><htasteq;0></color>! Wild, right?<clear><br><$voicel(1,7)><$emotion(1,8)>I’ll think up more questions for next time!
msgctxt "1968:560"
msgid "...<wait(0.4)><$voicel(1,8)><$comeff(1,3)><$motion(1,803)> ¡Errooor!<clear><br><$voicel(1,6)><$comeff(1,10)>¡La respuesta correcta era <dart;0()><$cdef(27)><htasteq;0></color>!<clear><br><$voicel(1,7)><$emotion(1,8)>No te rayes que otro día te pregunto otra cosa, ¡y seguro<br>que esa te la sabes!"
msgstr "...<wait(0.4)><$voicel(1,8)><$comeff(1,3)><$motion(1,803)> ¡Errooor!<clear><br><$voicel(1,6)><$comeff(1,10)>¡La respuesta correcta era <dart;0()><$cdef(27)><htasteq;0></color>!<clear><br><$voicel(1,7)><$emotion(1,8)>No te preocupes, que otro día te pregunto otra cosa,<br>¡y seguro que esa te la sabes!"

#. en: <$voicel(1,8)><$emotion(1,14)>OK, try and guess this one!<clear><br><$voicel(1,5)><$comeff(1,6)>What kinda stuff does <$cdef(27)><qtargetpk;0></color> like?
msgctxt "1968:562"
msgid "<$voicel(1,8)><$emotion(1,14)>¡Jua, jua! Si es que te apuntas a un bombardeo. ¡Va!<clear><br><$voicel(1,5)><$comeff(1,6)>¿Qué le gusta <esa;0()><$cdef(27)><qtargetpk;0></color>?"
msgstr "<$voicel(1,8)><$emotion(1,14)>¡Jua, jua! Es que te animas a todo. ¡Ahí va!<clear><br><$voicel(1,5)><$comeff(1,6)>¿Qué le gusta <esa;0()><$cdef(27)><qtargetpk;0></color>?"

#. en: Thaaat’s...<wait(0.4)><wait(0.4)><$voicel(1,7)><$comeff(1,20)><$motion(1,801)><$facial(1,4)>right! Way to go, <$cdef(27)><pname;0></color>!
msgctxt "1968:564"
msgid "Has... <wait(0.4)><wait(0.4)><$voicel(1,7)><$comeff(1,20)><$motion(1,801)><$facial(1,4)>¡acertado! ¡Menud<gen;-2(o,a)> eres, <$cdef(27)><pname;0></color>!"
msgstr "Has... <wait(0.4)><wait(0.4)><$voicel(1,7)><$comeff(1,20)><$motion(1,801)><$facial(1,4)>¡acertado! ¡Qué list<gen;-2(o,a)> eres, <$cdef(27)><pname;0></color>!"

#. en: Thaaat’s...<wait(0.4)><$voicel(1,8)><$comeff(1,3)><$motion(1,803)>not the right answer. Too bad!<clear><br><$voicel(1,6)><$comeff(1,10)>It’s actually <$cdef(27)><likemtag;0></color>! Wild, right?<clear><br><$voicel(1,7)><$emotion(1,8)>I’ll think up more questions for next time!
msgctxt "1968:565"
msgid "Has... <wait(0.4)><$voicel(1,8)><$comeff(1,3)><$motion(1,803)>¡fallado!<clear><br><$voicel(1,6)><$comeff(1,10)>¡La respuesta correcta era <dart;0()><$cdef(27)><likemtag;0></color>!<clear><br><$voicel(1,7)><$emotion(1,8)>A ver si tienes más suerte la próxima vez. Iré pensando<br>la siguiente pregunta."
msgstr ""

#. en: <$voicel(1,8)><$motion(1,661)><$comeff(1,3)><$facial(1,4)>See ya, pal! Let’s hang out again soon.
msgctxt "1968:566"
msgid "<$voicel(1,8)><$motion(1,661)><$comeff(1,3)><$facial(1,4)>¡Talueee!"
msgstr "<$voicel(1,8)><$motion(1,661)><$comeff(1,3)><$facial(1,4)>¡Chaooo!"

#. en: <oneline><$voicel(1,7)><$comeff(1,6)><$motion(1,805)>Hey <$cdef(27)><pname;0></color>, you got any<br><$cdef(27)><fqty(2)><class><refmateid;1></color><slide><br>on ya?<clear><br><$voicel(1,5)><$emotion(1,49)>Just sayin’ if you hand ’em over to me, I can turn ’em into<br><$cdef(27)><fqty(2)><class><reftarid;3></color> for ya!
msgctxt "1968:569"
msgid "<oneline><$voicel(1,7)><$comeff(1,6)><$motion(1,805)>¿Llevas alg<genqty;1(ún,una,unos,unas)><br><$cdef(27)><fqty(1)><class><refmateid;1></color><slide><br>encima?<clear><br><$voicel(1,5)><$emotion(1,49)>Puedo usar<genqty;1(lo,la,los,las)> para hacer<br><fqty(2)><$cdef(27)><class><reftarid;3></color>."
msgstr ""

#. en: <oneline><$voicel(1,5)><$comeff(1,14)><$motion(1,666)><$cdef(27)><fqty(2)><fcap><class><referrmate;0></color>, huh?<br>That<slide><br>kinda<slide><br>stuff’s<slide><br>way<slide><br>over<slide><br>my head.<clear><br><$voicel(1,8)><$emotion(1,49)>But I bet it’s right up <$cdef(27)><referrpk;2></color>’s alley!
msgctxt "1968:570"
msgid "<oneline><$voicel(1,5)><$comeff(1,14)><$motion(1,666)>¿<fcap><iart;0()><fqty(1)><$cdef(27)><class><referrmate;0></color>?<br>Buf, la verdad es<slide><br>que eso se me escapa...<clear><br><$voicel(1,8)><$emotion(1,49)>¡Aunque creo que <dart;2()><$cdef(27)><referrpk;2></color> sí entiende del<br>tema!"
msgstr ""

#. en: <oneline><$voicel(1,5)><$comeff(1,14)><$motion(1,666)><$cdef(27)><fqty(2)><fcap><class><referrmate;0></color>, huh?<br>That<slide><br>kinda<slide><br>stuff’s<slide><br>way<slide><br>over<slide><br>my head.<clear><br><$voicel(1,4)><$comeff(1,7)><$motion(1,807)>And I’ve got no clue who’d know more about it...
msgctxt "1968:571"
msgid "<oneline><$voicel(1,5)><$comeff(1,14)><$motion(1,666)>¿<fcap><iart;0()><$cdef(27)><fqty(1)><class><referrmate;0></color>?<br>Buf, la verdad es<slide><br>que eso se me escapa...<clear><br><$voicel(1,4)><$comeff(1,7)><$motion(1,807)>Tampoco se me ocurre nadie que pueda echarte una<br>mano..."
msgstr ""

#. en: <oneline><$voicel(1,5)><$comeff(1,14)><$motion(1,666)><$cdef(27)><fqty(2)><fcap><class><referrmate;0></color>, huh?<br>That<slide><br>kinda<slide><br>stuff’s<slide><br>way<slide><br>over<slide><br>my head.<clear><br><$voicel(1,7)><$emotion(1,14)>BUT I could probably turn any<br><$cdef(27)><fqty(2)><class><refmateid;3></color><slide><br>you’ve<slide><br>got<slide><br>into<slide><br><$voicel(1,6)><$cdef(27)><fqty(2)><class><reftarid;4></color><slide><br>for ya...<clear><br><$voicel(1,4)><$comeff(1,6)>Want me to do that instead?
msgctxt "1968:572"
msgid "<oneline><$voicel(1,5)><$comeff(1,14)><$motion(1,666)>¿<fcap><iart;0()><fqty(1)><$cdef(27)><class><referrmate;0></color>?<br>Buf, la verdad es<slide><br>que eso se me escapa...<clear><br><$voicel(1,7)><$emotion(1,14)>Pero veo que llevas alg<genqty;3(ún,una,unos,unas)><br><$cdef(27)><fqty(1)><class><refmateid;3></color>...<clear><br><$voicel(1,6)>Con eso te puedo hacer<br><$cdef(27)><fqty(2)><class><reftarid;4></color>.<slide><br><$voicel(1,4)><$comeff(1,6)>¿Te parece?"
msgstr ""

#. en: <oneline><$voicel(1,6)><$emotion(1,29)>So ya need<br><$cdef(27)><fqty(2)><class><reftarid;0></color>?<clear><br><oneline><$voicel(1,7)><$comeff(1,10)><$motion(1,806)>No prob! Just put some<br><$cdef(27)><fqty(2)><class><refmateid;2></color><slide><br>in the<slide><br><$voicel(1,6)><$cdef(27)><fqty(1)><reftable;1></color><slide><br>for me.<slide><br><$voicel(1,8)><$emotion(1,14)>I’ll<slide><br>handle<slide><br>it later!
msgctxt "1968:573"
msgid "<oneline><$voicel(1,6)><$emotion(1,29)>¿Necesitas<br><fqty(2)><$cdef(27)><class><reftarid;0></color>?<clear><br><$voicel(1,7)><$comeff(1,10)><$motion(1,806)>Déjame<br><dart;2()><$cdef(27)><fqty(1)><class><refmateid;2></color><slide><br>en <dart;1()><$cdef(27)><fqty(1)><class><reftable;1></color><slide><br><$voicel(1,6)>y yo me encargo del resto.<clear><br><$voicel(1,8)><$emotion(1,14)>¡Tú confía, que yo de esto controlo!"
msgstr "<oneline><$voicel(1,6)><$emotion(1,29)>¿Necesitas<br><fqty(2)><$cdef(27)><class><reftarid;0></color>?<clear><br><$voicel(1,7)><$comeff(1,10)><$motion(1,806)>Déjame<br><dart;2()><$cdef(27)><fqty(1)><class><refmateid;2></color><slide><br>en <dart;1()><$cdef(27)><fqty(1)><class><reftable;1></color><slide><br><$voicel(1,6)>y yo me encargo del resto.<clear><br><$voicel(1,8)><$emotion(1,14)>¡Tú confía, que yo de esto sé!"

#. en: <oneline><$voicel(1,5)><$comeff(1,14)><$motion(1,666)>I’m gonna need<br><iart;1()><$cdef(27)><fqty(1)><class><reftable;1></color><slide><$cdef(27)><br></color>if I’m<slide><br>gonna<slide><br>make<slide><br><$cdef(27)><fqty(2)><class><reftarid;0></color>...<clear><br><oneline><$voicel(1,7)><$emotion(1,14)>Think you can get me<br><iart;2()><$cdef(27)><fqty(1)><class><reftable;2></color>?
msgctxt "1968:574"
msgid "<$cdef(27)><oneline></color><$voicel(1,5)><$comeff(1,14)><$motion(1,666)>No puedo hacer<br><fqty(2)><$cdef(27)><class><reftarid;0> </color>sin<slide><br><iart;1()><$cdef(27)><fqty(1)><class><reftable;1></color>,<slide><br>me temo...<clear><br><$voicel(1,7)><$emotion(1,14)>Si apañas <genqty;1(uno,una,unos,unas)>, yo te ayudo encantad<gen;-3(o,a)>."
msgstr "<$cdef(27)><oneline></color><$voicel(1,5)><$comeff(1,14)><$motion(1,666)>No puedo hacer<br><fqty(2)><$cdef(27)><class><reftarid;0> </color>sin<slide><br><iart;1()><$cdef(27)><fqty(1)><class><reftable;1></color>,<slide><br>me temo...<clear><br><$voicel(1,7)><$emotion(1,14)>Si tienes <genqty;1(uno,una,unos,unas)>, yo te ayudo encantad<gen;-3(o,a)>."

#. en: <oneline><$voicel(1,9)><$emotion(1,8)>Lemme tell ya, I’m in rare form today, pal! Check out this<br>other cool stuff I made!<clear><br><$voicel(1,8)><$emotion(1,49)>Go on, take it!
msgctxt "1968:575"
msgid "<$voicel(1,9)><$emotion(1,8)>Buah, y mira esto también. Hoy estoy que me salgo.<br><wait(1.0)><$voicel(1,8)><$emotion(1,49)>¡Ahí lo llevas!"
msgstr "<$voicel(1,9)><$emotion(1,8)>Guau, y mira esto también. Hoy estoy imparable.<br><wait(1.0)><$voicel(1,8)><$emotion(1,49)>¡Ahí lo tienes!"

#. en: <$voicel(1,7)><$emotion(1,14)>Oh, right! This is for you. I picked it up on the way.
msgctxt "1968:576"
msgid "<$voicel(1,7)><$emotion(1,14)>¡Ah, toma, para ti! ¡Me lo he encontrado por el camino!"
msgstr "<$voicel(1,7)><$emotion(1,14)>¡Ah, toma, para ti! ¡Me lo encontré por el camino!"

#. en: <oneline><$voicel(1,7)><$emotion(1,27)>There you are, <$cdef(27)><pname;0></color>! Great news—we<br>finished<slide><br>building<slide><br>the<slide><br><$cdef(27)><cdirbname;1></color>!<clear><br><$voicel(1,6)><$emotion(1,38)>Check it out!
msgctxt "1968:585"
msgid "<oneline><$voicel(1,7)><$emotion(1,27)>¡Eeey, <$cdef(27)><pname;0></color>!<br>¡Hemos terminado<slide><br><dart;1()><$cdef(27)><cdirbname;1></color>!<slide><br><$voicel(1,6)><$emotion(1,38)>¡Échal<qty;1(e,es)> un vistazo!"
msgstr "<oneline><$voicel(1,7)><$emotion(1,27)>¡Eeey, <$cdef(27)><pname;0></color>!<br>¡Terminamos<slide><br><dart;1()><$cdef(27)><cdirbname;1></color>!<slide><br><$voicel(1,6)><$emotion(1,38)>¡Échal<qty;1(e,es)> un vistazo!"

#. en: <$voicel(1,7)><$comeff(1,1)><$motion(1,806)>You ready for the big reveal? Here we go!
msgctxt "1968:586"
msgid "<$voicel(1,7)><$comeff(1,1)><$motion(1,806)>¡Hora de la inauguración! ¡Tacháaan!"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,6)>Ha! How’s that? Not too shabby, if I say so myself!<clear><br><$voicel(1,5)><$emotion(1,49)>Lemme know next time you need to <$cdef(27)><$spwfull(1)></color> something!<br>I’d love to help ya out.
msgctxt "1968:587"
msgid "<$voicel(1,7)><$emotion(1,6)>¡Está mal que lo diga yo, pero ha quedado genial!<br>Jua, jua.<clear><br><$voicel(1,5)><$emotion(1,49)>¡Si necesitas <$cdef(27)><$spwfull(1)></color> algo más, cuenta conmigo!"
msgstr "<$voicel(1,7)><$emotion(1,6)>¡Está mal que lo diga yo, pero quedó genial!<br>Jua, jua.<clear><br><$voicel(1,5)><$emotion(1,49)>¡Si necesitas <$cdef(27)><$spwfull(1)></color> algo más, cuenta conmigo!"

#. en: <$voicel(1,7)><$emotion(1,27)><$cdef(27)><pname;0></color>! Play “look that way” with me!
msgctxt "1968:593"
msgid "<oneline><$voicel(1,7)><$emotion(1,27)>¡<$cdef(27)><pname;0></color>! Te reto a un duelo de<br>\"esquiva la baya\", ¡vamos!"
msgstr ""

#. en: <$voicel(1,9)><$emotion(1,1)>Aw yeah, let’s go! Game...ON!
msgctxt "1968:594"
msgid "<$voicel(1,9)><$emotion(1,1)>¡Así se habla, herman<gen;-2(o,a)>! ¡En guardia, que empezamos!"
msgstr ""

#. en: <$voicel(1,6)><$emotion(1,49)>Oh, OK. Another time!
msgctxt "1968:595"
msgid "<$voicel(1,6)><$emotion(1,49)>Qué dices, <gen;-2(bro,sis)>... ¡Pues otro día jugamos!"
msgstr ""

#. en: <oneline><$voicel(1,7)><$emotion(1,27)><$facial(1,13)>I lost? No way! Dang, you’re pretty good at this,<br><$cdef(27)><pname;0></color>!<clear><br><$voicel(1,5)><$comeff(1,10)><$motion(1,806)><$facial(1,4)>Let’s play again sometime, yeah? I gotta redeem myself!
msgctxt "1968:596"
msgid "<oneline><$voicel(1,7)><$emotion(1,27)><$facial(1,13)>¡Buah, chav<gen;-2(al,ala)>! ¡He perdido! ¡Eres imparable,<br><$cdef(27)><pname;0></color>!<clear><br><$voicel(1,5)><$comeff(1,10)><$motion(1,806)><$facial(1,4)>Pero que conste que esto no acaba aquí. ¡Otro día nos<br>echamos la revancha!"
msgstr "<oneline><$voicel(1,7)><$emotion(1,27)><$facial(1,13)>¡Uf, chav<gen;-2(al,ala)>! ¡Perdí! ¡Eres imparable,<br><$cdef(27)><pname;0></color>!<clear><br><$voicel(1,5)><$comeff(1,10)><$motion(1,806)><$facial(1,4)>Pero que conste que esto no acaba aquí. ¡Otro día nos<br>echamos la revancha!"

#. en: <oneline><$voicel(1,7)><$emotion(1,53)>No way! I actually beat <$cdef(27)><pname;0></color>?! Wow,<br>I feel<slide><br>like<slide><br>a genius!<clear><br><$voicel(1,7)><$comeff(1,10)><$motion(1,806)><$facial(1,4)>Let’s play again sometime, yeah? I wanna keep this win<br>streak goin’!
msgctxt "1968:597"
msgid "<$voicel(1,7)><$emotion(1,53)>¡Qué flipe! ¡Te he ganado, <$cdef(27)><pname;0></color>!<clear><br>¡Estoy que me salgo de la emoción!<clear><br><$voicel(1,7)><$comeff(1,10)><$motion(1,806)><$facial(1,4)>Tenemos que volver a jugar otro día, pana. ¡Que una sola<br>victoria me sabe a poco, jua, jua!"
msgstr "<$voicel(1,7)><$emotion(1,53)>¡Qué increíble! ¡Te gané, <$cdef(27)><pname;0></color>!<clear><br>¡Estoy que exploto de la emoción!<clear><br><$voicel(1,7)><$comeff(1,10)><$motion(1,806)><$facial(1,4)>Tenemos que volver a jugar otro día, compa. ¡Que una sola<br>victoria me sabe a poco, jua, jua!"

#. en: <oneline><$voicel(1,3)><$emotion(1,29)>Yo, <$cdef(27)><pname;0></color>! I’m in the mood for a little<br>hide-and-sneak.<slide><br>Wanna play?<clear><br><$voicel(1,7)><$emotion(1,38)>You hide, I’ll sneak—uh, seek!
msgctxt "1968:610"
msgid "<$voicel(1,3)><$emotion(1,29)>Oye, oye, <$cdef(27)><pname;0></color>, ¿te hace jugar al<br>escondite camuflado?<clear><br><$voicel(1,7)><$emotion(1,38)>¡En este te toca esconderte a ti!"
msgstr "<$voicel(1,3)><$emotion(1,29)>Oye, oye, <$cdef(27)><pname;0></color>, ¿quieres jugar al<br>escondite camuflado?<clear><br><$voicel(1,7)><$emotion(1,38)>¡En este te toca esconderte a ti!"

#. en: <$voicel(1,7)><$emotion(1,27)>Aw yeah, bring it on! No way am I gonna lose!
msgctxt "1968:611"
msgid "<$voicel(1,7)><$emotion(1,27)>¡Genial! ¡No pienso perder!"
msgstr ""

#. en: <$voicel(1,8)><$emotion(1,49)>Oh, OK. Another time!
msgctxt "1968:612"
msgid "<$voicel(1,8)><$emotion(1,49)>¡Pues nada, otro día jugamos!"
msgstr ""

#. en: <$voicel(1,4)><$comeff(1,4)><$motion(1,807)>Dang... You’re pretty good...
msgctxt "1968:617"
msgid "<$voicel(1,4)><$comeff(1,4)><$motion(1,807)>Agh... Eres demasiado buen<gen;-2(o,a)>."
msgstr ""

#. en: <oneline><$voicel(1,7)><$emotion(1,49)>Way to go, <$cdef(27)><pname;0></color>! You got a future in<br>the<slide><br>hide-and-sneak<slide><br>big leagues!<clear><br><$voicel(1,6)><$emotion(1,8)>Take this, and don’t forget about me once you go pro!
msgctxt "1968:618"
msgid "<$voicel(1,7)><$emotion(1,49)>Madre mía, no sabía que estaba ante una leyenda del<br>escondite camuflado.<clear><br><$voicel(1,6)><$emotion(1,8)>¡Te mereces un buen premio, <$cdef(27)><pname;1></color>!"
msgstr "<$voicel(1,7)><$emotion(1,49)>Cielos, no sabía que estaba ante una leyenda del<br>escondite camuflado.<clear><br><$voicel(1,6)><$emotion(1,8)>¡Te mereces un buen premio, <$cdef(27)><pname;1></color>!"

#. en: <$voicel(1,7)><$emotion(1,49)>I had a blast hangin’ out with you. Watch out, though—I’m<br>totally gonna win next time!
msgctxt "1968:619"
msgid "<$voicel(1,7)><$emotion(1,49)>Hemos echado un buen rato, ¿no crees? ¡Pero la próxima<br>vez no te resultará tan fácil ganar!"
msgstr "<$voicel(1,7)><$emotion(1,49)>Pasamos un buen rato, ¿no crees? ¡Pero la próxima<br>vez no te resultará tan fácil ganar!"

#. en: <$voicel(1,7)><$emotion(1,14)>Hey, I got a great idea! You and me are pretty close, yeah?<clear><br><$voicel(1,10)><$emotion(1,53)>Since we’re such good pals, I’m gonna start callin’ ya by<br>your name from now on.<clear><br><$voicel(1,7)><$emotion(1,49)>Sound good, <$cdef(27)><pname;0></color>? Ha! Nice.
msgctxt "1968:620"
msgid "<oneline><$voicel(1,7)><$emotion(1,14)>Jua, jua ¿te he sorprendido? He pensado que, ya que<br>nos llevamos tan bien, tendría que llamarte más por tu<slide><br>mote. <$voicel(1,10)><$emotion(1,53)>¡Para que veas que no se me ha olvidado!<clear><br><$voicel(1,7)><$emotion(1,49)>De ahora en adelante oirás un<br>\"¡<$cdef(27)><pname;0></color>!\"<slide><br>por ahí."
msgstr "<oneline><$voicel(1,7)><$emotion(1,14)>Jua, jua ¿te sorprendí? Pensé que, ya que<br>nos llevamos tan bien, tendría que llamarte más por tu<slide><br>apodo. <$voicel(1,10)><$emotion(1,53)>¡Para que veas que no se me olvidó!<clear><br><$voicel(1,7)><$emotion(1,49)>De ahora en adelante oirás un<br>\"¡<$cdef(27)><pname;0></color>!\"<slide><br>por ahí."

#. en: <$voicel(1,7)><$emotion(1,49)>Thanks for hanging out with me today, pal! I had a blast!
msgctxt "1968:622"
msgid "<$voicel(1,7)><$emotion(1,49)>¡Gracias por jugar, <gen;-2(bro,sis)>! Lo he pasado en grande."
msgstr "<$voicel(1,7)><$emotion(1,49)>¡Gracias por jugar, <gen;-2(bro,sis)>! La pasé en grande."

#. en: <$voicel(1,9)><$emotion(1,53)>Aw yeah, bring it on! No way am I gonna lose!
msgctxt "1968:623"
msgid "<$voicel(1,9)><$emotion(1,53)>¡Vamooos! ¡No pienso perder, chava<gen;-2(l,la)>!"
msgstr ""

#. en: <$voicel(1,6)><$emotion(1,14)>Oh, OK. Another time!
msgctxt "1968:624"
msgid "<$voicel(1,6)><$emotion(1,14)>¡Vale, nos vemos!"
msgstr "<$voicel(1,6)><$emotion(1,14)>¡Bueno, nos vemos!"

#. en: <$voicel(1,5)><$comeff(1,6)><$motion(1,666)>Uh, what? The <$cdef(27)><fqty(1)><$ifull(1325)></color> stopped working.<clear><br><$voicel(1,3)><$emotion(1,47)>Maybe it needs more power? Yeesh, what a pickle...
msgctxt "1968:667"
msgid "<$voicel(1,5)><$comeff(1,6)><$motion(1,666)>¿Qué ha pasado? No furula la <$cdef(27)><fqty(1)><$ifull(1325)></color>.<clear><br><$voicel(1,3)><$emotion(1,47)>¿Ha habido un apagón? ¿Me está troleando alguien?<br>Qué movida..."
msgstr "<$voicel(1,5)><$comeff(1,6)><$motion(1,666)>¿Qué pasó? No funciona la <$cdef(27)><fqty(1)><$ifull(1325)></color>.<clear><br><$voicel(1,3)><$emotion(1,47)>¿Hubo un apagón? ¿Me está troleando alguien?<br>Qué lío..."

#. en: <oneline><$voicel(1,5)><$emotion(1,14)>Here, take some<br><$cdef(27)><fqty(2)><class><reftarid;0></color>!<slide><br>I’m<slide><br>still<slide><br>workin’<slide><br>on<slide><br>the rest.<clear><br><$voicel(1,8)><$comeff(1,10)><$facial(1,4)><$motion(1,806)>Hold on a little longer while I finish up!
msgctxt "1968:670"
msgid "<oneline><$voicel(1,5)><$emotion(1,14)>¡Toma, <gen;-2(bro,sis)>! ¡Llévate<br>est<genqty;0(e,a,os,as)> <class><$cdef(27)><reftarid;0></color>!<clear><br><$voicel(1,8)><$comeff(1,10)><$facial(1,4)><$motion(1,806)>El resto todavía va a tardar un rato, ¡tienes que esperar!"
msgstr ""

#. en: <oneline><$emotion(1,14)><$voicel(1,7)>Oh yeah, I know where <$cdef(27)><pksrchtar;0></color>’s at!<br>Wanna<slide><br>visit<slide><br>’em together?<slide><br><$emotion(1,38)><$voicel(1,10)>I’ll<slide><br>fly us<slide><br>there<slide><br>in<slide><br>a flash!
msgctxt "1968:680"
msgid "<$cdef(27)><$voicel(1,7)></color><$emotion(1,14)>¡Sé dónde puede estar! ¿Quieres que te acerque volando?<br><$voicel(1,10)><$emotion(1,38)>¡Entre las nubes se va más rápido, <gen;-2(bro,sis)>!"
msgstr ""

#. en: <oneline><$voicel(1,7)><$emotion(1,14)>Pretty sure <$cdef(27)><pksrchtar;0></color>’s chillin’ at home.<br>Wanna<slide><br>visit<slide><br>’em together?<slide><br><$voicel(1,10)><$emotion(1,38)>I’ll<slide><br>fly us<slide><br>there<slide><br>in<slide><br>a flash!
msgctxt "1968:681"
msgid "<$cdef(27)><$voicel(1,7)></color><$emotion(1,14)>Me da a mí que está en su keli. ¿Quieres que te lleve?<br><$voicel(1,10)><$emotion(1,38)>¡Iremos volando de nube en nube, <gen;-2(bro,sis)>! ¡Jua, jua!"
msgstr "<$cdef(27)><$voicel(1,7)></color><$emotion(1,14)>Me parece que está en su casa. ¿Quieres que te lleve?<br><$voicel(1,10)><$emotion(1,38)>¡Iremos volando de nube en nube, <gen;-2(bro,sis)>! ¡Jua, jua!"

#. en: <oneline><$voicel(1,7)><$emotion(1,14)>Haven’t seen <$cdef(27)><pksrchtar;0></color> around today,<br>but<slide><br>I<slide><br>can<slide><br>take<slide><br>ya<slide><br>to<slide><br>where<slide><br>they live!<clear><br><$voicel(1,10)><$comeff(1,6)><$facial(1,4)><$motion(1,801)>How about it? Wanna fly there?
msgctxt "1968:682"
msgid "<$voicel(1,7)><$emotion(1,14)>Pues no, ni pajolera idea de dónde anda, pero te puedo<br>acercar a su keli en un momento.<clear><br><$cdef(27)><$voicel(1,10)></color><$comeff(1,6)><$facial(1,4)><$motion(1,801)>¿Qué me dices, mi pana? ¿Quieres que te lleve volando?"
msgstr "<$voicel(1,7)><$emotion(1,14)>Pues no, ni la menor idea de dónde anda, pero te puedo<br>acercar a su casa en un momento.<clear><br><$cdef(27)><$voicel(1,10)></color><$comeff(1,6)><$facial(1,4)><$motion(1,801)>¿Qué me dices, compa? ¿Quieres que te lleve volando?"

#. en: <oneline><$comeff(1,6)><$motion(1,805)><$voicel(1,5)><$cdef(27)><pksrchtar;0></color>? Can’t say I’ve seen ’em<br>around<slide><br>here.<slide><br><$voicel(1,8)><$emotion(1,14)>Guess<slide><br>they<slide><br>live<slide><br>pretty<slide><br>far away!
msgctxt "1968:683"
msgid "<oneline><$comeff(1,6)><$motion(1,805)><$voicel(1,5)>¿<fcap><dart;0()><$cdef(27)><pksrchtar;0></color>? Por aquí no anda,<br>eso fijísimo.<slide><br><$voicel(1,8)><$emotion(1,14)>¡Me da a mí<slide><br>que vive<slide><br>vete a saber dónde de lejos!"
msgstr "<oneline><$comeff(1,6)><$motion(1,805)><$voicel(1,5)>¿<fcap><dart;0()><$cdef(27)><pksrchtar;0></color>? Por aquí no anda,<br>eso segurísimo.<slide><br><$voicel(1,8)><$emotion(1,14)>¡Me parece<slide><br>que vive<slide><br>quién sabe dónde de lejos!"

#. en: <$voicel(1,9)><$emotion(1,27)>Aw yeah! Prepare for takeoff, pal!
msgctxt "1968:684"
msgid "<$voicel(1,9)><$emotion(1,27)>¡Di que sí! ¡Agárrate, que nos vamos!"
msgstr "<$voicel(1,9)><$emotion(1,27)>¡Así se habla! ¡Agárrate, que nos vamos!"

#. en: <$voicel(1,7)><$emotion(1,49)>Aw yeah, we made it! Next time you wanna fly somewhere,<br>just lemme know!
msgctxt "1968:685"
msgid "<$voicel(1,7)><$emotion(1,49)>¡Hemos llegado! Ha sido una pasada volar contigo, ¡a ver<br>si repetimos!"
msgstr "<$voicel(1,7)><$emotion(1,49)>¡Llegamos! Fue increíble volar contigo, ¡a ver<br>si repetimos!"

#. en: <oneline><$comeff(1,3)><$motion(1,801)><$voicel(1,9)>Nice, we made it! <wait(0.8)><$comeff(1,14)><$motion(1,805)><$voicel(1,4)>No sign of <$cdef(27)><pksrchtar;0><br></color>around, though.
msgctxt "1968:686"
msgid "<$cdef(27)><$comeff(1,3)></color><$motion(1,801)><$voicel(1,9)>¡Hemos llegado! Pero... <$comeff(1,14)><$motion(1,805)><$voicel(1,4)>buah, qué movida, aquí no está."
msgstr "<$cdef(27)><$comeff(1,3)></color><$motion(1,801)><$voicel(1,9)>¡Llegamos! Pero... <$comeff(1,14)><$motion(1,805)><$voicel(1,4)>uf, qué lío, aquí no está."

#. en: <$voicel(1,7)><$emotion(1,14)>No prob! Just holler anytime you wanna hit the skies!
msgctxt "1968:687"
msgid "<$voicel(1,7)><$emotion(1,14)>¡Vale, herman<gen;-2(o,a)>! ¡Cuando quieras volar a alguna parte, ya<br>sabes dónde estoy!"
msgstr "<$voicel(1,7)><$emotion(1,14)>¡Bueno, herman<gen;-2(o,a)>! ¡Cuando quieras volar a alguna parte, ya<br>sabes dónde estoy!"

#. en: <oneline><$emotion(1,14)><$voicel(1,7)>Oh yeah, I know where <$cdef(27)><pksrchtar;0></color>’s at!<br>Wanna<slide><br>visit<slide><br>’em together?<slide><br><$emotion(1,38)><$voicel(1,10)>I’ll<slide><br><$cdef(27)><$spwfull(35)></color><slide><br>us<slide><br>there<slide><br>in<slide><br>a flash!
msgctxt "1968:688"
msgid "<$cdef(27)><$emotion(1,14)></color><$voicel(1,7)>¡Algo me dice que sé dónde está!<clear><br>¿Quieres que te acerque? <$emotion(1,38)><$voicel(1,10)>¡Si nos <$cdef(27)>teletransporto<nbs2><$spwicon(35)></color>,<br>llegamos enseguida, <gen;-2(bro,sis)>!"
msgstr ""

#. en: <oneline><$voicel(1,7)><$emotion(1,14)>Pretty sure <$cdef(27)><pksrchtar;0></color>’s chillin’ at home.<br>Wanna<slide><br>visit<slide><br>’em together?<slide><br><$voicel(1,10)><$emotion(1,38)>I’ll<slide><br><$cdef(27)><$spwfull(35)></color><slide><br>us<slide><br>there<slide><br>in<slide><br>a flash!
msgctxt "1968:689"
msgid "<$voicel(1,7)><$emotion(1,14)>Fijo que<$cdef(27)> </color>está en su keli. ¿Te acerco hasta allí?<br><$voicel(1,10)><$emotion(1,38)>Un <$cdef(27)>teletransporte<nbs2><$spwicon(35)></color> y ¡pam! ¡Listo!"
msgstr "<$voicel(1,7)><$emotion(1,14)>Seguro que<$cdef(27)> </color>está en su casa. ¿Te acerco hasta allá?<br><$voicel(1,10)><$emotion(1,38)>Un <$cdef(27)>teletransporte<nbs2><$spwicon(35)></color> y ¡pam! ¡Listo!"

#. en: <oneline><$voicel(1,10)><$emotion(1,38)>Haven’t seen <$cdef(27)><pksrchtar;0></color> around today,<br>but<slide><br>I<slide><br>can<slide><br>take<slide><br>ya<slide><br>to<slide><br>where<slide><br>they live!<clear><br><$voicel(1,7)><$emotion(1,14)>How about it? Wanna <$cdef(27)><$spwfull(35)> </color>there?
msgctxt "1968:690"
msgid "<oneline><$cdef(27)><$voicel(1,10)></color><$emotion(1,38)>A saber dónde anda hoy, pero yo te acerco a su keli.<br><$voicel(1,7)><$emotion(1,14)>¿Qué me dices? ¿Quieres que nos <$cdef(27)>teletransporte<nbs2><$spwicon(35)></color>?"
msgstr "<oneline><$cdef(27)><$voicel(1,10)></color><$emotion(1,38)>No sé dónde anda hoy, pero yo te acerco a su casa.<br><$voicel(1,7)><$emotion(1,14)>¿Qué me dices? ¿Quieres que nos <$cdef(27)>teletransporte<nbs2><$spwicon(35)></color>?"

#. en: <oneline><$comeff(1,6)><$motion(1,805)><$voicel(1,5)><$cdef(27)><pksrchtar;0></color>? Can’t say I’ve seen ’em<br>around<slide><br>here.<slide><br><$voicel(1,8)><$emotion(1,14)>Guess<slide><br>they<slide><br>live<slide><br>pretty<slide><br>far away!
msgctxt "1968:691"
msgid "<$motion(1,805)><$voicel(1,5)>Buaaah, <$cdef(27)><$comeff(1,6)></color>¿por aquí? Ya te digo yo que no se pasa nunca.<br><$voicel(1,8)><$emotion(1,14)>¡Fijo que vive lejísimos!"
msgstr "<$motion(1,805)><$voicel(1,5)>Mmm, <$cdef(27)><$comeff(1,6)></color>¿por aquí? Ya te digo yo que no se pasa nunca.<br><$voicel(1,8)><$emotion(1,14)>¡Seguro que vive lejísimos!"

#. en: <$voicel(1,9)><$emotion(1,27)>Aw yeah! Let’s head out, pal!
msgctxt "1968:692"
msgid "<$voicel(1,9)><$emotion(1,27)>¡Ueee! ¡Allá vamos!"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,49)>Aw yeah, we made it! Next time you wanna <$cdef(27)><$spwfull(35)></color><br>somewhere, just lemme know!
msgctxt "1968:693"
msgid "<$voicel(1,7)><$emotion(1,49)>¡Hemos llegado! Ha sido breve pero bonito, juas. ¡A ver<br>si otro día nos marcamos otro <$cdef(27)>teletransporte<nbs2><$spwicon(35)></color>!"
msgstr "<$voicel(1,7)><$emotion(1,49)>¡Llegamos! Fue breve pero bonito, juas. ¡A ver<br>si otro día hacemos otro <$cdef(27)>teletransporte<nbs2><$spwicon(35)></color>!"

#. en: <oneline><$comeff(1,3)><$motion(1,801)><$voicel(1,9)>Nice, we made it! <wait(0.8)><$comeff(1,14)><$motion(1,805)><$voicel(1,4)>No sign of <$cdef(27)><pksrchtar;0><br></color>around, though.
msgctxt "1968:694"
msgid "<$cdef(27)><$comeff(1,3)></color><$motion(1,801)><$voicel(1,9)>¡Hemos llegadooo! <wait(0.8)><$comeff(1,14)><$motion(1,805)><$voicel(1,4)>Ah, si no está aquí... Movidón."
msgstr "<$cdef(27)><$comeff(1,3)></color><$motion(1,801)><$voicel(1,9)>¡Llegamooos! <wait(0.8)><$comeff(1,14)><$motion(1,805)><$voicel(1,4)>Ah, si no está aquí... Qué lío."

#. en: <$voicel(1,7)><$emotion(1,14)>No prob! Just holler anytime you wanna <$spwicon(35)><$cdef(27)>tele-PAR-TAY</color><br>with me, pal!
msgctxt "1968:695"
msgid "<$voicel(1,7)><$emotion(1,14)>¡Vale, <gen;-2(bro,sis)>! ¡Cuando quieras que te <$cdef(27)>teletransporte<nbs2><$spwicon(35)></color>,<br>ya sabes dónde estoy!"
msgstr "<$voicel(1,7)><$emotion(1,14)>¡Bueno, <gen;-2(bro,sis)>! ¡Cuando quieras que te <$cdef(27)>teletransporte<nbs2><$spwicon(35)></color>,<br>ya sabes dónde estoy!"

#. en: <oneline><$comeff(1,3)><$motion(1,803)><$voicel(1,7)><$cdef(27)><pksrchtar;0></color>? Pretty sure you’ll find ’em<br>over there!
msgctxt "1968:696"
msgid "<oneline><$comeff(1,3)><$motion(1,803)><$voicel(1,7)>¿<fcap><dart;0()><$cdef(27)><pksrchtar;0></color>? ¡Me suena que estaba<br>por ahí<slide><br>hace nada!"
msgstr ""

#. en: <oneline><$comeff(1,3)><$motion(1,803)><$voicel(1,7)>Oh, <$cdef(27)><pksrchtar;0></color>? I bet they’re chillin’<br>at home!
msgctxt "1968:697"
msgid "<$cdef(27)><$comeff(1,3)></color><$motion(1,803)><$voicel(1,7)>¡Sip, me suena que estaba en su keli!"
msgstr "<$cdef(27)><$comeff(1,3)></color><$motion(1,803)><$voicel(1,7)>¡Sip, me suena que estaba en su casa!"

#. en: <oneline><$comeff(1,6)><$motion(1,805)><$voicel(1,5)><$cdef(27)><pksrchtar;0></color>? Haven’t seen ’em around<br>today.<slide><br>Sorry, pal.
msgctxt "1968:698"
msgid "<$motion(1,805)><$voicel(1,5)><$cdef(27)><$comeff(1,6)></color>¿Eh? No sé dónde está... Hoy no nos hemos cruzado."
msgstr "<$motion(1,805)><$voicel(1,5)><$cdef(27)><$comeff(1,6)></color>¿Eh? No sé dónde está... Hoy no nos cruzamos."

#. en: <oneline><$comeff(1,6)><$motion(1,805)><$voicel(1,5)><$cdef(27)><pksrchtar;0></color>? Can’t say I’ve seen ’em<br>around<slide><br>here.<slide><br><wait(0.6)><$voicel(1,8)><$emotion(1,14)>They<slide><br>must<slide><br>live<slide><br>pretty<slide><br>far away!
msgctxt "1968:699"
msgid "<$motion(1,805)><$voicel(1,5)><$cdef(27)><$comeff(1,6)></color>¿Hm? Ni idea de dónde está, mi pana. <$voicel(1,8)><$emotion(1,14)>¡Me da a mí que<br>vive bastante lejos!"
msgstr "<$motion(1,805)><$voicel(1,5)><$cdef(27)><$comeff(1,6)></color>¿Hm? Ni idea de dónde está, compa. <$voicel(1,8)><$emotion(1,14)>¡Me parece que<br>vive bastante lejos!"

#. en: <$voicel(1,5)><$emotion(1,29)>Huh? You lookin’ for someone, <$cdef(27)><pname;0></color>?
msgctxt "1968:700"
msgid "<$voicel(1,5)><$emotion(1,29)>¡Hola, <$cdef(27)><pname;0></color>! ¿Buscas a alguien?"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,14)>Gotcha! Just checkin’.
msgctxt "1968:701"
msgid "<$voicel(1,7)><$emotion(1,14)>¡Ah, vale, me habré confundido!"
msgstr "<$voicel(1,7)><$emotion(1,14)>¡Ah, bueno, me habré confundido!"

#. en: <oneline><$comeff(1,10)><$motion(1,803)><$voicel(1,7)><$cdef(27)><pksrchtar;0></color>, huh? No clue where they<br>are,<slide><br>but I<slide><br>hope<slide><br>ya<slide><br>find ’em!
msgctxt "1968:702"
msgid "<oneline><$comeff(1,10)><$motion(1,803)><$voicel(1,7)>¿<fcap><dart;0()><$cdef(27)><pksrchtar;0></color>? Buah, no tengo<br>ni idea<slide><br>de dónde<slide><br>puede estar."
msgstr "<oneline><$comeff(1,10)><$motion(1,803)><$voicel(1,7)>¿<fcap><dart;0()><$cdef(27)><pksrchtar;0></color>? Uf, no tengo<br>ni idea<slide><br>de dónde<slide><br>puede estar."

#. en: <$voicel(1,3)><$comeff(1,7)><$facial(1,9)><$motion(1,807)>How comfortable is my place? Hate to say this, but it’s<br>kinda <$cdef(27)><flow><$stflevel;0(1)></color>.
msgctxt "1968:750"
msgid "<oneline><$voicel(1,3)><$comeff(1,7)><$facial(1,9)><$motion(1,807)>Me duele decírtelo, <gen;-2(bro,sis)>, pero... <wait(1.0)>como mucho es<br><$cdef(27)><$stflevel;0(1)></color>."
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,14)>How comfortable is my place? Eh... It’s <$cdef(27)><flow><$stflevel;0(2)></color>.
msgctxt "1968:751"
msgid "<oneline><$voicel(1,7)><$emotion(1,14)>¿De mi keli? A ver... <wait(1.0)>viene siendo <$cdef(27)><$stflevel;0(2)></color>."
msgstr "<oneline><$voicel(1,7)><$emotion(1,14)>¿De mi casa? A ver... <wait(1.0)>viene siendo <$cdef(27)><$stflevel;0(2)></color>."

#. en: <$voicel(1,7)><$emotion(1,50)>How comfortable is my place? Well, pretty <$cdef(27)><flow><$stflevel;0(3)></color>!
msgctxt "1968:752"
msgid "<$voicel(1,7)><$emotion(1,50)>Pues estoy <$cdef(27)><$stflevel;0(3)> </color>en mi keli, herman<gen;-2(o,a)>."
msgstr "<$voicel(1,7)><$emotion(1,50)>Pues estoy <$cdef(27)><$stflevel;0(3)> </color>en mi casa, herman<gen;-2(o,a)>."

#. en: <$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>How comfortable is my place? It’s seriously <$cdef(27)><flow><$stflevel;0(4)></color>!
msgctxt "1968:753"
msgid "<$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>¡Buah, es <$cdef(27)><$stflevel;0(4)></color>, chava<gen;-2(l,la)>!"
msgstr "<$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>¡Guau, es <$cdef(27)><$stflevel;0(4)></color>, chava<gen;-2(l,la)>!"

#. en: <oneline><$voicel(1,9)><$emotion(1,7)>How comfortable is my place? Gotta hand it to ya—it’s<br>totally <$cdef(27)><flow><$stflevel;0(5)></color>! <$voicel(1,7)><$emotion(1,49)>You seriously outdid yourself,<slide><br><$cdef(27)><pname;1></color>!
msgctxt "1968:754"
msgid "<oneline><$voicel(1,9)><$emotion(1,7)>Pues mira lo que te digo: <wait(1.0)>¡<$cdef(27)><$stflevel;0(5)></color>! <$voicel(1,7)><$emotion(1,49)>¡Estoy feliz<br>como<slide><br>un regaliz!"
msgstr ""

#. en: <$voicel(1,8)><$emotion(1,49)>Better than before!
msgctxt "1968:756"
msgid "<$voicel(1,8)><$emotion(1,49)>Mejor ahora, dónde va a parar."
msgstr "<$voicel(1,8)><$emotion(1,49)>Mejor ahora, sin duda."

#. en: <$voicel(1,7)><$emotion(1,39)>It’s way better, all thanks to you! You rock, pal!
msgctxt "1968:757"
msgid "<$voicel(1,7)><$emotion(1,39)>¡Está mucho mejor que antes! Gracias, herman<gen;-2(o,a)>."
msgstr ""

#. en: <oneline><$voicel(1,7)><$emotion(1,14)>Whoops! Sorry pal, but it looks like this<br><$cdef(27)><fqty(1)><class><aireactp;0></color><slide><br>is<slide><br>too<slide><br>small<slide><br>for me.<clear><br><$voicel(1,6)><$comeff(1,7)><$motion(1,666)>You got anything a smidge bigger?
msgctxt "1968:758"
msgid "<oneline><$voicel(1,7)><$emotion(1,14)>Perdona, <gen;-2(bro,sis)>, pero creo que est<genqty;0(e,a,os,as)><br><$cdef(27)><fqty(1)><aireactp;0></color><slide><br><qty;0(es,son)> un pelín<slide><br>pequeñaj<genqty;0(o,a,os,as)> para mí.<clear><br><$voicel(1,6)><$comeff(1,7)><$motion(1,666)>¿No tendrás algo más... de mi tamaño?"
msgstr "<oneline><$voicel(1,7)><$emotion(1,14)>Perdón, <gen;-2(bro,sis)>, pero creo que est<genqty;0(e,a,os,as)><br><$cdef(27)><fqty(1)><aireactp;0></color><slide><br><qty;0(es,son)> un poquito<slide><br>pequeñit<genqty;0(o,a,os,as)> para mí.<clear><br><$voicel(1,6)><$comeff(1,7)><$motion(1,666)>¿No tendrás algo más... de mi tamaño?"

#. en: <oneline><$voicel(1,7)><$emotion(1,8)>Thanks for putting out that<br><$cdef(27)><fqty(1)><class><aireactp;0></color>!
msgctxt "1968:761"
msgid "<oneline><$voicel(1,7)><$emotion(1,8)>Muchas gracias por traerme<br><iart;0()><$cdef(27)><fqty(1)><class><aireactp;0></color>."
msgstr ""

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>The comfort level at my place? Well, I’m not there right<br>now, but honestly, <$comeff(1,7)><$motion(1,802)><$voicel(1,4)>it’s kinda <$cdef(27)><flow><$stflevel;0(1)></color>...
msgctxt "1968:762"
msgid "<oneline><$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Como me pillas fuera de casa, ahora mismo no sabría<br>decirte bien, herman<gen;-2(o,a)>... <wait(1.0)><$comeff(1,7)><$motion(1,802)><$voicel(1,4)>pero supongo que es<slide><br><$cdef(27)><$stflevel;0(1)></color>..."
msgstr "<oneline><$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Como estoy fuera de casa, ahora mismo no sabría<br>decirte bien, herman<gen;-2(o,a)>... <wait(1.0)><$comeff(1,7)><$motion(1,802)><$voicel(1,4)>pero supongo que es<slide><br><$cdef(27)><$stflevel;0(1)></color>..."

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>The comfort level at my place? Well, I’m not there right<br>now, but honestly, <$comeff(1,3)><$motion(1,803)><$voicel(1,6)>I think it’s pretty <$cdef(27)><flow><$stflevel;0(2)></color>.
msgctxt "1968:763"
msgid "<$voicel(1,5)><$comeff(1,14)><$motion(1,666)>No estoy en mi keli, así que ando un tanto dudos<gen;-3(o,a)>...<br><wait(1.0)><$comeff(1,3)><$motion(1,803)><$voicel(1,6)>Será <$cdef(27)><$stflevel;0(2)></color>, digo yo."
msgstr "<$voicel(1,5)><$comeff(1,14)><$motion(1,666)>No estoy en mi casa, así que ando un tanto dudos<gen;-3(o,a)>...<br><wait(1.0)><$comeff(1,3)><$motion(1,803)><$voicel(1,6)>Será <$cdef(27)><$stflevel;0(2)></color>, digo yo."

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>The comfort level at my place? Well, I’m not there right<br>now, but honestly, <$comeff(1,9)><$motion(1,801)><$voicel(1,8)>I remember it being real <$cdef(27)><flow><$stflevel;0(3)></color>!
msgctxt "1968:764"
msgid "<oneline><$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Hmm... A ver que haga yo un repaso mental de mi keli...<wait(1.0)><br><$comeff(1,9)><$motion(1,801)><$voicel(1,8)>¡Que yo recuerde, es <$cdef(27)><$stflevel;0(3)></color>,<slide><br><gen;-2(bro,sis)>!"
msgstr "<oneline><$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Hmm... A ver que haga yo un repaso mental de mi casa...<wait(1.0)><br><$comeff(1,9)><$motion(1,801)><$voicel(1,8)>¡Que yo recuerde, es <$cdef(27)><$stflevel;0(3)></color>,<slide><br><gen;-2(bro,sis)>!"

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>The comfort level at my place? Well, I’m not there right<br>now, but honestly, <$comeff(1,21)><$motion(1,801)><$voicel(1,10)>I think it’s <$cdef(27)><flow><$stflevel;0(4)></color> now!
msgctxt "1968:765"
msgid "<oneline><$voicel(1,5)><$comeff(1,14)><$motion(1,666)>A ver que piense cómo me siento en mi keli...<wait(1.0)><br><$comeff(1,21)><$motion(1,801)><$voicel(1,10)>¡Pues diría que es <$cdef(27)><$stflevel;0(4)></color>!"
msgstr "<oneline><$voicel(1,5)><$comeff(1,14)><$motion(1,666)>A ver que piense cómo me siento en mi casa...<wait(1.0)><br><$comeff(1,21)><$motion(1,801)><$voicel(1,10)>¡Pues diría que es <$cdef(27)><$stflevel;0(4)></color>!"

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>The comfort level at my place? Well, I’m not there right<br>now, but honestly, <$comeff(1,8)><$motion(1,801)><$voicel(1,9)>it’s ridiculously <$cdef(27)><flow><$stflevel;0(5)></color>!<clear><br>Not gonna lie, it’s hard not to brag about it!
msgctxt "1968:766"
msgid "<oneline><oneline><$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Desde aquí no sabría valorarlo bien, pero...<wait(1.0)><br><$comeff(1,8)><$motion(1,801)><$voicel(1,9)>¡Nah, es <$cdef(27)><$stflevel;0(5)></color>! ¡No hago más que presumir<slide><br>de keli!"
msgstr "<oneline><oneline><$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Desde aquí no sabría valorarlo bien, pero...<wait(1.0)><br><$comeff(1,8)><$motion(1,801)><$voicel(1,9)>¡Nah, es <$cdef(27)><$stflevel;0(5)></color>! ¡No hago más que presumir<slide><br>de casa!"

#. en: <$voicel(1,8)><$emotion(1,49)>Better than before, that’s for sure.
msgctxt "1968:767"
msgid "<$voicel(1,8)><$emotion(1,49)>¡Ha mejorado, pana!"
msgstr "<$voicel(1,8)><$emotion(1,49)>¡Mejoró, compa!"

#. en: <$voicel(1,7)><$emotion(1,38)>It’s gotten WAY better, all thanks to you, pal!
msgctxt "1968:768"
msgid "<$voicel(1,7)><$emotion(1,38)>¡Gracias a ti, está mucho mejor!"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,38)>My place’s over here! C’mon, follow me!
msgctxt "1968:769"
msgid "<$voicel(1,7)><$emotion(1,38)>¡Mi keli está por aquí, herman<gen;-2(o,a)>! ¡Si quieres, te llevo!"
msgstr "<$voicel(1,7)><$emotion(1,38)>¡Mi casa está por aquí, herman<gen;-2(o,a)>! ¡Si quieres, te llevo!"

#. en: <$voicel(1,8)><$emotion(1,14)><$facial(1,4)>My place is over thataway!<clear><br><$voicel(1,5)><$comeff(1,4)><$motion(1,807)>I’d show you there myself, but I’ve got stuff to do, pal.
msgctxt "1968:770"
msgid "<$voicel(1,8)><$emotion(1,14)><$facial(1,4)>¡Mi keli está por ahí, herman<gen;-2(o,a)>! <$voicel(1,5)><$comeff(1,4)><$motion(1,807)>Te llevaría para que la veas,<br>pero me pillas ocupad<gen;-3(o,a)>."
msgstr "<$voicel(1,8)><$emotion(1,14)><$facial(1,4)>¡Mi casa está por ahí, herman<gen;-2(o,a)>! <$voicel(1,5)><$comeff(1,4)><$motion(1,807)>Te llevaría para que la veas,<br>pero ando ocupad<gen;-3(o,a)>."

#. en: <$voicel(1,7)><$emotion(1,27)><$facial(1,4)>Whoa, hey! You got that thing for my house? Thanks a<br>ton, <$cdef(27)><pname;0></color>!
msgctxt "1968:771"
msgid "<$voicel(1,7)><$emotion(1,27)><$facial(1,4)>¡Buah, <gen;-2(chaval,chavala)>! ¡Gracias por colocarme lo que quería en<br>mi keli, <$cdef(27)><pname;0></color>!"
msgstr "<$voicel(1,7)><$emotion(1,27)><$facial(1,4)>¡Guau, <gen;-2(chaval,chavala)>! ¡Gracias por colocarme lo que quería en<br>mi casa, <$cdef(27)><pname;0></color>!"

#. en: <oneline><$voicel(1,9)><$emotion(1,53)>Whoa, <iart;0()><$cdef(27)><fqty(1)><class><stfrevp;0></color>!<br>Thanks<slide><br>for<slide><br>putting<slide><br>one<slide><br>out<slide><br>for me!
msgctxt "1968:772"
msgid "<oneline><$voicel(1,9)><$emotion(1,53)>¡Buah, qué flipe de <$cdef(27)><fqty(1)><stfrevp;0><br></color>hay fuera!<slide><br>¡Gracias!"
msgstr "<oneline><$voicel(1,9)><$emotion(1,53)>¡Guau, qué belleza de <$cdef(27)><fqty(1)><stfrevp;0><br></color>hay afuera!<slide><br>¡Gracias!"

#. en: <$comeff(1,6)><$motion(1,666)><$voicel(1,5)>How comfortable is my place? Well, I just started livin’<br>in it, so I don’t really know yet.<clear><br><$comeff(1,3)><$motion(1,803)><$voicel(1,8)>Come ask me later, though!
msgctxt "1968:773"
msgid "<$motion(1,666)><$voicel(1,5)>Eh... <$comeff(1,6)>¿Ni pajolera idea? Acabo de mudarme, así que...<wait(1.0)><br><$comeff(1,3)><$motion(1,803)><$voicel(1,8)>Cuando sepa te lo digo."
msgstr "<$motion(1,666)><$voicel(1,5)>Eh... <$comeff(1,6)>¿Ni la menor idea? Acabo de mudarme, así que...<wait(1.0)><br><$comeff(1,3)><$motion(1,803)><$voicel(1,8)>Cuando sepa te lo digo."

#. en: <oneline><$emotion(1,1)><$voicel(1,8)>Thanks!<clear><br><$emotion(1,41)><$voicel(1,3)>But to be honest,<br><$cdef(27)><fqty(2)><class><stfrevp;0></color><slide><br>really<slide><br>aren’t<slide><br>my thing.<clear><br><$emotion(1,29)><$voicel(1,6)>You got anything else, pal?
msgctxt "1968:774"
msgid "<oneline><$emotion(1,1)><$voicel(1,8)>Gracias, <gen;-2(bro,sis)>.<clear><br><$emotion(1,41)><$voicel(1,3)>Mmm... <wait(1.0)>No sé cómo decírtelo, pero no soy muy fan<br><esde;0()><$cdef(27)><fqty(2)><class><stfrevp;0></color>.<clear><br><$emotion(1,29)><$voicel(1,6)>¿No tendrás alguna otra cosa guapa por ahí?"
msgstr "<oneline><$emotion(1,1)><$voicel(1,8)>Gracias, <gen;-2(bro,sis)>.<clear><br><$emotion(1,41)><$voicel(1,3)>Mmm... <wait(1.0)>No sé cómo decírtelo, pero no soy muy fan<br><esde;0()><$cdef(27)><fqty(2)><class><stfrevp;0></color>.<clear><br><$emotion(1,29)><$voicel(1,6)>¿No tendrás alguna otra cosa bonita por ahí?"

#. en: <oneline><$voicel(1,7)><$emotion(1,14)>Whoops! Sorry pal, but it looks like that<br><$cdef(27)><fqty(1)><class><stfrevp;0></color><slide><br>is<slide><br>too<slide><br>small<slide><br>for me.<clear><br><$voicel(1,6)><$comeff(1,7)><$motion(1,666)>You got anything a smidge bigger?
msgctxt "1968:775"
msgid "<oneline><$voicel(1,7)><$emotion(1,14)>Lo siento, pero parece que<br><dart;0()><fqty(1)><class><$cdef(27)><stfrevp;0></color><slide><br><qty;0(es,son)><slide><br>pequeñ<genqty;0(o,a,os,as)> para mí.<clear><br><$voicel(1,6)><$comeff(1,7)><$motion(1,666)>¿Tienes algo un pelín más grande?"
msgstr "<oneline><$voicel(1,7)><$emotion(1,14)>Lo siento, pero parece que<br><dart;0()><fqty(1)><class><$cdef(27)><stfrevp;0></color><slide><br><qty;0(es,son)><slide><br>pequeñ<genqty;0(o,a,os,as)> para mí.<clear><br><$voicel(1,6)><$comeff(1,7)><$motion(1,666)>¿Tienes algo un poquito más grande?"

#. en: <$voicel(1,5)><$emotion(1,14)>You sure like pickin’ rocks and sticks up off the ground,<br>huh, <$cdef(27)><pname;0></color>?<clear><br><$voicel(1,3)><$comeff(1,6)><$motion(1,666)>Doesn’t your bag get heavy with all that stuff in it?
msgctxt "1968:801"
msgid "<$voicel(1,5)><$emotion(1,14)>Veo que sueles recoger las piedras y ramas que te vas<br>encontrando por ahí.<clear><br><$voicel(1,3)><$comeff(1,6)><$motion(1,666)>¿No te pesa la Bolsa con tantas cosas?"
msgstr ""

#. en: <oneline><$voicel(1,7)><$emotion(1,14)>Oh, hey, <$cdef(27)><pname;0></color>. Feels like I’ve been<br>seein’<slide><br>a<slide><br>lot<slide><br>of<slide><br>you lately!<clear><br><$voicel(1,6)><$motion(1,805)>Bet you’ve got a lot goin’ on, huh?<clear><br><$voicel(1,7)><$comeff(1,10)><$motion(1,806)>You should let me help out sometimes!
msgctxt "1968:802"
msgid "<oneline><$voicel(1,7)><$emotion(1,14)>Eeey, <$cdef(27)><pname;0></color>. Últimamente te veo<br>mucho<slide><br>por aquí.<clear><br><$voicel(1,6)><$motion(1,805)>Seguro que sigues ayudando a los demás sin parar, ¿no?<br><$voicel(1,7)><$comeff(1,10)><$motion(1,806)>¡Deja que te ayude yo de vez en cuando también!"
msgstr ""

#. en: <oneline><$voicel(1,7)><$comeff(1,10)><$motion(1,806)>We really pulled out all the stops when we made that<br><$cdef(27)><asnbname;0></color>!<clear><br><$voicel(1,5)><$emotion(1,50)>Hope ya like it, <$cdef(27)><pname;1></color>!
msgctxt "1968:803"
msgid "<$cdef(27)><oneline><$voicel(1,7)></color><$comeff(1,10)><$motion(1,806)>¡Le he puesto mucho empeño a la construcción<br><esde;0()><$cdef(27)><asnbname;0></color>!<slide><br><$voicel(1,5)><$emotion(1,50)>Espero que te mole."
msgstr "<$cdef(27)><oneline><$voicel(1,7)></color><$comeff(1,10)><$motion(1,806)>¡Le puse mucho empeño a la construcción<br><esde;0()><$cdef(27)><asnbname;0></color>!<slide><br><$voicel(1,5)><$emotion(1,50)>Espero que te guste."

#. en: <oneline><$voicel(1,9)><$comeff(1,21)><$facial(1,5)><$motion(1,803)>Dang, whoever made that<br><$cdef(27)><rctbname;0></color><slide><br>did<slide><br>a<slide><br>heck<slide><br>of<slide><br>a<slide><br>good job!<clear><br><$voicel(1,7)><$comeff(1,10)><$motion(1,806)><$facial(1,1)>But I bet I could do an even BETTER job if I helped<br><$cdef(27)><$spwfull(1)></color> it! Ha!
msgctxt "1968:804"
msgid "<oneline><$voicel(1,9)><$comeff(1,21)><$facial(1,5)><$motion(1,803)>¡Buah, qué bien ha quedado<br><dart;0()><$cdef(27)><rctbname;0></color>!<clear><br><$voicel(1,7)><$comeff(1,10)><$motion(1,806)><$facial(1,1)>Aunque, si me pides ayuda a mí, ¡te puedo <$cdef(27)><$spwfull(1)></color><br>algo aún más flipante!"
msgstr "<oneline><$voicel(1,9)><$comeff(1,21)><$facial(1,5)><$motion(1,803)>¡Guau, qué bien quedó<br><dart;0()><$cdef(27)><rctbname;0></color>!<clear><br><$voicel(1,7)><$comeff(1,10)><$motion(1,806)><$facial(1,1)>Aunque, si me pides ayuda a mí, ¡te puedo <$cdef(27)><$spwfull(1)></color><br>algo aún más increíble!"

#. en: <$voicel(1,3)><$comeff(1,14)><$motion(1,666)>Hey, remember that, uh... What was their name? Y’know,<br>the one we hung out with that one time.<clear><br><$voicel(1,5)><$emotion(1,40)>Oh, right, duh! <$cdef(27)><acqpname;0></color>!<clear><br><$voicel(1,8)><$emotion(1,38)>You remember, right? I’d be down to hang out again!
msgctxt "1968:805"
msgid "<$voicel(1,3)><$comeff(1,14)><$motion(1,666)>Ay, ¿cómo se llamaba? Si estuvimos jugando y todo...<br><$voicel(1,5)><$emotion(1,40)>¡Ah, ya sé! ¡<$cdef(27)><acqpname;0></color>!<clear><br><$voicel(1,8)><$emotion(1,38)>¿Te acuerdas? Estaría genial quedar con <gen;0(él,ella)> otra vez."
msgstr "<$voicel(1,3)><$comeff(1,14)><$motion(1,666)>Ay, ¿cómo se llamaba? Si estuvimos jugando y todo...<br><$voicel(1,5)><$emotion(1,40)>¡Ah, ya sé! ¡<$cdef(27)><acqpname;0></color>!<clear><br><$voicel(1,8)><$emotion(1,38)>¿Te acuerdas? Estaría genial juntarme con <gen;0(él,ella)> otra vez."

#. en: <$voicel(1,7)><$emotion(1,27)>Ha! You changed, <$cdef(27)><pname;0></color>.<clear><br><$voicel(1,5)><$emotion(1,38)>I almost didn’t recognize ya at first, but I gotta say that<br>new look’s pretty snazzy!
msgctxt "1968:806"
msgid "<oneline><$voicel(1,7)><$emotion(1,27)>¡Menudo cambio radical, herman<gen;-2(o,a)>! ¡Casi ni te reconozco!<br><$voicel(1,5)><$emotion(1,38)>Pero te queda genial también, ¿eh?"
msgstr "<oneline><$voicel(1,7)><$emotion(1,27)>¡Qué cambio tan radical, herman<gen;-2(o,a)>! ¡Casi ni te reconozco!<br><$voicel(1,5)><$emotion(1,38)>Pero te queda genial también, ¿eh?"

#. en: <oneline><$voicel(1,7)><$emotion(1,1)>Hey hey, lookin’ sharp, <$cdef(27)><pname;0></color>! You<br>switch<slide><br>up<slide><br>your<slide><br>look<slide><br>a bit?<clear><br><$voicel(1,5)><$emotion(1,49)>Yeah, I’m pretty good at noticin’ stuff like that. Surprised?
msgctxt "1968:807"
msgid "<oneline><$voicel(1,7)><$emotion(1,1)>A ver, <$cdef(27)><pname;0></color>, te noto distint<gen;-2(o,a)>...<br>¿Te has hecho<slide><br>un cambio de look?<slide><br>¿Es eso, no?<clear><br><$voicel(1,5)><$emotion(1,49)>Si es que tengo buen ojo para esas cosas."
msgstr "<oneline><$voicel(1,7)><$emotion(1,1)>A ver, <$cdef(27)><pname;0></color>, te noto distint<gen;-2(o,a)>...<br>¿Te hiciste<slide><br>un cambio de look?<slide><br>¿Es eso, no?<clear><br><$voicel(1,5)><$emotion(1,49)>Es que tengo buen ojo para esas cosas."

#. en: <$voicel(1,5)><$emotion(1,14)>You seem pretty capable, but everyone’s got stuff they<br>can’t do alone, y’know?<clear><br><$voicel(1,7)><$emotion(1,8)>So if ya ever need a hand, you can call on me, got it? I’ve<br>always got your back, pal!
msgctxt "1968:808"
msgid "<$voicel(1,5)><$emotion(1,14)>Por muy manitas que seas, habrá algo que no puedas<br>hacer tú sol<gen;-2(o,a)>, ¿no?<clear><br><$voicel(1,7)><$emotion(1,8)>¡Si eso, me avisas, y yo vengo al rescate!"
msgstr "<$voicel(1,5)><$emotion(1,14)>Por muy hábil que seas, habrá algo que no puedas<br>hacer tú sol<gen;-2(o,a)>, ¿no?<clear><br><$voicel(1,7)><$emotion(1,8)>¡Si es así, me avisas, y yo vengo al rescate!"

#. en: <$voicel(1,3)><$comeff(1,14)><$motion(1,666)>I noticed this huge bush movin’ around earlier, so I crept<br>up close and saw...<clear><br><$voicel(1,7)><$emotion(1,49)><$cdef(27)>Professor Tangrowth</color>! Ha! That grassy goof looks totally<br>different from behind, am I right?
msgctxt "1968:809"
msgid "<$voicel(1,3)><$comeff(1,14)><$motion(1,666)>Buah, el otro día vi un arbusto moverse, ¡y yo flipando!<br>Así que me acerqué despacio...<clear><br><$voicel(1,7)><$emotion(1,49)>¡Y resultó ser el <$cdef(27)>Profesor Tangrowth</color>! Es que por detrás<br>parecía un arbusto de los de toda la vida, te lo juro."
msgstr "<$voicel(1,3)><$comeff(1,14)><$motion(1,666)>Uf, el otro día vi un arbusto moverse, ¡y yo alucinando!<br>Así que me acerqué despacio...<clear><br><$voicel(1,7)><$emotion(1,49)>¡Y resultó ser el <$cdef(27)>Profesor Tangrowth</color>! Es que por detrás<br>parecía un arbusto de los de toda la vida, te lo juro."

#. en: <oneline><$voicel(1,7)><$emotion(1,38)>This whole “livin’ with someone” thing’s pretty fun!<clear><br><$voicel(1,5)><$comeff(1,9)><$motion(1,805)><$facial(1,4)>Or maybe it’s just livin’ with YOU that makes it<br>fun, <$cdef(27)><pname;0></color>.
msgctxt "1968:810"
msgid "<$voicel(1,7)><$emotion(1,38)>¡Buah, tener compañer<gen;-2(o,a)> de keli es un flipe! <$voicel(1,5)><$comeff(1,9)><$motion(1,805)><$facial(1,4)>Aunque igual<br>me flipa porque eres tú, <$cdef(27)><pname;0></color>."
msgstr "<$voicel(1,7)><$emotion(1,38)>¡Guau, tener compañer<gen;-2(o,a)> de casa es genial! <$voicel(1,5)><$comeff(1,9)><$motion(1,805)><$facial(1,4)>Aunque tal vez<br>me encanta porque eres tú, <$cdef(27)><pname;0></color>."

#. en: <$voicel(1,5)><$emotion(1,14)>When I sing, sometimes folks nearby will drop what they’re<br>doin’ just to listen to my song.<clear><br><$voicel(1,7)><$emotion(1,8)>Ha! Guess I’m a pretty good singer, huh? ♪
msgctxt "1968:811"
msgid "<$voicel(1,5)><$emotion(1,14)>Cuando canto, de vez en cuando veo a otros Pokémon<br>que me escuchan ensimismados.<clear><br><$voicel(1,7)><$emotion(1,8)>¡Eso es que debo de tener una voz que flipas de bonita!<br>¡Jua, jua!"
msgstr "<$voicel(1,5)><$emotion(1,14)>Cuando canto, de vez en cuando veo a otros Pokémon<br>que me escuchan ensimismados.<clear><br><$voicel(1,7)><$emotion(1,8)>¡Será que tengo una voz increíblemente bonita!<br>¡Jua, jua!"

#. en: <$voicel(1,7)><$emotion(1,8)>I always get super hungry after a workout.<clear><br><$voicel(1,5)><$emotion(1,49)>Well, maybe it’s not me that’s hungry—it’s my muscles!
msgctxt "1968:812"
msgid "<$voicel(1,7)><$emotion(1,8)>¡Hay que comer bien para ponerse tan fuerte como yo,<br>herman<gen;-2(o,a)>! <$voicel(1,5)><$emotion(1,49)>No solo basta con entrenar duro, ¿eh?<clear><br>¡Pasando hambre, nadie tiene fuerzas para nada!"
msgstr ""

#. en: <$voicel(1,4)><$emotion(1,29)>Hey, do I look scary?<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,666)>I’m not tryin’ to look that way on purpose... But I guess I<br>might <$voicel(1,4)>look more intimidatin’ than you, huh?
msgctxt "1968:814"
msgid "<$voicel(1,4)><$emotion(1,29)>¿Crees que mi cara intimida, herman<gen;-2(o,a)>? <$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Que conste que<br>no estoy de mal humor... <$voicel(1,4)>aunque sé que puedo resultar<slide><br>un poco intens<gen;-3(o,a)>, ¡jua, jua!"
msgstr ""

#. en: <$voicel(1,5)><$emotion(1,29)>Hey, do you think my tastes and stuff’ll change as<br>I get older?<clear><br><$voicel(1,3)><$comeff(1,14)><$motion(1,666)>Maybe all the berries I hate will suddenly taste super<br>good, or the ones I like will taste awful instead...<clear><br><$voicel(1,7)><$emotion(1,49)>Growin’ up’s kinda wild, huh?
msgctxt "1968:817"
msgid "<$voicel(1,5)><$emotion(1,29)>Cuando sea más mayor, ¿tú crees que me cambiarán los<br>gustos? <$voicel(1,3)><$comeff(1,14)><$motion(1,666)>¿Te imaginas que acabo odiando mis bayas<slide><br>favoritas, o al revés?<clear><br><$voicel(1,7)><$emotion(1,49)>¡Esto de hacerse mayor es un movidón que flipas!"
msgstr "<$voicel(1,5)><$emotion(1,29)>Cuando sea más grande, ¿tú crees que me cambiarán los<br>gustos? <$voicel(1,3)><$comeff(1,14)><$motion(1,666)>¿Te imaginas que acabo odiando mis bayas<slide><br>favoritas, o al revés?<clear><br><$voicel(1,7)><$emotion(1,49)>¡Esto de hacerse mayor es un lío tremendo!"

#. en: <oneline><$voicel(1,5)><$comeff(1,14)><$motion(1,805)><$cdef(27)><$tonepk;0(2)></color> is such a little scamp! Always<br>yappin’<slide><br>away<slide><br>and<slide><br>makin’ mischief...<clear><br><$voicel(1,7)><$emotion(1,49)>Just like the old me! Ha! Kinda makes me wanna keep an<br>eye on them, y’know?
msgctxt "1968:819"
msgid "<$voicel(1,5)><$comeff(1,14)><$motion(1,805)>¡Buah, <dart;0()><$cdef(27)><$tonepk;0(2)> </color>es un trasto!<clear><br>No se calla ni debajo del agua, y no hace más que<br>travesuras...<clear><br><$voicel(1,7)><$emotion(1,49)>Es una movida, pero es que me recuerda a cuando yo era<br>pequeñ<gen;-3(o,a)>, así que no se me escapa una, ¡jua, jua!"
msgstr "<$voicel(1,5)><$comeff(1,14)><$motion(1,805)>¡Uf, <dart;0()><$cdef(27)><$tonepk;0(2)> </color>es un torbellino!<clear><br>No se calla ni debajo del agua, y no hace más que<br>travesuras...<clear><br><$voicel(1,7)><$emotion(1,49)>Es un lío, pero es que me recuerda a cuando yo era<br>pequeñ<gen;-3(o,a)>, así que no se me escapa una, ¡jua, jua!"

#. en: <$voicel(1,7)><$emotion(1,14)><$facial(1,4)>Gotta say, <$cdef(27)><$tonepk;0(17)></color> rules!<clear><br><$voicel(1,5)>Maybe ’cause their whole vibe is just so...<wait(0.6)>unique, y’know?<wait(0.3)><br>In any case, <$voicel(1,8)><$emotion(1,8)>they’re super fun to hang with. We always<slide><br>end up kickin’ it for hours!
msgctxt "1968:834"
msgid "<$voicel(1,7)><$emotion(1,14)><$facial(1,4)>¡Buah, soy muy fan <esde;0()><$cdef(27)><$tonepk;0(17)></color>!<clear><br><$voicel(1,5)>Se nota que no es como los demás Pokémon, tiene algo<br>especial.<clear><br><$voicel(1,8)><$emotion(1,8)>¡Te lo juro, pana, no me canso de pasar tiempo a su lado!"
msgstr "<$voicel(1,7)><$emotion(1,14)><$facial(1,4)>¡Guau, soy muy fan <esde;0()><$cdef(27)><$tonepk;0(17)></color>!<clear><br><$voicel(1,5)>Se nota que no es como los demás Pokémon, tiene algo<br>especial.<clear><br><$voicel(1,8)><$emotion(1,8)>¡Te lo juro, compa, no me canso de pasar tiempo a su lado!"

#. en: <$emotion(1,38)><$voicel(1,7)>Havin’ a massive jaw means I can fit more food in my maw!<clear><br><$facial(1,2)><$voicel(1,2)>Or, wait... <wait(1.0)><$comeff(1,6)><$motion(1,666)><$facial(1,2)><$voicel(1,5)>Is stuffing food in my maw what got me this<br>massive jaw?
msgctxt "1968:838"
msgid "<$emotion(1,38)><$voicel(1,7)>¡Tener esta mandibulaza me permite comer todo lo que<br>quiera!<clear><br><$facial(1,2)><$voicel(1,2)>Aunque... <wait(1.0)><$comeff(1,6)><$motion(1,666)><$facial(1,2)><$voicel(1,5)>¿no será que la mandíbula me ha crecido tanto<br>por comer sin parar?"
msgstr ""

#. en: <$voicel(1,5)><$comeff(1,14)><$motion(1,666)>What’s up with <$cdef(27)><gevcmainpk;0></color>? They seem way more excited<br>than usual about somethin’. <$voicel(1,8)><$emotion(1,49)>You should go talk to ’em!
msgctxt "1968:851"
msgid "<oneline><$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Buah, chava<gen;-2(l,la)>... No sé qué le pasa <esa;0()><$cdef(27)><gevcmainpk;0></color>,<br>pero está<slide><br>que no para. <$voicel(1,8)><$emotion(1,49)>¡Dile algo, a ver qué te cuenta!"
msgstr "<oneline><$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Uf, chava<gen;-2(l,la)>... No sé qué le pasa <esa;0()><$cdef(27)><gevcmainpk;0></color>,<br>pero está<slide><br>que no para. <$voicel(1,8)><$emotion(1,49)>¡Dile algo, a ver qué te cuenta!"

#. en: <$emotion(1,38)><$voicel(1,10)>Ha! Gotcha! I don’t talk like that.<clear><br><$emotion(1,29)><$voicel(1,7)>You got any idea who I was pretendin’ to be? Pretty sure I<br>nailed that impression.
msgctxt "1968:853"
msgid "...<clear><br><$emotion(1,38)><$voicel(1,10)>¡Va, ya paro! Si es que me parto haciendo esto, jua, jua.<clear><br><$emotion(1,29)><$voicel(1,7)>¿Qué me dices, panita? ¿Sabes a quién acabo de imitar?<br>Yo creo que lo he clavado..."
msgstr "...<clear><br><$emotion(1,38)><$voicel(1,10)>¡Ok, ya paro! Es que me muero de risa con esto, jua, jua.<clear><br><$emotion(1,29)><$voicel(1,7)>¿Qué me dices, compa? ¿Sabes a quién acabo de imitar?<br>Yo creo que lo clavé..."

#. en: <$comeff(1,20)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Bingo! Nice. I’m glad you got it, pal!
msgctxt "1968:854"
msgid "<$comeff(1,20)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Toma ya! Me alegro de que lo hayas adivinado, ¿eh?<br>Eso es que lo he hecho genial."
msgstr "<$comeff(1,20)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Bien! Me alegro de que lo hayas adivinado, ¿eh?<br>Eso es que lo hice genial."

#. en: <oneline><$comeff(1,1)><$facial(1,4)><$motion(1,806)><$voicel(1,9)><$pkcry;0(1,4)>, too bad! That was supposed to be<br><$cdef(27)><apfquizpk;1(0)></color>.<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,6)>Guess my impersonatin’ skills need some work...
msgctxt "1968:855"
msgid "<oneline><$comeff(1,1)><$facial(1,4)><$motion(1,806)><$voicel(1,9)><$pkcry;0(1,4)>... ¡Has fallado! Si estaba clarísimo que<br>estaba imitando <esa;1()><$cdef(27)><apfquizpk;1(0)></color>, ¿no?<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,6)>Se ve que las imitaciones se me dan peor que los chistes..."
msgstr "<oneline><$comeff(1,1)><$facial(1,4)><$motion(1,806)><$voicel(1,9)><$pkcry;0(1,4)>... ¡Fallaste! Si estaba clarísimo que<br>estaba imitando <esa;1()><$cdef(27)><apfquizpk;1(0)></color>, ¿no?<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,6)>Se ve que las imitaciones se me dan peor que los chistes..."

#. en: <$cdef(27)><$voicel(1,5)><$motion(1,666)><$facial(1,2)><$comeff(1,6)></color>What? You want me to hold on to that <$cdef(27)><fqty(1)><$ifull(432)> </color>for<br>ya?<wait(0.4)> <$emotion(1,60)><$voicel(1,8)>Sure thing, pal!
msgctxt "1968:859"
msgid "<$cdef(27)><$voicel(1,5)></color><$motion(1,666)><$facial(1,2)><$comeff(1,6)>¿Cómo dices, herman<gen;-2(o,a)>? ¿Quieres que me quede con este<br><$cdef(27)><fqty(1)><$ifull(432)></color>? <wait(1.0)><$emotion(1,60)><$voicel(1,8)>Vale, lo que tú digas."
msgstr "<$cdef(27)><$voicel(1,5)></color><$motion(1,666)><$facial(1,2)><$comeff(1,6)>¿Cómo dices, herman<gen;-2(o,a)>? ¿Quieres que me quede con este<br><$cdef(27)><fqty(1)><$ifull(432)></color>? <wait(1.0)><$emotion(1,60)><$voicel(1,8)>Bueno, lo que tú digas."

#. en: <$emotion(1,15)><$voicel(1,9)>Whoa, whoa, WHOA! What’s goin’ on?!<clear><br><$emotion(1,38)><$voicel(1,7)>Was this some kinda super special <$cdef(27)><fqty(1)><$ifull(432)></color>?! I had no<br>idea! <$emotion(1,14)><$voicel(1,6)>You can have it back, <$cdef(27)><pname;0></color>.
msgctxt "1968:860"
msgid "<oneline><$emotion(1,15)><$voicel(1,9)>¡Uala! Pero ¿qué pasa?<clear><br><$emotion(1,38)><$voicel(1,7)>¿Este <$cdef(27)><fqty(1)><$ifull(432)></color> es mágico o algo así?<br><$emotion(1,14)><$voicel(1,6)>Será mejor que te lo devuelva si eso,<slide><br><$cdef(27)><pname;0></color>."
msgstr "<oneline><$emotion(1,15)><$voicel(1,9)>¡Guau! Pero ¿qué pasa?<clear><br><$emotion(1,38)><$voicel(1,7)>¿Este <$cdef(27)><fqty(1)><$ifull(432)></color> es mágico o algo así?<br><$emotion(1,14)><$voicel(1,6)>Será mejor que te lo devuelva entonces,<slide><br><$cdef(27)><pname;0></color>."

#. en: <oneline><$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>Whoa! <$cdef(27)><pname;0></color>?! I had no clue that was<br>you.<slide><br><wait(0.4)><$comeff(1,3)><$facial(1,4)><$motion(1,806)><$voicel(1,6)>Nice one!<clear><br><$comeff(1,9)><$motion(1,801)><$voicel(1,8)>Here, take some <$cdef(27)><fqty(1)><$ifull(532)></color>!
msgctxt "1968:862"
msgid "<oneline><$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>¡Buaaah! ¿En serio eras tú, <$cdef(27)><pname;0></color>?<br>No me lo esperaba<slide><br>para nada, qué fuerte.<clear><br><$comeff(1,3)><$facial(1,4)><$motion(1,806)><$voicel(1,6)>Lo has hecho genial, <gen;-2(bro,sis)>, así que tengo un regalo para ti.<br><wait(1.0)><$comeff(1,9)><$motion(1,801)><$voicel(1,8)>Toma, una <$cdef(27)><fqty(1)><$ifull(532)></color>."
msgstr "<oneline><$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>¡Guaaau! ¿En serio eras tú, <$cdef(27)><pname;0></color>?<br>No me lo esperaba<slide><br>para nada, qué locura.<clear><br><$comeff(1,3)><$facial(1,4)><$motion(1,806)><$voicel(1,6)>Lo hiciste genial, <gen;-2(bro,sis)>, así que tengo un regalo para ti.<br><wait(1.0)><$comeff(1,9)><$motion(1,801)><$voicel(1,8)>Toma, una <$cdef(27)><fqty(1)><$ifull(532)></color>."

#. en: <oneline><$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>Whoa! <$cdef(27)><pname;0></color>?! I had no clue that was<br>you.<slide><br><wait(0.4)><$comeff(1,3)><$facial(1,4)><$motion(1,806)><$voicel(1,6)>Nice one!<clear><br><$comeff(1,9)><$motion(1,801)><$voicel(1,8)>Here, take some <$cdef(27)><fqty(1)><$ifull(532)></color>!
msgctxt "1968:863"
msgid "<oneline><$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>¡Buaaah! ¿En serio eras tú, <$cdef(27)><pname;0></color>?<br>No me lo esperaba<slide><br>para nada, qué fuerte.<clear><br><$comeff(1,3)><$facial(1,4)><$motion(1,806)><$voicel(1,6)>Lo has hecho genial, <gen;-2(bro,sis)>, así que tengo un regalo para ti.<br><wait(1.0)><$comeff(1,9)><$motion(1,801)><$voicel(1,8)>Toma, unas <$cdef(27)><fqty(2)><$ifull(532)></color>."
msgstr "<oneline><$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>¡Guaaau! ¿En serio eras tú, <$cdef(27)><pname;0></color>?<br>No me lo esperaba<slide><br>para nada, qué locura.<clear><br><$comeff(1,3)><$facial(1,4)><$motion(1,806)><$voicel(1,6)>Lo hiciste genial, <gen;-2(bro,sis)>, así que tengo un regalo para ti.<br><wait(1.0)><$comeff(1,9)><$motion(1,801)><$voicel(1,8)>Toma, unas <$cdef(27)><fqty(2)><$ifull(532)></color>."

#. en: <$voicel(1,8)><$emotion(1,14)>What? That sounds great!<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,805)>But I’m not the only one who wants to go, huh?<clear><br><$voicel(1,7)><$emotion(1,49)>Eh, no sweat—I can wait till next time! Ask me again once<br>things’ve settled down.
msgctxt "1968:902"
msgid "<$voicel(1,8)><$emotion(1,14)>¿De verdad? ¡Qué flipe! <wait(0.6)><$voicel(1,5)><$comeff(1,14)><$motion(1,805)>Pero hay un montón de peña<br>que también quiere ir, ¿no?<clear><br><$voicel(1,7)><$emotion(1,49)>¡Nada, nada, que vayan ellos! ¡A mí ya me invitarás otra<br>vez cuando tengas tiempo!"
msgstr "<$voicel(1,8)><$emotion(1,14)>¿De verdad? ¡Qué genial! <wait(0.6)><$voicel(1,5)><$comeff(1,14)><$motion(1,805)>Pero hay un montón de gente<br>que también quiere ir, ¿no?<clear><br><$voicel(1,7)><$emotion(1,49)>¡Nada, nada, que vayan ellos! ¡A mí ya me invitarás otra<br>vez cuando tengas tiempo!"

#. en: <$voicel(1,7)><$emotion(1,14)>I’m headin’ out! Thanks again for the invite, pal! <$voicel(1,10)><$emotion(1,8)>I had a<br>real fun time!
msgctxt "1968:903"
msgid "<$voicel(1,7)><$emotion(1,14)>¡Pues nada, me voy a ir yendo! ¡Gracias por invitarme!<br><$voicel(1,10)><$emotion(1,8)>Ha sido la caña, <gen;-2(bro,sis)>."
msgstr "<$voicel(1,7)><$emotion(1,14)>¡Pues nada, me voy a ir yendo! ¡Gracias por invitarme!<br><$voicel(1,10)><$emotion(1,8)>Fue genial, <gen;-2(bro,sis)>."

#. en: <$voicel(1,8)><$emotion(1,14)>Whoa, you sure?<clear><br><$voicel(1,5)><$emotion(1,8)>Aw yeah, I’d love to come visit! I’ll head over a bit<br>later, OK?
msgctxt "1968:904"
msgid "<$voicel(1,8)><$emotion(1,14)>¡¿Qué dices, <gen;-2(chaval,chavala)>?!<clear><br><$voicel(1,5)><$emotion(1,8)>Buah, pues claro, luego me paso."
msgstr "<$voicel(1,8)><$emotion(1,14)>¡¿Qué dices, <gen;-2(chaval,chavala)>?!<clear><br><$voicel(1,5)><$emotion(1,8)>Ah, pues claro, luego me paso."

#. en: <$voicel(1,7)><$voicel(1,7)><$emotion(1,49)>Hey, hey! You goin’ somewhere? Take me too!
msgctxt "1968:905"
msgid "<$voicel(1,7)><$voicel(1,7)><$emotion(1,49)>Ey, ¿adónde vas, herman<gen;-2(o,a)>? ¡Llévame contigo!"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,14)>What! Aw well, no prob. Have a super fun time!
msgctxt "1968:906"
msgid "<$voicel(1,7)><$emotion(1,14)>¡Buuu, aguafiestas! Jua, jua, ¡es broma! ¡Pásalo bien!"
msgstr "<$voicel(1,7)><$emotion(1,14)>¡Buuu, aguafiestas! Jua, jua, ¡es broma! ¡Pásala bien!"

#. en: <$voicel(1,7)><$emotion(1,39)>Dang, that was super fun! We gotta go again sometime,<br>right, <$cdef(27)><pname;0></color>?
msgctxt "1968:907"
msgid "<$voicel(1,7)><$emotion(1,39)>¡Buah, me lo he pasado como loc<gen;-3(o,a)>! ¡Tenemos que repetir<br>otro día, <$cdef(27)><pname;0></color>!"
msgstr "<$voicel(1,7)><$emotion(1,39)>¡Guau, me la pasé como loc<gen;-3(o,a)>! ¡Tenemos que repetir<br>otro día, <$cdef(27)><pname;0></color>!"

#. en: <oneline><$comeff(1,10)><$motionoff(1,804)><$voicel(1,9)>What’s up, <$cdef(27)><pname;0></color>? The party’s here!<clear><br><$comeff(1,9)><$motion(1,803)><$voicel(1,10)>You remember me, right? I’m <$cdef(27)><nowner;2></color>’s<br>coolest friend!<clear><br><$comeff(1,3)><$facial(1,4)><$motion(1,805)><$voicel(1,7)>Dang, this is a nice area. It’s giving my place back home a<br>run for its money!
msgctxt "1968:921"
msgid "<oneline><$comeff(1,10)><$motionoff(1,804)><$voicel(1,9)>¡Buenas, <$cdef(27)><pname;0></color>!<clear><br><$comeff(1,9)><$motion(1,803)><$voicel(1,10)>¿Te acuerdas de mí? Soy colega<br>de <$cdef(27)><nowner;2></color>.<clear><br><$comeff(1,3)><$facial(1,4)><$motion(1,805)><$voicel(1,7)>Esta zona está tela de bien, eeeh. Está ahí ahí con la mía.<br>Jua, jua."
msgstr "<oneline><$comeff(1,10)><$motionoff(1,804)><$voicel(1,9)>¡Buenas, <$cdef(27)><pname;0></color>!<clear><br><$comeff(1,9)><$motion(1,803)><$voicel(1,10)>¿Te acuerdas de mí? Soy compa<br>de <$cdef(27)><nowner;2></color>.<clear><br><$comeff(1,3)><$facial(1,4)><$motion(1,805)><$voicel(1,7)>Esta zona está súper bien, eeeh. Está a la par con la mía.<br>Jua, jua."
