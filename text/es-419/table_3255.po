#. en: <$comeff(1,9)><$facial(1,4)><$motionoff(1,804)><$voicel(1,10)>Yippee! Nice to meet you!<clear><br><$comeff(1,10)><$facial(1,1)><$motion(1,803)><$voicel(1,7)>This plot of tall grass is kinda small, but I like it!<clear><br><$comeff(1,21)><$facial(1,5)><$motion(1,801)><$voicel(1,9)>I love leaves and grass and stuff. And living by lotsa<br>green things!
msgctxt "3255:0"
msgid "<$comeff(1,9)><$facial(1,4)><$motionoff(1,804)><$voicel(1,10)>¡Hola, holita! ¡Encantad<gen;-3(o,a)> de conocerte!<clear><br><$comeff(1,10)><$facial(1,1)><$motion(1,803)><$voicel(1,7)>Esta zona de hierba alta es pequeñita, ¡pero la verdad<br>es que tiene una pinta genial!<clear><br><$comeff(1,21)><$facial(1,5)><$motion(1,801)><$voicel(1,9)>¡Ay, si es que nada da más paz que vivir rodead<gen;-3(o,a)> de hojas,<br>flores y cositas verdes!"
msgstr ""

#. en: <$voicel(1,5)><$emotion(1,14)>Heya, do you happen to know what area gets the most sun<br>’round here?<clear><br><$voicel(1,3)><$emotion(1,13)>I love to sunbathe every day, but I don’t really know this<br>place too well.<clear><br><$voicel(1,7)><$comeff(1,5)><$motion(1,802)>Oh dang! Sorry bud—this is our first time meeting, isn’t it?<br>My bad, I just went off babbling. <$voicel(1,10)><$comeff(1,9)><$motion(1,801)>Let’s be buddies<slide><br>from now on!
msgctxt "3255:1"
msgid "<$voicel(1,5)><$emotion(1,14)>Oye, figura, tú no conocerás por casualidad el rincón más<br>soleado de por aquí, ¿no?<clear><br><$voicel(1,3)><$emotion(1,13)>Me gusta tomar un poco el sol cada día, pero de esta zona<br>no tengo ni idea, por eso te...<clear><br><$voicel(1,7)><$comeff(1,5)><$motion(1,802)>¡Ay! ¡Menuda chapa te estoy soltando así de primeras<br>y nos acabamos de cruzar! Perdona, ¿eh?<clear><br><$voicel(1,10)><$comeff(1,9)><$motion(1,801)>¡Encantad<gen;-3(o,a)> de conocerte!"
msgstr "<$voicel(1,5)><$emotion(1,14)>Oye, tú no conocerás por casualidad el rincón más<br>soleado de por aquí, ¿no?<clear><br><$voicel(1,3)><$emotion(1,13)>Me gusta tomar un poco el sol cada día, pero de esta zona<br>no tengo ni idea, por eso te...<clear><br><$voicel(1,7)><$comeff(1,5)><$motion(1,802)>¡Ay! ¡Qué discurso te estoy soltando así de entrada<br>y nos acabamos de cruzar! Perdona, ¿eh?<clear><br><$voicel(1,10)><$comeff(1,9)><$motion(1,801)>¡Encantad<gen;-3(o,a)> de conocerte!"

#. en: <$voicel(1,9)><$emotion(1,14)>Why, hello there! What a pleasure to meet you! Let me<br>guess—you were drawn in by the scent of my flower!<clear><br>...<wait(0.8)><$voicel(1,3)><$comeff(1,3)>Oh dear. You weren’t? <wait(1.0)><$emotion(1,1)><$comeff(1,10)><$motion(1,802)>Whoops! There I go jumping to<br>conclusions again!<clear><br><$voicel(1,7)>But still, wouldn’t you agree that this lovely, sweet scent<br>suits me to a T?<clear><br><$voicel(1,9)><$motion(1,806)><$comeff(1,9)>If you ever want to find me, just follow your nose!
msgctxt "3255:2"
msgid "<$voicel(1,9)><$emotion(1,14)>¿Cómo estás? Es un placer conocerte. Imagino que has<br>llegado hasta mí siguiendo la pista de mi aroma floral...<clear><br>... <wait(0.8)><$voicel(1,3)><$comeff(1,3)>¿Cómo? ¿Que no es así?<wait(1.0)> <$emotion(1,1)><$comeff(1,10)><$motion(1,802)>Vaya, ya estoy sacando<br>conclusiones precipitadas otra vez.<clear><br><$voicel(1,7)>¡Pero estarás de acuerdo en que este dulce y fascinante<br>aroma es perfecto para <gen;-3(un señor,una señora)> de mi categoría!<clear><br><$voicel(1,9)><$motion(1,806)><$comeff(1,9)>Así que ya sabes cómo encontrarme: ¡solo tienes que<br>seguir a tu nariz! Jo, jo, jo."
msgstr ""

#. en: <$voicel(1,8)><$facial(1,13)><$comeff(1,5)>Uh-oh!<wait(1.0)> <$comeff(1,10)><$facial(1,4)>Be careful around my tail—<$motion(1,803)>if you bump into it,<br>you could get a real nasty burn!<clear><br><$voicel(1,5)><$emotion(1,3)>My friend stepped on my tail once and got SUPER mad<br>’cause it was so hot...<clear><br><$voicel(1,9)><$motion(1,807)><$comeff(1,4)>Even though I’M the one whose tail got trampled! It hurt so<br>bad I was spitting fire—literally!
msgctxt "3255:3"
msgid "<$voicel(1,8)><$facial(1,13)><$comeff(1,5)>¡Ey! <wait(1.0)><$comeff(1,10)><$facial(1,4)>¡Cuidadín con mi cola, <$motion(1,803)>que te puedes quemar!<clear><br><$voicel(1,5)><$emotion(1,3)>Anda que no se han enfadado conmigo ni nada mis<br>compis al pisármela sin querer y chamuscarse...<clear><br><$voicel(1,9)><$motion(1,807)><$comeff(1,4)>¡Cuando en realidad quien más sufre es mi pobre cola!<br>¡Echo fuego por la boca y todo del dolor!"
msgstr "<$voicel(1,8)><$facial(1,13)><$comeff(1,5)>¡Ey! <wait(1.0)><$comeff(1,10)><$facial(1,4)>¡Cuidadín con mi cola, <$motion(1,803)>que te puedes quemar!<clear><br><$voicel(1,5)><$emotion(1,3)>No sabes cuánto se enojaron conmigo mis<br>amigos al pisármela sin querer y chamuscarse...<clear><br><$voicel(1,9)><$motion(1,807)><$comeff(1,4)>¡Cuando en realidad quien más sufre es mi pobre cola!<br>¡Echo fuego por la boca y todo del dolor!"

#. en: <$voicel(1,9)><$comeff(1,3)>Oh?<wait(0.8)> Did our eyes just meet? All right,<$motion(1,802)> let’s battle!<clear><br>...<wait(1.0)><$voicel(1,8)><$comeff(1,6)>Huh?<wait(0.8)> Wait a sec. <$motion(1,805)>You LOOK like a human, but...<$voicel(1,10)>you’re<br>actually a Pokémon!<clear><br><$voicel(1,5)><$comeff(1,14)>Guess I’m not the only one who can do a pretty slick<br>human impression.<clear><br><$voicel(1,8)><$comeff(1,10)><$motion(1,803)>But anyway, nice to meet another talented trickster!
msgctxt "3255:4"
msgid "<$voicel(1,9)><$comeff(1,3)>¿Oh?<wait(0.8)> ¡¿Me has mirado a los ojos?! Pues na, <$motion(1,802)>¡a combatir!<clear><br>... <wait(1.0)><$voicel(1,8)><$comeff(1,6)>Para el carro... <wait(0.8)><$motion(1,805)>Tú vas con pintas de human<gen;-2(o,a)>, pero...<br><wait(0.8)><$voicel(1,10)>¡eres un Pokémon!<clear><br><$voicel(1,5)><$comeff(1,14)>Así que no soy <gen;-3(el único al,la única a la)> que le gusta imitar a los<br>humanos por las risas...<clear><br><$voicel(1,8)><$comeff(1,10)><$motion(1,803)>¡Pues nada, espero que seamos panas en el futuro!"
msgstr "<$voicel(1,9)><$comeff(1,3)>¿Oh?<wait(0.8)> ¡¿Me miraste a los ojos?! Pues na, <$motion(1,802)>¡a combatir!<clear><br>... <wait(1.0)><$voicel(1,8)><$comeff(1,6)>Un momento... <wait(0.8)><$motion(1,805)>Tú tienes pinta de human<gen;-2(o,a)>, pero...<br><wait(0.8)><$voicel(1,10)>¡eres un Pokémon!<clear><br><$voicel(1,5)><$comeff(1,14)>Así que no soy <gen;-3(el único al,la única a la)> que le gusta imitar a los<br>humanos por las risas...<clear><br><$voicel(1,8)><$comeff(1,10)><$motion(1,803)>¡Pues nada, espero que seamos buenos amigos en el futuro!"

#. en: <$voicel(1,7)><$comeff(1,1)>Hey, heyyy! You live around here? You wouldn’t happen to<br>know any strong local Pokémon, would ya?<clear><br><$voicel(1,8)><$motion(1,807)>Strong Pokémon all have a special bond—we just “get”<br>each other, y’know?<clear><br><$facial(1,4)><$voicel(1,9)><$comeff(1,10)><$motion(1,801)>So, I was thinkin’ that if I could find someone as strong as<br>me, maybe we could become buds!<clear><br><$facial(1,1)><$voicel(1,5)><$motion(1,805)>No offense, but you don’t look all that strong to me!<$lookat(0,1,1)><waitactor(0)><$motion(0,748)><wait(0.9)><clear><br><$voicel(1,10)><$motion(1,802)><$comeff(1,5)>W-Water Gun?! Maybe I spoke too soon...<clear><br><$voicel(1,9)><$facial(1,4)><$comeff(1,9)><$motion(1,801)>All right! You and me are friends now! Catch ya later!
msgctxt "3255:5"
msgid "<$voicel(1,7)><$comeff(1,1)>Ey, ¡qué pasa, niñ<gen;-2(o,a)>! ¿Eres de la zona? No conocerás por<br>un casual a alguien con una fuerza sobrenatural, ¿no?<clear><br><$voicel(1,8)><$motion(1,807)>Es que me entiendo de maravilla con los fortachones<br>como yo, ¿sabes?<clear><br><$facial(1,4)><$voicel(1,9)><$comeff(1,10)><$motion(1,801)>Si conoces a alguien más o menos con similar poderío,<br>¡te agradecería que me lo presentaras!<clear><br><$facial(1,1)><$voicel(1,5)><$motion(1,805)>Porque tú... No te ofendas, pero pareces un ratejo<br>esmirriad<gen;-2(o,a)>.<$lookat(0,1,1)><waitactor(0)><$motion(0,748)><wait(0.9)><clear><br><$voicel(1,10)><$motion(1,802)><$comeff(1,5)>¡¡Zaaard!! ¡Vaya pedazo de Pistola Agua! Veo que tienes<br>agallas, ja, ja.<clear><br><$voicel(1,9)><$facial(1,4)><$comeff(1,9)><$motion(1,801)>¡Pues hale! ¡Desde hoy mismo tú y yo somos colegas!"
msgstr "<$voicel(1,7)><$comeff(1,1)>Ey, ¡qué pasa, niñ<gen;-2(o,a)>! ¿Eres de la zona? No conocerás por<br>casualidad a alguien con una fuerza sobrenatural, ¿no?<clear><br><$voicel(1,8)><$motion(1,807)>Es que me entiendo de maravilla con los fortachones<br>como yo, ¿sabes?<clear><br><$facial(1,4)><$voicel(1,9)><$comeff(1,10)><$motion(1,801)>Si conoces a alguien más o menos con similar poderío,<br>¡te agradecería que me lo presentaras!<clear><br><$facial(1,1)><$voicel(1,5)><$motion(1,805)>Porque tú... No te ofendas, pero pareces un ratoncito<br>esmirriad<gen;-2(o,a)>.<$lookat(0,1,1)><waitactor(0)><$motion(0,748)><wait(0.9)><clear><br><$voicel(1,10)><$motion(1,802)><$comeff(1,5)>¡¡Zaaard!! ¡Vaya pedazo de Chorro de Agua! Veo que<br>tienes agallas, ja, ja.<clear><br><$voicel(1,9)><$facial(1,4)><$comeff(1,9)><$motion(1,801)>¡Pues listo! ¡Desde hoy mismo tú y yo somos amigos!"

#. en: <$comeff(1,10)><$facial(1,4)><$motionoff(1,803)><$voicel(1,7)>Oh wow, nice to meet you! Welcome to my place!<br><$facial(1,4)><$voicel(1,10)>Well, it’s not my place yet. <$comeff(1,13)><$facial(1,5)><$motionoff(1,801)><$voicel(1,9)>I was gonna move in today!<clear><br><$comeff(1,1)><$facial(1,1)><$voicel(1,5)>It’s a nice spot, though, right? Once I hide in my shell<br>here, <$facial(1,1)><$voicel(1,8)>I’ll be totally safe! <$comeff(1,21)><$facial(1,4)><$motionoff(1,816)><$voicel(1,7)>I bet I can even practice my<slide><br>Water Gun!
msgctxt "3255:6"
msgid "<$comeff(1,10)><$facial(1,4)><$motionoff(1,803)><$voicel(1,7)>¡Hola, hola! ¡Bienvenid<gen;-2(o,a)> a mi humilde casita!<clear><br><$facial(1,4)><$voicel(1,10)>Bueno, lo digo como si llevase aquí toda la vida,<br><$comeff(1,13)><$facial(1,5)><$motionoff(1,801)><$voicel(1,9)>pero me acabo de mudar hoy.<clear><br><$comeff(1,1)><$facial(1,1)><$voicel(1,5)>¡Este sitio está genial! Si me meto dentro del caparazón,<br><$facial(1,1)><$voicel(1,8)>estaré a salvo de cualquier peligro, y lo mejor de todo...<slide><br><$comeff(1,21)><$facial(1,4)><$motionoff(1,816)><$voicel(1,7)>¡tengo sitio de sobra para practicar mi Pistola Agua!"
msgstr "<$comeff(1,10)><$facial(1,4)><$motionoff(1,803)><$voicel(1,7)>¡Hola, hola! ¡Bienvenid<gen;-2(o,a)> a mi humilde casita!<clear><br><$facial(1,4)><$voicel(1,10)>Bueno, lo digo como si llevase aquí toda la vida,<br><$comeff(1,13)><$facial(1,5)><$motionoff(1,801)><$voicel(1,9)>pero me acabo de mudar hoy.<clear><br><$comeff(1,1)><$facial(1,1)><$voicel(1,5)>¡Este lugar está genial! Si me meto dentro del caparazón,<br><$facial(1,1)><$voicel(1,8)>estaré a salvo de cualquier peligro, y lo mejor de todo...<slide><br><$comeff(1,21)><$facial(1,4)><$motionoff(1,816)><$voicel(1,7)>¡tengo espacio de sobra para practicar mi Chorro de Agua!"

#. en: <$voicel(1,8)><$comeff(1,1)>Yo! Nice to meet ya! You can catch me ’round<br>here anytime! <clear><br><$voicel(1,7)><$motion(1,805)>What’s that? You’re <$comeff(1,6)>working hard to make it easier on the<br>Pokémon living in the area?<clear><br>Yooo... <wait(0.7)><$voicel(1,6)><$motion(1,803)><$comeff(1,5)>That’s amazing! Like totally awesome!<clear><br><$voicel(1,9)><$motion(1,801)><$comeff(1,21)>Let me know if there’s anything I can help with! <$voicel(1,10)><$motion(1,806)>Oh man,<br>we’re gonna be best buds for, like, 10,000 years!
msgctxt "3255:7"
msgid "<$voicel(1,8)><$comeff(1,1)>¡Oh, una cara nueva! ¡Me alegro de conocerte!<br>Espero que podamos ser colegas.<clear><br><$voicel(1,7)><$motion(1,805)><$comeff(1,6)>Tú eres <gen;-2(el,la)> que ha estado ayudando a otros Pokémon<br>a instalarse, ¿no?<clear><br>... <wait(0.7)><$voicel(1,6)><$motion(1,803)><$comeff(1,5)>¡Pues que sepas que me flipa el gesto!<clear><br><$voicel(1,9)><$motion(1,801)><$comeff(1,21)>Nos esperan diez mil años de amistad, por lo menos,<br><$voicel(1,10)><$motion(1,806)>así que, si te puedo ayudar en algo, ¡avisa!"
msgstr "<$voicel(1,8)><$comeff(1,1)>¡Oh, una cara nueva! ¡Me alegro de conocerte!<br>Espero que podamos ser amigos.<clear><br><$voicel(1,7)><$motion(1,805)><$comeff(1,6)>Tú eres <gen;-2(el,la)> que ha estado ayudando a otros Pokémon<br>a instalarse, ¿no?<clear><br>... <wait(0.7)><$voicel(1,6)><$motion(1,803)><$comeff(1,5)>¡Pues que sepas que me encanta el gesto!<clear><br><$voicel(1,9)><$motion(1,801)><$comeff(1,21)>Nos esperan diez mil años de amistad, por lo menos,<br><$voicel(1,10)><$motion(1,806)>así que, si te puedo ayudar en algo, ¡avisa!"

#. en: <$voicel(1,10)><$motion(1,803)><$comeff(1,12)>Well, howdy there! You got some hustle in yer bustle,<br>don’t ya?!<clear><br><$voicel(1,5)><$comeff(1,6)>What’s got ya runnin’ all over the place?<clear><br><$voicel(1,7)><$motion(1,805)><$comeff(1,14)>...Waterin’ the tall grass? And the flowers too? To make<br>this place more pleasant for all the Pokémon here?<clear><br><$facial(1,5)><$voicel(1,9)><$motion(1,801)><$comeff(1,10)>What a mighty fine thing to do! Truly commendable!<br><$facial(1,1)>I’d love to help out myself...<clear><br><$facial(1,10)><$voicel(1,2)><$motion(1,807)><$comeff(1,18)>But if I tried waterin’ all the plants, I’m like to wash away<br>all the hard work you’ve done so far...<$facial(1,1)><clear><br><$motion(1,802)><$voicel(1,7)><$comeff(1,1)>I tell you what, if there’s anythin’ ELSE I can help with, jus’<br>lemme know! I’ll be cheerin’ ya on in the meantime!
msgctxt "3255:8"
msgid "<$voicel(1,10)><$motion(1,803)><$comeff(1,12)>¡Bueno, bueno, bueno! ¿A qué pequeñ<gen;-2(o,a)> picaruel<gen;-2(o,a)><br>tenemos por aquí, tod<gen;-2(o,a)> pizpiret<gen;-2(o,a)>?<clear><br><$voicel(1,5)><$comeff(1,6)>¿Adónde vas por ahí tan corriendo?<clear><br><$voicel(1,7)><$motion(1,805)><$comeff(1,14)>Ah, ¿que vas esparciendo agua y haciendo crecer muchas<br>plantas y flores para que los Pokémon vivan más a gusto?<clear><br><$facial(1,5)><$voicel(1,9)><$motion(1,801)><$comeff(1,10)>¡Qué aplicad<gen;-2(o,a)> te veo! Haz bien sin mirar a quién, ¿eh?<$facial(1,1)><br>Me gustaría estar ahí contigo, a la pata del cañón.<clear><br><$facial(1,10)><$voicel(1,2)><$motion(1,807)><$comeff(1,18)>Como me ponga a regar, eso sí, igual dejo como unos<br>zorros todo lo que has hecho con tanto esfuerzo.<$facial(1,1)><clear><br><$motion(1,802)><$voicel(1,7)><$comeff(1,1)>Mira, te digo una cosa: si hay alguna forma de ayudarte,<br>¡tú dímelo sin remilgos! ¡Tienes todo mi apoyo!"
msgstr "<$voicel(1,10)><$motion(1,803)><$comeff(1,12)>¡Bueno, bueno, bueno! ¿A qué pequeñ<gen;-2(o,a)> picaruel<gen;-2(o,a)><br>tenemos por aquí, tod<gen;-2(o,a)> pizpiret<gen;-2(o,a)>?<clear><br><$voicel(1,5)><$comeff(1,6)>¿Adónde vas por ahí tan corriendo?<clear><br><$voicel(1,7)><$motion(1,805)><$comeff(1,14)>Ah, ¿que vas esparciendo agua y haciendo crecer muchas<br>plantas y flores para que los Pokémon vivan más a gusto?<clear><br><$facial(1,5)><$voicel(1,9)><$motion(1,801)><$comeff(1,10)>¡Qué aplicad<gen;-2(o,a)> te veo! Haz bien sin mirar a quién, ¿eh?<$facial(1,1)><br>Me gustaría estar ahí contigo, a la pata del cañón.<clear><br><$facial(1,10)><$voicel(1,2)><$motion(1,807)><$comeff(1,18)>Como me ponga a regar, eso sí, igual termino arruinando<br>todo lo que has hecho con tanto esfuerzo.<$facial(1,1)><clear><br><$motion(1,802)><$voicel(1,7)><$comeff(1,1)>Mira, te digo una cosa: si hay alguna forma de ayudarte,<br>¡tú dímelo sin remilgos! ¡Tienes todo mi apoyo!"

#. en: <$comeff(1,5)><$motionoff(1,807)><$facial(1,13)><$voicel(1,10)>Eep! A human! Oooh, are you trying to catch me?!<clear><br><$comeff(1,14)><$facial(1,1)>...<wait(1.1)><$voicel(1,8)>Huh? <$comeff(1,6)><$motionoff(1,803)><wait(1.2)><$voicel(1,9)><$facial(1,4)><$motionoff(1,801)><$comeff(1,21)>Now that I get a closer look at you, you’re not<br>a human at all—you’re a Pokémon!<clear><br><$comeff(1,13)><$voicel(1,7)><$pkcry;1(1,2)>! I can’t believe I met a Pokémon who can<br>transform into a human! <$facial(1,5)><$motionoff(1,804)><$voicel(1,9)>That’s so super AWESOME!
msgctxt "3255:9"
msgid "<$comeff(1,5)><$motionoff(1,807)><$facial(1,13)><$voicel(1,10)>¡Oh, no, <gen;-2(un humano,una humana)>! ¡¿No habrás venido a capturarme?!<clear><br><$comeff(1,14)><$facial(1,1)>... <wait(1.1)><$voicel(1,8)>¿Eh? <$comeff(1,6)><$motionoff(1,803)><wait(1.2)><$voicel(1,9)><$facial(1,4)><$motionoff(1,801)><$comeff(1,21)>Espera un momento... ¡Tú no eres <gen;-2(un humano,una humana)>,<br>eres un Pokémon!<clear><br><$comeff(1,13)><$voicel(1,7)>¡No sabía que hubiera Pokémon que pudieran<br>transformarse así! <$facial(1,5)><$motionoff(1,804)><$voicel(1,9)>¡Menud<gen;-2(o,a)> crack, <flow><$pkcry;1(1,2)>!"
msgstr "<$comeff(1,5)><$motionoff(1,807)><$facial(1,13)><$voicel(1,10)>¡Oh, no, <gen;-2(un humano,una humana)>! ¡¿No habrás venido a capturarme?!<clear><br><$comeff(1,14)><$facial(1,1)>... <wait(1.1)><$voicel(1,8)>¿Eh? <$comeff(1,6)><$motionoff(1,803)><wait(1.2)><$voicel(1,9)><$facial(1,4)><$motionoff(1,801)><$comeff(1,21)>Espera un momento... ¡Tú no eres <gen;-2(un humano,una humana)>,<br>eres un Pokémon!<clear><br><$comeff(1,13)><$voicel(1,7)>¡No sabía que hubiera Pokémon que pudieran<br>transformarse así! <$facial(1,5)><$motionoff(1,804)><$voicel(1,9)>¡Asombros<gen;-2(o,a)>, <flow><$pkcry;1(1,2)>!"

#. en: <$motion(1,806)><$voicel(1,3)><$comeff(1,5)>Whoa! Who’re you? I found this place first, pal.<$motion(0,824)><$comeff(0,1)><wait(0.9)><$motion(0,652)><wait(0.75)><clear><br><$motion(1,803)><$voicel(1,8)><$comeff(1,6)>Say what? YOU made this pretty little field?<$voicel(1,6)> All so that<br>Pokémon can live here, eh?<clear><br><$facial(1,4)><$motion(1,807)><$voicel(1,9)><$comeff(1,21)>Dang, that’s seriously awesome! Mad respect.<clear><br><$motion(1,801)><$voicel(1,7)><$comeff(1,10)>I think I’ll live here now! Thanks a million—I owe ya!
msgctxt "3255:10"
msgid "<$motion(1,806)><$voicel(1,3)><$comeff(1,5)>¡Ey! ¿Quién anda ahí? ¡Que este sitio lo he encontrado<br>yo primero!<$motion(0,824)><$comeff(0,1)><wait(0.9)><$motion(0,652)><wait(0.75)><clear><br><$motion(1,803)><$voicel(1,8)><$comeff(1,6)>Ah, ¿que te lo has currado tú <$voicel(1,6)>para que vivan Pokémon?<clear><br><$facial(1,4)><$motion(1,807)><$voicel(1,9)><$comeff(1,21)>¡Buah, <gen;-2(chaval,chavala)>! Todo mi respeto.<clear><br><$motion(1,801)><$voicel(1,7)><$comeff(1,10)>En ese caso, me quedo a vivir aquí más a gusto que<br>un arbusto. ¡Gracias!"
msgstr "<$motion(1,806)><$voicel(1,3)><$comeff(1,5)>¡Ey! ¿Quién anda ahí? ¡Que este lugar lo encontré<br>yo primero!<$motion(0,824)><$comeff(0,1)><wait(0.9)><$motion(0,652)><wait(0.75)><clear><br><$motion(1,803)><$voicel(1,8)><$comeff(1,6)>Ah, ¿que lo hiciste tú <$voicel(1,6)>para que vivan Pokémon?<clear><br><$facial(1,4)><$motion(1,807)><$voicel(1,9)><$comeff(1,21)>¡Guau, <gen;-2(chaval,chavala)>! Todo mi respeto.<clear><br><$motion(1,801)><$voicel(1,7)><$comeff(1,10)>En ese caso, me quedo a vivir aquí más a gusto que<br>un arbusto. ¡Gracias!"

#. en: <$motion(1,805)><$comeff(1,14)><$voicel(1,3)>Whew, I’m beat... Maybe I’ll have a little rest here for<br>a bit.<$lookat(1,1,0)><waitactor(1)><wait(1.2)><clear><br><$comeff(1,5)><$motion(1,803)><$voicel(1,8)>Oh, dear—you didn’t hear me just now, did you?<br>How embarrassing!<clear><br><$motion(1,802)><$voicel(1,5)><$comeff(1,10)>I was flying around for the first time in a while and it really<br>took it out of me... Must be because I slept for so long.<clear><br><$facial(1,4)><$motion(1,806)><$voicel(1,9)><$comeff(1,21)>Even so, being back in the sky feels wonderful!
msgctxt "3255:11"
msgid "<$motion(1,805)><$comeff(1,14)><$voicel(1,3)>Uf, madre mía, qué cansancio. No puedo ni con mis alas<br>ni con la vida ya...<$lookat(1,1,0)><waitactor(1)><wait(1.2)><clear><br><$comeff(1,5)><$motion(1,803)><$voicel(1,8)>¡Oy! No me digas que me has oído... Ay, qué vergüenza...<br>¿Qué vas a pensar de mí?<clear><br><$motion(1,802)><$voicel(1,5)><$comeff(1,10)>Verás, es que después de pasar tanto tiempo durmiendo,<br>he intentado volar un poco y me he cansado enseguida...<clear><br><$facial(1,4)><$motion(1,806)><$voicel(1,9)><$comeff(1,21)>¡Pero no sabes el gustirrinín que me ha dado volver<br>a estirar las alas, aunque solo haya sido un poquito!"
msgstr "<$motion(1,805)><$comeff(1,14)><$voicel(1,3)>Uf, cielos, qué cansancio. No puedo ni con mis alas<br>ni con la vida ya...<$lookat(1,1,0)><waitactor(1)><wait(1.2)><clear><br><$comeff(1,5)><$motion(1,803)><$voicel(1,8)>¡Oy! No me digas que me oíste... Ay, qué vergüenza...<br>¿Qué vas a pensar de mí?<clear><br><$motion(1,802)><$voicel(1,5)><$comeff(1,10)>Verás, es que después de pasar tanto tiempo durmiendo,<br>intenté volar un poco y me cansé enseguida...<clear><br><$facial(1,4)><$motion(1,806)><$voicel(1,9)><$comeff(1,21)>¡Pero no sabes el gustazo que me dio volver<br>a estirar las alas, aunque solo haya sido un poquito!"

#. en: <$voicel(1,9)><$motion(1,803)><$comeff(1,10)><$pkcry;0(1,2)>!!!<wait(0.5)><clear><br><$voicel(1,8)><$comeff(1,1)><$motion(1,801)>Hehe! Gotcha! Pretty scary, right?<clear><br><$motion(1,805)><$voicel(1,3)>Huh...<wait(0.5)> Your expression didn’t change. Weren’t you scared?<br><wait(0.4)>Even a tiny bit?<clear><br><$motion(1,802)><$comeff(1,14)><$voicel(1,5)>That’s so weird... I thought I was being super sneaky.<clear><br><$motion(1,806)><$comeff(1,21)><$voicel(1,8)>Wow, you sure have nerves of steel!
msgctxt "3255:12"
msgid "<$voicel(1,9)><$motion(1,803)><$comeff(1,10)>¡¡<$pkcry;0(1,2)>!!<wait(0.5)><clear><br><$voicel(1,8)><$comeff(1,1)><$motion(1,801)>¡Qué susto te he dado, eh! ¡Je, je!<clear><br><$motion(1,805)><$voicel(1,3)>... <wait(0.5)>¿Eh? Pero si no te ha cambiado la cara ni un poquito...<br>¿Cómo puede ser que no te haya asustado?<clear><br><$motion(1,802)><$comeff(1,14)><$voicel(1,5)>¡Si me he acercado a ti en silencio total! No me lo explico.<br><$motion(1,806)><$comeff(1,21)><$voicel(1,8)>¡¿No será que tienes superpoderes o algo así?!"
msgstr "<$voicel(1,9)><$motion(1,803)><$comeff(1,10)>¡¡<$pkcry;0(1,2)>!!<wait(0.5)><clear><br><$voicel(1,8)><$comeff(1,1)><$motion(1,801)>¡Qué susto te di, eh! ¡Je, je!<clear><br><$motion(1,805)><$voicel(1,3)>... <wait(0.5)>¿Eh? Pero si no te cambió la cara ni un poquito...<br>¿Cómo puede ser que no te haya asustado?<clear><br><$motion(1,802)><$comeff(1,14)><$voicel(1,5)>¡Si me acerqué a ti en silencio total! No me lo explico.<br><$motion(1,806)><$comeff(1,21)><$voicel(1,8)>¡¿No será que tienes superpoderes o algo así?!"

#. en: <$comeff(1,1)><$motion(1,816)><$voicel(1,9)>Ssshaaa! Nice to meetcha!<wait(0.4)><$motion(0,215)><clear><br>Wait...<wait(0.7)><$voicel(1,8)><$comeff(1,6)><$motion(1,802)> Aren’t you scared?<clear><br><$comeff(1,14)><$voicel(1,3)><$motion(1,806)>Usually whenever I say hi to someone, they take one look<br>at this pattern on my belly and take off running.<slide><br><$comeff(1,7)><$voicel(1,4)><$motion(1,807)>I’m not gonna lie, it kinda hurts my feelings, y’know?<clear><br><$comeff(1,9)><$voicel(1,9)><$motion(1,803)>But you seem fine around me, so we should be pals!
msgctxt "3255:13"
msgid "<$comeff(1,1)><$motion(1,816)><$voicel(1,9)>¡Buenasss! ¡Mucho gusssto!<wait(0.4)><$motion(0,215)><clear><br>... <wait(0.7)>¡Qué raro!<$voicel(1,8)><$comeff(1,6)><$motion(1,802)> ¿No te doy miedo?<clear><br><$comeff(1,14)><$voicel(1,3)><$motion(1,806)>Normalmente, cuando alguien ve los dibujos de mi<br>vientre, se achanta y sale por patas.<clear><br><$comeff(1,7)><$voicel(1,4)><$motion(1,807)>La verdad es que me deja un poco de bajón...<clear><br><$comeff(1,9)><$voicel(1,9)><$motion(1,803)>Pero a ti no parece importarte, así que ¡creo que nos<br>vamos a llevar bien!"
msgstr "<$comeff(1,1)><$motion(1,816)><$voicel(1,9)>¡Buenasss! ¡Mucho gusssto!<wait(0.4)><$motion(0,215)><clear><br>... <wait(0.7)>¡Qué raro!<$voicel(1,8)><$comeff(1,6)><$motion(1,802)> ¿No te doy miedo?<clear><br><$comeff(1,14)><$voicel(1,3)><$motion(1,806)>Normalmente, cuando alguien ve los dibujos de mi<br>vientre, se asusta y sale corriendo.<clear><br><$comeff(1,7)><$voicel(1,4)><$motion(1,807)>La verdad es que me deja un poco de bajón...<clear><br><$comeff(1,9)><$voicel(1,9)><$motion(1,803)>Pero a ti no parece importarte, así que ¡creo que nos<br>vamos a llevar bien!"

#. en: <$motion(1,805)>... ... ...<wait(0.5)><clear><br><$facial(1,3)><$motion(1,824)><$voicel(1,10)><$comeff(1,1)>OH! Hi! Nice to meet you!<clear><br><$facial(1,5)><$motion(1,806)><$voicel(1,9)><$comeff(1,21)>This is my first time in the area, but it looks like an<br>awesome place to live!<clear><br><$motion(1,805)><$voicel(1,7)><$comeff(1,10)>OK, I’ve got a great idea! Let’s tap our tails together so<br>we’ll always remember the moment we became friends!<clear><br><$voicel(1,8)><$comeff(1,9)>... ... ...<wait(0.9)><$comeff(1,6)><$facial(1,9)>Hm?<wait(0.5)><clear><br><$facial(1,13)><$voicel(1,10)><$comeff(1,5)><$motion(1,803)>OH! <wait(0.5)><$facial(1,1)><$motion(1,801)>I just noticed you don’t actually HAVE a tail. Whoops.<br><$voicel(1,6)><$facial(1,4)><$comeff(1,13)><$motion(1,801)>But you’re my friend from now on—tail or no tail!
msgctxt "3255:14"
msgid "<$motion(1,805)>...<wait(0.5)><clear><br><$facial(1,3)><$motion(1,824)><$voicel(1,10)><$comeff(1,1)>¡Qué hay! ¡Encantad<gen;-3(o,a)>!<clear><br><$facial(1,5)><$motion(1,806)><$voicel(1,9)><$comeff(1,21)>¡Es la primera vez que vengo por aquí, pero me mola<br>mucho el sitio, la verdad!<clear><br><$motion(1,805)><$voicel(1,7)><$comeff(1,10)>¡Ay, el saludo! ¡Venga, choca esa cola!<clear><br><$voicel(1,8)><$comeff(1,9)>... <wait(0.9)><$comeff(1,6)><$facial(1,9)>¿Hm?<wait(0.5)><clear><br><$facial(1,13)><$voicel(1,10)><$comeff(1,5)><$motion(1,803)>¡Ah, perdona!<wait(0.5)> <$facial(1,1)><$motion(1,801)>¡Ahora que me fijo, no tienes cola! ¡Jaaa!<br><$voicel(1,6)><$facial(1,4)><$comeff(1,13)><$motion(1,801)>Pero no pasa nada, nos podemos llevar bien igual."
msgstr "<$motion(1,805)>...<wait(0.5)><clear><br><$facial(1,3)><$motion(1,824)><$voicel(1,10)><$comeff(1,1)>¡Qué hay! ¡Encantad<gen;-3(o,a)>!<clear><br><$facial(1,5)><$motion(1,806)><$voicel(1,9)><$comeff(1,21)>¡Es la primera vez que vengo por aquí, pero me gusta<br>mucho el lugar, la verdad!<clear><br><$motion(1,805)><$voicel(1,7)><$comeff(1,10)>¡Ay, el saludo! ¡Vamos, choca esa cola!<clear><br><$voicel(1,8)><$comeff(1,9)>... <wait(0.9)><$comeff(1,6)><$facial(1,9)>¿Hm?<wait(0.5)><clear><br><$facial(1,13)><$voicel(1,10)><$comeff(1,5)><$motion(1,803)>¡Ah, perdona!<wait(0.5)> <$facial(1,1)><$motion(1,801)>¡Ahora que me fijo, no tienes cola! ¡Jaaa!<br><$voicel(1,6)><$facial(1,4)><$comeff(1,13)><$motion(1,801)>Pero no pasa nada, nos podemos llevar bien igual."

#. en: <$voicel(1,8)><$motion(1,816)>Zzzp... <wait(0.3)>Zzzhppp... <wait(0.6)><$voicel(1,7)><$motion(1,801)><$comeff(1,21)>Oh, that’s coming along nicely!<clear><br><$lookat(1,1,0)><waitactor(1)><$voicel(1,10)><$comeff(1,1)><$motion(1,802)>Goodness gracious! You didn’t see that just now, did you?<br>How frightfully embarrassing!<clear><br><$voicel(1,9)><$comeff(1,10)><$motion(1,803)>I was just charging up electricity in my tail, you see—to<br>help shake off this groggy feeling! I’ve been so sleepy...<clear><br><$voicel(1,7)><$motion(1,814)><$comeff(1,13)>And if I don’t have electricity, I simply can’t muster up any<br>energy! Zzzhhhuuu...
msgctxt "3255:15"
msgid "<$voicel(1,8)><$motion(1,816)>Bzz... <wait(0.3)>Bbbzzz... <wait(0.6)><$voicel(1,7)><$motion(1,801)><$comeff(1,21)>Ay, qué bien, por fin he podido cargarme<br>un poquito.<clear><br><$lookat(1,1,0)><waitactor(1)><$voicel(1,10)><$comeff(1,1)><$motion(1,802)>Oyoyoy, ¡no me digas que me has visto! Tierra, trágame...<clear><br><$voicel(1,9)><$comeff(1,10)><$motion(1,803)>Solo estaba absorbiendo un poco de corriente por la cola<br>para intentar espabilarme.<clear><br><$voicel(1,7)><$motion(1,814)><$comeff(1,13)>¡Es que sin mi electricidad no soy persona!"
msgstr "<$voicel(1,8)><$motion(1,816)>Bzz... <wait(0.3)>Bbbzzz... <wait(0.6)><$voicel(1,7)><$motion(1,801)><$comeff(1,21)>Ay, qué bien, por fin pude cargarme<br>un poquito.<clear><br><$lookat(1,1,0)><waitactor(1)><$voicel(1,10)><$comeff(1,1)><$motion(1,802)>Oyoyoy, ¡no me digas que me viste! Tierra, trágame...<clear><br><$voicel(1,9)><$comeff(1,10)><$motion(1,803)>Solo estaba absorbiendo un poco de corriente por la cola<br>para intentar despabilarme.<clear><br><$voicel(1,7)><$motion(1,814)><$comeff(1,13)>¡Es que sin mi electricidad no soy persona!"

#. en: <$facial(1,4)><$motion(1,806)><$comeff(1,10)><$voicel(1,9)>Clefairy, <wait(0.3)>Clefairy... ♪<wait(0.3)> Cle<wait(0.3)>fai<wait(0.3)><$motion(1,817)>ryyy! ♪<clear><br><$facial(1,1)><$motion(1,803)><$comeff(1,6)><$voicel(1,5)>How was that dance? Did I mess it up? I’m still a liiittle<br>sleepy.<$facial(1,14)><$motion(1,802)><$comeff(1,1)><$voicel(1,7)> Usually my moves are super sharp, though! ♪<clear><br><$facial(1,1)><$motion(1,801)><$comeff(1,20)><$voicel(1,10)>Oh! Let me show you something really cool. <$motionoff(1,804)><$voicel(1,8)>OK, so...I can<br>fly!<wait(0.3)> Just a little, though.<clear><br><$facial(1,4)><$comeff(1,1)><$voicel(1,10)>Ready? Here I go...<wait(0.3)><$motion(1,801)> Hup!<clear><br><$facial(1,1)><$comeff(1,14)><$voicel(1,6)>...<wait(1.6)><$facial(1,9)><$motion(1,802)><$comeff(1,6)>Huh? It didn’t work. Did I eat too much?
msgctxt "3255:16"
msgid "<$facial(1,4)><$motion(1,806)><$comeff(1,10)><$voicel(1,9)>♪Cleee...<wait(0.3)> Clefa...<wait(0.3)> Cle...<wait(0.3)> Faaai...<wait(0.3)> <$motion(1,817)>Ryyyyyy.♪<clear><br><$facial(1,1)><$motion(1,803)><$comeff(1,6)><$voicel(1,5)>¿Qué te ha parecido el baile? Un poco birria, ¿no?<br>Es que acabo de salir del sobre y no me da la vida...<slide><br><$facial(1,14)><$motion(1,802)><$comeff(1,1)><$voicel(1,7)>Con lo bien que me sale de normal...<clear><br><$facial(1,1)><$motion(1,801)><$comeff(1,20)><$voicel(1,10)>¡Ah, que casi se me olvida! Ya verás qué guapo el final...<br><$motionoff(1,804)><$voicel(1,8)>¿Sabías que puedo flotar por el aire?<clear><br><$facial(1,4)><$comeff(1,1)><$voicel(1,10)>Venga, que voy... <wait(0.3)><$motion(1,801)>¡Jerónimooo!<clear><br><$facial(1,1)><$comeff(1,14)><$voicel(1,6)>... <wait(1.6)><$facial(1,9)><$motion(1,802)><$comeff(1,6)>Pero... ¡Si no puedo flotar! Qué desastre.<br>¿Será que he comido demasiado?"
msgstr "<$facial(1,4)><$motion(1,806)><$comeff(1,10)><$voicel(1,9)>♪Cleee...<wait(0.3)> Clefa...<wait(0.3)> Cle...<wait(0.3)> Faaai...<wait(0.3)> <$motion(1,817)>Ryyyyyy.♪<clear><br><$facial(1,1)><$motion(1,803)><$comeff(1,6)><$voicel(1,5)>¿Qué te pareció el baile? Un poco flojo, ¿no?<br>Es que me acabo de levantar y no doy para más...<slide><br><$facial(1,14)><$motion(1,802)><$comeff(1,1)><$voicel(1,7)>Con lo bien que me sale de normal...<clear><br><$facial(1,1)><$motion(1,801)><$comeff(1,20)><$voicel(1,10)>¡Ah, que casi se me olvida! Ya verás qué lindo el final...<br><$motionoff(1,804)><$voicel(1,8)>¿Sabías que puedo flotar por el aire?<clear><br><$facial(1,4)><$comeff(1,1)><$voicel(1,10)>Vamos, allá voy... <wait(0.3)><$motion(1,801)>¡Jerónimooo!<clear><br><$facial(1,1)><$comeff(1,14)><$voicel(1,6)>... <wait(1.6)><$facial(1,9)><$motion(1,802)><$comeff(1,6)>Pero... ¡Si no puedo flotar! Qué desastre.<br>¿Será que comí demasiado?"

#. en: <$motion(1,816)><$voicel(1,10)><$comeff(1,10)>Goodness me, what an adorable little visitor!<clear><br><$motion(1,803)><$voicel(1,9)><$comeff(1,1)>Do you know what I was thinking this whole time as I<br>listened to your footsteps approaching?<clear><br><$motion(1,805)><$voicel(1,5)><$comeff(1,1)>That they sounded similar to human footsteps, only just a<br>little off...<wait(0.7)><$motion(1,802)><$comeff(1,6)> And who could they belong to?<clear><br><$motion(1,806)><$voicel(1,7)><$comeff(1,21)>Never would I have guessed that it was a <$cdef(27)>Ditto </color>who’s<br>transformed into a human!<clear><br><$motion(1,801)><$voicel(1,9)><$comeff(1,13)>You gave me a start, sure, but I’m happy to make<br>your acquaintance!
msgctxt "3255:17"
msgid "<$motion(1,816)><$voicel(1,10)><$comeff(1,10)>¡Anda, vaya invitad<gen;-2(o,a)> más adorable ha venido a visitarme!<clear><br><$motion(1,803)><$voicel(1,9)><$comeff(1,1)>He oído tus pasos a medida que te acercabas <$motion(1,805)><$voicel(1,5)><$comeff(1,1)>y sonaban<br>como a andares de humano, aunque no del todo...<clear><br>Y, claro, ya estaba yo barrenando... \"si no es un humano,<br><wait(0.7)><$motion(1,802)><$comeff(1,6)>¿quién puede ser?\".<clear><br><$motion(1,806)><$voicel(1,7)><$comeff(1,21)>¡Jamás me habría imaginado que se trataba de un <$cdef(27)>Ditto</color><br>transformado en human<gen;-2(o,a)>!<clear><br><$motion(1,801)><$voicel(1,9)><$comeff(1,13)>¿Dónde se ha visto semejante cosa? Menudo sorpresón<br>me he llevado, oye. ¡Un placer conocerte!"
msgstr "<$motion(1,816)><$voicel(1,10)><$comeff(1,10)>¡Vaya, qué invitad<gen;-2(o,a)> tan adorable vino a visitarme!<clear><br><$motion(1,803)><$voicel(1,9)><$comeff(1,1)>Oí tus pasos a medida que te acercabas <$motion(1,805)><$voicel(1,5)><$comeff(1,1)>y sonaban<br>como a andares de humano, aunque no del todo...<clear><br>Y, claro, ya estaba yo pensando... \"si no es un humano,<br><wait(0.7)><$motion(1,802)><$comeff(1,6)>¿quién puede ser?\".<clear><br><$motion(1,806)><$voicel(1,7)><$comeff(1,21)>¡Jamás me habría imaginado que se trataba de un <$cdef(27)>Ditto</color><br>transformado en human<gen;-2(o,a)>!<clear><br><$motion(1,801)><$voicel(1,9)><$comeff(1,13)>¿Dónde se ha visto semejante cosa? Qué sorpresón<br>me llevé, oye. ¡Un placer conocerte!"

#. en: <$voicel(1,5)><$motion(1,802)><$comeff(1,14)>Oh, uh, one sec... *scratch scratch*... *scratch scratch*...<wait(0.5)><clear><br><$comeff(1,21)><$voicel(1,7)><$motion(1,801)>Whew, I’m done!<clear><br><$voicel(1,8)><$motion(1,817)><$comeff(1,10)>I have so many tails, it’s hard to keep my fur tidy.<clear><br><$voicel(1,9)><$motion(1,803)><$comeff(1,1)>Anyway, now that I’m all sorted, let me greet you properly!<$facial(1,4)><$voicel(1,10)><$motion(1,816)><$comeff(1,13)><br>It’s great to meet you!
msgctxt "3255:18"
msgid "<$voicel(1,5)><$motion(1,802)><$comeff(1,14)>Ay, espera, dame un momento... Un poco por aquí,<br>un poco por allá... <wait(0.5)><$comeff(1,21)><$voicel(1,7)><$motion(1,801)>¡Por fin! Ya está.<clear><br><$voicel(1,8)><$motion(1,817)><$comeff(1,10)>Jo, es que tengo tantas colas que siempre tardo mogollón<br>en acicalármelas para que estén presentables.<clear><br><$voicel(1,9)><$motion(1,803)><$comeff(1,1)>Bueno, ahora que ya está hecho, por fin puedo saludarte<br>como es debido.<clear><br><$facial(1,4)><$voicel(1,10)><$motion(1,816)><$comeff(1,13)>¡Encantad<gen;-3(o,a)> de conocerte!"
msgstr "<$voicel(1,5)><$motion(1,802)><$comeff(1,14)>Ay, espera, dame un momento... Un poco por aquí,<br>un poco por allá... <wait(0.5)><$comeff(1,21)><$voicel(1,7)><$motion(1,801)>¡Por fin! Ya está.<clear><br><$voicel(1,8)><$motion(1,817)><$comeff(1,10)>Ay, es que tengo tantas colas que siempre tardo un montón<br>en acicalármelas para que estén presentables.<clear><br><$voicel(1,9)><$motion(1,803)><$comeff(1,1)>Bueno, ahora que ya está hecho, por fin puedo saludarte<br>como es debido.<clear><br><$facial(1,4)><$voicel(1,10)><$motion(1,816)><$comeff(1,13)>¡Encantad<gen;-3(o,a)> de conocerte!"

#. en: <$motion(1,803)><$voicel(1,6)><$comeff(1,14)>Hm...<wait(0.7)><$voicel(1,5)> You look human,<wait(0.5)> <$motion(1,807)>but that’s not the case, is it?<clear><br><$facial(1,4)><$motion(1,801)><$voicel(1,7)><$comeff(1,9)>Humans were once a common sight. I often used to see<br>them around here.<clear><br><$facial(1,1)><$motion(1,805)><$voicel(1,8)><$comeff(1,6)>Where in the world could they have gone? It’s much less<br>noisy now, but<$motion(1,802)><$voicel(1,5)><$comeff(1,14)> I confess that I miss them a little.
msgctxt "3255:19"
msgid "<$motion(1,803)><$voicel(1,6)><$comeff(1,14)>Uy... <wait(0.7)><$voicel(1,5)>Anda, creía que eras <gen;-2(un,una)> human<gen;-2(o,a)>, <wait(0.5)><$motion(1,807)>pero ya veo que<br>no.<clear><br><$facial(1,4)><$motion(1,801)><$voicel(1,7)><$comeff(1,9)>Hace tiempo, esta zona estaba llenita de humanos... <$facial(1,1)><$motion(1,805)><$voicel(1,8)><$comeff(1,6)><br>Me pregunto adónde habrán ido a parar todos ellos.<clear><br>Es cierto que está todo más tranquilo desde que se<br>fueron, <$motion(1,802)><$voicel(1,5)><$comeff(1,14)>pero a veces se los echa de menos..."
msgstr "<$motion(1,803)><$voicel(1,6)><$comeff(1,14)>Uy... <wait(0.7)><$voicel(1,5)>Vaya, creía que eras <gen;-2(un,una)> human<gen;-2(o,a)>, <wait(0.5)><$motion(1,807)>pero ya veo que<br>no.<clear><br><$facial(1,4)><$motion(1,801)><$voicel(1,7)><$comeff(1,9)>Hace tiempo, esta zona estaba llenita de humanos... <$facial(1,1)><$motion(1,805)><$voicel(1,8)><$comeff(1,6)><br>Me pregunto adónde habrán ido a parar todos ellos.<clear><br>Es cierto que está todo más tranquilo desde que se<br>fueron, <$motion(1,802)><$voicel(1,5)><$comeff(1,14)>pero a veces se los extraña..."

#. en: <$voicel(1,9)><$motion(1,801)><$comeff(1,13)>Jiiigglypuuuff! ♪ Jigglyyyyyypuuuuuuff! ♪<$motion(0,219)><clear><br><$voicel(1,5)><$comeff(1,1)><$motion(1,803)>Oh, hey, what did you think of my song?<clear><br><$voicel(1,3)><$motion(1,802)><$comeff(1,6)>...<wait(0.6)>Huh? You sleepy or something? <wait(0.6)><$motion(0,508)>Or was your face always<br>like that?<clear><br><$voicel(1,6)><$comeff(1,9)><$motion(1,816)>Well, if you’re in the mood, come listen to me sing<br>again sometime!
msgctxt "3255:20"
msgid "<$voicel(1,9)><$motion(1,801)><$comeff(1,13)>♪Jiiigglypuuuff, Jigglyyyyyypuuuuuuff.<br>Jiiigglypuuuff, jigglyyyyyy.♪<$motion(0,219)><clear><br><$voicel(1,5)><$comeff(1,1)><$motion(1,803)>¿Q-qué te ha parecido mi canción? ¿Te ha gustado?<clear><br><$voicel(1,3)><$motion(1,802)><$comeff(1,6)>Uy... <wait(0.6)>No me digas que al oírme te ha entrado sueño...<wait(0.6)><$motion(0,508)><br>O-oh, ¿quizá esa es la cara que tienes siempre?<clear><br><$voicel(1,6)><$comeff(1,9)><$motion(1,816)>Bueno, espero que vengas a escucharme cantar de nuevo."
msgstr "<$voicel(1,9)><$motion(1,801)><$comeff(1,13)>♪Jiiigglypuuuff, Jigglyyyyyypuuuuuuff.<br>Jiiigglypuuuff, jigglyyyyyy.♪<$motion(0,219)><clear><br><$voicel(1,5)><$comeff(1,1)><$motion(1,803)>¿Q-qué te pareció mi canción? ¿Te gustó?<clear><br><$voicel(1,3)><$motion(1,802)><$comeff(1,6)>Uy... <wait(0.6)>No me digas que al oírme te dio sueño...<wait(0.6)><$motion(0,508)><br>O-oh, ¿quizás esa es la cara que tienes siempre?<clear><br><$voicel(1,6)><$comeff(1,9)><$motion(1,816)>Bueno, espero que vengas a escucharme cantar de nuevo."

#. en: <$comeff(1,5)><$motion(1,816)><$voicel(1,9)>PWAAAH!<wait(0.5)><$comeff(0,5)><$motion(0,82)><clear><br><$comeff(1,1)><$motion(1,803)><$voicel(1,7)>Oh, hello there! I hope I didn’t startle you.<clear><br><$comeff(1,10)><$motion(1,806)><$voicel(1,6)>I can inflate my body by inhaling deeply.<clear><br><$comeff(1,21)><$motion(1,802)><$voicel(1,8)>Even the most fearsome foes get frightened and flee when<br>faced with my fluff.<$comeff(1,13)><$motion(1,801)><$voicel(1,10)> Try it yourself the next time you<slide><br>feel threatened!
msgctxt "3255:21"
msgid "<$comeff(1,5)><$motion(1,816)><$voicel(1,9)>¡Tuuuff!<wait(0.5)><$comeff(0,5)><$motion(0,82)><clear><br><$comeff(1,1)><$motion(1,803)><$voicel(1,7)>Uy, ¡hola! Vaya susto te habrás llevado, ju, ju.<clear><br><$comeff(1,10)><$motion(1,806)><$voicel(1,6)>Verás, si inhalas todo el aire que puedas y lo usas para<br>inflarte, <$comeff(1,21)><$motion(1,802)><$voicel(1,8)>¡puedes espantar a cualquier Pokémon malvado<slide><br>que te intente atacar!<clear><br><$comeff(1,13)><$motion(1,801)><$voicel(1,10)>¿Por qué no lo pruebas algún día, a ver si te sale?"
msgstr ""

#. en: <$motion(1,816)><$voicel(1,10)><$comeff(1,1)>Whoa! This looks like a pretty sweet spot to live!<wait(0.9)><br><$lookat(1,1,0)><waitactor(1)><$voicel(1,8)>You’re sayin’<$motion(1,802)><$voicel(1,6)><$comeff(1,6)> YOU made this place?<clear><br><$motion(1,801)><$voicel(1,9)><$comeff(1,10)>Wow, that’s super awesome! Thanks a bunch! I hope we<br>can play together here soon!<clear><br><$motion(1,807)><$voicel(1,10)><$comeff(1,9)>OH! Y’know what’d be fun to do here? A little nighttime<br>hide-and-seek!
msgctxt "3255:22"
msgid "<$motion(1,816)><$voicel(1,10)><$comeff(1,1)>¡Ostras, este lugar es perfecto! <wait(0.9)><$lookat(1,1,0)><waitactor(1)><$voicel(1,8)>¿Eh? <$motion(1,802)><$voicel(1,6)>¿Cómo dices?<br><$comeff(1,6)>¿Que lo has hecho tú?<wait(1.0)> ¡Guau! <$motion(1,801)><$voicel(1,9)><$comeff(1,10)>¡¡Gracias, compi!!<clear><br>¿Qué tal si jugamos al escondite una noche de estas?<br><$motion(1,807)><$voicel(1,10)><$comeff(1,9)>¡Ya verás qué divertido es! Se me da de miedo, je, je."
msgstr "<$motion(1,816)><$voicel(1,10)><$comeff(1,1)>¡Cielos, este lugar es perfecto! <wait(0.9)><$lookat(1,1,0)><waitactor(1)><$voicel(1,8)>¿Eh? <$motion(1,802)><$voicel(1,6)>¿Cómo dices?<br><$comeff(1,6)>¿Que lo hiciste tú?<wait(1.0)> ¡Guau! <$motion(1,801)><$voicel(1,9)><$comeff(1,10)>¡¡Muchas gracias!!<clear><br>¿Qué tal si jugamos al escondite una noche de estas?<br><$motion(1,807)><$voicel(1,10)><$comeff(1,9)>¡Ya verás qué divertido es! Me sale genial, je, je."

#. en: <$comeff(1,5)><$motion(1,803)><$voicel(1,10)>Oy! Whaddaya doin’ on MY turf, huh?<wait(0.6)><$comeff(1,1)><$motion(1,815)><$voicel(1,7)> You better not try<br>anything funny—I’ll suck your blood if you mess with me!<clear><br>...<wait(0.8)><$motion(1,827)><$comeff(1,6)><$voicel(1,6)>What?<wait(0.3)> You’re tellin’ me YOU made this spot here?<br><$comeff(1,21)><$facial(1,5)><$motion(1,801)><$voicel(1,10)>Dang, that’s really something!<clear><br><$comeff(1,10)><$voicel(1,7)>I shoulda known no one with a silly mug like yours could<br>be some kinda villain. My bad, pal.<clear><br><$comeff(1,13)><$motion(1,802)><$voicel(1,9)>I hope we can put this behind us and be friends!
msgctxt "3255:23"
msgid "<$comeff(1,5)><$motion(1,803)><$voicel(1,10)>¡Oye, tú! ¿Qué te crees que haces en mi territorio?<clear><br><$comeff(1,1)><$motion(1,815)><$voicel(1,7)>Como vengas a causar problemas, te chupo la sangre,<br>avisad<gen;-2(o,a)> quedas.<clear><br>... <wait(0.8)><$motion(1,827)><$comeff(1,6)><$voicel(1,6)>¿Ein?<wait(0.3)> ¿Este lugar lo has preparado tú? <$comeff(1,21)><$facial(1,5)><$motion(1,801)><$voicel(1,10)>¡Buah, qué flipe!<clear><br><$comeff(1,10)><$voicel(1,7)>Ahora que lo pienso, con la cara de empan<gen;-2(ao,á)> que tienes,<br>dudo mucho que seas ning<gen;-2(ún,una)> chung<gen;-2(o,a)>.<clear><br><$comeff(1,13)><$motion(1,802)><$voicel(1,9)>¡Nos vemos por ahí, chic<gen;-2(o,a)>!"
msgstr "<$comeff(1,5)><$motion(1,803)><$voicel(1,10)>¡Oye, tú! ¿Qué te crees que haces en mi territorio?<clear><br><$comeff(1,1)><$motion(1,815)><$voicel(1,7)>Como vengas a causar problemas, te chupo la sangre,<br>avisad<gen;-2(o,a)> quedas.<clear><br>... <wait(0.8)><$motion(1,827)><$comeff(1,6)><$voicel(1,6)>¿Ein?<wait(0.3)> ¿Este lugar lo preparaste tú? <$comeff(1,21)><$facial(1,5)><$motion(1,801)><$voicel(1,10)>¡Guau, qué locura!<clear><br><$comeff(1,10)><$voicel(1,7)>Ahora que lo pienso, con la cara de empan<gen;-2(ao,á)> que tienes,<br>dudo mucho que seas ning<gen;-2(ún,una)> malvad<gen;-2(o,a)>.<clear><br><$comeff(1,13)><$motion(1,802)><$voicel(1,9)>¡Nos vemos por ahí, chic<gen;-2(o,a)>!"

#. en: <$motion(1,802)><$voicel(1,3)>OUCH ouch ouch ouch owwww! <wait(0.5)>Hey! Umm...that’s not<br>grass, y’know! <$comeff(1,2)><$voicel(1,4)><$facial(1,9)>Ooooh, my aching head...<clear><br><$comeff(1,1)><$motion(1,807)><$voicel(1,5)><$facial(1,1)>Gosh, you really gave me a shock!<clear><br><$comeff(1,14)><$motion(1,805)><$voicel(1,7)>Whenever I get some sleep, everyone always thinks my<br>head is plain ol’ grass.<clear><br><$comeff(1,13)><$facial(1,4)><$motion(1,806)><$voicel(1,10)>So...uhm...if you’re ever plucking grass around here, just<br>be a little gentle, pretty please!
msgctxt "3255:24"
msgid "<$motion(1,802)><$voicel(1,3)>¡Ayyyy, qué dañooo! <wait(0.5)>Que eso no es un hierbajo, <$comeff(1,2)><$voicel(1,4)><$facial(1,9)>sino parte<br>de mi cabeza...<clear><br><$comeff(1,1)><$motion(1,807)><$voicel(1,5)><$facial(1,1)>Uf, jolín, qué mal rato... <$comeff(1,14)><$motion(1,805)><$voicel(1,7)>Esto me suele pasar cuando me<br>echo la siesta. Siempre hay alguien que me confunde.<clear><br><$comeff(1,13)><$facial(1,4)><$motion(1,806)><$voicel(1,10)>Así que ya sabes: cuando arranques hierbas por esta zona,<br>hazlo con cuidado, por si acaso."
msgstr "<$motion(1,802)><$voicel(1,3)>¡Ayyyy, qué dañooo! <wait(0.5)>Que eso no es un hierbajo, <$comeff(1,2)><$voicel(1,4)><$facial(1,9)>sino parte<br>de mi cabeza...<clear><br><$comeff(1,1)><$motion(1,807)><$voicel(1,5)><$facial(1,1)>Uf, rayos, qué mal rato... <$comeff(1,14)><$motion(1,805)><$voicel(1,7)>Esto me suele pasar cuando me<br>echo la siesta. Siempre hay alguien que me confunde.<clear><br><$comeff(1,13)><$facial(1,4)><$motion(1,806)><$voicel(1,10)>Así que ya sabes: cuando arranques hierbas por esta zona,<br>hazlo con cuidado, por si acaso."

#. en: <$motion(1,801)><$comeff(1,9)><$voicel(1,9)>This place is so comfortable...it makes me want to drool...<br><$comeff(0,5)><$voicel(1,1)><$comeff(1,19)><$motion(1,816)>*sluuuuuurrrp*...<wait(0.3)><$motion(0,81)><$comeff(0,19)><wait(2.5)><clear><br><$voicel(1,7)><$motion(1,803)><$comeff(1,6)>H-hey, you don’t look so good. Are you feeling OK?<$motion(0,824)><$comeff(0,1)><wait(0.9)><$motion(0,652)><wait(0.75)><clear><br><$motion(1,817)><$voicel(1,3)><$comeff(1,6)>What? An overwhelming stench? You can’t stand it?<br>I wonder what it could be. <$voicel(1,3)><$comeff(1,19)><$comeff(0,19)>*sluuurrrp*...<clear><br><$comeff(1,14)><$motion(1,803)><$voicel(1,5)>Hmmm...<wait(0.9)> I actually think...<wait(0.6)><$comeff(1,6)><$motion(1,802)>something smells kinda nice.
msgctxt "3255:25"
msgid "<$motion(1,801)><$comeff(1,9)><$voicel(1,9)>Se está tan a gustito aquí que se me cae la baba...<clear><br><$comeff(0,5)><$voicel(1,1)><$comeff(1,19)><$motion(1,816)>¡Aaay, q-qué susto!<wait(0.3)><$motion(0,81)><$comeff(0,19)><wait(2.5)><clear><br><$voicel(1,7)><$motion(1,803)><$comeff(1,6)>T-tienes mala cara... ¿Estás bien?<$motion(0,824)><$comeff(0,1)><wait(0.9)><$motion(0,652)><wait(0.75)><clear><br><$motion(1,817)><$voicel(1,3)><$comeff(1,6)>Dices que... ¿huele mal? <$voicel(1,3)><$comeff(1,19)><$comeff(0,19)>Qué raro... Yo no noto ningún<br>olor desagradable...<clear><br><$comeff(1,14)><$motion(1,803)><$voicel(1,5)>No sé...<wait(0.9)> Más bien... <wait(0.6)><$comeff(1,6)><$motion(1,802)>diría que huele bastante bien..."
msgstr ""

#. en: <$comeff(1,6)><$motion(1,803)><$voicel(1,5)>Hello there. Did you come to get a better look at these<br>petals of mine?<clear><br><$voicel(1,7)><$comeff(1,9)>Let me impart something you may find useful—<wait(0.6)>you’ve<br>heard the phrase, “Every rose has its thorn,” have<slide><br>you not?<clear><br><$comeff(1,14)><$motion(1,802)><$voicel(1,9)>Well, there are some flowers that are best admired from<br>afar. You shouldn’t go approaching just anything.<clear><br><$voicel(1,7)>Oh! <$motion(1,801)><$comeff(1,1)>You needn’t worry about me—I’m a kind soul through<br>and through.<clear><br><wait(0.9)><$voicel(1,3)>And you don’t look particularly tasty, anyway.<br><$comeff(1,9)><$voicel(1,6)>Hm? Oh, nothing! Just talking to myself.
msgctxt "3255:26"
msgid "<$comeff(1,6)><$motion(1,803)><$voicel(1,5)>Oh, ¿has venido aquí atraíd<gen;-2(o,a)> por la belleza atemporal<br>de mis pétalos?<clear><br><$voicel(1,7)><$comeff(1,9)>Pues permíteme brindarte una valiosa lección vital:<br><wait(0.6)>la beldad esconde una peligrosa verdad.<clear><br><$comeff(1,14)><$motion(1,802)><$voicel(1,9)>Hay flores que es mejor observar desde una distancia<br>prudencial.<clear><br><$voicel(1,7)>Ah...<$motion(1,801)><$comeff(1,1)> Pero, tranquil<gen;-2(o,a)>, tú no tienes nada que temer...<wait(0.9)><br><$voicel(1,3)><$cdef(9)>(No tienes precisamente una pinta suculenta...).</color><slide><br><$comeff(1,9)><$voicel(1,6)>Ah, nada, nada, hablaba para mis adentros."
msgstr ""

#. en: <$voicel(1,5)><$motion(1,814)><$comeff(1,14)>Hmmm... None here, huh.<clear><br><$lookat(1,1,0)><waitactor(1)><$voicel(1,6)><$comeff(1,5)>Oh. Uh... Did you need me for something?<$motion(1,826)> Sorry I didn’t<br>notice you.<clear><br><$voicel(1,8)>I was just really focused on finding some berries.<clear><br><$voicel(1,9)><$motion(1,803)><$comeff(1,10)><$facial(1,4)>Even though I JUST ate, I’m already sooo hungry.<clear><br><$voicel(1,7)><$comeff(1,6)><$motion(1,806)>Um... Do you think I’m gonna get bigger and bigger as I<br>grow up?<clear><br><$voicel(1,9)><$motion(1,801)><$comeff(1,21)><$facial(1,5)>That would make me really happy...
msgctxt "3255:27"
msgid "<$voicel(1,5)><$motion(1,814)><$comeff(1,14)>Nada, ni una...<clear><br><$lookat(1,1,0)><waitactor(1)><$voicel(1,6)><$comeff(1,5)>¿Hm? ¿Querías algo? <$motion(1,826)>Jo, perdona... <$voicel(1,8)>Es que estoy ocupad<gen;-3(o,a)><br>buscando bayitas.<clear><br><$voicel(1,9)><$motion(1,803)><$comeff(1,10)><$facial(1,4)>Acabo de comer, pero ya me ha entrado hambre otra vez.<br><$voicel(1,7)><$comeff(1,6)><$motion(1,806)>Me pregunto si será que estoy pegando el estirón...<slide><br><$voicel(1,9)><$motion(1,801)><$comeff(1,21)><$facial(1,5)>No estaría mal..."
msgstr "<$voicel(1,5)><$motion(1,814)><$comeff(1,14)>Nada, ni una...<clear><br><$lookat(1,1,0)><waitactor(1)><$voicel(1,6)><$comeff(1,5)>¿Hm? ¿Querías algo? <$motion(1,826)>Ay, perdón... <$voicel(1,8)>Es que estoy ocupad<gen;-3(o,a)><br>buscando bayitas.<clear><br><$voicel(1,9)><$motion(1,803)><$comeff(1,10)><$facial(1,4)>Acabo de comer, pero ya me dio hambre otra vez.<br><$voicel(1,7)><$comeff(1,6)><$motion(1,806)>Me pregunto si será que estoy dando el estirón...<slide><br><$voicel(1,9)><$motion(1,801)><$comeff(1,21)><$facial(1,5)>No estaría mal..."

#. en: <$comeff(1,1)><$motion(1,801)><$voicel(1,7)>Hello. Hello. You also are looking for a place to live?<clear><br><$comeff(1,14)><$motion(1,824)><$voicel(1,5)>I just found this location.<clear><br><$comeff(1,21)><$motion(1,816)><$voicel(1,9)>The humidity is high. It is very nice.<clear><br><$voicel(1,8)><$motion(1,802)><$comeff(1,13)>I will take it easy here for some time I think.
msgctxt "3255:28"
msgid "<$comeff(1,1)><$motion(1,801)><$voicel(1,7)>Hola. ¿Tú también buscas nueva residencia?<clear><br><$comeff(1,14)><$motion(1,824)><$voicel(1,5)>Yo acabo de encontrar este lugar.<clear><br><$comeff(1,21)><$motion(1,816)><$voicel(1,9)>El aire es húmedo. Transmite buena sensación.<clear><br><$voicel(1,8)><$motion(1,802)><$comeff(1,13)>De momento permaneceré aquí."
msgstr ""

#. en: <$comeff(1,21)><$motion(1,801)><$voicel(1,7)>Wow, such a pretty light!<clear><br><$comeff(1,1)><$voicel(1,10)>Oh, hello there! Nice to meet you!<clear><br><$comeff(1,6)><$motion(1,803)><$voicel(1,9)>Were you drawn to this light too? <$comeff(1,10)><$voicel(1,10)>I bet we have so much<br>in common!<clear><br><$motion(1,801)><$comeff(1,21)><$voicel(1,5)>Have you ever wondered why we’re drawn to shiny things<br>like this? <$voicel(1,7)>It’s weird, isn’t it?
msgctxt "3255:29"
msgid "<$comeff(1,21)><$motion(1,801)><$voicel(1,7)>Oooh, qué luz tan bonita...<br><$comeff(1,1)><$voicel(1,10)>¡Ah! ¡Hola! <$comeff(1,6)><$motion(1,803)><$voicel(1,9)>¿Tú también has venido atraíd<gen;-2(o,a)> por la luz?<clear><br><$comeff(1,10)><$voicel(1,10)>Si es así, estoy segur<gen;-3(o,a)> de que nos vamos a llevar bien.<clear><br><$motion(1,801)><$comeff(1,21)><$voicel(1,5)>¿Por qué será que la luz nos roba el corazón de esta<br>manera? <$voicel(1,7)>Es de lo más extraño..."
msgstr "<$comeff(1,21)><$motion(1,801)><$voicel(1,7)>Oooh, qué luz tan bonita...<br><$comeff(1,1)><$voicel(1,10)>¡Ah! ¡Hola! <$comeff(1,6)><$motion(1,803)><$voicel(1,9)>¿Tú también viniste atraíd<gen;-2(o,a)> por la luz?<clear><br><$comeff(1,10)><$voicel(1,10)>Si es así, estoy segur<gen;-3(o,a)> de que nos vamos a llevar bien.<clear><br><$motion(1,801)><$comeff(1,21)><$voicel(1,5)>¿Por qué será que la luz nos roba el corazón de esta<br>manera? <$voicel(1,7)>Es de lo más extraño..."

#. en: <$comeff(1,5)><$voicel(1,10)>Uwahhh! <wait(0.6)><$comeff(0,5)><$motion(0,82)><$motion(1,817)>*flap flap flap*<clear><br><$comeff(1,23)><$motion(1,801)><$voicel(1,5)>Ahem! My apologies. I was just a bit startled to be spoken<br>to so suddenly.<clear><br><$comeff(1,6)><$motion(1,803)><$voicel(1,8)>If I may ask, by the way, how are you at handling poison?<clear><br><$comeff(0,5)><$comeff(1,14)><$motion(1,807)><$voicel(1,3)>You see, I seem to have flapped my wings rather<br>vigorously in my surprise, and whenever I do that,<slide><br>I unfortunately tend to scatter poison scales.<wait(0.3)><$motion(0,81)><$comeff(0,19)><clear><br><$comeff(1,19)><$motion(1,802)><$voicel(1,4)>Oh dear, you may be experiencing a short bout of<br>dizziness. I do apologize...
msgctxt "3255:30"
msgid "<$comeff(1,5)><$voicel(1,10)>¿Hmm?... <wait(0.6)><$comeff(0,5)><$motion(0,82)><$motion(1,817)>¡¡V-venom!!<clear><br><$comeff(1,23)><$motion(1,801)><$voicel(1,5)>Ah, disculpa. No me esperaba que alguien me abordase<br>tan repentinamente.<clear><br><$motion(1,803)><$voicel(1,8)>A propósito, <$comeff(1,6)>¿eres de quienes resisten bien el veneno?<clear><br><$comeff(0,5)><$comeff(1,14)><$motion(1,807)><$voicel(1,3)>Lo digo porque, cuando agito las alas violentamente,<br>esparzo polvo venenoso a mi alrededor...<wait(0.3)><$motion(0,81)><$comeff(0,19)><clear><br><$comeff(1,19)><$motion(1,802)><$voicel(1,4)>Es probable que experimentes cierta sensación de mareo<br>durante un breve lapso de tiempo. Acepta mis disculpas."
msgstr ""

#. en: <$voicel(1,10)><$comeff(1,5)><$motion(1,817)>*POP*<wait(0.35)><$comeff(0,5)><$motion(0,182)><wait(0.5)><clear><br><$voicel(1,9)><$comeff(1,1)>Oh, hi there! I hope I didn’t startle you.<clear><br><$voicel(1,8)><$comeff(1,9)><$motion(1,801)>And, uh, maybe a weird time to say this, but...nice to<br>meet you!<clear><br><$voicel(1,7)><$comeff(1,13)><$motion(1,802)>You know, the dirt around here is so soft and moist...<br>It’s just perfect!<clear><br><$voicel(1,5)><$motion(1,803)>I was thinking I might actually start living here. I hope we<br>can be friends!<wait(0.5)><$motion(0,181)>
msgctxt "3255:31"
msgid "<$voicel(1,10)><$comeff(1,5)><$motion(1,817)>¡Dig!<wait(0.35)><$comeff(0,5)><$motion(0,182)><wait(0.5)><clear><br><$voicel(1,9)><$comeff(1,1)>¡Uy! ¡Perdona! Espero no haberte sorprendido.<br><$voicel(1,8)><$comeff(1,9)><$motion(1,801)>Ya no sé si pega, pero ¡es un placer conocerte!<clear><br><$voicel(1,7)><$comeff(1,13)><$motion(1,802)>La tierra de por aquí es de las mejores que he probado,<br>¡es tan blandita!<clear><br><$voicel(1,5)><$motion(1,803)>Me gusta tanto que creo que me voy a mudar aquí.<br>¡Nos vemos!<wait(0.5)><$motion(0,181)>"
msgstr "<$voicel(1,10)><$comeff(1,5)><$motion(1,817)>¡Dig!<wait(0.35)><$comeff(0,5)><$motion(0,182)><wait(0.5)><clear><br><$voicel(1,9)><$comeff(1,1)>¡Uy! ¡Perdona! Espero no haberte sorprendido.<br><$voicel(1,8)><$comeff(1,9)><$motion(1,801)>Ya no sé si viene al caso, pero ¡es un placer conocerte!<clear><br><$voicel(1,7)><$comeff(1,13)><$motion(1,802)>La tierra de por aquí es de las mejores que he probado,<br>¡es tan blandita!<clear><br><$voicel(1,5)><$motion(1,803)>Me gusta tanto que creo que me voy a mudar aquí.<br>¡Nos vemos!<wait(0.5)><$motion(0,181)>"

#. en: <$voicel(1,10)><$motion(1,817)><$comeff(1,5)>Oof! <wait(0.6)><$comeff(0,5)><$motion(0,82)><$comeff(1,5)><wait(0.9)><wait(0.35)>Ow, ow, ow...<clear><br><$voicel(1,8)>Sorry ’bout that! Probably didn’t feel too great for you<br>either, huh?<clear><br><$voicel(1,7)><$motion(1,802)><$comeff(1,19)>Y’know, I recently bumped my head against a rock poppin’<br>myself outta the ground! <$voicel(1,10)><$comeff(1,1)><$motion(1,803)>Glad I hit a Pokémon this time,<slide><br>at least!<clear><br><$voicel(1,5)>But hey, us meetin’ like this... Sorta feels like fate, don’t<br>ya think?<clear><br><$voicel(1,9)><$motion(1,801)><$comeff(1,10)>Guess we’ll just have to be buds from now on!
msgctxt "3255:32"
msgid "<$voicel(1,10)><$motion(1,817)><$comeff(1,5)>¡¡Trio!! <wait(0.6)><$comeff(0,5)><$motion(0,82)><$comeff(1,5)><wait(0.9)><wait(0.35)>Ay, ay, ayyy...<clear><br><$voicel(1,8)>¿Te has hecho daño tú también? Pa habernos matao, oye.<br>¡Perdóoon!<clear><br><$voicel(1,7)><$motion(1,802)><$comeff(1,19)>El otro día me di un buen golpazo con una roca al salir<br>a la superficie. <$voicel(1,10)><$comeff(1,1)><$motion(1,803)>Menos mal que hoy ha sido un Pokémon.<clear><br><$voicel(1,5)>Oye, igual encontrarnos así ha sido cosa del destino.<clear><br><$voicel(1,9)><$motion(1,801)><$comeff(1,10)>¡Espero que este sea el principio de una bonita amistad!"
msgstr "<$voicel(1,10)><$motion(1,817)><$comeff(1,5)>¡¡Trio!! <wait(0.6)><$comeff(0,5)><$motion(0,82)><$comeff(1,5)><wait(0.9)><wait(0.35)>Ay, ay, ayyy...<clear><br><$voicel(1,8)>¿Te lastimaste tú también? ¡Casi nos matamos, oye!<br>¡Perdóoon!<clear><br><$voicel(1,7)><$motion(1,802)><$comeff(1,19)>El otro día me di un buen golpazo con una roca al salir<br>a la superficie. <$voicel(1,10)><$comeff(1,1)><$motion(1,803)>Menos mal que hoy fue un Pokémon.<clear><br><$voicel(1,5)>Oye, tal vez encontrarnos así fue cosa del destino.<clear><br><$voicel(1,9)><$motion(1,801)><$comeff(1,10)>¡Espero que este sea el principio de una bonita amistad!"

#. en: <$voicel(1,10)><$comeff(1,5)><$motion(1,805)><$facial(1,13)>Meow?<clear><br><$voicel(1,7)><$comeff(1,4)><$motion(1,807)><$facial(1,13)>Meow me—ack, where’d it go?! <$comeff(1,4)>You gotta be kitten me!<clear><br><$facial(1,1)><$voicel(1,5)><$emotion(1,29)>Hey, you with the face! Have you seen my treasure?!<br><$voicel(1,4)><$emotion(1,46)>I coulda sworn it rolled this way...<clear><br><$voicel(1,5)><$comeff(1,3)><$motion(1,805)><$facial(1,9)>Aw, fine. Guess I’ve gotta look for a NEW treasure now.<clear><br><$voicel(1,8)><$emotion(1,49)>If you’re lucky, maybe I’ll let you help me out!
msgctxt "3255:33"
msgid "<$voicel(1,10)><$comeff(1,5)><$motion(1,805)><$facial(1,13)>¿Meow, meow? <wait(0.9)><$voicel(1,7)><$comeff(1,4)><$motion(1,807)><$facial(1,13)>¿Dónde está mi tesorito?<clear><br><$facial(1,1)><$voicel(1,5)><$emotion(1,29)>¡Oye, tú! ¿Has visto mi tesoro? <wait(0.5)><$voicel(1,4)><$emotion(1,46)>Juraría que llegó rodando<br>hasta aquí...<clear><br><$voicel(1,5)><$comeff(1,3)><$motion(1,805)><$facial(1,9)>Pues nada, qué se le va a hacer... Tendré que buscarme<br>uno nuevo.<clear><br><$voicel(1,8)><$emotion(1,49)>¡Nos vemos, compi!"
msgstr "<$voicel(1,10)><$comeff(1,5)><$motion(1,805)><$facial(1,13)>¿Meow, meow? <wait(0.9)><$voicel(1,7)><$comeff(1,4)><$motion(1,807)><$facial(1,13)>¿Dónde está mi tesorito?<clear><br><$facial(1,1)><$voicel(1,5)><$emotion(1,29)>¡Oye, tú! ¿Viste mi tesoro? <wait(0.5)><$voicel(1,4)><$emotion(1,46)>Juraría que llegó rodando<br>hasta aquí...<clear><br><$voicel(1,5)><$comeff(1,3)><$motion(1,805)><$facial(1,9)>Pues nada, qué se le va a hacer... Tendré que buscarme<br>uno nuevo.<clear><br><$voicel(1,8)><$emotion(1,49)>¡Nos vemos por ahí!"

#. en: <$voicel(1,6)><$motion(1,801)><$comeff(1,1)>Who do we have here? I’ve not seen your face before.<clear><br><$voicel(1,7)><$comeff(1,9)><$motion(1,803)>In any case, it’s a pleasure to meet you. Allow me to<br>extend my warmest greetings.<$motion(1,807)><wait(2.4)><clear><br><$voicel(1,9)>Well? How did you like my elegant bow?<$motion(0,215)><wait(2.1)><clear><br><$voicel(1,10)><$comeff(1,5)><$motion(1,803)>Goodness, what a graceful little greeting! Color<br>me impressed.<clear><br><$voicel(1,7)><$motion(1,802)><$comeff(1,21)>I must say, I’m slightly saddened that your bow was more<br>elegant than mine...<$voicel(1,10)><$motion(1,803)><$comeff(1,13)> But I won’t hold it against you.
msgctxt "3255:34"
msgid "<$voicel(1,6)><$motion(1,801)><$comeff(1,1)>Vaya, vaya, ¿qué tenemos por aquí? ¿Una cara nueva?<br><$voicel(1,7)><$comeff(1,9)><$motion(1,803)>En ese caso, permíteme que te salude como es debido.<clear><br><$motion(1,807)><wait(2.4)><$voicel(1,9)>¿Qué te parece mi elegante reverencia?<clear><br><$motion(0,215)><wait(2.1)><$voicel(1,10)><$comeff(1,5)><$motion(1,803)>¡Oh! Veo que tus modales no se quedan atrás...<clear><br><$voicel(1,7)><$motion(1,802)><$comeff(1,21)>De hecho, me duele admitir que tu reverencia supera<br>a la mía... <$voicel(1,10)><$motion(1,803)><$comeff(1,13)>Ju, ju, ju, en fin, ya nos iremos viendo."
msgstr ""

#. en: <$comeff(1,6)><$motion(1,816)><$voicel(1,1)><wait(0.3)>Hmmm...<wait(0.8)> What<wait(0.8)> did I do yesterday?<wait(0.6)> I can’t remember.<clear><br><$voicel(1,5)><$comeff(1,14)>Oh,<wait(0.5)> it’s you.<wait(0.5)><wait(0.9)><$motion(1,802)> Ummm...<wait(0.5)> We’re friends...right?<clear><br><$comeff(1,9)><$motion(1,801)><$voicel(1,7)>Oops! Never mind.<wait(0.2)><wait(0.9)> Uh...<wait(0.5)> It’s nice to meet you, then!<$voicel(1,10)><$comeff(1,13)><wait(0.5)> Let’s<br>be friends from now on!
msgctxt "3255:35"
msgid "<$comeff(1,6)><$motion(1,816)><$voicel(1,1)><wait(0.3)>Hmm...<wait(0.8)> Ayer...<wait(0.8)> ¿Qué hice?<wait(0.6)> No me acuerdo...<clear><br><$voicel(1,5)><$comeff(1,14)>Ah... <wait(0.5)>Tú...<wait(0.5)><wait(0.9)> <$motion(1,802)>Estooo...<wait(0.5)> ¿Tú y yo somos colegas o algo?<clear><br><$comeff(1,9)><$motion(1,801)><$voicel(1,7)>¿Ah, no?<wait(0.2)><wait(0.9)> Bueno... <wait(0.5)>Pos encant<gen;-3(ao,á)> de conocerte, oye.<br><$voicel(1,10)><$comeff(1,13)>A partir de hoy<wait(0.5)> sí que seremos coleguis. Jeee..."
msgstr "<$comeff(1,6)><$motion(1,816)><$voicel(1,1)><wait(0.3)>Hmm...<wait(0.8)> Ayer...<wait(0.8)> ¿Qué hice?<wait(0.6)> No me acuerdo...<clear><br><$voicel(1,5)><$comeff(1,14)>Ah... <wait(0.5)>Tú...<wait(0.5)><wait(0.9)> <$motion(1,802)>Esteee...<wait(0.5)> ¿Tú y yo somos amigos o algo?<clear><br><$comeff(1,9)><$motion(1,801)><$voicel(1,7)>¿Ah, no?<wait(0.2)><wait(0.9)> Bueno... <wait(0.5)>Pos encant<gen;-3(ao,á)> de conocerte, oye.<br><$voicel(1,10)><$comeff(1,13)>A partir de hoy<wait(0.5)> sí que seremos amiguis. Jeee..."

#. en: <$comeff(1,21)><$motion(1,801)><$voicel(1,9)><$facial(1,4)>Whoo! This place is great! Nice and quiet—and the water<br>is wicked gorgeous!<clear><br><$voicel(1,8)>Say, bud! Wanna join me for a little swimming?<br><wait(0.8)><$motion(1,824)><$comeff(1,6)>...What?! You CAN’T swim?<clear><br><$comeff(1,14)><$motion(1,805)><$voicel(1,7)>With those slick hands and feet of yours, I figured you’d<br>be a great swimmer! Huh...
msgctxt "3255:36"
msgid "<$comeff(1,21)><$motion(1,801)><$voicel(1,9)><$facial(1,4)>¡Buah, este lugar es el no va más! Con su tranquilidad,<br>sus aguas cristalinas... ¡Qué gustazo!<clear><br><$voicel(1,8)>Oye, ¿qué te parece si nos damos un chapuzón, niñ<gen;-2(o,a)>?<br><wait(0.8)><$motion(1,824)><$comeff(1,6)>¿Cómo que te hundes como una piedra? ¿No sabes nadar?<clear><br><$comeff(1,14)><$motion(1,805)><$voicel(1,7)>Pues vaya chasco... Con esas extremidades tan flexibles<br>que tienes, estaba convencid<gen;-3(o,a)> de que se te daría genial.<slide><br>No me estarás tomando el pelo, ¿no?"
msgstr "<$comeff(1,21)><$motion(1,801)><$voicel(1,9)><$facial(1,4)>¡Guau, este lugar es lo máximo! Con su tranquilidad,<br>sus aguas cristalinas... ¡Qué gustazo!<clear><br><$voicel(1,8)>Oye, ¿qué te parece si nos damos un chapuzón, amig<gen;-2(o,a)>?<br><wait(0.8)><$motion(1,824)><$comeff(1,6)>¿Cómo que te hundes como una piedra? ¿No sabes nadar?<clear><br><$comeff(1,14)><$motion(1,805)><$voicel(1,7)>Pues vaya chasco... Con esas extremidades tan flexibles<br>que tienes, estaba convencid<gen;-3(o,a)> de que se te daría genial.<slide><br>No me estarás tomando el pelo, ¿no?"

#. en: <$comeff(1,10)><$motion(1,816)><$voicel(1,9)>Ruff! Ruff ruff!<$motion(0,82)><$comeff(0,5)><clear><br><$voicel(1,8)><$comeff(1,1)>Oh, whoops, sorry. Did I scare you?<clear><br><$comeff(1,14)><$motion(1,817)><$voicel(1,5)>I thought you’d come to steal my home...<clear><br><$voicel(1,10)><$motion(1,802)><$comeff(1,5)>But now that I look at you, I can tell you’re not that kind<br>of Pokémon. <$voicel(1,8)>My mistake!<clear><br><$voicel(1,7)><$motion(1,801)><$comeff(1,13)>I hope you’ll be my friend!
msgctxt "3255:37"
msgid "<$comeff(1,10)><$motion(1,816)><$voicel(1,9)>Grr... ¡grow, grow!<$motion(0,82)><$comeff(0,5)><clear><br><$voicel(1,8)><$comeff(1,1)>¡Ay, perdona! <$comeff(1,14)><$motion(1,817)><$voicel(1,5)>Pensaba que habías venido a robarme<br>mi preciada casita...<clear><br><$voicel(1,10)><$motion(1,802)><$comeff(1,5)>Pero, ahora que te veo de cerca, no tienes ninguna pinta<br>de ser mala gente, <$voicel(1,8)>así que perdona por el susto.<clear><br><$voicel(1,7)><$motion(1,801)><$comeff(1,13)>¡Espero que no me lo tengas en cuenta y podamos<br>llevarnos bien!"
msgstr ""

#. en: <$motion(1,802)><$comeff(1,23)><$voicel(1,3)>*yawn* My body’s gotten all stiff...<clear><br><$motion(1,817)><$facial(1,3)><$comeff(1,22)><$voicel(1,9)><$textsize(2)>GRAAAWR!</textsize><clear><br><$facial(1,2)><$motion(1,803)><$comeff(1,1)><$voicel(1,8)>Oh! Did I scare you? Sorry ’bout that, bud.<clear><br><$facial(1,4)><$comeff(1,10)><$voicel(1,5)>I overslept a bit, so I figured I’d go for a little run to wake<br>myself up.<clear><br><$motion(1,801)><$comeff(1,9)><$voicel(1,10)>Just tryin’ to get in the right headspace first with a quick<br>roar, y’know?
msgctxt "3255:38"
msgid "<$motion(1,802)><$comeff(1,23)><$voicel(1,3)>Uf, me noto muy agarrotad<gen;-3(o,a)>...<clear><br><$motion(1,817)><$facial(1,3)><$comeff(1,22)><$voicel(1,9)><$textsize(2)>¡Aaarccc!</textsize><clear><br><$facial(1,2)><$motion(1,803)><$comeff(1,1)><$voicel(1,8)>¿Te he asustado? Perdona, niñ<gen;-2(o,a)>, no era mi intención.<clear><br><$facial(1,4)><$comeff(1,10)><$voicel(1,5)>Llevaba tanto tiempo durmiendo que se me ocurrió que<br>un buen esprint me ayudaría a despertarme...<clear><br><$motion(1,801)><$comeff(1,9)><$voicel(1,10)>¡Y justo me has pillado en pleno grito para ver si me<br>motivo!"
msgstr "<$motion(1,802)><$comeff(1,23)><$voicel(1,3)>Uf, me siento muy entumid<gen;-3(o,a)>...<clear><br><$motion(1,817)><$facial(1,3)><$comeff(1,22)><$voicel(1,9)><$textsize(2)>¡Aaarccc!</textsize><clear><br><$facial(1,2)><$motion(1,803)><$comeff(1,1)><$voicel(1,8)>¿Te asusté? Perdona, amig<gen;-2(o,a)>, no era mi intención.<clear><br><$facial(1,4)><$comeff(1,10)><$voicel(1,5)>Llevaba tanto tiempo durmiendo que se me ocurrió que<br>una buena carrera me ayudaría a despertarme...<clear><br><$motion(1,801)><$comeff(1,9)><$voicel(1,10)>¡Y justo me encontraste en pleno grito para ver si me<br>motivo!"

#. en: <$voicel(1,10)><$motion(1,815)><$comeff(1,12)>Whoops! ’Scuse me!<$comeff(0,12)><wait(0.35)><$motion(0,182)><wait(0.7)><clear><br><$voicel(1,3)><$motion(1,802)><$comeff(1,17)>I’m really sorry... I only just got my legs, so I’m not used to<br>walking yet...<clear><br><$voicel(1,8)><$motion(1,803)><$comeff(1,1)>Wait... You don’t even have legs!<clear><br><$voicel(1,10)><$motion(0,181)><wait(2.3)><$motion(1,816)><$comeff(1,5)>Wha—and now you do! Did they just grow?!<wait(1.1)><$motion(0,250)> <wait(1.4)><$motion(1,806)><$comeff(1,10)>And you’re<br>walking around, just like that!<clear><br><$voicel(1,9)><$motion(1,802)><$comeff(1,14)>Your legs just came in, and you’re already walking around<br>like a pro...<$voicel(1,7)><$motion(1,801)><$comeff(1,10)> That’s so cool!
msgctxt "3255:39"
msgid "<$voicel(1,10)><$motion(1,815)><$comeff(1,12)>¡Ah! ¡Perdona, perdona!<$comeff(0,12)><wait(0.35)><$motion(0,182)><wait(0.7)><clear><br><$voicel(1,3)><$motion(1,802)><$comeff(1,17)>Es que las patas me salieron hace poco y aún no domino<br>eso de caminar...<clear><br><$voicel(1,8)><$motion(1,803)><$comeff(1,1)>¡Anda! ¡Pero si tú tampoco tienes patas!<clear><br><$voicel(1,10)><$motion(0,181)><wait(2.3)><$motion(1,816)><$comeff(1,5)>¡Uoooh! ¡Te han salido de repente!<wait(1.1)><$motion(0,250)> <wait(1.4)><$voicel(1,8)><$motion(1,806)><$comeff(1,10)>¡Y qué bien las usas!<br>¡Toma ya!<clear><br><$voicel(1,9)><$motion(1,802)><$comeff(1,14)>¿Cómo haces para moverte con tanta soltura si a ti<br>también te acaban de salir? <$voicel(1,7)><$motion(1,801)><$comeff(1,10)>¡Eres increíble!"
msgstr "<$voicel(1,10)><$motion(1,815)><$comeff(1,12)>¡Ah! ¡Perdona, perdona!<$comeff(0,12)><wait(0.35)><$motion(0,182)><wait(0.7)><clear><br><$voicel(1,3)><$motion(1,802)><$comeff(1,17)>Es que las patas me salieron hace poco y aún no domino<br>eso de caminar...<clear><br><$voicel(1,8)><$motion(1,803)><$comeff(1,1)>¡Vaya! ¡Pero si tú tampoco tienes patas!<clear><br><$voicel(1,10)><$motion(0,181)><wait(2.3)><$motion(1,816)><$comeff(1,5)>¡Uoooh! ¡Te salieron de repente!<wait(1.1)><$motion(0,250)> <wait(1.4)><$voicel(1,8)><$motion(1,806)><$comeff(1,10)>¡Y qué bien las usas!<br>¡Así se hace!<clear><br><$voicel(1,9)><$motion(1,802)><$comeff(1,14)>¿Cómo haces para moverte con tanta soltura si a ti<br>también te acaban de salir? <$voicel(1,7)><$motion(1,801)><$comeff(1,10)>¡Eres increíble!"

#. en: <$motion(1,802)><$voicel(1,10)><$comeff(1,21)>Whoooaaa! The water here’s so prettyyy.<clear><br><$lookat(1,1,0)><waitactor(1)><$motion(1,803)><$voicel(1,7)><$comeff(1,5)>Oh! Um, nice to meet you. Did you come here to swim,<br>too?<clear><br><$motion(1,801)><$voicel(1,9)><$comeff(1,10)>The water might get a little slimy after I swim around in<br>it, so...<$motion(1,817)><$voicel(1,10)><$comeff(1,13)>you can go first! ♪
msgctxt "3255:40"
msgid "<$motion(1,802)><$voicel(1,10)><$comeff(1,21)>Me flipa el agua cristalina...<clear><br><$lookat(1,1,0)><waitactor(1)><$motion(1,803)><$voicel(1,7)><$comeff(1,5)>Ah... Encant<gen;-3(ao,á)>, amigui... ¿Tú también has venido a darte<br>un chapuzón?<clear><br><$motion(1,801)><$voicel(1,9)><$comeff(1,10)>Pos, en cuanto me meta yo en el agua, se va a quedar<br>ahí to viscosa, así que...<clear><br><$motion(1,817)><$voicel(1,10)><$comeff(1,13)>Tranqui, que te cedo el primer turno."
msgstr "<$motion(1,802)><$voicel(1,10)><$comeff(1,21)>Me encanta el agua cristalina...<clear><br><$lookat(1,1,0)><waitactor(1)><$motion(1,803)><$voicel(1,7)><$comeff(1,5)>Ah... Encant<gen;-3(ao,á)>, amigui... ¿Tú también viniste a darte<br>un chapuzón?<clear><br><$motion(1,801)><$voicel(1,9)><$comeff(1,10)>Pos, en cuanto me meta yo en el agua, se va a quedar<br>ahí toda viscosa, así que...<clear><br><$motion(1,817)><$voicel(1,10)><$comeff(1,13)>Tranqui, que te cedo el primer turno."

#. en: <$motion(1,801)><$comeff(1,1)><$voicel(1,9)>Wraaaa!<clear><br><$motion(1,816)><$comeff(1,10)><$voicel(1,10)>Well? Whaddya think of these fierce fists of mine? I can<br>split boulders in two with just one punch!<$motion(0,518)><wait(2.7)><$motion(0,519)><clear><br><$motion(1,801)><$motion(1,803)><$comeff(1,11)>Whoa! <$voicel(1,8)>Dang, looks like you’re pretty fierce too.<clear><br><$motion(1,802)><$comeff(1,23)><$voicel(1,3)>I don’t want us to fight, pal, but if that ever happened...<br>Hypothetically speaking, y’know?<clear><br><$voicel(1,5)>On the off chance that we ever have to fight each other,<wait(0.7)><br><$motion(1,814)><$comeff(1,10)><$voicel(1,10)>promise me we’ll settle it with a swimming contest!
msgctxt "3255:41"
msgid "<$motion(1,801)><$comeff(1,1)><$voicel(1,9)>¡Toma esa!<clear><br><$motion(1,816)><$comeff(1,10)><$voicel(1,10)>Buah, ¿qué me dices de mis puños? ¿A que son flipantes?<br>¡Pueden partir hasta las rocas, <gen;-2(chaval,chavala)>!<clear><br><$motion(0,518)><wait(2.7)><$motion(0,519)><$motion(1,801)><$motion(1,803)><$comeff(1,11)>¡¿Wrath?! <$voicel(1,8)>Jua, jua. Veo que no eres ning<gen;-2(ún,una)> mindundi.<clear><br><$motion(1,802)><$comeff(1,23)><$voicel(1,3)>No me quiero pelear contigo... pero bueno, que la vida<br>da más vueltas que la espiral de mi panza y quién sabe...<clear><br><$voicel(1,5)>Si llegase a suceder por x o por y... <$motion(1,814)><$comeff(1,10)><$voicel(1,10)>lo zanjamos con<br>una carrera a nado, ¿vale? ¡No hay vuelta atrás!"
msgstr "<$motion(1,801)><$comeff(1,1)><$voicel(1,9)>¡Toma eso!<clear><br><$motion(1,816)><$comeff(1,10)><$voicel(1,10)>Guau, ¿qué me dices de mis puños? ¿No son increíbles?<br>¡Pueden partir hasta las rocas, <gen;-2(chaval,chavala)>!<clear><br><$motion(0,518)><wait(2.7)><$motion(0,519)><$motion(1,801)><$motion(1,803)><$comeff(1,11)>¡¿Wrath?! <$voicel(1,8)>Jua, jua. Veo que no eres ning<gen;-2(ún,una)> principiante.<clear><br><$motion(1,802)><$comeff(1,23)><$voicel(1,3)>No me quiero pelear contigo... pero bueno, que la vida<br>da más vueltas que la espiral de mi panza y quién sabe...<clear><br><$voicel(1,5)>Si llegase a suceder por x o por y... <$motion(1,814)><$comeff(1,10)><$voicel(1,10)>lo zanjamos con<br>una carrera a nado, ¿sí? ¡No hay vuelta atrás!"

#. en: <$comeff(1,15)>...<wait(0.9)> ...<wait(0.9)> ...<wait(0.9)><clear><br><$motion(1,802)><$comeff(1,9)><$voicel(1,3)>Ahh, what a great nap. ♪<clear><br><$comeff(1,6)><$voicel(1,6)>Um... Who are you?<clear><br><$voicel(1,7)>Well, you don’t SEEM like a meanie or anything.<clear><br><$motion(1,803)><$comeff(1,16)><$voicel(1,5)>OK, I’m thinking it’s nap time for just a biiit longer...
msgctxt "3255:42"
msgid "<$comeff(1,15)>... <wait(0.9)>... <wait(0.9)><wait(0.9)><$motion(1,802)><$comeff(1,9)><$voicel(1,3)>Qué bien he dormido...<clear><br>Eh... <$comeff(1,6)><$voicel(1,6)>¿Q-quién eres?<clear><br><$voicel(1,7)>Bueno, no tienes pinta de mala persona...<clear><br><$motion(1,803)><$comeff(1,16)><$voicel(1,5)>Creo que me voy a echar otra siestecita..."
msgstr "<$comeff(1,15)>... <wait(0.9)>... <wait(0.9)><wait(0.9)><$motion(1,802)><$comeff(1,9)><$voicel(1,3)>Qué bien dormí...<clear><br>Eh... <$comeff(1,6)><$voicel(1,6)>¿Q-quién eres?<clear><br><$voicel(1,7)>Bueno, no tienes pinta de mala persona...<clear><br><$motion(1,803)><$comeff(1,16)><$voicel(1,5)>Creo que me voy a echar otra siestita..."

#. en: <$facial(1,2)><$comeff(1,14)>...<wait(0.9)> ...<wait(0.9)> ...<wait(0.9)><clear><br><$voicel(1,5)>Sorry, I’m meditating right now. Think you could give me<br>some space?<clear><br><$comeff(1,14)>...<wait(0.9)> ...<wait(0.9)> ...<wait(0.5)><br><wait(0.5)><$facial(1,3)><$voicel(1,8)><$motion(1,803)><$comeff(1,12)>Oh, actually...<clear><br><$voicel(1,7)><$motion(1,801)><$comeff(1,1)>I’m pretty new to this area and still getting my bearings, so<br>it’d mean a lot if we could be friends. Thanks.<clear><br><$facial(1,2)><$comeff(1,14)>...<wait(0.9)> ...<wait(0.9)> ...<wait(0.9)>
msgctxt "3255:43"
msgid "<$facial(1,2)><$comeff(1,14)>... <wait(0.9)>...<wait(0.9)><clear><br><$voicel(1,5)>Perdona, pero estoy meditando. Preferiría que no me<br>hablaras ahora.<clear><br><$comeff(1,14)>... <wait(0.9)>... <wait(0.5)><$facial(1,3)><$voicel(1,8)><$motion(1,803)><$comeff(1,12)>Aunque, de hecho, ahora que lo pienso...<clear><br><$voicel(1,7)><$motion(1,801)><$comeff(1,1)>No conozco muy bien la zona, así que me vendría genial<br>tener <gen;-2(un,una)> amig<gen;-2(o,a)> como tú aquí. Gracias.<clear><br><$facial(1,2)><$comeff(1,14)>... <wait(0.9)>...<wait(0.9)>"
msgstr ""

#. en: <$comeff(1,14)><$motion(1,802)><$voicel(1,8)>Hm? If I’m not mistaken, you’re...<wait(1.55)><$voicel(1,6)><$comeff(1,6)>a <$cdef(27)>Ditto</color>, right?<clear><br><$comeff(1,13)><$motion(1,801)><$voicel(1,7)><$facial(1,4)>Well, isn’t this a sight to behold! In all my years, I’ve<br>never seen a Ditto transformed into a human.<clear><br><$comeff(1,14)><$motion(1,803)><$voicel(1,5)><$facial(1,1)>Speaking of humans, I don’t see any around here—<$comeff(1,6)><$motion(1,801)><$voicel(1,6)>so how<br>were you able to transform into one?<clear><br><$comeff(1,13)><$motion(1,802)><$voicel(1,9)><$facial(1,4)>Oh, no need to answer that. Just musing to myself.
msgctxt "3255:44"
msgid "<$comeff(1,14)><$motion(1,802)><$voicel(1,8)>¿Eh? Si no me equivoco, tú eres... <wait(1.55)><$voicel(1,6)><$comeff(1,6)>un <$cdef(27)>Ditto</color>, ¿verdad?<clear><br><$comeff(1,13)><$motion(1,801)><$voicel(1,7)><$facial(1,4)>Una vida larga y plena te depara alegrías insospechadas<br>como esta: un Ditto que ha asumido una forma humana.<clear><br><$comeff(1,14)><$motion(1,803)><$voicel(1,5)><$facial(1,1)>Pero, ahora que lo pienso, no detecto presencia alguna<br>de seres humanos en esta zona...<clear><br><$comeff(1,6)><$motion(1,801)><$voicel(1,6)>¿Cómo te las has ingeniado para transformarte en su<br>imagen?<clear><br><$comeff(1,13)><$motion(1,802)><$voicel(1,9)><$facial(1,4)>Ah, no hace falta que contestes. Resulta mucho más<br>fascinante hallar la respuesta cavilando por mí mism<gen;-3(o,a)>."
msgstr "<$comeff(1,14)><$motion(1,802)><$voicel(1,8)>¿Eh? Si no me equivoco, tú eres... <wait(1.55)><$voicel(1,6)><$comeff(1,6)>un <$cdef(27)>Ditto</color>, ¿verdad?<clear><br><$comeff(1,13)><$motion(1,801)><$voicel(1,7)><$facial(1,4)>Una vida larga y plena te depara alegrías insospechadas<br>como esta: un Ditto que ha asumido una forma humana.<clear><br><$comeff(1,14)><$motion(1,803)><$voicel(1,5)><$facial(1,1)>Pero, ahora que lo pienso, no detecto presencia alguna<br>de seres humanos en esta zona...<clear><br><$comeff(1,6)><$motion(1,801)><$voicel(1,6)>¿Cómo te las ingeniaste para transformarte en su<br>imagen?<clear><br><$comeff(1,13)><$motion(1,802)><$voicel(1,9)><$facial(1,4)>Ah, no hace falta que contestes. Resulta mucho más<br>fascinante hallar la respuesta cavilando por mí mism<gen;-3(o,a)>."

#. en: <$motion(1,803)><$comeff(1,6)><$voicel(1,5)>Hey, quick question: you seen any boulders around here?<clear><br><$facial(1,9)><$motion(1,814)><$comeff(1,1)><$voicel(1,7)>My muscles lost their oomph while I was asleep, <$facial(1,1)><$voicel(1,8)>so I wanna<br>build ’em back up with some training!<clear><br><$motion(1,801)><$comeff(1,10)><$voicel(1,9)>You gotta lift heavy weights to be a heavyweight!
msgctxt "3255:45"
msgid "<$motion(1,803)><$comeff(1,6)><$voicel(1,5)>¡Ey! ¿No habrá alguna roca de buen tamaño por aquí?<clear><br><$facial(1,9)><$motion(1,814)><$comeff(1,1)><$voicel(1,7)>Me noto como agarrotado después de dormir tantísimo<br>tiempo, no sé... <$facial(1,1)><$voicel(1,8)>¡Tengo que volver a ponerme en forma!<clear><br><$motion(1,801)><$comeff(1,10)><$voicel(1,9)>Lo que me hace falta es una roca superpesada que pueda<br>levantar una y otra vez."
msgstr "<$motion(1,803)><$comeff(1,6)><$voicel(1,5)>¡Ey! ¿No habrá alguna roca de buen tamaño por aquí?<clear><br><$facial(1,9)><$motion(1,814)><$comeff(1,1)><$voicel(1,7)>Me siento como entumecido después de dormir tantísimo<br>tiempo, no sé... <$facial(1,1)><$voicel(1,8)>¡Tengo que volver a ponerme en forma!<clear><br><$motion(1,801)><$comeff(1,10)><$voicel(1,9)>Lo que me hace falta es una roca superpesada que pueda<br>levantar una y otra vez."

#. en: <$motion(1,814)><$comeff(1,13)><$voicel(1,10)>HYAH!<clear><br><$motion(1,801)><$comeff(1,10)><$voicel(1,9)>Oh, hey! You watchin’ me train? Whaddaya think? My<br>punches pack a lotta power, huh?<clear><br><$motion(1,803)><$comeff(1,5)><$voicel(1,5)>...Nothing? Not even a raised eyebrow? Dang.<wait(0.8)><$voicel(1,8)> You’re<br>something else, pal!<clear><br><$motion(1,815)><$voicel(1,9)>HRRRAAAH! How’s THAT?<clear><br><$voicel(1,1)><$motion(1,802)><$comeff(1,11)>Seriously? Is your face stuck? Have you only got one<br>expression? Yeesh.<clear><br><$motion(1,801)><$comeff(1,1)><$voicel(1,3)>Well, whatever. That was barely even half of my full<br>power anyway!
msgctxt "3255:46"
msgid "<$motion(1,814)><$comeff(1,13)><$voicel(1,10)>¡Choooke!<clear><br><$motion(1,801)><$comeff(1,10)><$voicel(1,9)>¡Bueno, bueno, pero si tengo público! ¿Qué te parece mi<br>entrenamiento? ¡Todos se estremecen ante mis puños!<clear><br><$motion(1,803)><$comeff(1,5)><$voicel(1,5)>Pues no has movido ni una ceja al verlos... <$voicel(1,8)>¡Qué tí<gen;-2(o,a)>!<clear><br><$motion(1,815)><$voicel(1,9)>¡Maaaaaachoke! ¿Y ahora qué me dices?<clear><br><$voicel(1,1)><$motion(1,802)><$comeff(1,11)>¡Pff, menuda cara impasible tienes, chava<gen;-2(l,la)>!<clear><br><$motion(1,801)><$comeff(1,1)><$voicel(1,3)>No pasa nada, que sepas que solo estaba usando la mitad<br>de mi fuerza. ¡Jua, jua! Me merezco un descansillo, eso sí."
msgstr "<$motion(1,814)><$comeff(1,13)><$voicel(1,10)>¡Choooke!<clear><br><$motion(1,801)><$comeff(1,10)><$voicel(1,9)>¡Bueno, bueno, pero si tengo público! ¿Qué te parece mi<br>entrenamiento? ¡Todos se estremecen ante mis puños!<clear><br><$motion(1,803)><$comeff(1,5)><$voicel(1,5)>Pues no has movido ni una ceja al verlos... <$voicel(1,8)>¡Qué dur<gen;-2(o,a)>!<clear><br><$motion(1,815)><$voicel(1,9)>¡Maaaaaachoke! ¿Y ahora qué me dices?<clear><br><$voicel(1,1)><$motion(1,802)><$comeff(1,11)>¡Pff, qué cara tan impasible tienes, chava<gen;-2(l,la)>!<clear><br><$motion(1,801)><$comeff(1,1)><$voicel(1,3)>No pasa nada, que sepas que solo estaba usando la mitad<br>de mi fuerza. ¡Jua, jua! Me merezco un descansito, eso sí."

#. en: <$comeff(1,1)><$motion(1,814)><$voicel(1,10)>Triceps! Biceps!<clear><br><$comeff(1,22)><$motion(1,816)><$voicel(1,8)>Pecs! Delts!<clear><br><$comeff(1,5)><$motion(1,817)><$voicel(1,10)>And don’t forget my lats and my traps!<clear><br><$comeff(1,21)><$motion(1,801)><$voicel(1,10)><$facial(1,4)>Oh yeahhh. My muscles are lookin’ shredded today...<wait(1.8)><$comeff(1,5)><$motion(1,803)><wait(1.2)><$lookat(1,1,0)><waitactor(1)><clear><br><$voicel(1,7)><$facial(1,13)>Hey! Whoa! Have you been there this whole time?<br><$comeff(1,10)><$motion(1,827)><$voicel(1,5)><$facial(1,1)>Wait, are you obsessed with muscles too?!<clear><br><$comeff(1,13)><$motion(1,825)><$voicel(1,9)><$facial(1,1)>Heck yeah, bud! Let’s train together! Muscles are life!
msgctxt "3255:47"
msgid "<$comeff(1,1)><$motion(1,814)><$voicel(1,10)>¡Esos brazacos!<clear><br><$comeff(1,22)><$motion(1,816)><$voicel(1,8)>¡Ese pechamen!<clear><br><$comeff(1,5)><$motion(1,817)><$voicel(1,10)>¡Esas lumbares!<clear><br><$comeff(1,21)><$motion(1,801)><$voicel(1,10)><$facial(1,4)>Buah, hoy también tengo los músculos en perfecto estado<br>de revista. ¡Estoy cachas no, lo siguiente!<clear><br><wait(1.8)><$comeff(1,5)><$motion(1,803)><wait(1.2)><$lookat(1,1,0)><waitactor(1)><$voicel(1,7)><$facial(1,13)>¡Ahí va! ¿Llevas ahí plantad<gen;-2(o,a)> todo este tiempo?<br><$comeff(1,10)><$motion(1,827)><$voicel(1,5)><$facial(1,1)>¿No serás también <gen;-2(un,una)> entusiasta del culturismo?<clear><br><$comeff(1,13)><$motion(1,825)><$voicel(1,9)><$facial(1,1)>¿Qué tal si nos juntamos para entrenar un ratejo?<br>Si hay algo de lo que te puedes fiar en esta vida...<slide><br>¡es de la musculatura!"
msgstr "<$comeff(1,1)><$motion(1,814)><$voicel(1,10)>¡Esos brazotes!<clear><br><$comeff(1,22)><$motion(1,816)><$voicel(1,8)>¡Esos pectorales!<clear><br><$comeff(1,5)><$motion(1,817)><$voicel(1,10)>¡Esas lumbares!<clear><br><$comeff(1,21)><$motion(1,801)><$voicel(1,10)><$facial(1,4)>Guau, hoy también tengo los músculos en perfecto estado<br>de revista. ¡Estoy más que en forma!<clear><br><wait(1.8)><$comeff(1,5)><$motion(1,803)><wait(1.2)><$lookat(1,1,0)><waitactor(1)><$voicel(1,7)><$facial(1,13)>¡Vaya! ¿Estuviste ahí plantad<gen;-2(o,a)> todo este tiempo?<br><$comeff(1,10)><$motion(1,827)><$voicel(1,5)><$facial(1,1)>¿No serás también <gen;-2(un,una)> entusiasta del culturismo?<clear><br><$comeff(1,13)><$motion(1,825)><$voicel(1,9)><$facial(1,1)>¿Qué tal si nos juntamos para entrenar un ratito?<br>Si hay algo de lo que te puedes fiar en esta vida...<slide><br>¡es de la musculatura!"

#. en: <$comeff(1,14)><$motion(1,802)><$voicel(1,3)>I can’t wait until I’m all grown up.<clear><br><$comeff(1,9)><$motion(1,801)><$voicel(1,7)><$facial(1,4)>I bet I’ll grow into a pretty flower.<clear><br><$comeff(1,6)><$motion(1,827)><$voicel(1,8)><$facial(1,1)>What do you think?<wait(1.1)><$comeff(1,1)><$motion(1,803)><$voicel(1,10)> Will I bloom into a beautiful flower?<clear><br><$comeff(1,21)><$motion(1,801)><$voicel(1,9)><$facial(1,4)>Hee hee... Yeah, I just know I will!
msgctxt "3255:48"
msgid "<$comeff(1,14)><$motion(1,802)><$voicel(1,3)>Qué ganas tengo de crecer, colegui.<clear><br><$comeff(1,9)><$motion(1,801)><$voicel(1,7)><$facial(1,4)>Cuando sea mayor, fijo que me sale una flor superchula...<br><$comeff(1,6)><$motion(1,827)><$voicel(1,8)><$facial(1,1)>¿Tú qué crees? <wait(0.9)><$comeff(1,1)><$motion(1,803)><$voicel(1,10)>Me saldrá, ¿no?<clear><br><$comeff(1,21)><$motion(1,801)><$voicel(1,9)><$facial(1,4)>Buah, segurísimo que sí..."
msgstr "<$comeff(1,14)><$motion(1,802)><$voicel(1,3)>Qué ganas tengo de crecer, amigui.<clear><br><$comeff(1,9)><$motion(1,801)><$voicel(1,7)><$facial(1,4)>Cuando sea mayor, seguro me sale una flor superlinda...<br><$comeff(1,6)><$motion(1,827)><$voicel(1,8)><$facial(1,1)>¿Tú qué crees? <wait(0.9)><$comeff(1,1)><$motion(1,803)><$voicel(1,10)>Me saldrá, ¿no?<clear><br><$comeff(1,21)><$motion(1,801)><$voicel(1,9)><$facial(1,4)>Sí, segurísimo que sí..."

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Ayooo, what’s up?! Nice to meet ya! I hope we can be<br>good friends!<clear><br><$comeff(1,5)><$facial(1,1)><$motion(1,824)><$voicel(1,7)>Oh, but, uh... You probably don’t wanna be around when<br>I’m hungry, yo.<clear><br><$comeff(1,19)><$facial(1,9)><$motion(1,802)><$voicel(1,3)>I kinda have this bad habit of gulping down everything in<br>sight and, like, dissolving it, so, y’know—<clear><br><$comeff(1,5)><$facial(1,13)><$motion(1,803)><$voicel(1,10)>*rumble gurgle* Uh-oh...<clear><br><$comeff(1,4)><$facial(1,9)><$motion(1,802)><$voicel(1,7)>Yo, can we have this conversation another time? My bad!<br>Really sorry about this!
msgctxt "3255:49"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Holi! Vaya cara de maj<gen;-2(o,a)> que tienes, ¿no?<clear><br><$comeff(1,5)><$facial(1,1)><$motion(1,824)><$voicel(1,7)>Te aviso por si acaso: mejor no te me acerques mucho<br>cuando tenga el estómago vacío.<clear><br><$comeff(1,19)><$facial(1,9)><$motion(1,802)><$voicel(1,3)>Verás, es que cuando tengo hambre me trago lo primero<br>que veo y lo derrito con mi ácido, literal...<clear><br><$comeff(1,5)><$facial(1,13)><$motion(1,803)><$voicel(1,10)>Grrrrrr...<clear><br><$comeff(1,4)><$facial(1,9)><$motion(1,802)><$voicel(1,7)>¡Ay, ay, ay, me ruge la tripa! ¡Me piro que no quiero<br>liarla!"
msgstr "<$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Holi! Vaya cara de simpátic<gen;-2(o,a)> que tienes, ¿no?<clear><br><$comeff(1,5)><$facial(1,1)><$motion(1,824)><$voicel(1,7)>Te aviso por si acaso: mejor no te me acerques mucho<br>cuando tenga el estómago vacío.<clear><br><$comeff(1,19)><$facial(1,9)><$motion(1,802)><$voicel(1,3)>Verás, es que cuando tengo hambre me trago lo primero<br>que veo y lo derrito con mi ácido, literal...<clear><br><$comeff(1,5)><$facial(1,13)><$motion(1,803)><$voicel(1,10)>Grrrrrr...<clear><br><$comeff(1,4)><$facial(1,9)><$motion(1,802)><$voicel(1,7)>¡Ay, ay, ay, me ruge la panza! ¡Me voy, que no quiero<br>armar un lío!"

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,9)>Heyyy. This place sure is relaxing. Oooh, I think I just<br>drooled a little...<clear><br><$comeff(1,5)><$motionoff(1,804)><$voicel(1,8)>Huh? You made this? That’s sooo nice. Thank you...<clear><br><$comeff(1,13)><$motion(1,801)><$voicel(1,7)>Guess I’ll need to be careful so I don’t dissolve this nice<br>home with my drooool...
msgctxt "3255:50"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,9)>Aaay, qué paaaz se respira aquí. ¡Se me cae literalmente<br>la baba con este sitio!<clear><br><$comeff(1,5)><$motionoff(1,804)><$voicel(1,8)>¿Cómo? ¿Que lo has preparado tú? ¡Jo, pues muchas<br>gracias!<clear><br><$comeff(1,13)><$motion(1,801)><$voicel(1,7)>Procuraré que la baba no caiga encima de mi casica,<br>no vaya a ser que la disuelva."
msgstr "<$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,9)>Aaay, qué paaaz se respira aquí. ¡Se me cae literalmente<br>la baba con este lugar!<clear><br><$comeff(1,5)><$motionoff(1,804)><$voicel(1,8)>¿Cómo? ¿Que lo preparaste tú? ¡Ay, pues muchas<br>gracias!<clear><br><$comeff(1,13)><$motion(1,801)><$voicel(1,7)>Procuraré que la baba no caiga encima de mi casita,<br>no vaya a ser que la disuelva."

#. en: <$comeff(1,5)><$facial(1,9)><$motion(1,803)><$voicel(1,4)>Ow! Kicked again...<clear><br><$comeff(1,14)><$motion(1,802)><$voicel(1,3)>I’d hoped I wouldn’t get kicked since I didn’t see any<br>humans around here...<clear><br><$comeff(1,1)><$facial(1,1)><$motion(1,805)><$voicel(1,8)>Wait a minute... You’re a Pokémon, aren’t you!<clear><br><$comeff(1,14)><$motion(1,807)><$voicel(1,5)>I guess it’s still possible for me to be kicked by a Pokémon<br>who LOOKS like a human, huh...<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Well, I learned something today. Thanks.
msgctxt "3255:51"
msgid "<$comeff(1,5)><$facial(1,9)><$motion(1,803)><$voicel(1,4)>¡Au! Ya estamos otra vez con las pataditas...<clear><br><$comeff(1,14)><$motion(1,802)><$voicel(1,3)>Y yo que pensaba que ahora que ya no se ven humanos<br>por ninguna parte iba a poder respirar tranquil<gen;-3(o,a)> por fin.<clear><br><$comeff(1,1)><$facial(1,1)><$motion(1,805)><$voicel(1,8)>¿Eh? ¡Pero si eres un Pokémon!<clear><br><$comeff(1,14)><$motion(1,807)><$voicel(1,5)>No me digas que ahora tengo que estar alerta para que<br>no se tropiecen conmigo Pokémon vestidos de humanos...<slide><br><$comeff(1,22)><$facial(1,7)><$motion(1,804)><$voicel(1,7)>¡Lo que me faltaba ya!"
msgstr ""

#. en: <$motion(1,17)><$comeff(1,9)><$voicel(1,8)><$facial(1,4)>Grom nom nom... So yummy! ♪<clear><br><$voicel(1,6)><$emotion(1,14)><$facial(1,1)>Oh—hi. Nice to meetcha.<clear><br><$voicel(1,7)><$emotion(1,39)>The boulders here are really cold and crunchy. I could eat<br>a mountain of them. ♪<clear><br><$voicel(1,5)><$emotion(1,49)>Let me know if you find any more tasty-looking boulders!
msgctxt "3255:52"
msgid "<$motion(1,17)><$comeff(1,9)><$voicel(1,8)><$facial(1,4)>Cronch, ñom, ñom... Qué ricas...<clear><br><$voicel(1,6)><$emotion(1,14)><$facial(1,1)>Ah, hola, colegui.<clear><br><$voicel(1,7)><$emotion(1,39)>Las rocas por aquí están tan fresquitas... Podría comerme<br>una montaña enteeera.<clear><br><$voicel(1,5)><$emotion(1,49)>Si encuentras alguna roca con buena pinta, avísame, ¿eh?"
msgstr "<$motion(1,17)><$comeff(1,9)><$voicel(1,8)><$facial(1,4)>Cronch, ñom, ñom... Qué ricas...<clear><br><$voicel(1,6)><$emotion(1,14)><$facial(1,1)>Ah, hola, amigui.<clear><br><$voicel(1,7)><$emotion(1,39)>Las rocas por aquí están tan fresquitas... Podría comerme<br>una montaña enteeera.<clear><br><$voicel(1,5)><$emotion(1,49)>Si encuentras alguna roca con buena pinta, avísame, ¿eh?"

#. en: Three... <wait(1.2)><$motion(1,803)><$comeff(1,14)>Two... <wait(1.2)><$motion(1,807)>One... <wait(1.2)><$motion(1,801)><$comeff(1,5)><br>... ... ...<wait(1.6)><$voicel(1,6)><$comeff(1,6)>Hm?<$lookat(1,1,0)><waitactor(1)><clear><br><$comeff(1,11)><$facial(1,13)><$motion(1,815)><$voicel(1,10)><$textsize(2)>AHHH!!!</textsize><clear><br><$comeff(1,10)><$motion(1,803)><$voicel(1,9)>Oh my goodness, who in the world are you?! It’s dangerous<br>to be here right now!<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,807)><$voicel(1,8)>I overslept so much that my mind is all groggy...<clear><br><$comeff(1,5)><$motion(1,814)><$voicel(1,7)>I was JUST about to clear my head with a big explosion!<clear><br><$comeff(1,21)><$motion(1,825)><$voicel(1,9)>Although, actually...I think the start you gave me may have<br>done the trick—I don’t feel sleepy at all anymore!<slide><br><$comeff(1,13)><$facial(1,4)><$motion(1,817)><$voicel(1,7)>So it all worked out after all. Thank you, dear!
msgctxt "3255:53"
msgid "Tres... <wait(1.2)><$motion(1,803)><$comeff(1,14)>dos... <wait(1.2)><$motion(1,807)>uno... <wait(1.2)><$motion(1,801)><$comeff(1,5)><wait(1.6)><$voicel(1,6)><$comeff(1,6)>¿Eh?<$lookat(1,1,0)><waitactor(1)><clear><br><$comeff(1,11)><$facial(1,13)><$motion(1,815)><$voicel(1,10)><$textsize(2)>¡Uah!</textsize><clear><br><$comeff(1,10)><$motion(1,803)><$voicel(1,9)>¡¿Se puede saber quién eres y qué haces ahí, criatura?!<br>¡Es peligroso!<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,807)><$voicel(1,8)>No sé si es por haber estado tanto tiempo durmiendo,<br>pero no logro espabilarme del todo, <$comeff(1,5)><$motion(1,814)><$voicel(1,7)>así que me disponía<slide><br>a explotar, a ver si eso funcionaba...<clear><br><$comeff(1,21)><$motion(1,825)><$voicel(1,9)>Pero la verdad es que, con la sorpresa que me he llevado<br>al verte, ya me noto mucho más despiert<gen;-3(o,a)>. <$comeff(1,13)><$facial(1,4)><$motion(1,817)><$voicel(1,7)>¡Gracias!"
msgstr "Tres... <wait(1.2)><$motion(1,803)><$comeff(1,14)>dos... <wait(1.2)><$motion(1,807)>uno... <wait(1.2)><$motion(1,801)><$comeff(1,5)><wait(1.6)><$voicel(1,6)><$comeff(1,6)>¿Eh?<$lookat(1,1,0)><waitactor(1)><clear><br><$comeff(1,11)><$facial(1,13)><$motion(1,815)><$voicel(1,10)><$textsize(2)>¡Uah!</textsize><clear><br><$comeff(1,10)><$motion(1,803)><$voicel(1,9)>¡¿Se puede saber quién eres y qué haces ahí, criatura?!<br>¡Es peligroso!<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,807)><$voicel(1,8)>No sé si es por haber estado tanto tiempo durmiendo,<br>pero no logro despabilarme del todo, <$comeff(1,5)><$motion(1,814)><$voicel(1,7)>así que me disponía<slide><br>a explotar, a ver si eso funcionaba...<clear><br><$comeff(1,21)><$motion(1,825)><$voicel(1,9)>Pero la verdad es que, con la sorpresa que me llevé<br>al verte, ya me siento mucho más despiert<gen;-3(o,a)>. <$comeff(1,13)><$facial(1,4)><$motion(1,817)><$voicel(1,7)>¡Gracias!"

#. en: ... ... ...<wait(1.2)><br>... ... ...<wait(1.2)><$motion(1,806)><$voicel(1,6)><$comeff(1,6)>Hm?<clear><br><$voicel(1,7)><$comeff(1,14)>Ummm.<wait(0.6)> Do I...<$voicel(1,6)><$comeff(1,6)><$motion(1,803)>know you?<clear><br><$voicel(1,7)><$comeff(1,14)>Ohhh.<wait(0.6)> Are we...<wait(1.0)>friends? <wait(0.6)><$voicel(1,6)><$comeff(1,6)><$motion(1,803)>Maybe?<clear><br><$voicel(1,8)><$comeff(1,6)><$motion(1,802)>Ahhh. Maybe not?<clear><br><$voicel(1,10)><$comeff(1,14)>Uhhh, well...<wait(1.0)><$motion(1,801)><$voicel(1,9)><$comeff(1,21)><$facial(1,5)>it’s nice to meet you. ♪
msgctxt "3255:54"
msgid "... <wait(1.2)><$motion(1,806)><$voicel(1,6)><$comeff(1,6)>¿Slow?<clear><br><$voicel(1,7)><$comeff(1,14)>Estooo...<wait(0.6)> Tú... <wait(1.0)>¿quién eres?<clear><br><$voicel(1,6)><$comeff(1,6)><$motion(1,803)>¿Qué estaba diciendo?<clear><br><$voicel(1,7)><$comeff(1,14)>Ah, sí...<wait(0.6)> Tú y yo... <wait(1.0)>¿somos coleguis?<clear><br><$voicel(1,6)><$comeff(1,6)><$motion(1,803)>¿Sí o qué? <wait(1.0)><$voicel(1,8)><$comeff(1,6)><$motion(1,802)>¿Ah, no?<clear><br><$voicel(1,10)><$comeff(1,14)>Pooos... Eeem... <wait(1.0)><$motion(1,801)><$voicel(1,9)><$comeff(1,21)><$facial(1,5)>Un placer, colega..."
msgstr "... <wait(1.2)><$motion(1,806)><$voicel(1,6)><$comeff(1,6)>¿Slow?<clear><br><$voicel(1,7)><$comeff(1,14)>Esteee...<wait(0.6)> Tú... <wait(1.0)>¿quién eres?<clear><br><$voicel(1,6)><$comeff(1,6)><$motion(1,803)>¿Qué estaba diciendo?<clear><br><$voicel(1,7)><$comeff(1,14)>Ah, sí...<wait(0.6)> Tú y yo... <wait(1.0)>¿somos amiguis?<clear><br><$voicel(1,6)><$comeff(1,6)><$motion(1,803)>¿Sí o qué? <wait(1.0)><$voicel(1,8)><$comeff(1,6)><$motion(1,802)>¿Ah, no?<clear><br><$voicel(1,10)><$comeff(1,14)>Pooos... Eeem... <wait(1.0)><$motion(1,801)><$voicel(1,9)><$comeff(1,21)><$facial(1,5)>Un placer, amigui..."

#. en: <$comeff(1,5)><$facial(1,13)><$motionoff(1,804)><$voicel(1,10)>Oh, I just had a gooood idea!<clear><br><$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Heyyy. Hey yooouuu! Listen to my good idea.<clear><br><$comeff(1,13)>...<wait(0.8)> ...<wait(0.8)><$facial(1,1)><$comeff(1,14)> ...<wait(0.8)><br><$comeff(1,6)><$motion(1,802)><$voicel(1,8)>Uhhh... What was it again?<clear><br><$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Ohhh well. Anyway, hope to see you around...
msgctxt "3255:55"
msgid "<$comeff(1,5)><$facial(1,13)><$motionoff(1,804)><$voicel(1,10)>¡Jo, vaya idea más genial he tenidooo!<clear><br><$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Oye, maj<gen;-2(o,a)>, escucha un momento.<clear><br><$comeff(1,13)>... <wait(0.8)>... <wait(0.8)><$facial(1,1)><$comeff(1,14)>... <wait(0.8)>...<clear><br><$comeff(1,6)><$motion(1,802)><$voicel(1,8)>Estooo... ¿y yo qué iba a decir?<clear><br><$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Nah, da igual. ¡Que tengas un bonito díaaa!"
msgstr "<$comeff(1,5)><$facial(1,13)><$motionoff(1,804)><$voicel(1,10)>¡Ay, qué idea tan genial tuveee!<clear><br><$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Oye, lind<gen;-2(o,a)>, escucha un momento.<clear><br><$comeff(1,13)>... <wait(0.8)>... <wait(0.8)><$facial(1,1)><$comeff(1,14)>... <wait(0.8)>...<clear><br><$comeff(1,6)><$motion(1,802)><$voicel(1,8)>Esteee... ¿y yo qué iba a decir?<clear><br><$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Nah, da igual. ¡Que tengas un bonito díaaa!"

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,5)>Fwahhh.<$lookat(1,1,0)><waitactor(1)><clear><br><$comeff(1,5)><$motion(1,803)><$voicel(1,8)>Ah. It is a human. I must emit my friendship waves.<clear><br><$comeff(1,13)><$facial(1,1)><$motionoff(1,817)><$voicel(1,7)>*beep beep* Hello. Hello. Konnichiwa. Merci. Xie xie.<br>Arigato ne. Thank you.<clear><br><$comeff(1,6)><$facial(1,9)><$motion(1,802)><$voicel(1,3)>Its reaction is not what I expected. What do I do.<$motion(0,182)><wait(1.4)><clear><br><$comeff(1,5)><$facial(1,4)><$motion(1,805)><$voicel(1,9)>What? You are a Pokémon? <wait(1.3)><$comeff(1,13)><$motion(0,181)>Let us be friends.
msgctxt "3255:56"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,5)>¡Bip!<$lookat(1,1,0)><waitactor(1)><clear><br><$comeff(1,5)><$motion(1,803)><$voicel(1,8)>¡Un ser humano! Iniciando emisión de salutaciones y ondas<br>amistosas.<clear><br><$comeff(1,13)><$facial(1,1)><$motionoff(1,817)><$voicel(1,7)>¡Bip, bip, bip! Hello, hola. Merci, xie xie, arigatou, gracias.<clear><br><$comeff(1,6)><$facial(1,9)><$motion(1,802)><$voicel(1,3)>... Reacción imperceptible. ¿Siguiente protocolo?<$motion(0,182)><wait(1.4)><clear><br><$comeff(1,5)><$facial(1,4)><$motion(1,805)><$voicel(1,9)>¡Bip! ¡Se trataba de un Pokémon!<wait(1.3)> <$comeff(1,13)><$motion(0,181)>Espero entablar amistad<br>contigo en un futuro próximo."
msgstr ""

#. en: <$comeff(1,10)><$motion(1,814)><$voicel(1,5)>*bzzzt bzzzt* Greetings.<clear><br><$comeff(1,6)><$motion(1,827)><$voicel(1,7)>I do look like just three Magnemite sticking together,<br>yes?<clear><br><$comeff(1,9)><$motion(1,803)><$voicel(1,8)>Well, we are just sticking together. Yes.<clear><br><$comeff(1,10)><$motion(1,802)><$voicel(1,7)>Actually, it requires much skill to work together as three.<clear><br><$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>So I think we too can be good friends. We and you.
msgctxt "3255:57"
msgid "<$comeff(1,10)><$motion(1,814)><$voicel(1,5)>Ton, ton... Un placer conocerte.<clear><br><$comeff(1,6)><$motion(1,827)><$voicel(1,7)>Pregunta: ¿parezco tres Magnemite acoplados?<clear><br><$comeff(1,9)><$motion(1,803)><$voicel(1,8)>Respuesta afirmativa. Somos tres individuos.<clear><br><$comeff(1,10)><$motion(1,802)><$voicel(1,7)>Mantener una buena relación entre tres requiere una<br>técnica avanzada.<clear><br><$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>Mi relación contigo será igual de buena."
msgstr ""

#. en: <$emotion(1,14)><$voicel(1,7)>Huh? An intruder? In my territory?! Yooo! Are you after<br>my leek?!?!<clear><br><$comeff(1,22)><$motionoff(1,804)><$voicel(1,9)>My faithful leek’s been with me for years! There’s NO WAY<br>I’ll hand it over without a fight! En garde ’n’ stuff, yo!<clear><br><$comeff(1,14)><$voicel(1,5)>... ... ...<wait(0.8)><br><$comeff(1,6)><$motion(1,803)>Oh. You’re, uh...not here to steal my leek? <$comeff(1,10)><$motion(1,801)><$voicel(1,8)>My bad, yo!<clear><br><$comeff(1,21)><$motion(1,803)><$voicel(1,10)>Phew. Well, that’s a relief. But I’m feelin’ kinda hungry<br>after all that excitement...<clear><br><$comeff(1,14)><$motion(1,806)><$voicel(1,6)>... ... ...<br>Yo, this leek’s lookin’ super tasty right now...
msgctxt "3255:58"
msgid "<$emotion(1,14)><$voicel(1,7)>¡Eh! ¡A<gen;-2(l, la)> intrus<gen;-2(o,a)>! ¿Qué haces en mis tierras, chava<gen;-2(l,la)>?<br>No vendrás a por mi puerro, ¿eh, desgraci<gen;-2(ao,á)>?<clear><br><$comeff(1,22)><$motionoff(1,804)><$voicel(1,9)>¡Este puerro lleva la tira a mi lado! ¡Es mi bestie, mi todo!<br>Si crees que me lo puedes birlar así, por tu cara bonita...<slide><br>¡MEEEK! ¡Error! ¡¡Prepárate para luchar!!<clear><br><$comeff(1,14)><$voicel(1,5)>... <wait(0.8)><$comeff(1,6)><$motion(1,803)>¿Eh? ¿Que me he precipitado a sacar conclusiones?<br><wait(0.4)><$comeff(1,10)><$motion(1,801)><$voicel(1,8)>¿Qué diceees? ¡Lo siento mucho, tí<gen;-2(o,a)>!<clear><br><$comeff(1,21)><$motion(1,803)><$voicel(1,10)>Puf... De tanto gritar ahora me ha dado un hambre que<br>no veas...<clear><br><$comeff(1,14)><$motion(1,806)><$voicel(1,6)>Oye, mi puerrito bestie... qué suculento te has vuelto<br>de pronto... ¡Si es que me flipa el puerro!"
msgstr "<$emotion(1,14)><$voicel(1,7)>¡Eh! ¡A<gen;-2(l, la)> intrus<gen;-2(o,a)>! ¿Qué haces en mis tierras, chava<gen;-2(l,la)>?<br>No vendrás por mi puerro, ¿eh, desgraci<gen;-2(ao,á)>?<clear><br><$comeff(1,22)><$motionoff(1,804)><$voicel(1,9)>¡Este puerro lleva años a mi lado! ¡Es mi bestie, mi todo!<br>Si crees que me lo puedes quitar así, por tu cara bonita...<slide><br>¡MEEEK! ¡Error! ¡¡Prepárate para luchar!!<clear><br><$comeff(1,14)><$voicel(1,5)>... <wait(0.8)><$comeff(1,6)><$motion(1,803)>¿Eh? ¿Que me precipité a sacar conclusiones?<br><wait(0.4)><$comeff(1,10)><$motion(1,801)><$voicel(1,8)>¿Qué diceees? ¡Lo siento mucho, amig<gen;-2(o,a)>!<clear><br><$comeff(1,21)><$motion(1,803)><$voicel(1,10)>Puf... De tanto gritar ahora me dio un hambre<br>tremenda...<clear><br><$comeff(1,14)><$motion(1,806)><$voicel(1,6)>Oye, mi puerrito bestie... qué suculento te volviste<br>de pronto... ¡Es que me encanta el puerro!"

#. en: <$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Wow, a human! Yaaay! ♪ I’m gonna follow it!<wait(1.3)><$motion(0,182)><wait(1.3)><clear><br><$comeff(1,5)><$facial(1,1)><$motionoff(1,804)><$voicel(1,8)>Gah! Whaaat? You’re just a Pokémon.<clear><br><$comeff(1,17)><$facial(1,9)><$motion(1,802)><$voicel(1,3)>Aw, that’s too bad. If you were a human, I figured you’d<br>be carrying a ton of tasty trash...<$facial(1,1)><$motion(0,181)><wait(2.5)><$motion(0,824)><wait(1.0)><$motion(0,652)><wait(0.9)><clear><br>Huh?<$motion(1,803)><$voicel(1,7)><$comeff(1,6)> You’re searching for humans too?<clear><br><$comeff(1,21)><$facial(1,5)><$motion(1,806)><$voicel(1,9)>Oh, neat! Well, if I can do anything to help, let me know.
msgctxt "3255:59"
msgid "<$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¿Qué ven mis ojos? ¡<gen;-2(Un,Una)> human<gen;-2(o,a)>!<br><$cdef(9)>(Voy a seguirl<gen;-2(o,a)> a ver si cae algo, jeee...).</color><wait(1.3)><$motion(0,182)><wait(1.3)><clear><br><$comeff(1,5)><$facial(1,1)><$motionoff(1,804)><$voicel(1,8)>Un momento... Pero si eres un Pokémon... Me has cortao<br>el rollo que no veas...<clear><br><$comeff(1,17)><$facial(1,9)><$motion(1,802)><$voicel(1,3)>Los humanos llevaban toda clase de basura deliciosa<br>encima. Se me estaba haciendo la boca agua ya...<$facial(1,1)><$motion(0,181)><wait(2.5)><$motion(0,824)><wait(1.0)><$motion(0,652)><wait(0.9)><clear><br><$motion(1,803)><$voicel(1,7)><$comeff(1,6)>¿Cómo? ¿Tú también estás buscando a los humanos?<clear><br><$comeff(1,21)><$facial(1,5)><$motion(1,806)><$voicel(1,9)>Pos, si necesitas cualquier cosa, ya sabes... aquí me<br>tienes..."
msgstr "<$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¿Qué ven mis ojos? ¡<gen;-2(Un,Una)> human<gen;-2(o,a)>!<br><$cdef(9)>(Voy a seguirl<gen;-2(o,a)> a ver si cae algo, jeee...).</color><wait(1.3)><$motion(0,182)><wait(1.3)><clear><br><$comeff(1,5)><$facial(1,1)><$motionoff(1,804)><$voicel(1,8)>Un momento... Pero si eres un Pokémon... Me quitaste<br>la ilusión de golpe...<clear><br><$comeff(1,17)><$facial(1,9)><$motion(1,802)><$voicel(1,3)>Los humanos llevaban toda clase de basura deliciosa<br>encima. Se me estaba haciendo la boca agua ya...<$facial(1,1)><$motion(0,181)><wait(2.5)><$motion(0,824)><wait(1.0)><$motion(0,652)><wait(0.9)><clear><br><$motion(1,803)><$voicel(1,7)><$comeff(1,6)>¿Cómo? ¿Tú también estás buscando a los humanos?<clear><br><$comeff(1,21)><$facial(1,5)><$motion(1,806)><$voicel(1,9)>Pos, si necesitas cualquier cosa, ya sabes... aquí me<br>tienes..."

#. en: <$comeff(1,9)><$motion(1,801)><$voicel(1,9)>Oh heyyy. I have a question for you.<clear><br><$comeff(1,6)><$motion(1,803)><$voicel(1,7)>Could you tell me the diiirtiest place around here?<clear><br><$comeff(1,14)><$facial(1,9)><$motion(1,806)><$voicel(1,5)>It used to be sooo much easier to find sludge and sewage<br>back in the day.<clear><br><$comeff(1,19)><$motion(1,802)><$voicel(1,3)>But it looks like there’s wayyy less of it these days.<br>That’s a seeerious environmental issue, don’t you think?
msgctxt "3255:60"
msgid "<$comeff(1,9)><$motion(1,801)><$voicel(1,9)>¡Ah, encantad<gen;-3(o,a)> de conocerte! Oye, ¿puedo preguntarte<br>algooo?<clear><br><$comeff(1,6)><$motion(1,803)><$voicel(1,7)>¿Conoces el lugar máaas guarrindongo de por aquí?<clear><br><$comeff(1,14)><$facial(1,9)><$motion(1,806)><$voicel(1,5)>Antiguamente estaba chupado encontrar lodo o unas<br>buenas agüicas residuales.<clear><br><$comeff(1,19)><$motion(1,802)><$voicel(1,3)>Pero ahora... la porquería parece escasear que no veas.<br>¡Eso sí que es un problema medioambiental grave!"
msgstr "<$comeff(1,9)><$motion(1,801)><$voicel(1,9)>¡Ah, encantad<gen;-3(o,a)> de conocerte! Oye, ¿puedo preguntarte<br>algooo?<clear><br><$comeff(1,6)><$motion(1,803)><$voicel(1,7)>¿Conoces el lugar máaas mugriento de por aquí?<clear><br><$comeff(1,14)><$facial(1,9)><$motion(1,806)><$voicel(1,5)>Antiguamente era facilísimo encontrar lodo o unas<br>buenas agüitas residuales.<clear><br><$comeff(1,19)><$motion(1,802)><$voicel(1,3)>Pero ahora... la porquería parece escasear un montón.<br>¡Eso sí que es un problema medioambiental grave!"

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Whoa, I bet living here would be a real gas. Plus, there’s<br>no way the wind can get to me!<clear><br><$facial(1,1)><$motion(1,805)><$voicel(1,7)>It’s not that I’m scared or anything—I’m just not a fan of<br>strong gusts of wind <wait(0.4)><$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,10)>since I always get blown away! Hehe!
msgctxt "3255:61"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Ey, qué buen sitio! Está hasta resguardado del viento<br>y todo, seguro que se está a gustísimo.<clear><br><$facial(1,1)><$motion(1,805)><$voicel(1,7)>Yo no le temo a nada, pero si hay una cosa en este mundo<br>que odio, es el viento... <$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,10)>¡¡Se me lleva enseguida!!"
msgstr "<$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Ey, qué buen lugar! Está hasta resguardado del viento<br>y todo, seguro que se está a gustísimo.<clear><br><$facial(1,1)><$motion(1,805)><$voicel(1,7)>Yo no le temo a nada, pero si hay una cosa en este mundo<br>que odio, es el viento... <$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,10)>¡¡Se me lleva enseguida!!"

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Hey there, nice to meet you. It’s so dark and quiet here...<wait(0.5)><br>I like it.<clear><br><$comeff(1,9)><$facial(1,1)><$motion(1,807)><$voicel(1,5)>Now all it needs is some unsuspecting humans to pass by<br>every once in a while.<clear><br><$voicel(1,7)><$motion(1,805)>I like to sneak up and tap ’em on the shoulder, then watch<br>’em scream and scatter. <wait(0.9)><$comeff(1,10)><$facial(1,5)><$motionoff(1,804)><$voicel(1,9)>It’s pretty fun.
msgctxt "3255:62"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Hola... Este sitio tan oscuro y tranquilo como una tumba<br>me viene de perlas.<clear><br><$comeff(1,9)><$facial(1,1)><$motion(1,807)><$voicel(1,5)>Solo falta que pase por aquí un humano de vez en<br>cuando. Sería la caña...<clear><br><$voicel(1,7)><$motion(1,805)>Me acercaría con sigilo, le daría un toquecito en el<br>hombro y a disfrutar con los gritos y viendo cómo sale<slide><br>corriendo. <$comeff(1,10)><$facial(1,5)><$motionoff(1,804)><$voicel(1,9)>Juas, juas. Soy la repera."
msgstr "<$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Hola... Este lugar tan oscuro y tranquilo como una tumba<br>me viene de perlas.<clear><br><$comeff(1,9)><$facial(1,1)><$motion(1,807)><$voicel(1,5)>Solo falta que pase por aquí un humano de vez en<br>cuando. Sería genial...<clear><br><$voicel(1,7)><$motion(1,805)>Me acercaría con sigilo, le daría un toquecito en el<br>hombro y a disfrutar con los gritos y viendo cómo sale<slide><br>corriendo. <$comeff(1,10)><$facial(1,5)><$motionoff(1,804)><$voicel(1,9)>Juas, juas. Soy lo máximo."

#. en: <$comeff(1,1)><$motion(1,803)><$voicel(1,5)>Huh? This human’s got a weird shadow. <$comeff(1,6)><$facial(1,9)><$motion(1,801)><$voicel(1,3)>I can’t figure out<br>how to slip into it...<wait(1.3)><$facial(1,1)><$motion(0,182)><wait(1.3)><clear><br><$comeff(1,5)><$motion(1,802)><$voicel(1,10)>Whoa! <wait(1.2)>You’re not a human?! <$motion(0,181)><wait(2.2)><$comeff(1,10)><$facial(1,4)><$motionoff(1,804)><$voicel(1,9)>That’s an awesome<br>transformation, bud!<clear><br><$motion(1,806)><$voicel(1,5)><$comeff(1,14)>But man, I can’t find a single human around here. <$comeff(1,6)><$facial(1,9)><$motion(1,807)><$voicel(1,7)>Where<br>the heck did they all go?
msgctxt "3255:63"
msgid "<$comeff(1,1)><$motion(1,803)><$voicel(1,5)>Buah, qué sombra más raruna tiene est<gen;-2(e,a)> <gen;-2(chaval,chavala)>...<br><$comeff(1,6)><$facial(1,9)><$motion(1,801)><$voicel(1,3)>¿Cómo podría hacer para ocultarme ahí?...<wait(1.3)><$facial(1,1)><$motion(0,182)><wait(1.3)><clear><br><$comeff(1,5)><$motion(1,802)><$voicel(1,10)>¡Gargh!<wait(1.2)> ¡Pero si no eres human<gen;-2(o,a)>! <$motion(0,181)><wait(2.2)><$comeff(1,10)><$facial(1,4)><$motionoff(1,804)><$voicel(1,9)>¡Pues qué pedazo de<br>transformación te has marcado, oye!<clear><br><$motion(1,806)><$voicel(1,5)><$comeff(1,14)>La verdad es que por aquí no hay ni rastro de humanos...<br><$comeff(1,6)><$facial(1,9)><$motion(1,807)><$voicel(1,7)>¿Por dónde andarán?"
msgstr "<$comeff(1,1)><$motion(1,803)><$voicel(1,5)>Vaya, qué sombra más rara tiene est<gen;-2(e,a)> <gen;-2(chaval,chavala)>...<br><$comeff(1,6)><$facial(1,9)><$motion(1,801)><$voicel(1,3)>¿Cómo podría hacer para ocultarme ahí?...<wait(1.3)><$facial(1,1)><$motion(0,182)><wait(1.3)><clear><br><$comeff(1,5)><$motion(1,802)><$voicel(1,10)>¡Gargh!<wait(1.2)> ¡Pero si no eres human<gen;-2(o,a)>! <$motion(0,181)><wait(2.2)><$comeff(1,10)><$facial(1,4)><$motionoff(1,804)><$voicel(1,9)>¡Pues qué tremenda<br>transformación te hiciste, oye!<clear><br><$motion(1,806)><$voicel(1,5)><$comeff(1,14)>La verdad es que por aquí no hay ni rastro de humanos...<br><$comeff(1,6)><$facial(1,9)><$motion(1,807)><$voicel(1,7)>¿Por dónde andarán?"

#. en: <$voicel(1,5)><$motion(1,806)>Oh? You there...<wait(1.8)> <$comeff(1,6)><$facial(1,4)><$motion(1,805)><$voicel(1,8)>You’re quite the digger, aren’t ya?<clear><br><$voicel(1,7)><$motion(1,807)><$facial(1,1)><$comeff(1,14)>You may not be the same type as me, but I bet you can dig<br>in the ground freely <$voicel(1,5)>and change the terrain as you like...<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>I know you have that potential, bud. I can see it in ya!
msgctxt "3255:64"
msgid "<$voicel(1,5)><$motion(1,806)><$comeff(1,6)>¿Eh?... <wait(1.8)><$facial(1,4)><$motion(1,805)><$voicel(1,8)>No se te da nada mal esto de excavar, amig<gen;-2(o,a)>.<clear><br><$voicel(1,7)><$motion(1,807)><$facial(1,1)><$comeff(1,14)>Aunque seas de un tipo diferente, me da a mí en la napia<br>que serías capaz de excavar y cambiar el terreno a placer<slide><br><$voicel(1,5)>para dejarlo como a ti te guste...<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Tienes ese potencial, hazme caso! ¡Si lo sabré yo!"
msgstr "<$voicel(1,5)><$motion(1,806)><$comeff(1,6)>¿Eh?... <wait(1.8)><$facial(1,4)><$motion(1,805)><$voicel(1,8)>No se te da nada mal esto de excavar, amig<gen;-2(o,a)>.<clear><br><$voicel(1,7)><$motion(1,807)><$facial(1,1)><$comeff(1,14)>Aunque seas de un tipo diferente, me da a mí en la nariz<br>que serías capaz de excavar y cambiar el terreno a placer<slide><br><$voicel(1,5)>para dejarlo como a ti te guste...<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Tienes ese potencial, hazme caso! ¡Si lo sabré yo!"

#. en: <$motion(1,806)><$voicel(1,7)>Oh, uh... N-nice to meet you. <wait(1.2)><$comeff(1,6)>You’re...not a human?<br>You’re a Pokémon? <$motion(0,40)><wait(1.7)><$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,8)>Oh, thank goodness!<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,806)><$voicel(1,5)>Y’see, when humans were around, they’d always come<br>poke me with stuff, thinking I was a Poké Ball...<clear><br><$comeff(1,19)><$facial(1,9)><$motion(1,802)><$voicel(1,3)>They’d end up getting zapped, and I always felt so bad<br>for them...<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>W-well, I hope you and I can be friends, anyway!<br>Bzzzzzzrt...
msgctxt "3255:65"
msgid "<$motion(1,806)><$voicel(1,7)>Hola... Mucho gusto...<wait(1.2)><$comeff(1,6)> T-tú no eres human<gen;-2(o,a)>, ¿verdad?<br><$motion(0,40)><wait(1.7)><$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,8)>Ay, qué alivio...<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,806)><$voicel(1,5)>Los humanos siempre se piensan que soy una Poké Ball<br>y me agarran sin querer...<clear><br><$comeff(1,19)><$facial(1,9)><$motion(1,802)><$voicel(1,3)>Se llevan unos calambres, los pobres... Luego me siento<br>fatal...<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>B-bueno, pues nos vemos por ahí... ¡Bzzz!"
msgstr "<$motion(1,806)><$voicel(1,7)>Hola... Mucho gusto...<wait(1.2)><$comeff(1,6)> T-tú no eres human<gen;-2(o,a)>, ¿verdad?<br><$motion(0,40)><wait(1.7)><$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,8)>Ay, qué alivio...<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,806)><$voicel(1,5)>Los humanos siempre creen que soy una Pokébola<br>y me agarran sin querer...<clear><br><$comeff(1,19)><$facial(1,9)><$motion(1,802)><$voicel(1,3)>Se llevan unos calambres, los pobres... Luego me siento<br>muy mal...<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>B-bueno, pues nos vemos por ahí... ¡Bzzz!"

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>Yooo, what a great place!<clear><br><$voicel(1,7)>Huh?! You made this? <$facial(1,13)><$comeff(1,21)><$motionoff(1,804)>That’s so awesome! Respect, yo!<clear><br><$comeff(1,13)><$motion(1,816)><$voicel(1,9)>I’ll do my best to not explode while I live here!
msgctxt "3255:66"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>¡Qué bien se está aquí!<clear><br><$voicel(1,7)>¿Lo has hecho tú? ¿Qué me estás contando?<br><$facial(1,13)><$comeff(1,21)><$motionoff(1,804)>¡Pues es una pasada!<clear><br><$comeff(1,13)><$motion(1,816)><$voicel(1,9)>Procuraré no explotar mientras viva aquí. ¡Sería una pena!"
msgstr "<$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>¡Qué bien se está aquí!<clear><br><$voicel(1,7)>¿Lo hiciste tú? ¿En serio?<br><$facial(1,13)><$comeff(1,21)><$motionoff(1,804)>¡Pues es increíble!<clear><br><$comeff(1,13)><$motion(1,816)><$voicel(1,9)>Procuraré no explotar mientras viva aquí. ¡Sería una pena!"

#. en: <$comeff(1,6)><$motion(1,803)><$voicel(1,10)>Huh? What’s your deal? ...Hang on a sec!
msgctxt "3255:67"
msgid "<$comeff(1,6)><$motion(1,803)><$voicel(1,10)>¡Oye, tú! ¿Quién eres? ¡Quiet<gen;-2(o,a)> ahí!"
msgstr ""

#. en: <$comeff(1,10)><$motion(1,807)><$voicel(1,10)>OK, folks: any thoughts on this funky-lookin’ rando?
msgctxt "3255:68"
msgid "<$comeff(1,10)><$motion(1,807)><$voicel(1,10)>A ver, peña. ¿Qué pensáis <gen;-2(del,de la)> nuev<gen;-2(o,a)>? Lleva unas pintas<br>un poco raras..."
msgstr "<$comeff(1,10)><$motion(1,807)><$voicel(1,10)>A ver, chicos. ¿Qué piensan <gen;-2(del,de la)> nuev<gen;-2(o,a)>? Tiene un aspecto<br>un poco raro..."

#. en: <$comeff(1,10)><$motion(1,807)><$voicel(1,10)>I say we act cool and be nice. I mean, our visitor here<br>doesn’t seem like a bad egg.
msgctxt "3255:69"
msgid "<$comeff(1,10)><$motion(1,807)><$voicel(1,10)>No sé, no parece mala gente. Si quiere ser amig<gen;-2(o,a)> nuestr<gen;-2(o,a)>,<br>pues okey."
msgstr ""

#. en: <$comeff(1,10)><$motion(1,807)><$voicel(1,10)>Yup, I agree.
msgctxt "3255:70"
msgid "<$comeff(1,10)><$motion(1,807)><$voicel(1,10)>¡Ídem!"
msgstr ""

#. en: <$comeff(1,10)><$motion(1,807)><$voicel(1,10)>Sounds good to meee!
msgctxt "3255:71"
msgid "<$comeff(1,10)><$motion(1,807)><$voicel(1,10)>¡Pues por mí también!"
msgstr ""

#. en: <$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>All right, thanks for waiting! Let’s be friends!
msgctxt "3255:72"
msgid "<$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>Hala, decidido, ¡ahora eres un<gen;-2(o,a)> más de la panda!"
msgstr "<$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>Bueno, decidido, ¡ahora eres un<gen;-2(o,a)> más de la pandilla!"

#. en: <$comeff(1,1)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Hey. Heyyyy. You there. Can you weigh in on something<br>for us reeeaaal quick?<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,802)><$voicel(1,3)>Sooo here’s the thing. I’m sleepy right now and would<br>love a nice naaap...
msgctxt "3255:73"
msgid "<$comeff(1,1)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Oyeee, ¿me concedes un minutico de tu tiempo?<br>Es que tengo aquí un asunto que me trae de cabezas.<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,802)><$voicel(1,3)>Pues mira, la cuestión es que me ha entrado la modorra<br>y me gustaría tumbarme un rato a la bartola."
msgstr "<$comeff(1,1)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Oyeee, ¿me concedes un minutito de tu tiempo?<br>Es que tengo aquí un asunto que me trae de cabezas.<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,802)><$voicel(1,3)>Pues mira, la cuestión es que me entró la modorra<br>y me gustaría echarme un rato a descansar."

#. en: <$comeff(1,10)><$motion(1,805)><$voicel(1,8)>But I want to eat some berries...
msgctxt "3255:74"
msgid "<$comeff(1,10)><$motion(1,805)><$voicel(1,8)>Pero yo quiero comer bayaaas..."
msgstr ""

#. en: <$comeff(1,9)><$motion(1,806)><$voicel(1,7)>And I want to go for a waaalk...
msgctxt "3255:75"
msgid "<$comeff(1,9)><$motion(1,806)><$voicel(1,7)>Y yo quiero dar un paseíco."
msgstr "<$comeff(1,9)><$motion(1,806)><$voicel(1,7)>Y yo quiero dar un paseíto."

#. en: <$comeff(1,6)><$motion(1,803)><$voicel(1,7)>Sooo uh... Can you think of some way we can take a nap<br>and eat and go on a walk all at the same tiiime?
msgctxt "3255:76"
msgid "<$comeff(1,6)><$motion(1,803)><$voicel(1,7)>Jo... ¿Se te ocurre alguna forma de dar un paseo mientras<br>se duerme y se come a la vez?"
msgstr "<$comeff(1,6)><$motion(1,803)><$voicel(1,7)>Ay... ¿Se te ocurre alguna forma de dar un paseo mientras<br>se duerme y se come a la vez?"

#. en: <$voicel(1,8)><$facial(1,13)><$motion(1,899)><$comeff(1,5)>Ack! A human!<clear><br><$voicel(1,3)><$comeff(1,17)><$motion(1,802)><$facial(1,1)>Wait, maybe not? Are you...a Pokémon? Phew! OK, guess<br>I’m safe for now.<clear><br><$voicel(1,5)><$facial(1,1)><$motion(1,666)>This place looks nice ’n’ quiet, so I think I’ll stay around<br>here for a while! <$voicel(1,8)><$emotion(1,38)>Let’s be friends, OK?<clear><br><$voicel(1,3)><$comeff(1,14)><$facial(1,9)><$motion(1,805)>... ... ...<br>Mom prob’ly woulda liked a place like this too...
msgctxt "3255:77"
msgid "<$voicel(1,8)><$facial(1,13)><$motion(1,899)><$comeff(1,5)>Ay, no... <gen;-2(U-un,U-una)> human<gen;-2(o,a)>...<clear><br><$voicel(1,3)><$comeff(1,17)><$motion(1,802)><$facial(1,1)>Ah, pero si eres un Pokémon. Jolín, menos mal.<clear><br><$voicel(1,5)><$facial(1,1)><$motion(1,666)>Este lugar está muy bien y parece tranquilito... así que<br>creo que voy a quedarme por aquí.<clear><br><$voicel(1,8)><$emotion(1,38)>E-espero que nos veamos a menudo y juguemos mucho.<br><wait(0.6)><$voicel(1,3)><$comeff(1,14)><$facial(1,9)><$motion(1,805)><$cdef(9)>(Jo, este sitio le habría encantado a mi mamá...).</color>"
msgstr "<$voicel(1,8)><$facial(1,13)><$motion(1,899)><$comeff(1,5)>Ay, no... <gen;-2(U-un,U-una)> human<gen;-2(o,a)>...<clear><br><$voicel(1,3)><$comeff(1,17)><$motion(1,802)><$facial(1,1)>Ah, pero si eres un Pokémon. Uf, menos mal.<clear><br><$voicel(1,5)><$facial(1,1)><$motion(1,666)>Este lugar está muy bien y parece tranquilito... así que<br>creo que voy a quedarme por aquí.<clear><br><$voicel(1,8)><$emotion(1,38)>E-espero que nos veamos a menudo y juguemos mucho.<br><wait(0.6)><$voicel(1,3)><$comeff(1,14)><$facial(1,9)><$motion(1,805)><$cdef(9)>(Ay, este lugar le habría encantado a mi mamá...).</color>"

#. en: <$voicel(1,6)><$emotion(1,14)>Oh, hello there. A pleasure to make your acquaintance.<clear><br><$voicel(1,3)><$comeff(1,6)><$motion(1,805)>May I ask why you’re shaped like a human?<wait(1.2)><$motion(0,824)><wait(1.0)><$motion(0,652)><wait(0.5)><clear><br><$voicel(1,6)><$comeff(1,14)>Ah, so you’re searching for humans, are you?<br>Fascinating.<clear><br><$voicel(1,7)><$motion(1,806)><$comeff(1,20)>If there’s any way I can be of assistance, I’d be happy<br>to help.<clear><br><$voicel(1,5)><$emotion(1,14)>Being unable to meet your loved ones must be terribly<br>sad, after all.
msgctxt "3255:78"
msgid "<$voicel(1,6)><$emotion(1,14)>Hola, es un placer conocerte.<clear><br><$voicel(1,3)><$comeff(1,6)><$motion(1,805)>¿A qué se debe que hayas adoptado aspecto humano?<wait(1.2)><$motion(0,824)><wait(1.0)><$motion(0,652)><wait(0.5)><clear><br><$voicel(1,6)><$comeff(1,14)>Ya veo, así que estás en plena búsqueda de <gen;-2(un,una)> human<gen;-2(o,a)><br>en concreto...<clear><br><$voicel(1,7)><$motion(1,806)><$comeff(1,20)>Si no es inconveniente, me gustaría ayudarte.<clear><br><$voicel(1,5)><$emotion(1,14)>Debe de ser muy duro el haber perdido a alguien que<br>significaba tanto para ti...<clear><br>Espero que nos llevemos bien."
msgstr ""

#. en: <$comeff(1,10)><$motion(1,814)><$voicel(1,9)><$textsize(2)>HIYAHHH!</textsize><wait(0.65)><$comeff(0,5)><$motion(0,132)><clear><br><$comeff(1,6)><$motion(1,803)><$voicel(1,5)>Oh! You all right there? Sure am sorry if I startled ya!<clear><br><$facial(1,4)><$motion(1,806)><$voicel(1,7)>I’m always practicin’ my kicks every chance I get—<$comeff(1,13)><$motionoff(1,804)><$voicel(1,8)>watch<br>yerself when walkin’ through this area!<clear><br><$comeff(1,10)><$facial(1,1)><$motion(1,815)><$voicel(1,9)>Low kick! Hiyah! <wait(1.2)><$motion(1,814)><$comeff(1,10)>Mid kick! Hiyah!<br><$comeff(1,10)><$motion(1,802)><$voicel(1,10)>And a high kick! Hiyah!<clear><br><$comeff(1,13)><$facial(1,4)><$motion(1,817)><$voicel(1,7)>Yes, indeed! My kicks are snappy again today! Hahahaaa!
msgctxt "3255:79"
msgid "<$comeff(1,10)><$motion(1,814)><$voicel(1,9)><$textsize(2)>¡¡Monlee!!</textsize><wait(0.65)><$comeff(0,5)><$motion(0,132)><clear><br><$comeff(1,6)><$motion(1,803)><$voicel(1,5)>¡Uy! ¿Te encuentras bien, mocit<gen;-2(o,a)>? Perdona si te he pegado<br>un buen susto.<clear><br><$facial(1,4)><$motion(1,806)><$voicel(1,7)>Es que en cuanto tengo un momento de asueto me pongo<br>a practicar las patadas y claro...<clear><br><$comeff(1,13)><$motionoff(1,804)><$voicel(1,8)>Procura andar con tiento si pasas por aquí, porque como<br>suelen decir: \"Si metes la pata, patada te meten\".<clear><br><$comeff(1,10)><$facial(1,1)><$motion(1,815)><$voicel(1,9)>¡Hit! ¡Patada baja! <wait(1.2)><$motion(1,814)><$comeff(1,10)>¡Mon! ¡Patada media! <$comeff(1,10)><$motion(1,802)><$voicel(1,10)>¡Lee! ¡Patada alta!<clear><br><$comeff(1,13)><$facial(1,4)><$motion(1,817)><$voicel(1,7)>¡Hoy también estoy ejecutando unas señoras patadas!<br>Hasta diría que son la envidia del vecindario. ¡Bua, ja, ja!"
msgstr "<$comeff(1,10)><$motion(1,814)><$voicel(1,9)><$textsize(2)>¡¡Monlee!!</textsize><wait(0.65)><$comeff(0,5)><$motion(0,132)><clear><br><$comeff(1,6)><$motion(1,803)><$voicel(1,5)>¡Uy! ¿Te encuentras bien, mocit<gen;-2(o,a)>? Perdona si te di<br>un buen susto.<clear><br><$facial(1,4)><$motion(1,806)><$voicel(1,7)>Es que en cuanto tengo un momento de asueto me pongo<br>a practicar las patadas y claro...<clear><br><$comeff(1,13)><$motionoff(1,804)><$voicel(1,8)>Procura andar con tiento si pasas por aquí, porque como<br>suelen decir: \"Si metes la pata, patada te meten\".<clear><br><$comeff(1,10)><$facial(1,1)><$motion(1,815)><$voicel(1,9)>¡Hit! ¡Patada baja! <wait(1.2)><$motion(1,814)><$comeff(1,10)>¡Mon! ¡Patada media! <$comeff(1,10)><$motion(1,802)><$voicel(1,10)>¡Lee! ¡Patada alta!<clear><br><$comeff(1,13)><$facial(1,4)><$motion(1,817)><$voicel(1,7)>¡Hoy también estoy ejecutando unas señoras patadas!<br>Hasta diría que son la envidia del vecindario. ¡Bua, ja, ja!"

#. en: <$voicel(1,10)><$comeff(1,10)><$motion(1,814)>Hup... Hyah!<wait(0.8)><$comeff(1,10)><$motion(1,815)><clear><br><$comeff(1,1)><$motion(1,803)><$voicel(1,9)>Oh, hey. Wanna join me for some training?<clear><br><$comeff(1,14)><$motion(1,802)><$voicel(1,5)>Actually, hold up—it’s just about time for a break.<clear><br><$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Taking small, frequent breaks is the key to not wearing<br>yourself out. We can train later, OK?
msgctxt "3255:80"
msgid "<$voicel(1,10)><$comeff(1,10)><$motion(1,814)>¡Hit, hit! ¡Mooon, chan!<wait(0.8)><$comeff(1,10)><$motion(1,815)><clear><br><$comeff(1,1)><$motion(1,803)><$voicel(1,9)>Buenas... Me has visto en acción y te han entrado ganas<br>de entrenar conmigo, ¿a que sí?<clear><br><$comeff(1,14)><$motion(1,802)><$voicel(1,5)>Ah, espera. Que es la hora del descanso.<clear><br><$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Tomarse muchos descansos es la clave para no acabar<br>hech<gen;-3(o,a)> un despojo. Otro día entrenamos."
msgstr "<$voicel(1,10)><$comeff(1,10)><$motion(1,814)>¡Hit, hit! ¡Mooon, chan!<wait(0.8)><$comeff(1,10)><$motion(1,815)><clear><br><$comeff(1,1)><$motion(1,803)><$voicel(1,9)>Buenas... Me viste en acción y te dieron ganas<br>de entrenar conmigo, ¿verdad?<clear><br><$comeff(1,14)><$motion(1,802)><$voicel(1,5)>Ah, espera. Que es la hora del descanso.<clear><br><$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Tomarse muchos descansos es la clave para no acabar<br>hech<gen;-3(o,a)> un despojo. Otro día entrenamos."

#. en: <$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Oh, hi! Nice to meet you. This place is pretty great, huh?<br>It’s like a treasure trove...<wait(0.8)>of trash! ♪<clear><br><$comeff(1,10)><$motion(1,815)><$voicel(1,9)>It smells sooo good. I keep taking lots of deep breaths.<br><$facial(1,1)><$motion(1,803)><$voicel(1,7)>In...<wait(0.5)>out...<slide><br><$comeff(1,14)><$motion(1,803)><$voicel(1,7)>In...<wait(0.5)>out...<clear><br><$comeff(1,14)><$voicel(1,3)>Uh-oh. I think I’m gonna explode. <$comeff(1,9)><$motion(1,816)>Bwhhh!<clear><br><$comeff(1,10)><$motion(1,815)><$voicel(1,5)>Phew, that was close. I released some gas, so it’s fine now.<br><$comeff(1,21)><$facial(1,4)><$motion(1,817)><$voicel(1,7)>Um, sorry if it was kinda stinky...
msgctxt "3255:81"
msgid "<$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>¿Qué pasa, colegui? Me flipa este sitio lleno de basura.<br><$comeff(1,10)><$motion(1,815)><$voicel(1,9)>Si es que huele que alimenta... Jeee.<clear><br>Voy a disfrutarlo al máximo inhalando to lo que<br>pueda...<wait(0.9)> <$facial(1,1)><$motion(1,803)><$voicel(1,7)>¡Sniiif! <wait(0.9)><$comeff(1,14)><$motion(1,803)><$voicel(1,7)>¡Sniiif! <wait(0.9)><$comeff(1,14)><$voicel(1,3)>Oh, no... Creo que voy a explotar...<clear><br><$comeff(1,9)><$motion(1,816)>Pssssss...<clear><br><$comeff(1,10)><$motion(1,815)><$voicel(1,5)>Buf, por los pelos... He soltao gas y ya no hay peligro.<br><$comeff(1,21)><$facial(1,4)><$motion(1,817)><$voicel(1,7)>Perdón por el tufo, ¿eh? No me lo tengas en cuenta..."
msgstr "<$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>¿Qué tal, amigui? Me encanta este lugar lleno de basura.<br><$comeff(1,10)><$motion(1,815)><$voicel(1,9)>Es que huele delicioso... Jeee.<clear><br>Voy a disfrutarlo al máximo inhalando todo lo que<br>pueda...<wait(0.9)> <$facial(1,1)><$motion(1,803)><$voicel(1,7)>¡Sniiif! <wait(0.9)><$comeff(1,14)><$motion(1,803)><$voicel(1,7)>¡Sniiif! <wait(0.9)><$comeff(1,14)><$voicel(1,3)>Oh, no... Creo que voy a explotar...<clear><br><$comeff(1,9)><$motion(1,816)>Pssssss...<clear><br><$comeff(1,10)><$motion(1,815)><$voicel(1,5)>Uf, por poco... Solté gas y ya no hay peligro.<br><$comeff(1,21)><$facial(1,4)><$motion(1,817)><$voicel(1,7)>Perdón por el tufo, ¿eh? No me lo tengas en cuenta..."

#. en: <$voicel(1,7)><$emotion(1,49)>Whoooaaa, a human... I was just wondering where all the<br>humans went.<wait(1.0)><$motion(0,824)><wait(1.0)><$motion(0,652)><wait(0.5)><clear><br><$voicel(1,5)><$comeff(1,4)><$motion(1,805)>What? You’re nooot a human? They’ve all gone off<br>somewhere?<clear><br><$voicel(1,3)><$emotion(1,46)>Oh, OK... That makes me kind of saaad...<clear><br><$voicel(1,7)><$emotion(1,6)>Places with lots of humans had tons of that niiice blaaack<br>smoke I love...
msgctxt "3255:82"
msgid "<$voicel(1,7)><$emotion(1,49)>¡Ostras, <gen;-2(un,una)> human<gen;-2(o,a)>! Ya me preguntaba yo dónde os<br>habíais metido todos...<wait(1.0)><$motion(0,824)><wait(1.0)><$motion(0,652)><wait(0.5)><clear><br><$voicel(1,5)><$comeff(1,4)><$motion(1,805)>¿Cóoomo? ¿Que eres un Pokémon? ¿Y que los humanos<br>se han esfumado sin dejar rastro?<clear><br><$voicel(1,3)><$emotion(1,46)>Vaya panorama... Pues qué penica, oye...<clear><br><$voicel(1,7)><$emotion(1,6)>Los sitios con muchos humanos siempre estaban a rebosar<br>de humo negruzco, así que se estaba de lujo."
msgstr "<$voicel(1,7)><$emotion(1,49)>¡Cielos, <gen;-2(un,una)> human<gen;-2(o,a)>! Ya me preguntaba yo dónde se<br>habían metido todos...<wait(1.0)><$motion(0,824)><wait(1.0)><$motion(0,652)><wait(0.5)><clear><br><$voicel(1,5)><$comeff(1,4)><$motion(1,805)>¿Cóoomo? ¿Que eres un Pokémon? ¿Y que los humanos<br>se esfumaron sin dejar rastro?<clear><br><$voicel(1,3)><$emotion(1,46)>Vaya panorama... Pues qué penita, oye...<clear><br><$voicel(1,7)><$emotion(1,6)>Los lugares con muchos humanos siempre estaban a rebosar<br>de humo negruzco, así que se estaba de maravilla."

#. en: <$comeff(1,10)><$motion(1,801)><$voicel(1,8)>Oh! Hiya there! Nice to meet you! Umm, so! Gonna need<br>you to sit still for just a sec.<clear><br><$motion(1,802)>...<wait(2.0)><$comeff(1,5)><$motion(1,803)><$voicel(1,7)>OK, got it! <$comeff(1,21)><$facial(1,4)><$motion(1,805)><$voicel(1,10)>You’re a good egg, right?<clear><br><$comeff(1,10)><$motion(1,806)><$voicel(1,7)>I’m pretty confident in my ability to judge someone’s<br>character based on their vibes!<clear><br><$comeff(1,13)><$motion(1,807)><$voicel(1,9)>Let’s be friends, OK?
msgctxt "3255:83"
msgid "<$comeff(1,10)><$motion(1,801)><$voicel(1,8)>¡Qué hayyy! ¡Encantad<gen;-3(o,a)>! A ver, no te muevas un<br>momentito...<clear><br><$motion(1,802)>... <wait(2.0)><$comeff(1,5)><$motion(1,803)><$voicel(1,7)>¡Ya está! <$comeff(1,21)><$facial(1,4)><$motion(1,805)><$voicel(1,10)>¡No hay duda, eres buena gente fijo!<clear><br><$comeff(1,10)><$motion(1,806)><$voicel(1,7)>Tengo un sexto sentido para percibir si alguien da buenas<br>o malas vibras.<clear><br><$comeff(1,13)><$motion(1,807)><$voicel(1,9)>Hale, ¡pues hasta otra!"
msgstr "<$comeff(1,10)><$motion(1,801)><$voicel(1,8)>¡Qué taaal! ¡Encantad<gen;-3(o,a)>! A ver, no te muevas un<br>momentito...<clear><br><$motion(1,802)>... <wait(2.0)><$comeff(1,5)><$motion(1,803)><$voicel(1,7)>¡Ya está! <$comeff(1,21)><$facial(1,4)><$motion(1,805)><$voicel(1,10)>¡No hay duda, seguro eres buena gente!<clear><br><$comeff(1,10)><$motion(1,806)><$voicel(1,7)>Tengo un sexto sentido para percibir si alguien da buenas<br>o malas vibras.<clear><br><$comeff(1,13)><$motion(1,807)><$voicel(1,9)>Bueno, ¡pues hasta la próxima!"

#. en: <$facial(1,4)><$comeff(1,21)><$motion(1,801)><$voicel(1,10)>Oooh, this place is so nice and warm! I’m gonna live here!<clear><br><$comeff(1,10)><$motion(1,803)><$voicel(1,7)>You can come here too—anytime you wanna take a nap!<clear><br><$comeff(1,5)><$motion(1,805)><$voicel(1,9)>Oh, but I gotta warn you that I move my vines a lot in my<br>sleep. Sorry if you get tangled up in them!
msgctxt "3255:84"
msgid "<$facial(1,4)><$comeff(1,21)><$motion(1,801)><$voicel(1,10)>¡Hala, este sitio es supercalentito! ¡Quiero vivir aquí!<clear><br><$comeff(1,10)><$motion(1,803)><$voicel(1,7)>Si algún día te entran ganas de descansar y echarte<br>la siesta conmigo, pásate por aquí, ¿vale?<clear><br><$comeff(1,5)><$motion(1,805)><$voicel(1,9)>Aunque te aviso de que me muevo mucho cuando duermo<br>y es posible que te enredes en mis lianas... Ji, ji."
msgstr "<$facial(1,4)><$comeff(1,21)><$motion(1,801)><$voicel(1,10)>¡Guau, este lugar es supercalentito! ¡Quiero vivir aquí!<clear><br><$comeff(1,10)><$motion(1,803)><$voicel(1,7)>Si algún día te entran ganas de descansar y echarte<br>la siesta conmigo, pásate por aquí, ¿sí?<clear><br><$comeff(1,5)><$motion(1,805)><$voicel(1,9)>Aunque te aviso de que me muevo mucho cuando duermo<br>y es posible que te enredes en mis lianas... Ji, ji."

#. en: <$motion(1,816)><$comeff(1,10)>... ... ...<br><$voicel(1,6)><$comeff(1,14)>Wait... Can you...<clear><br><$comeff(1,6)><$voicel(1,5)>Can you see this wall, yo? <wait(0.8)><$facial(1,4)><$comeff(1,21)><$motion(1,803)><$voicel(1,10)>You’re the real deal, huh?<clear><br><$comeff(1,13)><$motion(1,801)><$voicel(1,7)>That proves your heart’s, like, pure, y’know? I hope we<br>can be friends.
msgctxt "3255:85"
msgid "<$motion(1,816)><$comeff(1,10)>...<clear><br>... <$voicel(1,6)><$comeff(1,14)>Acaso... tú... <$comeff(1,6)><$voicel(1,5)>¿ves mi pared?<wait(0.8)> <$facial(1,4)><$comeff(1,21)><$motion(1,803)><$voicel(1,10)>Vaya, eres <gen;-2(un,una)> tí<gen;-2(o,a)> list<gen;-2(o,a)>...<clear><br><$comeff(1,13)><$motion(1,801)><$voicel(1,7)>Seguro que eres alguien de corazón puro.<br>¡Nos llevaremos bien!"
msgstr "<$motion(1,816)><$comeff(1,10)>...<clear><br>... <$voicel(1,6)><$comeff(1,14)>Acaso... tú... <$comeff(1,6)><$voicel(1,5)>¿ves mi pared?<wait(0.8)> <$facial(1,4)><$comeff(1,21)><$motion(1,803)><$voicel(1,10)>Vaya, eres <gen;-2(un,una)> chic<gen;-2(o,a)> list<gen;-2(o,a)>...<clear><br><$comeff(1,13)><$motion(1,801)><$voicel(1,7)>Seguro que eres alguien de corazón puro.<br>¡Nos llevaremos bien!"

#. en: <$comeff(1,10)><$motion(1,814)><$voicel(1,9)>Swish!<clear><br><$comeff(1,6)><$motion(1,803)><$voicel(1,5)>Huh? What’s up? You need somethin’ from me?<turn(1,60)><$lookat(1,0,1)><waitactor(1)><clear><br><$motion(1,806)><$voicel(1,6)>Sorry, but it’ll have to wait. I gotta get my hundred<br>swings in!<clear><br><$comeff(1,10)><$motion(1,815)><$voicel(1,9)>Swoosh... <wait(1.8)><$comeff(1,6)><$motion(1,807)>Uh... What number was that?<clear><br><$comeff(1,1)><$motion(1,801)><$voicel(1,7)>Ah well, whatever. Time for a little break!
msgctxt "3255:86"
msgid "<$comeff(1,10)><$motion(1,814)><$voicel(1,9)>¡Scy, scy!<clear><br><$comeff(1,6)><$motion(1,803)><$voicel(1,5)>¿Y tú quién guadañas eres? ¿Querías algo, chic<gen;-2(o,a)>?<turn(1,60)><$lookat(1,0,1)><waitactor(1)><clear><br><$motion(1,806)><$voicel(1,6)>Perdona, pero antes tengo que terminar mi entrenamiento<br>de 100 cortes consecutivos.<clear><br><$comeff(1,10)><$motion(1,815)><$voicel(1,9)>¡Theeer! <wait(1.8)><$comeff(1,6)><$motion(1,807)>¿Cuántos llevo ya?... <wait(0.5)><$comeff(1,1)><$motion(1,801)><$voicel(1,7)>¡Bueno, es igual!<br>Habrá que descansar un poco."
msgstr ""

#. en: <$comeff(1,13)><$motion(1,827)><$voicel(1,10)>Om nom nom...bzzzt...chomp chomp...zap...<wait(0.3)><$facial(1,4)><$comeff(1,21)><$motion(1,801)><$voicel(1,9)> Ahhh,<br>nothing hits the spot like some nice sparks!<clear><br><$facial(1,1)><$comeff(1,6)><$motion(1,803)><$voicel(1,7)>Huh? Who’re you? Sorry, but I’m really hungry,<$comeff(1,14)><$motion(1,802)><$voicel(1,5)> so I’m not<br>splitting this electricity with you or anyone else!<slide><br><$comeff(1,6)><$motion(1,803)><$voicel(1,6)>Really? You can’t eat electricity?<clear><br><$comeff(1,10)><$motion(1,807)><$voicel(1,10)>Oh wow, that’s too bad! You’re missing out—it’s so tasty<br>and tingly!
msgctxt "3255:87"
msgid "<$comeff(1,13)><$motion(1,827)><$voicel(1,10)>Om, nom, nom, nom... Bzzzz... Ñam, ñam, ñam... Bzzzz...<clear><br><$facial(1,4)><$comeff(1,21)><$motion(1,801)><$voicel(1,9)>¡Buah, qué flipe la electricidad, está riquísima!<clear><br><$facial(1,1)><$comeff(1,6)><$motion(1,803)><$voicel(1,7)>¿Y tú quién eres? Lo siento, pero tengo mucha hambre y<br><$comeff(1,14)><$motion(1,802)><$voicel(1,5)>no pienso compartir mi electricidad.<clear><br><$comeff(1,6)><$motion(1,803)><$voicel(1,6)>¿Cómo que no comes \"de eso\"? <$comeff(1,10)><$motion(1,807)><$voicel(1,10)>Jua, no sabes lo que te<br>pierdes. ¡Ojalá pudieras probar su sabor electrizante!"
msgstr "<$comeff(1,13)><$motion(1,827)><$voicel(1,10)>Om, nom, nom, nom... Bzzzz... Ñam, ñam, ñam... Bzzzz...<clear><br><$facial(1,4)><$comeff(1,21)><$motion(1,801)><$voicel(1,9)>¡Guau, qué maravilla la electricidad, está riquísima!<clear><br><$facial(1,1)><$comeff(1,6)><$motion(1,803)><$voicel(1,7)>¿Y tú quién eres? Lo siento, pero tengo mucha hambre y<br><$comeff(1,14)><$motion(1,802)><$voicel(1,5)>no pienso compartir mi electricidad.<clear><br><$comeff(1,6)><$motion(1,803)><$voicel(1,6)>¿Cómo que no comes \"de eso\"? <$comeff(1,10)><$motion(1,807)><$voicel(1,10)>Jua, no sabes lo que te<br>pierdes. ¡Ojalá pudieras probar su sabor electrizante!"

#. en: <$facial(1,13)><$comeff(1,5)><$motion(1,803)><$voicel(1,8)>Fwah?! Uh, hi there...<clear><br><$motion(1,802)><$voicel(1,3)>I-it’s been a while since I’ve talked to anyone, and...<br>W-well, I’m getting really nervous, to be honest.<clear><br><$comeff(1,14)><$motion(1,806)><$voicel(1,5)>I feel like my heart’s about to jump out of my mouth...<clear><br><$voicel(1,7)><$motion(1,850)><$comcan(1)>FWOOM!<clear><br><$comeff(1,19)><$motion(1,807)><$voicel(1,4)>Oops!!! Sorry, sorry... Fire came out instead.<clear><br><$facial(1,4)><$comeff(1,21)><$motion(1,803)><$voicel(1,5)>I’d be so happy if you’d come talk to me again, though!
msgctxt "3255:88"
msgid "<$facial(1,13)><$comeff(1,5)><$motion(1,803)><$voicel(1,8)>Mag, mag. Uy... Hola... <$motion(1,802)><$voicel(1,3)>Hacía mucho tiempo que no<br>hablaba con nadie...<clear><br><$comeff(1,14)><$motion(1,806)><$voicel(1,5)>Ay, ay, ay, ¡q-qué nervios!<clear><br><$voicel(1,7)><$motion(1,850)><$comcan(1)>¡Maaag!<clear><br><$comeff(1,19)><$motion(1,807)><$voicel(1,4)>Perdona... Cuando me altero se me escapa el fuego sin<br>querer... <$facial(1,4)><$comeff(1,21)><$motion(1,803)><$voicel(1,5)>Uf, espero que nos llevemos bien... Hasta otra."
msgstr ""

#. en: <$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,10)>Hehehe. Now that sure is nice...<clear><br><$comeff(1,13)><$motion(1,801)><$voicel(1,9)>My horns are shinin’ brighter than ever today!<clear><br><$facial(1,1)><$comeff(1,6)><$motion(1,827)><$voicel(1,5)>You there! <$voicel(1,6)>You agree, don’t ya?<clear><br><$facial(1,4)><$comeff(1,9)><$motion(1,803)><$voicel(1,8)>Why, I bet the sight of my horns would give even ol’<br><$cdef(27)>Heracross</color> a right scare! <$comeff(1,10)><$motion(1,801)><$voicel(1,9)>Gahahaha!
msgctxt "3255:89"
msgid "<$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,10)>¡Je, je, je! Mira tú qué bien.<clear><br><$comeff(1,13)><$motion(1,801)><$voicel(1,9)>¡Hoy mi cornamenta tiene un lustre mayor de lo habitual!<clear><br><$facial(1,1)><$motion(1,827)><$voicel(1,5)>Mírala, mocit<gen;-2(o,a)>... <$voicel(1,6)><$comeff(1,6)>¿No estás de acuerdo conmigo?<clear><br><$facial(1,4)><$comeff(1,9)><$motion(1,803)><$voicel(1,8)>Si ese bribón de <$cdef(27)>Heracross </color>la viera, seguro que se llevaría<br>un susto de padre y muy señor mío... <$comeff(1,10)><$motion(1,801)><$voicel(1,9)>¡Bua, ja, ja!"
msgstr "<$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,10)>¡Je, je, je! Mira tú qué bien.<clear><br><$comeff(1,13)><$motion(1,801)><$voicel(1,9)>¡Hoy mi cornamenta tiene un lustre mayor de lo habitual!<clear><br><$facial(1,1)><$motion(1,827)><$voicel(1,5)>Mírala, mocit<gen;-2(o,a)>... <$voicel(1,6)><$comeff(1,6)>¿No estás de acuerdo conmigo?<clear><br><$facial(1,4)><$comeff(1,9)><$motion(1,803)><$voicel(1,8)>Si ese bribón de <$cdef(27)>Heracross </color>la viera, seguro que se llevaría<br>un susto de muerte... <$comeff(1,10)><$motion(1,801)><$voicel(1,9)>¡Bua, ja, ja!"

#. en: <$comeff(1,10)><$motion(1,801)><$voicel(1,10)>*flop* *flop flop* <wait(1.2)>*flop* <$comeff(1,5)>Oh! Sorry, yo!<clear><br><$facial(1,4)><$comeff(1,1)><$voicel(1,8)>I was so busy flippin’ and floppin’ that I forgot to<br>greet ya!<clear><br><$comeff(1,13)><$voicel(1,7)><$motion(1,816)>I don’t have a single redeeming quality, yo, but I sure<br>would like if we could be friends!<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,815)><$voicel(1,9)>Bee-tee-dubs, I flop around when I’m happy too!<br>*flop flop* <wait(0.25)><$comeff(1,10)>
msgctxt "3255:90"
msgid "<$comeff(1,10)><$motion(1,801)><$voicel(1,10)>¡Karp, karp!<wait(1.2)> Magi...<$comeff(1,5)> ¡Ay, perdona!<clear><br><$facial(1,4)><$comeff(1,1)><$voicel(1,8)>¡Estaba tan concentrad<gen;-3(o,a)> saltando que ni te he saludado!<clear><br><$comeff(1,13)><$voicel(1,7)><$motion(1,816)>Ojalá que nos llevemos bien, aunque no sé, tampoco es<br>que yo sea la leche.<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,815)><$voicel(1,9)>Eso sí, lo de saltar se me da bien, ¡sobre todo si estoy<br>content<gen;-3(o,a)>! ¡Karp, karp!<wait(0.25)><$comeff(1,10)>"
msgstr "<$comeff(1,10)><$motion(1,801)><$voicel(1,10)>¡Karp, karp!<wait(1.2)> Magi...<$comeff(1,5)> ¡Ay, perdona!<clear><br><$facial(1,4)><$comeff(1,1)><$voicel(1,8)>¡Estaba tan concentrad<gen;-3(o,a)> saltando que ni te saludé!<clear><br><$comeff(1,13)><$voicel(1,7)><$motion(1,816)>Ojalá que nos llevemos bien, aunque no sé, tampoco es<br>que yo sea gran cosa.<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,815)><$voicel(1,9)>Eso sí, lo de saltar se me da bien, ¡sobre todo si estoy<br>content<gen;-3(o,a)>! ¡Karp, karp!<wait(0.25)><$comeff(1,10)>"

#. en: <$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>*yaaawn* Now THAT was some good sleep, I tell you what!<br>...<wait(1.5)><$comeff(1,6)><$motion(1,803)><$voicel(1,6)>Hm?! Who’re YOU?!<clear><br><$motion(1,805)><$voicel(1,7)>Tryin’ to sneak attack me while I’m sleepin’, are ya?!<br><$comeff(1,10)><$facial(1,4)><$motion(1,802)><$voicel(1,10)>It’s been a while since I went on a proper rampage...<slide><br>Hoo yeah! Come at me! Bring it on!<clear><br><$comeff(1,6)><$facial(1,1)><$motion(1,805)><$voicel(1,6)>Oh wait...<clear><br><$comeff(1,1)><$motion(1,827)><$voicel(1,7)>Now that I take a good look around, I don’t see any<br>humans ’round these parts...<clear><br><$comeff(1,22)><$facial(1,7)><$motion(1,825)><$voicel(1,9)>Well, dang! That don’t make fer a very satisfyin’ rampage,<br>now does it? We’ll have to tussle some other time!
msgctxt "3255:91"
msgid "<$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Gyaaa... ¡Madre mía, he dormido como un ceporro!<br>... <wait(1.5)><$comeff(1,6)><$motion(1,803)><$voicel(1,6)>¿Eh? ¿Y qué se te ha perdido a ti por aquí?<clear><br><$motion(1,805)><$voicel(1,7)>¿No estarías tramando atacarme a traición aprovechando<br>que estaba durmiendo tan ricamente?<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,802)><$voicel(1,10)>¡Pues así sea! Hacía un tiempecito que no me desbocaba,<br>así que no hay mal que por bien no venga.<clear><br><$comeff(1,6)><$facial(1,1)><$motion(1,805)><$voicel(1,6)>Uy, pero espera un momento...<clear><br><$comeff(1,1)><$motion(1,827)><$voicel(1,7)>Bien mirado, por esta zona no hay ni rastro de seres<br>humanos, ¿no? Pues entonces no merece ni la pena.<clear><br><$comeff(1,22)><$facial(1,7)><$motion(1,825)><$voicel(1,9)>Aquí imperaría la máxima \"El que se desboca se equivoca\".<br>¡Arrasar por arrasar es tontería!"
msgstr "<$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Gyaaa... ¡Cielos, dormí como un tronco!<br>... <wait(1.5)><$comeff(1,6)><$motion(1,803)><$voicel(1,6)>¿Eh? ¿Y qué se te perdió a ti por aquí?<clear><br><$motion(1,805)><$voicel(1,7)>¿No estarías tramando atacarme a traición aprovechando<br>que estaba durmiendo tan ricamente?<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,802)><$voicel(1,10)>¡Pues así sea! Hacía un tiempito que no me desbocaba,<br>así que no hay mal que por bien no venga.<clear><br><$comeff(1,6)><$facial(1,1)><$motion(1,805)><$voicel(1,6)>Uy, pero espera un momento...<clear><br><$comeff(1,1)><$motion(1,827)><$voicel(1,7)>Bien mirado, por esta zona no hay ni rastro de seres<br>humanos, ¿no? Pues entonces no vale ni la pena.<clear><br><$comeff(1,22)><$facial(1,7)><$motion(1,825)><$voicel(1,9)>Aquí imperaría la máxima \"El que se desboca se equivoca\".<br>¡Arrasar por arrasar es tontería!"

#. en: <$comeff(1,14)><$voicel(1,5)>Hm...<wait(0.8)><$motion(1,801)><$comeff(1,3)><$motion(1,803)> That’s certainly a...unique appearance, isn’t it?<br><$comeff(1,9)><$facial(1,4)><$motion(1,805)><$voicel(1,9)>Why, you look just like a human!<clear><br><$facial(1,1)><$voicel(1,9)>You know...<wait(1.3)>I was once quite close friends with a human<br><$motion(1,806)><$voicel(1,9)>who rode on my back as we traveled together.<slide><br><$facial(1,4)><$motion(1,801)><$voicel(1,7)><$comeff(1,9)>Oh, what fun we had!
msgctxt "3255:92"
msgid "<$comeff(1,14)><$voicel(1,5)>Vaya... <wait(0.8)><$motion(1,801)><$comeff(1,3)><$motion(1,803)>Tienes un aspecto la mar de extraño, peque.<br><$comeff(1,9)><$facial(1,4)><$motion(1,805)><$voicel(1,9)>Te pareces muchísimo a <gen;-2(un,una)> human<gen;-2(o,a)>...<clear><br><$facial(1,1)><$voicel(1,9)>Ay... <wait(1.3)>¿Sabes? Yo antes también tenía un humano al que<br>apreciaba con todo mi corazón.<clear><br><$motion(1,806)><$voicel(1,9)>Le gustaba subirse a mi lomo y juntos viajábamos de aquí<br>para allá... <$facial(1,4)><$motion(1,801)><$voicel(1,7)><$comeff(1,9)>Ay, qué recuerdos..."
msgstr "<$comeff(1,14)><$voicel(1,5)>Vaya... <wait(0.8)><$motion(1,801)><$comeff(1,3)><$motion(1,803)>Tienes un aspecto de lo más extraño, peque.<br><$comeff(1,9)><$facial(1,4)><$motion(1,805)><$voicel(1,9)>Te pareces muchísimo a <gen;-2(un,una)> human<gen;-2(o,a)>...<clear><br><$facial(1,1)><$voicel(1,9)>Ay... <wait(1.3)>¿Sabes? Yo antes también tenía un humano al que<br>apreciaba con todo mi corazón.<clear><br><$motion(1,806)><$voicel(1,9)>Le gustaba subirse a mi lomo y juntos viajábamos de aquí<br>para allá... <$facial(1,4)><$motion(1,801)><$voicel(1,7)><$comeff(1,9)>Ay, qué recuerdos..."

#. en: <$comeff(1,10)><$facial(1,4)><$motionoff(1,804)><$voicel(1,10)>Oh! Hello there! Do you live around here?<clear><br><$comeff(1,13)><$facial(1,1)><$motion(1,806)><$voicel(1,8)>I tell ya, this really does seem like a great place to live!<clear><br><$comeff(1,10)><$facial(1,14)><$motion(1,805)><$voicel(1,7)>If there’s a flower garden, I wanna sunbathe in it. If there’s<br>a pretty ocean, I wanna swim in it! <$comeff(1,21)><$facial(1,5)><$motion(1,801)><$voicel(1,9)>Oooh, and...<slide><br>I even bet going on night walks would be fun!
msgctxt "3255:93"
msgid "<$comeff(1,10)><$facial(1,4)><$motionoff(1,804)><$voicel(1,10)>¡Hola! ¿Eres de por aquí?<clear><br><$comeff(1,13)><$facial(1,1)><$motion(1,806)><$voicel(1,8)>¡Este lugar parece estupendo! Tiene pinta de que<br>me lo pasaré muy bien si me mudo aquí.<clear><br><$comeff(1,10)><$facial(1,14)><$motion(1,805)><$voicel(1,7)>Podría tomar el sol entre las flores, chapotear en el mar,<br>dar paseos nocturnos... <$comeff(1,21)><$facial(1,5)><$motion(1,801)><$voicel(1,9)>¡Todo suena genial!"
msgstr "<$comeff(1,10)><$facial(1,4)><$motionoff(1,804)><$voicel(1,10)>¡Hola! ¿Eres de por aquí?<clear><br><$comeff(1,13)><$facial(1,1)><$motion(1,806)><$voicel(1,8)>¡Este lugar parece estupendo! Parece que<br>me la pasaré muy bien si me mudo aquí.<clear><br><$comeff(1,10)><$facial(1,14)><$motion(1,805)><$voicel(1,7)>Podría tomar el sol entre las flores, chapotear en el mar,<br>dar paseos nocturnos... <$comeff(1,21)><$facial(1,5)><$motion(1,801)><$voicel(1,9)>¡Todo suena genial!"

#. en: <$comeff(1,1)><$motion(1,803)><$voicel(1,8)>Hey, nice to meet you. This place has a great vibe, huh?<clear><br><$voicel(1,6)><$comeff(1,14)>All it needs is...<wait(1.2)><$comeff(1,9)>a little more moisture, maybe?<turn(1,50)><$lookat(1,0,1)><waitactor(1)><$motion(1,816)><wait(1.3)><turn(0,310)><waitactor(0)><$motion(0,748)><wait(1.2)><$comeff(1,5)><$lookat(1,1,0)><waitactor(1)><clear><br><$voicel(1,8)>Whoa! <wait(1.2)><$comeff(1,3)><$motion(1,824)><$voicel(1,10)>You startled me.<$lookat(0,1,1)><waitactor(0)><clear><br><$comeff(1,10)><$motion(1,806)><$voicel(1,5)>But hey, thanks for the extra moisture. That was kind of ya.<br><$comeff(1,21)><$motion(1,801)><$voicel(1,7)>I hope you and I can be great friends.
msgctxt "3255:94"
msgid "<$comeff(1,1)><$motion(1,803)><$voicel(1,8)>Hola. Qué sitio más chulo, ¿no?<br><$voicel(1,6)><$comeff(1,14)>Aunque... <wait(1.2)><$comeff(1,9)>para mi gusto, le falta un poco de humedad...<turn(1,50)><$lookat(1,0,1)><waitactor(1)><$motion(1,816)><wait(1.3)><turn(0,310)><waitactor(0)><$motion(0,748)><wait(1.2)><$comeff(1,5)><$lookat(1,1,0)><waitactor(1)><clear><br><$voicel(1,8)>¡Hala! <wait(1.2)><$comeff(1,3)><$motion(1,824)><$voicel(1,10)>¡Qué susto!<$lookat(0,1,1)><waitactor(0)><clear><br><$comeff(1,10)><$motion(1,806)><$voicel(1,5)>Ahora ya de humedad ni tan mal. <$comeff(1,21)><$motion(1,801)><$voicel(1,7)>Gracias.<br>A ver si nos vemos por ahí."
msgstr "<$comeff(1,1)><$motion(1,803)><$voicel(1,8)>Hola. Qué lugar tan bonito, ¿no?<br><$voicel(1,6)><$comeff(1,14)>Aunque... <wait(1.2)><$comeff(1,9)>para mi gusto, le falta un poco de humedad...<turn(1,50)><$lookat(1,0,1)><waitactor(1)><$motion(1,816)><wait(1.3)><turn(0,310)><waitactor(0)><$motion(0,748)><wait(1.2)><$comeff(1,5)><$lookat(1,1,0)><waitactor(1)><clear><br><$voicel(1,8)>¡Guau! <wait(1.2)><$comeff(1,3)><$motion(1,824)><$voicel(1,10)>¡Qué susto!<$lookat(0,1,1)><waitactor(0)><clear><br><$comeff(1,10)><$motion(1,806)><$voicel(1,5)>Ahora ya de humedad ni tan mal. <$comeff(1,21)><$motion(1,801)><$voicel(1,7)>Gracias.<br>A ver si nos vemos por ahí."

#. en: <$comeff(1,5)><$facial(1,13)><$motionoff(1,804)><$voicel(1,10)>Whoa! That gave me a jolt.<clear><br><$comeff(1,23)><$facial(1,9)><$motion(1,802)><$voicel(1,7)>Don’t spark up a conversation with me outta nowhere like<br>that, OK? I may not look it, but I’m pretty jumpy.<clear><br><$facial(1,1)><$comeff(1,1)><$motion(1,803)><$voicel(1,8)>Oh, and be EXTRA careful around me in bad weather!<clear><br><$comeff(1,10)><$motion(1,805)><$voicel(1,7)>’Cause if I cry out in surprise, sometimes lightning will<br>come shooting down in a flash!<clear><br><$facial(1,4)><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>And then the sound of the lightning will startle me so<br>much that I cry out AGAIN!
msgctxt "3255:95"
msgid "<$comeff(1,5)><$facial(1,13)><$motionoff(1,804)><$voicel(1,10)>¡Joool! ¡Ay, qué susto, tú!<clear><br><$comeff(1,23)><$facial(1,9)><$motion(1,802)><$voicel(1,7)>¡No me hables así, tan de sopetón, que me va a dar algo!<br>Igual no lo parece, pero en realidad soy un poco miedica.<clear><br><$facial(1,1)><$comeff(1,1)><$motion(1,803)><$voicel(1,8)>Así que ya puedes tener cuidado cuando haga mal tiempo,<br><$comeff(1,10)><$motion(1,805)><$voicel(1,7)>porque como me des un susto y me hagas gritar sin querer,<slide><br>igual te cae un rayo en la cabeza.<clear><br><$facial(1,4)><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Y con el ruido del rayo, quizá me asusto y vuelvo a gritar,<br>¡así que ojo!"
msgstr "<$comeff(1,5)><$facial(1,13)><$motionoff(1,804)><$voicel(1,10)>¡Joool! ¡Ay, qué susto, tú!<clear><br><$comeff(1,23)><$facial(1,9)><$motion(1,802)><$voicel(1,7)>¡No me hables así, tan de sopetón, que me va a dar algo!<br>Tal vez no lo parezca, pero en realidad me asusto fácilmente.<clear><br><$facial(1,1)><$comeff(1,1)><$motion(1,803)><$voicel(1,8)>Así que más vale que tengas cuidado cuando haga mal tiempo,<br><$comeff(1,10)><$motion(1,805)><$voicel(1,7)>porque como me des un susto y me hagas gritar sin querer,<slide><br>a lo mejor te cae un rayo en la cabeza.<clear><br><$facial(1,4)><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Y con el ruido del rayo, quizás me asusto y vuelvo a gritar,<br>¡así que ojo!"

#. en: <$comeff(1,13)><$motion(1,803)><$voicel(1,9)>Hey there! It’s SO great to meet you! It’s been a hot<br>minute since I’ve chatted with another Pokémon!<clear><br><$comeff(1,5)><$facial(1,4)><$motion(1,816)><$voicel(1,7)>Oh! How about this—can we be friends? I mean,<br>why not, right?<clear><br><$comeff(1,10)><$motion(1,801)><$voicel(1,10)>Hee hee, I’m so hyped, I can feel the flames burning<br>inside my body!<clear><br><$comeff(1,14)>...<wait(1.2)><$facial(1,1)><$motion(1,807)><$voicel(1,8)>Actually, it might be a little TOO hot.
msgctxt "3255:96"
msgid "<$comeff(1,13)><$motion(1,803)><$voicel(1,9)>¡Holaaa! ¡Hacía siglos que no hablaba con otro Pokémon!<clear><br><$comeff(1,5)><$facial(1,4)><$motion(1,816)><$voicel(1,7)>Oye, ¿a que te mueres por ser mi amig<gen;-2(o,a)>? ¿A que sí?<clear><br><$comeff(1,10)><$motion(1,801)><$voicel(1,10)>¡Uf, qué subidón! ¡Estoy que ardo por dentro, literalmente!<br>Jaaa, ja, ja. ¡Qué buen<gen;-3(o,a)> que soy! ¡Me parto yo sol<gen;-3(o,a)>!<clear><br><$comeff(1,14)>... <wait(1.2)><$facial(1,1)><$motion(1,807)><$voicel(1,8)>¿Demasiado intens<gen;-3(o,a)>, quizá?"
msgstr "<$comeff(1,13)><$motion(1,803)><$voicel(1,9)>¡Holaaa! ¡Hacía siglos que no hablaba con otro Pokémon!<clear><br><$comeff(1,5)><$facial(1,4)><$motion(1,816)><$voicel(1,7)>Oye, te mueres por ser mi amig<gen;-2(o,a)>, ¿verdad? ¿Verdad que sí?<clear><br><$comeff(1,10)><$motion(1,801)><$voicel(1,10)>¡Uf, qué emoción! ¡Estoy que ardo por dentro, literalmente!<br>Jaaa, ja, ja. ¡Qué buen<gen;-3(o,a)> que soy! ¡Me río yo sol<gen;-3(o,a)>!<clear><br><$comeff(1,14)>... <wait(1.2)><$facial(1,1)><$motion(1,807)><$voicel(1,8)>¿Demasiado intens<gen;-3(o,a)>, quizás?"

#. en: <$comeff(1,14)><$voicel(1,6)><$motionoff(1,805)>Jagjag. <wait(1.8)><$voicel(1,7)><$comeff(1,6)><$motionoff(1,803)>Hmmm? This place. Where am I?<clear><br><$comeff(1,1)><$voicel(1,5)>It is you who called me to this place?<clear><br><$motionoff(1,806)><$facial(1,13)><$voicel(1,7)>I grew inside a computer.<clear><br><$comeff(1,13)><$motionoff(1,801)><$facial(1,4)><$voicel(1,9)>So the large sky here is very much novel!
msgctxt "3255:97"
msgid "<$comeff(1,14)><$voicel(1,6)><$motionoff(1,805)>Gon, gon... <wait(1.8)><$voicel(1,7)><$comeff(1,6)><$motionoff(1,803)>¿Dónde estoy?<clear><br><$comeff(1,1)><$voicel(1,5)>¿Me has convocado tú?<clear><br><$motionoff(1,806)><$facial(1,13)><$voicel(1,7)>Fui concebido dentro de un ordenador...<clear><br><$comeff(1,13)><$motionoff(1,801)><$facial(1,4)><$voicel(1,9)>¡Ver este gran cielo es una sensación muy novedosa!"
msgstr "<$comeff(1,14)><$voicel(1,6)><$motionoff(1,805)>Gon, gon... <wait(1.8)><$voicel(1,7)><$comeff(1,6)><$motionoff(1,803)>¿Dónde estoy?<clear><br><$comeff(1,1)><$voicel(1,5)>¿Me convocaste tú?<clear><br><$motionoff(1,806)><$facial(1,13)><$voicel(1,7)>Fui concebido dentro de una computadora...<clear><br><$comeff(1,13)><$motionoff(1,801)><$facial(1,4)><$voicel(1,9)>¡Ver este gran cielo es una sensación muy novedosa!"

#. en: <$comeff(1,6)><$motion(1,803)><$voicel(1,7)>Hm? And who might you be? You live ’round<br>these parts?<clear><br><$comeff(1,10)><$motion(1,806)><$voicel(1,7)>Guess that makes us neighbors, then! I’m quite fond o’<br>this place myself.<clear><br><$comeff(1,14)><$motion(1,805)><$voicel(1,7)>The air here feels familiar, y’see? Almost like I’ve been<br>breathin’ it for ages! <$comeff(1,13)><$motion(1,801)><$voicel(1,7)>Real curious, I tell you what!
msgctxt "3255:98"
msgid "<$comeff(1,6)><$motion(1,803)><$voicel(1,7)>¿Dactyl? ¿Y tú quién vendrías a ser, si puede saberse?<br>¿Vives por estos lares, jovenzuel<gen;-2(o,a)>?<clear><br><$comeff(1,10)><$motion(1,806)><$voicel(1,7)>Pues yo a este sitio le tengo mucho cariño, ¡que conste!<br>Que de <gen;-3(buen,buena)> vecin<gen;-3(o,a)> es ser agradecid<gen;-3(o,a)>.<clear><br><$comeff(1,14)><$motion(1,805)><$voicel(1,7)>Por alguna razón, el aire de por aquí me resulta familiar,<br>como si lo llevara respirando desde la era de Maricastaña.<slide><br><$comeff(1,13)><$motion(1,801)><$voicel(1,7)>¡Es bien curioso!"
msgstr "<$comeff(1,6)><$motion(1,803)><$voicel(1,7)>¿Dactyl? ¿Y tú quién vendrías a ser, si puede saberse?<br>¿Vives por estos lares, jovenzuel<gen;-2(o,a)>?<clear><br><$comeff(1,10)><$motion(1,806)><$voicel(1,7)>Pues yo a este lugar le tengo mucho cariño, ¡que conste!<br>Que de <gen;-3(buen,buena)> vecin<gen;-3(o,a)> es ser agradecid<gen;-3(o,a)>.<clear><br><$comeff(1,14)><$motion(1,805)><$voicel(1,7)>Por alguna razón, el aire de por aquí me resulta familiar,<br>como si lo llevara respirando desde hace siglos.<slide><br><$comeff(1,13)><$motion(1,801)><$voicel(1,7)>¡Es bien curioso!"

#. en: <$comeff(1,16)><$motionoff(1,804)><$voicel(1,5)>*yaaaaaaaaawn*... <wait(0.8)><$comeff(1,15)>*grumble grumble*<clear><br><$voicel(1,10)>... ... ...Snoooooorrr...<br>... ... ...<wait(0.8)><$comeff(1,5)><$voicel(1,8)><$motion(1,803)>LAX!<clear><br><$comeff(1,6)><$motion(1,805)><$voicel(1,5)>Hnnnf? Wha—? Oh... I thought I was eating some yummy<br>fooood, <$comeff(1,7)><$motion(1,802)><$voicel(1,4)>but I guess it was just a dreeeaaam...<clear><br><$emotion(1,29)><$voicel(1,6)>Huh? Oh, hi... How looong have you been there?<clear><br><$emotion(1,38)><$voicel(1,10)>Well, I guess it doesn’t maaatter...
msgctxt "3255:99"
msgid "<$comeff(1,16)><$motionoff(1,804)><$voicel(1,5)>Uaaaaaaaaah... <wait(0.8)><$comeff(1,15)>Zzz...<clear><br><$voicel(1,10)>Grrr... Ñam, ñam, ñam...<wait(0.8)><$comeff(1,5)><$voicel(1,8)><$motion(1,803)> ¡¡Lax!!<clear><br><$comeff(1,6)><$motion(1,805)><$voicel(1,5)>¿Eh? Retruécanos... Estaba saboreando una comida<br>deliciosa, pero... resulta que no era más que un sueño...<slide><br><$comeff(1,7)><$motion(1,802)><$voicel(1,4)>Menudo chasco...<clear><br><$emotion(1,29)><$voicel(1,6)>¿Eh? ¿Y tú... cuánto rato llevas ahí? <wait(0.4)><$emotion(1,38)><$voicel(1,10)>Bueno, tanto da,<br>cada uno a lo suyo."
msgstr "<$comeff(1,16)><$motionoff(1,804)><$voicel(1,5)>Uaaaaaaaaah... <wait(0.8)><$comeff(1,15)>Zzz...<clear><br><$voicel(1,10)>Grrr... Ñam, ñam, ñam...<wait(0.8)><$comeff(1,5)><$voicel(1,8)><$motion(1,803)> ¡¡Lax!!<clear><br><$comeff(1,6)><$motion(1,805)><$voicel(1,5)>¿Eh? Retruécanos... Estaba saboreando una comida<br>deliciosa, pero... resulta que no era más que un sueño...<slide><br><$comeff(1,7)><$motion(1,802)><$voicel(1,4)>Qué chasco...<clear><br><$emotion(1,29)><$voicel(1,6)>¿Eh? ¿Y tú... cuánto rato llevas ahí? <wait(0.4)><$emotion(1,38)><$voicel(1,10)>Bueno, da igual,<br>cada uno a lo suyo."

#. en: <$motion(1,804)><$comeff(1,5)>Gyaoo!<wait(1.4)><clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,805)>My goodness... You made this building for me?<clear><br><$voicel(1,7)><$emotion(1,39)>It’s so wonderfully chilly and comfortable. Ahh, this really<br>reminds me of where I used to live long ago!<clear><br><$voicel(1,5)><$comeff(1,10)><$motion(1,805)>Gracious, it must have been an awful lot of work to make<br>something so enormous. <$voicel(1,8)><$motion(1,803)><$comeff(1,9)>Thank you so much for<slide><br>putting in all that effort!
msgctxt "3255:100"
msgid "<$motion(1,804)><$comeff(1,5)>¡Artiii!<wait(1.4)><clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,805)>Vaya... De modo que has sido tú quien ha construido<br>esta estructura. Qué gran proeza...<clear><br><$voicel(1,7)><$emotion(1,39)>Es un lugar muy cómodo. El frescor que se respira aquí<br>me trae recuerdos de mi antiguo hogar...<clear><br><$voicel(1,5)><$comeff(1,10)><$motion(1,805)>No ha debido de ser nada fácil erigir algo de tal<br>magnitud.<clear><br><$voicel(1,8)><$motion(1,803)><$comeff(1,9)>¡Tienes mi más sincera gratitud!"
msgstr "<$motion(1,804)><$comeff(1,5)>¡Artiii!<wait(1.4)><clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,805)>Vaya... De modo que fuiste tú quien construyó<br>esta estructura. Qué gran proeza...<clear><br><$voicel(1,7)><$emotion(1,39)>Es un lugar muy cómodo. El frescor que se respira aquí<br>me trae recuerdos de mi antiguo hogar...<clear><br><$voicel(1,5)><$comeff(1,10)><$motion(1,805)>No debió de ser nada fácil erigir algo de tal<br>magnitud.<clear><br><$voicel(1,8)><$motion(1,803)><$comeff(1,9)>¡Tienes mi más sincera gratitud!"

#. en: <$voicel(1,7)><$motion(1,859)><$textsize(2)>BZZZ-ZAP-ZAP-ZAP!</textsize><clear><br><$voicel(1,9)><$emotion(1,38)>Kwaaa, that jolted me right awake!<clear><br><$lookat(1,0,0)><$voicel(1,5)><$comeff(1,5)><$motion(1,807)>You made this spot? Nice work! Real energizin’ stuff.
msgctxt "3255:104"
msgid "<$voicel(1,7)><$motion(1,859)><$textsize(2)>¡Zap! ¡Zap, zaaap!</textsize><clear><br><$voicel(1,9)><$emotion(1,38)>¡Jua, jua! ¡Nada como una buena descarga para despertar!<clear><br><$lookat(1,0,0)><$voicel(1,5)><$comeff(1,5)><$motion(1,807)>¿Has construido tú esto? ¡Buaaah, flipo contigo!"
msgstr "<$voicel(1,7)><$motion(1,859)><$textsize(2)>¡Zap! ¡Zap, zaaap!</textsize><clear><br><$voicel(1,9)><$emotion(1,38)>¡Jua, jua! ¡Nada como una buena descarga para despertar!<clear><br><$lookat(1,0,0)><$voicel(1,5)><$comeff(1,5)><$motion(1,807)>¿Construiste tú esto? ¡Guaaau, eres increíble!"

#. en: <$voicel(1,7)><$comeff(1,14)><$motion(1,803)>Hm? And jus’ who’re you? Can’t a Pokémon have a nice<br>time relaxin’ in a volcano without—<wait(1.0)><$motion(0,824)><wait(1.0)><$motion(0,652)><wait(0.5)><clear><br><$voicel(1,6)><$comeff(1,5)><$motion(1,801)>What’s that, now? YOU made this place?<clear><br><$voicel(1,7)><$comeff(1,9)><$motionoff(1,804)>Well, why didn’t ya say so?! I gotta give ya my<br>thanks, then!<clear><br><$voicel(1,5)><$motion(1,666)><$comeff(1,3)>Sorry fer the staredown earlier—nothin’ personal!
msgctxt "3255:108"
msgid "<$voicel(1,7)><$comeff(1,14)><$motion(1,803)>Hmm... ¿Se puede saber quién corchos anda ahí?<br>Mira que interrumpir mi siestecilla en el volcán. Mol...<wait(1.0)><$motion(0,824)><wait(1.0)><$motion(0,652)><wait(0.5)><clear><br><$voicel(1,6)><$comeff(1,5)><$motion(1,801)>¿Cómo dices? ¿Que todo esto... lo has construido tú?<br><$voicel(1,7)><$comeff(1,9)><$motionoff(1,804)>¡Córcholis! En tal caso, ¿cómo puedo darte las gracias?<clear><br><$voicel(1,5)><$motion(1,666)><$comeff(1,3)>Mis disculpas por ponerme gruñ<gen;-3(ón,ona)> cuando te he visto.<br>¡Espero que no me lo tengas en cuenta!"
msgstr "<$voicel(1,7)><$comeff(1,14)><$motion(1,803)>Hmm... ¿Se puede saber quién corchos anda ahí?<br>Mira que interrumpir mi siestita en el volcán. Mol...<wait(1.0)><$motion(0,824)><wait(1.0)><$motion(0,652)><wait(0.5)><clear><br><$voicel(1,6)><$comeff(1,5)><$motion(1,801)>¿Cómo dices? ¿Que todo esto... lo construiste tú?<br><$voicel(1,7)><$comeff(1,9)><$motionoff(1,804)>¡Córcholis! En tal caso, ¿cómo puedo darte las gracias?<clear><br><$voicel(1,5)><$motion(1,666)><$comeff(1,3)>Mis disculpas por ponerme gruñ<gen;-3(ón,ona)> cuando te vi.<br>¡Espero que no me lo tengas en cuenta!"

#. en: <$comeff(1,21)><$motion(1,801)><$voicel(1,9)>Whoa! You’re like, the perfect size!<clear><br><$comeff(1,14)><$motion(1,806)><$voicel(1,8)>Umm... I’m working hard every day to make sure I grow up<br>big and strong.<clear><br><$comeff(1,13)><$motion(1,807)><$voicel(1,7)>I wanna use your height as my goal, so let’s be buddies<br>from now on, OK?<clear><br><$comeff(1,5)><$motion(1,804)>Huh? Wait a sec... Can you make yourself as big as you<br>want when you transform?<clear><br><$comeff(1,19)><$motion(1,802)><$voicel(1,3)>For real?! Ughhh, I’ve shed my skin SO many times already,<br>and I’m STILL only this size. <$comeff(1,6)><$motion(1,803)><$voicel(1,8)>It’s totally unfair, right?
msgctxt "3255:112"
msgid "<$comeff(1,21)><$motion(1,801)><$voicel(1,9)>¡Hala, qué grande eres!<clear><br><$comeff(1,14)><$motion(1,806)><$voicel(1,8)>Verás, es que... lo que más quiero en este mundo es<br>hacerme más grande.<clear><br><$comeff(1,13)><$motion(1,807)><$voicel(1,7)>Ahora que te he visto, creo que mi meta podría ser<br>alcanzar tu tamaño, así que... i-igual podría ser tu amig<gen;-3(o,a)>...<clear><br><$comeff(1,5)><$motion(1,804)>¿Cómo? ¿Que te puedes transformar y ser del tamaño<br>que tú quieras? No me digas...<clear><br><$comeff(1,19)><$motion(1,802)><$voicel(1,3)>Y yo que me paso el día esforzándome en mudar de piel<br>para crecer poco a poco... <$comeff(1,6)><$motion(1,803)><$voicel(1,8)>¿No te parece superinjusto?"
msgstr "<$comeff(1,21)><$motion(1,801)><$voicel(1,9)>¡Guau, qué grande eres!<clear><br><$comeff(1,14)><$motion(1,806)><$voicel(1,8)>Verás, es que... lo que más quiero en este mundo es<br>hacerme más grande.<clear><br><$comeff(1,13)><$motion(1,807)><$voicel(1,7)>Ahora que te vi, creo que mi meta podría ser<br>alcanzar tu tamaño, así que... t-tal vez podría ser tu amig<gen;-3(o,a)>...<clear><br><$comeff(1,5)><$motion(1,804)>¿Cómo? ¿Que te puedes transformar y ser del tamaño<br>que tú quieras? No me digas...<clear><br><$comeff(1,19)><$motion(1,802)><$voicel(1,3)>Y yo que me paso el día esforzándome en mudar de piel<br>para crecer poco a poco... <$comeff(1,6)><$motion(1,803)><$voicel(1,8)>¿No te parece superinjusto?"

#. en: <$voicel(1,8)><$emotion(1,14)>Oh, hi. Nice to meet you.<clear><br><$voicel(1,5)><$motion(1,805)><$comeff(1,21)><$facial(1,4)>I was just enjoying this space... It’s so comfortable, don’t<br>you think?<clear><br><$voicel(1,4)><$comeff(1,17)><$facial(1,4)><$motion(1,806)>I bet it’s absolutely perfect on nice days...<clear><br><$facial(1,1)><$motion(0,824)><wait(1.0)><$motion(0,652)><wait(0.7)><$voicel(1,7)><$comeff(1,5)><$motion(1,803)>What? You made all this? Wow, that’s really cool!<br><$voicel(1,7)><$emotion(1,8)>I was thinking about living here, so...I hope we get along!
msgctxt "3255:113"
msgid "<$voicel(1,8)><$emotion(1,14)>Oh, h-hola, encantad<gen;-3(o,a)>...<clear><br><$voicel(1,5)><$motion(1,805)><$comeff(1,21)><$facial(1,4)>Este lugar parece muy apacible y tiene muy buen<br>ambiente...<clear><br><$voicel(1,4)><$comeff(1,17)><$facial(1,4)><$motion(1,806)>Qué alivio... Seguro que, cuando hace buen tiempo,<br>da mucho gusto estar aquí.<wait(1.0)><$facial(1,1)><$motion(0,824)><wait(1.0)><$motion(0,652)><wait(0.7)><clear><br><$voicel(1,7)><$comeff(1,5)><$motion(1,803)>Oh, ¿dices que lo has preparado tú? Hala...<clear><br><$voicel(1,7)><$emotion(1,8)>P-pues tengo pensado quedarme a vivir aquí, así que<br>espero que nos llevemos bien."
msgstr "<$voicel(1,8)><$emotion(1,14)>Oh, h-hola, encantad<gen;-3(o,a)>...<clear><br><$voicel(1,5)><$motion(1,805)><$comeff(1,21)><$facial(1,4)>Este lugar parece muy apacible y tiene muy buen<br>ambiente...<clear><br><$voicel(1,4)><$comeff(1,17)><$facial(1,4)><$motion(1,806)>Qué alivio... Seguro que, cuando hace buen tiempo,<br>da mucho gusto estar aquí.<wait(1.0)><$facial(1,1)><$motion(0,824)><wait(1.0)><$motion(0,652)><wait(0.7)><clear><br><$voicel(1,7)><$comeff(1,5)><$motion(1,803)>Oh, ¿dices que lo preparaste tú? Guau...<clear><br><$voicel(1,7)><$emotion(1,8)>P-pues tengo pensado quedarme a vivir aquí, así que<br>espero que nos llevemos bien."

#. en: <$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>*yaaawn* That was a goooood sleep.<clear><br>...<wait(0.8)><$comeff(1,5)><$facial(1,1)><$motion(1,805)><$voicel(1,7)>Oh, hello there. Where did yooouuu come from?<br><$facial(1,4)>...<wait(0.8)><$comeff(1,15)><$voicel(1,4)>*snore*<clear><br>...<wait(0.8)><$comeff(1,5)><$facial(1,13)><$motion(1,803)><$voicel(1,8)>Huh? Wha—?! <wait(0.8)><$voicel(1,7)><$facial(1,1)>Oh... I’m so sorryyy.<clear><br><$comeff(1,10)><$facial(1,4)><$voicel(1,9)>It’s just so niiice here that I keep nodding off.<clear><br><$facial(1,1)><$voicel(1,8)>What? You made this home? <$voicel(1,7)><$facial(1,4)><$comeff(1,21)><$motionoff(1,804)>Wooow!<clear><br><$comeff(1,13)><$motion(1,807)><$voicel(1,9)>I feel like I could fly fooorever if I just get in a good sleep<br>here. <$comeff(1,15)><$motion(1,801)><$voicel(1,3)>*yaaawn*
msgctxt "3255:114"
msgid "<$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Niiite... ¡Qué siestón más reparador!<clear><br>...<wait(0.8)><$comeff(1,5)><$facial(1,1)><$motion(1,805)><$voicel(1,7)> ¡Ay, holaaa! ¿Qué tal? ¿De dónde vienes tú?...<br><$facial(1,4)>... <wait(0.8)><$comeff(1,15)><$voicel(1,4)>Zzz...<clear><br>... <wait(0.8)><$comeff(1,5)><$facial(1,13)><$motion(1,803)><$voicel(1,8)>¡Ah! <wait(0.8)><$voicel(1,7)><$facial(1,1)>¡Ay, lo sientooo!<clear><br><$comeff(1,10)><$facial(1,4)><$voicel(1,9)>Es que se duerme tan a gustico aquí que, en cuanto me<br>quiero dar cuenta, ¡ya se me cierran los ojos otra vez!<clear><br><$facial(1,1)><$voicel(1,8)>¿Eh? ¿Que has sido tú quien ha preparado esta casica? <$voicel(1,7)><$facial(1,4)><$comeff(1,21)><$motionoff(1,804)><br>¡Qué maj<gen;-2(ooo,aaa)>!<clear><br><$comeff(1,13)><$motion(1,807)><$voicel(1,9)>Si duermo aquí como un tronco, ¡seguro que podré luego<br>volar hasta el fin del mundo! <$comeff(1,15)><$motion(1,801)><$voicel(1,3)>Niteee..."
msgstr "<$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Niiite... ¡Qué siestón más reparador!<clear><br>...<wait(0.8)><$comeff(1,5)><$facial(1,1)><$motion(1,805)><$voicel(1,7)> ¡Ay, holaaa! ¿Qué tal? ¿De dónde vienes tú?...<br><$facial(1,4)>... <wait(0.8)><$comeff(1,15)><$voicel(1,4)>Zzz...<clear><br>... <wait(0.8)><$comeff(1,5)><$facial(1,13)><$motion(1,803)><$voicel(1,8)>¡Ah! <wait(0.8)><$voicel(1,7)><$facial(1,1)>¡Ay, lo sientooo!<clear><br><$comeff(1,10)><$facial(1,4)><$voicel(1,9)>Es que se duerme tan a gustito aquí que, en cuanto me<br>quiero dar cuenta, ¡ya se me cierran los ojos otra vez!<clear><br><$facial(1,1)><$voicel(1,8)>¿Eh? ¿Que fuiste tú quien preparó esta casita? <$voicel(1,7)><$facial(1,4)><$comeff(1,21)><$motionoff(1,804)><br>¡Qué lind<gen;-2(ooo,aaa)>!<clear><br><$comeff(1,13)><$motion(1,807)><$voicel(1,9)>Si duermo aquí como un tronco, ¡seguro que podré luego<br>volar hasta el fin del mundo! <$comeff(1,15)><$motion(1,801)><$voicel(1,3)>Niteee..."

#. en: <$motionoff(1,804)><wait(0.5)><$voicel(1,8)><$comeff(1,5)>Mew!<clear><br><$voicel(1,5)><$emotion(1,14)>So we meet again. There must be some bond of fate<br>connecting us.<clear><br><$voicel(1,3)><$comeff(1,14)><$motion(1,805)>All the things you’ve seen. And the things you’ve yet to<br>build.<clear><br><$voicel(1,6)><$motion(1,801)>I’m interested in it all.<clear><br><$voicel(1,8)><$emotion(1,49)>I’d like to talk with you more.
msgctxt "3255:115"
msgid "<$motionoff(1,804)><wait(0.5)><$voicel(1,8)><$comeff(1,5)>¡Twooo!<clear><br><$voicel(1,5)><$emotion(1,14)>Esta es la segunda vez que tú y yo nos encontramos.<br>Se ve que el destino insiste en cruzar nuestros caminos.<clear><br><$voicel(1,3)><$comeff(1,14)><$motion(1,805)>Siento harta curiosidad por todas tus vivencias hasta<br>la fecha y por ver qué ases te guardas bajo la manga.<slide><br><$voicel(1,6)><$motion(1,801)>Quiero presenciarlo de cerca.<clear><br><$voicel(1,8)><$emotion(1,49)>Estoy segur<gen;-3(o,a)> de que podríamos mantener conversaciones<br>de lo más interesantes."
msgstr ""

#. en: <$voicel(1,5)><$comeff(1,16)><$motion(1,807)>*yaaawn* Dang—what a great nap!! Heya...you the one<br>who called me here?<$comcan(1)><$voicel(1,4)><$emotion(1,14)> You need me for somethin’?<$motion(0,824)><wait(1.0)><wait(0.8)><$motion(0,652)><wait(0.8)><clear><br><$voicel(1,5)><$comeff(1,6)><$motion(1,805)>Huh? You wanna be my friend?<clear><br><$voicel(1,7)><$emotion(1,8)>Ahaha—HECK YEAH! Let’s be buddies! Come chat<br>whenever you have time!
msgctxt "3255:116"
msgid "<$voicel(1,5)><$comeff(1,16)><$motion(1,807)>Uaaah... ¡He dormido como un tronco! Hmm... ¿Hm?<br>¿Has sido tú <gen;-2(el,la)> que me ha invocado? <wait(0.4)>¿Y qué quieres?<$comcan(1)><slide><br><$voicel(1,4)><$emotion(1,14)>¿Has venido a pedirme algo?<clear><br><$motion(0,824)><wait(1.0)><wait(0.8)><$motion(0,652)><wait(0.8)><$voicel(1,5)><$comeff(1,6)><$motion(1,805)>¿Cómo? <wait(0.4)>¿Que quieres ser mi amig<gen;-2(o,a)>?<clear><br><$voicel(1,7)><$emotion(1,8)>¡Ja, jaaa! ¡Me parece estupendo! ¡Pues habrá que hablar<br>por los codos para conocernos mejor!"
msgstr "<$voicel(1,5)><$comeff(1,16)><$motion(1,807)>Uaaah... ¡Dormí como un tronco! Hmm... ¿Hm?<br>¿Fuiste tú <gen;-2(el,la)> que me invocó? <wait(0.4)>¿Y qué quieres?<$comcan(1)><slide><br><$voicel(1,4)><$emotion(1,14)>¿Viniste a pedirme algo?<clear><br><$motion(0,824)><wait(1.0)><wait(0.8)><$motion(0,652)><wait(0.8)><$voicel(1,5)><$comeff(1,6)><$motion(1,805)>¿Cómo? <wait(0.4)>¿Que quieres ser mi amig<gen;-2(o,a)>?<clear><br><$voicel(1,7)><$emotion(1,8)>¡Ja, jaaa! ¡Me parece estupendo! ¡Pues habrá que hablar<br>por los codos para conocernos mejor!"

#. en: <$voicel(1,10)><$comeff(1,5)><$motion(1,816)><$facial(1,4)>CYAAA?!<clear><br><$voicel(1,3)><$comeff(1,4)><$motion(1,806)>Oh, sorry! You came outta nowhere.<clear><br><$voicel(1,5)><$motion(1,661)><$comeff(1,3)>But anyway, nice to meet you! I’ve never been here,<br>but it seems like a great place.<clear><br><$voicel(1,10)><$emotion(1,8)>And I can feel my flames burning strong!<clear><br><$voicel(1,7)><$emotion(1,49)>OK, that’s it—I’m gonna live here now!
msgctxt "3255:117"
msgid "<$voicel(1,10)><$comeff(1,5)><$motion(1,816)><$facial(1,4)>¡¡Quiiil!!<clear><br><$voicel(1,3)><$comeff(1,4)><$motion(1,806)>¡Ey, perdona! Vaya susto me he llevado.<clear><br><$voicel(1,5)><$motion(1,661)><$comeff(1,3)>En fin, que encantad<gen;-3(o,a)>. Acabo de llegar y ya me da la<br>impresión de que este sitio es GENIAL.<slide><br><$voicel(1,10)><$emotion(1,8)>¡Qué ganas de presumir de llamas!<clear><br><$voicel(1,7)><$emotion(1,49)>¡Ya sé! Voy a quedarme aquí a vivir, ¿vale?"
msgstr "<$voicel(1,10)><$comeff(1,5)><$motion(1,816)><$facial(1,4)>¡¡Quiiil!!<clear><br><$voicel(1,3)><$comeff(1,4)><$motion(1,806)>¡Ey, perdona! Vaya susto me llevé.<clear><br><$voicel(1,5)><$motion(1,661)><$comeff(1,3)>En fin, que encantad<gen;-3(o,a)>. Acabo de llegar y ya me da la<br>impresión de que este lugar es GENIAL.<slide><br><$voicel(1,10)><$emotion(1,8)>¡Qué ganas de presumir de llamas!<clear><br><$voicel(1,7)><$emotion(1,49)>¡Ya sé! Voy a quedarme aquí a vivir, ¿sí?"

#. en: <$comeff(1,5)><$motion(1,803)><$voicel(1,10)>Grrr! What’s your deal, pal?<clear><br><$comeff(1,10)><$voicel(1,9)>You here to take my home away? I’d like to see you try!<br><$motion(1,817)>GRRAAAAAAWRRR!<clear><br><$comeff(1,14)><$voicel(1,3)>Huh. Thought I was bein’ pretty menacing, but you didn’t<br>even flinch.<wait(0.8)><$comeff(1,6)><$motion(1,807)><$voicel(1,6)> Maybe the heat’s messing with your head?<slide><br><$comeff(1,14)><$motion(1,806)><$voicel(1,5)>Or maybe you’re just expertly trained.<clear><br><$comeff(1,13)><$motionoff(1,804)><$voicel(1,7)>OK, my bad! Let’s be friends from now on!
msgctxt "3255:118"
msgid "<$comeff(1,5)><$motion(1,803)><$voicel(1,10)>¿Y tú quién eres? ¿Has venido a quitarme mi keli?<clear><br><$comeff(1,10)><$motion(1,817)><$voicel(1,9)>¡Pues no me pienso dejar! ¡Quiiiiii!<clear><br><$comeff(1,14)><$voicel(1,3)>¿Qué pasa, no te doy miedo?<wait(0.8)> <$comeff(1,6)><$motion(1,807)><$voicel(1,6)>¿Te ha dado un síncope<br>por el calor, o qué?<clear><br><$comeff(1,14)><$motion(1,806)><$voicel(1,5)>O igual es que eres tan fuerte que ni te inmutas...<clear><br><$comeff(1,13)><$motionoff(1,804)><$voicel(1,7)>¡Pensándolo mejor, podrías ser mi amig<gen;-2(o,a)>!"
msgstr "<$comeff(1,5)><$motion(1,803)><$voicel(1,10)>¿Y tú quién eres? ¿Viniste a quitarme mi casa?<clear><br><$comeff(1,10)><$motion(1,817)><$voicel(1,9)>¡Pues no me pienso dejar! ¡Quiiiiii!<clear><br><$comeff(1,14)><$voicel(1,3)>¿Qué pasa, no te doy miedo?<wait(0.8)> <$comeff(1,6)><$motion(1,807)><$voicel(1,6)>¿Te dio un síncope<br>por el calor, o qué?<clear><br><$comeff(1,14)><$motion(1,806)><$voicel(1,5)>O tal vez eres tan fuerte que ni te inmutas...<clear><br><$comeff(1,13)><$motionoff(1,804)><$voicel(1,7)>¡Pensándolo mejor, podrías ser mi amig<gen;-2(o,a)>!"

#. en: <$comeff(1,10)><$motion(1,816)><$voicel(1,9)>Bwahhhhhh! <wait(0.4)><$motion(0,132)><$comeff(1,5)>Nice-lookin’ place we’ve got here! <$comeff(1,9)><$motion(1,803)><$voicel(1,10)>I can<br>dig it!<clear><br><$comeff(1,6)><$motion(1,805)><$voicel(1,7)>Huh? Oh hey, bud, what’s up? Need somethin’ from me?<clear><br><$comeff(1,5)><$voicel(1,8)>Say WHAT? You made this home?<clear><br><$comeff(1,21)><$motionoff(1,804)><$voicel(1,9)>Wow! That’s real cool! I hope we can be friends!<clear><br><$voicel(1,8)>Gotta warn you, though, I blast out heat shimmers when I<br>get excited, like I did a second ago. <$comeff(1,13)><$motion(1,807)><$voicel(1,9)>Watch out for that!
msgctxt "3255:119"
msgid "<$comeff(1,10)><$motion(1,816)><$voicel(1,9)>¡¡Tyyy!! <wait(0.4)><$motion(0,132)><$comeff(1,5)>¡Vaya rinconcito más apañao hay montado aquí!<br><$comeff(1,9)><$motion(1,803)><$voicel(1,10)>¡Está fetén!<clear><br><$comeff(1,6)><$motion(1,805)><$voicel(1,7)>¡Ey! ¿Qué pasa, necesitas algo, amig<gen;-2(o,a)>?<clear><br><$comeff(1,5)><$voicel(1,8)>¿Cómo dices? ¿Que todo esto te lo has currado tú?<clear><br><$comeff(1,21)><$motionoff(1,804)><$voicel(1,9)>¡No me fastidies! ¡Qué hacha! Tú y yo nos vamos<br>a llevar genial.<clear><br><$voicel(1,8)>Pero ojo, que cuando me emociono, pueden salir de mí<br>unas potentes explosiones de fuego.<slide><br><$comeff(1,13)><$motion(1,807)><$voicel(1,9)>¡Quien avisa no es <gen;-3(traidor,traidora)>!"
msgstr "<$comeff(1,10)><$motion(1,816)><$voicel(1,9)>¡¡Tyyy!! <wait(0.4)><$motion(0,132)><$comeff(1,5)>¡Vaya rinconcito más bien montado hay aquí!<br><$comeff(1,9)><$motion(1,803)><$voicel(1,10)>¡Está genial!<clear><br><$comeff(1,6)><$motion(1,805)><$voicel(1,7)>¡Ey! ¿Qué pasa, necesitas algo, amig<gen;-2(o,a)>?<clear><br><$comeff(1,5)><$voicel(1,8)>¿Cómo dices? ¿Que todo esto lo hiciste tú?<clear><br><$comeff(1,21)><$motionoff(1,804)><$voicel(1,9)>¡No me digas! ¡Eres increíble! Tú y yo nos vamos<br>a llevar genial.<clear><br><$voicel(1,8)>Pero ojo, que cuando me emociono, pueden salir de mí<br>unas potentes explosiones de fuego.<slide><br><$comeff(1,13)><$motion(1,807)><$voicel(1,9)>¡Quien avisa no es <gen;-3(traidor,traidora)>!"

#. en: ...<wait(0.5)><$voicel(1,8)><$comeff(1,1)><$motion(1,803)>Hoot!<wait(0.3)><clear><br>...<wait(0.7)><$voicel(1,7)><$comeff(1,10)><$motion(1,816)>Hoooooot!<clear><br>...<wait(0.3)><$voicel(1,6)>Oh. <$comeff(1,5)>Hey there. <wait(0.5)><$comeff(1,6)>Was I being <$motion(1,802)>too loud?<clear><br><$comeff(1,9)><$voicel(1,3)><$motion(1,806)>I can’t help it... I just get the urge to cry out around<br>this time...<clear><br><$voicel(1,9)><$motion(1,801)>Oh, don’t worry. I’m not sad or anything—it’s just a habit.<br><$comeff(1,10)>Hoot!
msgctxt "3255:120"
msgid "... <wait(0.5)><$voicel(1,8)><$comeff(1,1)><$motion(1,803)>¡Hoot! <wait(0.3)>¡Hoot! <wait(0.7)><$voicel(1,7)><$comeff(1,10)><$motion(1,816)>¡Hoot!<clear><br>... <wait(0.3)><$voicel(1,6)>Ah... <$comeff(1,5)>Hola...<clear><br><wait(0.5)><$comeff(1,6)><$motion(1,802)>¿T-te he molestado con el ruido? <$comeff(1,9)><$voicel(1,3)><$motion(1,806)>Es que cuando llega esta<br>hora del día, no puedo evitar ponerme a ulular sin parar...<clear><br><$voicel(1,9)><$motion(1,801)>Pero no te preocupes, no es que esté enfadad<gen;-3(o,a)> ni nada...<br><$comeff(1,10)>¡Hoot!"
msgstr "... <wait(0.5)><$voicel(1,8)><$comeff(1,1)><$motion(1,803)>¡Hoot! <wait(0.3)>¡Hoot! <wait(0.7)><$voicel(1,7)><$comeff(1,10)><$motion(1,816)>¡Hoot!<clear><br>... <wait(0.3)><$voicel(1,6)>Ah... <$comeff(1,5)>Hola...<clear><br><wait(0.5)><$comeff(1,6)><$motion(1,802)>¿T-te molesté con el ruido? <$comeff(1,9)><$voicel(1,3)><$motion(1,806)>Es que cuando llega esta<br>hora del día, no puedo evitar ponerme a ulular sin parar...<clear><br><$voicel(1,9)><$motion(1,801)>Pero no te preocupes, no es que esté enojad<gen;-3(o,a)> ni nada...<br><$comeff(1,10)>¡Hoot!"

#. en: <$comeff(1,13)><$voicel(1,5)><$motionoff(1,805)><$pkcry;0(1,1)>. I’ve been searching for somewhere quiet<br>to think, <$voicel(1,6)><$motionoff(1,803)>and this place looks suitable.<clear><br><$comeff(1,6)><$voicel(1,3)>Hmm? What a curious character you are. Are you human?<br><$comeff(1,14)><$facial(1,14)><$voicel(1,4)><$motionoff(1,807)>Or a Pokémon?<clear><br><$comeff(1,9)><$facial(1,4)><$voicel(1,7)><$motionoff(1,801)>I suppose I’ll spend the night pondering this.
msgctxt "3255:121"
msgid "<oneline><$comeff(1,13)><$voicel(1,5)><$motionoff(1,805)><$pkcry;0(1,1)>... Este lugar parece idóneo <$voicel(1,6)><$motionoff(1,803)>para sumirme<br>en mis<slide><br>pensamientos rodead<gen;-3(o,a)> de paz y sosiego.<clear><br><$comeff(1,6)><$voicel(1,3)>¿Hm? Tienes un aspecto ciertamente peculiar, joven...<br>¿Eres <gen;-2(un,una)> human<gen;-2(o,a)>? <$comeff(1,14)><$facial(1,14)><$voicel(1,4)><$motionoff(1,807)>¿O más bien un Pokémon?<clear><br><$comeff(1,9)><$facial(1,4)><$voicel(1,7)><$motionoff(1,801)>Bien, todo indica que pasaré esta noche ponderando<br>esa cuestión."
msgstr ""

#. en: <$comeff(1,21)><$facial(1,14)><$voicel(1,9)><$motionoff(1,801)>Oh wow, this is the perfect place for spinning my web!<clear><br><$comeff(1,5)><$facial(1,1)><$voicel(1,7)><$motionoff(1,802)>Wait, you’re saying you made this? That’s amazing! <$comeff(1,10)><$voicel(1,8)><$motionoff(1,803)>I really,<br>really like it here.<clear><br><$comeff(1,13)><$facial(1,14)><$voicel(1,9)><$motionoff(1,807)>Please come play with me whenever you want!
msgctxt "3255:122"
msgid "<$comeff(1,21)><$facial(1,14)><$voicel(1,9)><$motionoff(1,801)>¡Oh! ¡Este lugar es perfecto para ponerme a tejer telas!<br><$comeff(1,5)><$facial(1,1)><$voicel(1,7)><$motionoff(1,802)>¿Me lo has preparado tú? <$comeff(1,10)><$voicel(1,8)><$motionoff(1,803)>Jo, está genial.<clear><br><$comeff(1,13)><$facial(1,14)><$voicel(1,9)><$motionoff(1,807)>¡Espero que vengas a visitarme para jugar todos los días!"
msgstr "<$comeff(1,21)><$facial(1,14)><$voicel(1,9)><$motionoff(1,801)>¡Oh! ¡Este lugar es perfecto para ponerme a tejer telas!<br><$comeff(1,5)><$facial(1,1)><$voicel(1,7)><$motionoff(1,802)>¿Me lo preparaste tú? <$comeff(1,10)><$voicel(1,8)><$motionoff(1,803)>Vaya, está genial.<clear><br><$comeff(1,13)><$facial(1,14)><$voicel(1,9)><$motionoff(1,807)>¡Espero que vengas a visitarme para jugar todos los días!"

#. en: <$comeff(1,14)><$facial(1,14)><$voicel(1,3)>Tut tut. I must say, it takes some nerve to enter my nest.<wait(0.3)><br><$comeff(1,6)><$facial(1,1)><$voicel(1,6)>You’re a brave one, aren’t you?<clear><br><$comeff(1,13)><$voicel(1,7)><$motionoff(1,802)>Oh, no need to fret—I’m not upset. On the contrary, I’m in<br>quite a good mood.<clear><br><$comeff(1,10)><$voicel(1,8)><$motionoff(1,805)>After all, I’ve just found the most wonderful home!<clear><br><$comeff(1,21)><$facial(1,14)><$voicel(1,9)><$motionoff(1,801)>I’m sure it will be dazzling once I decorate it with some of<br>my sparkling string.
msgctxt "3255:123"
msgid "<$comeff(1,6)><$facial(1,14)><$voicel(1,3)>Uy, ¿qué haces aquí? <$comeff(1,14)><$facial(1,1)><$voicel(1,6)>Hay que tener valor para atreverse<br>a entrar en mis dominios...<clear><br><$comeff(1,13)><$voicel(1,7)><$motionoff(1,802)>No te preocupes, que no me voy a enfadar. De hecho,<br>hoy estoy de bastante buen humor.<clear><br><$comeff(1,10)><$voicel(1,8)><$motionoff(1,805)>¿Que por qué? ¡Pues por haber encontrado un sitio tan<br>fenomenal como este para vivir!<clear><br><$comeff(1,21)><$facial(1,14)><$voicel(1,9)><$motionoff(1,801)>Solo me falta decorarlo de arriba abajo con mi seda<br>especial para que quede perfecto."
msgstr "<$comeff(1,6)><$facial(1,14)><$voicel(1,3)>Uy, ¿qué haces aquí? <$comeff(1,14)><$facial(1,1)><$voicel(1,6)>Hay que tener valor para atreverse<br>a entrar en mis dominios...<clear><br><$comeff(1,13)><$voicel(1,7)><$motionoff(1,802)>No te preocupes, que no me voy a enojar. De hecho,<br>hoy estoy de bastante buen humor.<clear><br><$comeff(1,10)><$voicel(1,8)><$motionoff(1,805)>¿Que por qué? ¡Pues por haber encontrado un lugar tan<br>fenomenal como este para vivir!<clear><br><$comeff(1,21)><$facial(1,14)><$voicel(1,9)><$motionoff(1,801)>Solo me falta decorarlo de arriba abajo con mi seda<br>especial para que quede perfecto."

#. en: <$voicel(1,10)><$comeff(1,5)><$motion(1,807)>Whoa! You found me!<clear><br><$voicel(1,5)><$comeff(1,1)><$motion(1,805)>And here I was hopin’ to ambush anyone who came by and<br>suck their blood! <$voicel(1,4)><$comeff(1,14)><$motion(1,802)>I must be losin’ my touch.<clear><br>...<wait(0.6)><$voicel(1,7)>Wait, no! Maybe <$motion(1,806)><$comeff(1,6)>you have super keen senses?!<clear><br><$voicel(1,5)>You don’t look like you do...<$comeff(1,1)><$motion(1,803)>but that’s the feelin’ I’m<br>getting—like your looks are deceiving or something!<clear><br><$voicel(1,9)><$comeff(1,10)><$motion(1,801)>Well, let’s be friends, yeah? <wait(0.9)><$comeff(1,14)>Ughhh, I’m so hungry...
msgctxt "3255:124"
msgid "<$voicel(1,10)><$comeff(1,5)><$motion(1,807)>¡Bat, me has pillado in fraganti!<clear><br><$voicel(1,5)><$comeff(1,1)><$motion(1,805)>Estaba convencid<gen;-3(o,a)> de que iba a poder chuparles la sangre<br>disimuladamente a los pardillos que pasasen por aquí...<slide><br><$voicel(1,4)><$comeff(1,14)><$motion(1,802)>Estoy en baja forma. Quién me ha visto y quién me ve.<clear><br>... <wait(0.6)><$voicel(1,7)><$motion(1,806)><$comeff(1,6)>O quizá es que tú tienes los sentidos más agudizados<br>que yo qué sé.<clear><br><$voicel(1,5)>Cualquiera lo diría, con esas pintas que me traes...<br><$comeff(1,1)><$motion(1,803)>pero vaya, ¡que las apariencias engañan!<clear><br><$voicel(1,9)><$comeff(1,10)><$motion(1,801)>En fin, seamos colegas y aquí no ha pasado nada, ¿eh?<br><wait(0.9)><$comeff(1,14)>Uf, me muero de hambre..."
msgstr "<$voicel(1,10)><$comeff(1,5)><$motion(1,807)>¡Bat, me atrapaste in fraganti!<clear><br><$voicel(1,5)><$comeff(1,1)><$motion(1,805)>Estaba convencid<gen;-3(o,a)> de que iba a poder chuparles la sangre<br>disimuladamente a los ingenuos que pasaran por aquí...<slide><br><$voicel(1,4)><$comeff(1,14)><$motion(1,802)>Estoy en baja forma. Quién me ha visto y quién me ve.<clear><br>... <wait(0.6)><$voicel(1,7)><$motion(1,806)><$comeff(1,6)>O quizás es que tú tienes los sentidos más agudizados<br>que yo qué sé.<clear><br><$voicel(1,5)>Cualquiera lo diría, con ese aspecto que tienes...<br><$comeff(1,1)><$motion(1,803)>pero vaya, ¡que las apariencias engañan!<clear><br><$voicel(1,9)><$comeff(1,10)><$motion(1,801)>En fin, seamos amigos y aquí no pasó nada, ¿eh?<br><wait(0.9)><$comeff(1,14)>Uf, me muero de hambre..."

#. en: <$facial(1,13)><$voicel(1,10)><$comeff(1,1)><$motion(1,803)>Oops, sorry! I hope I didn’t zap you.<clear><br><$voicel(1,7)><$motionoff(1,806)>You kinda surprised me, <$comeff(1,10)><$voicel(1,8)><$motionoff(1,807)>popping up outta nowhere like<br>that.<clear><br><$comeff(1,5)><$voicel(1,10)><$motionoff(1,804)>But it wasn’t a bad surprise! <$comeff(1,21)><$voicel(1,9)><$motionoff(1,801)>I just know we’re going to be<br>great friends!
msgctxt "3255:125"
msgid "<$facial(1,13)><$voicel(1,10)><$comeff(1,1)><$motion(1,803)>¡Ay! ¿Te he dado calambre? ¡Perdona!<clear><br><$voicel(1,7)><$motionoff(1,806)>Es que has aparecido tan de repente<$comeff(1,10)><$voicel(1,8)><$motionoff(1,807)> que me he asustado<br><$comeff(1,5)><$voicel(1,10)><$motionoff(1,804)>y me han saltado las chispas.<clear><br><$comeff(1,21)><$voicel(1,9)><$motionoff(1,801)>¡Encantad<gen;-3(o,a)>! Espero que nos llevemos bien."
msgstr "<$facial(1,13)><$voicel(1,10)><$comeff(1,1)><$motion(1,803)>¡Ay! ¿Te di un calambre? ¡Perdona!<clear><br><$voicel(1,7)><$motionoff(1,806)>Es que apareciste tan de repente<$comeff(1,10)><$voicel(1,8)><$motionoff(1,807)> que me asusté<br><$comeff(1,5)><$voicel(1,10)><$motionoff(1,804)>y me saltaron las chispas.<clear><br><$comeff(1,21)><$voicel(1,9)><$motionoff(1,801)>¡Encantad<gen;-3(o,a)>! Espero que nos llevemos bien."

#. en: <$comeff(1,21)><$facial(1,4)><$motionoff(1,804)>Clef clef...<clear><br><$comeff(1,5)><$facial(1,1)><$motion(1,803)><$voicel(1,7)>Oh, hello! Nice to meet you! Sorry I didn’t notice you at<br>first! <$comeff(1,10)><$motion(1,807)><$voicel(1,9)>I’ve been looking at the sky...<clear><br><$comeff(1,13)><$motion(1,806)><$voicel(1,9)>Sometimes, if you watch the sky reeaaally closely, for a<br>reeaaally long time...you’ll see a shooting star! <$comeff(1,21)><$facial(1,4)><$motionoff(1,804)><$voicel(1,9)>I’ve been<slide><br>waiting and waiting for that!
msgctxt "3255:126"
msgid "<$comeff(1,21)><$facial(1,4)><$motionoff(1,804)>♪Clef, clef...♪<clear><br><$comeff(1,5)><$facial(1,1)><$motion(1,803)><$voicel(1,7)>¡Oh! ¡Holita! ¡Perdona, no te había visto! <$comeff(1,10)><$motion(1,807)><$voicel(1,9)>Estaba a lo mío,<br>mirando al cielo, como siempre.<clear><br><$comeff(1,13)><$motion(1,806)><$voicel(1,9)>¿Sabías que, de vez en cuando, se ven estrellas fugaces?<br><$comeff(1,21)><$facial(1,4)><$motionoff(1,804)><$voicel(1,9)>¡Qué ganas de que vuelva a pasar una!"
msgstr ""

#. en: <$comeff(1,10)><$motion(1,807)><$voicel(1,7)>Oh, hi! Nice to meetcha!<clear><br><$motion(1,803)><$voicel(1,8)>You look really soft...<clear><br><$comeff(1,6)><$facial(1,1)><$motion(1,805)><$voicel(1,5)>Hey, who do you think is squishier, you or me?! <$motion(1,803)><$voicel(1,7)>Let’s<br>bounce together on three to figure it out!<clear><br><$voicel(1,10)>Ready? One...two...three!<wait(0.65)><$comeff(0,5)><$comeff(1,5)><$motion(0,4)><$motion(1,815)><clear><br><$motion(1,807)><$voicel(1,7)>Hmm, OK. Looks like I’m squishy, and you’re springy! <$comeff(1,13)><$voicel(1,9)><$motion(1,801)>But<br>we’re both soft, so let’s be friends!
msgctxt "3255:127"
msgid "<$comeff(1,10)><$motion(1,807)><$voicel(1,7)>¡Holiii! ¡Encantad<gen;-3(ooo,aaa)>!<clear><br><$motion(1,803)><$voicel(1,8)>¡Oh, oh, oooh! ¡Tienes pinta de ser superblandit<gen;-2(o,a)>!<br><$comeff(1,6)><$facial(1,1)><$motion(1,805)><$voicel(1,5)>¿Por qué no probamos a ver si lo eres más que yo?<clear><br><$motion(1,803)><$voicel(1,7)>¡Venga, vamos a botar a la de tres! <$voicel(1,10)>Una... <wait(0.65)>dos... <wait(0.65)>¡y tres!<wait(0.65)><$comeff(0,5)><$comeff(1,5)><$motion(0,4)><$motion(1,815)><clear><br><$motion(1,807)><$voicel(1,7)>¡Ya veo! ¡Yo soy blandit<gen;-3(o,a)> y tú eres más bien \"blanditt<gen;-2(o,a)>\"!<br><$comeff(1,13)><$voicel(1,9)><$motion(1,801)>Ji, ji, ji. ¡Espero que nos llevemos bien!"
msgstr "<$comeff(1,10)><$motion(1,807)><$voicel(1,7)>¡Holiii! ¡Encantad<gen;-3(ooo,aaa)>!<clear><br><$motion(1,803)><$voicel(1,8)>¡Oh, oh, oooh! ¡Tienes pinta de ser superblandit<gen;-2(o,a)>!<br><$comeff(1,6)><$facial(1,1)><$motion(1,805)><$voicel(1,5)>¿Por qué no probamos a ver si lo eres más que yo?<clear><br><$motion(1,803)><$voicel(1,7)>¡A rebotar a la cuenta de tres! <$voicel(1,10)>Una... <wait(0.65)>dos... <wait(0.65)>¡y tres!<wait(0.65)><$comeff(0,5)><$comeff(1,5)><$motion(0,4)><$motion(1,815)><clear><br><$motion(1,807)><$voicel(1,7)>¡Ya veo! ¡Yo soy blandit<gen;-3(o,a)> y tú eres más bien \"blanditt<gen;-2(o,a)>\"!<br><$comeff(1,13)><$voicel(1,9)><$motion(1,801)>Ji, ji, ji. ¡Espero que nos llevemos bien!"

#. en: <$motion(1,802)><$comeff(1,23)><$voicel(1,3)>Ohmygosh, I am sooo itchyyyy!<clear><br><$motion(1,803)><$comeff(1,5)><$voicel(1,8)>Ummm... Hey! Excuse me, you there! Could you scratch my<br>back for me, pretty pretty please? <$motion(1,802)><$comeff(1,19)><$voicel(1,4)>I can’t reach it with<slide><br>my hooves...<wait(1.0)><$motion(0,156)><wait(1.6)><clear><br><$comeff(1,9)><$voicel(1,9)>Uh-huh, yup, that’s the spot, right there!<wait(0.9)><$se2d(2394)><$motion(0,157)><$comeff(0,5)><$motion(1,817)><$comeff(1,10)><br><$textsize(2)>PHEEEW!</textsize><clear><br><$motion(1,805)><$voicel(1,6)>Oh geez, I’m sooo sorry!<clear><br><$motion(1,807)><$comeff(1,4)><$voicel(1,7)>You’re just like REALLY good at back scratching, so I let<br>out a little shock without thinking...<clear><br><$motion(1,801)><$comeff(1,21)><$voicel(1,9)>But you really helped me out! Thank you sooo much!
msgctxt "3255:130"
msgid "<$motion(1,802)><$comeff(1,23)><$voicel(1,3)>Ay, cómo picaaa...<br><$motion(1,803)><$comeff(1,5)><$voicel(1,8)>Perdona... ¿te importaría rascarme el lomo, porfi?<clear><br><$motion(1,802)><$comeff(1,19)><$voicel(1,4)>Es que con estas patitas que tengo no hay forma de llegar,<br>y me pica un montón...<wait(1.0)><$motion(0,156)><wait(1.6)><clear><br><$comeff(1,9)><$voicel(1,9)>Ay, no, un poco más hacia acá... ¡Ahí, ahí, justo!<clear><br><$se2d(2394)><$motion(0,157)><$comeff(0,5)><$motion(1,817)><$comeff(1,10)><$textsize(2)>¡Qué gustitooo!</textsize><clear><br><$motion(1,805)><$voicel(1,6)>L-lo siento... <wait(0.5)><$motion(1,807)><$comeff(1,4)><$voicel(1,7)>Es que se te da tan bien esto de rascar que<br>he perdido las formas... <$motion(1,801)><$comeff(1,21)><$voicel(1,9)>¡Muchísimas gracias!"
msgstr "<$motion(1,802)><$comeff(1,23)><$voicel(1,3)>Ay, cómo picaaa...<br><$motion(1,803)><$comeff(1,5)><$voicel(1,8)>Perdona... ¿te importaría rascarme el lomo, porfi?<clear><br><$motion(1,802)><$comeff(1,19)><$voicel(1,4)>Es que con estas patitas que tengo no hay forma de llegar,<br>y me pica un montón...<wait(1.0)><$motion(0,156)><wait(1.6)><clear><br><$comeff(1,9)><$voicel(1,9)>Ay, no, un poco más hacia acá... ¡Ahí, ahí, justo!<clear><br><$se2d(2394)><$motion(0,157)><$comeff(0,5)><$motion(1,817)><$comeff(1,10)><$textsize(2)>¡Qué gustitooo!</textsize><clear><br><$motion(1,805)><$voicel(1,6)>L-lo siento... <wait(0.5)><$motion(1,807)><$comeff(1,4)><$voicel(1,7)>Es que se te da tan bien esto de rascar que<br>perdí la compostura... <$motion(1,801)><$comeff(1,21)><$voicel(1,9)>¡Muchísimas gracias!"

#. en: <$comeff(1,13)><$motion(1,803)><$voicel(1,5)>Oh, hi. Nice to meet you!<clear><br><$comeff(1,10)><$motion(1,802)><$voicel(1,7)>Wow, your body’s pretty smooth. So’s mine!<clear><br><$comeff(1,6)><$voicel(1,7)>Huh? You think I’m more fluffy than smooth?<clear><br><$comeff(1,13)><$motion(1,805)><$voicel(1,7)>That’s true. Parts of me are smooth, and other parts are<br><$motion(1,805)><$voicel(1,7)>really, really fluffy!<clear><br><$motion(0,156)><$comeff(1,14)><$motion(1,803)><$voicel(1,7)>Oh, but my fluff’s packed with electricity, so uh—<$comeff(1,10)><$motion(1,802)><$voicel(1,7)>just<br>watch out for that, OK?<wait(1.2)><$motion(0,157)><$se2d(2394)><$comeff(0,5)><clear><br><$comeff(1,4)><$motion(1,801)><$voicel(1,7)>Whoops... Too late!
msgctxt "3255:131"
msgid "<$comeff(1,13)><$motion(1,803)><$voicel(1,5)>Oye, yo a ti no te conozco, ¿verdad? Juraría que no...<clear><br><$comeff(1,10)><$motion(1,802)><$voicel(1,7)>¿Te han dicho alguna vez que tu piel parece supersuave?<br>Vamos, igualita que la mía. Nos vamos a llevar genial.<clear><br><$comeff(1,6)><$voicel(1,7)>¿Eh? ¿Cómo que yo soy más esponjos<gen;-3(o,a)> que suave? <$comeff(1,13)><$motion(1,805)><$voicel(1,7)>Je.<clear><br>Solo tengo lana en algunas partes... El resto de mi cuerpo<br>es suuupersuave, <$motion(1,805)><$voicel(1,7)>como puedes ver.<clear><br><$motion(0,156)><$comeff(1,14)><$motion(1,803)><$voicel(1,7)>Hablando de lana... Cuidadín, colegui, que está cargada<br>de electricidad.<clear><br><$comeff(1,10)><$motion(1,802)><$voicel(1,7)>No te vayas a... <wait(1.2)><$motion(0,157)><$se2d(2394)><$comeff(0,5)><$comeff(1,4)><$motion(1,801)><$voicel(1,7)>Pueees, demasiado tarde..."
msgstr "<$comeff(1,13)><$motion(1,803)><$voicel(1,5)>Oye, yo a ti no te conozco, ¿verdad? Juraría que no...<clear><br><$comeff(1,10)><$motion(1,802)><$voicel(1,7)>¿Te han dicho alguna vez que tu piel parece supersuave?<br>Vamos, igualita que la mía. Nos vamos a llevar genial.<clear><br><$comeff(1,6)><$voicel(1,7)>¿Eh? ¿Cómo que yo soy más esponjos<gen;-3(o,a)> que suave? <$comeff(1,13)><$motion(1,805)><$voicel(1,7)>Je.<clear><br>Solo tengo lana en algunas partes... El resto de mi cuerpo<br>es suuupersuave, <$motion(1,805)><$voicel(1,7)>como puedes ver.<clear><br><$motion(0,156)><$comeff(1,14)><$motion(1,803)><$voicel(1,7)>Hablando de lana... Cuidadito, amigui, que está cargada<br>de electricidad.<clear><br><$comeff(1,10)><$motion(1,802)><$voicel(1,7)>No te vayas a... <wait(1.2)><$motion(0,157)><$se2d(2394)><$comeff(0,5)><$comeff(1,4)><$motion(1,801)><$voicel(1,7)>Pueees, demasiado tarde..."

#. en: <$voicel(1,5)><$emotion(1,29)>Oh my, aren’t you just the cutest thing? Are you human?<$motion(0,41)><br><$voicel(1,8)><$facial(1,4)><$comeff(1,3)>Wait, no! You’re a Pokémon, aren’t you?<$motion(0,40)><slide><br><$voicel(1,10)><$comeff(1,10)><$motion(1,805)>Very good transformation!<clear><br><$voicel(1,5)><$emotion(1,29)>Hmm, this looks like quite a nice area to live in. <$voicel(1,7)><$facial(1,4)><$motion(1,859)>Maybe I’ll<br>light the place up with my trusty tail! ♪<clear><br><$voicel(1,9)><$emotion(1,8)>It looks like I’ve already got a lovely neighbor in you, so<br>I believe life is about to get brighter!
msgctxt "3255:132"
msgid "<$voicel(1,5)><$emotion(1,29)>Oy, pero qué jovenzuel<gen;-2(o,a)> más maj<gen;-2(o,a)> tenemos aquí...<br>¿Eres <gen;-2(un,una)> human<gen;-2(o,a)>?<$motion(0,41)><clear><br><$voicel(1,8)><$facial(1,4)><$comeff(1,3)>¡Ah, no! ¡Si eres un Pokémon! <$motion(0,40)><$voicel(1,10)><$comeff(1,10)><$motion(1,805)>Pues se te da de maravilla<br>transformarte, criatura.<clear><br>Bueno, ya que estás aquí, escucha que te diga:<br><$voicel(1,5)><$emotion(1,29)>¿No te parece este un sitio estupendo para vivir?<clear><br><$voicel(1,7)><$facial(1,4)><$motion(1,859)>¡Y mejor que va a ser todavía cuando lo ilumine todo<br>con la preciosa luz de mi cola!<clear><br><$voicel(1,9)><$emotion(1,8)>Los vecinos parecen muy amables... ¡Creo que mudarme<br>aquí sería una idea brillante, jo, jo, jo!"
msgstr "<$voicel(1,5)><$emotion(1,29)>Oy, pero qué jovenzuel<gen;-2(o,a)> más simpátic<gen;-2(o,a)> tenemos aquí...<br>¿Eres <gen;-2(un,una)> human<gen;-2(o,a)>?<$motion(0,41)><clear><br><$voicel(1,8)><$facial(1,4)><$comeff(1,3)>¡Ah, no! ¡Si eres un Pokémon! <$motion(0,40)><$voicel(1,10)><$comeff(1,10)><$motion(1,805)>Pues se te da de maravilla<br>transformarte, criatura.<clear><br>Bueno, ya que estás aquí, déjame decirte algo:<br><$voicel(1,5)><$emotion(1,29)>¿No te parece este un lugar estupendo para vivir?<clear><br><$voicel(1,7)><$facial(1,4)><$motion(1,859)>¡Y mejor que va a ser todavía cuando lo ilumine todo<br>con la preciosa luz de mi cola!<clear><br><$voicel(1,9)><$emotion(1,8)>Los vecinos parecen muy amables... ¡Creo que mudarme<br>aquí sería una idea brillante, jo, jo, jo!"

#. en: <$voicel(1,8)><$motion(1,880)><$comeff(1,13)>Bello bellooo bell! ♪<clear><br><$voicel(1,9)><$facial(1,4)><$motion(1,801)><$comeff(1,10)>When I perform this dance, I can feel it deepen my<br>connection with the sun.<clear><br><$voicel(1,4)><$comeff(1,6)><$motion(1,806)>Would you like to join me?<clear><br><$motion(0,425)><$voicel(1,9)><$emotion(1,14)>Well, just look at you! How lovely.<clear><br><$motion(0,306)><$voicel(1,9)><$emotion(1,8)>What a treat it is to meet such a charming dancer!
msgctxt "3255:133"
msgid "<$voicel(1,8)><$motion(1,880)><$comeff(1,13)>♪¡Beeell, bellooo!♪<clear><br><$voicel(1,9)><$facial(1,4)><$motion(1,801)><$comeff(1,10)>Bailo así porque me da la impresión de que me ayuda a<br>conectarme más con el sol.<clear><br><$voicel(1,4)><$comeff(1,6)><$motion(1,806)>¿Por qué no te unes a mi danza?<clear><br><$motion(0,425)><$voicel(1,9)><$emotion(1,14)>¡Oh! ¡Estupendo! <$motion(0,306)><$voicel(1,9)><$emotion(1,8)>Me alegro de haber conocido a tan<br><gen;-2(buen,buena)> bailar<gen;-2(ín,ina)>."
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,62)><$pkcry;0(1,2)>! <$pkcry;1(1,2)>! ♪ Oh, hi there!<clear><br><$voicel(1,3)><$emotion(1,29)>Did you make this nice place to live? <$voicel(1,7)><$facial(1,4)><$motion(1,805)><$comeff(1,21)>It looks really<br>comfy with all this water around!<clear><br><$voicel(1,9)><$comeff(1,8)><$motion(1,817)>Even if I got all sweaty, it’d be easy to wash myself clean<br>again.
msgctxt "3255:134"
msgid "<oneline><$voicel(1,7)><$emotion(1,62)>¡<$pkcry;0(1,2)>, <flow><$pkcry;1(1,2)>! ¡Holaaa!<br><$voicel(1,3)><$emotion(1,29)>¿Has preparado tú este lugar?<clear><br><$voicel(1,7)><$facial(1,4)><$motion(1,805)><$comeff(1,21)>¡Qué maravilla que haya tanta agua! <$voicel(1,9)><$comeff(1,8)><$motion(1,817)>Si me pongo a sudar<br>de tanto jugar, ¡solo tengo que darme un chapuzón y listo!"
msgstr "<oneline><$voicel(1,7)><$emotion(1,62)>¡<$pkcry;0(1,2)>, <flow><$pkcry;1(1,2)>! ¡Holaaa!<br><$voicel(1,3)><$emotion(1,29)>¿Preparaste tú este lugar?<clear><br><$voicel(1,7)><$facial(1,4)><$motion(1,805)><$comeff(1,21)>¡Qué maravilla que haya tanta agua! <$voicel(1,9)><$comeff(1,8)><$motion(1,817)>Si me pongo a sudar<br>de tanto jugar, ¡solo tengo que darme un chapuzón y listo!"

#. en: <$voicel(1,5)><$emotion(1,27)>Hey, you! Stop for a second! <wait(0.4)><$facial(1,14)>Stand still and just listen...<clear><br><$voicel(1,4)><$motion(1,805)>... ... ...<clear><br><$voicel(1,3)><$emotion(1,29)>So, what do you think? Doesn’t the water sound so clear<br>and beautiful?<clear><br><$voicel(1,9)><$emotion(1,8)>Being able to live by the water is just the BEST!<clear><br><$voicel(1,4)><$comeff(1,6)>Wait—is this here because of you? Are you the reason I<br>can live here? <wait(0.4)><$voicel(1,10)><$emotion(1,60)>In that case, you’re the BEST too!
msgctxt "3255:135"
msgid "<$voicel(1,5)><$emotion(1,27)>¡Ey, tú! ¡Sí, tú! ¡Shhh!<wait(0.4)><$facial(1,14)> Escucha con atención...<clear><br><$voicel(1,4)><$motion(1,805)>...<clear><br><$voicel(1,3)><$emotion(1,29)>¿Qué, lo oyes? ¿No percibes el sonido del agua cristalina?<br><$voicel(1,9)><$emotion(1,8)>¡Vivir cerca del agua es la caña!<clear><br><$voicel(1,4)><$comeff(1,6)>¿No habrás tenido tú algo que ver? <wait(0.4)><$voicel(1,10)><$emotion(1,60)>¡Entonces tú también<br>eres la caña!"
msgstr "<$voicel(1,5)><$emotion(1,27)>¡Ey, tú! ¡Sí, tú! ¡Shhh!<wait(0.4)><$facial(1,14)> Escucha con atención...<clear><br><$voicel(1,4)><$motion(1,805)>...<clear><br><$voicel(1,3)><$emotion(1,29)>¿Qué, lo oyes? ¿No percibes el sonido del agua cristalina?<br><$voicel(1,9)><$emotion(1,8)>¡Vivir cerca del agua es lo máximo!<clear><br><$voicel(1,4)><$comeff(1,6)>¿No habrás tenido tú algo que ver? <wait(0.4)><$voicel(1,10)><$emotion(1,60)>¡Entonces tú también<br>eres lo máximo!"

#. en: <$comeff(1,14)>... ... ...<clear><br><$voicel(1,5)>... ... ...<clear><br>Um... <wait(0.8)>Can, uh—<wait(0.4)><$voicel(1,4)><$comeff(1,6)><$motion(1,666)>can you tell I’m not a tree?<clear><br><$voicel(1,7)><$comeff(1,4)><$motion(1,807)><$facial(1,9)>Aw, what?! Say something sooner! Gosh, I kept pretending<br>even after my cover was blown. How embarrassing...<clear><br><$voicel(1,5)><$emotion(1,49)>Next time, come talk to me normally, OK?
msgctxt "3255:136"
msgid "<$comeff(1,14)>...<clear><br><$voicel(1,5)>... <wait(0.4)>No me digas que... <wait(0.4)><$voicel(1,4)><$comeff(1,6)><$motion(1,666)>¿te has dao cuenta de que no<br>soy un árbol?<clear><br><$voicel(1,7)><$comeff(1,4)><$motion(1,807)><$facial(1,9)>No vale, jopé, a la próxima dímelo antes... Que hacer<br>de árbol cuando los demás se han dao cuenta queda<slide><br>bastaaante ridículo.<clear><br><$voicel(1,5)><$emotion(1,49)>A la próxima, háblame normal y punto, ¿eh?"
msgstr "<$comeff(1,14)>...<clear><br><$voicel(1,5)>... <wait(0.4)>No me digas que... <wait(0.4)><$voicel(1,4)><$comeff(1,6)><$motion(1,666)>¿te diste cuenta de que no<br>soy un árbol?<clear><br><$voicel(1,7)><$comeff(1,4)><$motion(1,807)><$facial(1,9)>No se vale, ay, a la próxima dímelo antes... Que hacer<br>de árbol cuando los demás ya se dieron cuenta queda<slide><br>bastaaante ridículo.<clear><br><$voicel(1,5)><$emotion(1,49)>A la próxima, háblame normal y punto, ¿eh?"

#. en: <$voicel(1,7)><$facial(1,4)><$motion(1,827)><$comeff(1,13)>Ahhh... ♪ When the curled hair on my head waves in the<br>wind, <$voicel(1,4)><$comeff(1,10)><$cdef(27)>Poliwag </color>and <$cdef(27)>Poliwhirl </color>can’t take their eyes off me.<clear><br><$voicel(1,5)><$motion(1,634)><$facial(1,5)>And look... It seems this dear human is enchanted<br>as well! ♪<clear><br><$voicel(1,4)><$motion(1,635)><$facial(1,1)><$comeff(1,3)>Oh! Pardon me! You’re a Pokémon, aren’t you? What a fun<br>little one you are! <$voicel(1,10)><$emotion(1,62)>I hope we’ll be the best of friends!
msgctxt "3255:137"
msgid "<$voicel(1,7)><$facial(1,4)><$motion(1,827)><$comeff(1,13)>¡Toed! ¿Sabías que los <$cdef(27)>Poliwag</color> y los <$cdef(27)>Poliwhirl</color> <$voicel(1,4)><$comeff(1,10)>se quedan<br>prendados de mi rizo cuando se mueve?<clear><br><$voicel(1,5)><$motion(1,634)><$facial(1,5)>Y parece que a los humanos os pasa lo mismo, jo, jo, jo.<clear><br><$voicel(1,4)><$motion(1,635)><$facial(1,1)><$comeff(1,3)>¡Caramba, pero si eres un Pokémon! Menud<gen;-2(o,a)> querub<gen;-2(ín,ina)><br>más simpátic<gen;-2(o,a)>. <$voicel(1,10)><$emotion(1,62)>¡Me has caído bien!"
msgstr "<$voicel(1,7)><$facial(1,4)><$motion(1,827)><$comeff(1,13)>¡Toed! ¿Sabías que los <$cdef(27)>Poliwag</color> y los <$cdef(27)>Poliwhirl</color> <$voicel(1,4)><$comeff(1,10)>se quedan<br>prendados de mi rizo cuando se mueve?<clear><br><$voicel(1,5)><$motion(1,634)><$facial(1,5)>Y parece que a los humanos les pasa lo mismo, jo, jo, jo.<clear><br><$voicel(1,4)><$motion(1,635)><$facial(1,1)><$comeff(1,3)>¡Caramba, pero si eres un Pokémon! Menud<gen;-2(o,a)> querub<gen;-2(ín,ina)><br>más simpátic<gen;-2(o,a)>. <$voicel(1,10)><$emotion(1,62)>¡Me caíste bien!"

#. en: <$voicel(1,5)><$emotion(1,32)>Woop! Nice to meet you! Isn’t this place nice ’n’ humid?<clear><br><$voicel(1,4)><$emotion(1,29)>Y’like spots like this too? Then we should hang out for<br>a while!<clear><br><$voicel(1,4)><$motion(1,816)><$comeff(1,5)>OH! But be careful right there!<clear><br><$voicel(1,7)><$motion(1,805)><$facial(1,4)><$comeff(1,10)>I was just chilling there earlier, so it miiight be a little slimy<br>and make your skin tingle.
msgctxt "3255:138"
msgid "<$voicel(1,5)><$emotion(1,32)>Woop, woop, hola... Me gusta mucho esta zona por la<br>humedad.<clear><br><$voicel(1,4)><$emotion(1,29)>Si a ti también te gusta, puedes pasarte por aquí.<clear><br><$voicel(1,4)><$motion(1,816)><$comeff(1,5)>A-aunque me he estado revolcando y <$voicel(1,7)><$motion(1,805)><$facial(1,4)><$comeff(1,10)>puede que el suelo<br>esté embarrado e incluso ponzoñoso..."
msgstr "<$voicel(1,5)><$emotion(1,32)>Woop, woop, hola... Me gusta mucho esta zona por la<br>humedad.<clear><br><$voicel(1,4)><$emotion(1,29)>Si a ti también te gusta, puedes pasarte por aquí.<clear><br><$voicel(1,4)><$motion(1,816)><$comeff(1,5)>A-aunque estuve revolcándome y <$voicel(1,7)><$motion(1,805)><$facial(1,4)><$comeff(1,10)>puede que el suelo<br>esté embarrado e incluso ponzoñoso..."

#. en: <$voicel(1,3)><$motion(1,666)><$comeff(1,5)>Excuse me. I don’t believe we’ve met, but tell me...<wait(0.8)><br>despite looking human, <$voicel(1,6)><$emotion(1,29)>you’re really a <$cdef(27)>Ditto</color>, aren’t you?<slide><br><$voicel(1,8)><$facial(1,4)><$comeff(1,9)>Yes, that’s what I thought—and I’m rarely wrong. ♪<clear><br><$voicel(1,3)><$facial(1,14)><$comeff(1,14)><$motion(1,806)>According to my Future Sight, it seems you and I<br><$voicel(1,8)><$emotion(1,14)>will spend a lot of time together.<clear><br><$voicel(1,10)><$emotion(1,38)>I feel fortunate to have such a splendid neighbor!
msgctxt "3255:139"
msgid "<$voicel(1,3)><$motion(1,666)><$comeff(1,5)>Hola, encantad<gen;-3(o,a)> de conocerte. Pareces <gen;-2(un,una)> human<gen;-2(o,a)>,<br>pero... ¡algo me dice que <$voicel(1,6)><$emotion(1,29)>en realidad eres un <$cdef(27)>Ditto</color>!<clear><br><$voicel(1,8)><$facial(1,4)><$comeff(1,9)>¡Ju, ju, si es que nada se me escapa!<clear><br><$voicel(1,3)><$facial(1,14)><$comeff(1,14)><$motion(1,806)>Incluso soy capaz de predecir nuestro futuro:<br><$voicel(1,8)><$emotion(1,14)>¡nuestra amistad va a ser de las que duran!<clear><br><$voicel(1,10)><$emotion(1,38)>Me alegro de conocerte, vecin<gen;-2(o,a)>."
msgstr ""

#. en: <$voicel(1,5)><$emotion(1,14)>How nice to make your acquaintance. This place you’ve<br>got here is really quite peaceful and soothing.<clear><br><$voicel(1,3)><$facial(1,4)><$motion(1,805)><$comeff(1,9)>I can feel the aura of the moon here as well... Hm hm, this<br>is quite the ideal home for me.<clear><br><$voicel(1,5)><$emotion(1,41)>Ah, my apologies. I was just musing to myself. Anyhow, I’ll<br>be staying here a while, <$voicel(1,4)><$emotion(1,38)>so feel free to stop by any time.
msgctxt "3255:140"
msgid "<$voicel(1,5)><$emotion(1,14)>Es un placer conocerte. Este lugar desprende un aire<br>de lo más apacible, ¿no es así?<clear><br><$voicel(1,3)><$facial(1,4)><$motion(1,805)><$comeff(1,9)>El halo de la luna luce aquí en todo su esplendor. Je, sin<br>duda una morada que se amolda a mis preferencias.<clear><br><$voicel(1,5)><$emotion(1,41)>Discúlpame... Me he dejado llevar por mi locuacidad.<br>Creo que residiré aquí una temporada.<clear><br><$voicel(1,4)><$emotion(1,38)>Espero que el futuro nos depare un feliz reencuentro."
msgstr "<$voicel(1,5)><$emotion(1,14)>Es un placer conocerte. Este lugar desprende un aire<br>de lo más apacible, ¿no es así?<clear><br><$voicel(1,3)><$facial(1,4)><$motion(1,805)><$comeff(1,9)>El halo de la luna luce aquí en todo su esplendor. Je, sin<br>duda una morada que se amolda a mis preferencias.<clear><br><$voicel(1,5)><$emotion(1,41)>Discúlpame... Me dejé llevar por mi locuacidad.<br>Creo que residiré aquí una temporada.<clear><br><$voicel(1,4)><$emotion(1,38)>Espero que el futuro nos depare un feliz reencuentro."

#. en: <$motion(1,802)><$voicel(1,8)><$comeff(1,1)>Hey there, yo!<clear><br><$voicel(1,7)><$motion(1,803)><$comeff(1,6)>You wouldn’t happen to know where the humans live<br>around here, would ya?<clear><br><$motion(0,41)>...<wait(0.9)><$voicel(1,10)><$comeff(1,11)><$motion(1,817)>What?! There aren’t any humans here at ALL?<clear><br><$motion(1,807)><$comeff(1,7)><$voicel(1,4)>Yo, you serious? That ain’t good!<clear><br><$motion(1,802)><$motion(1,805)><$voicel(1,5)><$comeff(1,14)>I wanna fill my home up <$voicel(1,8)><$motion(1,805)>with a bunch of shiny stuff!<clear><br><$motion(1,663)><$comeff(1,17)><$voicel(1,6)>And, y’know, human homes have jewels and glass and all<br>kinds of sparkly things, yo!<clear><br><$motion(1,801)><$comeff(1,10)><$voicel(1,3)>Guess I’ll have to think up a plan B!
msgctxt "3255:141"
msgid "<$motion(1,802)><$voicel(1,8)><$comeff(1,1)>¡Buenas! ¿Cómo vas?<clear><br><$voicel(1,7)><$motion(1,803)><$comeff(1,6)>Oye, ¿sabes si algún humano vive por aquí cerca?<clear><br><$motion(0,41)>... <wait(0.9)><$voicel(1,10)><$comeff(1,11)><$motion(1,817)>¿Eh? ¿Que no hay ni rastro de los humanos? ¿En serio?<br><$motion(1,807)><$comeff(1,7)><$voicel(1,4)>¡Qué heavy, <gen;-2(tío,tía)>!<clear><br><$motion(1,802)><$motion(1,805)><$voicel(1,5)><$comeff(1,14)>Y yo que quería llenar mi casa <$voicel(1,8)><$motion(1,805)>de cosas brillantes y<br>relucientes...<clear><br><$motion(1,663)><$comeff(1,17)><$voicel(1,6)>Los humanos suelen guardar joyas, objetos de cristal...<br>¡sus casas están llenas de trastos que molan muchísimo!<clear><br><$motion(1,801)><$comeff(1,10)><$voicel(1,3)>Pues nada, tendré que ingeniármelas de otra forma."
msgstr "<$motion(1,802)><$voicel(1,8)><$comeff(1,1)>¡Buenas! ¿Cómo estás?<clear><br><$voicel(1,7)><$motion(1,803)><$comeff(1,6)>Oye, ¿sabes si algún humano vive por aquí cerca?<clear><br><$motion(0,41)>... <wait(0.9)><$voicel(1,10)><$comeff(1,11)><$motion(1,817)>¿Eh? ¿Que no hay ni rastro de los humanos? ¿En serio?<br><$motion(1,807)><$comeff(1,7)><$voicel(1,4)>¡Qué locura, <gen;-2(tío,tía)>!<clear><br><$motion(1,802)><$motion(1,805)><$voicel(1,5)><$comeff(1,14)>Y yo que quería llenar mi casa <$voicel(1,8)><$motion(1,805)>de cosas brillantes y<br>relucientes...<clear><br><$motion(1,663)><$comeff(1,17)><$voicel(1,6)>Los humanos suelen guardar joyas, objetos de cristal...<br>¡sus casas están llenas de cosas geniales!<clear><br><$motion(1,801)><$comeff(1,10)><$voicel(1,3)>Pues nada, tendré que ingeniármelas de otra forma."

#. en: <$voicel(1,4)><$emotion(1,31)>What is this place?<clear><br><$voicel(1,1)><$facial(1,14)><$comeff(1,14)><$motion(1,806)>Where do we Pokémon come from, and where are we<br>headed?<slide><br><$voicel(1,4)><$motion(1,807)>... ... ...<clear><br><$voicel(1,7)><$emotion(1,14)>I can’t seem to stop myself from wondering about such<br>things. But for now, I’m not heading anywhere. In fact...<slide><br><$voicel(1,5)><$facial(1,4)><$comeff(1,10)><$motion(1,806)>I’m settling down right here!<clear><br><$voicel(1,7)><$emotion(1,27)>And you, dear—I’m not sure if you’re a human or a<br>Pokémon, <$voicel(1,10)><$emotion(1,8)>but I do hope we’ll have fun together!
msgctxt "3255:142"
msgid "<$voicel(1,4)><$emotion(1,31)>¿Dónde estoy?...<clear><br><$voicel(1,1)><$facial(1,14)><$comeff(1,14)><$motion(1,806)>Los Pokémon... ¿de dónde venimos y adónde vamos?<clear><br><$voicel(1,4)><$motion(1,807)>...<clear><br><$voicel(1,7)><$emotion(1,14)>Todo el día estoy dándole vueltas a eso, ¿eh?, pero tengo<br>claro que no voy a irme a ninguna parte...<slide><br><$voicel(1,5)><$facial(1,4)><$comeff(1,10)><$motion(1,806)>¡y voy a quedarme a vivir aquí!<clear><br><$voicel(1,7)><$emotion(1,27)>Y tú... No sé si eres Pokémon, human<gen;-2(o,a)> o qué, pero espero<br>que <$voicel(1,10)><$emotion(1,8)>te quedes a pasar un buen ratillo conmigo."
msgstr "<$voicel(1,4)><$emotion(1,31)>¿Dónde estoy?...<clear><br><$voicel(1,1)><$facial(1,14)><$comeff(1,14)><$motion(1,806)>Los Pokémon... ¿de dónde venimos y adónde vamos?<clear><br><$voicel(1,4)><$motion(1,807)>...<clear><br><$voicel(1,7)><$emotion(1,14)>Todo el día estoy dándole vueltas a eso, ¿eh?, pero tengo<br>claro que no voy a irme a ninguna parte...<slide><br><$voicel(1,5)><$facial(1,4)><$comeff(1,10)><$motion(1,806)>¡y voy a quedarme a vivir aquí!<clear><br><$voicel(1,7)><$emotion(1,27)>Y tú... No sé si eres Pokémon, human<gen;-2(o,a)> o qué, pero espero<br>que <$voicel(1,10)><$emotion(1,8)>te quedes a pasar un buen ratito conmigo."

#. en: <$voicel(1,4)>WoOoOoOoOoOoO...<wait(0.8)> <$voicel(1,4)><$voicel(1,2)>Aaaaaagggh!<wait(0.8)><$voicel(1,8)> Screeee!<clear><br>...<wait(0.4)> ...<wait(0.4)> ...<br>...<$lookat(1,1,0)><waitactor(1)><$voicel(1,4)><$comeff(1,7)>Seriously?<clear><br><$voicel(1,5)><$emotion(1,51)>All that and you’re not spooked at all? Not even a little<br>bit startled?<clear><br><$voicel(1,4)><$emotion(1,14)>Wow...you’re a tough nut to crack.<clear><br><$voicel(1,9)><$emotion(1,8)>Well, I’ll scare you one of these days. In the meantime,<br>I hope we can be friends.
msgctxt "3255:143"
msgid "<$voicel(1,4)>Buuuuuu... <$voicel(1,4)><$voicel(1,2)>Buuu... <wait(0.8)><$voicel(1,8)>¡Buuuuuu! <wait(0.4)>... <wait(0.4)>...<clear><br>... <$lookat(1,1,0)><waitactor(1)><$voicel(1,4)><$comeff(1,7)>Pfff... Yo aquí intentando asustarte, y nada...<clear><br><$voicel(1,5)><$emotion(1,51)>Ni te das por aludid<gen;-2(o,a)>... <$voicel(1,4)><$emotion(1,14)>Eres dur<gen;-2(o,a)> de roer, ¿eh?<clear><br><$voicel(1,9)><$emotion(1,8)>Algún día lograré pillarte desprevenid<gen;-2(o,a)>, ya lo verás,<br>pero, de momento, si quieres ser mi amig<gen;-2(o,a)>, adelante."
msgstr "<$voicel(1,4)>Buuuuuu... <$voicel(1,4)><$voicel(1,2)>Buuu... <wait(0.8)><$voicel(1,8)>¡Buuuuuu! <wait(0.4)>... <wait(0.4)>...<clear><br>... <$lookat(1,1,0)><waitactor(1)><$voicel(1,4)><$comeff(1,7)>Pfff... Yo aquí intentando asustarte, y nada...<clear><br><$voicel(1,5)><$emotion(1,51)>Ni te das por aludid<gen;-2(o,a)>... <$voicel(1,4)><$emotion(1,14)>Eres dur<gen;-2(o,a)> de roer, ¿eh?<clear><br><$voicel(1,9)><$emotion(1,8)>Algún día lograré agarrarte desprevenid<gen;-2(o,a)>, ya lo verás,<br>pero, de momento, si quieres ser mi amig<gen;-2(o,a)>, adelante."

#. en: <$voicel(1,7)><$emotion(1,49)>Gira! Lovely to meet you! I was just checking this<br>area out.<clear><br><$voicel(1,5)><$emotion(1,8)>Actually, I plan to LIVE here—so I expect I’ll be seeing<br>you around!<clear><br><$voicel(1,4)><$emotion(1,14)><$facial(1,1)>Oh, where are my manners? My tail needs to greet you<br>as well...<turn(1,180)><clear><br><waitactor(1)><$motion(1,803)><$voicel(1,10)>Farig!<clear><br><turn(1,180)><waitactor(1)><$voicel(1,5)><$comeff(1,4)><$motion(1,805)>Oh dear! Looks like the little dear’s in a bad mood. Sorry<br>it turned away from you like that!<clear><br><$voicel(1,7)><$emotion(1,38)>It’s usually much better behaved, so I hope we can all<br>be friends!
msgctxt "3255:144"
msgid "<$voicel(1,7)><$emotion(1,49)>¡Giraf! ¡Encantad<gen;-3(o,a)>! ¿Qué tal? Estaba echando un ojillo por<br>la zona.<clear><br><$voicel(1,5)><$emotion(1,8)>Y pensándolo bien... acabo de decidir que voy a vivir<br>aquí.<clear><br><$voicel(1,4)><$emotion(1,14)><$facial(1,1)>Oy, perdona, debería presentarte también a mi cola,<br>qué cabeza la mía...<turn(1,180)><clear><br><waitactor(1)><$motion(1,803)><$voicel(1,10)>Farig...<clear><br><turn(1,180)><waitactor(1)><$voicel(1,5)><$comeff(1,4)><$motion(1,805)>Vaya, ¿está vergonzosa hoy? Anda que... Mira que es<br>maleducada.<clear><br><$voicel(1,7)><$emotion(1,38)>En fin, otro día estará de mejor humor. ¡Nos vemos!"
msgstr "<$voicel(1,7)><$emotion(1,49)>¡Giraf! ¡Encantad<gen;-3(o,a)>! ¿Qué tal? Estaba echando un ojito por<br>la zona.<clear><br><$voicel(1,5)><$emotion(1,8)>Y pensándolo bien... acabo de decidir que voy a vivir<br>aquí.<clear><br><$voicel(1,4)><$emotion(1,14)><$facial(1,1)>Oy, perdona, debería presentarte también a mi cola,<br>qué cabeza la mía...<turn(1,180)><clear><br><waitactor(1)><$motion(1,803)><$voicel(1,10)>Farig...<clear><br><turn(1,180)><waitactor(1)><$voicel(1,5)><$comeff(1,4)><$motion(1,805)>Vaya, ¿está vergonzosa hoy? Ay... Mira que es<br>maleducada.<clear><br><$voicel(1,7)><$emotion(1,38)>En fin, otro día estará de mejor humor. ¡Nos vemos!"

#. en: <$voicel(1,5)><$emotion(1,27)>Well, steel my nerves! This place is—<clear><br><$voicel(1,1)><$emotion(1,66)>Wait, what is this place? Hey, you over there! Yeah, you!<br>Any idea where we are?<clear><br><$voicel(1,7)><$emotion(1,14)>What?!<clear><br><$voicel(1,9)><$emotion(1,38)>Ya made this new home here jus’ fer me? Now that sure<br>was nice of ya!<clear><br><$voicel(1,7)><$comeff(1,9)><$motion(1,816)>I’mma have to do somethin’ fer you as well, then!
msgctxt "3255:145"
msgid "<$voicel(1,5)><$emotion(1,27)>¡Oooh! ¡Este lugar es...!<clear><br><$voicel(1,1)><$emotion(1,66)>¿Qué lugar es este? ¿Lo sabes tú?<clear><br><$voicel(1,7)><$emotion(1,14)>¿Cómo dices? ¿Que has preparado esto para mí? <clear><br><$voicel(1,9)><$emotion(1,38)>¡Eso sí es generosidad y lo demás son tonterías!<clear><br><$voicel(1,7)><$comeff(1,9)>¡<$motion(1,816)>Pues yo también tendré que hacer algo por ti, jovenzuel<gen;-2(o,a)>!<br>Favor con favor se paga."
msgstr "<$voicel(1,5)><$emotion(1,27)>¡Oooh! ¡Este lugar es...!<clear><br><$voicel(1,1)><$emotion(1,66)>¿Qué lugar es este? ¿Lo sabes tú?<clear><br><$voicel(1,7)><$emotion(1,14)>¿Cómo dices? ¿Que preparaste esto para mí? <clear><br><$voicel(1,9)><$emotion(1,38)>¡Eso sí es generosidad y lo demás son tonterías!<clear><br><$voicel(1,7)><$comeff(1,9)>¡<$motion(1,816)>Pues yo también tendré que hacer algo por ti, jovenzuel<gen;-2(o,a)>!<br>Favor con favor se paga."

#. en: ...<$voicel(1,4)><$emotion(1,27)><$pkcry;0(1,4)>!<clear><br><$voicel(1,1)><$emotion(1,58)>You startled me! Just what exactly are you?! If you’re<br>planning to attack me, then—<$voicel(1,4)><$facial(1,7)><$motion(1,814)><$voicel(1,4)>*swish!<wait(0.9)><wait(0.4)> <$motion(1,815)><$voicel(1,2)>swish!*<clear><br><$voicel(1,2)><$motion(1,802)>You’ll soon find yourself prey to my pincers!<clear><br><$voicel(1,5)><$emotion(1,41)>Hmmm... That relaxed stance...<$voicel(1,4)><$comeff(1,14)>and that unconcerned<br>expression...<clear><br><$voicel(1,10)><$emotion(1,14)>Heh. I’m impressed. <$voicel(1,9)><$emotion(1,8)>I seem to have found myself a worthy<br>rival. I look forward to whatever lies ahead of us.
msgctxt "3255:146"
msgid "...<$voicel(1,4)><$emotion(1,27)> ¡<$pkcry;0(1,4)>!<clear><br><$voicel(1,1)><$emotion(1,58)>Menudo sobresalto... ¡¿Se puede saber quién eres?!<br>Si te propones agredirme... <$voicel(1,4)><$facial(1,7)><$motion(1,814)><$voicel(1,4)>¡Zas!<wait(0.9)><wait(0.4)> <$motion(1,815)><$voicel(1,2)>¡Zas!<clear><br><$voicel(1,2)><$motion(1,802)>¡Serás presa de mis pinzas!<clear><br><$voicel(1,5)><$emotion(1,41)>Qué porte tan natural... <wait(0.9)><$voicel(1,4)><$comeff(1,14)>y qué semblante tan impertérrito...<br><wait(0.9)><$voicel(1,10)><$emotion(1,14)>Hmm... Se ve que estás a mi altura.<clear><br><$voicel(1,9)><$emotion(1,8)>Je, por lo visto he encontrado <gen;-2(un,una)> rival formidable.<br>Ardo en deseos de ver qué nos tiene reservado el futuro."
msgstr "...<$voicel(1,4)><$emotion(1,27)> ¡<$pkcry;0(1,4)>!<clear><br><$voicel(1,1)><$emotion(1,58)>Qué sobresalto... ¡¿Se puede saber quién eres?!<br>Si te propones agredirme... <$voicel(1,4)><$facial(1,7)><$motion(1,814)><$voicel(1,4)>¡Zas!<wait(0.9)><wait(0.4)> <$motion(1,815)><$voicel(1,2)>¡Zas!<clear><br><$voicel(1,2)><$motion(1,802)>¡Serás presa de mis pinzas!<clear><br><$voicel(1,5)><$emotion(1,41)>Qué porte tan natural... <wait(0.9)><$voicel(1,4)><$comeff(1,14)>y qué semblante tan impertérrito...<br><wait(0.9)><$voicel(1,10)><$emotion(1,14)>Hmm... Se ve que estás a mi altura.<clear><br><$voicel(1,9)><$emotion(1,8)>Je, por lo visto he encontrado <gen;-2(un,una)> rival formidable.<br>Ardo en deseos de ver qué nos tiene reservado el futuro."

#. en: <$voicel(1,3)><$emotion(1,64)>Huh? Who are you?! More importantly, where are we?!<br>Well...<$voicel(1,6)><$emotion(1,14)>I guess there’s no need to sweat the small stuff.<clear><br><$voicel(1,9)><$emotion(1,8)>Get a load of this nice tree! I feel like I could live here for<br>a while—and have a good time while I’m at it!<clear><br><$voicel(1,2)><$emotion(1,55)>Say, bud, you seem like an interestin’ character! <$voicel(1,6)><$facial(1,4)><$comeff(1,3)>I’m sure<br>you’re gonna do some great things! <$voicel(1,10)><$emotion(1,38)>That’s the vibe I’m<slide><br>pickin’ up with my antennae!
msgctxt "3255:147"
msgid "<$voicel(1,3)><$emotion(1,64)>Oye, ¿tú quién eres? O mejor dicho, ¿dónde estoy?<clear><br><$voicel(1,6)><$emotion(1,14)>Bah, ¿qué más da? ¡A la porra los detalles triviales!<clear><br><$voicel(1,9)><$emotion(1,8)>Con este árbol que me he topado, ¡me voy a pegar<br>la vidorra padre!<clear><br><$voicel(1,2)><$emotion(1,55)>Eres <gen;-2(un,una)> tip<gen;-2(o,a)> bien curios<gen;-2(o,a)>, oye. <$voicel(1,6)><$facial(1,4)><$comeff(1,3)>¡Me da a mí en las<br>antenas <$voicel(1,10)><$emotion(1,38)>que harás grandes cosas en esta vida!"
msgstr "<$voicel(1,3)><$emotion(1,64)>Oye, ¿tú quién eres? O mejor dicho, ¿dónde estoy?<clear><br><$voicel(1,6)><$emotion(1,14)>Bah, ¿qué más da? ¡A la porra los detalles triviales!<clear><br><$voicel(1,9)><$emotion(1,8)>Con este árbol que me encontré, ¡me voy a dar<br>la gran vida!<clear><br><$voicel(1,2)><$emotion(1,55)>Eres <gen;-2(un,una)> tip<gen;-2(o,a)> bien curios<gen;-2(o,a)>, oye. <$voicel(1,6)><$facial(1,4)><$comeff(1,3)>¡Me da a mí en las<br>antenas <$voicel(1,10)><$emotion(1,38)>que harás grandes cosas en esta vida!"

#. en: <$voicel(1,5)><$emotion(1,14)>Oh, look, a human! Or wait...are you a Pokémon?<br><$voicel(1,4)><$comeff(1,6)>Oh, so you’re LOOKING for humans, huh?<clear><br><$voicel(1,1)><$emotion(1,65)>I was actually made by humans, <$voicel(1,6)><$emotion(1,31)>but I don’t know where<br>they’ve all gone.<clear><br><$voicel(1,7)><$emotion(1,65)>They were smart enough to make a construct as amazing as<br>me, <$voicel(1,8)><$comeff(1,3)>but they still did some pretty quirky stuff!<clear><br><$voicel(1,4)><$motion(1,806)>Like staying up all night and being late in the morning,<br><$voicel(1,10)><$emotion(1,38)>or gobbling up all their snacks!
msgctxt "3255:149"
msgid "<$voicel(1,5)><$emotion(1,14)>Ah, <gen;-2(un,una)> human<gen;-2(o,a)>... ¿O no? ¿Eres un Pokémon?...<wait(0.9)><br><$voicel(1,4)><$comeff(1,6)>¿Y estás buscando a los humanos?<clear><br><$voicel(1,1)><$emotion(1,65)>A mí me crearon unos humanos... <wait(0.9)><$voicel(1,6)><$emotion(1,31)>pero no sé dónde están.<clear><br><$voicel(1,8)><$comeff(1,3)>No pillo a los humanos, son todo un misterio. <$voicel(1,7)><$emotion(1,65)>¡Lo mismo<br>se pasan la noche entera sin dormir jugando a la consola<slide><br>que crean máquinas increíbles, como yo!<clear><br><$voicel(1,4)><$motion(1,806)>Llegan tarde a los sitios y comen aun sin tener hambre...<br><$voicel(1,10)><$emotion(1,38)>¡Qué irónico, con lo listos que son!"
msgstr "<$voicel(1,5)><$emotion(1,14)>Ah, <gen;-2(un,una)> human<gen;-2(o,a)>... ¿O no? ¿Eres un Pokémon?...<wait(0.9)><br><$voicel(1,4)><$comeff(1,6)>¿Y estás buscando a los humanos?<clear><br><$voicel(1,1)><$emotion(1,65)>A mí me crearon unos humanos... <wait(0.9)><$voicel(1,6)><$emotion(1,31)>pero no sé dónde están.<clear><br><$voicel(1,8)><$comeff(1,3)>No entiendo a los humanos, son todo un misterio. <$voicel(1,7)><$emotion(1,65)>¡Lo mismo<br>se pasan la noche entera sin dormir jugando videojuegos<slide><br>que crean máquinas increíbles, como yo!<clear><br><$voicel(1,4)><$motion(1,806)>Llegan tarde a los lugares y comen aun sin tener hambre...<br><$voicel(1,10)><$emotion(1,38)>¡Qué irónico, con lo listos que son!"

#. en: <$voicel(1,7)><$comeff(1,6)>Hey, did you <$motion(1,803)>make this place for me?<clear><br><$motion(1,816)><$voicel(1,8)>Hup! <wait(1.0)><$motion(1,814)><$voicel(1,8)>Hyah! <wait(0.7)><$motion(1,817)><wait(0.4)><$comeff(1,10)><$voicel(1,9)>YAAAH!<clear><br><$motion(1,806)><$voicel(1,8)><$comeff(1,9)>Awww yeah, that’s the stuff! Perfect!<clear><br><$motion(1,805)><$voicel(1,9)><$comeff(1,10)>If I train here, I bet I can master any fighting move!<br><$motion(1,801)><$voicel(1,8)><$comeff(1,13)>Thanks a bunch!
msgctxt "3255:150"
msgid "<$voicel(1,7)>¡Hola! <$motion(1,803)><$comeff(1,6)>¿Este lugar tan chulo lo has preparado tú?<br><$motion(1,816)><$voicel(1,8)>¡Kia! <wait(1.0)><$motion(1,814)><$voicel(1,8)>¡Kiaa! <wait(0.7)><$motion(1,817)><wait(0.4)><$comeff(1,10)><$voicel(1,9)>¡Kiaaa! <$motion(1,806)><$voicel(1,8)><$comeff(1,9)>¡Sí! ¡Genial! ¡Perfecto!<clear><br><$motion(1,805)><$voicel(1,9)><$comeff(1,10)>¡Aquí podré entrenar y dominar todas las artes marciales<br>habidas y por haber! <$motion(1,801)><$voicel(1,8)><$comeff(1,13)>¡Muchas gracias!"
msgstr "<$voicel(1,7)>¡Hola! <$motion(1,803)><$comeff(1,6)>¿Este lugar tan genial lo preparaste tú?<br><$motion(1,816)><$voicel(1,8)>¡Kia! <wait(1.0)><$motion(1,814)><$voicel(1,8)>¡Kiaa! <wait(0.7)><$motion(1,817)><wait(0.4)><$comeff(1,10)><$voicel(1,9)>¡Kiaaa! <$motion(1,806)><$voicel(1,8)><$comeff(1,9)>¡Sí! ¡Genial! ¡Perfecto!<clear><br><$motion(1,805)><$voicel(1,9)><$comeff(1,10)>¡Aquí podré entrenar y dominar todas las artes marciales<br>habidas y por haber! <$motion(1,801)><$voicel(1,8)><$comeff(1,13)>¡Muchas gracias!"

#. en: <$voicel(1,4)><$facial(1,4)><$comeff(1,9)>Whoooaaa. Whether you’re looking from above...<wait(0.4)><$motion(1,807)>or below,<br>this place is the best!<clear><br><$voicel(1,6)><$facial(1,1)><$comeff(1,5)>Oh, hi there! Nice to meetcha!<clear><br><$voicel(1,7)><$emotion(1,8)>Hey, check out my home! Just perfect for me, isn’t it?<clear><br><$voicel(1,9)><$facial(1,4)><$comeff(1,8)><$motion(1,816)>I could look at it while doing handstands or spinning—no<br>matter what, I’ll never get sick of this view!<clear><br><$voicel(1,7)><$emotion(1,14)>Heh heh, I’m gonna keep living here from now on, so I<br>hope you’ll come visit sometimes!
msgctxt "3255:151"
msgid "<$voicel(1,4)><$facial(1,4)><$comeff(1,9)>Hmm... Da igual que la mire del derecho que del revés...<br><wait(0.4)><$motion(1,807)>¡Está genial!<clear><br><$voicel(1,6)><$facial(1,1)><$comeff(1,5)>¡Uy, no te había visto! ¡Hola!<clear><br><$voicel(1,7)><$emotion(1,8)>¡Mira esto, miraaa! ¿Qué te parece mi nueva casa?<br>¿No crees que es perfecta para mí?<clear><br><$voicel(1,9)><$facial(1,4)><$comeff(1,8)><$motion(1,816)>Puedo hacer el pino, dar mil vueltas, y sigue siendo ideal.<br>¡Podría admirarla durante horas!<clear><br><$voicel(1,7)><$emotion(1,14)>¡A partir de hoy viviré aquí! ¡Ven a verme cuando quieras!"
msgstr "<$voicel(1,4)><$facial(1,4)><$comeff(1,9)>Hmm... Da igual que la mire del derecho que del revés...<br><wait(0.4)><$motion(1,807)>¡Está genial!<clear><br><$voicel(1,6)><$facial(1,1)><$comeff(1,5)>¡Uy, no te había visto! ¡Hola!<clear><br><$voicel(1,7)><$emotion(1,8)>¡Mira esto, miraaa! ¿Qué te parece mi nueva casa?<br>¿No crees que es perfecta para mí?<clear><br><$voicel(1,9)><$facial(1,4)><$comeff(1,8)><$motion(1,816)>Me pongo de cabeza, doy mil vueltas, y sigue siendo ideal.<br>¡Podría admirarla durante horas!<clear><br><$voicel(1,7)><$emotion(1,14)>¡A partir de hoy viviré aquí! ¡Ven a verme cuando quieras!"

#. en: <$voicel(1,1)><$emotion(1,31)>Ugh... Why do I feel so...weak?<$voicel(1,8)><$emotion(1,8)> Guess I’ll try<br>some exercise...<clear><br><$voicel(1,5)><$emotion(1,14)>Oh! Hey, you there! Wanna work out together? It’s easy!<wait(0.4)><$comeff(0,14)><$motion(0,831)><wait(1.2)><$comeff(0,20)><$motion(0,832)><clear><br><$voicel(1,9)><$motion(1,860)><$motion(0,228)>Swing your arms around and go BZZZT!<br><$voicel(1,4)>BZZZT BZZZT BZZZZZZT!<clear><br><$voicel(1,3)><$emotion(1,27)><$motion(0,286)>Uh, I’m not really sure what you were doing, but I could<br>tell you were going all out!<clear><br><$voicel(1,9)><$emotion(1,38)>Keep that energy up!
msgctxt "3255:152"
msgid "<$voicel(1,1)><$emotion(1,31)>Uf, me noto baj<gen;-3(o,a)> de energía... <$voicel(1,8)><$emotion(1,8)>¡Hora de entrenar!<clear><br><$voicel(1,5)><$emotion(1,14)>¡Ey, tú! ¡Sí, tú! ¿Te ape ser mi compi de entrenamiento?<wait(0.4)><$comeff(0,14)><$motion(0,831)><wait(1.2)><$comeff(0,20)><$motion(0,832)><clear><br><$voicel(1,9)><$motion(1,860)><$motion(0,228)>Venga, ¡a girar esos bracitos tuyos! Uno, dos, uno, dos...<br><$voicel(1,4)>¡¡y a echar chispas!!<clear><br><$voicel(1,3)><$emotion(1,27)><$motion(0,286)>Hmm... Pues parece que no se te da del todo bien,<br>¡pero al menos lo has intentado!<clear><br><$voicel(1,9)><$emotion(1,38)>¡La próxima vez, más y mejor!"
msgstr "<$voicel(1,1)><$emotion(1,31)>Uf, me siento baj<gen;-3(o,a)> de energía... <$voicel(1,8)><$emotion(1,8)>¡Hora de entrenar!<clear><br><$voicel(1,5)><$emotion(1,14)>¡Ey, tú! ¡Sí, tú! ¿Quieres entrenar conmigo?<wait(0.4)><$comeff(0,14)><$motion(0,831)><wait(1.2)><$comeff(0,20)><$motion(0,832)><clear><br><$voicel(1,9)><$motion(1,860)><$motion(0,228)>Vamos, ¡a girar esos bracitos tuyos! Uno, dos, uno, dos...<br><$voicel(1,4)>¡¡y a echar chispas!!<clear><br><$voicel(1,3)><$emotion(1,27)><$motion(0,286)>Hmm... Pues parece que no se te da del todo bien,<br>¡pero al menos lo intentaste!<clear><br><$voicel(1,9)><$emotion(1,38)>¡La próxima vez, más y mejor!"

#. en: <$voicel(1,5)><$emotion(1,14)>Magby! ♪ Nice to meet you! I’m just taking a break<br>right now.<clear><br><$voicel(1,3)><$emotion(1,51)>I JUST woke up, so if I let myself get too excited I would<br>only get tired again.<clear><br><$voicel(1,9)><$emotion(1,8)>This home is nice ’n’ toasty, which is perfect for times<br>like this!
msgctxt "3255:153"
msgid "<$voicel(1,5)><$emotion(1,14)>¡Mag, mag! ¿Qué tal? Me has pillado descansando un<br>rato.<clear><br><$voicel(1,3)><$emotion(1,51)>Llevo jugueteando desde que me he despertado y estoy<br>agotad<gen;-3(o,a)>...<clear><br><$voicel(1,9)><$emotion(1,8)>Nada como un lugar calentito para descansar a gustito."
msgstr "<$voicel(1,5)><$emotion(1,14)>¡Mag, mag! ¿Qué tal? Me encontraste descansando un<br>rato.<clear><br><$voicel(1,3)><$emotion(1,51)>Llevo jugueteando desde que me desperté y estoy<br>agotad<gen;-3(o,a)>...<clear><br><$voicel(1,9)><$emotion(1,8)>Nada como un lugar calentito para descansar a gustito."

#. en: <$voicel(1,7)><$emotion(1,8)>What a lovely place this is! A perfect spot to gather<br>everyone for a nice rest. <$voicel(1,5)><$motion(1,805)><$comeff(1,10)>It’s just so peaceful!<clear><br><$voicel(1,3)><$emotion(1,14)>Why, look at this! Hello there, you! <$voicel(1,2)><$comeff(1,6)>Are you OK? You’re<br>not tired, are you? ...<$voicel(1,8)><$motion(1,805)><$comeff(1,5)><$facial(1,4)>No, you look just full of beans!<clear><br><$voicel(1,9)><$emotion(1,39)>You know what, I think I might just start living here! Come<br>and see me anytime!
msgctxt "3255:154"
msgid "<$voicel(1,7)><$emotion(1,8)>¡Este lugar es fantástico! Muy tranquilo y acogedor,<br><$voicel(1,5)><$motion(1,805)><$comeff(1,10)>perfecto para que cualquiera se tome un respiro.<clear><br><$voicel(1,3)><$emotion(1,14)>¡Oh, hola, jovenzuel<gen;-2(o,a)>! <$voicel(1,2)><$comeff(1,6)>Dime, ¿te encuentras bien?<br>¿No andarás algo cansad<gen;-2(o,a)>?<clear><br><$voicel(1,8)><$motion(1,805)><$comeff(1,5)><$facial(1,4)>Vaya, por lo que veo estás a rebosar de energía.<clear><br><$voicel(1,9)><$emotion(1,39)>Por cierto, creo que voy a quedarme a vivir por aquí.<br>Ven a verme de vez en cuando, ¿vale?"
msgstr "<$voicel(1,7)><$emotion(1,8)>¡Este lugar es fantástico! Muy tranquilo y acogedor,<br><$voicel(1,5)><$motion(1,805)><$comeff(1,10)>perfecto para que cualquiera se tome un respiro.<clear><br><$voicel(1,3)><$emotion(1,14)>¡Oh, hola, jovenzuel<gen;-2(o,a)>! <$voicel(1,2)><$comeff(1,6)>Dime, ¿te encuentras bien?<br>¿No andarás algo cansad<gen;-2(o,a)>?<clear><br><$voicel(1,8)><$motion(1,805)><$comeff(1,5)><$facial(1,4)>Vaya, por lo que veo estás a rebosar de energía.<clear><br><$voicel(1,9)><$emotion(1,39)>Por cierto, creo que voy a quedarme a vivir por aquí.<br>Ven a verme de vez en cuando, ¿sí?"

#. en: ...<$voicel(1,7)><$emotion(1,27)>Oh hey, bud! I’ve been watchin’ your adventures!<clear><br><$facial(1,9)><$voicel(1,3)><$comeff(1,14)><$motion(1,666)>You’ve been workin’ hard waterin’ plants and makin’ lots of<br>stuff for everybody! <$voicel(1,6)><$facial(1,4)>Looks like you’re havin’ a blast!<slide><br><$voicel(1,8)><$emotion(1,49)>Yeah, watchin’ ya puts a real smile on my face, bud!<clear><br><$voicel(1,9)><$emotion(1,8)>I bet I could see even MORE fun stuff if I was right down<br>here with ya!
msgctxt "3255:155"
msgid "<$voicel(1,7)><$emotion(1,27)>Oh, si eres tú.<clear><br>He estado siguiendo todas tus aventuras hasta la fecha.<clear><br><$facial(1,9)><$voicel(1,3)><$comeff(1,14)><$motion(1,666)>He visto lo mucho que te has esforzado por hacer más<br>cómodas las vidas de los Pokémon y las muchas sonrisas<slide><br>que has logrado sacarles.<clear><br><$voicel(1,6)><$facial(1,4)>¡Verte en acción es un auténtico deleite!<clear><br><$voicel(1,8)><$emotion(1,49)><$voicel(1,9)><$emotion(1,8)>Por eso he decidido permanecer cerca de ti y seguir tus<br>divertidas aventuras de cerca."
msgstr "<$voicel(1,7)><$emotion(1,27)>Oh, si eres tú.<clear><br>He estado siguiendo todas tus aventuras hasta la fecha.<clear><br><$facial(1,9)><$voicel(1,3)><$comeff(1,14)><$motion(1,666)>He visto lo mucho que te has esforzado por hacer más<br>cómodas las vidas de los Pokémon y las muchas sonrisas<slide><br>que has logrado sacarles.<clear><br><$voicel(1,6)><$facial(1,4)>¡Verte en acción es un auténtico deleite!<clear><br><$voicel(1,8)><$emotion(1,49)><$voicel(1,9)><$emotion(1,8)>Por eso decidí permanecer cerca de ti y seguir tus<br>divertidas aventuras de cerca."

#. en: <$voicel(1,5)><$emotion(1,29)>How do ya feel about takin’ me to where you live?
msgctxt "3255:156"
msgid "<$voicel(1,5)><$emotion(1,29)>He decidido mudarme más cerca de donde vives.<br>¿Te supondría mucha molestia acompañarme hasta allí?"
msgstr "<$voicel(1,5)><$emotion(1,29)>Decidí mudarme más cerca de donde vives.<br>¿Te supondría mucha molestia acompañarme hasta allá?"

#. en: <$voicel(1,7)><$emotion(1,38)>Awesome! Thanks, bud! I’ll follow your lead, then!
msgctxt "3255:157"
msgid "<$voicel(1,7)><$emotion(1,38)>¡Mil gracias! Indícame el camino y yo te sigo."
msgstr ""

#. en: <$voicel(1,3)><$comeff(1,3)><$motion(1,806)>Oh, OK... Well, you do seem always busy with somethin’<br>or other!<clear><br><$voicel(1,7)><$comeff(1,9)><$motion(1,803)>I’ll be waitin’ right here, so lemme know if you ever<br>change your mind!
msgctxt "3255:158"
msgid "<$voicel(1,3)><$comeff(1,3)><$motion(1,806)>Debería haber supuesto que estarías muy ocupad<gen;-2(o,a)>,<br>siempre andas de un lado para otro...<clear><br><$voicel(1,7)><$comeff(1,9)><$motion(1,803)>No pasa nada, yo seguiré aquí, por si más adelante<br>tienes tiempo."
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,14)>...Oh! I daresay it’s been a while since I’ve spoken with<br>another Pokémon.<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,666)>I’ve been here for such a long time, after all. Interacting<br>with another Pokémon feels quite nostalgic...<clear><br><$voicel(1,7)><$emotion(1,38)>Hmmm. I suppose this is as good an opportunity as any<br>to go outside.
msgctxt "3255:159"
msgid "<$voicel(1,7)><$emotion(1,14)>Oh, hacía eones que no cruzaba palabra con otro<br>Pokémon.<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Llevaba tanto tiempo aguardando aquí que anhelaba<br>interactuar con alguien.<clear><br><$voicel(1,7)><$emotion(1,38)>Hm... ¿Sabes qué? Creo que esto es una señal de que<br>he de pasar más tiempo fuera, acompañad<gen;-3(o,a)> de otros."
msgstr "<$voicel(1,7)><$emotion(1,14)>Oh, hacía eones que no cruzaba palabra con otro<br>Pokémon.<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Llevaba tanto tiempo aguardando aquí que anhelaba<br>interactuar con alguien.<clear><br><$voicel(1,7)><$emotion(1,38)>Hm... ¿Sabes qué? Creo que esto es una señal de que<br>he de pasar más tiempo afuera, acompañad<gen;-3(o,a)> de otros."

#. en: <$voicel(1,7)><$emotion(1,14)>Oh, so you usually spend time around other Pokémon?<clear><br><$voicel(1,5)><$motion(1,666)>If you wouldn’t mind, would you please <$voicel(1,4)><$emotion(1,29)>take me to where<br>you all live?
msgctxt "3255:160"
msgid "<$voicel(1,7)><$emotion(1,14)>De modo que tú normalmente vives acompañad<gen;-2(o,a)><br>de otros Pokémon. Interesante...<clear><br><$voicel(1,5)><$motion(1,666)>En ese caso, ¿te importaría si yo... también me instalara<br>contigo y con los demás?<clear><br><$voicel(1,4)><$emotion(1,29)>¿Podrías hacerme el favor de llevarme hasta allí?"
msgstr "<$voicel(1,7)><$emotion(1,14)>De modo que tú normalmente vives acompañad<gen;-2(o,a)><br>de otros Pokémon. Interesante...<clear><br><$voicel(1,5)><$motion(1,666)>En ese caso, ¿te importaría si yo... también me instalara<br>contigo y con los demás?<clear><br><$voicel(1,4)><$emotion(1,29)>¿Podrías hacerme el favor de llevarme hasta allá?"

#. en: <$voicel(1,7)><$emotion(1,38)>I’m very grateful. I’ll follow along now.
msgctxt "3255:161"
msgid "<$voicel(1,7)><$emotion(1,38)>Te lo agradezco. Adelante pues, muéstrame el camino."
msgstr ""

#. en: <$voicel(1,7)><$comeff(1,14)><$motion(1,666)>That’s a shame... I suppose I’ll carry on here for a while<br>longer. <$voicel(1,6)><$comeff(1,10)><$motion(1,803)>Please tell me if you ever change your mind.
msgctxt "3255:162"
msgid "<$voicel(1,7)><$comeff(1,14)><$motion(1,666)>Entiendo. Una auténtica lástima.<clear><br><$voicel(1,6)><$comeff(1,10)><$motion(1,803)>No obstante, si cambias de parecer, aquí seguiré."
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,14)>Well now, this is a surprise. I rarely see anyone around<br>here. How do you do?<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,805)>I was just beginning to grow weary of being on my own...<br>What curious timing.<clear><br><$voicel(1,7)><$emotion(1,39)>It’s been ages since I ventured out and about. Perhaps a<br>change of scenery will do me some good.
msgctxt "3255:163"
msgid "<$voicel(1,7)><$emotion(1,14)>Hola, encanto, ¿cómo estás? No esperaba encontrarme<br>a nadie por aquí...<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,805)>Has llegado justo cuando empezaba a aburrirme de<br>esta soledad.<clear><br><$voicel(1,7)><$emotion(1,39)>Ju, ju... Supongo que está bien salir al exterior de vez<br>en cuando."
msgstr "<$voicel(1,7)><$emotion(1,14)>Hola, encanto, ¿cómo estás? No esperaba encontrarme<br>a nadie por aquí...<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,805)>Llegaste justo cuando empezaba a aburrirme de<br>esta soledad.<clear><br><$voicel(1,7)><$emotion(1,39)>Ju, ju... Supongo que está bien salir al exterior de vez<br>en cuando."

#. en: <$voicel(1,5)><$emotion(1,14)>Where do you live, little one? Might I ask you <$voicel(1,4)><$comeff(1,6)><$motion(1,806)>to bring me<br>back with you?
msgctxt "3255:164"
msgid "<$voicel(1,5)><$emotion(1,14)>Dime, ¿dónde vives tú? Si no te importa, me gustaría<br>trasladarme allí...<clear><br><$voicel(1,4)><$comeff(1,6)><$motion(1,806)>¿Podrías mostrarme el camino, chiqui?"
msgstr "<$voicel(1,5)><$emotion(1,14)>Dime, ¿dónde vives tú? Si no te importa, me gustaría<br>trasladarme allá...<clear><br><$voicel(1,4)><$comeff(1,6)><$motion(1,806)>¿Podrías mostrarme el camino, chiqui?"

#. en: <$voicel(1,7)><$emotion(1,1)>Thank you. Well then, lead the way.
msgctxt "3255:165"
msgid "<$voicel(1,7)><$emotion(1,1)>Muchas gracias. En tal caso, te sigo."
msgstr ""

#. en: <$voicel(1,3)><$comeff(1,14)><$motion(1,666)>Oh dear, how disappointing. But I understand. I’ll stay<br>here, <$voicel(1,6)><$emotion(1,49)>so please come by again if you ever feel like it.
msgctxt "3255:166"
msgid "<$voicel(1,3)><$comeff(1,14)><$motion(1,666)>Pues qué lástima... Pero qué se le va a hacer...<br><wait(0.4)><$voicel(1,6)><$emotion(1,49)>Si cambias de idea más adelante, aquí estaré."
msgstr ""

#. en: <$voicel(1,4)><$motion(1,17)>Om nom nom...<wait(0.8)><$motion(1,19)><$voicel(1,10)><$facial(1,4)><$comeff(1,17)> Ahhh, that’s the stuff.<clear><br><$voicel(1,7)><$emotion(1,32)>Hey, you. Have you tried<$voicel(1,4)><$comeff(1,6)> the dirt here yet? <wait(0.3)><$voicel(1,8)><$facial(1,4)><$comeff(1,10)>Not gonna lie,<br>it’s pretty tasty!<clear><br><$voicel(1,1)><$emotion(1,27)>What?! You don’t eat dirt? Wow, that’s too bad...<wait(0.3)>for YOU!<clear><br><$voicel(1,7)><$facial(1,4)><$motion(1,806)><$comeff(1,10)>You’ve gotta eat a ton if you wanna grow big!
msgctxt "3255:167"
msgid "<$voicel(1,4)><$motion(1,17)>Ñam, ñam... <wait(0.8)><$motion(1,19)><$voicel(1,10)><$facial(1,4)><$comeff(1,17)>Ostras, está buenísima.<clear><br><$voicel(1,7)><$emotion(1,32)>¡Ey! <$voicel(1,4)><$comeff(1,6)>¿Has probado ya la tierra de por aquí?<br><$voicel(1,8)><$facial(1,4)><$comeff(1,10)>¡Está requetebuena!<clear><br><$voicel(1,1)><$emotion(1,27)>¿Qué? ¿Que no comes tierra? Pues tú te lo pierdes...<br><$voicel(1,7)><$facial(1,4)><$motion(1,806)><$comeff(1,10)>¡Quien no come tierra no crece!"
msgstr "<$voicel(1,4)><$motion(1,17)>Ñam, ñam... <wait(0.8)><$motion(1,19)><$voicel(1,10)><$facial(1,4)><$comeff(1,17)>Cielos, está buenísima.<clear><br><$voicel(1,7)><$emotion(1,32)>¡Ey! <$voicel(1,4)><$comeff(1,6)>¿Ya probaste la tierra de por aquí?<br><$voicel(1,8)><$facial(1,4)><$comeff(1,10)>¡Está requetebuena!<clear><br><$voicel(1,1)><$emotion(1,27)>¿Qué? ¿Que no comes tierra? Pues tú te lo pierdes...<br><$voicel(1,7)><$facial(1,4)><$motion(1,806)><$comeff(1,10)>¡Quien no come tierra no crece!"

#. en: <$voicel(1,5)><$emotion(1,27)>Uh, hi... We’ve never met, right...?<clear><br><$voicel(1,3)><$emotion(1,59)>Sorry if I’m a bit restless...<$voicel(1,6)><$facial(1,4)><$comeff(1,9)> I found myself the perfect home,<br>and I can hardly stop from <$voicel(1,10)><$emotion(1,60)>jumping with joy.<clear><br><$voicel(1,7)><$motion(1,806)><$comeff(1,14)>Heh heh... Maybe I don’t look it, but I really love bouncing<br>around, you know? <$voicel(1,6)><$comeff(1,10)><$motion(1,816)>I’m pretty fast, too!
msgctxt "3255:168"
msgid "<$voicel(1,5)><$emotion(1,27)>Uy... T-tú y yo no nos conocemos aún, ¿v-verdad?<br><$voicel(1,3)><$emotion(1,59)>Perdona... Soy un poco tímid<gen;-3(o,a)>...<clear><br><$voicel(1,6)><$facial(1,4)><$comeff(1,9)>He encontrado una casa estupenda... <$voicel(1,10)><$emotion(1,60)>Estoy tan content<gen;-3(o,a)><br>que quiero salir disparad<gen;-3(o,a)> de la emoción...<$voicel(1,7)><clear><br><$motion(1,806)><$comeff(1,14)>Je... Sé que no lo aparento, pero me puedo propulsar<br>superlejos... <$voicel(1,6)><$comeff(1,10)><$motion(1,816)>¡y a toda leche, además!"
msgstr "<$voicel(1,5)><$emotion(1,27)>Uy... T-tú y yo no nos conocemos aún, ¿v-verdad?<br><$voicel(1,3)><$emotion(1,59)>Perdona... Soy un poco tímid<gen;-3(o,a)>...<clear><br><$voicel(1,6)><$facial(1,4)><$comeff(1,9)>Encontré una casa estupenda... <$voicel(1,10)><$emotion(1,60)>Estoy tan content<gen;-3(o,a)><br>que quiero salir disparad<gen;-3(o,a)> de la emoción...<$voicel(1,7)><clear><br><$motion(1,806)><$comeff(1,14)>Je... Sé que no lo aparento, pero me puedo propulsar<br>superlejos... <$voicel(1,6)><$comeff(1,10)><$motion(1,816)>¡y a toda velocidad, además!"

#. en: <$voicel(1,8)><$motionoff(1,816)><$facial(1,8)><$comeff(1,10)><$textsize(2)>GRAAAR!</textsize><wait(0.5)><$motion(0,82)><$comeff(0,5)><$facial(0,13)><clear><br><$voicel(1,10)><$motionoff(1,804)><$comeff(1,10)><$textsize(2)>GRAWRAAAAR!</textsize><clear><br><$voicel(1,4)><$motionoff(1,805)><$comeff(1,17)><$facial(1,1)><$facial(0,1)><$textsize(0)>Phew...</textsize><clear><br><$voicel(1,10)><$motionoff(1,816)><$comeff(1,10)><$facial(1,8)><$textsize(2)>GUHPYAHHH!</textsize><clear><br><$voicel(1,7)><$motion(1,803)><$comeff(1,3)><$facial(1,13)>Oh? Hello? Someone there?! <wait(0.5)><$motion(0,749)><$voicel(1,4)><$emotion(1,59)>Sorry if I startled ya!<clear><br><$voicel(1,5)><$motionoff(1,807)><$comeff(1,10)><$facial(1,4)>If I don’t let out a hearty bellow after wakin’ up, I’ll be<br>sleepy all day. Y’know what I mean?<clear><br><$voicel(1,7)><$emotion(1,39)>I may not look it, but I’m actually quite a softie! <$voicel(1,10)><$motion(1,803)><$comeff(1,9)><$facial(1,5)>Hope ya<br>won’t be too scared of me, ya hear?
msgctxt "3255:169"
msgid "<$voicel(1,8)><$motionoff(1,816)><$facial(1,8)><$comeff(1,10)><$textsize(2)>¡Taaar!</textsize><wait(0.5)><$motion(0,82)><$comeff(0,5)><$facial(0,13)><clear><br><$voicel(1,10)><$motionoff(1,804)><$comeff(1,10)><$textsize(2)>¡Taaaaaar!</textsize><clear><br><$voicel(1,4)><$motionoff(1,805)><$comeff(1,17)><$facial(1,1)><$facial(0,1)><$textsize(0)>Uf...</textsize><clear><br><$voicel(1,10)><$motionoff(1,816)><$comeff(1,10)><$facial(1,8)><$textsize(2)>¡Taaaaaarrrgh!</textsize><clear><br><$voicel(1,7)><$motion(1,803)><$comeff(1,3)><$facial(1,13)>¿Eh? Vaya, ¡quién me iba a decir que había alguien<br>pululando por aquí!<wait(0.5)><$motion(0,749)><clear><br><$voicel(1,4)><$emotion(1,59)>¡Disculpa si por poco te da un patatús por mi culpa!<clear><br><$voicel(1,5)><$motionoff(1,807)><$comeff(1,10)><$facial(1,4)>Si no pego un buen grito matutino no soy Pokémon,<br>y ya se sabe que \"quien bien bosteza, bien se despereza\".<clear><br><$voicel(1,7)><$emotion(1,39)>Pero no te dejes llevar por las apariencias. ¡Soy más gentil<br>de lo que parezco a simple vista! <$voicel(1,10)><$motion(1,803)><$comeff(1,9)><$facial(1,5)>¡Tú no me tengas miedo!"
msgstr ""

#. en: <$voicel(1,10)><$emotion(1,8)>Torch!<clear><br><$voicel(1,7)><$emotion(1,14)>Hi there, human! Or...Pokémon? <$voicel(1,2)><$comeff(1,6)>Which is it?<br><$voicel(1,2)><$emotion(1,65)>Maybe I can tell if I peck you.<clear><br>...<$voicel(1,3)><$emotion(1,14)>Hee hee, sorry! I was just joking! I won’t peck you!<clear><br><$voicel(1,7)><$motion(1,805)>I’ll make it up to you by warming you up on cold days<br>with my nice, toasty tummy! <$voicel(1,8)><$emotion(1,6)>Come hug me any time!<slide><br><$pkcry;1(1,1)>!
msgctxt "3255:172"
msgid "<$voicel(1,10)><$emotion(1,8)>¡Tooorch! <$voicel(1,7)><$emotion(1,14)>¡Holita, human<gen;-2(o,a)>!<clear><br>Uy, ¿o eres un Pokémon?... <wait(0.9)><$voicel(1,2)><$comeff(1,6)>Hmm, no me queda claro...<br><$voicel(1,2)><$emotion(1,65)>Tal vez un buen picotazo me ayude a identificarte...<slide><br><$voicel(1,3)><$emotion(1,14)>¡Ji, ji! ¡Es bromi! No soy tan mal<gen;-3(o,a)>.<clear><br><$voicel(1,7)><$motion(1,805)>De hecho, soy supermaj<gen;-3(o,a)>, <$voicel(1,8)><$emotion(1,6)>y para demostrártelo te<br>prometo que te dejaré abrazarme en días fríos para<slide><br>darte calorcito con mi pancita. ¡<$pkcry;1(1,1)>!"
msgstr "<$voicel(1,10)><$emotion(1,8)>¡Tooorch! <$voicel(1,7)><$emotion(1,14)>¡Holita, human<gen;-2(o,a)>!<clear><br>Uy, ¿o eres un Pokémon?... <wait(0.9)><$voicel(1,2)><$comeff(1,6)>Hmm, no me queda claro...<br><$voicel(1,2)><$emotion(1,65)>Tal vez un buen picotazo me ayude a identificarte...<slide><br><$voicel(1,3)><$emotion(1,14)>¡Ji, ji! ¡Es broma! No soy tan mal<gen;-3(o,a)>.<clear><br><$voicel(1,7)><$motion(1,805)>De hecho, soy supersimpátic<gen;-3(o,a)>, <$voicel(1,8)><$emotion(1,6)>y para demostrártelo te<br>prometo que te dejaré abrazarme en días fríos para<slide><br>darte calorcito con mi pancita. ¡<$pkcry;1(1,1)>!"

#. en: <$voicel(1,7)><$motion(1,814)><$pkcry;0(1,1)>! It’s <$cdef(27)>Combusken</color> time, baby!<clear><br><$voicel(1,3)><$emotion(1,64)>Hm? Is someone watching?<clear><br><$lookat(1,1,0)><waitactor(1)><$voicel(1,8)><$comeff(1,5)>OH!<clear><br><$voicel(1,5)><$emotion(1,58)>Ahem! ...Hello there. Did you see that just now?<clear><br><$voicel(1,1)><$emotion(1,31)>That was just a little, uh, you know...greeting! A special<br>greeting. For you.<$voicel(1,8)><$emotion(1,14)> ’Cause we just met, get it?<clear><br><$voicel(1,1)><$emotion(1,58)>Definitely not something I do when no one’s around...
msgctxt "3255:173"
msgid "<$voicel(1,7)><$motion(1,814)>¡<$pkcry;0(1,1)>! ¡Aquí está <gen;-3(el,la)> magnífic<gen;-3(o,a)> Combusken!<clear><br><$voicel(1,3)><$emotion(1,64)>Hmm... Me da la impresión de que me están mirando...<clear><br><$lookat(1,1,0)><waitactor(1)><$voicel(1,8)><$comeff(1,5)>¡Ah!<clear><br><$voicel(1,5)><$emotion(1,58)>Ejem, ejem... Hola. ¿Me has visto?...<wait(0.9)> <$voicel(1,1)><$emotion(1,31)>Verás, lo de ahora<br>era... <wait(0.3)>¡era un saludo! Eso, ¡un saludo para ti!<clear><br><$voicel(1,8)><$emotion(1,14)>Como es la primera vez que nos vemos y tal, pues eso.<br><$voicel(1,1)><$emotion(1,58)>Vamos, que no es algo que haga cuando no hay nadie..."
msgstr "<$voicel(1,7)><$motion(1,814)>¡<$pkcry;0(1,1)>! ¡Aquí está <gen;-3(el,la)> magnífic<gen;-3(o,a)> Combusken!<clear><br><$voicel(1,3)><$emotion(1,64)>Hmm... Me da la impresión de que me están mirando...<clear><br><$lookat(1,1,0)><waitactor(1)><$voicel(1,8)><$comeff(1,5)>¡Ah!<clear><br><$voicel(1,5)><$emotion(1,58)>Ejem, ejem... Hola. ¿Me viste?...<wait(0.9)> <$voicel(1,1)><$emotion(1,31)>Verás, lo de ahora<br>era... <wait(0.3)>¡era un saludo! Eso, ¡un saludo para ti!<clear><br><$voicel(1,8)><$emotion(1,14)>Como es la primera vez que nos vemos y tal, pues eso.<br><$voicel(1,1)><$emotion(1,58)>Vamos, que no es algo que haga cuando no hay nadie..."

#. en: <$voicel(1,8)><$emotion(1,38)>Hahaha! <wait(0.8)><$voicel(1,10)><$motion(1,814)><$facial(0,13)><$comeff(0,5)>Another great day for a good old-fashioned<br>Blaze Kick!<clear><br><$voicel(1,3)><$emotion(1,58)><$facial(0,1)>Whoa, whoa, WHOA! Hey!<clear><br><$voicel(1,1)><$facial(1,1)><$motion(1,802)><$comeff(1,4)>One stray kick and I could’ve launched you into orbit just<br>now, bud!<clear><br><$voicel(1,7)><$emotion(1,65)>Huh. Now that I’m takin’ a good look around, <$voicel(1,8)><$emotion(1,14)>this place<br>looks real nice—perfect for me to live in!<slide><br><$voicel(1,10)><$emotion(1,38)>Glad I didn’t kick it down!
msgctxt "3255:174"
msgid "<$voicel(1,8)><$emotion(1,38)>¡Ja, ja, ja! <wait(0.8)><$voicel(1,10)><$motion(1,814)><$facial(0,13)><$comeff(0,5)>¡Hoy tampoco podía faltar una Patada Ígnea<br>bien puesta!<clear><br><$voicel(1,3)><$emotion(1,58)><$facial(0,1)>¡Ahí va! ¡Pa habernos matao!<clear><br><$voicel(1,1)><$facial(1,1)><$motion(1,802)><$comeff(1,4)>¡Fiu, por poco te envío al quinto pino de un patadón,<br>niñ<gen;-2(o,a)>!<clear><br><$voicel(1,7)><$emotion(1,65)>Oye, ahora que lo pienso, este sitio parece un buen lugar<br>para vivir... <$voicel(1,8)><$emotion(1,14)>¡No está pero que nada mal!<clear><br><$voicel(1,10)><$emotion(1,38)>¡Menos mal que no me lo he cargado entrenando!"
msgstr "<$voicel(1,8)><$emotion(1,38)>¡Ja, ja, ja! <wait(0.8)><$voicel(1,10)><$motion(1,814)><$facial(0,13)><$comeff(0,5)>¡Hoy tampoco podía faltar una Patada Ígnea<br>bien puesta!<clear><br><$voicel(1,3)><$emotion(1,58)><$facial(0,1)>¡Vaya! ¡Casi nos matamos!<clear><br><$voicel(1,1)><$facial(1,1)><$motion(1,802)><$comeff(1,4)>¡Fiu, por poco te mando a volar de un patadón,<br>amig<gen;-2(o,a)>!<clear><br><$voicel(1,7)><$emotion(1,65)>Oye, ahora que lo pienso, este rincón parece un buen lugar<br>para vivir... <$voicel(1,8)><$emotion(1,14)>¡No está pero que nada mal!<clear><br><$voicel(1,10)><$emotion(1,38)>¡Menos mal que no lo destruí entrenando!"

#. en: <$voicel(1,8)><$emotion(1,27)>Mmmmmm! This water is so tasty!<clear><br><$voicel(1,3)><$emotion(1,64)>Oh! Hi there—nice to meet you! Are you here for a drink<br>of water too?<clear><br><$voicel(1,1)><$emotion(1,41)>I was sooo thirsty until I found this place...<clear><br><$voicel(1,7)><$emotion(1,6)>The water here is great! One gulp and I’m totally<br>refreshed!<clear><br><$voicel(1,10)><$motion(1,806)><$comeff(1,10)>I’ve definitely found where I want to live!
msgctxt "3255:175"
msgid "<$voicel(1,8)><$emotion(1,27)>¡Ahí va, pero qué agua más rica!<clear><br><$voicel(1,3)><$emotion(1,64)>Ah, hola. ¿Tú también has venido a beber de aquí?<clear><br><$voicel(1,1)><$emotion(1,41)>Hace un rato estaba que me moría de sed, <$voicel(1,7)><$emotion(1,6)>¡pero esta agua<br>me ha devuelto a la vida, como quien dice!<clear><br><$voicel(1,10)><$motion(1,806)><$comeff(1,10)>¡Cómo me alegro de haber encontrado un sitio tan chachi!"
msgstr "<$voicel(1,8)><$emotion(1,27)>¡Vaya, pero qué agua más rica!<clear><br><$voicel(1,3)><$emotion(1,64)>Ah, hola. ¿Tú también viniste a beber de aquí?<clear><br><$voicel(1,1)><$emotion(1,41)>Hace un rato estaba que me moría de sed, <$voicel(1,7)><$emotion(1,6)>¡pero esta agua<br>me devolvió a la vida, como quien dice!<clear><br><$voicel(1,10)><$motion(1,806)><$comeff(1,10)>¡Cómo me alegro de haber encontrado un lugar tan genial!"

#. en: <$voicel(1,5)><$emotion(1,27)>Hey there! Could I have a minute of your time, yo?<clear><br><$voicel(1,7)><$emotion(1,38)>I know what’s up. You look like a human but are actually a<br>Pokémon, right?<clear><br><$voicel(1,3)><$emotion(1,51)>Sometimes I get confused for a human too, yo. <$voicel(1,8)><$emotion(1,50)>But I can<br>tell you’re like me by your smell!<clear><br><$voicel(1,9)><$emotion(1,38)>Let’s be friends! Folks like us gotta stick together!
msgctxt "3255:176"
msgid "<$voicel(1,5)><$emotion(1,27)>¡Oye, <gen;-2(tío,tía)>! ¿Tienes un momento? Te veo pinta de human<gen;-2(o,a)>,<br><$voicel(1,7)><$emotion(1,38)>pero eres un Pokémon, ¿verdad?<clear><br><$voicel(1,3)><$emotion(1,51)>A mí también me suelen confundir con <gen;-3(un,una)> niñ<gen;-3(o,a)> human<gen;-3(o,a)>,<br><$voicel(1,8)><$emotion(1,50)>¡pero mi olfato es infalible y tu olor no engaña!<clear><br><$voicel(1,9)><$emotion(1,38)>¡Con lo que nos parecemos, seguro que nos llevamos<br>de fábula!"
msgstr "<$voicel(1,5)><$emotion(1,27)>¡Oye, <gen;-2(tío,tía)>! ¿Tienes un momento? Pareces human<gen;-2(o,a)>,<br><$voicel(1,7)><$emotion(1,38)>pero eres un Pokémon, ¿verdad?<clear><br><$voicel(1,3)><$emotion(1,51)>A mí también me suelen confundir con <gen;-3(un,una)> niñ<gen;-3(o,a)> human<gen;-3(o,a)>,<br><$voicel(1,8)><$emotion(1,50)>¡pero mi olfato es infalible y tu olor no engaña!<clear><br><$voicel(1,9)><$emotion(1,38)>¡Con lo que nos parecemos, seguro que nos llevamos<br>de fábula!"

#. en: <$voicel(1,7)><$facial(1,4)><$comeff(1,9)><$motion(1,803)>Ludi! Ludi! Hey theeere. Nice to meet you.<clear><br><$voicel(1,5)><$facial(1,1)><$motion(1,805)><$comeff(1,21)>This new living space is sooo niiice. Just makes me want<br>to daaance.<clear><br><$voicel(1,7)><$emotion(1,38)>I love having music when I’m dancing. Heyyy, if you know<br>any good songs <$voicel(1,10)><$comeff(1,13)><$motion(1,664)>I’d love to hear them!
msgctxt "3255:177"
msgid "<$voicel(1,7)><$facial(1,4)><$comeff(1,9)><$motion(1,803)>♪¡Ludi, ludi!♪ Holaaa, ¿qué taaaal?<clear><br><$voicel(1,5)><$facial(1,1)><$motion(1,805)><$comeff(1,21)>Oye, qué bien está esta nueva casica mía, ¿eeeh?<br>¡Tanto que me entran ganas de bailar!<clear><br><$voicel(1,7)><$emotion(1,38)>Y si el baile está acompañado de una buena música,<br>♪¡entonces ya sería el no va más!♪<clear><br>Si conoces algún temazo... <$voicel(1,10)><$comeff(1,13)><$motion(1,664)>¡no dudes en mostrármelo!<br>¡Soy tod<gen;-3(o,a)> oídos!"
msgstr "<$voicel(1,7)><$facial(1,4)><$comeff(1,9)><$motion(1,803)>♪¡Ludi, ludi!♪ Holaaa, ¿qué taaaal?<clear><br><$voicel(1,5)><$facial(1,1)><$motion(1,805)><$comeff(1,21)>Oye, qué bien está esta nueva casita mía, ¿eeeh?<br>¡Tanto que me entran ganas de bailar!<clear><br><$voicel(1,7)><$emotion(1,38)>Y si el baile está acompañado de una buena música,<br>♪¡entonces ya sería lo máximo!♪<clear><br>Si conoces algún éxito... <$voicel(1,10)><$comeff(1,13)><$motion(1,664)>¡no dudes en mostrármelo!<br>¡Soy tod<gen;-3(o,a)> oídos!"

#. en: <$emotion(1,3)><$voicel(1,2)><$comeff(1,17)>Ahhh, so relaxing...<clear><br><$facial(1,1)><$voicel(1,5)>Flying around is nice, but when it comes down to it,<br><$voicel(1,7)><$emotion(1,8)>kicking back and relaxing at home is the best.<clear><br><$comeff(1,21)><$voicel(1,3)>You look like you know a thing or two about taking it easy,<br>yeah? <$voicel(1,6)><$emotion(1,9)>Um... Wanna chill out together? ♪
msgctxt "3255:178"
msgid "<$emotion(1,3)><$voicel(1,2)><$comeff(1,17)>Ay, qué a gustito estoy...<clear><br><$facial(1,1)><$voicel(1,5)>Ir a volar por ahí también me gusta pero, al fin y al cabo,<br><$voicel(1,7)><$emotion(1,8)>no hay nada como estar de chill en casita. Jeee...<clear><br><$comeff(1,21)><$voicel(1,3)>Tú también tienes pinta de no querer hacer na de na...<br><$voicel(1,6)><$emotion(1,9)>Oye, ¿nos echamos a la bartola un rato?"
msgstr "<$emotion(1,3)><$voicel(1,2)><$comeff(1,17)>Ay, qué a gustito estoy...<clear><br><$facial(1,1)><$voicel(1,5)>Ir a volar por ahí también me gusta pero, al fin y al cabo,<br><$voicel(1,7)><$emotion(1,8)>no hay nada como estar de chill en casita. Jeee...<clear><br><$comeff(1,21)><$voicel(1,3)>Tú también tienes pinta de no querer hacer nada de nada...<br><$voicel(1,6)><$emotion(1,9)>Oye, ¿nos echamos a descansar un rato?"

#. en: <$comeff(1,1)><$motion(1,807)><$voicel(1,7)>Whoooaaa, I found a niiice home. And you made<br>it?<$comeff(1,21)><$motion(1,802)><$voicel(1,8)> Thaaanks.<clear><br><$comeff(1,13)><$motion(1,803)><$voicel(1,7)>I think I’ll chill out here for a while.<clear><br><$comeff(1,14)><$facial(1,14)><$motionoff(1,804)><$voicel(1,5)>Then after I do that, I’ll go find the sea, <$motion(1,805)><$voicel(1,6)>and I’ll float<br>around a bit, and theeen...<clear><br><$facial(1,1)><$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Maybe just keep on doing that for a while. Yeahhh...
msgctxt "3255:179"
msgid "<$comeff(1,1)><$motion(1,807)><$voicel(1,7)>¡Ay, pero qué casica más bonica he encontradooo!<br>No me digas que es obra tuya. <$comeff(1,21)><$motion(1,802)><$voicel(1,8)>¡Graciaaas!<clear><br><$comeff(1,13)><$motion(1,803)><$voicel(1,7)>Uf, pues con tu permiso voy a repantingarme por aquí,<br>¿eeeh?<clear><br><$comeff(1,14)><$facial(1,14)><$motionoff(1,804)><$voicel(1,5)>Después de pegarme la vidorra, me iré a buscar el mar...<br><$motion(1,805)><$voicel(1,6)>Allí estaré flotando, meciéeendome entre las olas...<clear><br><$facial(1,1)><$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Y, ya de paso, me seguiré relajando, tomándome todo<br>con muuucha calma."
msgstr "<$comeff(1,1)><$motion(1,807)><$voicel(1,7)>¡Ay, pero qué casita más bonita encontréee!<br>No me digas que es obra tuya. <$comeff(1,21)><$motion(1,802)><$voicel(1,8)>¡Graciaaas!<clear><br><$comeff(1,13)><$motion(1,803)><$voicel(1,7)>Uf, pues con tu permiso voy a repantingarme por aquí,<br>¿eeeh?<clear><br><$comeff(1,14)><$facial(1,14)><$motionoff(1,804)><$voicel(1,5)>Después de darme la gran vida, me iré a buscar el mar...<br><$motion(1,805)><$voicel(1,6)>Allí estaré flotando, meciéeendome entre las olas...<clear><br><$facial(1,1)><$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Y, ya de paso, me seguiré relajando, tomándome todo<br>con muuucha calma."

#. en: <$comeff(1,10)><$motion(1,803)><$voicel(1,9)>Umm... Excuse me! You over there, um, <$cdef(27)>Ditto</color>!<clear><br><$comeff(1,14)><$voicel(1,7)><$motion(1,801)>Yup! As soon as I saw you, I knew it. I mean, that you were<br>a <$cdef(27)>Ditto</color>! <$motion(1,805)><$voicel(1,8)>Um, and also that this home was made by you...<clear><br><$comeff(1,6)><$motion(1,806)><$voicel(1,5)>Hmm, I wonder if I’m getting across how happy I am.<wait(1.2)><$motion(0,40)><wait(1.7)><clear><br><$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Thank you! And I hope to see you around!
msgctxt "3255:180"
msgid "<$comeff(1,10)><$motion(1,803)><$voicel(1,9)>O-oye, chic<gen;-2(o,a)> <$cdef(27)>Ditto</color>, esto...<clear><br><$comeff(1,14)><$voicel(1,7)><$motion(1,801)>Verás, es que en cuanto te he visto he sabido enseguida<br>que eras un <$cdef(27)>Ditto </color>transformado... y también que <$motion(1,805)><$voicel(1,8)>has sido<slide><br>tú quien me ha preparado este lugar, y...<clear><br><$comeff(1,6)><$motion(1,806)><$voicel(1,5)>Ay, ¿por qué me lío tanto?... <wait(1.2)><$motion(0,40)><wait(1.7)><$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Que muchas gracias!<br>E-eres muy guay."
msgstr "<$comeff(1,10)><$motion(1,803)><$voicel(1,9)>O-oye, chic<gen;-2(o,a)> <$cdef(27)>Ditto</color>, esto...<clear><br><$comeff(1,14)><$voicel(1,7)><$motion(1,801)>Verás, es que en cuanto te vi supe enseguida<br>que eras un <$cdef(27)>Ditto </color>transformado... y también que <$motion(1,805)><$voicel(1,8)>fuiste<slide><br>tú quien me preparó este lugar, y...<clear><br><$comeff(1,6)><$motion(1,806)><$voicel(1,5)>Ay, ¿por qué me enredo tanto?... <wait(1.2)><$motion(0,40)><wait(1.7)><$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Que muchas gracias!<br>E-eres genial."

#. en: <$voicel(1,6)><$motion(1,806)><$comeff(1,3)>Oh, um, hello...<clear><br><$voicel(1,7)><$emotion(1,50)>Wait, you’re actually a Pokémon, aren’t you. It’s so nice to<br>meet you!<clear><br><$voicel(1,1)><$emotion(1,65)>You know, I have a feeling this place will be full of happy<br>Pokémon soon. <$voicel(1,7)><$comeff(1,6)>It’s just a hunch, really.<clear><br><$voicel(1,10)><$emotion(1,8)>But I think it might all be thanks to you.
msgctxt "3255:181"
msgid "<$voicel(1,6)><$motion(1,806)><$comeff(1,3)>Hola... <$voicel(1,7)><$emotion(1,50)>Eres un Pokémon, ¿no? Encantad<gen;-3(o,a)>...<clear><br><$voicel(1,7)><$comeff(1,6)>¿Has tenido algo que ver con esto?<clear><br><$voicel(1,1)><$emotion(1,65)>Algo me dice que pronto habrá un montón de Pokémon<br>felices por aquí...<clear><br><$voicel(1,10)><$emotion(1,8)>Tal vez me equivoque, pero me da esa sensación..."
msgstr "<$voicel(1,6)><$motion(1,806)><$comeff(1,3)>Hola... <$voicel(1,7)><$emotion(1,50)>Eres un Pokémon, ¿no? Encantad<gen;-3(o,a)>...<clear><br><$voicel(1,7)><$comeff(1,6)>¿Tuviste algo que ver con esto?<clear><br><$voicel(1,1)><$emotion(1,65)>Algo me dice que pronto habrá un montón de Pokémon<br>felices por aquí...<clear><br><$voicel(1,10)><$emotion(1,8)>Tal vez me equivoque, pero me da esa sensación..."

#. en: <$voicel(1,5)><$emotion(1,14)>Hello there, little <$cdef(27)>Ditto</color>. It’s a pleasure to meet you. <wait(1.0)><$voicel(1,8)><$emotion(1,8)><br>Thank you for building this exquisite home.<clear><br><$facial(1,1)><$comeff(1,14)><$motion(1,806)>...<$voicel(1,2)>Hm, I see...<clear><br><$voicel(1,7)><$facial(1,14)><$emotion(1,27)>From now on, our world is bound to <$facial(1,1)>grow more pleasant<br>and full of ease,<$voicel(1,8)><$facial(1,4)> as long as you’re around.<slide><br><$voicel(1,10)><$comeff(1,13)><$motion(1,805)>I just know it.
msgctxt "3255:182"
msgid "<$voicel(1,5)><$emotion(1,14)>Un placer conocerte, querid<gen;-2(o,a)> <$cdef(27)>Ditto</color>. <$voicel(1,8)><$emotion(1,8)>Te agradezco que<br>me hayas preparado este estupendo lugar para vivir.<clear><br><$facial(1,1)><$comeff(1,14)><$motion(1,806)>... <$voicel(1,2)>Hmm... Ya veo...<clear><br><$voicel(1,7)><$facial(1,14)><$emotion(1,27)>Algo me dice que, gracias a ti, <$facial(1,1)>este mundo se irá haciendo<br><$voicel(1,8)><$facial(1,4)>cada vez más acogedor y divertido.<clear><br><$voicel(1,10)><$comeff(1,13)><$motion(1,805)>No me preguntes cómo, pero lo presiento."
msgstr ""

#. en: <$comeff(1,10)><$motion(1,805)><$voicel(1,7)>Osu! What a nice place, <$comeff(1,13)><$motion(1,803)><$voicel(1,8)>I really like it! <$comcan(1)><$motion(1,801)><$voicel(1,10)>And you<br>made it for me?!<clear><br><$comeff(1,10)><$motion(1,806)><$voicel(1,7)>I’ll keep training hard so I can help out <$comeff(1,21)><$motion(1,816)><$voicel(1,9)>next time you<br>make something, yo!
msgctxt "3255:183"
msgid "<$comeff(1,10)><$motion(1,805)><$voicel(1,7)>¡Guau, qué guapada de sitio!<clear><br><$comeff(1,13)><$motion(1,803)><$voicel(1,8)>Está muy logrado... <wait(0.9)><$comcan(1)><$motion(1,801)><$voicel(1,10)>¿Te lo has currado para mí?<clear><br><$comeff(1,10)><$motion(1,806)><$voicel(1,7)>Pues tendré que entrenar duro, así la próxima vez <$comeff(1,21)><$motion(1,816)><$voicel(1,9)>podré<br>ayudarte a construir lo que necesites."
msgstr "<$comeff(1,10)><$motion(1,805)><$voicel(1,7)>¡Guau, qué lugar tan lindo!<clear><br><$comeff(1,13)><$motion(1,803)><$voicel(1,8)>Está muy logrado... <wait(0.9)><$comcan(1)><$motion(1,801)><$voicel(1,10)>¿Lo hiciste para mí?<clear><br><$comeff(1,10)><$motion(1,806)><$voicel(1,7)>Pues tendré que entrenar duro, así la próxima vez <$comeff(1,21)><$motion(1,816)><$voicel(1,9)>podré<br>ayudarte a construir lo que necesites."

#. en: <$comeff(1,10)><$motion(1,803)><$voicel(1,7)>Heyyy, you! Human-lookin’ kiddo! <wait(0.4)><$comeff(0,5)><wait(0.6)><$comeff(1,10)><$motion(1,806)><$voicel(1,9)>Ya trainin’ hard?!<wait(0.8)><$motion(0,41)><wait(0.8)><br><$comeff(1,5)><$motion(1,803)><$voicel(1,8)>What?! You’re not?! <$comeff(1,10)><$motion(1,801)><$voicel(1,10)>Well, at least you’re honest!<clear><br><$comeff(1,13)><$motionoff(1,804)><$voicel(1,9)>In that case, feel free to gimme a holler if ya need help<br>with any physical labor!
msgctxt "3255:184"
msgid "<$comeff(1,10)><$motion(1,803)><$voicel(1,7)>¡Oye, picaruel<gen;-2(o,a)>! ¡Sí, tú, especie de humanoide pequeñaj<gen;-2(o,a)>!<wait(0.4)><$comeff(0,5)><wait(0.6)><br><$comeff(1,10)><$motion(1,806)><$voicel(1,9)>¡¿Estás entrenando duro?!<wait(0.8)><$motion(0,41)><wait(0.8)> <$comeff(1,5)><$motion(1,803)><$voicel(1,8)>¡¿Cómo que no?!<clear><br><$comeff(1,10)><$motion(1,801)><$voicel(1,10)>Hm... Bueno, al menos eres sincer<gen;-2(o,a)>.<clear><br><$comeff(1,13)><$motionoff(1,804)><$voicel(1,9)>En ese caso, ¡aquí me tienes si buscas a alguien para algún<br>trabajo laborioso!"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,8)>Boing, boing! Hi, nice to meet you! I’m so happy to have a<br>home now!<clear><br><$voicel(1,3)><$emotion(1,65)>I had been sleeping on my tail over around there, <$voicel(1,2)><$emotion(1,31)>but I’m<br>not sure how much longer I coulda lasted...<clear><br><$voicel(1,9)><$facial(1,4)><$comeff(1,10)><$motion(1,806)>Starting today, I’m gonna live HERE! So come and visit me<br>sometimes, OK?
msgctxt "3255:185"
msgid "<$voicel(1,7)><$emotion(1,8)>¡Boing, boing! ¡Hola! Ya tengo un lugar para vivir, ¡chachiii!<clear><br><$voicel(1,3)><$emotion(1,65)>Hasta ahora dormía como podía encima de mi propia cola,<br><$voicel(1,2)><$emotion(1,31)>pero estaba un poco hart<gen;-3(o,a)> ya, si te digo la verdad.<clear><br><$voicel(1,9)><$facial(1,4)><$comeff(1,10)><$motion(1,806)>Pero eso ya se acabó a partir de ahora mismito:<br>¡me mudo aquí! Vente a jugar un día de estos, ¿vale?"
msgstr "<$voicel(1,7)><$emotion(1,8)>¡Boing, boing! ¡Hola! Ya tengo un lugar para vivir, ¡geniaaal!<clear><br><$voicel(1,3)><$emotion(1,65)>Hasta ahora dormía como podía encima de mi propia cola,<br><$voicel(1,2)><$emotion(1,31)>pero estaba un poco hart<gen;-3(o,a)> ya, si te digo la verdad.<clear><br><$voicel(1,9)><$facial(1,4)><$comeff(1,10)><$motion(1,806)>Pero eso ya se acabó a partir de ahora mismito:<br>¡me mudo aquí! Ven a jugar un día de estos, ¿sí?"

#. en: <$voicel(1,5)><$emotion(1,27)>Twinkle! Twinkle! This shine! Is it maybe jewels?<clear><br><$voicel(1,3)><$emotion(1,31)>Oh. It is not. It is just your twinkling smiling eyes.<clear><br><$voicel(1,7)><$emotion(1,38)>I am happy meeting you and your twinkling shiny<br>smile. <$pkcry;2(1,1)>!
msgctxt "3255:186"
msgid "<$voicel(1,5)><$emotion(1,27)>¡Brilla! ¡Brilla! ¡¿Es una joya?!<clear><br><$voicel(1,3)><$emotion(1,31)>Ah. No. Solo el brillo feliz de tus ojos.<clear><br><$voicel(1,7)><$emotion(1,38)>Me alegra conocer a alguien con una sonrisa brillante.<br>¡<$pkcry;2(1,1)>!"
msgstr ""

#. en: <$motion(1,805)><$voicel(1,5)>Hi there. This is sure a nice place.<br><$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>Hey, maybe... Would you like to play with me?<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,802)><$voicel(1,7)>Oh, but...please don’t go and disappear on me, OK?<br><$comeff(1,17)><$facial(1,9)><$voicel(1,3)>I seem to keep losing track of all my friends...<clear><br><$voicel(1,5)><$motion(1,806)>We’ll be playing, but then they’ll up and vanish the<br>moment I turn my back to them...<wait(0.4)><$comeff(0,5)><clear><br><$motion(1,807)><$voicel(1,1)>It always makes me a little sad.<clear><br><$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>I hope you and I can have lots of fun together!
msgctxt "3255:187"
msgid "<$motion(1,805)><$voicel(1,5)>Hola... Qué buen sitio, ¿eh? <$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>¿Q-quieres jugar conmigo?<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,802)><$voicel(1,7)>Ah... Pero no desaparezcas de repente, ¿prometido?<br><$comeff(1,17)><$facial(1,9)><$voicel(1,3)>Es que me pasa mucho cuando juego con algún amigo...<clear><br><$voicel(1,5)><$motion(1,806)>Me doy la vuelta un momento... y cuando me quiero dar<br>cuenta ya no está... <wait(0.4)><$comeff(0,5)><$motion(1,807)><$voicel(1,1)>Es bastante triste...<clear><br><$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>E-espero poder jugar contigo a partir de ahora, al menos."
msgstr "<$motion(1,805)><$voicel(1,5)>Hola... Qué buen lugar, ¿eh? <$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>¿Q-quieres jugar conmigo?<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,802)><$voicel(1,7)>Ah... Pero no desaparezcas de repente, ¿prometido?<br><$comeff(1,17)><$facial(1,9)><$voicel(1,3)>Es que me pasa mucho cuando juego con algún amigo...<clear><br><$voicel(1,5)><$motion(1,806)>Me doy la vuelta un momento... y cuando me quiero dar<br>cuenta ya no está... <wait(0.4)><$comeff(0,5)><$motion(1,807)><$voicel(1,1)>Es bastante triste...<clear><br><$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>E-espero poder jugar contigo a partir de ahora, al menos."

#. en: <$voicel(1,7)><$emotion(1,27)><$pkcry;0(1,2)>! You there, humany Pokémon!<clear><br><$voicel(1,3)><$emotion(1,38)>How’re your energy levels? Are you feeling charged up?!<clear><br><$voicel(1,2)><$emotion(1,65)>If you ever think you need a boost,<$voicel(1,10)><$comeff(1,9)><$motion(1,806)> you can count on<br>me from now on!
msgctxt "3255:188"
msgid "<oneline><$voicel(1,7)><$emotion(1,27)>¡<$pkcry;0(1,2)>! ¡Oye, tú! ¡El Pokémon con pinta de<br>human<gen;-2(o,a)>!<clear><br><$voicel(1,3)><$emotion(1,38)>¿Y esa cara que me traes? ¿Andas algo falt<gen;-2(o,a)> de ánimos?<br><$voicel(1,2)><$emotion(1,65)>¡Si necesitas que te recarguen las pilas, <$voicel(1,10)><$comeff(1,9)><$motion(1,806)>yo te echo<slide><br>un cable, chic<gen;-2(o,a)>!"
msgstr "<oneline><$voicel(1,7)><$emotion(1,27)>¡<$pkcry;0(1,2)>! ¡Oye, tú! ¡El Pokémon con pinta de<br>human<gen;-2(o,a)>!<clear><br><$voicel(1,3)><$emotion(1,38)>¿Y esa cara que me traes? ¿Andas algo falt<gen;-2(o,a)> de ánimos?<br><$voicel(1,2)><$emotion(1,65)>¡Si necesitas que te recarguen las pilas, <$voicel(1,10)><$comeff(1,9)><$motion(1,806)>yo te echo<slide><br>una mano, chic<gen;-2(o,a)>!"

#. en: <$voicel(1,7)><$emotion(1,14)><$pkcry;0(1,2)>. Hey, you. Human-looking Pokémon.<clear><br><$voicel(1,5)><$emotion(1,8)>I owe you my thanks. You made this home, yeah?<clear><br><$voicel(1,9)><$facial(1,4)><$motion(1,859)>See, electricity’s my favorite thing. My other fave?<br>Sunny weather.
msgctxt "3255:189"
msgid "<oneline><$voicel(1,7)><$emotion(1,14)><$pkcry;0(1,2)>... Ey, tú... <gen;-2(El,La)> que lleva pintas de<br>human<gen;-2(o,a)>...<clear><br><$voicel(1,5)><$emotion(1,8)>Quería darte las gracias. Esto lo has preparado tú, ¿no?<clear><br><$voicel(1,9)><$facial(1,4)><$motion(1,859)>Me encanta la energía, tanto la eléctrica como la solar.<br>Por si te interesa saberlo."
msgstr "<oneline><$voicel(1,7)><$emotion(1,14)><$pkcry;0(1,2)>... Ey, tú... <gen;-2(El,La)> que parece<br>human<gen;-2(o,a)>...<clear><br><$voicel(1,5)><$emotion(1,8)>Quería darte las gracias. Esto lo preparaste tú, ¿no?<clear><br><$voicel(1,9)><$facial(1,4)><$motion(1,859)>Me encanta la energía, tanto la eléctrica como la solar.<br>Por si te interesa saberlo."

#. en: <$voicel(1,7)><$emotion(1,8)>Hey hey! Great to see a new face! I was just looking<br>around for a new home <$voicel(1,6)><$comeff(1,10)>and ended up planting my butt<slide><br>down here!<clear><br><$voicel(1,9)><$facial(1,4)><$comeff(1,10)><$motion(1,814)>And it’s a pretty nice butt, don’t you think? So shiny!<clear><br><$voicel(1,3)><$emotion(1,29)>By the way, I see you’re in a human form right now.<br><$voicel(1,8)><$emotion(1,39)>Kinda makes me wonder what human butts look like.
msgctxt "3255:190"
msgid "<$voicel(1,7)><$emotion(1,8)>¡Qué pasaaa! ¡Mucho gusto! Justo venía de posar<br>mis posaderas <$voicel(1,6)><$comeff(1,10)>en mis nuevos aposentos.<clear><br><$voicel(1,9)><$facial(1,4)><$comeff(1,10)><$motion(1,814)>¿Qué me dices de mi cola brillante? ¿A que es lo más?<clear><br><$voicel(1,3)><$emotion(1,29)>Por cierto, tú que vas por ahí con pintas de human<gen;-2(o,a)>...<br><$voicel(1,8)><$emotion(1,39)>¿Los humanos tienen cola?"
msgstr "<$voicel(1,7)><$emotion(1,8)>¡Qué taaal! ¡Mucho gusto! Justo venía de posar<br>mis posaderas <$voicel(1,6)><$comeff(1,10)>en mis nuevos aposentos.<clear><br><$voicel(1,9)><$facial(1,4)><$comeff(1,10)><$motion(1,814)>¿Qué tal mi cola brillante? ¿Verdad que es lo máximo?<clear><br><$voicel(1,3)><$emotion(1,29)>Por cierto, tú que vas por ahí con aspecto de human<gen;-2(o,a)>...<br><$voicel(1,8)><$emotion(1,39)>¿Los humanos tienen cola?"

#. en: <$voicel(1,3)><$emotion(1,29)>Oh? Why, it’s <$cdef(27)>Ditto</color>! I was expecting someone else.<clear><br><$voicel(1,7)><$emotion(1,8)>Were you drawn to my sweet aroma, darling? ♪<clear><br><$voicel(1,5)><$emotion(1,14)>Say, if you come across a Pokémon who looks like<br>me called <$cdef(27)>Volbeat</color>,<$voicel(1,8)><$facial(1,4)><$comeff(1,13)> please let me know, won’t you?
msgctxt "3255:191"
msgid "<$voicel(1,3)><$emotion(1,29)>¡Oh! Ah, vaya, si no eres mi amorcín, sino un <$cdef(27)>Ditto</color>...<clear><br><$voicel(1,7)><$emotion(1,8)>¿Has venido atraíd<gen;-2(o,a)> por mi dulce aroma? Ju, ju.<clear><br><$voicel(1,5)><$emotion(1,14)>Por cierto, si te encuentras por ahí a un <$voicel(1,8)><$facial(1,4)><$comeff(1,13)>Pokémon que se<br>parece un poco a mí llamado <$cdef(27)>Volbeat</color>, avísame."
msgstr "<$voicel(1,3)><$emotion(1,29)>¡Oh! Ah, vaya, si no eres mi amorcín, sino un <$cdef(27)>Ditto</color>...<clear><br><$voicel(1,7)><$emotion(1,8)>¿Viniste atraíd<gen;-2(o,a)> por mi dulce aroma? Ju, ju.<clear><br><$voicel(1,5)><$emotion(1,14)>Por cierto, si te encuentras por ahí a un <$voicel(1,8)><$facial(1,4)><$comeff(1,13)>Pokémon que se<br>parece un poco a mí llamado <$cdef(27)>Volbeat</color>, avísame."

#. en: <$voicel(1,7)><$facial(1,4)><$comeff(1,21)><$motion(1,805)>Whoooaaa, is this my new home?<clear><br><$voicel(1,5)><$emotion(1,13)>Hmm, a home of this size would take about three<br>mouthfuls, but...<$voicel(1,4)><$facial(1,1)><$comeff(1,10)><$motion(1,816)><$facial(0,13)>I bet I could gulp it all down.<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,803)>...Oh. But if I did that, I wouldn’t be able to live here.<br><$voicel(1,9)><$comeff(1,3)><$motion(1,807)>Yeah, I’d better not.
msgctxt "3255:192"
msgid "<$voicel(1,7)><$facial(1,4)><$comeff(1,21)><$motion(1,805)>¿Es esta mi nueva casa? Jo, qué chuli.<clear><br><$voicel(1,5)><$emotion(1,13)>¿De cuántos bocados podría comérmela? <$voicel(1,4)><$facial(1,1)><$comeff(1,10)><$motion(1,816)><$facial(0,13)>Yo creo que<br>con tres me bastaría...<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,803)>Uy, no me mires con esa cara... que estaba de broma...<br><$voicel(1,9)><$comeff(1,3)><$motion(1,807)>¿Cómo voy a comerme mi propia casa?"
msgstr "<$voicel(1,7)><$facial(1,4)><$comeff(1,21)><$motion(1,805)>¿Es esta mi nueva casa? Vaya, qué linda.<clear><br><$voicel(1,5)><$emotion(1,13)>¿De cuántos bocados podría comérmela? <$voicel(1,4)><$facial(1,1)><$comeff(1,10)><$motion(1,816)><$facial(0,13)>Yo creo que<br>con tres me bastaría...<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,803)>Uy, no me mires con esa cara... que estaba de broma...<br><$voicel(1,9)><$comeff(1,3)><$motion(1,807)>¿Cómo voy a comerme mi propia casa?"

#. en: <$voicel(1,3)><$facial(1,9)><$motion(1,801)>*yaaawn* <wait(0.9)><wait(0.5)><$voicel(1,6)><$motion(1,834)><$comeff(1,8)>What a pleasant plaaace... <$voicel(1,6)><$comeff(1,16)>Mmmmmm.<clear><br><$voicel(1,7)><$motion(1,835)><$comeff(1,3)>Oh yayyy. Food time. <wait(0.9)><$voicel(1,9)><$emotion(1,8)><$facial(0,9)><$comeff(0,4)><$motion(0,41)>Yummyyy.<clear><br><$voicel(1,3)><$emotion(1,27)><$facial(0,1)>Oh nooo. My food’s moving? Waaaiiit. You aren’t food,<br>you’re a humaaan.<clear><br><$voicel(1,5)><$emotion(1,58)>Sorryyy... I’m still kind of sleepy.
msgctxt "3255:193"
msgid "<$voicel(1,3)><$facial(1,9)><$motion(1,801)>Swaaa... <wait(0.9)><wait(0.5)><$voicel(1,6)><$motion(1,834)><$comeff(1,8)>Pero qué a gustico se está aquí, madre mía...<br><$voicel(1,6)><$comeff(1,16)>Mñrm, mñrm...<clear><br><$voicel(1,7)><$motion(1,835)><$comeff(1,3)>Guaaau, pero si hay comida y todo... <wait(0.9)><$voicel(1,9)><$emotion(1,8)><$facial(0,9)><$comeff(0,4)><$motion(0,41)>¡A comeeer!<clear><br><$voicel(1,3)><$emotion(1,27)><$facial(0,1)>Uy, juraría que la comida se ha movido, aunque... ¡Ah!<br>Ahora que te veo bien, en realidad eres un ser humano.<clear><br><$voicel(1,5)><$emotion(1,58)>Perdona, estoy aún un poco adormilad<gen;-3(o,a)>..."
msgstr "<$voicel(1,3)><$facial(1,9)><$motion(1,801)>Swaaa... <wait(0.9)><wait(0.5)><$voicel(1,6)><$motion(1,834)><$comeff(1,8)>Pero qué a gustito se está aquí, de verdad...<br><$voicel(1,6)><$comeff(1,16)>Mñrm, mñrm...<clear><br><$voicel(1,7)><$motion(1,835)><$comeff(1,3)>Guaaau, pero si hay comida y todo... <wait(0.9)><$voicel(1,9)><$emotion(1,8)><$facial(0,9)><$comeff(0,4)><$motion(0,41)>¡A comeeer!<clear><br><$voicel(1,3)><$emotion(1,27)><$facial(0,1)>Uy, juraría que la comida se movió, aunque... ¡Ah!<br>Ahora que te veo bien, en realidad eres un ser humano.<clear><br><$voicel(1,5)><$emotion(1,58)>Perdona, estoy aún un poco adormilad<gen;-3(o,a)>..."

#. en: <$comeff(1,10)><$motionoff(1,804)><$voicel(1,9)>Fwwwssshhhhhh... Niiice to meeeet yooouuu...<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,805)><$voicel(1,8)>Pfwahhh... Sooorry, this place is just sooo relaxing.<br><$emotion(1,38)><$voicel(1,10)>I couldn’t help letting out looots of steam.<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,8)>I’ll try to keep it under control in the fuuuture so I’m not a<br>booother to the others here.
msgctxt "3255:194"
msgid "<$comeff(1,10)><$motionoff(1,804)><$voicel(1,9)>Fuaaaaaa... Encantaaaaaad<gen;-3(o,a)>...<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,805)><$voicel(1,8)>¡Fiu! Perdona, majet<gen;-2(e,a)>, es que estoy tan cómod<gen;-3(o,a)> aquí que<br>al relajarme ha empezado a salir humo por todos lados...<slide><br><$emotion(1,38)><$voicel(1,10)>¡Buf! ¡Menudo corte!<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,8)>Pero no te preocuuupes, prometo controlarme a partir<br>de ahora."
msgstr "<$comeff(1,10)><$motionoff(1,804)><$voicel(1,9)>Fuaaaaaa... Encantaaaaaad<gen;-3(o,a)>...<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,805)><$voicel(1,8)>¡Fiu! Perdona, majet<gen;-2(e,a)>, es que estoy tan cómod<gen;-3(o,a)> aquí que<br>al relajarme empezó a salir humo por todos lados...<slide><br><$emotion(1,38)><$voicel(1,10)>¡Uf! ¡Qué vergüenza!<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,8)>Pero no te preocuuupes, prometo controlarme a partir<br>de ahora."

#. en: <$voicel(1,5)><$motion(1,662)><$comeff(1,10)>Hey, you! Listen to this!<$lookat(1,1,0)><waitactor(1)><clear><br><$voicel(1,7)><$comeff(1,7)><$facial(1,9)>I was gonna use my jaw to dig myself a little home in the<br>ground, but<$voicel(1,3)><$emotion(1,51)> honestly, it seemed like way too much work.<clear><br><$voicel(1,7)><$emotion(1,50)>But then I stumbled on a spot that’s totally perfect for me!<br>What are the chances, right?<clear><br><$voicel(1,9)><$emotion(1,63)>Whaaat! YOU made this home? With THAT jaw? Wow,<br>that’s jaw-some!
msgctxt "3255:195"
msgid "<$voicel(1,5)><$motion(1,662)><$comeff(1,10)>¡Ey, tú, escucha!<$lookat(1,1,0)><waitactor(1)><clear><br><$voicel(1,7)><$comeff(1,7)><$facial(1,9)>Ni te imaginas la pereza que me daba pensar en <$voicel(1,3)><$emotion(1,51)>cavar<br>a mordiscos mi propia casa...<clear><br><$voicel(1,7)><$emotion(1,50)>¡Y voy y me encuentro con este sitio tan perfecto!<clear><br><$voicel(1,9)><$emotion(1,63)>¿Cóoomo? ¿Que lo has hecho tú? Con esa boquita tan<br>pequeña, no me inspirabas confianza, ¡pero vaya contigo!"
msgstr "<$voicel(1,5)><$motion(1,662)><$comeff(1,10)>¡Ey, tú, escucha!<$lookat(1,1,0)><waitactor(1)><clear><br><$voicel(1,7)><$comeff(1,7)><$facial(1,9)>Ni te imaginas la pereza que me daba pensar en <$voicel(1,3)><$emotion(1,51)>cavar<br>a mordiscos mi propia casa...<clear><br><$voicel(1,7)><$emotion(1,50)>¡Y voy y me encuentro con este lugar tan perfecto!<clear><br><$voicel(1,9)><$emotion(1,63)>¿Cóoomo? ¿Que lo hiciste tú? Con esa boquita tan<br>pequeña, no me inspirabas confianza, ¡pero vaya contigo!"

#. en: <$voicel(1,5)><$comeff(1,17)><$facial(1,9)>Phew. A rest...<clear><br><$lookat(1,1,0)><waitactor(1)><$voicel(1,7)><$comeff(1,3)><$facial(1,1)>Oh. Hello. It has been a while since I flew. <$voicel(1,1)><$emotion(1,41)>I am<br>now tired...<clear><br><$voicel(1,7)><$emotion(1,55)>If my wings were bigger, I could fly for longer. <$voicel(1,2)><$emotion(1,51)>I want to<br>grow bigger soon...
msgctxt "3255:196"
msgid "<$voicel(1,5)><$comeff(1,17)><$facial(1,9)>Procedo a descansar...<clear><br><$lookat(1,1,0)><waitactor(1)><$voicel(1,7)><$comeff(1,3)><$facial(1,1)>Hola. Un placer conocerte. Hacía mucho que no volaba.<br><$voicel(1,1)><$emotion(1,41)>Por eso siento cansancio.<clear><br><$voicel(1,7)><$emotion(1,55)>Ojalá tuviera alas más grandes. Así podría volar más<br>fácilmente.<clear><br><$voicel(1,2)><$emotion(1,51)>Espero crecer pronto..."
msgstr ""

#. en: <$voicel(1,5)><$emotion(1,14)>Oh? Who might you be?<$facial(1,4)> I don’t believe we’ve met,<br>but it’s a pleasure.<clear><br><$voicel(1,7)><$emotion(1,8)>I was just thinking about making this spot my new home!<clear><br><$voicel(1,3)><$facial(1,1)><$motion(1,805)>I spend most of my time in the sky, but it would be lovely<br>to have a place where I can rest on occasion<slide><br><$voicel(1,6)><$facial(1,4)><$comeff(1,8)>and tend to these precious wings of mine.<clear><br><$voicel(1,10)><$emotion(1,38)>This seems like the perfect, peaceful spot!
msgctxt "3255:197"
msgid "<$voicel(1,5)><$emotion(1,14)>Creo que no nos conocemos. <$facial(1,4)>¡Es un placer, chiquit<gen;-2(ín,ina)>!<br><$voicel(1,7)><$emotion(1,8)>Tengo pensado vivir aquí a partir de hoy, ¿sabes?<clear><br><$voicel(1,3)><$facial(1,1)><$motion(1,805)>Me paso el día revoloteando de aquí para allá, pero<br>también necesito un lugar tranquilo donde <$voicel(1,6)><$facial(1,4)><$comeff(1,8)>acicalarme<slide><br>estas preciosas alas...<clear><br><$voicel(1,10)><$emotion(1,38)>¡Creo que este sitio me irá de perlas!"
msgstr "<$voicel(1,5)><$emotion(1,14)>Creo que no nos conocemos. <$facial(1,4)>¡Es un placer, chiquit<gen;-2(ín,ina)>!<br><$voicel(1,7)><$emotion(1,8)>Tengo pensado vivir aquí a partir de hoy, ¿sabes?<clear><br><$voicel(1,3)><$facial(1,1)><$motion(1,805)>Me paso el día revoloteando de aquí para allá, pero<br>también necesito un lugar tranquilo donde <$voicel(1,6)><$facial(1,4)><$comeff(1,8)>acicalarme<slide><br>estas preciosas alas...<clear><br><$voicel(1,10)><$emotion(1,38)>¡Creo que este lugar me irá de perlas!"

#. en: <$voicel(1,5)><$emotion(1,29)>Whoa, what’s your deal? You seem interesting!<clear><br><$voicel(1,7)><$facial(1,4)><$comeff(1,10)>A Pokémon who transformed into a human? Dang, that’s<br>super cool!<wait(0.8)> Lemme take<$motion(1,815)><$comeff(0,5)> a closer look at—<clear><br><$voicel(1,3)><$emotion(1,58)>Oh wait, shoot, no! That was close! My thorns almost<br>spiked you!<clear><br><$voicel(1,7)><$emotion(1,55)>OK, as long as you’re good with no hugs, <$voicel(1,10)><$emotion(1,8)>let’s be besties!
msgctxt "3255:198"
msgid "<$voicel(1,5)><$emotion(1,29)>Hala, qué Pokémon más curioso... <$voicel(1,7)><$facial(1,4)><$comeff(1,10)>¿Te has transformado<br>en human<gen;-2(o,a)>? ¡Qué fuerte!<wait(0.8)> A ver, <$motion(1,815)><$comeff(0,5)>que te vea de cerca...<clear><br><$voicel(1,3)><$emotion(1,58)>¡Ey, pero ten cuidado, que te vas a pinchar!<clear><br><$voicel(1,7)><$emotion(1,55)>Bueno, yo te he avisado, ¿eh? <$voicel(1,10)><$emotion(1,8)>Si quieres ser mi mejor<br>amig<gen;-2(o,a)>, ya sabes lo que hay. Je, je."
msgstr "<$voicel(1,5)><$emotion(1,29)>Vaya, qué Pokémon más curioso... <$voicel(1,7)><$facial(1,4)><$comeff(1,10)>¿Te transformaste<br>en human<gen;-2(o,a)>? ¡Increíble!<wait(0.8)> A ver, <$motion(1,815)><$comeff(0,5)>que te vea de cerca...<clear><br><$voicel(1,3)><$emotion(1,58)>¡Ey, pero ten cuidado, que te vas a pinchar!<clear><br><$voicel(1,7)><$emotion(1,55)>Bueno, yo te avisé, ¿eh? <$voicel(1,10)><$emotion(1,8)>Si quieres ser mi mejor<br>amig<gen;-2(o,a)>, ya sabes lo que hay. Je, je."

#. en: <$voicel(1,5)><$emotion(1,14)>Greetings. Wonderful night, isn’t it?<clear><br><$voicel(1,3)><$comeff(1,14)><$motion(1,805)>What makes tonight wonderful, you ask? <$voicel(1,7)><$emotion(1,8)>Well, I just found<br>a nice spot where I think I’ll be able to settle down.<clear><br><$voicel(1,5)><$facial(1,1)><$motion(1,806)><$comeff(1,13)>Things are way too bright during the day, so I think I’ll<br>hang out here...
msgctxt "3255:199"
msgid "<$voicel(1,5)><$emotion(1,14)>Ho-hola... Qué noche tan espléndida, no... ¿no crees?<br><$voicel(1,3)><$comeff(1,14)><$motion(1,805)>¿Sabes por qué lo pienso?<clear><br><$voicel(1,7)><$emotion(1,8)>Porque justo creo que acabo de encontrar un sitio<br>tranquilo donde vivir, casi perfecto para mí.<clear><br><$voicel(1,5)><$facial(1,1)><$motion(1,806)><$comeff(1,13)>Durante el día, hará sol, así que yo creo que me quedaré<br>por aquí..."
msgstr "<$voicel(1,5)><$emotion(1,14)>Ho-hola... Qué noche tan espléndida, no... ¿no crees?<br><$voicel(1,3)><$comeff(1,14)><$motion(1,805)>¿Sabes por qué lo pienso?<clear><br><$voicel(1,7)><$emotion(1,8)>Porque justo creo que acabo de encontrar un lugar<br>tranquilo donde vivir, casi perfecto para mí.<clear><br><$voicel(1,5)><$facial(1,1)><$motion(1,806)><$comeff(1,13)>Durante el día, hará sol, así que yo creo que me quedaré<br>por aquí..."

#. en: <$voicel(1,5)><$emotion(1,61)>A human child!<clear><br><$facial(1,1)><$comeff(1,14)><$motion(0,41)>... ... ...<clear><br>Wait. <wait(0.4)><$voicel(1,3)><$emotion(1,51)>You are not a human child. <$voicel(1,2)><$comeff(1,7)>Your appearance.<br>It misleads.<clear><br><$voicel(1,7)><$emotion(1,14)>No. You did not do wrong. It is just me.<clear><br><$voicel(1,5)><$emotion(1,8)>I very much like human children, <$voicel(1,4)><$facial(1,1)><$comeff(1,6)><$motion(1,805)>but I do not see them<br>around here.
msgctxt "3255:200"
msgid "<$voicel(1,5)><$emotion(1,61)>¡¡Una cría de humano!!<clear><br><$facial(1,1)><$comeff(1,14)><$motion(0,41)>... <wait(0.4)><$voicel(1,3)><$emotion(1,51)>¿O no?... <wait(0.9)><$voicel(1,2)><$comeff(1,7)>Tu aspecto me induce confusión.<clear><br><$voicel(1,7)><$emotion(1,14)>No. No es tu culpa.<clear><br><$voicel(1,5)><$emotion(1,8)>Me gustan los niños humanos. <wait(0.4)><$voicel(1,4)><$facial(1,1)><$comeff(1,6)><$motion(1,805)>Pero no los veo ya."
msgstr ""

#. en: <$voicel(1,1)><$facial(1,7)><$motion(1,662)><$comeff(1,23)>Boo! Booooo! To talk to me you must be very brave.<clear><br><$voicel(1,5)><$emotion(1,14)>Ah. Ahhh. Nice to meet you, <$cdef(27)>Ditto</color>. Let us be friends for<br>ages to come.<clear><br><$voicel(1,3)><$emotion(1,31)>The others...they are scared of me. They run when I am<br>seen. <$voicel(1,7)><$comeff(1,3)>But you. You are OK I think.<clear><br><$voicel(1,4)><$emotion(1,8)>Boo! Boooo! I am happy. ♪
msgctxt "3255:201"
msgid "<$voicel(1,1)><$facial(1,7)><$motion(1,662)><$comeff(1,23)>¡Clops! Alguien me está dirigiendo la palabra...<clear><br><$voicel(1,5)><$emotion(1,14)>Aaah... Es un placer conocerte, <$cdef(27)>Ditto</color>. Espero que nuestra<br>amistad dure eternamente.<clear><br><$voicel(1,3)><$emotion(1,31)>Los demás... tienen miedo de mí. En cuanto me ven,<br>huyen. <$voicel(1,7)><$comeff(1,3)>Tú no.<clear><br><$voicel(1,4)><$emotion(1,8)>Uuuh... Qué emoción."
msgstr ""

#. en: <$voicel(1,5)><$emotion(1,64)>Hello. You appear very busy. <$voicel(1,8)><$emotion(1,27)>You are making homes for<br>all? <$voicel(1,10)><$facial(1,4)><$comeff(1,10)>That is amazing.<clear><br><$voicel(1,3)><$emotion(1,40)>Then maybe you should sometimes rest at my home.<clear><br><$voicel(1,7)><$emotion(1,8)>A human woman said my magnetism can help make tired<br>less bad.
msgctxt "3255:202"
msgid "<$voicel(1,5)><$emotion(1,64)>Hola. Pareces muy ocupad<gen;-2(o,a)>.<clear><br><$voicel(1,8)><$emotion(1,27)>¿Preparas lugares de residencia para todos?<br><wait(0.4)><$voicel(1,10)><$facial(1,4)><$comeff(1,10)>¡Impresionante!<clear><br><$voicel(1,3)><$emotion(1,40)>Reposa en la mía de vez en cuando.<clear><br><$voicel(1,7)><$emotion(1,8)>Una anciana humana dijo que mi magnetismo puede<br>eliminar la fatiga."
msgstr ""

#. en: <$voicel(1,1)><$emotion(1,31)>I am a small bit sad.<clear><br><$voicel(1,5)><$motion(1,803)>I flew in the sky just now, <$facial(1,9)><$comeff(1,17)>but my speed was slower<br>than before.<clear><br><$voicel(1,3)><$emotion(1,41)>I was as fast as the lightning. But now I am slow like<br>a breeze.<clear><br><$voicel(1,7)><$motion(1,816)>I must retrain.<clear><br><$voicel(1,1)><$comeff(1,5)><$motion(1,806)>I am now quietly motivated.
msgctxt "3255:203"
msgid "<$voicel(1,1)><$emotion(1,31)>Siento algo de tristeza.<clear><br><$voicel(1,5)><$motion(1,803)>Al volar por primera vez tras mucho tiempo, <$facial(1,9)><$comeff(1,17)>mi velocidad<br>no es la que era.<clear><br><$voicel(1,3)><$emotion(1,41)>Antes volaba como el rayo, ahora como una brisa.<clear><br><$voicel(1,7)><$motion(1,816)>Debo entrenar para desoxidarme...<clear><br><$voicel(1,1)><$comeff(1,5)><$motion(1,806)>Siento un fuego en mi interior."
msgstr "<$voicel(1,1)><$emotion(1,31)>Siento algo de tristeza.<clear><br><$voicel(1,5)><$motion(1,803)>Al volar por primera vez después de mucho tiempo,<br><$facial(1,9)><$comeff(1,17)>mi velocidad no es la que era.<clear><br><$voicel(1,3)><$emotion(1,41)>Antes volaba como el rayo, ahora como una brisa.<clear><br><$voicel(1,7)><$motion(1,816)>Debo entrenar para desoxidarme...<clear><br><$voicel(1,1)><$comeff(1,5)><$motion(1,806)>Siento un fuego en mi interior."

#. en: <$voicel(1,1)><$comeff(1,14)><$motion(1,816)>... ... ...<clear><br>Calculations complete. Chance of first meeting is<br>100 percent.<clear><br><$voicel(1,4)><$facial(1,14)>Rewording required—<wait(0.9)><$voicel(1,10)><$emotion(1,38)>it is nice to meet you.<$motion(0,40)><clear><br><$facial(1,1)>... ... ...<clear><br><$emotion(1,67)><$voicel(1,7)><$comeff(1,14)>Calculations complete. Chance of becoming friends is also<br><$voicel(1,2)>100 percent.<clear><br><$voicel(1,9)><$emotion(1,50)>Let us be friends.
msgctxt "3255:204"
msgid "<$voicel(1,1)><$comeff(1,14)><$motion(1,816)>Según mis cálculos, la probabilidad de que este sea<br>nuestro primer encuentro es del 100<nbs4>%.<clear><br><$voicel(1,4)><$facial(1,14)>En otras palabras: <wait(0.9)><$voicel(1,10)><$emotion(1,38)>¡¡Es un placer conocerte!!<$motion(0,40)><clear><br><$facial(1,1)>... <$emotion(1,67)><$voicel(1,7)><$comeff(1,14)>Según mis cálculos, la probabilidad de que tú y yo<br><$voicel(1,2)>entablemos amistad es también del 100<nbs4>%.<clear><br><$voicel(1,9)><$emotion(1,50)>En otras palabras: ¡¡Hola, amig<gen;-2(o,a)> mí<gen;-2(o,a)>!!"
msgstr ""

#. en: <$voicel(1,5)><$pkcry;0(1,1)>! <$emotion(1,14)>Who’re you? Why d’you look funny?<clear><br><$voicel(1,3)><$motion(1,666)><$comeff(1,6)>Isn’t it hard to swim like that?<clear><br><$voicel(1,7)><$emotion(1,40)>Oh, I get it. You’re better at walking, aren’t you?<clear><br><$voicel(1,7)><$emotion(1,8)>I like swimming better than walking, myself. I hope we can<br>swim together sometime!
msgctxt "3255:206"
msgid "<oneline><$voicel(1,5)>¡<$pkcry;0(1,1)>! <$emotion(1,14)>¿Y tú quién eres? ¡Me encanta la pinta<br>que llevas!<clear><br><$voicel(1,3)><$motion(1,666)>Hm, pero... <$comeff(1,6)>¿no te cuesta un poco nadar vestid<gen;-2(o,a)> así?<clear><br><$voicel(1,7)><$emotion(1,40)>¡Ah! ¡Que eres de l<gen;-2(o,a)>s que prefieren usar las patas para<br>caminar, claro!<clear><br><$voicel(1,7)><$emotion(1,8)>Es que a mí me gusta mucho más nadar, ¿sabes?<br>¡Podríamos quedar para darnos un chapuzón algún día!"
msgstr "<oneline><$voicel(1,5)>¡<$pkcry;0(1,1)>! <$emotion(1,14)>¿Y tú quién eres? ¡Me encanta<br>tu aspecto!<clear><br><$voicel(1,3)><$motion(1,666)>Hm, pero... <$comeff(1,6)>¿no te cuesta un poco nadar vestid<gen;-2(o,a)> así?<clear><br><$voicel(1,7)><$emotion(1,40)>¡Ah! ¡Que eres de l<gen;-2(o,a)>s que prefieren usar las patas para<br>caminar, claro!<clear><br><$voicel(1,7)><$emotion(1,8)>Es que a mí me gusta mucho más nadar, ¿sabes?<br>¡Podríamos vernos para darnos un chapuzón algún día!"

#. en: <$voicel(1,5)><$emotion(1,14)>We haven’t met, have we? Thanks for taking the time to<br>come say hi to someone like me.<$voicel(1,10)><$facial(1,4)><$comeff(1,9)> It means a lot.<clear><br><$voicel(1,3)><$emotion(1,65)>Anyway, this spot here—it’s pretty nice, don’t ya think?<br>It’s got water, and<$voicel(1,6)><$facial(1,14)><$comeff(1,3)> I can tell other Pokémon are around.<clear><br><$voicel(1,9)><$emotion(1,62)>I’ve always lived alone, but having others around feels<br>kinda...nice.
msgctxt "3255:207"
msgid "<$voicel(1,5)><$emotion(1,14)>Hmm... Yo a ti no te había visto nunca, ¿verdad?<br>Y aun así has venido a hablar conmigo. <$voicel(1,10)><$facial(1,4)><$comeff(1,9)>Gracias.<clear><br><$voicel(1,3)><$emotion(1,65)>Este sitio es estupendo. Tiene agua <$voicel(1,6)><$facial(1,14)><$comeff(1,3)>y, además, parece<br>que hay otros Pokémon cerca.<clear><br><$voicel(1,9)><$emotion(1,62)>Siempre he vivido sol<gen;-3(o,a)>, pero está bien salir de tu zona<br>de confort de vez en cuando."
msgstr "<$voicel(1,5)><$emotion(1,14)>Hmm... Yo a ti no te había visto nunca, ¿verdad?<br>Y aun así viniste a hablar conmigo. <$voicel(1,10)><$facial(1,4)><$comeff(1,9)>Gracias.<clear><br><$voicel(1,3)><$emotion(1,65)>Este lugar es estupendo. Tiene agua <$voicel(1,6)><$facial(1,14)><$comeff(1,3)>y, además, parece<br>que hay otros Pokémon cerca.<clear><br><$voicel(1,9)><$emotion(1,62)>Siempre he vivido sol<gen;-3(o,a)>, pero está bien salir de tu zona<br>de confort de vez en cuando."

#. en: <$voicel(1,3)><$emotion(1,51)>Ahhh, you have such a tranquil expression.<clear><br><$voicel(1,5)><$emotion(1,14)>This must be a calm and peaceful place. <$voicel(1,8)><$facial(1,5)><$comeff(1,10)>I approve!<clear><br><$voicel(1,9)><$facial(1,1)><$motion(1,805)><$comeff(1,13)>I believe I’ll seek out a suitable home for myself here.
msgctxt "3255:208"
msgid "<$voicel(1,3)><$emotion(1,51)>Ah... Tu rostro rezuma sosiego...<clear><br><$voicel(1,5)><$emotion(1,14)>Será que me hallo en un remanso de paz y tranquilidad.<br><$voicel(1,8)><$facial(1,5)><$comeff(1,10)>Me ha producido una grata impresión.<clear><br><$voicel(1,9)><$facial(1,1)><$motion(1,805)><$comeff(1,13)>Creo que me dispondré a buscar una morada de mi agrado<br>en este emplazamiento."
msgstr "<$voicel(1,3)><$emotion(1,51)>Ah... Tu rostro rezuma sosiego...<clear><br><$voicel(1,5)><$emotion(1,14)>Será que me hallo en un remanso de paz y tranquilidad.<br><$voicel(1,8)><$facial(1,5)><$comeff(1,10)>Me produjo una grata impresión.<clear><br><$voicel(1,9)><$facial(1,1)><$motion(1,805)><$comeff(1,13)>Creo que me dispondré a buscar una morada de mi agrado<br>en este emplazamiento."

#. en: <$voicel(1,8)><$emotion(1,8)>Tot tot! ♪<clear><br><$voicel(1,6)><$comeff(1,10)>Yooo! The acoustics in this area are perfect!<clear><br><$voicel(1,4)><$emotion(1,8)>Totot tot! ♪<clear><br><$voicel(1,6)><$comeff(1,10)>Yeah! That sounds good, if I do say so myself!<clear><br><$lookat(1,1,0)><waitactor(1)><$voicel(1,7)><$comeff(1,5)>Ahhh! Were you listening to me this whole time? Arghhh,<br>I’m kinda embarrassed now!<clear><br><$voicel(1,10)><$comeff(1,13)><$motion(1,806)>Well, I hope you enjoyed my tones, yo.
msgctxt "3255:209"
msgid "<$voicel(1,8)><$emotion(1,8)>♪¡Kri, kri!♪<clear><br><$voicel(1,6)><$comeff(1,10)>¡Qué heavy la sonoridad de este sitio, me encanta!<br><$voicel(1,4)><$emotion(1,8)>♪¡Kri, kriiiiii!♪<clear><br><$voicel(1,6)><$comeff(1,10)>¡Está mal que lo diga yo, pero sueno superbién!<clear><br><$lookat(1,1,0)><waitactor(1)><$voicel(1,7)><$comeff(1,5)>Uy, ¿me has estado escuchando todo este tiempo?<br>¡Ja, qué palo!<clear><br><$voicel(1,10)><$comeff(1,13)><$motion(1,806)>Bueno, espero que te haya gustado el show.<br>He devorado, lo sé."
msgstr "<$voicel(1,8)><$emotion(1,8)>♪¡Kri, kri!♪<clear><br><$voicel(1,6)><$comeff(1,10)>¡Qué genial la sonoridad de este lugar, me encanta!<br><$voicel(1,4)><$emotion(1,8)>♪¡Kri, kriiiiii!♪<clear><br><$voicel(1,6)><$comeff(1,10)>¡Está mal que lo diga yo, pero sueno superbién!<clear><br><$lookat(1,1,0)><waitactor(1)><$voicel(1,7)><$comeff(1,5)>Uy, ¿me estuviste escuchando todo este tiempo?<br>¡Ja, qué vergüenza!<clear><br><$voicel(1,10)><$comeff(1,13)><$motion(1,806)>Bueno, espero que te haya gustado el show.<br>Lo di todo, lo sé."

#. en: <$voicel(1,7)><$emotion(1,8)>Tu tu tu tuuune! ♪ Tu tu tu tuuune! ♪ Another day,<br>another beautiful tuuune! ♪<clear><br><$voicel(1,3)><$emotion(1,29)>Hm? Who are you? Did ya like my performance?<clear><br><$voicel(1,6)><$facial(1,4)><$motion(1,805)><$comeff(1,10)>I’m so happy to meet a new friend! Lemme see if I can<br>express this as a melody...<$voicel(1,10)><$emotion(1,62)> Tu tu tuuune! ♪ Tu tu tuuune! ♪
msgctxt "3255:210"
msgid "<$voicel(1,7)><$emotion(1,8)>♪Kri, kri... Kri, kri...♪ ¡Hoy también estoy que me salgo!<clear><br><$voicel(1,3)><$emotion(1,29)>¿Hm? ¿Y tú de dónde sales? ¿Te ha gustado mi serenata?<br><$voicel(1,6)><$facial(1,4)><$motion(1,805)><$comeff(1,10)>Pues yo he ganado <gen;-2(un,una)> fan, ¡pero tú <gen;-3(un amigo,una amiga)>!<clear><br>¡Voy a plasmar estos sentimientos en mi próximo tema!<br><$voicel(1,10)><$emotion(1,62)>♪Kri, kri... Tun, tun...♪"
msgstr "<$voicel(1,7)><$emotion(1,8)>♪Kri, kri... Kri, kri...♪ ¡Hoy también estoy imparable!<clear><br><$voicel(1,3)><$emotion(1,29)>¿Hm? ¿Y tú de dónde sales? ¿Te gustó mi serenata?<br><$voicel(1,6)><$facial(1,4)><$motion(1,805)><$comeff(1,10)>Pues yo gané <gen;-2(un,una)> fan, ¡pero tú <gen;-3(un amigo,una amiga)>!<clear><br>¡Voy a plasmar estos sentimientos en mi próximo tema!<br><$voicel(1,10)><$emotion(1,62)>♪Kri, kri... Tun, tun...♪"

#. en: <$voicel(1,5)><$motionoff(1,805)><$comeff(1,6)>Yo, ummm... Would you happen to know of any big, sturdy<br>trees around here? <$voicel(1,8)><$facial(1,4)>I wanna practice my <$cdef(27)>Headbutt</color>.<slide><br><$voicel(1,2)><$motion(1,803)><$comeff(1,3)><$facial(1,13)>O-ohh... <$voicel(1,4)><$emotion(1,3)><$comeff(1,6)>I shouldn’t go knocking down trees all<slide><br>willy-nilly?<clear><br><$voicel(1,7)><$motion(1,803)><$comeff(1,14)><$facial(1,1)>Yooo... OK. You’re doin’ some environ-mental re-form?<br>And it’s all for the Pokémon here?<clear><br><$voicel(1,5)><$emotion(1,33)>So, uh... In other words, uh...<clear><br><$voicel(1,7)><$emotion(1,15)>That’s, like...super amazing! Guess I underestimated you!<clear><br><$voicel(1,9)><$emotion(1,39)>I’m sorry about the trees, yo. I won’t do that anymore, and<br>you can totally call on me anytime you need me!
msgctxt "3255:211"
msgid "<$voicel(1,5)><$motionoff(1,805)>Disculpa, <$comeff(1,6)>¿no sabrás dónde hay un árbol fuerte y grande<br>por aquí, por casualidad? <$voicel(1,8)><$facial(1,4)>Es para practicar <$cdef(27)>Golpe Cabeza</color>.<clear><br><$voicel(1,2)><$motion(1,803)><$comeff(1,3)><$facial(1,13)>¿Cómo que no puedo ir derribando árboles por ahí?<br><$voicel(1,4)><$emotion(1,3)><$comeff(1,6)>¡Primera noticia!<clear><br><$voicel(1,7)><$motion(1,803)><$comeff(1,14)><$facial(1,1)>¿Así que este lugar lo estás aclima... tando, dices?<br>¿Para que los Pokémon puedan vivir en él?<clear><br><$voicel(1,5)><$emotion(1,33)>Hmm... A ver si te estoy entendiendo... Entonces...<br><$voicel(1,7)><$emotion(1,15)>¡Eres la leche! ¡Me encanta lo que haces!<clear><br><$voicel(1,9)><$emotion(1,39)>A partir de ahora tendré cuidado con los árboles.<br>¡Tienes mi apoyo!"
msgstr "<$voicel(1,5)><$motionoff(1,805)>Disculpa, <$comeff(1,6)>¿no sabrás dónde hay un árbol fuerte y grande<br>por aquí, por casualidad? <$voicel(1,8)><$facial(1,4)>Es para practicar <$cdef(27)>Golpe Cabeza</color>.<clear><br><$voicel(1,2)><$motion(1,803)><$comeff(1,3)><$facial(1,13)>¿Cómo que no puedo ir derribando árboles por ahí?<br><$voicel(1,4)><$emotion(1,3)><$comeff(1,6)>¡Primera noticia!<clear><br><$voicel(1,7)><$motion(1,803)><$comeff(1,14)><$facial(1,1)>¿Así que este lugar lo estás aclima... tando, dices?<br>¿Para que los Pokémon puedan vivir en él?<clear><br><$voicel(1,5)><$emotion(1,33)>Hmm... A ver si te estoy entendiendo... Entonces...<br><$voicel(1,7)><$emotion(1,15)>¡Eres increíble! ¡Me encanta lo que haces!<clear><br><$voicel(1,9)><$emotion(1,39)>A partir de ahora tendré cuidado con los árboles.<br>¡Tienes mi apoyo!"

#. en: <$voicel(1,10)><$motionoff(1,814)>Grahhh!<wait(0.5)><$se2d(2095)><$motionoff(0,182)><wait(0.06)><$comeff(0,5)><wait(0.8)><clear><br><$voicel(1,7)><$emotion(1,14)>Whoa! Sorry ’bout that! I was just practicin’ my <$cdef(27)>Headbutt</color>!<br><$voicel(1,4)><$motionoff(1,805)><$comeff(1,4)>You OK, bud?!<wait(1.0)><$motionoff(0,181)><wait(1.5)><$motionoff(0,250)><wait(1.5)><clear><br><$voicel(1,5)><$comeff(1,17)>Hm. Seems like you’re fine. That’s a relief!<clear><br><$voicel(1,7)><$emotion(1,14)>I gotta say, you felt, uh...REALLY soft and squishy!<clear><br><$voicel(1,3)>I can smash through pretty much any hard object with<br>my <$cdef(27)>Headbutt</color>...<clear><br><$voicel(1,7)><$emotion(1,38)>But if we battled, I think I’d have trouble smashing through<br>you! Let’s maybe just be friends instead, yeah?
msgctxt "3255:212"
msgid "<$voicel(1,10)><$motionoff(1,814)>¡Raaam!<wait(0.5)><$se2d(2095)><$motionoff(0,182)><wait(0.06)><$comeff(0,5)><wait(0.8)><clear><br><$voicel(1,7)><$emotion(1,14)>¡Ahí vaaa! ¡Perdona, niñ<gen;-2(o,a)>! ¡Me has pillado justo cuando<br>estaba entrenando mis cabezazos! <$voicel(1,4)><$motionoff(1,805)><$comeff(1,4)>¡¿Estás bien?!<wait(1.0)><$motionoff(0,181)><wait(1.5)><$motionoff(0,250)><wait(1.5)><clear><br><$voicel(1,5)><$comeff(1,17)>Bueno, parece que sí. ¡Menos mal!<clear><br><$voicel(1,7)><$emotion(1,14)>Por cierto, qué cuerpo tan blandurrio tienes, ¿no?<clear><br><$voicel(1,3)>Cuando se pone en mi punto de mira un objetivo bien<br>duro y sólido, ¡lo hago añicos de un cabezazo!<clear><br><$voicel(1,7)><$emotion(1,38)>Pero, si tuviera que vérmelas contigo, no sabría ni por<br>dónde empezar. ¡Así que vamos a llevarnos bien, amig<gen;-2(o,a)>!"
msgstr "<$voicel(1,10)><$motionoff(1,814)>¡Raaam!<wait(0.5)><$se2d(2095)><$motionoff(0,182)><wait(0.06)><$comeff(0,5)><wait(0.8)><clear><br><$voicel(1,7)><$emotion(1,14)>¡Vaaaya! ¡Perdona, pequeñ<gen;-2(o,a)>! ¡Llegaste justo cuando<br>estaba entrenando mis cabezazos! <$voicel(1,4)><$motionoff(1,805)><$comeff(1,4)>¡¿Estás bien?!<wait(1.0)><$motionoff(0,181)><wait(1.5)><$motionoff(0,250)><wait(1.5)><clear><br><$voicel(1,5)><$comeff(1,17)>Bueno, parece que sí. ¡Menos mal!<clear><br><$voicel(1,7)><$emotion(1,14)>Por cierto, qué cuerpo tan blandito tienes, ¿no?<clear><br><$voicel(1,3)>Cuando se pone en mi punto de mira un objetivo bien<br>duro y sólido, ¡lo hago añicos de un cabezazo!<clear><br><$voicel(1,7)><$emotion(1,38)>Pero, si tuviera que vérmelas contigo, no sabría ni por<br>dónde empezar. ¡Así que vamos a llevarnos bien, amig<gen;-2(o,a)>!"

#. en: <$comeff(1,23)><$motion(1,802)><$voicel(1,3)>Hmmm... I wonder where I am...<wait(1.2)><$motion(0,215)><wait(0.5)><clear><br>Oh! <$comeff(1,5)><$motion(1,803)><$voicel(1,10)><$lookat(1,1,0)><waitactor(1)><$voicel(1,7)>Um... Hello there! Do you live around here?<clear><br><$comeff(1,23)><$motion(1,805)><$voicel(1,5)>I don’t know anything about this area, and...I’m really<br>nervous, to be honest. But...<$comeff(1,21)><$motion(1,806)><$voicel(1,8)>I hope we can be friends.<slide><br><$comeff(1,13)><$motion(1,807)><$voicel(1,7)>So, um, yeah... Nice to meet you!
msgctxt "3255:213"
msgid "<$comeff(1,23)><$motion(1,802)><$voicel(1,3)>Esto... ¿Q-qué es este lugar?<wait(1.2)><$motion(0,215)><wait(0.5)><clear><br>Ah... <$comeff(1,5)><$motion(1,803)><$voicel(1,10)><$lookat(1,1,0)><waitactor(1)><$voicel(1,7)>Hola... Encantad<gen;-3(o,a)>... ¿Eres de por aquí?<clear><br><$comeff(1,23)><$motion(1,805)><$voicel(1,5)>N-no sé mucho de esta zona y aún no conozco a nadie,<br>así que estoy un tanto nervios<gen;-3(o,a)>...<clear><br><$comeff(1,21)><$motion(1,806)><$voicel(1,8)>Espero que podamos llevarnos bien... <$comeff(1,13)><$motion(1,807)><$voicel(1,7)>¡N-nos vemos!"
msgstr ""

#. en: <$comeff(1,10)><$motion(1,801)><$voicel(1,7)>Heyyy there. Nice to meet you.<clear><br><$voicel(1,5)>My biggest strength is that I’m just sturdy, you knooow?<clear><br><$comeff(1,14)><$motion(1,805)><$voicel(1,6)>So if aaanyone tries to attack you around here, <$comeff(1,13)><$motion(1,806)><$voicel(1,7)>you hide<br>behind me. OK?<clear><br><$comcan(1)><$motion(1,803)><$voicel(1,8)>Whaaat? It’s all peaceful here? And there aren’t any<br>enemies? <$comeff(1,21)><$motion(1,807)><$voicel(1,9)>That’s greeeaaat!
msgctxt "3255:214"
msgid "<$comeff(1,10)><$motion(1,801)><$voicel(1,7)>Eyyy, holaaa, ¿qué tal? Encantad<gen;-3(o,a)> de conocerte.<clear><br><$voicel(1,5)>Oye, que sepas que aquí tienes <gen;-3(un,una)> tip<gen;-3(o,a)> fuerte para lo<br>que necesites, ¿eeeh? Nadie me tose a robust<gen;-3(o,a)>.<clear><br><$comeff(1,14)><$motion(1,805)><$voicel(1,6)>Si ves que alguien está a punto de atacarte por aquí,<br><$comeff(1,13)><$motion(1,806)><$voicel(1,7)>tú corre a esconderte detrás de mí, ¿vale? Sin problema.<clear><br><$comcan(1)><$motion(1,803)><$voicel(1,8)>¿Cómo? ¿Que aquí reina la paz? ¿No hay ni un mísero<br>enemigo que echarse a la caraaa?<clear><br><$comeff(1,21)><$motion(1,807)><$voicel(1,9)>¡Pues mejor me lo pones, maj<gen;-2(o,a)>!"
msgstr "<$comeff(1,10)><$motion(1,801)><$voicel(1,7)>Eyyy, holaaa, ¿qué tal? Encantad<gen;-3(o,a)> de conocerte.<clear><br><$voicel(1,5)>Oye, que sepas que aquí tienes <gen;-3(un,una)> tip<gen;-3(o,a)> fuerte para lo<br>que necesites, ¿eeeh? Nadie me supera en lo robust<gen;-3(o,a)>.<clear><br><$comeff(1,14)><$motion(1,805)><$voicel(1,6)>Si ves que alguien está a punto de atacarte por aquí,<br><$comeff(1,13)><$motion(1,806)><$voicel(1,7)>tú corre a esconderte detrás de mí, ¿sí? Sin problema.<clear><br><$comcan(1)><$motion(1,803)><$voicel(1,8)>¿Cómo? ¿Que aquí reina la paz? ¿No hay ni un mísero<br>enemigo que echarse a la caraaa?<clear><br><$comeff(1,21)><$motion(1,807)><$voicel(1,9)>¡Pues mucho mejor, amig<gen;-2(o,a)>!"

#. en: <$voicel(1,7)><$emotion(1,27)>Bzzz bzzz! Hi there! Nice to meet you!<clear><br><$voicel(1,5)><$facial(1,4)><$motion(1,803)><$comeff(1,21)>Are you the one who made this pretty flower bed? Wow!<clear><br><$voicel(1,9)><$emotion(1,6)>These flowers look like they have really sweet, juicy,<br>delicious nectar!<clear><br><$voicel(1,5)><$emotion(1,60)>We’re gonna live here now, OK? Thanks! See you around!
msgctxt "3255:215"
msgid "<$voicel(1,7)><$emotion(1,27)>¡Com, com! ¿Qué tal?<clear><br><$voicel(1,5)><$facial(1,4)><$motion(1,803)><$comeff(1,21)>¡¡Ualaaa!! ¿Has sido tú <gen;-2(el,la)> que ha colocado aquí todas<br>estas flores tan bonitas? ¡¡Qué chupiii!!<clear><br><$voicel(1,9)><$emotion(1,6)>¡Seguro que el néctar que dan está superdulce<br>y riquisísimo!<clear><br><$voicel(1,5)><$emotion(1,60)>¡Pues ya está, decidido! ¡Voy a mudarme aquí!"
msgstr "<$voicel(1,7)><$emotion(1,27)>¡Com, com! ¿Qué tal?<clear><br><$voicel(1,5)><$facial(1,4)><$motion(1,803)><$comeff(1,21)>¡¡Guaaau!! ¿Fuiste tú <gen;-2(el,la)> que colocó aquí todas<br>estas flores tan bonitas? ¡¡Qué geniaaal!!<clear><br><$voicel(1,9)><$emotion(1,6)>¡Seguro que el néctar que dan está superdulce<br>y riquisísimo!<clear><br><$voicel(1,5)><$emotion(1,60)>¡Pues ya está, decidido! ¡Voy a mudarme aquí!"

#. en: <$voicel(1,5)><$emotion(1,14)>Well, hello there, child! Don’t you look cute as a blossom?<clear><br><$voicel(1,3)><$emotion(1,64)>This gorgeous field of flowers... Am I right in thinking you<br>are the one who grew these?<clear><br><$voicel(1,7)><$emotion(1,6)>There’s nothing I love more than the sweet, sweet nectar<br>found in flowers, so I’m pleased as pollen!<clear><br><$voicel(1,9)><$comeff(1,9)><$motion(1,806)>Though I admit I also have a fondness for adorable, dutiful<br>little charmers like you!
msgctxt "3255:216"
msgid "<$voicel(1,5)><$emotion(1,14)>Es un placer conocer a <gen;-2(un,una)> chiquill<gen;-2(o,a)> tan bell<gen;-2(o,a)> como<br>la más bella flor.<clear><br><$voicel(1,3)><$emotion(1,64)>¿Todas estas flores de aquí han sido obra tuya?<br><$voicel(1,7)><$emotion(1,6)>¡No sabes lo feliz que me has hecho!<clear><br><$voicel(1,9)><$comeff(1,9)><$motion(1,806)>Mis dos cosas favoritas de este mundo son el néctar<br>de las flores y l<gen;-2(o,a)>s niñ<gen;-2(o,a)>s amables y tiern<gen;-2(o,a)>s como tú."
msgstr "<$voicel(1,5)><$emotion(1,14)>Es un placer conocer a <gen;-2(un,una)> chiquill<gen;-2(o,a)> tan bell<gen;-2(o,a)> como<br>la más bella flor.<clear><br><$voicel(1,3)><$emotion(1,64)>¿Todas estas flores de aquí fueron obra tuya?<br><$voicel(1,7)><$emotion(1,6)>¡No sabes lo feliz que me hiciste!<clear><br><$voicel(1,9)><$comeff(1,9)><$motion(1,806)>Mis dos cosas favoritas de este mundo son el néctar<br>de las flores y l<gen;-2(o,a)>s niñ<gen;-2(o,a)>s amables y tiern<gen;-2(o,a)>s como tú."

#. en: <$voicel(1,3)><$facial(1,9)><$motion(1,663)><$comeff(1,18)>Water... I need water... Nnngh, I’m all dried out.<clear><br><$voicel(1,2)><$motion(1,806)><$comeff(1,7)><$facial(1,9)>I came all this way, but now, I don’t think I can go any<br>further...<wait(1.0)><$motion(0,748)><wait(1.0)><clear><br><$comeff(1,5)><$facial(1,1)><$motion(1,805)>Wha—?! <wait(1.8)><$voicel(1,7)>Was that Water Gun?! Did you do that?<clear><br><$voicel(1,10)><$facial(1,4)><$motionoff(1,804)><$comeff(1,9)>Thank you SO MUCH! You SAVED me!<clear><br><$voicel(1,7)><$emotion(1,39)>I promise I’ll make it up to you! Let’s be friends!
msgctxt "3255:217"
msgid "<$voicel(1,3)><$facial(1,9)><$motion(1,663)><$comeff(1,18)>Uf... Me muero de seeed... Que alguien me dé aguaaa...<br><$voicel(1,2)><$motion(1,806)><$comeff(1,7)><$facial(1,9)>No puedo más...<wait(1.0)><$motion(0,748)><wait(1.0)><clear><br><$comeff(1,5)><$facial(1,1)><$motion(1,805)>¡Oh! <wait(1.8)><$voicel(1,7)>¡¿Así que sabes usar Pistola Agua?!<clear><br><$voicel(1,10)><$facial(1,4)><$motionoff(1,804)><$comeff(1,9)>¡¡Muchas graciaaas!! ¡No sé qué habría hecho sin ti!<br><$voicel(1,7)><$emotion(1,39)>¡Te debo una muy gorda!"
msgstr "<$voicel(1,3)><$facial(1,9)><$motion(1,663)><$comeff(1,18)>Uf... Me muero de seeed... Que alguien me dé aguaaa...<br><$voicel(1,2)><$motion(1,806)><$comeff(1,7)><$facial(1,9)>No puedo más...<wait(1.0)><$motion(0,748)><wait(1.0)><clear><br><$comeff(1,5)><$facial(1,1)><$motion(1,805)>¡Oh! <wait(1.8)><$voicel(1,7)>¡¿Así que sabes usar Chorro de Agua?!<clear><br><$voicel(1,10)><$facial(1,4)><$motionoff(1,804)><$comeff(1,9)>¡¡Muchas graciaaas!! ¡No sé qué habría hecho sin ti!<br><$voicel(1,7)><$emotion(1,39)>¡Te debo una muy gorda!"

#. en: <$voicel(1,7)><$emotion(1,14)>Nice to meetcha! I’m looking for my friend right now.<clear><br><$voicel(1,5)><$motion(1,806)><$facial(1,4)><$comeff(1,21)>They look just like me—just a different color! And<br>it’s a REALLY pretty color, to boot...<clear><br><$voicel(1,7)><$emotion(1,8)><$voicel(1,7)>I gotta do my best each and every day so I can be just as<br>pretty as them!<clear><br><$voicel(1,5)><$emotion(1,49)>Hehe... Whoops, I didn’t mean to say all that. Don’t tell<br>them what I said, OK?
msgctxt "3255:218"
msgid "<$voicel(1,7)><$emotion(1,14)>Ho-hola. Estoy buscando a mi amiga...<clear><br><$voicel(1,5)><$motion(1,806)><$facial(1,4)><$comeff(1,21)>Es clavadita a mí, pero de un color mucho más bonito.<clear><br><$voicel(1,7)><$emotion(1,8)><$voicel(1,7)>La verdad es que me da mucha envidia, y me esfuerzo<br>un montón para ser tan bonit<gen;-3(o,a)> como ella...<clear><br><$voicel(1,5)><$emotion(1,49)>Uy, me he ido de la lengua un poco. No se lo digas, eh..."
msgstr "<$voicel(1,7)><$emotion(1,14)>Ho-hola. Estoy buscando a mi amiga...<clear><br><$voicel(1,5)><$motion(1,806)><$facial(1,4)><$comeff(1,21)>Es idéntica a mí, pero de un color mucho más bonito.<clear><br><$voicel(1,7)><$emotion(1,8)><$voicel(1,7)>La verdad es que me da mucha envidia, y me esfuerzo<br>un montón para ser tan bonit<gen;-3(o,a)> como ella...<clear><br><$voicel(1,5)><$emotion(1,49)>Uy, se me fue la lengua un poco. No se lo digas, eh..."

#. en: <$emotion(1,14)><$voicel(1,10)>You, there! Would you listen to this?<clear><br><$comeff(1,7)><$facial(1,9)><$voicel(1,3)>I bumped my head into a wall just a bit ago... <wait(0.6)><$motion(1,802)>See?<br>Right here!<clear><br><$emotion(1,38)><$voicel(1,9)>Oh, wait, I forgot... I never have any bruises—or any visible<br>injuries, for that matter! <$comeff(1,9)><$motion(1,806)><$voicel(1,8)>Any bump or scrape just heals<slide><br>itself right up!<clear><br><$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,4)>But that doesn’t change the fact that it hurts...<clear><br><$emotion(1,14)><$voicel(1,7)>Oh goodness, look at me babbling on like this when we’ve<br>only just met... Thanks so much for listening!
msgctxt "3255:219"
msgid "<$emotion(1,14)><$voicel(1,10)>¡Oyyy! Escucha que te diga...<clear><br><$comeff(1,7)><$facial(1,9)><$voicel(1,3)>Antes me he pegado un porrazo pero bueeeno bueno<br>contra una roca y...<wait(0.6)><$motion(1,802)> ¡Sí, justo aquí! ¡Mira, mira!<clear><br><$emotion(1,38)><$voicel(1,9)>¿Dices que no tengo ni herida ni cicatriz ni nada?<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,8)>Será porque mi cuerpo tiene la capacidad de regenerarse<br>al instante, ¿sabes?<clear><br><$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,4)>Aunque sea muy práctico, el daño del porrazo que me<br>he dado no me lo quita nadie...<clear><br><$emotion(1,14)><$voicel(1,7)>Uy, perdona, si es que me enrollo más que las persianas.<br>Gracias por escuchar mis desvaríos, y ¡encantad<gen;-3(o,a)>!"
msgstr "<$emotion(1,14)><$voicel(1,10)>¡Oyyy! Déjame contarte algo...<clear><br><$comeff(1,7)><$facial(1,9)><$voicel(1,3)>Hace un rato me di un porrazo pero bueeeno bueno<br>contra una roca y...<wait(0.6)><$motion(1,802)> ¡Sí, justo aquí! ¡Mira, mira!<clear><br><$emotion(1,38)><$voicel(1,9)>¿Dices que no tengo ni herida ni cicatriz ni nada?<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,8)>Será porque mi cuerpo tiene la capacidad de regenerarse<br>al instante, ¿sabes?<clear><br><$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,4)>Aunque sea muy práctico, el daño del porrazo que me<br>di no me lo quita nadie...<clear><br><$emotion(1,14)><$voicel(1,7)>Uy, perdona, es que hablo hasta por los codos.<br>Gracias por escuchar mis desvaríos, y ¡encantad<gen;-3(o,a)>!"

#. en: <$voicel(1,7)><$comeff(1,9)><$motion(1,803)><$facial(1,4)>Oh, hiii! Nice to meet you. I like this place because it<br>makes me feel so relaaaaxed. <$voicel(1,4)><$comeff(1,6)><$motion(1,666)><$facial(1,1)>Are you here to relax too?<clear><br><$motion(0,824)><wait(1.0)><$motion(0,652)><wait(0.5)><$voicel(1,7)><$emotion(1,27)>Whaaaaaat? YOU’RE the one who got this place all set<br>up? That’s...that’s amaaaziiing.<clear><br><$voicel(1,5)><$emotion(1,8)>You’re kinda makin’ me feel motivated too... <$voicel(1,8)><$emotion(1,49)>Let me know<br>if you ever need some heeelp!
msgctxt "3255:220"
msgid "<$voicel(1,7)><$comeff(1,9)><$motion(1,803)><$facial(1,4)>Hola, es un placer. Me gusta mucho el ambiente relajado<br>de este sitio.<clear><br><$voicel(1,4)><$comeff(1,6)><$motion(1,666)><$facial(1,1)>¿Tú también estás aquí para desconectar?<clear><br><$motion(0,824)><wait(1.0)><$motion(0,652)><wait(0.5)><$voicel(1,7)><$emotion(1,27)>¿Qué dices? ¿Que has sido tú quien ha montado esto?<br>Guaaau, increíble.<clear><br><$voicel(1,5)><$emotion(1,8)>Oírte decir eso me ha dado ganas de ayudar... <$voicel(1,8)><$emotion(1,49)>Avísame<br>si puedo hacer algo, ¿vale?"
msgstr "<$voicel(1,7)><$comeff(1,9)><$motion(1,803)><$facial(1,4)>Hola, es un placer. Me gusta mucho el ambiente relajado<br>de este lugar.<clear><br><$voicel(1,4)><$comeff(1,6)><$motion(1,666)><$facial(1,1)>¿Tú también estás aquí para desconectar?<clear><br><$motion(0,824)><wait(1.0)><$motion(0,652)><wait(0.5)><$voicel(1,7)><$emotion(1,27)>¿Qué dices? ¿Que fuiste tú quien armó esto?<br>Guaaau, increíble.<clear><br><$voicel(1,5)><$emotion(1,8)>Oírte decir eso me dio ganas de ayudar... <$voicel(1,8)><$emotion(1,49)>Avísame<br>si puedo hacer algo, ¿sí?"

#. en: <$voicel(1,9)><$emotion(1,27)>Floohoo! A human child!<wait(1.3)><$voicel(1,8)><$comeff(1,9)> Here, child, come with me...<clear><br><$voicel(1,5)><$comeff(1,6)>Huh?<$emotion(1,14)> Oh, you’re a Pokémon, aren’t you?<clear><br><$voicel(1,7)><$motion(1,801)><$comeff(1,21)>Well, Pokémon make good travel buddies too! ♪<$voicel(1,10)> Let’s be<br>friends so we can visit lots of different places together.<clear><br><$voicel(1,5)><$emotion(1,25)><$comeff(1,9)>You know what they say—um...<wait(1.0)>it’s dangerous to go alone!
msgctxt "3255:221"
msgid "<$voicel(1,9)><$emotion(1,27)>¡Pero si es <gen;-2(un,una)> niñ<gen;-2(o,a)> human<gen;-2(o,a)>!<clear><br><$voicel(1,8)><$comeff(1,9)>Oye, vente conmigo...<clear><br><$voicel(1,5)><$comeff(1,6)>Un momento... <wait(0.9)><$emotion(1,14)>Tú eres un Pokémon... <wait(0.9)><$voicel(1,7)><$motion(1,801)><$comeff(1,21)>Bueno, qué más da...<br>Seré tu amig<gen;-3(o,a)> <$voicel(1,10)>e iremos a visitar un montón de sitios.<clear><br><$voicel(1,5)><$emotion(1,25)><$comeff(1,9)>Ya verás... Lo vamos a pasar de muerte... Jeee."
msgstr "<$voicel(1,9)><$emotion(1,27)>¡Pero si es <gen;-2(un,una)> niñ<gen;-2(o,a)> human<gen;-2(o,a)>!<clear><br><$voicel(1,8)><$comeff(1,9)>Oye, vente conmigo...<clear><br><$voicel(1,5)><$comeff(1,6)>Un momento... <wait(0.9)><$emotion(1,14)>Tú eres un Pokémon... <wait(0.9)><$voicel(1,7)><$motion(1,801)><$comeff(1,21)>Bueno, qué más da...<br>Seré tu amig<gen;-3(o,a)> <$voicel(1,10)>e iremos a visitar un montón de lugares.<clear><br><$voicel(1,5)><$emotion(1,25)><$comeff(1,9)>Ya verás... La vamos a pasar increíble... Jeee."

#. en: <$comeff(1,10)><$motionoff(1,804)><$voicel(1,5)>Hi theeere. Ummm...where are we?<clear><br><$motion(1,802)><$voicel(1,7)>I was just floating around and vibing and found<br>myself here...<clear><br><$motion(1,803)><$voicel(1,5)>Weeell... I guess it doesn’t matter. Seems like a niiice place<br>to be.<clear><br><$comeff(1,13)><$motion(1,801)><$voicel(1,7)>It might not be so bad to settle dowwwn in one spot<br>sometimes, huh?
msgctxt "3255:222"
msgid "<$comeff(1,10)><$motionoff(1,804)><$voicel(1,5)>Ah, hola, encantad<gen;-3(o,a)> de conocerte. Oye, una preguntica:<br>¿podrías decirme dónde estoy?<clear><br><$motion(1,802)><$voicel(1,7)>Es que he estado flotaaando a la deriva y he acabado<br>por recalar en este lugar.<clear><br><$motion(1,803)><$voicel(1,5)>Pero mira, al final tanto me da. Parece que se está a<br>gustico aquí.<clear><br><$comeff(1,13)><$motion(1,801)><$voicel(1,7)>Supongo que de vez en cuando no viene mal anclarse<br>una temporada en un mismo sitio."
msgstr "<$comeff(1,10)><$motionoff(1,804)><$voicel(1,5)>Ah, hola, encantad<gen;-3(o,a)> de conocerte. Oye, una preguntita:<br>¿podrías decirme dónde estoy?<clear><br><$motion(1,802)><$voicel(1,7)>Es que estuve flotaaando a la deriva y terminé<br>por recalar en este lugar.<clear><br><$motion(1,803)><$voicel(1,5)>Pero mira, al final me da igual. Parece que se está a<br>gustito aquí.<clear><br><$comeff(1,13)><$motion(1,801)><$voicel(1,7)>Supongo que de vez en cuando no viene mal anclarse<br>una temporada en un mismo lugar."

#. en: <$comeff(1,13)><$motion(1,801)><$voicel(1,7)>Ah. I knew I’d find a good home sooner or later. It was ME<br>searching, after all.<clear><br><$comeff(1,6)><$motion(1,803)><$voicel(1,5)>Hm? You built this place? <$comeff(1,10)><$motion(1,807)><$voicel(1,7)>Heh heh, that’s an impressive<br>feat! Thank you.<clear><br><$comeff(1,14)><$motion(1,817)><$voicel(1,4)>... ... ...<$pkcry;2(1,2)>.<wait(0.8)><$comeff(0,5)><$comcan(1)><clear><br><$voicel(1,7)><$comeff(1,10)><$motion(1,805)>...There. I’ve cast a good-luck spell on you as thanks.<clear><br><$voicel(1,5)><$motion(1,806)>It seems my spells sometimes bring happiness—<$voicel(1,6)>but they<br>may also bring torment.<clear><br><$comeff(1,13)><$motionoff(1,804)><$voicel(1,9)>I’m sure you’ll be just fine, though. I’ve got a feeling.
msgctxt "3255:223"
msgid "<$comeff(1,13)><$motion(1,801)><$voicel(1,7)>Tal y como presagiaba, he logrado hallar una morada que<br>responde a mis exigencias. No esperaba menos de mí.<clear><br><$comeff(1,6)><$motion(1,803)><$voicel(1,5)>¿Cómo dices? ¿Eres tú <gen;-2(el,la)> <gen;-2(autor,autora)> de semejante maravilla?<br><$comeff(1,10)><$motion(1,807)><$voicel(1,7)>Je, pues mi más sincera enhorabuena y agradecimiento.<clear><br><$comeff(1,14)><$motion(1,817)><$voicel(1,4)>... <wait(0.8)><$pkcry;2(1,2)>...<wait(0.8)><$comeff(0,5)><$comcan(1)><clear><br><$voicel(1,7)><$comeff(1,10)><$motion(1,805)>Te he lanzado un conjuro como muestra de gratitud.<clear><br><$voicel(1,5)><$motion(1,806)>Mis conjuros son capaces de portar dicha...<$voicel(1,6)> pero también<br>la desdicha.<clear><br><$comeff(1,13)><$motionoff(1,804)><$voicel(1,9)>Mas no te preocupes. Estoy segur<gen;-3(o,a)> de que, en tu caso,<br>los hados te serán favorables."
msgstr "<$comeff(1,13)><$motion(1,801)><$voicel(1,7)>Tal y como presagiaba, logré hallar una morada que<br>responde a mis exigencias. No esperaba menos de mí.<clear><br><$comeff(1,6)><$motion(1,803)><$voicel(1,5)>¿Cómo dices? ¿Eres tú <gen;-2(el,la)> <gen;-2(autor,autora)> de semejante maravilla?<br><$comeff(1,10)><$motion(1,807)><$voicel(1,7)>Je, pues te felicito y te lo agradezco de corazón.<clear><br><$comeff(1,14)><$motion(1,817)><$voicel(1,4)>... <wait(0.8)><$pkcry;2(1,2)>...<wait(0.8)><$comeff(0,5)><$comcan(1)><clear><br><$voicel(1,7)><$comeff(1,10)><$motion(1,805)>Te lancé un conjuro como muestra de gratitud.<clear><br><$voicel(1,5)><$motion(1,806)>Mis conjuros son capaces de portar dicha...<$voicel(1,6)> pero también<br>la desdicha.<clear><br><$comeff(1,13)><$motionoff(1,804)><$voicel(1,9)>Mas no te preocupes. Estoy segur<gen;-3(o,a)> de que, en tu caso,<br>los hados te serán favorables."

#. en: <$voicel(1,1)><$motion(1,816)><$facial(1,7)><$comeff(1,5)>Caw, caaawww!!!<clear><br><$voicel(1,5)><$emotion(1,65)>Hmph. Still no response. Where in the world is this<br>place?<clear><br><$lookat(1,1,0)><waitactor(1)>...<$voicel(1,7)><$comeff(1,3)>Oh, I was expecting <$cdef(27)>Murkrow</color>, but instead a strange-<br>looking human has appeared.<clear><br><$voicel(1,5)><$motion(1,805)><$comeff(1,6)>No, wait. On closer inspection, you seem to be a <$cdef(27)>Ditto</color>.<clear><br><$voicel(1,1)><$emotion(1,31)>To tell you the truth, all of my many followers have gone<br>off somewhere.<clear><br><$voicel(1,9)><$emotion(1,50)>For now I’ll be living here, so I hope to see you around!
msgctxt "3255:224"
msgid "<$voicel(1,1)><$motion(1,816)><$facial(1,7)><$comeff(1,5)>¡Krooow! ¡Hooonch!<clear><br><$voicel(1,5)><$emotion(1,65)>¿Por qué no acude nadie a mi llamada? ¿Qué clase de<br>lugar es este?<clear><br><$lookat(1,1,0)><waitactor(1)>Hm...<$voicel(1,7)><$comeff(1,3)> En lugar de mis leales <$cdef(27)>Murkrow</color>, es un ser humano<br>de dudoso aspecto quien se presenta ante mí...<clear><br><$voicel(1,5)><$motion(1,805)><$comeff(1,6)>No, bien mirado... Se trata en realidad de un <$cdef(27)>Ditto</color>.<clear><br><$voicel(1,1)><$emotion(1,31)>Hablando con franqueza, mis numerosos súbditos parecen<br>haberse esfumado...<clear><br><$voicel(1,9)><$emotion(1,50)>Tengo intención de asentarme aquí, así que espero que<br>entablemos una próspera amistad."
msgstr ""

#. en: <$comeff(1,1)><$facial(1,14)><$motion(1,802)><$voicel(1,7)>What is this place? It makes me feel kinda nervous when<br>I don’t know where I am...<clear><br><$comeff(1,5)><$facial(1,1)><$motion(1,803)><$voicel(1,8)>Oh! Hi there! Are you from around here?<clear><br><$comeff(1,10)><$motionoff(1,804)><$voicel(1,10)>Um, just so you know, I’m not crying. These aren’t tears.<br>They’re sweat! So don’t worry!<clear><br><$comeff(1,13)><$motion(1,806)><$voicel(1,5)>Tears do come out of my eyes sometimes too, but so does<br>sweat.<clear><br><$comeff(1,21)><$motion(1,802)><$voicel(1,9)>But anyway, I’m really happy to meet you! I got a feeling<br>we’re gonna be friends!<clear><br><$comeff(1,10)><$motion(1,801)><$voicel(1,10)>Oh, now THESE are tears—happy ones!
msgctxt "3255:225"
msgid "<$comeff(1,1)><$facial(1,14)><$motion(1,802)><$voicel(1,7)>¿Dónde estoy? Ay, cómo me estresan los sitios que<br>no conozco...<clear><br><$comeff(1,5)><$facial(1,1)><$motion(1,803)><$voicel(1,8)>¡Oh! ¡Holi! ¿Eres de por aquí?<clear><br><$comeff(1,10)><$motionoff(1,804)><$voicel(1,10)>No te preocupes por mí, ¿eh?, que no estoy llorando,<br>es que cuando me entra el estrés me pongo a sudar...<clear><br><$comeff(1,13)><$motion(1,806)><$voicel(1,5)>¡Te lo juro! ¡Que aunque me estén saliendo de los ojos,<br>estas gotas son sudor y no lágrimas!<clear><br><$comeff(1,21)><$motion(1,802)><$voicel(1,9)>Uf, pero cómo me alegro de que estés aquí, tienes pinta<br>de ser muy maj<gen;-2(o,a)>...<clear><br><$comeff(1,10)><$motion(1,801)><$voicel(1,10)>¡Ay, ahora sí que se me saltan las lágrimas de lo content<gen;-3(o,a)><br>que estoy!"
msgstr "<$comeff(1,1)><$facial(1,14)><$motion(1,802)><$voicel(1,7)>¿Dónde estoy? Ay, cómo me estresan los lugares que<br>no conozco...<clear><br><$comeff(1,5)><$facial(1,1)><$motion(1,803)><$voicel(1,8)>¡Oh! ¡Holi! ¿Eres de por aquí?<clear><br><$comeff(1,10)><$motionoff(1,804)><$voicel(1,10)>No te preocupes por mí, ¿eh?, que no estoy llorando,<br>es que cuando me entra el estrés me pongo a sudar...<clear><br><$comeff(1,13)><$motion(1,806)><$voicel(1,5)>¡Te lo juro! ¡Que aunque me estén saliendo de los ojos,<br>estas gotas son sudor y no lágrimas!<clear><br><$comeff(1,21)><$motion(1,802)><$voicel(1,9)>Uf, pero cómo me alegro de que estés aquí, pareces<br>muy simpátic<gen;-2(o,a)>...<clear><br><$comeff(1,10)><$motion(1,801)><$voicel(1,10)>¡Ay, ahora sí que se me saltan las lágrimas de lo content<gen;-3(o,a)><br>que estoy!"

#. en: <$voicel(1,5)><$emotion(1,27)><$facial(1,13)>Whoa!<clear><br><$voicel(1,3)><$comeff(1,14)><$motion(1,816)>You look just like a human! <$voicel(1,4)><$comeff(1,6)>But you’re not really a<br>human, right?<clear><br><$voicel(1,9)><$motion(1,807)><$comeff(1,9)>I’ve never met a Pokémon who’s <$voicel(1,6)><$comeff(1,10)>as good at mimicking<br>as I am!<clear><br><$voicel(1,9)><$emotion(1,63)>You really do look just like a human, though... I’m kinda<br>jealous!
msgctxt "3255:226"
msgid "<$voicel(1,5)><$emotion(1,27)><$facial(1,13)>¡¿Mime?!<clear><br><$voicel(1,3)><$comeff(1,14)><$motion(1,816)>Pareces <gen;-2(un,una)> human<gen;-2(o,a)>, pero en realidad no lo eres,<br><$voicel(1,4)><$comeff(1,6)>¿o me equivoco?<clear><br><$voicel(1,9)><$motion(1,807)><$comeff(1,9)>¡Es la primera vez que me topo con otro Pokémon <$voicel(1,6)><$comeff(1,10)>al que<br>las imitaciones se le den tan bien como a mí!<clear><br><$voicel(1,9)><$emotion(1,63)>La verdad es que me has dejado muy impresionad<gen;-3(o,a)>,<br>human<gen;-2(o,a)> de mentirijilla."
msgstr "<$voicel(1,5)><$emotion(1,27)><$facial(1,13)>¡¿Mime?!<clear><br><$voicel(1,3)><$comeff(1,14)><$motion(1,816)>Pareces <gen;-2(un,una)> human<gen;-2(o,a)>, pero en realidad no lo eres,<br><$voicel(1,4)><$comeff(1,6)>¿o me equivoco?<clear><br><$voicel(1,9)><$motion(1,807)><$comeff(1,9)>¡Es la primera vez que me topo con otro Pokémon <$voicel(1,6)><$comeff(1,10)>al que<br>las imitaciones se le den tan bien como a mí!<clear><br><$voicel(1,9)><$emotion(1,63)>La verdad es que me dejaste muy impresionad<gen;-3(o,a)>,<br>human<gen;-2(o,a)> de mentiritas."

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,10)>Hiii! Nice to meetchoo! Look—isn’t my egg pretty?<clear><br><$comeff(1,8)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>I saw it was so perfect and round and picked it up,<br>and now I’m keeping it all warm and cozy!<clear><br><$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>I wonder what kinda baby’s gonna hatch... I’m so excited!
msgctxt "3255:227"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,10)>¡Hola! ¡Mira mi huevo! ¿A que es precioso?<clear><br><$comeff(1,8)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>Me encontré este huevo tan redondito por ahí y decidí<br>cuidarlo y mantenerlo calentito.<clear><br><$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Qué ganas de ver qué sale de él!"
msgstr "<$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,10)>¡Hola! ¡Mira mi huevo! ¿Verdad que es precioso?<clear><br><$comeff(1,8)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>Me encontré este huevo tan redondito por ahí y decidí<br>cuidarlo y mantenerlo calentito.<clear><br><$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Qué ganas de ver qué sale de él!"

#. en: <$voicel(1,5)><$emotion(1,14)>Yo! Nice to meet you! Wait... Have you copied <$voicel(1,8)><$motion(1,824)>a human<br>body with your transformation? What a coincidence!<clear><br><$voicel(1,5)><$emotion(1,8)>I can copy human voices pretty good myself!<clear><br><$voicel(1,7)><$emotion(1,9)>“Rubber baby buggy bumpers! Rubber baby buggy<br>bumpers!” <$voicel(1,10)><$emotion(1,39)>Pretty awesome, yeah?!<slide><br><$voicel(1,8)><$motionoff(1,804)><$comeff(1,1)>But I gotta tell ya, I have no idea what it means, yo!
msgctxt "3255:228"
msgid "<$voicel(1,5)><$emotion(1,14)>¡Muy buenas! Oye, ¿tú no estarás <$voicel(1,8)><$motion(1,824)>imitando a los humanos<br>con esas pintas?<clear><br>¡Qué casualidad! <$voicel(1,5)><$emotion(1,8)>¡Yo también sé imitar a los humanos!<br>La voz me sale clavadita, ya verás.<clear><br><$voicel(1,7)><$emotion(1,9)>\"Tres tristes Timburr tragaban trigo en un trigal\".<br>\"En tres tristes trastos tragaban trigo tres tristes Timburr\".<slide><br><$voicel(1,10)><$emotion(1,39)>¿Ves? ¡Igualito!<clear><br><$voicel(1,8)><$motionoff(1,804)><$comeff(1,1)>Eso sí, no entiendo muy bien por qué están tristes...<br>¡Con lo rico que está el trigo!"
msgstr "<$voicel(1,5)><$emotion(1,14)>¡Muy buenas! Oye, ¿tú no estarás <$voicel(1,8)><$motion(1,824)>imitando a los humanos<br>con ese aspecto?<clear><br>¡Qué casualidad! <$voicel(1,5)><$emotion(1,8)>¡Yo también sé imitar a los humanos!<br>La voz me sale idéntica, ya verás.<clear><br><$voicel(1,7)><$emotion(1,9)>\"Tres tristes Timburr tragaban trigo en un trigal\".<br>\"En tres tristes trastos tragaban trigo tres tristes Timburr\".<slide><br><$voicel(1,10)><$emotion(1,39)>¿Ves? ¡Igualito!<clear><br><$voicel(1,8)><$motionoff(1,804)><$comeff(1,1)>Eso sí, no entiendo muy bien por qué están tristes...<br>¡Con lo rico que está el trigo!"

#. en: <$voicel(1,6)><$facial(1,4)><$comeff(1,3)>Whoa, hi! Nice to meet you. <wait(0.9)><$voicel(1,4)>Um, actually, I...<br><wait(0.4)><$emotion(1,41)> *gurgle*<clear><br><$voicel(1,8)><$emotion(1,27)>Oh, sorry about that.<clear><br><$voicel(1,1)><$emotion(1,46)>I just woke up a little while ago, so I’m pretty hungry...<clear><br><$voicel(1,6)><$facial(1,1)><$motion(1,805)>I was gonna go look for some food in a bit...<br><wait(0.9)><wait(0.4)><$voicel(1,2)><$facial(1,9)><$comeff(1,7)> *gurgle gurgle*...<clear><br><$voicel(1,7)><$emotion(1,14)>Here’s a thought... You’re transformed into a human now...<br><$voicel(1,10)><$comeff(1,6)><$motion(1,666)>but can you transform into yummy food?
msgctxt "3255:229"
msgid "<$voicel(1,6)><$facial(1,4)><$comeff(1,3)>Muy buenas. ¿Qué tal? <wait(0.9)><$voicel(1,4)>¿Qué me cuen...? <wait(0.9)><$emotion(1,41)>Grrrrrr...<wait(0.9)><br><$voicel(1,8)><$emotion(1,27)>Uy, perdona... ¡eso han sido mis tripas rugiendo!<clear><br><$voicel(1,1)><$emotion(1,46)>Es que acabo de salir del sobre y tengo un hambre...<clear><br><$voicel(1,6)><$facial(1,1)><$motion(1,805)>Estaba pensando en ir a zampar algo dentro de un rato.<br><wait(0.9)><wait(0.4)><$voicel(1,2)><$facial(1,9)><$comeff(1,7)>Grrrrrr...<clear><br><$voicel(1,7)><$emotion(1,14)>Uf... Oye, ya que puedes transformarte en human<gen;-2(o,a)>...<br><$voicel(1,10)><$comeff(1,6)><$motion(1,666)>¿no podrías transformarte en algo rico pa papear?"
msgstr "<$voicel(1,6)><$facial(1,4)><$comeff(1,3)>Muy buenas. ¿Qué tal? <wait(0.9)><$voicel(1,4)>¿Qué me cuen...? <wait(0.9)><$emotion(1,41)>Grrrrrr...<wait(0.9)><br><$voicel(1,8)><$emotion(1,27)>Uy, perdona... ¡eso fueron mis tripas rugiendo!<clear><br><$voicel(1,1)><$emotion(1,46)>Es que acabo de levantarme y tengo un hambre...<clear><br><$voicel(1,6)><$facial(1,1)><$motion(1,805)>Estaba pensando en ir a comer algo dentro de un rato.<br><wait(0.9)><wait(0.4)><$voicel(1,2)><$facial(1,9)><$comeff(1,7)>Grrrrrr...<clear><br><$voicel(1,7)><$emotion(1,14)>Uf... Oye, ya que puedes transformarte en human<gen;-2(o,a)>...<br><$voicel(1,10)><$comeff(1,6)><$motion(1,666)>¿no podrías transformarte en algo rico pa comer?"

#. en: <$comeff(1,14)><$facial(1,14)><$motion(1,807)><$voicel(1,5)>*sniiifff* *sniff sniff*<clear><br><$comeff(1,21)><$facial(1,1)><$motion(1,801)><$voicel(1,9)>You’re giving off an aura... And it’s the same aura as my<br>friends’!<clear><br><$comeff(1,13)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Does that mean we can be friends? I bet it does!
msgctxt "3255:230"
msgid "<$comeff(1,14)><$facial(1,14)><$motion(1,807)><$voicel(1,5)>Snif... Snif...<clear><br><$comeff(1,21)><$facial(1,1)><$motion(1,801)><$voicel(1,9)>Emites unas ondas muy parecidas a las de mis amigos.<br>Vaya, vaya...<clear><br><$comeff(1,13)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>¡Seguro que eso significa que nos llevaremos bien!"
msgstr ""

#. en: <$voicel(1,3)><$emotion(1,29)>You...are not actually human.<clear><br><$voicel(1,1)><$emotion(1,65)><$voicel(1,5)>But I sense a warm aura from you, <$voicel(1,8)><$facial(1,14)><$comeff(1,3)>much like the aura of<br>humans who loved and cared for their Pokémon.<clear><br><$voicel(1,5)><$facial(1,4)><$motion(1,806)>I look forward to seeing what you achieve in this world.<clear><br><$voicel(1,7)><$emotion(1,8)>If there’s anything I can do to help, you need only ask.
msgctxt "3255:231"
msgid "<$voicel(1,3)><$emotion(1,29)>Tú... no eres un ser humano.<clear><br><$voicel(1,1)><$emotion(1,65)><$voicel(1,5)>Pero percibo un aura cálida que emana de ti... <$voicel(1,8)><$facial(1,14)><$comeff(1,3)>semejante a<br>la de una persona que profesa devoción por los Pokémon.<clear><br><$voicel(1,5)><$facial(1,4)><$motion(1,806)>No veo la hora de comprobar qué impronta dejarás en<br>este mundo...<clear><br><$voicel(1,7)><$emotion(1,8)>Si hay algo que pueda hacer para ayudarte, no vaciles en<br>decírmelo."
msgstr ""

#. en: <$comeff(1,5)><wait(0.5)><$comeff(1,10)><$lookat(1,1,0)><waitactor(1)><$motionoff(1,804)><$voicel(1,9)>Bzzzt! Beep beep. Intruder detected.<clear><br><$comeff(1,14)><$motion(1,803)><$voicel(1,5)>Oh. Wait. This location. <$facial(1,4)><$voicel(1,6)>It is new to me.<clear><br><$comeff(1,19)><$facial(1,14)><$motion(1,802)><$voicel(1,3)>So the intruder... It is me?<wait(1.2)><$motion(0,824)><$comeff(0,1)><wait(1.4)><$motion(0,652)><wait(0.7)><clear><br><$comeff(1,10)><$facial(1,1)><$motion(1,803)><$voicel(1,5)>What? I am not an intruder? You constructed this home?<br><$voicel(1,8)>And I may live here?<clear><br><$comeff(1,10)><$facial(1,14)><$motionoff(1,804)><$voicel(1,9)>I have understood. Then we are now friends.
msgctxt "3255:232"
msgid "<$comeff(1,5)><wait(0.5)><$comeff(1,10)><$lookat(1,1,0)><waitactor(1)><$motionoff(1,804)><$voicel(1,9)>¡Bzzzt! ¡Bip! ¡Bip! ¡Intrus<gen;-2(o,a)> detectad<gen;-2(o,a)>!<clear><br><$comeff(1,14)><$motion(1,803)><$voicel(1,5)>No. Falsa alarma.<$facial(1,4)><$voicel(1,6)> Quien ha irrumpido en un sitio nuevo<br>he sido yo.<clear><br><$comeff(1,19)><$facial(1,14)><$motion(1,802)><$voicel(1,3)>¿Soy el intruso?<wait(1.2)><$motion(0,824)><$comeff(0,1)><wait(1.4)><$motion(0,652)><wait(0.7)><clear><br><$comeff(1,10)><$facial(1,1)><$motion(1,803)><$voicel(1,5)>¿No? ¿Esta unidad habitacional la has preparado tú?<br><$voicel(1,8)>¿Y tengo autorización para residir en ella?<clear><br><$comeff(1,10)><$facial(1,14)><$motionoff(1,804)><$voicel(1,9)>¡Respuesta afirmativa! Ergo, ¡amig<gen;-2(o,a)> detectad<gen;-2(o,a)>!"
msgstr "<$comeff(1,5)><wait(0.5)><$comeff(1,10)><$lookat(1,1,0)><waitactor(1)><$motionoff(1,804)><$voicel(1,9)>¡Bzzzt! ¡Bip! ¡Bip! ¡Intrus<gen;-2(o,a)> detectad<gen;-2(o,a)>!<clear><br><$comeff(1,14)><$motion(1,803)><$voicel(1,5)>No. Falsa alarma.<$facial(1,4)><$voicel(1,6)> Quien irrumpió en un lugar nuevo<br>fui yo.<clear><br><$comeff(1,19)><$facial(1,14)><$motion(1,802)><$voicel(1,3)>¿Soy el intruso?<wait(1.2)><$motion(0,824)><$comeff(0,1)><wait(1.4)><$motion(0,652)><wait(0.7)><clear><br><$comeff(1,10)><$facial(1,1)><$motion(1,803)><$voicel(1,5)>¿No? ¿Esta unidad habitacional la preparaste tú?<br><$voicel(1,8)>¿Y tengo autorización para residir en ella?<clear><br><$comeff(1,10)><$facial(1,14)><$motionoff(1,804)><$voicel(1,9)>¡Respuesta afirmativa! Ergo, ¡amig<gen;-2(o,a)> detectad<gen;-2(o,a)>!"

#. en: <$voicel(1,3)><$motion(1,859)><$comeff(0,5)><$facial(1,13)>Hot dang! What an electrifyin’ly good spot! Jus’ perfect fer<br>me, if I do say so myself!<clear><br><$voicel(1,5)><$emotion(1,14)><$facial(0,1)>Well, howdy! You live round these parts too?<clear><br><$voicel(1,1)><$motion(1,805)>In that case, how’s about we really brighten up this place<br><$voicel(1,6)><$motion(1,806)><$comeff(1,9)>and make it even more fun? <$voicel(1,10)><$emotion(1,38)>I’ll help ya as much as I can!
msgctxt "3255:233"
msgid "<$voicel(1,3)><$motion(1,859)><$comeff(0,5)><$facial(1,13)>¡Chispas! Este lugar me transmite buenas vibraciones.<br>Es más, sus características... ¡me atraen como un imán!<clear><br><$voicel(1,5)><$emotion(1,14)><$facial(0,1)>¡Ah! ¿Tú eres un<gen;-2(o,a)> de l<gen;-2(o,a)>s vecin<gen;-2(o,a)>s, jovenzuel<gen;-2(o,a)>?<clear><br><$voicel(1,1)><$motion(1,805)>En ese caso, habrá que hacer causa común, ¿no? <$voicel(1,6)><$motion(1,806)><$comeff(1,9)><br>¡Para darle juntos más vida y animación al vecindario!<slide><br><$voicel(1,10)><$emotion(1,38)>¡Yo también pondré todo de mi parte!"
msgstr ""

#. en: <$voicel(1,5)><$emotion(1,14)>Hiii. Nice to meet yooouuu.<clear><br><$voicel(1,3)><$emotion(1,65)>I actually just came to the area recently, <$voicel(1,6)><$facial(1,9)>so I’m not used<br>to it yet, <$voicel(1,8)><$facial(1,4)><$comeff(1,10)>but it seems like a suuuper nice place to live.<clear><br><$voicel(1,5)><$emotion(1,8)>This is such a niiice home. I’ll have to be careful to not<br><$voicel(1,4)><$motion(1,806)><$facial(1,1)>accidentally set it on fire...<clear><br><$voicel(1,1)><$emotion(1,41)>I’d cry sooo much if this place went up in flaaames.
msgctxt "3255:234"
msgid "<$voicel(1,5)><$emotion(1,14)>Holaaa, ¿qué tal? ¡Encantad<gen;-3(o,a)>!<clear><br><$voicel(1,3)><$emotion(1,65)>¿Qué sitio es este? Yo es que soy <gen;-3(un,una)> recién llegad<gen;-3(o,a)>,<br><$voicel(1,6)><$facial(1,9)>así que de momento no consigo orientarme muy bien...<slide><br><$voicel(1,8)><$facial(1,4)><$comeff(1,10)>pero tiene pinta de ser un buen lugar para vivir, eso sí.<clear><br><$voicel(1,5)><$emotion(1,8)>Ya que me ha tocado en gracia una casica tan apañada,<br>espero no chamuscarla sin querer... <$voicel(1,4)><$motion(1,806)><$facial(1,1)>Tendré cuidadito.<clear><br><$voicel(1,1)><$emotion(1,41)>Si quedase reducida a cenizas, ¡creo que rompería a llorar<br>del disgusto!"
msgstr "<$voicel(1,5)><$emotion(1,14)>Holaaa, ¿qué tal? ¡Encantad<gen;-3(o,a)>!<clear><br><$voicel(1,3)><$emotion(1,65)>¿Qué lugar es este? Yo es que soy <gen;-3(un,una)> recién llegad<gen;-3(o,a)>,<br><$voicel(1,6)><$facial(1,9)>así que de momento no consigo orientarme muy bien...<slide><br><$voicel(1,8)><$facial(1,4)><$comeff(1,10)>pero parece un buen lugar para vivir, eso sí.<clear><br><$voicel(1,5)><$emotion(1,8)>Ya que me tocó en suerte una casita tan linda,<br>espero no chamuscarla sin querer... <$voicel(1,4)><$motion(1,806)><$facial(1,1)>Tendré cuidadito.<clear><br><$voicel(1,1)><$emotion(1,41)>Si quedase reducida a cenizas, ¡creo que rompería a llorar<br>del disgusto!"

#. en: <$comeff(1,1)><$motion(1,803)><$voicel(1,7)>Hi! It’s great to meet you! This seems like a pretty comfy<br>place to live! <$comeff(1,6)><$motion(1,806)><$voicel(1,8)>So what is it that you do around here?<wait(1.0)><$motion(0,824)><wait(1.4)><$motion(0,652)><wait(0.7)><clear><br><$comeff(1,14)><$voicel(1,5)>Huh... You’re building different habitats all around to suit<br>all the different kinds of Pokémon? <$comeff(1,21)><$motion(1,801)><$voicel(1,9)>That’s SO COOL!<clear><br><$comeff(1,10)><$facial(1,14)><$motion(1,807)><$voicel(1,7)>If everyone gets a home that’s just perfect for them, d’you<br>think they might stop squabbling over territory?<slide><br><$comeff(1,13)><$facial(1,1)><$motion(1,805)><$voicel(1,6)>That would be EVEN COOLER!
msgctxt "3255:235"
msgid "<$comeff(1,1)><$motion(1,803)><$voicel(1,7)>¡Holaaa! No te conozco, ¿verdad? ¡Qué bien se está aquí!<br><$comeff(1,6)><$motion(1,806)><$voicel(1,8)>¿Tú qué haces en este lugar?<wait(1.0)><$motion(0,824)><wait(1.4)><$motion(0,652)><wait(0.7)><clear><br><$comeff(1,14)><$voicel(1,5)>¿Vas de aquí para allá montando hábitats personalizados<br>a la gente?<$comeff(1,21)><$motion(1,801)><$voicel(1,9)> ¡Buah, qué maj<gen;-2(ooo,aaa)>!<clear><br><$comeff(1,10)><$facial(1,14)><$motion(1,807)><$voicel(1,7)>Si todos tuvieran una casa a su gusto, tal vez se acabarían<br>las peleas por el territorio...<clear><br><$comeff(1,13)><$facial(1,1)><$motion(1,805)><$voicel(1,6)>¡Qué máquina estás hech<gen;-2(o,a)>!"
msgstr "<$comeff(1,1)><$motion(1,803)><$voicel(1,7)>¡Holaaa! No te conozco, ¿verdad? ¡Qué bien se está aquí!<br><$comeff(1,6)><$motion(1,806)><$voicel(1,8)>¿Tú qué haces en este lugar?<wait(1.0)><$motion(0,824)><wait(1.4)><$motion(0,652)><wait(0.7)><clear><br><$comeff(1,14)><$voicel(1,5)>¿Vas de aquí para allá armando hábitats personalizados<br>para la gente?<$comeff(1,21)><$motion(1,801)><$voicel(1,9)> ¡Guau, qué lind<gen;-2(ooo,aaa)>!<clear><br><$comeff(1,10)><$facial(1,14)><$motion(1,807)><$voicel(1,7)>Si todos tuvieran una casa a su gusto, tal vez se acabarían<br>las peleas por el territorio...<clear><br><$comeff(1,13)><$facial(1,1)><$motion(1,805)><$voicel(1,6)>¡Estás hech<gen;-2(o,a)> todo un genio!"

#. en: <$voicel(1,4)><$emotion(1,14)>Ah, hi there. Nice to meet you.<clear><br><$voicel(1,5)><$emotion(1,55)>Um, are you OK being so close to me? <$voicel(1,4)><$emotion(1,29)>You’re not too<br>cold, are you?<clear><br>Oh...<wait(0.2)><$voicel(1,4)><$emotion(1,53)>that’s great! As you’d expect, my body’s as cold as<br>ice... <$voicel(1,1)><$emotion(1,31)>I always get a bit worried when friends hang out<slide><br>with me.<clear><br><$voicel(1,7)><$emotion(1,14)>You don’t seem to be the type to catch a cold easily,<br>though... <$voicel(1,9)><$emotion(1,8)>Maybe we can hang out even more!
msgctxt "3255:236"
msgid "<$voicel(1,4)><$emotion(1,14)>Ah, hola... Encantad<gen;-3(o,a)>.<clear><br><$voicel(1,5)><$emotion(1,55)>Cuando te has acercado a mí... <$voicel(1,4)><$emotion(1,29)>¿n-no has sentido<br>mucho frío?<clear><br><wait(0.2)><$voicel(1,4)><$emotion(1,53)>¡Ay, qué alivio! Mi cuerpo irradia un frío que no veas,<br><$voicel(1,1)><$emotion(1,31)>me preocupa que los demás se enfermen al acercarse...<clear><br><$voicel(1,7)><$emotion(1,14)>Tú no tienes pinta de pillar resfriados fácilmente, <$voicel(1,9)><$emotion(1,8)>así que<br>puedo ser tu amig<gen;-3(o,a)>... s-si quieres..."
msgstr "<$voicel(1,4)><$emotion(1,14)>Ah, hola... Encantad<gen;-3(o,a)>.<clear><br><$voicel(1,5)><$emotion(1,55)>Cuando te acercaste a mí... <$voicel(1,4)><$emotion(1,29)>¿n-no sentiste<br>mucho frío?<clear><br><wait(0.2)><$voicel(1,4)><$emotion(1,53)>¡Ay, qué alivio! Mi cuerpo irradia un frío tremendo,<br><$voicel(1,1)><$emotion(1,31)>me preocupa que los demás se enfermen al acercarse...<clear><br><$voicel(1,7)><$emotion(1,14)>Tú no pareces de los que se resfrían fácilmente, <$voicel(1,9)><$emotion(1,8)>así que<br>puedo ser tu amig<gen;-3(o,a)>... s-si quieres..."

#. en: <$voicel(1,8)><$comeff(1,3)>Hey there. Nice to meet—<wait(0.5)><$voicel(1,10)><$motion(1,807)>BZ BZZZT—<wait(1.1)><$voicel(1,4)><$comeff(1,4)>Sorry, I must have<br>caught a bug and now...<clear><br><$voicel(1,6)><$comeff(1,14)><$motion(1,826)>... ... ...<clear><br>Hey there.<clear><br><$voicel(1,7)><$comeff(1,10)><$motion(1,827)>Nice to meet you. Nice to meet you! Nice To MeEt YOu!<br>gOoD MoRNafTeRNOoOOnEvENinGGgGgGG!<slide><br><$voicel(1,9)><$motionoff(1,804)>YOU U U UUU BZZZT BEEP BOOP BEEEEEEEEEEEE—<clear><br><$voicel(1,6)><$comeff(1,5)><$motion(1,803)>Bing!<clear><br><$voicel(1,7)><$comeff(1,3)>Hey there. Nice to meet you. Hope we can be friends.
msgctxt "3255:237"
msgid "<$voicel(1,8)><$comeff(1,3)>Hola, encantad...<wait(0.5)><$voicel(1,10)><$motion(1,807)> <gen;-3(o-O-o,a-A-a)>...<wait(1.1)> <$voicel(1,4)><$comeff(1,4)>Perdona, no sé qué<br>me pasa...<clear><br><$voicel(1,6)><$comeff(1,14)><$motion(1,826)>E-e-E-e... <wait(0.6)><$voicel(1,7)><$comeff(1,10)><$motion(1,827)>¡Encantad<gen;-3(o,a)>! ¡DeCaNTad<gen;-3(o,a)>! ¡LeVAnTAd<gen;-3(O,A)>!<clear><br>¡Bu-bU-bUEnOs díAs! ¡Nu-nU-nUEvOs díAaaAaas!<br>¡Hu-hU-huEvOS díAaaAaassSSSs!<clear><br><$voicel(1,9)><$motionoff(1,804)>Pi, pi, pi, piii... <wait(0.4)><$voicel(1,6)><$comeff(1,5)><$motion(1,803)>Plup.<clear><br><$voicel(1,7)><$comeff(1,3)>Hola, encantad<gen;-3(o,a)> de conocerte."
msgstr ""

#. en: <$voicel(1,5)><$emotion(1,14)>Hey now, this looks like a great area to live in.<clear><br><$voicel(1,3)><$emotion(1,65)>You’re the one who set this place up, yeah?<clear><br><$voicel(1,7)><$emotion(1,8)>Well then, I better show my appreciation. Thank you.<clear><br><$voicel(1,4)><$emotion(1,60)>I’m grateful we met today.<$motion(0,40)> Let this be the start of a<br>beautiful friendship.
msgctxt "3255:238"
msgid "<$voicel(1,5)><$emotion(1,14)>Hola. Este podría ser un buen sitio en el que vivir...<br><$voicel(1,3)><$emotion(1,65)>¿Has sido tú quien lo ha preparado?<clear><br><$voicel(1,7)><$emotion(1,8)>En ese caso, tengo que agradecértelo como es debido.<br>Muchas gracias.<clear><br><$voicel(1,4)><$emotion(1,60)>Me alegro de haberte conocido hoy. <$motion(0,40)>Nos vemos."
msgstr "<$voicel(1,5)><$emotion(1,14)>Hola. Este podría ser un buen lugar en el que vivir...<br><$voicel(1,3)><$emotion(1,65)>¿Fuiste tú quien lo preparó?<clear><br><$voicel(1,7)><$emotion(1,8)>En ese caso, tengo que agradecértelo como es debido.<br>Muchas gracias.<clear><br><$voicel(1,4)><$emotion(1,60)>Me alegro de haberte conocido hoy. <$motion(0,40)>Nos vemos."

#. en: <$voicel(1,7)><$emotion(1,39)>This place. It is brighter and warmer than the world I was in<br>before now.<clear><br><$voicel(1,5)><$emotion(1,65)>This human too is different than I remember.<clear><br><$voicel(1,4)><$motion(1,803)><$comeff(1,3)><$facial(1,13)>What? You are not a human?<clear><br><$voicel(1,7)><$emotion(1,8)>Much here is of great interest to me! I think I will live here<br>for a time!
msgctxt "3255:239"
msgid "<$voicel(1,7)><$emotion(1,39)>Este lugar es más cálido y luminoso que el mundo de<br>donde provengo.<clear><br><$voicel(1,5)><$emotion(1,65)>Parece estar habitado por seres cuasihumanos no vistos<br>hasta ahora.<clear><br><$voicel(1,4)><$motion(1,803)><$comeff(1,3)><$facial(1,13)>¿Noir? ¿No eres un ser humano?<clear><br><$voicel(1,7)><$emotion(1,8)>Este lugar esconde cosas fascinantes. Me propongo vivir<br>aquí por un tiempo."
msgstr ""

#. en: <$voicel(1,9)><$motionoff(1,807)><$comeff(1,10)><$textsize(2)>Ahhh, what a great nap!<clear><br></textsize><$voicel(1,8)><$motionoff(1,806)><$comeff(1,21)><$facial(1,1)>Wait...where am I? Wherever it is, it sure is comfy.<clear><br><$voicel(1,9)><$motion(1,803)><$comeff(1,3)><$facial(1,4)>Huh? Did you make this place for me? <wait(0.3)><$motion(0,40)><wait(1.0)><$comeff(1,9)>That’s AMAZING!<br><$voicel(1,8)><$motion(1,801)><$comeff(1,12)>I better do something nice for you too, then!<clear><br><$voicel(1,5)><$motionoff(1,805)><$facial(1,1)>If I can help you with anything, <$voicel(1,5)><$emotion(1,62)>ask me anytime!
msgctxt "3255:240"
msgid "<$voicel(1,9)><$motionoff(1,807)><$comeff(1,10)><$textsize(2)>¡Uaaah, qué buena siesta!</textsize><clear><br><$voicel(1,8)><$motionoff(1,806)><$comeff(1,21)><$facial(1,1)>¿Eh? ¿Dónde estoy? ¡Este sitio es superchachi!<clear><br><$voicel(1,9)><$motion(1,803)><$comeff(1,3)><$facial(1,4)>¿Dices que lo has preparado tú?... <wait(0.3)><$motion(0,40)><wait(1.0)><$comeff(1,9)>¡Halaaa! ¡Qué guaaay!<br><$voicel(1,8)><$motion(1,801)><$comeff(1,12)>Pues te debo una... <$voicel(1,5)><$motionoff(1,805)><$facial(1,1)>Así que ya sabes, cualquier cosa<slide><br>que necesites, <$voicel(1,5)><$emotion(1,62)>¡cuenta conmigo!"
msgstr "<$voicel(1,9)><$motionoff(1,807)><$comeff(1,10)><$textsize(2)>¡Uaaah, qué buena siesta!</textsize><clear><br><$voicel(1,8)><$motionoff(1,806)><$comeff(1,21)><$facial(1,1)>¿Eh? ¿Dónde estoy? ¡Este lugar es supergenial!<clear><br><$voicel(1,9)><$motion(1,803)><$comeff(1,3)><$facial(1,4)>¿Dices que lo preparaste tú?... <wait(0.3)><$motion(0,40)><wait(1.0)><$comeff(1,9)>¡Guaaau! ¡Qué geniaaal!<br><$voicel(1,8)><$motion(1,801)><$comeff(1,12)>Pues te debo una... <$voicel(1,5)><$motionoff(1,805)><$facial(1,1)>Así que ya sabes, cualquier cosa<slide><br>que necesites, <$voicel(1,5)><$emotion(1,62)>¡cuenta conmigo!"

#. en: <$comeff(1,1)><$motion(1,803)><$voicel(1,5)>H-hey there—can I ask you a quick question?<clear><br><$comeff(1,6)><$motion(1,806)><$voicel(1,3)>Am I covered in dirt? I’ve been exploring all over, so I’m<br>a bit worried I’m a mess...<wait(1.2)><$motion(0,41)><wait(1.8)><clear><br><$comeff(1,21)><$motion(1,807)><$voicel(1,7)>I’m fine? Thank goodness...<clear><br><$comeff(1,13)><$motion(1,801)><$voicel(1,9)>I bet I could stay nice and clean in this den... I could go<br>sunbathing too...
msgctxt "3255:241"
msgid "<$comeff(1,1)><$motion(1,803)><$voicel(1,5)>Hola... Mucho gusto. Me gustaría preguntarte algo...<clear><br><$comeff(1,6)><$motion(1,806)><$voicel(1,3)>¿Me ves alguna mancha o suciedad en el cuerpo?<br>He salido un rato a explorar y estoy rayad<gen;-3(o,a)> con eso...<wait(1.2)><$motion(0,41)><wait(1.8)><clear><br><$comeff(1,21)><$motion(1,807)><$voicel(1,7)>¿No? ¿Todo bien? Ay, menos mal...<clear><br><$comeff(1,13)><$motion(1,801)><$voicel(1,9)>Si vivo aquí, podré mantenerme limpi<gen;-3(o,a)> en todo momento,<br>y pega el solecito que da gusto..."
msgstr "<$comeff(1,1)><$motion(1,803)><$voicel(1,5)>Hola... Mucho gusto. Me gustaría preguntarte algo...<clear><br><$comeff(1,6)><$motion(1,806)><$voicel(1,3)>¿Me ves alguna mancha o suciedad en el cuerpo?<br>Salí un rato a explorar y estoy preocupad<gen;-3(o,a)> por eso...<wait(1.2)><$motion(0,41)><wait(1.8)><clear><br><$comeff(1,21)><$motion(1,807)><$voicel(1,7)>¿No? ¿Todo bien? Ay, menos mal...<clear><br><$comeff(1,13)><$motion(1,801)><$voicel(1,9)>Si vivo aquí, podré mantenerme limpi<gen;-3(o,a)> en todo momento,<br>y pega el solecito que da gusto..."

#. en: <$comeff(1,14)><$voicel(1,5)>*glare*...<clear><br><$comcan(1)><$motion(1,803)><$voicel(1,6)>How odd. This one doesn’t seem <$voicel(1,3)>at all fazed by my glare.<br><$motion(1,801)><$voicel(1,7)>All right, time to unleash my true might...<clear><br><$comeff(1,11)><$motion(1,802)><$voicel(1,10)><$textsize(2)>*GLARE*</textsize><wait(0.4)><$motion(0,234)><wait(0.6)><$motion(0,290)><clear><br><$comeff(1,10)><$motionoff(1,804)><$voicel(1,9)>Gracious! You must be quite a brave soul.<clear><br><$comeff(1,13)><$motion(1,805)><$voicel(1,7)>I plan on staying here for a while, so do come by and see<br>me whenever you have the time.
msgctxt "3255:242"
msgid "<$comeff(1,14)><$voicel(1,5)>...<clear><br><$comcan(1)><$motion(1,803)><$voicel(1,6)><$cdef(9)>(Est<gen;-2(e,a)> chiquill<gen;-2(o,a)> no se amedrenta por mucho que le eche <$voicel(1,3)>mi<br>más fiera mirada... <$motion(1,801)><$voicel(1,7)>Tendré que desatar toda mi fiereza...)</color><clear><br><$comeff(1,11)><$motion(1,802)><$voicel(1,10)><$textsize(2)>¡¡Periooorrr!! </textsize><wait(0.4)><$motion(0,234)><wait(0.6)><$motion(0,290)><clear><br><$comeff(1,10)><$motionoff(1,804)><$voicel(1,9)>¡Ju, ju, ju! Tienes agallas, ¿eh? Muy bien, me gusta.<clear><br><$comeff(1,13)><$motion(1,805)><$voicel(1,7)>Bueno, me voy a quedar por aquí una temporadita,<br>así que ven a verme cuando quieras."
msgstr ""

#. en: <$comeff(1,10)><$facial(1,4)><$motionoff(1,804)><$voicel(1,6)>Well now, there’s a new face! I mean, I think so—we<br>haven’t met before, have we?<clear><br><$facial(1,1)><$comeff(1,6)><$motion(1,805)><$voicel(1,8)>I must’ve tunneled farther than I thought. Looks like I’ve<br>come a looong way!<clear><br><$comeff(1,13)><$motion(1,803)><$voicel(1,7)>But now that I’ve met you, I think I’ll stick around for a<br>while! <$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Show me the ropes around here, OK?
msgctxt "3255:243"
msgid "<$comeff(1,10)><$facial(1,4)><$motionoff(1,804)><$voicel(1,6)>¡Buenaaas! ¡No me suena tu cara! <$facial(1,1)><$comeff(1,6)><$motion(1,805)><$voicel(1,8)>¿Igual he excavado<br>demasiado y he acabado en el quinto pino?<clear><br><$comeff(1,13)><$motion(1,803)><$voicel(1,7)>Bueno, ya que nos hemos conocido, te confío que creo<br>que me voy a quedar un tiempo a vivir aquí.<$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,9)><clear><br>¡Así me enseñas la zona!"
msgstr "<$comeff(1,10)><$facial(1,4)><$motionoff(1,804)><$voicel(1,6)>¡Buenaaas! ¡No me suena tu cara! <$facial(1,1)><$comeff(1,6)><$motion(1,805)><$voicel(1,8)>¿Será que excavé<br>demasiado y terminé muy lejos de casa?<clear><br><$comeff(1,13)><$motion(1,803)><$voicel(1,7)>Bueno, ya que nos conocimos, te confío que creo<br>que me voy a quedar un tiempo a vivir aquí.<$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,9)><clear><br>¡Así me enseñas la zona!"

#. en: <$voicel(1,7)><$facial(1,4)><$motion(1,805)><$comeff(1,10)>The ground here sure is nice! Not too hard, not too soft—<br>jus’ right, I say! <$voicel(1,5)><$emotion(1,14)>You there! You agree, don’tcha?<clear><br><$voicel(1,7)><$emotion(1,55)>To the untrained eye, yer hands seem a li’l small and<br>ill-suited for diggin’...<$voicel(1,8)><$comeff(1,5)><$motion(1,816)>but I know what’s what!<clear><br><$voicel(1,5)><$emotion(1,63)>You got the potential to be a diggin’ master!<clear><br><$voicel(1,9)><$emotion(1,38)>As somethin’ of a diggin’ master myself, you can trust me<br>on this—sure as dirt!
msgctxt "3255:244"
msgid "<$voicel(1,7)><$facial(1,4)><$motion(1,805)><$comeff(1,10)>¡Este terreno está pero que muy bien! Ni demasiado duro,<br>ni demasiado blando... ¡Está pintiparado! <$voicel(1,5)><$emotion(1,14)>¿No te parece?<clear><br><$voicel(1,7)><$emotion(1,55)>A ver, cierto es que esas manitas que te gastas no tienen<br>la forma más apropiada para andar cavando por ahí...<slide><br><$voicel(1,8)><$comeff(1,5)><$motion(1,816)>¡pero yo tengo un sexto sentido, jovenzuel<gen;-2(o,a)>!<clear><br><$voicel(1,5)><$emotion(1,63)>¡Te veo potencial para convertirte en <gen;-2(un,una)> consumad<gen;-2(o,a)><br><gen;-2(excavador,excavadora)>!<clear><br><$voicel(1,9)><$emotion(1,38)>¡Por estas! Te lo dice toda una eminencia en la materia."
msgstr "<$voicel(1,7)><$facial(1,4)><$motion(1,805)><$comeff(1,10)>¡Este terreno está pero que muy bien! Ni demasiado duro,<br>ni demasiado blando... ¡Está de maravilla! <$voicel(1,5)><$emotion(1,14)>¿No te parece?<clear><br><$voicel(1,7)><$emotion(1,55)>A ver, cierto es que esas manitas que tienes no tienen<br>la forma más apropiada para andar cavando por ahí...<slide><br><$voicel(1,8)><$comeff(1,5)><$motion(1,816)>¡pero yo tengo un sexto sentido, jovenzuel<gen;-2(o,a)>!<clear><br><$voicel(1,5)><$emotion(1,63)>¡Te veo potencial para convertirte en <gen;-2(un,una)> consumad<gen;-2(o,a)><br><gen;-2(excavador,excavadora)>!<clear><br><$voicel(1,9)><$emotion(1,38)>¡Palabra! Te lo dice toda una eminencia en la materia."

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Hiya! It’s really nice to meet you. You’re, um...<clear><br><$comeff(1,13)><$motionoff(1,804)><$voicel(1,5)>Oh, you don’t need to tell me—I know who you are!<clear><br><$comeff(1,8)><$motion(1,805)><$voicel(1,7)>You’re a <$cdef(27)>Ditto</color>, not a human... And you’re doing everything<br>you can <$voicel(1,8)>to make this a fun place for us to live! ♪<clear><br><$comeff(1,21)><$motion(1,806)><$voicel(1,9)>You always work super hard, but um—make sure to take<br>breaks too, OK?
msgctxt "3255:245"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>¡Hola, tú! ¿Y tú eres...? <wait(0.9)><$comeff(1,13)><$motionoff(1,804)><$voicel(1,5)>Bueno, no me lo digas.<br>Ya lo sé todo... Jeee...<clear><br><$comeff(1,8)><$motion(1,805)><$voicel(1,7)>En realidad eres un <$cdef(27)>Ditto</color> y has estado trabajando duro<br><$voicel(1,8)>para que todos tengan un sitio en el que vivir felices...<clear><br><$comeff(1,21)><$motion(1,806)><$voicel(1,9)>Tupendo, pero también es importante descansar de vez<br>en cuando, ¿eh?"
msgstr "<$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>¡Hola, tú! ¿Y tú eres...? <wait(0.9)><$comeff(1,13)><$motionoff(1,804)><$voicel(1,5)>Bueno, no me lo digas.<br>Ya lo sé todo... Jeee...<clear><br><$comeff(1,8)><$motion(1,805)><$voicel(1,7)>En realidad eres un <$cdef(27)>Ditto</color> y has estado trabajando duro<br><$voicel(1,8)>para que todos tengan un lugar en el que vivir felices...<clear><br><$comeff(1,21)><$motion(1,806)><$voicel(1,9)>Tupendo, pero también es importante descansar de vez<br>en cuando, ¿eh?"

#. en: <$voicel(1,10)><$motion(1,815)><$comeff(1,5)>TIMBURRRRRR!<clear><br><$voicel(1,5)><$motionoff(1,804)><$comeff(1,3)>Ha! Whaddya think? I’m pretty good with this lumber,<br>right? You should watch me <$cdef(27)><$spwfull(1)></color>—<$voicel(1,8)><$motion(1,806)>I’m a total pro!<clear><br><$voicel(1,5)><$emotion(1,49)>Lemme know if you ever want help building a house!
msgctxt "3255:246"
msgid "<$voicel(1,10)><$motion(1,815)><$comeff(1,5)>¡Buuurrr!<clear><br><$voicel(1,5)><$motionoff(1,804)><$comeff(1,3)>¿Qué te ha parecido mi técnica? ¡A mí lo que mejor se<br>me da es <$cdef(27)><$spwfull(1)></color> todo tipo de cosas, <$voicel(1,8)><$motion(1,806)>por difíciles<slide><br>que parezcan!<clear><br><$voicel(1,5)><$emotion(1,49)>Que no me entere yo de que <$cdef(27)>construyes<nbs2><$spwicon(1)></color> alguna<br>casa humana sin avisarme, ¿eh?"
msgstr "<$voicel(1,10)><$motion(1,815)><$comeff(1,5)>¡Buuurrr!<clear><br><$voicel(1,5)><$motionoff(1,804)><$comeff(1,3)>¿Qué te pareció mi técnica? ¡A mí lo que mejor se<br>me da es <$cdef(27)><$spwfull(1)></color> todo tipo de cosas, <$voicel(1,8)><$motion(1,806)>por difíciles<slide><br>que parezcan!<clear><br><$voicel(1,5)><$emotion(1,49)>Que no me entere yo de que <$cdef(27)>construyes<nbs2><$spwicon(1)></color> alguna<br>casa humana sin avisarme, ¿eh?"

#. en: <$motion(1,814)><$voicel(1,6)>Hup!<clear><br><$motion(1,815)><$voicel(1,8)>Hah!<clear><br><$motionoff(1,804)><$voicel(1,9)>HYAAAH!<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,7)>Whaddya think of these muscles? I got so warmed up<br>I’m practically on fire now!<wait(1.0)><$motion(0,748)><wait(0.8)><clear><br><$comeff(1,5)><$motion(1,803)><$voicel(1,9)>Whoa! You tryin’ to cool me down? Ha! Thanks, pal. I like<br>your style!<clear><br><$emotion(1,38)><$voicel(1,9)>Gimme a call if you need a hand buildin’ anything, yeah?
msgctxt "3255:247"
msgid "<$motion(1,814)><$voicel(1,6)>¡Gur!<clear><br><$motion(1,815)><$voicel(1,8)>¡Duuurr!<clear><br><$motionoff(1,804)><$voicel(1,9)>¡JAAA!<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,7)>Flipas con mis músculos, ¿eh? No veas cómo quema<br>esta rutinilla de ejercicio, ¡los tengo al rojo vivo!<wait(1.0)><$motion(0,748)><wait(0.8)><clear><br><$comeff(1,5)><$motion(1,803)><$voicel(1,9)>¡Ja, ja! ¿Eso es para enfriarme? Te lo has tomado al pie de<br>la letra. Ha sido un buen gesto, ¡me has caído bien!<clear><br><$emotion(1,38)><$voicel(1,9)>Si en algún momento necesitas ayuda construyendo un<br>edificio o algo similar, dame un toque y te echo un cable."
msgstr "<$motion(1,814)><$voicel(1,6)>¡Gur!<clear><br><$motion(1,815)><$voicel(1,8)>¡Duuurr!<clear><br><$motionoff(1,804)><$voicel(1,9)>¡JAAA!<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,7)>Alucinas con mis músculos, ¿eh? No sabes cómo quema<br>esta rutinita de ejercicio, ¡los tengo al rojo vivo!<wait(1.0)><$motion(0,748)><wait(0.8)><clear><br><$comeff(1,5)><$motion(1,803)><$voicel(1,9)>¡Ja, ja! ¿Eso es para enfriarme? Te lo tomaste al pie de<br>la letra. Fue un buen gesto, ¡me caíste bien!<clear><br><$emotion(1,38)><$voicel(1,9)>Si en algún momento necesitas ayuda construyendo un<br>edificio o algo similar, avísame y te echo una mano."

#. en: <$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Hmmm. This ol’ place ain’t what it used to be back in<br>my day...<clear><br><$voicel(1,3)><$comeff(1,17)><$motion(1,807)>Where’s all the concrete gone? Used to stretch as far as<br>the eye could see, but now it’s plumb disappeared!<clear><br><$voicel(1,7)><$emotion(1,27)>I say, this is a real pickle, but...I s’pose I’ll jus’ hafta start<br>spreadin’ the word about concrete again!<clear><br><$voicel(1,7)><$comeff(1,10)><$motion(1,817)>Startin’ with you! Now listen up—concrete’s amazin’! Why,<br>you can make stuff with it OR brandish it all weaponlike!<clear><br><$voicel(1,7)><$emotion(1,8)>I’ll make a concrete convert outta you yet!
msgctxt "3255:248"
msgid "<$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Durr... Hay que ver lo que ha cambiado esta zona...<clear><br><$voicel(1,3)><$comeff(1,17)><$motion(1,807)>En mis tiempos, esto estaba lleno de construcciones<br>de hormigón, ¿sabes?<clear><br><$voicel(1,7)><$emotion(1,27)>Viendo el panorama, creo que solo queda una opción:<br>¡Pregonar las bondades de tan maravilloso material!<clear><br><$voicel(1,7)><$comeff(1,10)><$motion(1,817)>Mira, ya que estás aquí, empiezo contigo, jovenzuel<gen;-2(o,a)>:<br>¡El hormigón es fantástico, ya sea para construir cosas<slide><br>o para hacer malabares con él!<clear><br><$voicel(1,7)><$emotion(1,8)>¡Si te pica la curiosidad, te enseñaré todo lo que quieras<br>saber acerca de este material tan versátil!"
msgstr "<$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Durr... Hay que ver cuánto cambió esta zona...<clear><br><$voicel(1,3)><$comeff(1,17)><$motion(1,807)>En mis tiempos, esto estaba lleno de construcciones<br>de concreto, ¿sabes?<clear><br><$voicel(1,7)><$emotion(1,27)>Viendo el panorama, creo que solo queda una opción:<br>¡Pregonar las bondades de tan maravilloso material!<clear><br><$voicel(1,7)><$comeff(1,10)><$motion(1,817)>Mira, ya que estás aquí, empiezo contigo, jovenzuel<gen;-2(o,a)>:<br>¡El concreto es fantástico, ya sea para construir cosas<slide><br>o para hacer malabares con él!<clear><br><$voicel(1,7)><$emotion(1,8)>¡Si te pica la curiosidad, te enseñaré todo lo que quieras<br>saber acerca de este material tan versátil!"

#. en: <$comeff(1,14)>Hmmmmmm... <wait(0.3)>Hmmm? <$voicel(1,6)>Huh?!<clear><br><$voicel(1,7)><$emotion(1,29)>You’re...not really a human, are you?<clear><br><$voicel(1,5)><$emotion(1,38)>At this point, I guess it doesn’t really matter! Yo, you got<br>any garbage?!<clear><br><$voicel(1,7)><$comeff(1,9)><$motion(1,806)>My body’s really cravin’ some tasty garbage! You all should<br>really do more littering around here.
msgctxt "3255:249"
msgid "<$comeff(1,14)>Hmm...<wait(0.3)> <$voicel(1,6)>¿Eh?<clear><br><$voicel(1,7)><$emotion(1,29)>¿<gen;-2(Un,Una)> human<gen;-2(o,a)>? ¡Qué heavy!<clear><br><$voicel(1,5)><$emotion(1,38)>Ah, ¿que eres un Pokémon? Bah, lo mismo da.<br>¿No llevarás encima algo de basura, por casualidad?<clear><br><$voicel(1,7)><$comeff(1,9)><$motion(1,806)>Tengo un mono de basura de la buena... Ojalá la gente<br>tirase más porquerías al suelo."
msgstr "<$comeff(1,14)>Hmm...<wait(0.3)> <$voicel(1,6)>¿Eh?<clear><br><$voicel(1,7)><$emotion(1,29)>¿<gen;-2(Un,Una)> human<gen;-2(o,a)>? ¡Increíble!<clear><br><$voicel(1,5)><$emotion(1,38)>Ah, ¿que eres un Pokémon? Bah, lo mismo da.<br>¿No llevarás encima algo de basura, por casualidad?<clear><br><$voicel(1,7)><$comeff(1,9)><$motion(1,806)>Tengo un antojo de basura de la buena... Ojalá la gente<br>tirara más porquerías al suelo."

#. en: <$voicel(1,8)><$comeff(1,5)><$motion(1,805)>Trash! Trash! I want to eat some traaash! ♪<clear><br><$voicel(1,5)><$emotion(1,38)>The crinkly stuff has a hint of sweetness, and the soggy<br>stuff just melts in your mouth with flavor. <$voicel(1,4)><$comeff(1,8)><$motion(1,663)><$facial(1,1)>The goopy stuff<slide><br>is so tasty it tingles...<clear><br><$voicel(1,5)><$comeff(1,17)><$motion(1,807)><$facial(1,9)>*sigh* There was so much more garbage everywhere back<br>when the humans were around.<clear><br><$voicel(1,4)><$facial(1,1)><$comeff(1,7)><$motion(1,666)>We’re really living in some trying times...<clear><br><$voicel(1,8)><$emotion(1,14)><$facial(1,4)>Anyway, if you find any trash, please share it with me!
msgctxt "3255:250"
msgid "<$voicel(1,8)><$comeff(1,5)><$motion(1,805)>¡Basuraaa! ¡Busco basuraaa! ¿Quién tiene algo de basura<br>para <gen;-3(un,una)> pobre seño<gen;-3(r,ra)> hambrient<gen;-3(o,a)>?<clear><br><$voicel(1,5)><$emotion(1,38)>Mi reino por un poco de basura dulce y crujiente, de la<br>blandurria que se te deshace en la boca o, poniéndome<slide><br>exquisit<gen;-3(o,a)>, <$voicel(1,4)><$comeff(1,8)><$motion(1,663)><$facial(1,1)>de la viscosa que te entumece la lengua...<clear><br><$voicel(1,5)><$comeff(1,17)><$motion(1,807)><$facial(1,9)>Ay, con la de basura que había por todas partes cuando<br>el mundo estaba lleno de humanos...<clear><br><$voicel(1,4)><$facial(1,1)><$comeff(1,7)><$motion(1,666)>Eso sí que eran buenos tiempos. Lo que daría por volver<br>a comer así de bien.<clear><br><$voicel(1,8)><$emotion(1,14)><$facial(1,4)>En fin, criaturilla, si encuentras algo de basura por ahí,<br>la aceptaré encantad<gen;-3(o,a)>."
msgstr "<$voicel(1,8)><$comeff(1,5)><$motion(1,805)>¡Basuraaa! ¡Busco basuraaa! ¿Quién tiene algo de basura<br>para <gen;-3(un,una)> pobre seño<gen;-3(r,ra)> hambrient<gen;-3(o,a)>?<clear><br><$voicel(1,5)><$emotion(1,38)>Mi reino por un poco de basura dulce y crujiente, de la<br>blandurria que se te deshace en la boca o, poniéndome<slide><br>exquisit<gen;-3(o,a)>, <$voicel(1,4)><$comeff(1,8)><$motion(1,663)><$facial(1,1)>de la viscosa que te entumece la lengua...<clear><br><$voicel(1,5)><$comeff(1,17)><$motion(1,807)><$facial(1,9)>Ay, con la de basura que había por todas partes cuando<br>el mundo estaba lleno de humanos...<clear><br><$voicel(1,4)><$facial(1,1)><$comeff(1,7)><$motion(1,666)>Eso sí que eran buenos tiempos. Lo que daría por volver<br>a comer así de bien.<clear><br><$voicel(1,8)><$emotion(1,14)><$facial(1,4)>En fin, criaturita, si encuentras algo de basura por ahí,<br>la aceptaré encantad<gen;-3(o,a)>."

#. en: <$comeff(1,14)>... ... ...<br>... ... ...<clear><br><$motionoff(1,804)><wait(0.5)><$voicel(1,10)><$comeff(1,14)><$comeff(1,5)><$textsize(2)>Yeowwln!<clear><br><$voicel(1,7)><$emotion(1,38)></textsize>Hee hee! Did I startle you? I just wanted to see how<br>you’d react.<clear><br><$voicel(1,6)><$comeff(1,9)><$motion(1,806)>And it was really fun to watch! Hee hee!<clear><br><$voicel(1,7)><$emotion(1,1)>I really wanna be friends with you! And don’t worry—<br>I won’t play any more pranks!<clear><br>...<wait(0.2)><$voicel(1,6)><$emotion(1,27)>Probably.
msgctxt "3255:251"
msgid "<$comeff(1,14)>...<clear><br><$motionoff(1,804)><wait(0.5)><$voicel(1,10)><$comeff(1,14)><$comeff(1,5)><$textsize(2)>¡¡Buuu!!</textsize><clear><br><$voicel(1,7)><$emotion(1,38)>Ji, ji, ¿te he asustado? Tenía mucha curiosidad por ver<br>cómo reaccionarías... <wait(0.4)><$voicel(1,6)><$comeff(1,9)><$motion(1,806)>¡y diría que ha merecido la pena!<clear><br><$voicel(1,7)><$emotion(1,1)>Tú y yo lo vamos a pasar superdíver, ya verás.<br>¡Y prometo no asustarte más!<clear><br>... <wait(0.2)><$voicel(1,6)><$emotion(1,27)>Al menos por ahora. Ji, ji."
msgstr "<$comeff(1,14)>...<clear><br><$motionoff(1,804)><wait(0.5)><$voicel(1,10)><$comeff(1,14)><$comeff(1,5)><$textsize(2)>¡¡Buuu!!</textsize><clear><br><$voicel(1,7)><$emotion(1,38)>Ji, ji, ¿te asusté? Tenía mucha curiosidad por ver<br>cómo reaccionarías... <wait(0.4)><$voicel(1,6)><$comeff(1,9)><$motion(1,806)>¡y diría que valió la pena!<clear><br><$voicel(1,7)><$emotion(1,1)>Tú y yo la vamos a pasar genial, ya verás.<br>¡Y prometo no asustarte más!<clear><br>... <wait(0.2)><$voicel(1,6)><$emotion(1,27)>Al menos por ahora. Ji, ji."

#. en: <$voicel(1,7)><$emotion(1,14)>Ohhh! That’s a unique look ya got there! You into<br>disguising yourself too?<clear><br><$motion(0,40)><wait(1.2)><$voicel(1,3)><$comeff(1,14)><$motion(1,805)>That’s a halfway decent disguise, I guess... Nowhere<br>near MY level, of course!<clear><br><$voicel(1,5)><$emotion(1,49)>Hey, I know! Let’s be disguise buds! I’ll give you a holler<br>next time I’m gonna prank somebody.<clear><br><$voicel(1,7)><$emotion(1,8)>You and I could get into all KINDS of trouble together!
msgctxt "3255:252"
msgid "<$voicel(1,7)><$emotion(1,14)>¡Qué tenemos aquí! Conque a ti también te va lo de<br>transformarte, ¿eh?<clear><br><$motion(0,40)><wait(1.2)><$voicel(1,3)><$comeff(1,14)><$motion(1,805)>Hmm, no se te da mal, pero todavía te falta pa llegar<br>a mi altura.<clear><br><$voicel(1,5)><$emotion(1,49)>Ya sé, ¿y si nos hacemos coleguillas de travesuras?<br>Seguro que juntos podríamos liarla pero bien, ja, ja.<clear><br><$voicel(1,7)><$emotion(1,8)>La próxima vez que quiera gastarle una broma a alguien,<br>¡te aviso!"
msgstr "<$voicel(1,7)><$emotion(1,14)>¡Qué tenemos aquí! Conque a ti también te gusta<br>transformarte, ¿eh?<clear><br><$motion(0,40)><wait(1.2)><$voicel(1,3)><$comeff(1,14)><$motion(1,805)>Hmm, no se te da mal, pero todavía te falta pa llegar<br>a mi altura.<clear><br><$voicel(1,5)><$emotion(1,49)>Ya sé, ¿y si nos hacemos compinches de travesuras?<br>Seguro que juntos podríamos armar un buen lío, ja, ja.<clear><br><$voicel(1,7)><$emotion(1,8)>La próxima vez que quiera hacerle una broma a alguien,<br>¡te aviso!"

#. en: <$comeff(1,14)>Hmmm...<clear><br>... ... ...<$voicel(1,6)>OK!<clear><br><$voicel(1,7)><$motion(1,806)><$comeff(1,5)><$facial(1,4)>No dust! No dirt! You’re completely clean! That’s sooo<br>great! <$voicel(1,6)><$motion(1,805)><$comeff(1,4)><$facial(1,9)>Oh, sorry, I guess that came outta nowhere!<clear><br><$facial(1,1)><$voicel(1,7)><$motion(1,661)><$comeff(1,7)>It’s just, I get so, um, twitchy? Like I REALLY can’t sit still<br>when stuff isn’t clean!<clear><br><$voicel(1,7)><$emotion(1,16)><$motion(1,805)>Do you ever get that feeling?
msgctxt "3255:253"
msgid "<$comeff(1,14)>Hmm... <$voicel(1,6)>A ver, a veeer...<clear><br><$voicel(1,7)><$motion(1,806)><$comeff(1,5)><$facial(1,4)>¡Ni una mota de polvo a la vista! ¡Nada de mugre!<br>¡Estás limpísim<gen;-2(o,a)>, como debe ser!<clear><br><$voicel(1,6)><$motion(1,805)><$comeff(1,4)><$facial(1,9)>Ay, perdona, me he emocionado un poco de más...<clear><br><$facial(1,1)><$voicel(1,7)><$motion(1,661)><$comeff(1,7)>Es que me pongo de los nervios cuando las cosas<br>no están impolutísimas.<clear><br><$voicel(1,7)><$emotion(1,16)><$motion(1,805)>Lo entiendes, ¿no? Claro que sí."
msgstr "<$comeff(1,14)>Hmm... <$voicel(1,6)>A ver, a veeer...<clear><br><$voicel(1,7)><$motion(1,806)><$comeff(1,5)><$facial(1,4)>¡Ni una mota de polvo a la vista! ¡Nada de mugre!<br>¡Estás limpísim<gen;-2(o,a)>, como debe ser!<clear><br><$voicel(1,6)><$motion(1,805)><$comeff(1,4)><$facial(1,9)>Ay, perdona, me emocioné un poco de más...<clear><br><$facial(1,1)><$voicel(1,7)><$motion(1,661)><$comeff(1,7)>Es que me altero muchísimo cuando las cosas<br>no están impolutísimas.<clear><br><$voicel(1,7)><$emotion(1,16)><$motion(1,805)>Lo entiendes, ¿no? Claro que sí."

#. en: <$voicel(1,7)><$emotion(1,27)>Oh! I’m sorry, but could you wait a moment?<clear><br><$voicel(1,5)><$comeff(1,10)><$motion(1,805)>I’m making myself presentable for guests. Just working<br>on some finishing touches... Almost finished...<slide><br><$motion(1,816)><$voicel(1,8)><$comeff(1,9)>Ta-daaa!<clear><br><$voicel(1,6)><$emotion(1,39)>There, all nice and clean!<clear><br><$voicel(1,7)><$emotion(1,49)>Thank you for waiting. I’m delighted to meet you!
msgctxt "3255:254"
msgid "<$voicel(1,7)><$emotion(1,27)>Ay, chiqui, ¿te importa esperar un segundín?<clear><br><$voicel(1,5)><$comeff(1,10)><$motion(1,805)>Es que todavía no tengo este lugar listo para que vengan<br>visitas, me falta darle un último repaso... <clear><br><$motion(1,816)><$voicel(1,8)><$comeff(1,9)>¡Tachán!<clear><br><$voicel(1,6)><$emotion(1,39)>Mucho mejor así. ¡Limpio y adecentado! Qué gusto, oye...<br><$voicel(1,7)><$emotion(1,49)>Perdona, ya estoy. ¡Un placer conocerte!"
msgstr "<$voicel(1,7)><$emotion(1,27)>Ay, cielito, ¿te importa esperar un segundito?<clear><br><$voicel(1,5)><$comeff(1,10)><$motion(1,805)>Es que todavía no tengo este lugar listo para que vengan<br>visitas, me falta darle un último repaso... <clear><br><$motion(1,816)><$voicel(1,8)><$comeff(1,9)>¡Tachán!<clear><br><$voicel(1,6)><$emotion(1,39)>Mucho mejor así. ¡Limpio y adecentado! Qué gusto, oye...<br><$voicel(1,7)><$emotion(1,49)>Perdona, ya terminé. ¡Un placer conocerte!"

#. en: <$voicel(1,6)><$emotion(1,14)>Umm... Who are you? Are you lost?<wait(1.0)><$motion(0,41)><wait(1.9)><$motion(0,824)><wait(1.0)><$motion(0,652)><wait(0.5)><clear><br><$voicel(1,3)><$comeff(1,6)><$motion(1,805)>You’re not? You say you’re actually the one looking?<clear><br><$voicel(1,5)><$emotion(1,46)>Ooh, so all the humans have gotten lost, huh? <$voicel(1,8)><$comeff(1,10)><$motionoff(1,804)><$facial(1,4)>OK... I can<br>help you look for them!<clear><br><$voicel(1,5)><$facial(1,4)><$comeff(1,21)><$motion(1,806)>I’m sure they’re feeling lonely. Someone needs to find<br>them and guide them on their way...
msgctxt "3255:255"
msgid "<$voicel(1,6)><$emotion(1,14)>¿Q-quién eres? ¿Te has perdido?<wait(1.0)><$motion(0,41)><wait(1.9)><$motion(0,824)><wait(1.0)><$motion(0,652)><wait(0.5)><clear><br><$voicel(1,3)><$comeff(1,6)><$motion(1,805)>Ah, ¿no? ¿Eres tú quien anda buscando a alguien?<clear><br><$voicel(1,5)><$emotion(1,46)>Ah... Conque todos los humanos se han perdido...<br><$voicel(1,8)><$comeff(1,10)><$motionoff(1,804)><$facial(1,4)>Oye, p-pues si quieres, te puedo ayudar a buscarlos.<clear><br><$voicel(1,5)><$facial(1,4)><$comeff(1,21)><$motion(1,806)>Seguro que se sienten muy solitos tan lejos de casa...<br>Necesitan que alguien les muestre el camino de vuelta."
msgstr "<$voicel(1,6)><$emotion(1,14)>¿Q-quién eres? ¿Te perdiste?<wait(1.0)><$motion(0,41)><wait(1.9)><$motion(0,824)><wait(1.0)><$motion(0,652)><wait(0.5)><clear><br><$voicel(1,3)><$comeff(1,6)><$motion(1,805)>Ah, ¿no? ¿Eres tú quien anda buscando a alguien?<clear><br><$voicel(1,5)><$emotion(1,46)>Ah... Conque todos los humanos se perdieron...<br><$voicel(1,8)><$comeff(1,10)><$motionoff(1,804)><$facial(1,4)>Oye, p-pues si quieres, te puedo ayudar a buscarlos.<clear><br><$voicel(1,5)><$facial(1,4)><$comeff(1,21)><$motion(1,806)>Seguro que se sienten muy solitos tan lejos de casa...<br>Necesitan que alguien les muestre el camino de vuelta."

#. en: <$motion(1,666)><$voicel(1,7)><$comeff(1,6)>Huh? A human? No...you smell different.<wait(1.0)><$motion(0,824)><wait(1.0)><$motion(0,652)><wait(0.5)><clear><br><$voicel(1,5)><$emotion(1,14)>Oh, you say you’re looking for a human? I certainly<br>haven’t seen any around here... <$voicel(1,4)><$comeff(1,14)><$motion(1,805)>It’s so much quieter than<slide><br>it used to be... Like a fire’s gone out...<clear><br><$voicel(1,7)><$emotion(1,49)>Hey, is...is it alright if I help you look?<$voicel(1,8)> It’d be so nice to<br>see everyone again!
msgctxt "3255:256"
msgid "<$motion(1,666)><$voicel(1,7)><$comeff(1,6)>¿Eh? ¿Eres <gen;-2(un,una)> human<gen;-2(o,a)>? No, no hueles a humano...<wait(1.0)><$motion(0,824)><wait(1.0)><$motion(0,652)><wait(0.5)><clear><br><$voicel(1,5)><$emotion(1,14)>Ya veo, conque estás buscando a <gen;-2(uno,una)>... Ahora que lo<br>dices, no noto la presencia de ninguno por esta zona.<clear><br><$voicel(1,4)><$comeff(1,14)><$motion(1,805)>Está todo mucho más tranquilo que antes, como si se<br>hubiese apagado una llama...<clear><br><$voicel(1,7)><$emotion(1,49)>P-por cierto, ¿quieres que te ayude con tu búsqueda?<br><$voicel(1,8)>A mí también me gustaría que volvieran los humanos..."
msgstr ""

#. en: <$voicel(1,7)><$comeff(1,14)><$motion(1,805)>I get the sense that the number of humans and Pokémon<br>has greatly declined.<clear><br><$voicel(1,5)><$emotion(1,29)>And what about you? What are you up to? It seems you<br>have quite a lot going on.<wait(1.0)><$motion(0,824)><wait(1.0)><$motion(0,652)><wait(0.5)><clear><br><$voicel(1,7)><$emotion(1,8)>Oh my, fixing up the area and creating homes so that<br>others will return here?<clear><br><$voicel(1,5)><$emotion(1,49)>Well, isn’t that a splendid idea! I insist on helping you with<br>this endeavor. <$voicel(1,4)><$motion(1,805)><$comeff(1,8)><$facial(1,9)>I long to see humans again soon...
msgctxt "3255:257"
msgid "<$voicel(1,7)><$comeff(1,14)><$motion(1,805)>Vaya, veo que tanto el número de humanos como de<br>Pokémon se ha reducido drásticamente.<clear><br><$voicel(1,5)><$emotion(1,29)>¿Tú qué haces aquí? Pareces bastante ocupad<gen;-2(o,a)>...<wait(1.0)><$motion(0,824)><wait(1.0)><$motion(0,652)><wait(0.5)><clear><br><$voicel(1,7)><$emotion(1,8)>¿Estás creando lugares para vivir y acondicionándolos<br>para que todo el mundo vuelva?<clear><br><$voicel(1,5)><$emotion(1,49)>Ju, ju, mira qué bien. Si necesitas ayuda, yo te la presto<br>cuando quieras.<clear><br><$voicel(1,4)><$motion(1,805)><$comeff(1,8)><$facial(1,9)>Tengo muchas ganas de que vuelvan los humanos..."
msgstr "<$voicel(1,7)><$comeff(1,14)><$motion(1,805)>Vaya, veo que tanto el número de humanos como de<br>Pokémon se redujo drásticamente.<clear><br><$voicel(1,5)><$emotion(1,29)>¿Tú qué haces aquí? Pareces bastante ocupad<gen;-2(o,a)>...<wait(1.0)><$motion(0,824)><wait(1.0)><$motion(0,652)><wait(0.5)><clear><br><$voicel(1,7)><$emotion(1,8)>¿Estás creando lugares para vivir y acondicionándolos<br>para que todo el mundo vuelva?<clear><br><$voicel(1,5)><$emotion(1,49)>Ju, ju, mira qué bien. Si necesitas ayuda, yo te la presto<br>cuando quieras.<clear><br><$voicel(1,4)><$motion(1,805)><$comeff(1,8)><$facial(1,9)>Tengo muchas ganas de que vuelvan los humanos..."

#. en: <$comeff(1,5)><$motionoff(1,804)><$voicel(1,9)>Whoa! Who are you? Why are you on my turf? Get outta<br>here <$comeff(1,22)><$motion(1,815)><$voicel(1,8)>or get ready to catch these tusks!<clear><br><$comeff(1,6)><$motion(1,666)><$voicel(1,5)>Uh... Why aren’t you scared? Wasn’t I menacing enough?<clear><br><$comeff(1,10)><$motion(1,803)><$voicel(1,10)>Well, don’t get TOO comfortable!<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,7)>Someday, when my tusks are big and intimidating like<br><$cdef(27)>Haxorus</color>’s, I’m gonna scare you off SO good!<slide><br><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>But how about we be friends until then, OK?
msgctxt "3255:258"
msgid "<$comeff(1,5)><$motionoff(1,804)><$voicel(1,9)>¡Eeey! ¡¿Quién se atreve a invadir MI territorio?!<br><wait(0.4)><$comeff(1,22)><$motion(1,815)><$voicel(1,8)>¡Te las vas a ver con mis colmillos!<clear><br><$comeff(1,6)><$motion(1,666)><$voicel(1,5)>¿Eh? No te has achantado ni un poquito... ¿Y eso?<br>¿Qué me ha faltado? Hmm...<clear><br><$comeff(1,10)><$motion(1,803)><$voicel(1,10)>¡Ya sé!<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,7)>Cuando tenga unos colmillos enormes, en plan <$cdef(27)>Haxorus</color>,<br>¡te vas a enterar de lo que es bueno!<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>En fin, que encantad<gen;-3(o,a)>."
msgstr "<$comeff(1,5)><$motionoff(1,804)><$voicel(1,9)>¡Eeey! ¡¿Quién se atreve a invadir MI territorio?!<br><wait(0.4)><$comeff(1,22)><$motion(1,815)><$voicel(1,8)>¡Te las vas a ver con mis colmillos!<clear><br><$comeff(1,6)><$motion(1,666)><$voicel(1,5)>¿Eh? No te asustaste ni un poquito... ¿Y eso?<br>¿Qué me faltó? Hmm...<clear><br><$comeff(1,10)><$motion(1,803)><$voicel(1,10)>¡Ya sé!<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,7)>Cuando tenga colmillos enormes como los de <$cdef(27)>Haxorus</color>,<br>¡te vas a enterar de lo que es bueno!<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>En fin, que encantad<gen;-3(o,a)>."

#. en: <$voicel(1,7)><$comeff(1,5)><$motion(1,662)>Hey! What’re you doing on MY turf, pal? Try anything tricky<br>and these tusks’ll teach you a...<clear><br><$voicel(1,5)><$motion(1,805)><$comeff(1,14)>Actually, you’re pretty squishy, huh? Not sure if these<br>tusks’ll do anything, really.<clear><br><$voicel(1,7)><$emotion(1,49)>Anyway, you don’t look like the tricksy type, so hopefully<br>we can be pals!
msgctxt "3255:259"
msgid "<$voicel(1,7)><$comeff(1,5)><$motion(1,662)>¡Oye! ¿Qué haces en mi territorio? Como te traigas entre<br>manos algo chungo, te hago pedazos con estos señores<slide><br>colmillos que tengo...<clear><br><$voicel(1,5)><$motion(1,805)><$comeff(1,14)>Aunque, ahora que te miro de cerca... tienes una pinta<br>como muy gomosa. No sé si morderte serviría de algo...<clear><br><$voicel(1,7)><$emotion(1,49)>Bah, tienes cara de ser buena gente, lo mismo hasta<br>podríamos llevarnos bien."
msgstr "<$voicel(1,7)><$comeff(1,5)><$motion(1,662)>¡Oye! ¿Qué haces en mi territorio? Si te traes entre<br>manos algo raro, te hago pedazos con estos señores<slide><br>colmillos que tengo...<clear><br><$voicel(1,5)><$motion(1,805)><$comeff(1,14)>Aunque, ahora que te miro de cerca... tienes un aspecto<br>como muy gomoso. No sé si morderte serviría de algo...<clear><br><$voicel(1,7)><$emotion(1,49)>Bah, tienes cara de ser buena gente, a lo mejor hasta<br>podríamos llevarnos bien."

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Haxoraaa! ♪ This oughta be a fine place to sleep, I tell<br>ya what!<slide><br><$comeff(1,6)><$facial(1,1)><$motion(1,806)><$voicel(1,6)>But who on earth coulda made such a nice place?<clear><br><$emotion(1,14)><$voicel(1,7)>Say what, now?! YOU made it? Fer me?!<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,805)><$voicel(1,5)>Well then, it’d be right rude o’ me not to make use of it!<br>In return, I’d be glad to help ya with anything ya need.<clear><br><$emotion(1,38)><$voicel(1,9)>These magnificent tusks o’ mine can cut through anythin’!<br>I’m sure I can help ya make places to live, as well!
msgctxt "3255:260"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Haaax! ¡Este rincón es ideal para una buena madriguera!<br><wait(0.4)><$comeff(1,6)><$facial(1,1)><$motion(1,806)><$voicel(1,6)>Me pregunto quién habrá creado tan estupendo lugar...<clear><br><$emotion(1,14)><$voicel(1,7)>¿Dices que ha sido obra tuya?<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,805)><$voicel(1,5)>Caray, pues no puedo hacer otra cosa que agradecértelo.<br>A cambio, te ofrezco mi ayuda.<clear><br><$emotion(1,38)><$voicel(1,9)>Estos colmillos son capaces de cortar lo que les eches.<br>Seguro que te sirven para crear más lugares acogedores."
msgstr "<$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Haaax! ¡Este rincón es ideal para una buena madriguera!<br><wait(0.4)><$comeff(1,6)><$facial(1,1)><$motion(1,806)><$voicel(1,6)>Me pregunto quién habrá creado tan estupendo lugar...<clear><br><$emotion(1,14)><$voicel(1,7)>¿Dices que fue obra tuya?<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,805)><$voicel(1,5)>Caray, pues no puedo hacer otra cosa que agradecértelo.<br>A cambio, te ofrezco mi ayuda.<clear><br><$emotion(1,38)><$voicel(1,9)>Estos colmillos son capaces de cortar lo que les eches.<br>Seguro que te sirven para crear más lugares acogedores."

#. en: <$voicel(1,7)><$comeff(1,21)><$emotion(1,39)>This area is so warm and comfortable... It makes me want<br>to spew out fire... <$comeff(1,6)><$motion(1,805)><$voicel(1,6)>Are you here to relax too?<wait(1.0)><$motion(0,824)><wait(1.0)><$motion(0,652)><wait(0.6)><clear><br><$voicel(1,7)><$emotion(1,15)><$motion(1,663)>Wait, you made this place? Oh wow... That’s pretty<br>amazing!<clear><br><$voicel(1,5)><$emotion(1,49)>I think I’m gonna live here. I-I promise I won’t burn<br>anything down...
msgctxt "3255:261"
msgid "<$voicel(1,7)><$comeff(1,21)><$emotion(1,39)>Este lugar me encanta, es tan calentito... Hace que quiera<br>ponerme a escupir fuego por todas partes.<clear><br><$comeff(1,6)><$motion(1,805)><$voicel(1,6)>¿Tú también has venido aquí a estar de tranquileo?<wait(1.0)><$motion(0,824)><wait(1.0)><$motion(0,652)><wait(0.6)><clear><br><$voicel(1,7)><$emotion(1,15)><$motion(1,663)>¿C-cómo? ¿Que tú eres quien ha preparado este lugar?<br>Qué me dices... Increíble.<clear><br><$voicel(1,5)><$emotion(1,49)>P-pues me gustaría vivir aquí. Prometo tener cuidado<br>y no quemar nada."
msgstr "<$voicel(1,7)><$comeff(1,21)><$emotion(1,39)>Este lugar me encanta, es tan calentito... Hace que quiera<br>ponerme a escupir fuego por todas partes.<clear><br><$comeff(1,6)><$motion(1,805)><$voicel(1,6)>¿Tú también viniste aquí a relajarte?<wait(1.0)><$motion(0,824)><wait(1.0)><$motion(0,652)><wait(0.6)><clear><br><$voicel(1,7)><$emotion(1,15)><$motion(1,663)>¿C-cómo? ¿Que tú eres quien preparó este lugar?<br>Qué me dices... Increíble.<clear><br><$voicel(1,5)><$emotion(1,49)>P-pues me gustaría vivir aquí. Prometo tener cuidado<br>y no quemar nada."

#. en: <$emotion(1,14)><$voicel(1,7)>Oh, hello there. Nice to make your acquaintance. What<br>a...nostalgic look you have there.<clear><br><$comeff(1,14)><$motion(1,827)><$voicel(1,5)>I always wanted to be friends with a human...<clear><br><$voicel(1,3)>But whenever I approached one, they were always<br>frightened of me and tried to keep their distance.<clear><br><$comeff(1,7)><$facial(1,9)><$motion(1,802)><$voicel(1,2)>It was quite depressing, to be honest...but there<br>was nothing I could do about it.<clear><br><$emotion(1,8)><$voicel(1,9)>Ah... My apologies. Never mind my musings. I’d love to<br>become friends with you instead!
msgctxt "3255:262"
msgid "<$emotion(1,14)><$voicel(1,7)>Hola, un placer. Ese aspecto que has adoptado me trae<br>recuerdos ciertamente tristes...<clear><br><$comeff(1,14)><$motion(1,827)><$voicel(1,5)>Verás, antaño intenté trabar amistad con los humanos...<br>mas siempre mantuvieron la distancia. <$voicel(1,3)>Parecían temerme.<slide><br><$comeff(1,7)><$facial(1,9)><$motion(1,802)><$voicel(1,2)>Fue verdaderamente descorazonador.<clear><br><$emotion(1,8)><$voicel(1,9)>Disculpa, no pretendía aburrirte con mis historias.<br>Ojalá podamos trabar una bella amistad tú y yo."
msgstr ""

#. en: <$comeff(1,10)><$motionoff(1,804)><$voicel(1,9)>Croak croooaaak! Check out my bubbles—they’re on a<br>whole new level of supple springiness! Probably ’cause I’ve<slide><br><$emotion(1,8)><$voicel(1,8)>found a great home where I can get lots of rest!<clear><br><$comeff(1,5)><$facial(1,1)><$motion(1,803)><$voicel(1,9)>Whoa, what?! YOU made this place? ’Cause you wanna<br>make sure everyone’s got a comfy spot to stay?<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,817)><$voicel(1,9)>Well that does it—I’m gonna help you out! Just lemme<br>know if you need anything, OK?
msgctxt "3255:263"
msgid "<$comeff(1,10)><$motionoff(1,804)><$voicel(1,9)>¡Froooak! ¿Has visto lo esponjosas y suaves que están mis<br>burbujas? <$emotion(1,8)><$voicel(1,8)>¡Es por haber encontrado un hogar donde<slide><br>poder dormir como es debido!<clear><br><$comeff(1,5)><$facial(1,1)><$motion(1,803)><$voicel(1,9)>¿Cómooo? ¿Que lo has preparado tú con esas manitas?<clear><br>Te estás esforzando un montón para que todo el mundo<br>esté muy cómodo aquí, ¿no?<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,817)><$voicel(1,9)>Vale, ¡pues yo tampoco me quedaré de ancas cruzadas!<br>Avísame si necesitas ayuda con cualquier cosa."
msgstr "<$comeff(1,10)><$motionoff(1,804)><$voicel(1,9)>¡Froooak! ¿Viste lo esponjosas y suaves que están mis<br>burbujas? <$emotion(1,8)><$voicel(1,8)>¡Es por haber encontrado un hogar donde<slide><br>poder dormir como es debido!<clear><br><$comeff(1,5)><$facial(1,1)><$motion(1,803)><$voicel(1,9)>¿Cómooo? ¿Que lo preparaste tú con esas manitas?<clear><br>Te estás esforzando un montón para que todo el mundo<br>esté muy cómodo aquí, ¿no?<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,817)><$voicel(1,9)>Bueno, ¡pues yo tampoco me quedaré de ancas cruzadas!<br>Avísame si necesitas ayuda con cualquier cosa."

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,805)><$voicel(1,9)>Ribbit riiibbit! Yooo, this place is so nice! And it’s got<br>super great scenery too!<wait(1.0)><$motion(0,824)><wait(1.2)><$motion(0,652)><wait(0.6)><clear><br><$comeff(1,5)><$facial(1,1)><$motion(1,803)><$voicel(1,8)>Whaaat?! You’re the one who got this place set up all nice<br>and junk?!<clear><br><$emotion(1,38)><$voicel(1,9)>That’s AMAZING! You’re pretty skilled, huh?<clear><br><$comeff(1,14)><$facial(1,4)><$motion(1,806)><$voicel(1,5)>Well, y’know, I really like climbin’ up to high places! So it’d<br>be super cool, yo, if you could make some HUGE<slide><br><$emotion(1,8)><$voicel(1,10)>mountains and stuff around here too!
msgctxt "3255:264"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,805)><$voicel(1,9)>♪¡Fro, frooo!♪ ¡Qué fantasía de lugar! ¿Pero tú has visto<br>estos paisajes?<wait(1.0)><$motion(0,824)><wait(1.2)><$motion(0,652)><wait(0.6)><clear><br><$comeff(1,5)><$facial(1,1)><$motion(1,803)><$voicel(1,8)>¿Qué diceees? ¿Que es cosa tuya? <$emotion(1,38)><$voicel(1,9)>Pues oye, ¡de diez!<clear><br><$comeff(1,14)><$facial(1,4)><$motion(1,806)><$voicel(1,5)>Oye, y ya que estamos... podrías marcarte también<br>una montañita o algo, ¿no?<clear><br><$emotion(1,8)><$voicel(1,10)>¡Es que me mola escalar lugares muy altos!"
msgstr "<$comeff(1,9)><$facial(1,4)><$motion(1,805)><$voicel(1,9)>♪¡Fro, frooo!♪ ¡Qué fantasía de lugar! ¿Pero ya viste<br>estos paisajes?<wait(1.0)><$motion(0,824)><wait(1.2)><$motion(0,652)><wait(0.6)><clear><br><$comeff(1,5)><$facial(1,1)><$motion(1,803)><$voicel(1,8)>¿Qué diceees? ¿Que es cosa tuya? <$emotion(1,38)><$voicel(1,9)>Pues oye, ¡de diez!<clear><br><$comeff(1,14)><$facial(1,4)><$motion(1,806)><$voicel(1,5)>Oye, y ya que estamos... podrías hacer también<br>una montañita o algo, ¿no?<clear><br><$emotion(1,8)><$voicel(1,10)>¡Es que me encanta escalar lugares muy altos!"

#. en: <$voicel(1,8)><$emotion(1,27)>Ah. I’ve been spotted.<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,806)>I sensed someone’s presence and hid myself away to<br>assess the situation. <$motion(1,666)><$voicel(1,4)>But it seems you’re not an enemy.<clear><br><$voicel(1,7)><$emotion(1,32)>I can’t imagine any devious schemes lurking behind such<br>vacant eyes.<clear><br><$voicel(1,7)><$emotion(1,49)>Next time we meet, I won’t hide, so please greet me when<br>you see me.
msgctxt "3255:265"
msgid "<$voicel(1,8)><$emotion(1,27)>Vaya, me has encontrado.<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,806)>He notado que algo se aproximaba y me he escondido<br>para poder observar sin ser vist<gen;-3(o,a)>...<clear><br><$motion(1,666)><$voicel(1,4)>Pero no pareces ser una amenaza. Ese rostro tan afable<br><$voicel(1,7)><$emotion(1,32)>no puede esconder viles intenciones.<clear><br><$voicel(1,7)><$emotion(1,49)>No veo la necesidad de evitarte, así que salúdame<br>cuando me veas."
msgstr "<$voicel(1,8)><$emotion(1,27)>Vaya, me encontraste.<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,806)>Noté que algo se aproximaba y me escondí<br>para poder observar sin ser vist<gen;-3(o,a)>...<clear><br><$motion(1,666)><$voicel(1,4)>Pero no pareces ser una amenaza. Ese rostro tan afable<br><$voicel(1,7)><$emotion(1,32)>no puede esconder viles intenciones.<clear><br><$voicel(1,7)><$emotion(1,49)>No veo la necesidad de evitarte, así que salúdame<br>cuando me veas."

#. en: <$voicel(1,7)><$comeff(1,3)>Tyrooo! Hey, play with me! C’mon!<$motion(1,817)><wait(0.5)><$motion(0,182)><wait(0.06)><$comeff(0,5)><wait(0.8)><clear><br><$voicel(1,10)><$comeff(1,9)><$motion(1,805)><$comeff(1,3)>Huh?! Why’d you get all...squishy?<clear><br><$voicel(1,5)><$comeff(1,6)><$motion(1,666)>Do you not wanna play? Or...were you having fun?<$motion(0,181)><wait(2.0)> I...<br><$voicel(1,10)><$comeff(1,5)><$motion(1,803)><$facial(1,4)>I’ve got no clue which it is! Hehe!<clear><br><$voicel(1,8)><$emotion(1,8)>But we should play again sometime. This was fun!
msgctxt "3255:266"
msgid "<$voicel(1,7)><$comeff(1,3)>¡Oooyeee! ¿Juegas conmigo? ¡Venga, vaaaa!<$motion(1,817)><wait(0.5)><$motion(0,182)><wait(0.06)><$comeff(0,5)><wait(0.8)><clear><br><$voicel(1,10)><$comeff(1,9)><$motion(1,805)><$comeff(1,3)>¡Hala! ¿Qué te ha pasado? Estás tod<gen;-2(o,a)> espachurrad<gen;-2(o,a)>.<clear><br><$voicel(1,5)><$comeff(1,6)><$motion(1,666)>¿Es que no te ha gustado el juego? ¿O es que te lo estás<br>pasando tan chachi conmigo que te ha dado un soponcio?<$motion(0,181)><wait(2.0)><clear><br>...<$voicel(1,10)><$comeff(1,5)><$motion(1,803)><$facial(1,4)> ¡Jopetas, no entiendo nadaaa!<clear><br><$voicel(1,8)><$emotion(1,8)>En fin, si quieres volver a jugar, yo encantad<gen;-3(o,a)> de la vida."
msgstr "<$voicel(1,7)><$comeff(1,3)>¡Oooyeee! ¿Juegas conmigo? ¡Vamos, porfaaa!<$motion(1,817)><wait(0.5)><$motion(0,182)><wait(0.06)><$comeff(0,5)><wait(0.8)><clear><br><$voicel(1,10)><$comeff(1,9)><$motion(1,805)><$comeff(1,3)>¡Guau! ¿Qué te pasó? Estás tod<gen;-2(o,a)> aplastad<gen;-2(o,a)>.<clear><br><$voicel(1,5)><$comeff(1,6)><$motion(1,666)>¿Es que no te gustó el juego? ¿O es que te la estás<br>pasando tan bien conmigo que te dio un soponcio?<$motion(0,181)><wait(2.0)><clear><br>...<$voicel(1,10)><$comeff(1,5)><$motion(1,803)><$facial(1,4)> ¡Rayos, no entiendo nadaaa!<clear><br><$voicel(1,8)><$emotion(1,8)>En fin, si quieres volver a jugar, yo encantad<gen;-3(o,a)> de la vida."

#. en: <$comeff(1,22)><$motionoff(1,804)><$voicel(1,9)>Ty-RAAAH! Who do ya think you are?! I say, this here’s<br>MY land!<slide><br><$comeff(1,10)><$motion(1,803)><$voicel(1,8)>I jus’ claimed it—’n’ what I say goes!<clear><br><$comeff(1,6)><$motion(1,805)><$voicel(1,5)>What’s that, now?! YOU made this land what it is?<br>Well, knock me down! That’s quite the feat!<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,7)>Hmmm... Keepin’ you around might not be so bad. Could<br>even make this a nicer place to live, I reckon...<clear><br><$emotion(1,38)><$voicel(1,9)>OK! I hereby grant ya permission to roam my land!<br>Ain’t no problem at all, nope! Gwahahahaaa!
msgctxt "3255:267"
msgid "<$comeff(1,22)><$motionoff(1,804)><$voicel(1,9)>¡GRRRRRR! ¿Qué se te ha perdido en mi territorio, moz<gen;-2(o,a)>?<clear><br><$comeff(1,10)><$motion(1,803)><$voicel(1,8)>¡Y sí, acabo de decidir ahora mismo que es mío, y punto!<br>¿Algún inconveniente?<clear><br><$comeff(1,6)><$motion(1,805)><$voicel(1,5)>¿Cómo dices? ¿Que este sitio es obra tuya? <wait(0.4)>¡Caray!<br>¡Estás hech<gen;-2(o,a)> tod<gen;-2(o,a)> <gen;-2(un,una)> manitas!<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,7)>Hm... Igual convendría tenerte cerca para que me<br>mantuvieras esto a punto...<clear><br><$emotion(1,38)><$voicel(1,9)>Está bien. Por ser tú, tienes permiso para deambular por<br>mi propiedad como te plazca. ¡Bua, ja, ja!"
msgstr "<$comeff(1,22)><$motionoff(1,804)><$voicel(1,9)>¡GRRRRRR! ¿Qué se te perdió en mi territorio, moz<gen;-2(o,a)>?<clear><br><$comeff(1,10)><$motion(1,803)><$voicel(1,8)>¡Y sí, acabo de decidir ahora mismo que es mío, y punto!<br>¿Algún inconveniente?<clear><br><$comeff(1,6)><$motion(1,805)><$voicel(1,5)>¿Cómo dices? ¿Que este lugar es obra tuya? <wait(0.4)>¡Caray!<br>¡Estás hech<gen;-2(o,a)> tod<gen;-2(o,a)> <gen;-2(un,una)> artista!<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,7)>Hm... Quizás convendría tenerte cerca para que me<br>mantuvieras esto en orden...<clear><br><$emotion(1,38)><$voicel(1,9)>Está bien. Por ser tú, tienes permiso para deambular por<br>mi propiedad como te plazca. ¡Bua, ja, ja!"

#. en: <$comeff(1,16)><$facial(1,4)><$motion(1,807)><$voicel(1,4)>*yaaawn*<wait(0.8)><$facial(1,1)><br>Oh, hey there.<clear><br><$comeff(1,14)><$motion(1,805)><$voicel(1,3)>I feel like I’ve been sleeping for a long time. I was<br>dreaming, I think... I was in a nice, cool place...<clear><br><$emotion(1,38)><$voicel(1,7)>But this place is just as nice as my dreams.<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,9)>Maybe I’ll make this my new home. Looks like I’ve made a<br>new friend too.
msgctxt "3255:268"
msgid "<$comeff(1,16)><$facial(1,4)><$motion(1,807)><$voicel(1,4)>Uaaaaaah...<wait(0.8)><$facial(1,1)> Oh, buenos días.<clear><br><$comeff(1,14)><$motion(1,805)><$voicel(1,3)>Siento que llevo media vida durmiendo. Estaba soñando<br>que me encontraba en un lugar fresco y muy apacible...<slide><br><$emotion(1,38)><$voicel(1,7)>pero, ahora que levanto la vista, lo cierto es que este<slide><br>lugar no se queda atrás.<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,9)>Me voy a venir a vivir aquí, así que encantad<gen;-3(o,a)> de<br>conocerte, vecin<gen;-2(o,a)>."
msgstr ""

#. en: <$emotion(1,14)><$voicel(1,5)>Oh, I’m so pleased to meet a new face! And this place is<br>quite nice too. So calm and peaceful.<clear><br><$emotion(1,8)><$voicel(1,9)>I’ll be living here from now on, so I’m looking forward to<br>us getting to know each other better!<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,803)><$voicel(1,6)>Oh, but just one thing—<$comeff(1,10)><$motion(1,807)><$voicel(1,9)>My body is EXTREMELY cold! Be<br>careful not to touch me, or you’ll be frozen solid!<clear><br><$comeff(1,21)><$facial(1,4)><$motion(1,803)><$voicel(1,8)>You’ve been warned, dear!
msgctxt "3255:269"
msgid "<$emotion(1,14)><$voicel(1,5)>Ay, hola, criatura. Qué feliz estoy de haber encontrado<br>un lugar donde puedo ir a mi ritmo, sin prisas.<clear><br><$emotion(1,8)><$voicel(1,9)>He decidido venirme a vivir aquí, así que espero que<br>podamos llevarnos bien.<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,803)><$voicel(1,6)>Ah, pero hay algo que debes saber...<clear><br><$comeff(1,10)><$motion(1,807)><$voicel(1,9)>Mi cuerpo está extremadamente frío, así que, si lo tocas,<br>terminarás convertid<gen;-2(o,a)> en un cubito de hielo...<clear><br><$comeff(1,21)><$facial(1,4)><$motion(1,803)><$voicel(1,8)>Ten cuidado, ¿vale, pequeñ<gen;-2(ín,ina)>?"
msgstr "<$emotion(1,14)><$voicel(1,5)>Ay, hola, criatura. Qué feliz estoy de haber encontrado<br>un lugar donde puedo ir a mi ritmo, sin prisas.<clear><br><$emotion(1,8)><$voicel(1,9)>Decidí venirme a vivir aquí, así que espero que<br>podamos llevarnos bien.<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,803)><$voicel(1,6)>Ah, pero hay algo que debes saber...<clear><br><$comeff(1,10)><$motion(1,807)><$voicel(1,9)>Mi cuerpo está extremadamente frío, así que, si lo tocas,<br>terminarás convertid<gen;-2(o,a)> en un cubito de hielo...<clear><br><$comeff(1,21)><$facial(1,4)><$motion(1,803)><$voicel(1,8)>Ten cuidado, ¿de acuerdo, pequeñ<gen;-2(ín,ina)>?"

#. en: <$emotion(1,50)><$voicel(1,7)>Why hello, how do you do? What a lovely little spot.<clear><br><$comeff(1,3)><$facial(1,4)><$motion(1,805)><$voicel(1,5)>Oh my! You created this charming haven? I’m sure it’ll fill<br>up with Pokémon in no time.<clear><br><$emotion(1,38)><$voicel(1,9)>If the Pokémon begin to quarrel, you must allow me to<br>help. <$comeff(1,21)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>I’m quite adept at stopping fights, you see.<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,9)>My dearest hope is to help us all get along.
msgctxt "3255:270"
msgid "<$emotion(1,50)><$voicel(1,7)>¡Hola! Encantad<gen;-3(o,a)> de conocerte. Me gusta mucho este<br>lugar, la verdad.<clear><br><$comeff(1,3)><$facial(1,4)><$motion(1,805)><$voicel(1,5)>Ah, ¿lo has creado tú? Pues seguro que muchos Pokémon<br>se pasarán por aquí.<clear><br><$emotion(1,38)><$voicel(1,9)>Si ves que algunos se pelean, deja que yo me encargue.<br><wait(0.4)><$comeff(1,21)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>¡Sembrar la paz es lo que mejor se me da!<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,9)>Espero que todos los Pokémon que vengan convivan<br>en paz y armonía."
msgstr "<$emotion(1,50)><$voicel(1,7)>¡Hola! Encantad<gen;-3(o,a)> de conocerte. Me gusta mucho este<br>lugar, la verdad.<clear><br><$comeff(1,3)><$facial(1,4)><$motion(1,805)><$voicel(1,5)>Ah, ¿lo creaste tú? Pues seguro que muchos Pokémon<br>se pasarán por aquí.<clear><br><$emotion(1,38)><$voicel(1,9)>Si ves que algunos se pelean, deja que yo me encargue.<br><wait(0.4)><$comeff(1,21)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>¡Sembrar la paz es lo que mejor se me da!<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,9)>Espero que todos los Pokémon que vengan convivan<br>en paz y armonía."

#. en: <$emotion(1,14)><$voicel(1,10)><$pkcry;0(1,1)>! Nice to meetcha!<clear><br><$comeff(1,6)><$motion(1,666)><$voicel(1,5)>Sorry to spring this on ya, but do y’know if there’s a power<br>outlet somewhere nearby?<$emotion(1,38)><$voicel(1,8)> I gotta charge up a li’l!<clear><br><$emotion(1,14)><$voicel(1,7)>OH! ALSO! I am straight up STARVING! Let me know if<br>there’s anywhere to find some berries around here!<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,9)>I’m gonna be living here from now on, so you and I are<br>besties now!
msgctxt "3255:271"
msgid "<$emotion(1,14)><$voicel(1,10)>¡<$pkcry;0(1,1)>! ¡Qué pasa! ¡Un placer conocerte!<clear><br><$motion(1,666)><$voicel(1,5)>Una cosa... <$comeff(1,6)>¿Has visto algún enchufe por aquí cerca?<br><wait(0.4)><$emotion(1,38)><$voicel(1,8)>¡No me vendría mal algo de corriente!<clear><br><$emotion(1,14)><$voicel(1,7)>¡Ah! Y también estoy que me muero de hambre, así que<br>si conoces algún sitio donde pillar bayas, ¡dime dónde!<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,9)>He decidido mudarme aquí, ¡así que ya nos veremos!"
msgstr "<$emotion(1,14)><$voicel(1,10)>¡<$pkcry;0(1,1)>! ¡Qué tal! ¡Un placer conocerte!<clear><br><$motion(1,666)><$voicel(1,5)>Una cosa... <$comeff(1,6)>¿Viste algún enchufe por aquí cerca?<br><wait(0.4)><$emotion(1,38)><$voicel(1,8)>¡No me vendría mal algo de corriente!<clear><br><$emotion(1,14)><$voicel(1,7)>¡Ah! Y también estoy que me muero de hambre, así que<br>si conoces algún lugar con bayas, ¡dime dónde!<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,9)>Decidí mudarme aquí, ¡así que ya nos veremos!"

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,805)><$voicel(1,9)>Goo-meee! ♪ This place is nice ’n’ dark... <$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,6)>It could<br>be a little bit damper, though.<wait(1.0)><$motion(0,748)><wait(0.8)><clear><br><$comeff(1,5)><$facial(1,13)><$motion(1,803)><$voicel(1,10)>Goo?!<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Oh, thanks for using<$cdef(27)> <$sklfull(3)></color>, goo-mee goo! ♪<br>I got to meet you, it’s nice and damp now...<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,10)>Gosh, I’m starting to like it more ’n’ more here!
msgctxt "3255:272"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,805)><$voicel(1,9)>Goom... Este lugar tan oscurito está muy chupi...<br><$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,6)>Con un poquitín más de humedad, estaría perfe.<wait(1.0)><$motion(0,748)><wait(0.8)><clear><br><$comeff(1,5)><$facial(1,13)><$motion(1,803)><$voicel(1,10)>¡¿Goom?!<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Oh, ¿sabes usar <$cdef(27)><$sklfull(3)></color>? Muchas gracias...<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,10)>Cómo me alegro de haber conocido a alguien tan maj<gen;-2(o,a)>.<br>Este sitio cada vez me gusta más."
msgstr "<$comeff(1,9)><$facial(1,4)><$motion(1,805)><$voicel(1,9)>Goom... Este lugar tan oscurito está genial...<br><$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,6)>Con un poquitín más de humedad, estaría perfecto.<wait(1.0)><$motion(0,748)><wait(0.8)><clear><br><$comeff(1,5)><$facial(1,13)><$motion(1,803)><$voicel(1,10)>¡¿Goom?!<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Oh, ¿sabes usar <$cdef(27)><$sklfull(3)></color>? Muchas gracias...<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,10)>Cómo me alegro de conocer a alguien tan simpátic<gen;-2(o,a)>.<br>Este lugar cada vez me gusta más."

#. en: <$comeff(1,14)><$motion(1,805)><$voicel(1,6)>*sniff sniff*<clear><br><$emotion(1,14)><$voicel(1,8)>Oh! You’re a Pokémon! Nice to meet ya!<clear><br><$emotion(1,38)><$voicel(1,9)>But I gotta say...you don’t SMELL like your average<br>Pokémon!<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>It’s like...a berry smell? Or even a leafy smell? It’s like all<br>sorts of smells are all mixed together...<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,9)>*GRUUUUUMBLE!* Oooh, it’s making me hungry...
msgctxt "3255:273"
msgid "<$comeff(1,14)><$motion(1,805)><$voicel(1,6)>Snif, snif...<clear><br><$emotion(1,14)><$voicel(1,8)>¡Anda, un Pokémon! ¡Encantad<gen;-3(ooo,aaa)>!<clear><br><$emotion(1,38)><$voicel(1,9)>Oye, sin ofender, pero hueles un poco raro, ¿no?<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>Tienes como olor a bayas, pero también... a hojas<br>y a un montón de cosas más ahí entremezcladas...<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,9)>Grrr... <wait(0.5)>Aaay... Cómo me ruge la tripa... ¡Mira lo que has<br>conseguido! ¡Ahora tengo hambre!"
msgstr "<$comeff(1,14)><$motion(1,805)><$voicel(1,6)>Snif, snif...<clear><br><$emotion(1,14)><$voicel(1,8)>¡Mira, un Pokémon! ¡Encantad<gen;-3(ooo,aaa)>!<clear><br><$emotion(1,38)><$voicel(1,9)>Oye, sin ofender, pero hueles un poco raro, ¿no?<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>Tienes como olor a bayas, pero también... a hojas<br>y a un montón de cosas más ahí entremezcladas...<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,9)>Grrr... <wait(0.5)>Aaay... Cómo me ruge la panza... ¡Mira lo que<br>conseguiste! ¡Ahora tengo hambre!"

#. en: <$emotion(1,8)><$voicel(1,9)>Oh my goodness gracious me—hello there! I’m so happy<br>we’ve met!<clear><br><$emotion(1,14)><$voicel(1,7)>Oh no, I’ve gone and gotten overexcited again—hence<br>all the slime. <$comeff(1,10)><$motion(1,806)><$voicel(1,9)>Do be careful—it’s quite sticky!<clear><br><$emotion(1,14)><$voicel(1,7)>Now then, why don’t we celebrate our meeting here...<br><$emotion(1,8)><$voicel(1,10)>with a friendly hug?!
msgctxt "3255:274"
msgid "<$emotion(1,8)><$voicel(1,9)>¡Oy, oy, oy! ¡Es un placer conocerte, criaturilla!<clear><br><$emotion(1,14)><$voicel(1,7)>Discúlpame, me he emocionado tanto que lo estoy<br>poniendo todo perdido...<clear><br><$comeff(1,10)><$motion(1,806)><$voicel(1,9)>Ten cuidado, ¿quieres? Mis fluidos son muy pegajosos.<clear><br><$emotion(1,14)><$voicel(1,7)>¡Ah! ¿Qué tal si celebramos el habernos conocido hoy...<br><wait(0.4)><$emotion(1,8)><$voicel(1,10)>con un buen achuchón?"
msgstr "<$emotion(1,8)><$voicel(1,9)>¡Oy, oy, oy! ¡Es un placer conocerte, criaturita!<clear><br><$emotion(1,14)><$voicel(1,7)>Discúlpame, me emocioné tanto que lo estoy<br>ensuciando todo...<clear><br><$comeff(1,10)><$motion(1,806)><$voicel(1,9)>Ten cuidado, ¿quieres? Mis fluidos son muy pegajosos.<clear><br><$emotion(1,14)><$voicel(1,7)>¡Ah! ¿Qué tal si celebramos el habernos conocido hoy...<br><wait(0.4)><$emotion(1,8)><$voicel(1,10)>con un buen abrazo?"

#. en: <$emotion(1,14)><$voicel(1,7)>Hey there. Pretty nice place you’ve got here. <clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>You made all this, huh? Guess I should do something to<br>thank you... <$emotion(1,29)><$voicel(1,7)>Do you like berries?<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,5)>I’m a pretty big foodie, so I can scout out some nice, ripe<br>ones for you, if you’d like. <$emotion(1,38)><$voicel(1,10)>It’ll be great, trust me.
msgctxt "3255:275"
msgid "<$emotion(1,14)><$voicel(1,7)>Hola. Está guapo este sitio, ¿eh?<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>¿Que lo has creado tú? Vaya, quién lo habría dicho...<br>¿Qué te puedo dar a cambio?...<clear><br><$emotion(1,29)><$voicel(1,7)>Hmm, ¿te gustan las bayas?<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,5)>Aquí donde me ves, tengo muy buen ojo para la comida,<br>así que te traeré alguna que esté en su punto justo.<slide><br><$emotion(1,38)><$voicel(1,10)>Ya verás, vas a flipar."
msgstr "<$emotion(1,14)><$voicel(1,7)>Hola. Está bonito este lugar, ¿eh?<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>¿Que lo creaste tú? Vaya, quién lo habría dicho...<br>¿Qué te puedo dar a cambio?...<clear><br><$emotion(1,29)><$voicel(1,7)>Hmm, ¿te gustan las bayas?<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,5)>Aquí donde me ves, tengo muy buen ojo para la comida,<br>así que te traeré alguna que esté en su punto justo.<slide><br><$emotion(1,38)><$voicel(1,10)>Ya verás, vas a alucinar."

#. en: <$emotion(1,14)><$voicel(1,9)>Hmmm? HMMM?! I smell ’em!<clear><br><$comeff(1,14)><$motion(1,805)><$voicel(1,7)>I smell the lingerin’ scent of berries on ya!<clear><br><$comeff(1,5)><$motion(1,806)><$voicel(1,9)>You’re a berry-huntin’ PRO, aren’tcha, bud?<clear><br><$emotion(1,38)><$voicel(1,7)>OK! Let’s make a deal! I’ll lend you a hand with whatever<br>you need. In return, all I ask is that you share some of<slide><br>your berries with me from time to time!
msgctxt "3255:276"
msgid "<$emotion(1,14)><$voicel(1,9)>Vern... Jo, jo... Ese olor... ¡es inconfundible!<br><$comeff(1,14)><$motion(1,805)><$voicel(1,7)>¡Echas un tufillo a baya que alimenta!<clear><br><$comeff(1,5)><$motion(1,806)><$voicel(1,9)>No serás un<gen;-2(o,a)> de es<gen;-2(o,a)>s expert<gen;-2(o,a)>s buscador<gen;-2(e,a)>s de bayas<br>de l<gen;-2(o,a)>s que tanto he oído hablar, ¿no?<clear><br><$emotion(1,38)><$voicel(1,7)>¡Pues mira tú qué bien! ¿Y si llegamos a un acuerdo?<clear><br>Yo te ayudo en lo que quieras y tú a cambio me das una<br>bayita o dos de tanto en cuanto. ¿Hay trato, camarada?"
msgstr "<$emotion(1,14)><$voicel(1,9)>Vern... Jo, jo... Ese olor... ¡es inconfundible!<br><$comeff(1,14)><$motion(1,805)><$voicel(1,7)>¡Desprendes un tufillo a bayas tremendo!<clear><br><$comeff(1,5)><$motion(1,806)><$voicel(1,9)>No serás un<gen;-2(o,a)> de es<gen;-2(o,a)>s expert<gen;-2(o,a)>s buscador<gen;-2(e,a)>s de bayas<br>de l<gen;-2(o,a)>s que tanto he oído hablar, ¿no?<clear><br><$emotion(1,38)><$voicel(1,7)>¡Pues mira tú qué bien! ¿Y si llegamos a un acuerdo?<clear><br>Yo te ayudo en lo que quieras y tú a cambio me das una<br>bayita o dos de vez en cuando. ¿Hay trato, camarada?"

#. en: <$comeff(1,14)><$motion(1,806)><$voicel(1,9)>First we look right... Then we look left... And now we<br>look baaack! <$motion(1,805)><$voicel(1,8)>Next, we look forwa—<clear><br><$emotion(1,14)><$voicel(1,6)>... ... ...<br>Oh geez, there’s a stranger here.<clear><br><$comeff(1,6)><$motion(1,666)><$voicel(1,7)>Ummm... Uhhh... N-nice to meetcha, I guess?<clear><br><$emotion(1,38)><$voicel(1,10)>S-see ya around!
msgctxt "3255:277"
msgid "<$comeff(1,14)><$motion(1,806)><$voicel(1,9)>¿Derecha? Despejado. ¿Izquierda? Despejado. ¿Detrás?<br>Despejado. <$motion(1,805)><$voicel(1,8)>¿Delante?...<clear><br><$emotion(1,14)><$voicel(1,6)>Ah. U-un Pokémon desconocido... <wait(0.4)><$motion(1,666)>Esto... Eh...<br>E-encantad<gen;-3(o,a)>, <$comeff(1,6)><$voicel(1,7)>¿supongo?...<clear><br><$emotion(1,38)><$voicel(1,10)>N-nos vemos."
msgstr ""

#. en: <$comeff(1,14)><$motion(1,807)><$voicel(1,6)>*rustle rustle* *flap*<clear><br><$emotion(1,29)><$voicel(1,7)>Hm? Who are—wait, hold on a second.<clear><br><$comeff(1,14)><$motion(1,807)><$voicel(1,6)>*rustle rustle* *preen* *flap*<br>...<wait(0.6)><$comcan(1)><$motion(1,803)>There we go.<clear><br><$comeff(1,9)><$motion(1,805)><$voicel(1,7)>Needed to make myself presentable first. Now then—<wait(0.7)><$emotion(1,38)><$voicel(1,10)>hello<br>there. It’s nice to meet you.
msgctxt "3255:278"
msgid "<$comeff(1,14)><$motion(1,807)><$voicel(1,6)>Trix, trix...<clear><br><$emotion(1,29)><$voicel(1,7)>¿Eh? ¿Y tú quién eres? Ah, un segundo.<clear><br><$comeff(1,14)><$motion(1,807)><$voicel(1,6)>Trix, trix, trix, trix... <wait(0.9)><$comcan(1)><$motion(1,803)>Ahora sí, mucho mejor así.<clear><br><$comeff(1,9)><$motion(1,805)><$voicel(1,7)>No podía presentarme con las plumas todas<br>desacicaladas... <wait(0.6)><$emotion(1,38)><$voicel(1,10)>En fin, encantad<gen;-3(o,a)> de conocerte."
msgstr ""

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Yes? Can I...help you with something? You can’t fool me,<br>you know.<clear><br><$emotion(1,14)><$voicel(1,8)>I’ve already seen through your ruse! You’re a despicable<br>human who’s out to get me!<clear><br><$comeff(1,5)><$motionoff(1,804)><$voicel(1,9)>Wh-what?! You’re a Pokémon?<clear><br><$comeff(1,14)><$motion(1,806)><$voicel(1,5)>In that case... Ahem! I-I see...<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Seeing as you’ve been so honest, I guess you’re not so<br>despicable after all. Maybe we can be friends.
msgctxt "3255:279"
msgid "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Hmm... ¿Sí? ¿Qué te trae por aquí? Tienes pinta de<br>tramar algo...<clear><br><$emotion(1,14)><$voicel(1,8)>¡¿No serás uno de esos viles humanos que andan tras de<br>mí?!<clear><br><$comeff(1,5)><$motionoff(1,804)><$voicel(1,9)>¡¿C-cómo dices?! ¿Que eres un Pokémon? <wait(0.8)><$comeff(1,14)><$motion(1,806)><$voicel(1,5)>Ya veo, pues...<br>¡Ejem! Está bien...<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Supongo que no eres tan vil como suponía, puesto que<br>te has sincerado conmigo. Es un placer conocerte."
msgstr "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Hmm... ¿Sí? ¿Qué te trae por aquí? Tienes cara de<br>tramar algo...<clear><br><$emotion(1,14)><$voicel(1,8)>¡¿No serás uno de esos viles humanos que andan tras de<br>mí?!<clear><br><$comeff(1,5)><$motionoff(1,804)><$voicel(1,9)>¡¿C-cómo dices?! ¿Que eres un Pokémon? <wait(0.8)><$comeff(1,14)><$motion(1,806)><$voicel(1,5)>Ya veo, pues...<br>¡Ejem! Está bien...<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Supongo que no eres tan vil como suponía, puesto que<br>te sinceraste conmigo. Es un placer conocerte."

#. en: <$emotion(1,64)><$voicel(1,2)>Grbiii... I don’t know this place...<clear><br><$emotion(1,14)><$voicel(1,8)>Oh! Hi there, nice to meet you! <$voicel(1,3)><$emotion(1,31)>I just popped outta the<br>dirt, so I’m really not sure where I am or what’s going on...<clear><br><$voicel(1,7)><$comeff(1,21)><$facial(1,2)><$motion(1,806)>But you seem real nice! <$voicel(1,10)><$emotion(1,8)>I hope we can be friends!
msgctxt "3255:280"
msgid "<$emotion(1,64)><$voicel(1,2)>Vaya, este lugar no me resulta familiar... <wait(1.0)><$emotion(1,14)><$voicel(1,8)>Anda, hola,<br>encantad<gen;-3(o,a)>.<clear><br><$voicel(1,3)><$emotion(1,31)>Acabo de salir del suelo, así que no sé muy bien dónde<br>me encuentro ahora mismo.<clear><br><$voicel(1,7)><$comeff(1,21)><$facial(1,2)><$motion(1,806)>De todas formas, pareces muy buena gente,<$voicel(1,10)><$emotion(1,8)> así que si<br>quieres que seamos amigos, ¡genial!"
msgstr "<$emotion(1,64)><$voicel(1,2)>Vaya, este lugar no me resulta familiar... <wait(1.0)><$emotion(1,14)><$voicel(1,8)>Oh, hola,<br>encantad<gen;-3(o,a)>.<clear><br><$voicel(1,3)><$emotion(1,31)>Acabo de salir del suelo, así que no sé muy bien dónde<br>me encuentro ahora mismo.<clear><br><$voicel(1,7)><$comeff(1,21)><$facial(1,2)><$motion(1,806)>De todas formas, pareces muy buena gente,<$voicel(1,10)><$emotion(1,8)> así que si<br>quieres que seamos amigos, ¡genial!"

#. en: <$voicel(1,3)><$motion(1,803)><$facial(1,7)><$comeff(1,5)>Hey! Who’re you? You wanna fight?! Come on, yo, just try<br>and hit me!<clear><br><$voicel(1,7)><$motionoff(1,804)><$comeff(1,10)>My hard shell’s tougher than any you’ve ever seen!<br>Bring it!<clear><br><$voicel(1,6)><$motion(1,806)><$comeff(1,14)><$facial(1,1)>... ... ...<br><wait(0.8)><$motion(1,805)><$comeff(1,6)><$voicel(1,2)>You scared yet?<clear><br><$voicel(1,3)><$motion(1,817)><$comeff(1,10)>Well...uh...I also have a ZAP attack I can hit ya with. It’s<br>kinda like my trump card, y’know?<clear><br><$motion(0,41)><wait(1.2)><$voicel(1,7)><$emotion(1,8)>Huh? You don’t wanna fight? Phew... That’s a relief!<br>I actually just wanna be friends, yo!
msgctxt "3255:281"
msgid "<$voicel(1,3)><$motion(1,803)><$facial(1,7)><$comeff(1,5)>Eh, ¿y tú quién eres? ¿Vienes buscando drama o qué?<clear><br><$voicel(1,7)><$motionoff(1,804)><$comeff(1,10)>Mi caparazón lo aguanta todo. ¡A ver si tienes narices<br>de hacerme nada!<clear><br><$voicel(1,6)><$motion(1,806)><$comeff(1,14)><$facial(1,1)>... <wait(0.8)><$motion(1,805)><$comeff(1,6)><$voicel(1,2)>Al final te has rajado, ¿eh? ¡Normal!<clear><br><$voicel(1,3)><$motion(1,817)><$comeff(1,10)>¡No me mires así, que todavía estoy a tiempo de dejarte<br>ties<gen;-2(o,a)> de una descarga!<clear><br><$motion(0,41)><wait(1.2)><$voicel(1,7)><$emotion(1,8)>Oh, así que no vienes buscando pelea... ¡Menos mal!<clear><br>En cuanto te he visto he pensado: \"Tiene pinta de ser<br>maj<gen;-2(o,a)>. ¡Ojalá podamos ser colegas!\"."
msgstr "<$voicel(1,3)><$motion(1,803)><$facial(1,7)><$comeff(1,5)>Eh, ¿y tú quién eres? ¿Vienes buscando drama o qué?<clear><br><$voicel(1,7)><$motionoff(1,804)><$comeff(1,10)>Mi caparazón lo aguanta todo. ¡A ver si te atreves<br>a hacerme algo!<clear><br><$voicel(1,6)><$motion(1,806)><$comeff(1,14)><$facial(1,1)>... <wait(0.8)><$motion(1,805)><$comeff(1,6)><$voicel(1,2)>Al final te acobardaste, ¿eh? ¡Lógico!<clear><br><$voicel(1,3)><$motion(1,817)><$comeff(1,10)>¡No me mires así, que todavía estoy a tiempo de dejarte<br>ties<gen;-2(o,a)> de una descarga!<clear><br><$motion(0,41)><wait(1.2)><$voicel(1,7)><$emotion(1,8)>Oh, así que no vienes buscando pelea... ¡Menos mal!<clear><br>En cuanto te vi pensé: \"Se ve que es<br>simpátic<gen;-2(o,a)>. ¡Ojalá podamos ser amigos!\"."

#. en: <$emotion(1,29)><$voicel(1,7)>Huh? Who’re you? You lookin’ to fight me?!<clear><br><$comeff(1,14)><$motion(1,807)><$voicel(1,5)>Ya probably don’t wanna do that. See, I’d pick ya right up<br>in these jaws of mine...<$comeff(1,5)><$motionoff(1,804)><$voicel(1,10)>and give ya a BIG ZAP!<clear><br><$comeff(1,14)><$motion(1,805)><$voicel(1,6)>... ... ...<br>No reaction? None?<clear><br><$emotion(1,38)><$voicel(1,9)>I gotcha shocked before I could shock ya, huh?<br>Bwahahahaaa!
msgctxt "3255:282"
msgid "<$emotion(1,29)><$voicel(1,7)>¿Y tú quién eres, niñ<gen;-2(o,a)>? ¿Es que buscas pelea?<clear><br><$comeff(1,14)><$motion(1,807)><$voicel(1,5)>¡Yo que tú me iría por patas ahora mismo! Como te pille<br>con estas mandibulacas, te pegaré tal descarga que...<slide><br><$comeff(1,5)><$motionoff(1,804)><$voicel(1,10)>¡te dejaré ties<gen;-2(o,a)>!<clear><br><$comeff(1,14)><$motion(1,805)><$voicel(1,6)>... No dices nada, ¿eh?<clear><br><$emotion(1,38)><$voicel(1,9)>¡Je! ¿Ties<gen;-2(o,a)> del miedo incluso antes de verme en acción?<br>¡Mua, ja, ja, ja, ja!"
msgstr "<$emotion(1,29)><$voicel(1,7)>¿Y tú quién eres, niñ<gen;-2(o,a)>? ¿Es que buscas pelea?<clear><br><$comeff(1,14)><$motion(1,807)><$voicel(1,5)>¡Yo que tú saldría corriendo ahora mismo! Si te atrapo<br>con estas mandibulacas, te pegaré tal descarga que...<slide><br><$comeff(1,5)><$motionoff(1,804)><$voicel(1,10)>¡te dejaré ties<gen;-2(o,a)>!<clear><br><$comeff(1,14)><$motion(1,805)><$voicel(1,6)>... No dices nada, ¿eh?<clear><br><$emotion(1,38)><$voicel(1,9)>¡Je! ¿Ties<gen;-2(o,a)> del miedo incluso antes de verme en acción?<br>¡Mua, ja, ja, ja, ja!"

#. en: <$voicel(1,7)><$comeff(1,3)><$motion(1,803)><$facial(1,4)>Hi! Nice to meet you! Don’t worry, I’m not scary at all!<br><$voicel(1,10)><$comeff(1,10)><$motion(1,817)>See? I’m just an adorable <$cdef(27)>Pikachu</color>!<clear><br>... ... ...<br><$voicel(1,3)><$comeff(1,6)><$motion(1,805)><$facial(1,1)>H-hold on... Y-you haven’t seen through my disguise<slide><br>already, have you?<wait(1.0)><$motion(0,40)><wait(0.8)><clear><br><$voicel(1,1)><$comeff(1,4)><$motion(1,807)><$facial(1,9)>Awww, I guess you have... I-I’m sorry I lied to you.<$voicel(1,8)><$comeff(1,14)><$motion(1,805)> I just<br>wanted to be friends...<$voicel(1,10)><$comeff(1,21)><$motion(1,801)><$facial(1,4)> Do...do you think we could<slide><br>maybe play together...?
msgctxt "3255:283"
msgid "<$voicel(1,7)><$comeff(1,3)><$motion(1,803)><$facial(1,4)>¡Hola! ¡Es un placer! ¿Eh? ¿C-cómo que doy miedo?<br><$voicel(1,10)><$comeff(1,10)><$motion(1,817)>¿No me ves? ¡Si soy un <$cdef(27)>Pikachu</color>! Soy suuuperadorable...<clear><br><$voicel(1,3)><$comeff(1,6)><$motion(1,805)><$facial(1,1)>¿E-eh?... Supongo que has descubierto el pastel...<wait(1.0)><$motion(0,40)><wait(0.8)><clear><br><$voicel(1,1)><$comeff(1,4)><$motion(1,807)><$facial(1,9)>Vaya... ¿Tanto se me nota? Siento haberte mentido...<clear><br><$voicel(1,8)><$comeff(1,14)><$motion(1,805)>Es tan solo que yo... yo... Me gustaría hacer amigos...<clear><br><$voicel(1,10)><$comeff(1,21)><$motion(1,801)><$facial(1,4)>S-si no te importa, me gustaría... que nos conociésemos<br>mejor."
msgstr "<$voicel(1,7)><$comeff(1,3)><$motion(1,803)><$facial(1,4)>¡Hola! ¡Es un placer! ¿Eh? ¿C-cómo que doy miedo?<br><$voicel(1,10)><$comeff(1,10)><$motion(1,817)>¿No me ves? ¡Si soy un <$cdef(27)>Pikachu</color>! Soy suuuperadorable...<clear><br><$voicel(1,3)><$comeff(1,6)><$motion(1,805)><$facial(1,1)>¿E-eh?... Supongo que descubriste el pastel...<wait(1.0)><$motion(0,40)><wait(0.8)><clear><br><$voicel(1,1)><$comeff(1,4)><$motion(1,807)><$facial(1,9)>Vaya... ¿Tanto se me nota? Siento haberte mentido...<clear><br><$voicel(1,8)><$comeff(1,14)><$motion(1,805)>Es tan solo que yo... yo... Me gustaría hacer amigos...<clear><br><$voicel(1,10)><$comeff(1,21)><$motion(1,801)><$facial(1,4)>S-si no te importa, me gustaría... que nos conociéramos<br>mejor."

#. en: <$comeff(1,16)><$facial(1,14)><$voicel(1,9)>*yawn*... <wait(0.8)><$facial(1,1)><$comeff(1,3)><$motion(1,803)>Oh, hi there. Nice to meet you! Sorry, I just woke<br>up, and...<$emotion(1,38)><$voicel(1,8)>that means it’s time for a jog!<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>Looks like there’s space for me to take a breather too, so<br>I might as well get going.<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,8)>Scor scor. ♪ ...Oh! <$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,8)>I should be careful<$comeff(1,5)><$facial(1,1)><$motion(1,803)><$voicel(1,9)> not to burn this<br>place down by accident!
msgctxt "3255:284"
msgid "<$comeff(1,16)><$facial(1,14)><$voicel(1,9)>Uaaah...<wait(0.8)><$facial(1,1)><$comeff(1,3)><$motion(1,803)> Oh, encantad<gen;-3(o,a)> de conocerte. Estaba echándome<br>una siestecilla, y qué mejor para despertar del todo que...<slide><br><$emotion(1,38)><$voicel(1,8)>¡pegarse una buena carrerilla!<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>Aquí hay espacio de sobra para descansar, pero también<br>para correr. ¡Hora de calentar las patas!<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,8)>♪¡Un, dos!♪<clear><br><$comeff(1,5)><$facial(1,1)><$motion(1,803)><$voicel(1,9)>Lo malo es que... como me descuide, puede que acabe<br>prendiéndole fuego a todo...<clear><br><$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,8)>¡Prometo que tendré cuidado!"
msgstr "<$comeff(1,16)><$facial(1,14)><$voicel(1,9)>Uaaah...<wait(0.8)><$facial(1,1)><$comeff(1,3)><$motion(1,803)> Oh, encantad<gen;-3(o,a)> de conocerte. Estaba echándome<br>una siestita, y qué mejor para despertar del todo que...<slide><br><$emotion(1,38)><$voicel(1,8)>¡darse una buena carrerita!<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>Aquí hay espacio de sobra para descansar, pero también<br>para correr. ¡Hora de calentar las patas!<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,8)>♪¡Un, dos!♪<clear><br><$comeff(1,5)><$facial(1,1)><$motion(1,803)><$voicel(1,9)>Lo malo es que... si me descuido, puede que acabe<br>prendiéndole fuego a todo...<clear><br><$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,8)>¡Prometo que tendré cuidado!"

#. en: <$motion(1,815)><$voicel(1,10)>Ra-BOOM!<clear><br><$emotion(1,14)><$voicel(1,5)>Oh, sorry—did I startle you? I was just doing my regular<br>kick drills.<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,7)>But I’m a little hungry now, so maybe I’ll head out to find<br>a tree that’s got some berries in it.<clear><br><$emotion(1,38)><$voicel(1,9)>I’ll show you the fruits of my training by kicking every last<br>berry out of that tree.
msgctxt "3255:285"
msgid "<$motion(1,815)><$voicel(1,10)>¡Toma esa!<clear><br><$emotion(1,14)><$voicel(1,5)>Ostras, perdón, ¿te he asustado? Estaba practicando<br>mi juego de pies.<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,7)>De tanto ejercicio me está dando mucha hambre. Va<br>tocando buscar algo para picotear por ahí.<clear><br><$emotion(1,38)><$voicel(1,9)>Usaré los movimientos que he estado practicando contra<br>los árboles para hacer caer todas las bayas que vea."
msgstr "<$motion(1,815)><$voicel(1,10)>¡Toma esa!<clear><br><$emotion(1,14)><$voicel(1,5)>Cielos, perdón, ¿te asusté? Estaba practicando<br>mi juego de pies.<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,7)>De tanto ejercicio me está dando mucha hambre. Iré<br>a buscar algo para comer por ahí.<clear><br><$emotion(1,38)><$voicel(1,9)>Usaré los movimientos que he estado practicando contra<br>los árboles para hacer caer todas las bayas que vea."

#. en: <$comeff(1,1)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Hey, heyyy! Nice to meet ya! Nice scenery we got around<br>here, huh? <$emotion(1,29)><$facial(1,1)><$voicel(1,6)>You here for the scenery too?<clear><br><$comeff(1,3)><$motion(1,805)><$voicel(1,9)>Whoa! Seriously?! You’re the one who got this place up<br>and runnin’? You’re a real nice Pokémon, aren’t you?<slide><br><$comeff(1,9)><$motion(1,806)><$voicel(1,8)>All right! You’ve got yourself a new fan, bud!<clear><br><$emotion(1,38)><$voicel(1,9)>I love cheerin’ on as a fan just as much as I love BEING<br>cheered on by my fans!
msgctxt "3255:286"
msgid "<$comeff(1,1)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>¡Buenas! No nos conocemos, ¿no? Este paisaje es bonito<br>a rabiar. <wait(0.4)><$emotion(1,29)><$facial(1,1)><$voicel(1,6)>¿Tú también has venido a admirarlo?<clear><br><$comeff(1,3)><$motion(1,805)><$voicel(1,9)>¿Qué dices? ¿Que te lo has currado tú? ¡Vaya trabajazo!<br><wait(0.4)><$comeff(1,9)><$motion(1,806)><$voicel(1,8)>¡Te mereces un aplauso de los buenos!<clear><br><$emotion(1,38)><$voicel(1,9)>Me encanta recibir vítores del público, así que entiendo<br>perfectamente lo bien que sienta que alguien te alabe."
msgstr "<$comeff(1,1)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>¡Buenas! No nos conocemos, ¿no? Este paisaje es bonito<br>a más no poder. <wait(0.4)><$emotion(1,29)><$facial(1,1)><$voicel(1,6)>¿Tú también viniste a admirarlo?<clear><br><$comeff(1,3)><$motion(1,805)><$voicel(1,9)>¿Qué dices? ¿Que lo hiciste tú? ¡Vaya trabajazo!<br><wait(0.4)><$comeff(1,9)><$motion(1,806)><$voicel(1,8)>¡Te mereces un aplauso de los buenos!<clear><br><$emotion(1,38)><$voicel(1,9)>Me encanta recibir vítores del público, así que entiendo<br>perfectamente lo bien que se siente que alguien te alabe."

#. en: <$motion(1,17)><$voicel(1,5)>Hrrr’re yrrr? Rrrgh...srrr-ry...<wait(0.4)> <$motion(1,19)>*gulp!*<clear><br><$emotion(1,14)><$voicel(1,7)>Nice to meet ya. And sorry it took me a second to say<br>hi—<$emotion(1,38)><$voicel(1,5)>my cheeks were full of berries.<clear><br><$comeff(1,21)><$facial(1,4)><$motion(1,806)><$voicel(1,9)>Doing that lets me enjoy yummy berries muuuch longer!<br>You can copy me too—if you want! ♪
msgctxt "3255:287"
msgid "<$motion(1,17)><$voicel(1,5)>¿Y dú fién eref?... Afff... Ferdona... <wait(0.4)><$motion(1,19)>¡Glup!<clear><br><$emotion(1,14)><$voicel(1,7)>Encantad<gen;-3(o,a)>. P-perdona, sé que es de mala educación<br>hablar con la boca llena... <wait(0.4)><$emotion(1,38)><$voicel(1,5)>y la tenía a rebosar de bayas.<clear><br><$comeff(1,21)><$facial(1,4)><$motion(1,806)><$voicel(1,9)>Es que así las puedo saborear durante mucho rato...<br>Deberías probarlo tú también."
msgstr ""

#. en: <$comeff(1,5)><$facial(1,13)><$motionoff(1,804)><$voicel(1,9)>Uwagh?! Who are YOU? You better not be a meanie, or<br>I’m gonna chase you away!<clear><br><$comeff(1,14)><$motion(1,805)><$voicel(1,5)>Hmmm... Cute, round eyes... Kinda spacy too... They<br>don’t LOOK like meanie eyes...<clear><br><$emotion(1,37)><$voicel(1,7)>Well, I guess you’re prolly OK. Forget what I said a<br>second ago! <$emotion(1,8)><$voicel(1,10)>Let’s be friends!
msgctxt "3255:288"
msgid "<$comeff(1,5)><$facial(1,13)><$motionoff(1,804)><$voicel(1,9)>¡KIII! ¿Y tú quién eres, si se puede saber? ¡Como tengas<br>malas intenciones, tendrás que vértelas conmigo!<clear><br><$comeff(1,14)><$motion(1,805)><$voicel(1,5)><$cdef(9)>(Hmm... La verdad es que tiene unos ojos muy redonditos<br>y graciosos...).</color><clear><br><$emotion(1,37)><$voicel(1,7)>Bueno, supongo que no tienes cara de depredado<gen;-2(r,ra)>.<br>Olvida las amenazas de antes, ¿eh? <wait(0.4)><$emotion(1,8)><$voicel(1,10)>¡Encantad<gen;-3(o,a)>!"
msgstr "<$comeff(1,5)><$facial(1,13)><$motionoff(1,804)><$voicel(1,9)>¡KIII! ¿Y tú quién eres, si se puede saber? ¡Si tienes<br>malas intenciones, tendrás que vértelas conmigo!<clear><br><$comeff(1,14)><$motion(1,805)><$voicel(1,5)><$cdef(9)>(Hmm... La verdad es que tiene unos ojos muy redonditos<br>y graciosos...).</color><clear><br><$emotion(1,37)><$voicel(1,7)>Bueno, supongo que no tienes cara de depredado<gen;-2(r,ra)>.<br>Olvida las amenazas de antes, ¿eh? <wait(0.4)><$emotion(1,8)><$voicel(1,10)>¡Encantad<gen;-3(o,a)>!"

#. en: <$emotion(1,14)><$voicel(1,5)>Hey, nice to meet you. You see all these human tools<br>around here? <$emotion(1,8)><$voicel(1,8)>Pretty interesting lineup, huh?<clear><br><$comeff(1,6)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>I wonder what they were put here for.<clear><br><$emotion(1,14)><$voicel(1,7)>Oh, I see—you placed them here. Well, let me say this:<br>I like your style.<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>See, I’m also particular about how I use my tools. <$emotion(1,38)><$voicel(1,10)>If there’s<br>ever anything I can help with, just say the word.
msgctxt "3255:289"
msgid "<$emotion(1,14)><$voicel(1,5)>Oh, buenas. Estos artefactos humanos me han llamado<br>la atención.<clear><br><$emotion(1,8)><$voicel(1,8)>Siempre me han parecido tela de interesantes las cosas<br>que fabricaban.<clear><br><$comeff(1,6)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>Lo que no me explico es cómo han venido a parar aquí...<clear><br><$emotion(1,14)><$voicel(1,7)>Oh, ya veo, así que es cosa tuya. Se ve que compartimos<br>el amor por estos chismes.<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Soy <gen;-3(un,una)> crack con estas cosas, así que si necesitas ayuda<br>en algún momento con una movida de estas, ya sabes...<slide><br><$emotion(1,38)><$voicel(1,10)>Yo te echo un ala encantad<gen;-3(o,a)>."
msgstr "<$emotion(1,14)><$voicel(1,5)>Oh, buenas. Estos artefactos humanos me llamaron<br>la atención.<clear><br><$emotion(1,8)><$voicel(1,8)>Siempre me parecieron superinteresantes las cosas<br>que fabricaban.<clear><br><$comeff(1,6)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>Lo que no me explico es cómo vinieron a parar aquí...<clear><br><$emotion(1,14)><$voicel(1,7)>Oh, ya veo, así que es cosa tuya. Se ve que compartimos<br>el amor por estos aparatos.<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Soy <gen;-3(un,una)> crack con estas cosas, así que si necesitas ayuda<br>en algún momento con algún aparato de estos, ya sabes...<slide><br><$emotion(1,38)><$voicel(1,10)>Yo te echo un ala encantad<gen;-3(o,a)>."

#. en: <$emotion(1,14)><$voicel(1,8)>Well now, I haven’t seen anyone who looks like you in<br>a very long time. How nostalgic.<clear><br><$comeff(1,14)><$motion(1,805)><$voicel(1,5)>I used to give humans rides as I flew, but now I’ve no<br>idea where they all are. <$comeff(1,7)><$facial(1,9)><$motion(1,802)><$voicel(1,4)>Now that they’re gone, I quite<slide><br>miss them.<clear><br><$comeff(1,3)><$facial(1,1)><$motion(1,803)><$voicel(1,7)>Oh, you’ve actually been searching for humans? In that<br>case, I’d like to assist.<clear><br><$emotion(1,8)><$voicel(1,9)>I hope someday I’ll fly with humans once more.
msgctxt "3255:290"
msgid "<$emotion(1,14)><$voicel(1,8)>¿Qué ven mis ojos? Esa apariencia tuya me resulta tan<br>familiar... Ah, me inundan los recuerdos.<clear><br><$comeff(1,14)><$motion(1,805)><$voicel(1,5)>Verás, yo antaño me dedicaba a transportar a los humanos<br>de aquí para allá surcando los cielos... pero hace tanto ya<slide><br>que no veo a ninguno...<clear><br><$comeff(1,7)><$facial(1,9)><$motion(1,802)><$voicel(1,4)>Me entristece sobremanera pensar en su desaparición...<clear><br><$comeff(1,3)><$facial(1,1)><$motion(1,803)><$voicel(1,7)>Ya veo, de modo que estás investigando el paradero de<br>los humanos... En ese caso, haré cuanto esté en mi ala<slide><br>con tal de apoyar tu causa.<clear><br><$emotion(1,8)><$voicel(1,9)>Espero que llegue el día en el que pueda volver a recorrer<br>el firmamento junto a ellos."
msgstr ""

#. en: <$motion(1,807)><$voicel(1,10)>*rumble rumble* *grumble grumble*<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Huh? Are you...food? Yooo! My food just walked right up<br>to me!<clear><br><$comeff(1,10)><$facial(1,1)><$motionoff(1,804)><$voicel(1,10)>Heck yeah! Time to eat!<wait(1.0)><$motion(0,748)><wait(0.8)><clear><br><$comeff(1,5)><$motion(1,803)><$voicel(1,8)>ACK! That’s COLD, yo!<clear><br><$comeff(1,6)><$motion(1,666)><$voicel(1,5)>Oh, uh... You’re not, uh—you’re not food, are you?<clear><br><$emotion(1,38)><$voicel(1,9)>My bad!!! Really sorry about that. Hey, why don’t we be<br>friends, though?
msgctxt "3255:291"
msgid "<$motion(1,807)><$voicel(1,10)>Ay, estoy esmay<gen;-3(ao,á)>...<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>... ¿Y esto? ¿Comida a domicilio... de gratis?<br>¡No sé de dónde habrá salido, pero tanto da!<clear><br><$comeff(1,10)><$facial(1,1)><$motionoff(1,804)><$voicel(1,10)>¡Pa'l buche!<wait(1.0)><$motion(0,748)><wait(0.8)><clear><br><$comeff(1,5)><$motion(1,803)><$voicel(1,8)>¡Paraaa, qué fríooo!<clear><br><$comeff(1,6)><$motion(1,666)><$voicel(1,5)>¿Qué pasa? ¿Es que no eres papeo?<clear><br><$emotion(1,38)><$voicel(1,9)>Lo siento, tí<gen;-2(o,a)>. Literal que no me he dado cuenta, ¿eh?<br>¡No me odies, porfa!"
msgstr "<$motion(1,807)><$voicel(1,10)>Ay, estoy desmay<gen;-3(ao,á)> de hambre...<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>... ¿Y esto? ¿Comida a domicilio... de gratis?<br>¡No sé de dónde habrá salido, pero qué más da!<clear><br><$comeff(1,10)><$facial(1,1)><$motionoff(1,804)><$voicel(1,10)>¡Pa'l buche!<wait(1.0)><$motion(0,748)><wait(0.8)><clear><br><$comeff(1,5)><$motion(1,803)><$voicel(1,8)>¡Paraaa, qué fríooo!<clear><br><$comeff(1,6)><$motion(1,666)><$voicel(1,5)>¿Qué pasa? ¿Es que no eres comida?<clear><br><$emotion(1,38)><$voicel(1,9)>Lo siento, amig<gen;-2(o,a)>. Literal que no me di cuenta, ¿eh?<br>¡No me odies, porfa!"

#. en: <$emotion(1,14)><$voicel(1,6)>Oh, um... Hi.<clear><br><$comeff(1,21)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>I only just got here, so...I’d be really thankful if you could<br>fill me in on what’s going on and stuff...<clear><br><$emotion(1,14)><$voicel(1,5)>Don’t worry, I’ll share something important with you in<br>exchange. <$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,7)>See, if you touch me, you might get zapped<slide><br>real good. Like, with electricity.<$emotion(1,38)><$voicel(1,6)> Just be careful, OK?
msgctxt "3255:292"
msgid "<$emotion(1,14)><$voicel(1,6)>Eh... H-hola...<clear><br><$comeff(1,21)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>Acabo de llegar aquí, así que si me pones al corriente<br>de todo... te lo agradecería.<clear><br><$emotion(1,14)><$voicel(1,5)>A cambio, te daré un consejo para que no acabes mal...<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,7)>Procura no tocarme a no ser que quieras llevarte un buen<br>calambrazo o acabar envenenad<gen;-2(o,a)>...<clear><br><$emotion(1,38)><$voicel(1,6)>Te aviso de que duele bastante, así que cuidadito, porfa."
msgstr ""

#. en: <$motion(1,644)><$comeff(1,9)>*pluck pluck* *THUMMM* <wait(1.0)><$motion(1,803)><$voicel(1,5)>Hmmm, excellent. Sounding<br>rather good today. <wait(0.5)><$comeff(1,3)><$lookat(1,0,0)>...Oh?<clear><br><$lookat(1,1,0)><waitactor(1)><$voicel(1,3)><$motion(1,806)><$comeff(1,6)>Who are you exactly? If you’re here to fight, I’d rather we<br>just get it over with. <$voicel(1,6)><$motion(1,807)><$comeff(1,17)>I still have quite a lot to do today.<clear><br><$comeff(1,14)>... ... ...<br><wait(0.8)><$voicel(1,8)><$emotion(1,14)>Huh. Not even a blink, eh? You don’t scare easily. <$voicel(1,10)><$motion(1,805)><$facial(1,4)><$comeff(1,10)>I think<slide><br>I like you.<clear><br><$voicel(1,8)><$motion(1,645)><$comeff(1,9)>I look forward to getting to know you.
msgctxt "3255:293"
msgid "<$motion(1,644)><$comeff(1,9)>♪¡Tox, tox, cityyy!♪<br><wait(1.0)><$motion(1,803)><$voicel(1,5)>Hm... No ha ido nada mal la sesión. <wait(0.5)><$comeff(1,3)><$lookat(1,0,0)>¿Hm?<clear><br><$lookat(1,1,0)><waitactor(1)><$voicel(1,3)><$motion(1,806)><$comeff(1,6)>¿Quién eres? Si quieres luchar, te ruego que terminemos<br>cuanto antes. <wait(0.4)><$voicel(1,6)><$motion(1,807)><$comeff(1,17)>Tengo la agenda de lo más apretada hoy...<clear><br><$comeff(1,14)>... <wait(0.8)><$voicel(1,8)><$emotion(1,14)>Vaya... Ni te inmutas, ¿eh? <$voicel(1,10)><$motion(1,805)><$facial(1,4)><$comeff(1,10)>Me has caído en gracia.<br><$voicel(1,8)><$motion(1,645)><$comeff(1,9)>Es un placer."
msgstr "<$motion(1,644)><$comeff(1,9)>♪¡Tox, tox, cityyy!♪<br><wait(1.0)><$motion(1,803)><$voicel(1,5)>Hm... No estuvo nada mal la sesión. <wait(0.5)><$comeff(1,3)><$lookat(1,0,0)>¿Hm?<clear><br><$lookat(1,1,0)><waitactor(1)><$voicel(1,3)><$motion(1,806)><$comeff(1,6)>¿Quién eres? Si quieres luchar, te ruego que terminemos<br>cuanto antes. <wait(0.4)><$voicel(1,6)><$motion(1,807)><$comeff(1,17)>Tengo la agenda de lo más apretada hoy...<clear><br><$comeff(1,14)>... <wait(0.8)><$voicel(1,8)><$emotion(1,14)>Vaya... Ni te inmutas, ¿eh? <$voicel(1,10)><$motion(1,805)><$facial(1,4)><$comeff(1,10)>Me caíste en gracia.<br><$voicel(1,8)><$motion(1,645)><$comeff(1,9)>Es un placer."

#. en: <$voicel(1,4)><$motion(1,803)><$facial(1,7)><$comeff(1,22)>What’re you starin’ at?!<clear><br><$voicel(1,7)><$motion(1,805)>You lookin’ for a shock to your system, bud?<br><wait(0.8)><$motion(1,644)><$comeff(1,9)>*TWAAAANG!*<clear><br>... ... ...<wait(0.5)>Hm?<br><$voicel(1,5)><$emotion(1,14)>That dazed look on your face... <$voicel(1,8)><$motion(1,645)><$facial(1,4)><$comeff(1,21)>My sound TOTALLY blew<slide><br>your mind, didn’t it?!<clear><br><$voicel(1,9)><$motion(1,806)><$comeff(1,10)>Haha! You’ve got good taste, bud! Y’know what? Feel free<br>to come chat with me anytime! <$voicel(1,8)><$motion(1,644)><$comeff(1,9)>I’ll hit you with my killer<slide><br>sounds whenever ya like!
msgctxt "3255:294"
msgid "<$voicel(1,4)><$motion(1,803)><$facial(1,7)><$comeff(1,22)>¿Se te ha perdido algo aquí, renacuaj<gen;-2(o,a)>?<clear><br><$voicel(1,7)><$motion(1,805)>¿Quieres que te haga temblar? <wait(0.8)><$motion(1,644)><$comeff(1,9)>¡¡TOOOX!!<clear><br>... <wait(0.5)><$voicel(1,5)><$emotion(1,14)>¿Y bien?<clear><br><$voicel(1,8)><$motion(1,645)><$facial(1,4)><$comeff(1,21)>¡Por tu gesto embobado diría que te ha molao el show!<clear><br><$voicel(1,9)><$motion(1,806)><$comeff(1,10)>¡Je, je! ¡Tienes buen gusto pa la música! Ven a ver cómo<br>me marco unos arpegios cuando tú quieras.<clear><br><$voicel(1,8)><$motion(1,644)><$comeff(1,9)>¡Haré que tus oídos lloren de la alegría!"
msgstr "<$voicel(1,4)><$motion(1,803)><$facial(1,7)><$comeff(1,22)>¿Se te perdió algo aquí, renacuaj<gen;-2(o,a)>?<clear><br><$voicel(1,7)><$motion(1,805)>¿Quieres que te haga temblar? <wait(0.8)><$motion(1,644)><$comeff(1,9)>¡¡TOOOX!!<clear><br>... <wait(0.5)><$voicel(1,5)><$emotion(1,14)>¿Y bien?<clear><br><$voicel(1,8)><$motion(1,645)><$facial(1,4)><$comeff(1,21)>¡Por tu gesto embobado diría que te encantó el show!<clear><br><$voicel(1,9)><$motion(1,806)><$comeff(1,10)>¡Je, je! ¡Tienes buen gusto pa la música! Ven a ver cómo<br>toco unos arpegios cuando tú quieras.<clear><br><$voicel(1,8)><$motion(1,644)><$comeff(1,9)>¡Haré que tus oídos lloren de la alegría!"

#. en: <$motion(1,814)><$voicel(1,6)>...*poke*<clear><br><$motion(1,815)><$voicel(1,8)>... ... ...*poke poke*<clear><br><$emotion(1,37)><$voicel(1,9)>Huh... Your body feels so weird. It’s so...squishy! <$comeff(1,21)><$facial(1,4)><$motion(1,806)><$voicel(1,8)>Hehehe,<br>you’re fun to poke! I don’t wanna stop!<clear><br><$emotion(1,8)><$voicel(1,9)>Maybe I’ll poke you again sometime! Hehe!
msgctxt "3255:295"
msgid "<$motion(1,814)><$voicel(1,6)>¡Dreep!<clear><br><$motion(1,815)><$voicel(1,8)>¡Dreedreep!<clear><br><$emotion(1,37)><$voicel(1,9)>¡Guau, qué blanditooo! Tienes un tacto rarísimo.<clear><br><$comeff(1,21)><$facial(1,4)><$motion(1,806)><$voicel(1,8)>Jolín, ha sido muy díver darte toquecitos. <wait(0.4)><$emotion(1,8)><$voicel(1,9)>¡Que no te<br>extrañe si vuelvo a por más!"
msgstr "<$motion(1,814)><$voicel(1,6)>¡Dreep!<clear><br><$motion(1,815)><$voicel(1,8)>¡Dreedreep!<clear><br><$emotion(1,37)><$voicel(1,9)>¡Guau, qué blanditooo! Tienes un tacto rarísimo.<clear><br><$comeff(1,21)><$facial(1,4)><$motion(1,806)><$voicel(1,8)>Vaya, fue muy divertido darte toquecitos. <wait(0.4)><$emotion(1,8)><$voicel(1,9)>¡Que no te<br>extrañe si vuelvo por más!"

#. en: <$voicel(1,7)><$motion(1,805)><$facial(1,4)><$comeff(1,10)>Yooo! This area’s pretty sweet!<clear><br><$voicel(1,5)><$emotion(1,39)>There’s no dangerous stuff, so I bet even my li’l guy can<br>play without a care in the world!<clear><br><$voicel(1,7)><$comeff(1,3)><$motion(1,803)><$facial(1,1)>Who’s the “li’l guy”? Yo, it’s this <$cdef(27)>Dreepy</color> on my head, yo!<br><$voicel(1,10)><$motion(1,806)><$facial(1,4)><$comeff(1,8)>They’re all tiny and cute, right?<clear><br><$voicel(1,7)><$emotion(1,8)>I hope you and I and this li’l guy can all get along!
msgctxt "3255:296"
msgid "<$voicel(1,7)><$motion(1,805)><$facial(1,4)><$comeff(1,10)>Este sitio es muy top, ¿eh?<clear><br><$voicel(1,5)><$emotion(1,39)>No parece haber nada chungo por aquí, así que puedo<br>dejar que el peque juguetee mientras yo estoy de chill.<clear><br><$voicel(1,7)><$comeff(1,3)><$motion(1,803)><$facial(1,1)>Ah, me refería a este <$cdef(27)>Dreepy</color> que llevo en la cabeza.<br><$voicel(1,10)><$motion(1,806)><$facial(1,4)><$comeff(1,8)>Es un pequeñín muy adorable, ¿no crees?<clear><br><$voicel(1,7)><$emotion(1,8)>Nada, ¡es un placer! ¡De mi parte y de la del peque!"
msgstr "<$voicel(1,7)><$motion(1,805)><$facial(1,4)><$comeff(1,10)>Este lugar está genial, ¿eh?<clear><br><$voicel(1,5)><$emotion(1,39)>No parece haber nada peligroso por aquí, así que puedo<br>dejar que el pequeño juguetee mientras me relajo.<clear><br><$voicel(1,7)><$comeff(1,3)><$motion(1,803)><$facial(1,1)>Ah, me refería a este <$cdef(27)>Dreepy</color> que llevo en la cabeza.<br><$voicel(1,10)><$motion(1,806)><$facial(1,4)><$comeff(1,8)>Es un pequeñín muy adorable, ¿no crees?<clear><br><$voicel(1,7)><$emotion(1,8)>Nada, ¡es un placer! ¡De mi parte y de la del pequeño!"

#. en: <$voicel(1,8)><$comeff(1,10)><$motion(1,801)><$facial(1,4)>Gwahaha! Ya found me!<clear><br><$voicel(1,5)><$comeff(1,9)><$motionoff(1,804)>Pretty impressive that you were able to sense I was here,<br>I tell ya what!<clear><br><$voicel(1,7)><$comeff(1,20)><$motion(1,803)>All righty, I think ya deserve a prize! <$cdef(27)>Dreepy </color>love it—and<br>I bet you will too! <$voicel(1,10)><$comeff(1,10)><$motion(1,806)>You get...a ride in my horns!<clear><br><$voicel(1,7)><$motion(1,807)><$comeff(1,3)><$facial(1,1)>Or, well...hm... On second glance, ya might jus’ be a bit<br>too big fer that!<clear><br><$voicel(1,10)><$comeff(1,10)><$facial(1,4)><$motion(1,801)>Gwahahahahaaa!
msgctxt "3255:297"
msgid "<$voicel(1,8)><$comeff(1,10)><$motion(1,801)><$facial(1,4)>¡Bua, ja, ja! Me has encontrado.<clear><br><$voicel(1,5)><$comeff(1,9)><$motionoff(1,804)>¡Que hayas logrado seguirme la pista dice mucho de ti,<br>jovenzuel<gen;-2(o,a)>!<clear><br><$voicel(1,7)><$motion(1,803)>Creo que te has ganado una buena recompensa...<br><wait(0.5)><$comeff(1,20)>¡Ya sé!<clear><br><$voicel(1,10)><$comeff(1,10)><$motion(1,806)>Te llevaré a dar una vueltecita metid<gen;-2(o,a)> en mis cuernos.<br>¡A los <$cdef(27)>Dreepy</color> los vuelve locos!<clear><br><$voicel(1,7)><$motion(1,807)><$comeff(1,3)><$facial(1,1)>Uy, me parece que he hablado antes de la cuenta...<clear><br><$voicel(1,10)><$comeff(1,10)><$facial(1,4)><$motion(1,801)>Mirándote bien, ¡creo que no vas a caber dentro!<br>¡Bua, ja, ja!"
msgstr "<$voicel(1,8)><$comeff(1,10)><$motion(1,801)><$facial(1,4)>¡Bua, ja, ja! Me encontraste.<clear><br><$voicel(1,5)><$comeff(1,9)><$motionoff(1,804)>¡Que hayas logrado seguirme la pista dice mucho de ti,<br>jovenzuel<gen;-2(o,a)>!<clear><br><$voicel(1,7)><$motion(1,803)>Creo que te ganaste una buena recompensa...<br><wait(0.5)><$comeff(1,20)>¡Ya sé!<clear><br><$voicel(1,10)><$comeff(1,10)><$motion(1,806)>Te llevaré a dar una vueltita metid<gen;-2(o,a)> en mis cuernos.<br>¡A los <$cdef(27)>Dreepy</color> los vuelve locos!<clear><br><$voicel(1,7)><$motion(1,807)><$comeff(1,3)><$facial(1,1)>Uy, me parece que hablé antes de la cuenta...<clear><br><$voicel(1,10)><$comeff(1,10)><$facial(1,4)><$motion(1,801)>Mirándote bien, ¡creo que no vas a caber dentro!<br>¡Bua, ja, ja!"

#. en: <$voicel(1,7)><$motion(1,805)><$comeff(1,3)>Sprrr! ♪ Who are you? Did you find me by following<br>my scent?<$motion(0,41)><wait(0.8)><clear><br><$motion(1,803)><$facial(1,4)><$comeff(1,21)><$voicel(1,5)>Huh? You didn’t? But...but you do think it’s a nice scent,<br>right? It’s pretty and sweet, right?<clear><br><$voicel(1,9)><$emotion(1,6)>You can come see me again if you want! I’ll share this nice<br>scent with you anytime!
msgctxt "3255:298"
msgid "<$voicel(1,7)><$motion(1,805)><$comeff(1,3)>♪¡Sprrr!♪ ¿Quién eres? ¿Otra víctima que ha caído presa<br>de mi irresistible aroma?<$motion(0,41)><wait(0.8)><clear><br><$motion(1,803)><$facial(1,4)><$comeff(1,21)><$voicel(1,5)>¿Q-que no? Pero ¿no te parece que es un olor muy<br>dulce y agradable?<clear><br><$voicel(1,9)><$emotion(1,6)>¡Que sepas que puedes venir a verme cuando quieras!<br>Estaré encantad<gen;-3(o,a)> de compartir mi aroma contigo."
msgstr ""

#. en: <$voicel(1,10)><$motionoff(1,804)><$comeff(1,10)><$textsize(2)>FLRRR!!!</textsize><wait(0.5)><$motion(0,82)><$comeff(0,5)><clear><br><$voicel(1,7)><$motion(1,801)><$facial(1,5)><$comeff(1,9)>AHAHA! Did I scare ya? Operation mischief: HUGE<br>success!<clear><br><$voicel(1,5)><$motion(1,807)><$facial(1,4)><$comeff(1,1)>Sorry, sorry, I just wanted to start our friendship off with<br>a bang!<clear><br><$voicel(1,9)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>I’m gonna live here now, so be sure and say hi if you see<br>me around!<clear><br><$voicel(1,8)><$motion(1,805)><$facial(1,4)><$comeff(1,9)>Cause if you DON’T see me...mischief just might<br>strike twice! ♪
msgctxt "3255:299"
msgid "<$voicel(1,10)><$motionoff(1,804)><$comeff(1,10)><$textsize(2)>¡¡FLORRR!!</textsize><wait(0.5)><$motion(0,82)><$comeff(0,5)><clear><br><$voicel(1,7)><$motion(1,801)><$facial(1,5)><$comeff(1,9)>¡Jaaa, ja, ja! ¡Deberías verte la cara! ¡Menudo susto te<br>has llevado!<clear><br><$voicel(1,5)><$motion(1,807)><$facial(1,4)><$comeff(1,1)>Perdona, perdona. ¡Quería que te llevaras una primera<br>impresión memorable en vez de presentarme así sin más!<clear><br><$voicel(1,9)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>He decidido venirme a vivir aquí, ¡así que no dudes en<br>saludar cuando me veas!<clear><br><$voicel(1,8)><$motion(1,805)><$facial(1,4)><$comeff(1,9)>O si no... <wait(0.4)>♪¡tendré que darte otro susto!♪"
msgstr "<$voicel(1,10)><$motionoff(1,804)><$comeff(1,10)><$textsize(2)>¡¡FLORRR!!</textsize><wait(0.5)><$motion(0,82)><$comeff(0,5)><clear><br><$voicel(1,7)><$motion(1,801)><$facial(1,5)><$comeff(1,9)>¡Jaaa, ja, ja! ¡Deberías verte la cara! ¡Qué susto te<br>llevaste!<clear><br><$voicel(1,5)><$motion(1,807)><$facial(1,4)><$comeff(1,1)>Perdona, perdona. ¡Quería que te llevaras una primera<br>impresión memorable en vez de presentarme así sin más!<clear><br><$voicel(1,9)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Decidí venirme a vivir aquí, ¡así que no dudes en<br>saludar cuando me veas!<clear><br><$voicel(1,8)><$motion(1,805)><$facial(1,4)><$comeff(1,9)>O si no... <wait(0.4)>♪¡tendré que darte otro susto!♪"

#. en: <$voicel(1,5)><$motion(1,805)><$comeff(1,10)>Your attention, please! Allow me to dazzle you with my<br>next demonstration!<clear><br><$voicel(1,7)><$motionoff(1,804)>Take a good look at this plain, ordinary bud.<br><$motion(1,644)>Three...<wait(0.7)>two...<wait(0.6)><$voicel(1,10)>one...<clear><br><$voicel(1,9)><$motion(1,807)><$facial(1,4)><$comeff(1,21)>Ta-da! In an instant, it blossomed into a lovely flower! ♪<clear><br><$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,8)>Thank you for watching. Wasn’t that preferable to a<br>humdrum introduction?<clear><br><$voicel(1,10)><$motion(1,803)><$comeff(1,9)>Just one of the dazzling displays you can look forward to!
msgctxt "3255:300"
msgid "<$voicel(1,5)><$motion(1,805)><$comeff(1,10)>¡Atención, <gen;-2(gentil caballero,gentil dama)>, pues estás a punto de ser<br>testigo de algo verdaderamente asombroso!<clear><br><$voicel(1,7)><$motionoff(1,804)>Tengo aquí un brote ordinario, nada fuera de lo común.<br>Sin embargo, cuando hago esto...<wait(1.0)><$motion(1,644)> Tres... <wait(0.7)>dos... <wait(0.6)><$voicel(1,10)>uno...<clear><br><$voicel(1,9)><$motion(1,807)><$facial(1,4)><$comeff(1,21)>¡Bum! ♪¡De él brota una bella flor!♪<clear><br><$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,8)>¡Gracias por tu atención! Espero haber causado una buena<br>primera impresión.<clear><br><$voicel(1,10)><$motion(1,803)><$comeff(1,9)>Encantad<gen;-3(o,a)> de conocerte."
msgstr ""

#. en: <$voicel(1,8)><$comeff(1,3)><$motion(1,803)>AHH! It’s a stranger!<clear><br><$voicel(1,7)><$motion(1,805)><$comeff(1,9)>OK, Pawmi, at times like this you just gotta show ’em<br>your special move...<clear><br><$voicel(1,5)><$facial(1,7)><$motion(1,817)><$comeff(1,14)>Um, so first I’m s’posta rub my cheeks... Mi mii...Mi...<clear><br><$voicel(1,8)><$facial(1,7)><$motion(1,859)><$comeff(1,10)>M...MI... MIII!!!<clear><br><$voicel(1,9)><$facial(1,4)><$motionoff(1,804)><$comeff(1,21)>Phew! Lookit, look! This is awesome! I made electricity for<br>the first time in a while! Hehe...
msgctxt "3255:301"
msgid "<$voicel(1,8)><$comeff(1,3)><$motion(1,803)>¡Aaah! ¿Q-quién anda ahí? <$voicel(1,7)><$motion(1,805)><$comeff(1,9)>¡Tengo un movimiento especial<br>y no dudaré en usarlo!<clear><br><$voicel(1,5)><$facial(1,7)><$motion(1,817)><$comeff(1,14)><$cdef(9)>(C-calma... En momentos como este, debo frotarme las<br>mejillas, así, así...).</color><clear><br>Paw, paw... <$voicel(1,8)><$facial(1,7)><$motion(1,859)><$comeff(1,10)>¡Paaawmiii!<clear><br><$voicel(1,9)><$facial(1,4)><$motionoff(1,804)><$comeff(1,21)>¡Haaala, qué guay! He conseguido que salgan chispitas.<br><wait(0.6)>Uy, a todo esto... ¿Para qué quería generar electricidad?"
msgstr "<$voicel(1,8)><$comeff(1,3)><$motion(1,803)>¡Aaah! ¿Q-quién anda ahí? <$voicel(1,7)><$motion(1,805)><$comeff(1,9)>¡Tengo un movimiento especial<br>y no dudaré en usarlo!<clear><br><$voicel(1,5)><$facial(1,7)><$motion(1,817)><$comeff(1,14)><$cdef(9)>(C-calma... En momentos como este, debo frotarme las<br>mejillas, así, así...).</color><clear><br>Paw, paw... <$voicel(1,8)><$facial(1,7)><$motion(1,859)><$comeff(1,10)>¡Paaawmiii!<clear><br><$voicel(1,9)><$facial(1,4)><$motionoff(1,804)><$comeff(1,21)>¡Guaaau, qué genial! Conseguí que salieran chispitas.<br><wait(0.6)>Uy, a todo esto... ¿Para qué quería generar electricidad?"

#. en: <$voicel(1,6)><$emotion(1,14)>Oh, hi! Nice to meetcha.<clear><br><$voicel(1,7)><$motion(1,806)><$comeff(1,10)>There are so many things around here I’ve never seen<br>before. It makes my walks really exciting! ♪<clear><br><$voicel(1,9)><$motion(1,801)><$facial(1,4)><$comeff(1,9)>It’s so fun wandering around unfamiliar places. It’s like,<br>uh...a mini adventure! <$voicel(1,8)><$motion(1,805)><$comeff(1,6)>Wanna join me sometime?
msgctxt "3255:302"
msgid "<$voicel(1,6)><$emotion(1,14)>Anda, hola, encantad<gen;-3(o,a)>.<clear><br><$voicel(1,7)><$motion(1,806)><$comeff(1,10)>Este lugar está repleeeto de cosas por descubrir.<br>Invita a darse un paseo para explorarlo, ¿no crees?<clear><br><$voicel(1,9)><$motion(1,801)><$facial(1,4)><$comeff(1,9)>Me encanta explorar lugares guiad<gen;-3(o,a)> por mis propios pasos<br>y descubrirlos a mi propio ritmo.<clear><br><$voicel(1,8)><$motion(1,805)><$comeff(1,6)>Si te ape acompañarme algún día, ¡ya sabes!"
msgstr "<$voicel(1,6)><$emotion(1,14)>Oh, hola, encantad<gen;-3(o,a)>.<clear><br><$voicel(1,7)><$motion(1,806)><$comeff(1,10)>Este lugar está repleeeto de cosas por descubrir.<br>Invita a darse un paseo para explorarlo, ¿no crees?<clear><br><$voicel(1,9)><$motion(1,801)><$facial(1,4)><$comeff(1,9)>Me encanta explorar lugares guiad<gen;-3(o,a)> por mis propios pasos<br>y descubrirlos a mi propio ritmo.<clear><br><$voicel(1,8)><$motion(1,805)><$comeff(1,6)>Si quieres acompañarme algún día, ¡ya sabes!"

#. en: <$voicel(1,5)><$emotion(1,14)>Heyyy. Nice to meet you... It’s suuuper peaceful around<br>here, isn’t it?<clear><br><$voicel(1,3)><$motion(1,805)><$comeff(1,14)>I saw a bunch of other places that were kiiinda sketchy...<br><$voicel(1,8)><$motion(1,801)><$facial(1,4)><$comeff(1,21)>but this place looks nice and saaafe—like nobody’s<slide><br>gonna get huuurt here.<clear><br><$voicel(1,5)><$motion(1,806)><$comeff(1,16)>Phewww. Feeling safe has me feeling kinda sleepyyy.<br><$voicel(1,4)><$facial(1,14)><$comeff(1,15)>Guess I’ll take it eeeaaasy for a bit in my new home...
msgctxt "3255:303"
msgid "<$voicel(1,5)><$emotion(1,14)>Hola, ¿qué tal? ¡Es un placer! Me gusta bastante este sitio,<br>se respira mucha paz.<clear><br><$voicel(1,3)><$motion(1,805)><$comeff(1,14)>Siento que en otros lugares sieeempre había algo que<br>me hacía sentirme asustad<gen;-3(o,a)> o en algún tipo de peligro,<slide><br><$voicel(1,8)><$motion(1,801)><$facial(1,4)><$comeff(1,21)>pero este sitio parece tan seguro que puedo relajarme.<clear><br><$voicel(1,5)><$motion(1,806)><$comeff(1,16)>Aaah... Qué alivio, de verdad, tanto que me está<br>entrando un sueñico...<clear><br><$voicel(1,4)><$facial(1,14)><$comeff(1,15)>Creo que voy a ponerme cómod<gen;-3(o,a)> en mi nuevo hogar."
msgstr "<$voicel(1,5)><$emotion(1,14)>Hola, ¿qué tal? ¡Es un placer! Me gusta bastante este lugar,<br>se respira mucha paz.<clear><br><$voicel(1,3)><$motion(1,805)><$comeff(1,14)>Siento que en otros lugares sieeempre había algo que<br>me hacía sentirme asustad<gen;-3(o,a)> o en algún tipo de peligro,<slide><br><$voicel(1,8)><$motion(1,801)><$facial(1,4)><$comeff(1,21)>pero este lugar parece tan seguro que puedo relajarme.<clear><br><$voicel(1,5)><$motion(1,806)><$comeff(1,16)>Aaah... Qué alivio, de verdad, tanto que me está<br>entrando un sueñito...<clear><br><$voicel(1,4)><$facial(1,14)><$comeff(1,15)>Creo que voy a ponerme cómod<gen;-3(o,a)> en mi nuevo hogar."

#. en: <$voicel(1,3)><$motion(1,803)><$facial(1,13)><$comeff(1,5)>Ruff?! Whew, what a surprise...<clear><br><$voicel(1,5)><$motion(1,807)><$comeff(1,4)>Oh, um, sorry about that! There are so many things around<br>here I’ve never seen before... <$voicel(1,8)><$motion(1,801)><$facial(1,4)><$comeff(1,10)>I was going for a walk and<slide><br>just got really into it all!<clear><br><$voicel(1,9)><$motionoff(1,804)><$facial(1,4)><$comeff(1,9)>I promise from now on I’ll look straight ahead when I’m walking!
msgctxt "3255:304"
msgid "<$voicel(1,3)><$motion(1,803)><$facial(1,13)><$comeff(1,5)>¡Ahí va! ¡Casi nos chocamos!<clear><br><$voicel(1,5)><$motion(1,807)><$comeff(1,4)>Ay, perdón. Estaba tan distraíd<gen;-3(o,a)> mirando a mi alrededor<br>que no te había visto.<clear><br><$voicel(1,8)><$motion(1,801)><$facial(1,4)><$comeff(1,10)>¡Hay muchas cosas chachis por aquí!<clear><br><$voicel(1,9)><$motionoff(1,804)><$facial(1,4)><$comeff(1,9)>Te prometo que miraré hacia el frente a partir de ahora.<br>¡Espero que podamos ser amiguis!"
msgstr "<$voicel(1,3)><$motion(1,803)><$facial(1,13)><$comeff(1,5)>¡Uy! ¡Casi nos chocamos!<clear><br><$voicel(1,5)><$motion(1,807)><$comeff(1,4)>Ay, perdón. Estaba tan distraíd<gen;-3(o,a)> mirando a mi alrededor<br>que no te había visto.<clear><br><$voicel(1,8)><$motion(1,801)><$facial(1,4)><$comeff(1,10)>¡Hay muchas cosas geniales por aquí!<clear><br><$voicel(1,9)><$motionoff(1,804)><$facial(1,4)><$comeff(1,9)>Te prometo que miraré hacia el frente a partir de ahora.<br>¡Espero que podamos ser amiguis!"

#. en: <$voicel(1,7)><$emotion(1,14)>Why hello, sweet child. Were you drawn in by my scent?<clear><br><$voicel(1,9)><$comeff(1,9)><$facial(1,4)><$motion(1,801)>I’ll have you know that my aroma is just one of my many<br>favorable qualities.<clear><br><$voicel(1,7)><$comeff(1,21)><$motionoff(1,804)>Have you admired the shine of this glistening body? Or<br>these lush, ruffle-able tufts of fur? <$voicel(1,6)><$motion(1,806)><$comeff(1,14)><$facial(1,1)>And of course...<clear><br><$voicel(1,3)><$motion(1,807)><$comeff(1,17)>Oh dear, I apologize for going on and on about myself.<br>I want to hear about you too, of course.
msgctxt "3255:305"
msgid "<$voicel(1,7)><$emotion(1,14)>Hola, ricura. Deja que lo adivine: vienes encandilad<gen;-2(o,a)> por<br>mi irresistible fragancia, ¿no es así?<clear><br><$voicel(1,9)><$comeff(1,9)><$facial(1,4)><$motion(1,801)>Si mi aroma te ha parecido delectable, espera a descubrir<br>mis otros encantos...<clear><br><$voicel(1,7)><$comeff(1,21)><$motionoff(1,804)>Como el elegante lustre de mi piel o la increíble suavidad<br>de mi pelaje...<clear><br><$voicel(1,6)><$motion(1,806)><$comeff(1,14)><$facial(1,1)>Por no hablar de... <wait(0.9)><$voicel(1,3)><$motion(1,807)><$comeff(1,17)>Ay, perdona, parece que no tengo<br>abuela. Cuando quieras, ven y cuéntame sobre ti."
msgstr "<$voicel(1,7)><$emotion(1,14)>Hola, ricura. Deja que lo adivine: vienes encandilad<gen;-2(o,a)> por<br>mi irresistible fragancia, ¿no es así?<clear><br><$voicel(1,9)><$comeff(1,9)><$facial(1,4)><$motion(1,801)>Si mi aroma te ha parecido delectable, espera a descubrir<br>mis otros encantos...<clear><br><$voicel(1,7)><$comeff(1,21)><$motionoff(1,804)>Como el elegante lustre de mi piel o la increíble suavidad<br>de mi pelaje...<clear><br><$voicel(1,6)><$motion(1,806)><$comeff(1,14)><$facial(1,1)>Por no hablar de... <wait(0.9)><$voicel(1,3)><$motion(1,807)><$comeff(1,17)>Ay, perdona, creo que ya me<br>alabé demasiado. Cuando quieras, ven y cuéntame sobre ti."

#. en: <$voicel(1,7)><$motion(1,817)><$facial(1,7)><$comeff(1,10)>Hup! Hup! Hyah! Haaa! HYAAAH!<clear><br><$voicel(1,10)><$motionoff(1,804)><$comeff(1,21)>Well? Whaddaya think about my move? Pretty cool, huh?<clear><br><$voicel(1,7)><$facial(1,4)><$motion(1,806)><$comeff(1,9)>I practice it real hard all the time so I’ll never lose!<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,805)><$facial(1,1)>As long as I keep my body moving, and let my feelings<br>burn within me, <$voicel(1,10)><$comeff(1,3)><$motion(1,801)><$facial(1,4)>I can beat anyone! Even if they’re huge!<clear><br><$voicel(1,4)><$motion(1,803)><$facial(1,1)><$comeff(1,10)>Uh...probably!
msgctxt "3255:306"
msgid "<$voicel(1,7)><$motion(1,817)><$facial(1,7)><$comeff(1,10)>¡Toma! ¡Cómete esa! ¡Char! ¡Ca! ¡DET!<clear><br><$voicel(1,10)><$motionoff(1,804)><$comeff(1,21)>¿Y bien? ¿Qué te ha parecido mi supermovimiento?<br>¿Lo mola o no lo mola todo?<clear><br><$voicel(1,7)><$facial(1,4)><$motion(1,806)><$comeff(1,9)>¡Estoy entrenando a fuego para no perder contra nadie!<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,805)><$facial(1,1)>Mientras no me detenga y mis sentimientos ardan con<br>furia...<clear><br><$voicel(1,10)><$comeff(1,3)><$motion(1,801)><$facial(1,4)>¡No perderé contra nadie! ¡Ni aunque me saque diez<br>cabezas!<clear><br><$voicel(1,4)><$motion(1,803)><$facial(1,1)><$comeff(1,10)>Bueno, ¡eso espero!"
msgstr "<$voicel(1,7)><$motion(1,817)><$facial(1,7)><$comeff(1,10)>¡Toma! ¡Cómete esa! ¡Char! ¡Ca! ¡DET!<clear><br><$voicel(1,10)><$motionoff(1,804)><$comeff(1,21)>¿Y bien? ¿Qué te pareció mi supermovimiento?<br>¿Es lo máximo o no?<clear><br><$voicel(1,7)><$facial(1,4)><$motion(1,806)><$comeff(1,9)>¡Estoy entrenando con todo para no perder contra nadie!<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,805)><$facial(1,1)>Mientras no me detenga y mis sentimientos ardan con<br>furia...<clear><br><$voicel(1,10)><$comeff(1,3)><$motion(1,801)><$facial(1,4)>¡No perderé contra nadie! ¡Ni aunque me saque diez<br>cabezas!<clear><br><$voicel(1,4)><$motion(1,803)><$facial(1,1)><$comeff(1,10)>Bueno, ¡eso espero!"

#. en: <$voicel(1,5)><$emotion(1,14)>Oh? Who are you? <wait(0.8)>Hm, you don’t seem to be here<br>to battle.<clear><br><$voicel(1,7)><$motion(1,805)><$comeff(1,10)>Don’t worry—I wouldn’t force anyone to fight me.<clear><br><$voicel(1,5)><$motion(1,806)><$comeff(1,14)>I prefer to battle opponents head-on, without malice.<clear><br><$voicel(1,10)><$motion(1,801)><$comeff(1,21)><$facial(1,4)>After all, I consider myself a proud and noble knight.
msgctxt "3255:307"
msgid "<$voicel(1,5)><$emotion(1,14)>Tú, identifícate. <wait(0.4)>Hmm... No parece que vengas con<br>intenciones de luchar.<clear><br><$voicel(1,7)><$motion(1,805)><$comeff(1,10)>Tranquil<gen;-2(o,a)>, no soy de l<gen;-3(o,a)>s que gastan su energía en peleas<br>inútiles. No voy a hacerte nada.<clear><br><$voicel(1,5)><$motion(1,806)><$comeff(1,14)>Soy trigo limpio. Jamás me batiría en duelo contra alguien<br>que no busca un enfrentamiento.<clear><br><$voicel(1,10)><$motion(1,801)><$comeff(1,21)><$facial(1,4)>Tienes mi palabra de guerrer<gen;-3(o,a)>."
msgstr ""

#. en: <$voicel(1,8)><$comeff(1,5)><$motion(1,803)>Huh?!<clear><br><$voicel(1,2)><$comeff(1,4)><$motion(1,802)>Y-you really surprised me...<clear><br><$voicel(1,6)><$motion(1,806)><$facial(1,4)><$comeff(1,3)>I guess... I guess you’re not here for a battle?<clear><br><$voicel(1,7)><$comeff(1,10)><$facial(1,4)><$motion(1,801)>Well um... I’m thinking about living here so uh...nice to<br>meet you, I guess.<clear><br><$voicel(1,5)><$facial(1,9)><$comeff(1,14)><$motion(1,807)>If you’re ever in the mood for a battle, I’m more than<br>happy to face you, but I should warn you...<clear><br><$voicel(1,7)><$motion(1,802)><$comeff(1,17)>I can’t hold back at all once I’m facing an opponent.
msgctxt "3255:308"
msgid "<$voicel(1,8)><$comeff(1,5)><$motion(1,803)>¡Ledge!<clear><br><$voicel(1,2)><$comeff(1,4)><$motion(1,802)>P-por poco me da un infarto.<clear><br><$voicel(1,6)><$motion(1,806)><$facial(1,4)><$comeff(1,3)>No vienes con intención de combatir, ¿no?<clear><br><$voicel(1,7)><$comeff(1,10)><$facial(1,4)><$motion(1,801)>Por cierto, he decidido mudarme aquí, así que... un placer.<clear><br><$voicel(1,5)><$facial(1,9)><$comeff(1,14)><$motion(1,807)>Aquí estaré si quieres enfrentarte a mí en algún momento,<br>aunque no lo recomiendo...<clear><br><$voicel(1,7)><$motion(1,802)><$comeff(1,17)>Cuando me enfrasco en un combate, no sé contenerme."
msgstr "<$voicel(1,8)><$comeff(1,5)><$motion(1,803)>¡Ledge!<clear><br><$voicel(1,2)><$comeff(1,4)><$motion(1,802)>P-por poco me da un infarto.<clear><br><$voicel(1,6)><$motion(1,806)><$facial(1,4)><$comeff(1,3)>No vienes con intención de combatir, ¿no?<clear><br><$voicel(1,7)><$comeff(1,10)><$facial(1,4)><$motion(1,801)>Por cierto, decidí mudarme aquí, así que... un placer.<clear><br><$voicel(1,5)><$facial(1,9)><$comeff(1,14)><$motion(1,807)>Aquí estaré si quieres enfrentarte a mí en algún momento,<br>aunque no lo recomiendo...<clear><br><$voicel(1,7)><$motion(1,802)><$comeff(1,17)>Cuando me enfrasco en un combate, no sé contenerme."

#. en: <$voicel(1,7)><$comeff(1,5)><$motion(1,803)>Eek! WHO are YOU?! Wait a sec... You’re not trying to<br>steal my hammer, are you?!<clear><br><$voicel(1,9)><$comeff(1,4)><$motion(1,807)><$facial(1,7)>Well, you can’t have it! This is MY hammer! I worked really<br>hard to make it! <$voicel(1,8)><$comeff(1,10)><$motion(1,802)>I’ll NEVER give it to you!<clear><br><$voicel(1,4)><$comeff(1,14)><$motion(1,806)><$facial(1,9)>... ... ...<br><wait(1.0)><$voicel(1,6)><$comeff(1,3)><$facial(1,1)><$motion(1,803)>Wait, what...?<clear><br><$voicel(1,3)><$comeff(1,6)><$motion(1,805)>You DIDN’T come to steal my hammer? <wait(0.7)>Awww, but it’s<br>so cool!
msgctxt "3255:309"
msgid "<$voicel(1,7)><$comeff(1,5)><$motion(1,803)>¡Tiiink! ¿Y tú quién eres? No habrás venido a quitarme<br>el martillo, ¿no?<clear><br><$voicel(1,9)><$comeff(1,4)><$motion(1,807)><$facial(1,7)>¡Ni hablaaar! ¡Este martillo es mío y de nadie más!<br>¡Que para algo lo fabriqué con mis propias manitas!<clear><br><$voicel(1,8)><$comeff(1,10)><$motion(1,802)>¡No te lo daré de ninguna manera!<clear><br><$voicel(1,4)><$comeff(1,14)><$motion(1,806)><$facial(1,9)>... <wait(1.0)><$voicel(1,6)><$comeff(1,3)><$facial(1,1)><$motion(1,803)>Espera...<clear><br><$voicel(1,3)><$comeff(1,6)><$motion(1,805)>¿Entonces no has venido a robarme mi querido martillo?<br>¡Jo, pero si mola un montón!"
msgstr "<$voicel(1,7)><$comeff(1,5)><$motion(1,803)>¡Tiiink! ¿Y tú quién eres? No habrás venido a quitarme<br>el martillo, ¿no?<clear><br><$voicel(1,9)><$comeff(1,4)><$motion(1,807)><$facial(1,7)>¡Ni hablaaar! ¡Este martillo es mío y de nadie más!<br>¡Que para algo lo fabriqué con mis propias manitas!<clear><br><$voicel(1,8)><$comeff(1,10)><$motion(1,802)>¡No te lo daré de ninguna manera!<clear><br><$voicel(1,4)><$comeff(1,14)><$motion(1,806)><$facial(1,9)>... <wait(1.0)><$voicel(1,6)><$comeff(1,3)><$facial(1,1)><$motion(1,803)>Espera...<clear><br><$voicel(1,3)><$comeff(1,6)><$motion(1,805)>¿Entonces no viniste a robarme mi querido martillo?<br>¡Ay, pero si es increíble!"

#. en: <$voicel(1,6)><$comeff(1,14)><$motion(1,805)>*staaaaare*...<clear><br><$voicel(1,4)><$motion(1,807)><$comeff(1,17)>Tch... C’mon now!<clear><br><$voicel(1,1)><$motion(1,802)><$comeff(1,7)>You’re all SOFT and SQUISHY, and I don’t think I like<br>it, PAL!<clear><br><$voicel(1,7)><$comeff(1,10)><$motion(1,806)><$facial(1,4)>I like my Pokémon sharper and TOUGHER!<clear><br><$motion(0,824)><$facial(1,1)>Huh? <wait(0.9)><$voicel(1,6)><$emotion(1,14)>You say you can probably get tougher?<$motion(0,652)><clear><br><$voicel(1,9)><$emotion(1,8)>OK! I’ll be waiting here till you TOUGHEN UP a little!
msgctxt "3255:310"
msgid "<$voicel(1,6)><$comeff(1,14)><$motion(1,805)>Hmm... <wait(0.6)><$voicel(1,4)><$motion(1,807)><$comeff(1,17)>No, lo siento pero no.<clear><br><$voicel(1,1)><$motion(1,802)><$comeff(1,7)>Te veo demasiado blandengue para serme útil...<br><$voicel(1,7)><$comeff(1,10)><$motion(1,806)><$facial(1,4)>¡Yo solo me junto con los Pokémon más duros!<clear><br><$motion(0,824)><$facial(1,1)>...<wait(0.9)><$voicel(1,6)><$emotion(1,14)> ¿Dices que... intentarás volverte más dur<gen;-2(o,a)>?<$motion(0,652)><clear><br><$voicel(1,9)><$emotion(1,8)>Está bieeen, te concederé una segunda oportunidad.<br>¡Pero no me hagas esperar mucho!"
msgstr ""

#. en: <$voicel(1,10)><$motionoff(1,804)><$comeff(1,10)><$textsize(2)>Whoa. Hey. Whoa.</textsize><clear><br><$voicel(1,7)><$motion(1,662)><$comeff(1,22)><$textsize(2)>I am cute. It is the truth. But you<br>should not touch me.</textsize><clear><br><$voicel(1,6)><$motion(1,803)><$comeff(1,3)>I am sorry for the sudden yelling.<clear><br><$voicel(1,3)><$motion(1,805)><$facial(1,9)><$comeff(1,4)>There are sometimes Pokémon who get poisoned badly by<br>me. <$voicel(1,6)><$motion(1,807)><$comeff(1,10)>So I warn all.<clear><br><$voicel(1,4)><$motion(1,663)><$comeff(1,17)>Being cute. It is not all good things.
msgctxt "3255:311"
msgid "<$voicel(1,10)><$motionoff(1,804)><$comeff(1,10)><$textsize(2)>¡Alto! ¡No debes tocarme!</textsize><clear><br><$voicel(1,7)><$motion(1,662)><$comeff(1,22)><$textsize(2)>¡Poseo gran belleza, pero no se toca!</textsize><clear><br><$voicel(1,6)><$motion(1,803)><$comeff(1,3)>Ah. Disculpas por mis gritos repentinos.<clear><br><$voicel(1,3)><$motion(1,805)><$facial(1,9)><$comeff(1,4)>Hubo quien se envenenó al entrar en contacto conmigo.<clear><br><$voicel(1,6)><$motion(1,807)><$comeff(1,10)>Ahora trato siempre de evitar desgracias.<clear><br><$voicel(1,4)><$motion(1,663)><$comeff(1,17)>Ains. Ser tan bonit<gen;-3(o,a)> es un trabajo difícil."
msgstr "<$voicel(1,10)><$motionoff(1,804)><$comeff(1,10)><$textsize(2)>¡Alto! ¡No debes tocarme!</textsize><clear><br><$voicel(1,7)><$motion(1,662)><$comeff(1,22)><$textsize(2)>¡Poseo gran belleza, pero no se toca!</textsize><clear><br><$voicel(1,6)><$motion(1,803)><$comeff(1,3)>Ah. Disculpas por mis gritos repentinos.<clear><br><$voicel(1,3)><$motion(1,805)><$facial(1,9)><$comeff(1,4)>Hubo quien se envenenó al entrar en contacto conmigo.<clear><br><$voicel(1,6)><$motion(1,807)><$comeff(1,10)>Ahora trato siempre de evitar desgracias.<clear><br><$voicel(1,4)><$motion(1,663)><$comeff(1,17)>Ay. Ser tan bonit<gen;-3(o,a)> es un trabajo difícil."

#. en: <$voicel(1,5)><$motion(1,805)><$comeff(1,14)>Hm. You do not appear to be here for the purpose of<br>disturbing my territory.<slide><br><$voicel(1,10)><$motionoff(1,804)><$comeff(1,9)><$facial(1,4)>That is good. I am happy. ♪<clear><br><$voicel(1,7)><$comeff(1,21)><$motion(1,801)>I have decided. I will live here from today. Let us<br>be friends.<slide><br><$voicel(1,6)><$emotion(1,14)><$facial(1,1)>But use caution when getting close to me.<clear><br><$voicel(1,7)><$motion(1,807)><$comeff(1,10)>My body chips with the slightest provocation. It spreads<br>poison. This is dangerous.
msgctxt "3255:312"
msgid "<$voicel(1,5)><$motion(1,805)><$comeff(1,14)>Um. Hola. Este es mi territorio. ¿Tienes intenciones<br>hostiles?<clear><br><$voicel(1,10)><$motionoff(1,804)><$comeff(1,9)><$facial(1,4)>♪Bien. Bien.♪<clear><br><$voicel(1,7)><$comeff(1,21)><$motion(1,801)>He decidido vivir aquí a partir de hoy. Es un placer.<clear><br><$voicel(1,6)><$emotion(1,14)><$facial(1,1)>Ah. Eso sí. No te acerques a mí sin avisar. Es peligroso.<clear><br><$voicel(1,7)><$motion(1,807)><$comeff(1,10)>Mi cuerpo es muy frágil. Cuando me veo amenazad<gen;-3(o,a)>,<br>esparzo veneno por todos lados."
msgstr "<$voicel(1,5)><$motion(1,805)><$comeff(1,14)>Um. Hola. Este es mi territorio. ¿Tienes intenciones<br>hostiles?<clear><br><$voicel(1,10)><$motionoff(1,804)><$comeff(1,9)><$facial(1,4)>♪Bien. Bien.♪<clear><br><$voicel(1,7)><$comeff(1,21)><$motion(1,801)>Decidí vivir aquí a partir de hoy. Es un placer.<clear><br><$voicel(1,6)><$emotion(1,14)><$facial(1,1)>Ah. Eso sí. No te acerques a mí sin avisar. Es peligroso.<clear><br><$voicel(1,7)><$motion(1,807)><$comeff(1,10)>Mi cuerpo es muy frágil. Cuando me veo amenazad<gen;-3(o,a)>,<br>esparzo veneno por todos lados."

#. en: <$voicel(1,8)><$emotion(1,14)>Hey! Nice to meet ya—<clear><br><$voicel(1,6)><$comeff(1,4)><$motion(1,805)><$facial(1,9)>I mean, wait, no!<clear><br><$voicel(1,1)><$motion(1,634)><$facial(1,14)><$comeff(1,10)>Gaaah! I’ve been defeated! It’s all going dark...<clear><br>... ... ...<wait(0.8)><$voicel(1,6)><$facial(1,1)><$comeff(1,3)>*glance*<clear><br><$voicel(1,3)><$motion(1,635)><$comeff(1,6)>Not fooling you, huh? I guess I can’t play dead once I’ve<br>already said hi...<clear><br><$voicel(1,7)><$comeff(1,9)><$motionoff(1,804)><$facial(1,4)>Eh, whatever! You don’t seem like a bad Pokémon or<br>anything! So come say hi again sometime!<clear><br><$voicel(1,6)><$comeff(1,10)><$facial(1,1)><$motion(1,803)>Er, when I’m not playing dead, that is!
msgctxt "3255:313"
msgid "<$voicel(1,8)><$emotion(1,14)>¡Ey, qué pasa! ¿Cómo te va?<clear><br><$voicel(1,6)><$comeff(1,4)><$motion(1,805)><$facial(1,9)>¡¡Ostras, no, espera!!<clear><br><$voicel(1,1)><$motion(1,634)><$facial(1,14)><$comeff(1,10)>Urghhh... Argh... Es... cof, cof... el fin... ¡Blergh!<br><wait(0.8)><$voicel(1,6)><$facial(1,1)><$comeff(1,3)>... <$cdef(9)>(¿Habrá colado?).</color><clear><br><$voicel(1,3)><$motion(1,635)>Nada... Supongo que ya es tarde para hacerse <gen;-3(el muerto,la muerta)>,<br><$comeff(1,6)>¿no? Ya te había saludado y todo...<clear><br><$voicel(1,7)><$comeff(1,9)><$motionoff(1,804)><$facial(1,4)>¡Bah, qué más da! ¡Al menos tienes pinta de ser legal!<br>Ven a hablar conmigo cuando quieras.<clear><br><$voicel(1,6)><$comeff(1,10)><$facial(1,1)><$motion(1,803)>Excepto cuando me esté haciendo <gen;-3(el muerto,la muerta)>, claro,<br>¡que si no, me delatas!"
msgstr "<$voicel(1,8)><$emotion(1,14)>¡Ey, qué tal! ¿Cómo te va?<clear><br><$voicel(1,6)><$comeff(1,4)><$motion(1,805)><$facial(1,9)>¡¡Rayos, no, espera!!<clear><br><$voicel(1,1)><$motion(1,634)><$facial(1,14)><$comeff(1,10)>Urghhh... Argh... Es... cof, cof... el fin... ¡Blergh!<br><wait(0.8)><$voicel(1,6)><$facial(1,1)><$comeff(1,3)>... <$cdef(9)>(¿Se lo habrá creído?).</color><clear><br><$voicel(1,3)><$motion(1,635)>Nada... Supongo que ya es tarde para hacerse <gen;-3(el muerto,la muerta)>,<br><$comeff(1,6)>¿no? Ya te había saludado y todo...<clear><br><$voicel(1,7)><$comeff(1,9)><$motionoff(1,804)><$facial(1,4)>¡Bah, qué más da! ¡Al menos pareces buena gente!<br>Ven a hablar conmigo cuando quieras.<clear><br><$voicel(1,6)><$comeff(1,10)><$facial(1,1)><$motion(1,803)>Excepto cuando me esté haciendo <gen;-3(el muerto,la muerta)>, claro,<br>¡que si no, me delatas!"

#. en: <$voicel(1,8)><$motion(1,803)><$comeff(1,11)><$facial(1,13)>GAH!<clear><br><$voicel(1,3)><$motion(1,634)><$facial(1,14)>Time to...play dead!<br><wait(0.5)>... ... ...<wait(0.5)><$comeff(1,3)><$facial(1,1)>Huh?<slide><br><$voicel(1,4)><$motion(1,635)><$comeff(1,6)>No way! Could you tell I was just pretendin’?<clear><br><$voicel(1,6)><$motionoff(1,804)><$comeff(1,10)>Ha! You’re pretty sharp, blobhead!<clear><br><$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,9)>I’d hate to be your enemy...so let’s be friends instead!
msgctxt "3255:314"
msgid "<$voicel(1,8)><$motion(1,803)><$comeff(1,11)><$facial(1,13)>¡TAAAT! ¡Sálvese quien pueda!<clear><br>Oh, no... El socorro tardío es un socorro baldío.<br>¡Ha llegado mi hora!<clear><br><$voicel(1,3)><$motion(1,634)><$facial(1,14)>¡Bleeergh! <wait(0.5)>... <wait(0.8)><$comeff(1,3)><$facial(1,1)><$cdef(9)>(¿Se habrá ido ya?).</color><clear><br><$voicel(1,4)><$motion(1,635)><$comeff(1,6)>¿Eh? ¿No ha colado, supongo? <wait(0.8)><$voicel(1,6)><$motionoff(1,804)><$comeff(1,10)>Buah, ¡eres buen<gen;-2(o,a)>!<clear><br><$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,9)>¡No me gustaría tenerte como enemig<gen;-2(o,a)>! ¿Quieres que<br>seamos camaradas?"
msgstr "<$voicel(1,8)><$motion(1,803)><$comeff(1,11)><$facial(1,13)>¡TAAAT! ¡Sálvese quien pueda!<clear><br>Oh, no... El socorro tardío es un socorro baldío.<br>¡Llegó mi hora!<clear><br><$voicel(1,3)><$motion(1,634)><$facial(1,14)>¡Bleeergh! <wait(0.5)>... <wait(0.8)><$comeff(1,3)><$facial(1,1)><$cdef(9)>(¿Se habrá ido ya?).</color><clear><br><$voicel(1,4)><$motion(1,635)><$comeff(1,6)>¿Eh? ¿No te lo creíste, supongo? <wait(0.8)><$voicel(1,6)><$motionoff(1,804)><$comeff(1,10)>Vaya, ¡eres buen<gen;-2(o,a)>!<clear><br><$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,9)>¡No me gustaría tenerte como enemig<gen;-2(o,a)>! ¿Quieres que<br>seamos camaradas?"

#. en: <$voicel(1,8)><$emotion(1,14)>Oh, hey there.<clear><br><$voicel(1,3)><$motion(1,805)><$comeff(1,6)>I’m searching for my captain. Have you seen anyone who<br>looks kinda like me around here?<clear><br><$voicel(1,6)><$motion(1,634)><$facial(1,14)><$comeff(1,14)>Hmmm...<clear><br><$voicel(1,3)><$motion(1,635)><$comeff(1,17)><$facial(1,9)>I hope we can meet up again soon. Feels so weird when<br>my crew’s not around.
msgctxt "3255:315"
msgid "<$voicel(1,8)><$emotion(1,14)>Eh... Hola.<clear><br><$voicel(1,3)><$motion(1,805)>Estoy buscando a mi Capitán. <$comeff(1,6)>No lo habrás visto, ¿no?<br>Se parece mucho a mí, pero con una pose tal que así...<clear><br><$voicel(1,6)><$motion(1,634)><$facial(1,14)><$comeff(1,14)>...<clear><br><$voicel(1,3)><$motion(1,635)><$comeff(1,17)><$facial(1,9)>Espero que podamos reencontrarnos pronto. No me gusta<br>no tener a mi tripulación cerca."
msgstr "<$voicel(1,8)><$emotion(1,14)>Eh... Hola.<clear><br><$voicel(1,3)><$motion(1,805)>Estoy buscando a mi Capitán. <$comeff(1,6)>No lo habrás visto, ¿no?<br>Se parece mucho a mí, pero con una pose así...<clear><br><$voicel(1,6)><$motion(1,634)><$facial(1,14)><$comeff(1,14)>...<clear><br><$voicel(1,3)><$motion(1,635)><$comeff(1,17)><$facial(1,9)>Espero que podamos reencontrarnos pronto. No me gusta<br>no tener a mi tripulación cerca."

#. en: <$voicel(1,7)><$emotion(1,14)>Oh, hi. That’s an unusual look...<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,805)><$facial(1,14)>You look like one of those, uh—what are they called?<br>Uh... <wait(0.5)>Uhhh...<clear><br><$voicel(1,7)><$comeff(1,20)><$facial(1,4)><$motionoff(1,804)>Oh, I remember: humans! You look like a human. Hee hee,<wait(0.8)><br><$voicel(1,10)><$comeff(1,9)><$motion(1,801)>thanks for waiting while I tried to remember.<clear><br><$voicel(1,7)><$comeff(1,21)><$motion(1,806)>You’re really nice. As long as I’m with you, I feel like<br>everything’s gonna work out fine from now on. ♪
msgctxt "3255:316"
msgid "<$voicel(1,7)><$emotion(1,14)>Eeeh, colegui, llevas unas pintas de alucine...<br>En el buen sentido, que conste.<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,805)><$facial(1,14)>Me recuerdas a... <wait(0.4)>esto... <wait(0.4)>¿cómo era?...<clear><br><$voicel(1,7)><$comeff(1,20)><$facial(1,4)><$motionoff(1,804)>Aaah, sí, eeeso es. Eres clavadit<gen;-2(o,a)> a <gen;-2(un,una)> human<gen;-2(o,a)>.<clear><br><$voicel(1,10)><$comeff(1,9)><$motion(1,801)>Je, jeee... Se agradece la paciencia, que a veces se me<br>olvidan las cosas...<clear><br><$voicel(1,7)><$comeff(1,21)><$motion(1,806)>Se nota que eres legal, me inspiras confianza. Seguuuro<br>que nos llevaremos bien."
msgstr "<$voicel(1,7)><$emotion(1,14)>Eeeh, oye, tienes un aspecto alucinante...<br>En el buen sentido, que conste.<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,805)><$facial(1,14)>Me recuerdas a... <wait(0.4)>esto... <wait(0.4)>¿cómo era?...<clear><br><$voicel(1,7)><$comeff(1,20)><$facial(1,4)><$motionoff(1,804)>Aaah, sí, eeeso es. Eres igualit<gen;-2(o,a)> a <gen;-2(un,una)> human<gen;-2(o,a)>.<clear><br><$voicel(1,10)><$comeff(1,9)><$motion(1,801)>Je, jeee... Se agradece la paciencia, que a veces se me<br>olvidan las cosas...<clear><br><$voicel(1,7)><$comeff(1,21)><$motion(1,806)>Se nota que eres buena gente, me inspiras confianza.<br>Seguuuro que nos llevaremos bien."

#. en: <$voicel(1,8)><$emotion(1,14)>Oh, hey! Nice to meetcha!<clear><br><$voicel(1,5)><$comeff(1,10)><$motion(1,805)>I know my head LOOKS a little scary... <$voicel(1,7)><$motion(1,807)><$facial(1,4)><$comeff(1,21)>But I’m honestly not<br>scary at all, not in the slightest! So let’s be buddies!<clear><br><$voicel(1,4)><$comeff(1,14)><$motion(1,806)><$facial(1,14)>Peeek...aaa...<clear><br><$voicel(1,10)><$comeff(1,10)><$motion(1,817)><$facial(1,1)><$textsize(2)>BOO!</textsize><clear><br><$voicel(1,6)><$comeff(1,9)><$facial(1,4)><$motion(1,801)>Ahaha, GOTCHA!
msgctxt "3255:317"
msgid "<$voicel(1,8)><$emotion(1,14)>Holaaa, ¿qué pasaaa?<clear><br><$voicel(1,5)><$comeff(1,10)><$motion(1,805)>¿Mi cabeza? Ay, sí, ya sé que puede dar un poco de yuyu<br>y eso, pero...<clear><br><$voicel(1,7)><$motion(1,807)><$facial(1,4)><$comeff(1,21)>Tú ni caso, que no muerde. ¡Fijo que nos llevamos bien!<br><wait(0.8)><$voicel(1,4)><$comeff(1,14)><$motion(1,806)><$facial(1,14)>Ya te digo, no tienes naaada que temer...<clear><br><$voicel(1,10)><$comeff(1,10)><$motion(1,817)><$facial(1,1)><$textsize(2)>¡AY, QUE TE COMOOO!<clear><br></textsize><$voicel(1,6)><$comeff(1,9)><$facial(1,4)><$motion(1,801)>¡Jaaa, ja, ja! Estoy de broma, tranqui."
msgstr "<$voicel(1,8)><$emotion(1,14)>Holaaa, ¿qué taaal?<clear><br><$voicel(1,5)><$comeff(1,10)><$motion(1,805)>¿Mi cabeza? Ay, sí, ya sé que puede dar un poco de miedo<br>y eso, pero...<clear><br><$voicel(1,7)><$motion(1,807)><$facial(1,4)><$comeff(1,21)>Tú ni caso, que no muerde. ¡Seguro que nos llevamos bien!<br><wait(0.8)><$voicel(1,4)><$comeff(1,14)><$motion(1,806)><$facial(1,14)>Te lo aseguro, no tienes naaada que temer...<clear><br><$voicel(1,10)><$comeff(1,10)><$motion(1,817)><$facial(1,1)><$textsize(2)>¡AY, QUE TE COMOOO!<clear><br></textsize><$voicel(1,6)><$comeff(1,9)><$facial(1,4)><$motion(1,801)>¡Jaaa, ja, ja! Es broma, no te asustes."

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,13)><$comeff(1,5)>Gimmi?! Yo! You found me! You’re pretty good at treasure<br>hunting, huh?!<clear><br><$voicel(1,3)><$motion(1,805)><$comeff(1,10)>But, uh, sorry... I can’t give ya my coin... <$voicel(1,6)><$emotion(1,39)>This here’s my<br>treasure!<clear><br><$voicel(1,7)><$motionoff(1,804)><$facial(1,4)><$comeff(1,9)>I can totally help ya out with other stuff, though! Definitely<br>gimme a yell if ya need somethin’, yo!
msgctxt "3255:318"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,13)><$comeff(1,5)>¡¿Gimmi?! ¡Me has pillado! ¡Te sales como buscatesoros!<clear><br><$voicel(1,3)><$motion(1,805)><$comeff(1,10)>Respeto total, ¿eh, tí<gen;-2(o,a)>?, ¡pero me temo que no puedo<br>darte ni una sola moneda!<clear><br><$voicel(1,6)><$emotion(1,39)>¡Es mi tesoro, al fin y al cabo!<clear><br><$voicel(1,7)><$motionoff(1,804)><$facial(1,4)><$comeff(1,9)>Pero si hay alguna otra cosa con la que pueda ayudarte,<br>que no te dé palo pedírmelo."
msgstr "<$voicel(1,7)><$motion(1,803)><$facial(1,13)><$comeff(1,5)>¡¿Gimmi?! ¡Me atrapaste! ¡Eres un as buscando tesoros!<clear><br><$voicel(1,3)><$motion(1,805)><$comeff(1,10)>Respeto total, ¿eh, amig<gen;-2(o,a)>?, ¡pero me temo que no puedo<br>darte ni una sola moneda!<clear><br><$voicel(1,6)><$emotion(1,39)>¡Es mi tesoro, al fin y al cabo!<clear><br><$voicel(1,7)><$motionoff(1,804)><$facial(1,4)><$comeff(1,9)>Pero si hay alguna otra cosa con la que pueda ayudarte,<br>que no te dé vergüenza pedírmelo."

#. en: <$voicel(1,5)><$motion(1,805)><$comeff(1,14)>Hmmmmmm? I’m all hard and tough, but you’re all<br>soft and squuuiiishy...<clear><br><$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,9)>It’s kinda neat that we’re so diiifferent like that. I hope we<br>can be friiieeends.<clear><br><$voicel(1,5)><$motion(1,803)><$comeff(1,21)>My body’s real shiny, you knooow? So I might be kinda<br>dazzling to look at, <$voicel(1,8)><$motion(1,806)><$comeff(1,10)>and it would be suuuper cool if you<slide><br>could just ignore that.
msgctxt "3255:319"
msgid "<$voicel(1,5)><$motion(1,805)><$comeff(1,14)>Mira tú qué contraste más curioso: tú eres t<gen;-2(o,oa)> blandit<gen;-2(o,a)><br>y yo soy más dur<gen;-3(o,a)> que el acero.<clear><br><$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,9)>¡En la variedad está el gusto, o eso dicen! Me encantaría<br>que nos conociésemos mejor.<clear><br><$voicel(1,5)><$motion(1,803)><$comeff(1,21)>Y ya de primeras te pido perdón. Sé que mi cuerpo es<br>la mar de brillante y puede cegar cuando refleja la luz,<slide><br><$voicel(1,8)><$motion(1,806)><$comeff(1,10)>pero espero que no sea un inconveniente."
msgstr "<$voicel(1,5)><$motion(1,805)><$comeff(1,14)>Mira tú qué contraste más curioso: tú eres t<gen;-2(o,oa)> blandit<gen;-2(o,a)><br>y yo soy más dur<gen;-3(o,a)> que el acero.<clear><br><$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,9)>¡En la variedad está el gusto, o eso dicen! Me encantaría<br>que nos conociéramos mejor.<clear><br><$voicel(1,5)><$motion(1,803)><$comeff(1,21)>Y de antemano te pido perdón. Sé que mi cuerpo es<br>muy brillante y puede cegar cuando refleja la luz,<slide><br><$voicel(1,8)><$motion(1,806)><$comeff(1,10)>pero espero que no sea un inconveniente."

#. en: <$voicel(1,5)><$comeff(1,3)><$motion(1,803)>First, would you please lead me <$voicel(1,4)><$emotion(1,16)>to the place where<br>you and your friends live?
msgctxt "3255:320"
msgid "<$voicel(1,5)><$comeff(1,3)><$motion(1,803)>Seré franc<gen;-3(o,a)> contigo: me gustaría establecer mi morada<br>por donde tú vives. <$voicel(1,4)><$emotion(1,16)>¿Te importaría mostrarme el camino?"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,1)>You have my thanks. I’ll follow your lead.
msgctxt "3255:321"
msgid "<$voicel(1,7)><$emotion(1,1)>Gracias. Te sigo."
msgstr ""

#. en: <$voicel(1,5)><$emotion(1,27)>Oh, is this poor timing for you? I’ll remain here, then,<br><$voicel(1,8)><$emotion(1,38)>so please come speak with me again.
msgctxt "3255:322"
msgid "<$voicel(1,5)><$emotion(1,27)>Ya veo, de modo que he preguntado en mal momento.<br>No pasa nada.<clear><br><$voicel(1,8)><$emotion(1,38)>Avísame cuando te venga bien. Yo estaré aquí."
msgstr "<$voicel(1,5)><$emotion(1,27)>Ya veo, de modo que pregunté en mal momento.<br>No pasa nada.<clear><br><$voicel(1,8)><$emotion(1,38)>Avísame cuando te venga bien. Yo estaré aquí."

#. en: <$voicel(1,7)><$emotion(1,8)>Vooolm! ♪ Y’all always seem to be having a great time!<clear><br><$voicel(1,5)><$comeff(1,3)><$motion(1,805)>What d’ya call this again? A “party”? I’m kinda startin’ to<br>feel like <$voicel(1,8)><$motionoff(1,804)><$comeff(1,5)>I wanna join in too!<clear><br><$voicel(1,5)><$emotion(1,49)>Whaddaya say? Think I could be part of your friend group?
msgctxt "3255:326"
msgid "<$voicel(1,7)><$emotion(1,8)>♪¡Nion!♪ ¡Te veo tan animad<gen;-2(o,a)> como de costumbre!<clear><br><$voicel(1,5)><$comeff(1,3)><$motion(1,805)>¿Dices que esto se llama... \"fiesta\"? Pues está muy bien,<br>oye. Menudo ambientazo.<clear><br><$voicel(1,8)><$motionoff(1,804)><$comeff(1,5)>¡Hasta me están entrando ganas de socializar un poco!<clear><br><$voicel(1,5)><$emotion(1,49)>Y, bueno, ya que estoy aquí, te pregunto una cosilla...<br>¿qué te parece si me hago amig<gen;-3(o,a)> tuy<gen;-3(o,a)>?"
msgstr "<$voicel(1,7)><$emotion(1,8)>♪¡Nion!♪ ¡Te veo tan animad<gen;-2(o,a)> como de costumbre!<clear><br><$voicel(1,5)><$comeff(1,3)><$motion(1,805)>¿Dices que esto se llama... \"fiesta\"? Pues está muy bien,<br>oye. ¡Qué ambientazo!<clear><br><$voicel(1,8)><$motionoff(1,804)><$comeff(1,5)>¡Hasta me están entrando ganas de socializar un poco!<clear><br><$voicel(1,5)><$emotion(1,49)>Y, bueno, ya que estoy aquí, te pregunto una cosita...<br>¿qué te parece si me hago amig<gen;-3(o,a)> tuy<gen;-3(o,a)>?"

#. en: <$voicel(1,3)><$motion(1,805)><$comeff(1,6)>Hmmm... You’re not dirty or anything, are you?<clear><br><$voicel(1,5)><$emotion(1,14)>Oh, I mean, sorry to ask! It’s just, if things are dirty around<br>me, <$voicel(1,8)><$motion(1,807)><$comeff(1,10)>it’s really hard for me to ignore!<clear><br><$voicel(1,6)><$emotion(1,8)>But anyway, um... Nice to meet you!<clear><br><$voicel(1,7)><$motion(1,817)><$facial(1,4)><$comeff(1,21)>If you ever get all dusty, I can pat you clean with my wings!
msgctxt "3255:330"
msgid "<$voicel(1,3)><$motion(1,805)><$comeff(1,6)>Hmm... No estarás suci<gen;-2(o,a)>, ¿no?<clear><br><$voicel(1,5)><$emotion(1,14)>Ah, perdona, es que... ¡necesito que todo a mi alrededor<br>esté limpio! <wait(0.4)><$voicel(1,8)><$motion(1,807)><$comeff(1,10)>¡No lo puedo evitar!<clear><br><$voicel(1,6)><$emotion(1,8)>En fin, vaya forma de presentarse, ¿no? ¡Encantad<gen;-3(o,a)>!<clear><br><$voicel(1,7)><$motion(1,817)><$facial(1,4)><$comeff(1,21)>Si en algún momento te llenas de polvo o lo que sea,<br>ya sabes, ¡mis alas te dejarán limpit<gen;-2(o,a)> en un momentín!"
msgstr "<$voicel(1,3)><$motion(1,805)><$comeff(1,6)>Hmm... No estarás suci<gen;-2(o,a)>, ¿no?<clear><br><$voicel(1,5)><$emotion(1,14)>Ah, perdona, es que... ¡necesito que todo a mi alrededor<br>esté limpio! <wait(0.4)><$voicel(1,8)><$motion(1,807)><$comeff(1,10)>¡No lo puedo evitar!<clear><br><$voicel(1,6)><$emotion(1,8)>En fin, vaya forma de presentarse, ¿no? ¡Encantad<gen;-3(o,a)>!<clear><br><$voicel(1,7)><$motion(1,817)><$facial(1,4)><$comeff(1,21)>Si en algún momento te llenas de polvo o lo que sea,<br>ya sabes, ¡mis alas te dejarán limpit<gen;-2(o,a)> en un momentito!"

#. en: <$voicel(1,8)><$emotion(1,14)>Oh! Nice to meet you, dear!<clear><br><$voicel(1,9)><$comeff(1,9)><$motion(1,801)><$facial(1,4)>I’m just tickled pink to see you, you know—it’s been so<br>long since I’ve had anyone to talk to, after all!<clear><br><$voicel(1,8)><$comeff(1,10)><$motionoff(1,804)>Please feel free to ask me if you ever need anything!<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,805)><$facial(1,1)>For example... Hmmm... Oh! If you’re ever having trouble<br>falling asleep...<clear><br><$voicel(1,7)><$comeff(1,21)><$motion(1,816)>I can wrap you up in my wings and sing you a lullaby! ♪
msgctxt "3255:331"
msgid "<$voicel(1,8)><$emotion(1,14)>Ay, criaturilla, ¡encantad<gen;-3(o,a)> de conocerte!<clear><br><$voicel(1,9)><$comeff(1,9)><$motion(1,801)><$facial(1,4)>Llevaba tanto sin hablar con nadie... ¡Qué alegría me<br>acabas de dar!<clear><br><$voicel(1,8)><$comeff(1,10)><$motionoff(1,804)>¡Que sepas que puedes venir a mí siempre que tengas<br>algún problemilla!<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,805)><$facial(1,1)>Por ejemplo, si alguna noche te desvelas y no puedes<br>dormir...<clear><br><$voicel(1,7)><$comeff(1,21)><$motion(1,816)>♪Estaré más que encantad<gen;-3(o,a)> de acurrucarte en mis alas<br>mientras te canto una dulce nana.♪"
msgstr "<$voicel(1,8)><$emotion(1,14)>Ay, criaturita, ¡encantad<gen;-3(o,a)> de conocerte!<clear><br><$voicel(1,9)><$comeff(1,9)><$motion(1,801)><$facial(1,4)>Llevaba tanto sin hablar con nadie... ¡Qué alegría me<br>acabas de dar!<clear><br><$voicel(1,8)><$comeff(1,10)><$motionoff(1,804)>¡Que sepas que puedes venir a mí siempre que tengas<br>algún problemita!<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,805)><$facial(1,1)>Por ejemplo, si alguna noche te desvelas y no puedes<br>dormir...<clear><br><$voicel(1,7)><$comeff(1,21)><$motion(1,816)>♪Estaré más que encantad<gen;-3(o,a)> de acurrucarte en mis alas<br>mientras te canto una dulce canción de cuna.♪"

#. en: <$voicel(1,7)><$motion(1,805)><$comeff(1,14)>This area appears quite comfortable.<wait(1.0)><$motion(0,824)><wait(1.0)><clear><br><$motion(0,652)><$voicel(1,6)><$emotion(1,14)>Is that thanks to your efforts?<clear><br><$voicel(1,3)><$comeff(1,10)>The humans seem to have disappeared from this place, <$voicel(1,8)><$motion(1,806)><$facial(1,4)><$comeff(1,9)>but<br>I’m beginning to sense a spark of hope once more.<clear><br><$voicel(1,9)><$motionoff(1,804)><$facial(1,4)><$comeff(1,21)>I may not be able to offer much, but I’d like to help. If<br>nothing else, please let me watch over you.
msgctxt "3255:332"
msgid "<$voicel(1,7)><$motion(1,805)><$comeff(1,14)>Este lugar parece idóneo para mí. Dispone de todas las<br>comodidades que pudiera desear.<wait(1.0)><$motion(0,824)><wait(1.0)><clear><br><$motion(0,652)><$voicel(1,6)><$emotion(1,14)>¿Es a ti a quien debo agradecérselo?<clear><br><$voicel(1,3)><$comeff(1,10)>Por lo visto, aunque los humanos hayan desaparecido sin<br>dejar ningún rastro... <$voicel(1,8)><$motion(1,806)><$facial(1,4)><$comeff(1,9)>todavía es pronto para perder la fe.<slide><br>Aún hay algo a lo que aferrarnos.<clear><br><$voicel(1,9)><$motionoff(1,804)><$facial(1,4)><$comeff(1,21)>Puede que no sea <gen;-3(el,la)> más capaz, mas te brindaré mi ayuda<br>en lo que pueda. Como mínimo, deja que vele por ti."
msgstr ""

#. en: <$voicel(1,6)><$emotion(1,14)>Heyyy. Hellooo...<$motion(0,82)><$comeff(0,5)><wait(0.8)><clear><br><$voicel(1,3)><$motion(1,666)><$comeff(1,6)><$motion(0,824)>Whaaat? Why are you so surprised? <wait(1.0)><$motion(0,652)><$voicel(1,8)><$cdef(27)>Professor</color>... <$cdef(27)>Tangrowth</color>?<clear><br><$voicel(1,5)><$motion(1,803)><$facial(1,4)><$comeff(1,20)>Ohhh... So I look like someone you knooow? I wonder if I’ll<br>meet theeem someday while I’m living here...<clear><br><$voicel(1,7)><$comeff(1,14)>But they’re a professor, you sayyy? Maybe they can teach me<br><$voicel(1,10)><$emotion(1,39)>where to find a nice sunny spot to just relaaax.
msgctxt "3255:333"
msgid "<$voicel(1,6)><$emotion(1,14)>¡Hola, maj<gen;-2(o,a)>, encantad<gen;-3(o,a)>!<$motion(0,82)><$comeff(0,5)><wait(0.8)><clear><br><$voicel(1,3)><$motion(1,666)><$comeff(1,6)><$motion(0,824)>¿Hm? ¿Qué pasa? ¿A qué viene esa cara de sorpresa?<br><wait(1.0)><$motion(0,652)><$voicel(1,8)>¿Cómo que \"<$cdef(27)>Profesor Tangrowth</color>\"?<clear><br><$voicel(1,5)><$motion(1,803)><$facial(1,4)><$comeff(1,20)>Aaah, entieeendo, entieeendo. Así que me parezco a<br>un conocido tuyo. ¡Si me lo encuentro por aquí un día<slide><br>de estos, me aseguraré de saludar!<clear><br><$voicel(1,7)><$comeff(1,14)>¿Y dices que es un profesor? Debe de saber un montón<br>de cosas...<clear><br><$voicel(1,10)><$emotion(1,39)>¡Le preguntaré cuál es su lugar favorito pa echarse<br>una siestecica bajo el sol!"
msgstr "<$voicel(1,6)><$emotion(1,14)>¡Hola, lind<gen;-2(o,a)>, encantad<gen;-3(o,a)>!<$motion(0,82)><$comeff(0,5)><wait(0.8)><clear><br><$voicel(1,3)><$motion(1,666)><$comeff(1,6)><$motion(0,824)>¿Hm? ¿Qué pasa? ¿A qué viene esa cara de sorpresa?<br><wait(1.0)><$motion(0,652)><$voicel(1,8)>¿Cómo que \"<$cdef(27)>Profesor Tangrowth</color>\"?<clear><br><$voicel(1,5)><$motion(1,803)><$facial(1,4)><$comeff(1,20)>Aaah, entieeendo, entieeendo. Así que me parezco a<br>un conocido tuyo. ¡Si me lo encuentro por aquí un día<slide><br>de estos, me aseguraré de saludar!<clear><br><$voicel(1,7)><$comeff(1,14)>¿Y dices que es un profesor? Debe de saber un montón<br>de cosas...<clear><br><$voicel(1,10)><$emotion(1,39)>¡Le preguntaré cuál es su lugar favorito pa echarse<br>una siestita bajo el sol!"

#. en: <$voicel(1,5)><$emotion(1,14)>It is nice to meet you. I have chosen to live here. <$voicel(1,8)><$comeff(1,21)><$facial(1,4)><$motionoff(1,804)>So. Let<br>us become friends. I would be happy if we did.<wait(1.0)><$motion(0,40)><wait(1.0)><clear><br><$voicel(1,10)><$comeff(1,9)><$motion(1,801)><$facial(1,4)>You will be my friend? That is so good.<clear><br><$voicel(1,7)><$motion(1,816)><$comeff(1,10)>I am so happy I could spin and spin and spin more<br>than usual.<clear><br><$voicel(1,6)><$motion(1,814)><$comeff(1,14)><$facial(1,1)>Spin and spin and spin and spin and—<clear><br><$voicel(1,2)><$comeff(1,4)><$motion(1,807)><$facial(1,9)>I have spun too much. I am now tired.
msgctxt "3255:334"
msgid "<$voicel(1,5)><$emotion(1,14)>¡Encantad<gen;-3(o,a)>! Me he mudado y ando en busca de amigos.<br><$voicel(1,8)><$comeff(1,21)><$facial(1,4)><$motionoff(1,804)>¿Te gustaría serlo?<wait(1.0)><$motion(0,40)><wait(1.0)><clear><br><$voicel(1,10)><$comeff(1,9)><$motion(1,801)><$facial(1,4)>¡Has aceptado! ¡Bien! ¡Qué júbilo!<clear><br><$voicel(1,7)><$motion(1,816)><$comeff(1,10)>Rotación al 100<nbs4>%. Estoy tan feliz que no... puedo...<br>parar de girar...<clear><br><$voicel(1,6)><$motion(1,814)><$comeff(1,14)><$facial(1,1)>Gira y gira y gira y gira...<clear><br><$voicel(1,2)><$comeff(1,4)><$motion(1,807)><$facial(1,9)>Ay... Creo que me he mareado."
msgstr "<$voicel(1,5)><$emotion(1,14)>¡Encantad<gen;-3(o,a)>! Me mudé y ando en busca de amigos.<br><$voicel(1,8)><$comeff(1,21)><$facial(1,4)><$motionoff(1,804)>¿Te gustaría serlo?<wait(1.0)><$motion(0,40)><wait(1.0)><clear><br><$voicel(1,10)><$comeff(1,9)><$motion(1,801)><$facial(1,4)>¡Aceptaste! ¡Bien! ¡Qué júbilo!<clear><br><$voicel(1,7)><$motion(1,816)><$comeff(1,10)>Rotación al 100<nbs4>%. Estoy tan feliz que no... puedo...<br>parar de girar...<clear><br><$voicel(1,6)><$motion(1,814)><$comeff(1,14)><$facial(1,1)>Gira y gira y gira y gira...<clear><br><$voicel(1,2)><$comeff(1,4)><$motion(1,807)><$facial(1,9)>Ay... Creo que me mareé."

#. en: <$voicel(1,6)><$motion(1,806)><$comeff(1,3)>Yo. You need somethin’?<clear><br><$voicel(1,7)><$comeff(1,9)><$facial(1,4)><$motion(1,801)>It’s been a while since I’ve seen anyone else, so I’m pretty<br>pumped to get to chat with ya!<clear><br><$facial(0,9)><$voicel(1,5)><$comeff(1,5)><$motion(1,803)><$facial(1,1)>Whoa! I’m gettin’ so pumped that<$voicel(1,10)><$comeff(1,10)><$motionoff(1,804)><$facial(1,4)> my whole body’s<br>heatin’ up!<wait(1.0)><$motion(0,41)><$comeff(0,4)><wait(0.8)><clear><br><$voicel(1,4)><$comeff(1,11)><$facial(1,1)>Uh-oh! Are you gettin’ a little too hot? That’s no good...<clear><br><$voicel(1,2)><$comeff(1,4)><$motion(1,807)><$facial(1,9)>Come on, body! Cool down already!
msgctxt "3255:335"
msgid "<$voicel(1,6)><$motion(1,806)><$comeff(1,3)>Eyyy, ¿qué pasa, chava<gen;-2(l,la)>?<clear><br><$voicel(1,7)><$comeff(1,9)><$facial(1,4)><$motion(1,801)>¡No sabes lo emocionad<gen;-3(o,a)> que estoy ahora mismo!<br>¡Hacía la tira que no hablaba con nadie!<clear><br><$facial(0,9)><$voicel(1,5)><$comeff(1,5)><$motion(1,803)><$facial(1,1)>Buah, es que noto el fervor en mi interior y todo...<br><wait(1.0)><$voicel(1,10)><$comeff(1,10)><$motionoff(1,804)><$facial(1,4)>¡Tengo el cuerpo ardiendo de la emoción!<slide><br><$motion(0,41)><$comeff(0,4)><wait(0.8)><$voicel(1,4)><$comeff(1,11)><$facial(1,1)>¡Oh, no! ¿Es demasiado calor para ti?<clear><br><$voicel(1,2)><$comeff(1,4)><$motion(1,807)><$facial(1,9)>¡Cálmate un poquito, cuerpo! ¡Baja la temperatura!"
msgstr "<$voicel(1,6)><$motion(1,806)><$comeff(1,3)>Eyyy, ¿qué pasa, chava<gen;-2(l,la)>?<clear><br><$voicel(1,7)><$comeff(1,9)><$facial(1,4)><$motion(1,801)>¡No sabes lo emocionad<gen;-3(o,a)> que estoy ahora mismo!<br>¡Hacía muchísimo que no hablaba con nadie!<clear><br><$facial(0,9)><$voicel(1,5)><$comeff(1,5)><$motion(1,803)><$facial(1,1)>Guau, es que noto el fervor en mi interior y todo...<br><wait(1.0)><$voicel(1,10)><$comeff(1,10)><$motionoff(1,804)><$facial(1,4)>¡Tengo el cuerpo ardiendo de la emoción!<slide><br><$motion(0,41)><$comeff(0,4)><wait(0.8)><$voicel(1,4)><$comeff(1,11)><$facial(1,1)>¡Oh, no! ¿Es demasiado calor para ti?<clear><br><$voicel(1,2)><$comeff(1,4)><$motion(1,807)><$facial(1,9)>¡Cálmate un poquito, cuerpo! ¡Baja la temperatura!"

#. en: <$voicel(1,7)><$emotion(1,14)>Well, howdy! I don’t believe we’ve met before, have we?<br>This here area’s real nice, ain’t it? <$voicel(1,8)><$motion(1,801)><$facial(1,4)><$comeff(1,9)>I’m lovin’ it!<clear><br><$voicel(1,5)><$comeff(1,10)><$motion(1,806)>Why, I love it so much I think I’m gonna make it my home!<br>Feel free to visit if ya need anythin’ now, ya hear?<clear><br><$voicel(1,7)><$comeff(1,21)><$motion(1,817)>Fer example, if you’re ever cold, come see me! I’ll warm ya<br>right up!
msgctxt "3255:336"
msgid "<$voicel(1,7)><$emotion(1,14)>Oh, hola, jovencit<gen;-2(o,a)>. En este lugar se está muy a gusto.<br><$voicel(1,8)><$motion(1,801)><$facial(1,4)><$comeff(1,9)>Tanto que no quiero irme.<clear><br><$voicel(1,5)><$comeff(1,10)><$motion(1,806)>Creo que me quedaré a vivir aquí. Si alguna vez necesitas<br>mi ayuda, no dudes en contar conmigo.<clear><br><$voicel(1,7)><$comeff(1,21)><$motion(1,817)>Puedes venirte a mi vera cuando tengas frío.<br>¡Te garantizo que estarás muy calentit<gen;-2(o,a)>!"
msgstr "<$voicel(1,7)><$emotion(1,14)>Oh, hola, jovencit<gen;-2(o,a)>. En este lugar se está muy a gusto.<br><$voicel(1,8)><$motion(1,801)><$facial(1,4)><$comeff(1,9)>Tanto que no quiero irme.<clear><br><$voicel(1,5)><$comeff(1,10)><$motion(1,806)>Creo que me quedaré a vivir aquí. Si alguna vez necesitas<br>mi ayuda, no dudes en contar conmigo.<clear><br><$voicel(1,7)><$comeff(1,21)><$motion(1,817)>Puedes venirte a mi lado cuando tengas frío.<br>¡Te garantizo que estarás muy calentit<gen;-2(o,a)>!"

#. en: <$voicel(1,9)><$emotion(1,8)>Bzzzt... Bzzzt... Wattreee! ♪<clear><br><$voicel(1,5)><$comeff(1,3)><$motionoff(1,804)>Wow, the wind in this area is real nice! I like how easy it<br>makes flying around.<clear><br><$voicel(1,7)><$comeff(1,10)><$motion(1,803)>I’m gonna live here from now on. Stop by and say hi, OK?
msgctxt "3255:337"
msgid "<$voicel(1,9)><$emotion(1,8)>¡Bzzzt! ¡Bzzzt! ♪¡Waaatt!♪<clear><br><$voicel(1,5)><$comeff(1,3)><$motionoff(1,804)>¡En esta zona hay unos vientos buenísimos! ¡Qué guay!<br>Casi ni tengo que hacer esfuerzo para volar.<clear><br><$voicel(1,7)><$comeff(1,10)><$motion(1,803)>Decidido: ¡me vengo a vivir aquí! ¡Espero que me des una<br>superbienvenida! ¡Je, je!"
msgstr "<$voicel(1,9)><$emotion(1,8)>¡Bzzzt! ¡Bzzzt! ♪¡Waaatt!♪<clear><br><$voicel(1,5)><$comeff(1,3)><$motionoff(1,804)>¡En esta zona hay unos vientos buenísimos! ¡Qué genial!<br>Casi ni tengo que hacer esfuerzo para volar.<clear><br><$voicel(1,7)><$comeff(1,10)><$motion(1,803)>Decidido: ¡me vengo a vivir aquí! ¡Espero que me des una<br>superbienvenida! ¡Je, je!"

#. en: <$voicel(1,9)><$comeff(1,9)><$motionoff(1,804)>Kiii! ♪ This place is awesome! I bet I could really recharge<br>my batteries if I rested here!<clear><br><$voicel(1,7)><$emotion(1,53)>I tell ya, bein’ here makes me feel like I can soar on the<br>wind to the end of the world! Like I can do ANYTHING!<clear><br><$voicel(1,5)><$comeff(1,10)><$motion(1,803)>And since I can do anything, you just let me know if<br>anything needs doin’! I’d be happy to help, bud!
msgctxt "3255:338"
msgid "<$voicel(1,9)><$comeff(1,9)><$motionoff(1,804)>♪¡Watt!♪ Qué sitio tan tremendo. ¡Aquí puedo descansar<br>y recuperar fuerzas que da gusto!<clear><br><$voicel(1,7)><$emotion(1,53)>Además, desde aquí puedo pillar una corriente de aire<br>e ir adonde me plazca. ¡Tengo opciones infinitas!<clear><br><$voicel(1,5)><$comeff(1,10)><$motion(1,803)>Si tienes algún problemilla, no dudes en decírmelo,<br>que pa algo estoy aquí. ¡Te ayudo sin dudarlo!"
msgstr "<$voicel(1,9)><$comeff(1,9)><$motionoff(1,804)>♪¡Watt!♪ Qué lugar tan increíble. ¡Aquí puedo descansar<br>y recuperar fuerzas que da gusto!<clear><br><$voicel(1,7)><$emotion(1,53)>Además, desde aquí puedo tomar una corriente de aire<br>e ir adonde me plazca. ¡Tengo opciones infinitas!<clear><br><$voicel(1,5)><$comeff(1,10)><$motion(1,803)>Si tienes algún problemita, no dudes en decírmelo,<br>que pa algo estoy aquí. ¡Te ayudo sin dudarlo!"

#. en: <$voicel(1,7)><$comeff(1,16)><$motion(1,805)>*yaaaaaawwwn*... Oh! Hi! Nice to meet you! And, um...<br>Where am I? And how did I get here?<clear><br><$voicel(1,4)><$emotion(1,29)>I must’ve gotten blown around by the wind while I<br>was asleep.<clear><br><$voicel(1,6)><$emotion(1,8)>Still... I like it here! It’s got a nice vibe.<clear><br><$voicel(1,7)><$comeff(1,10)><$motion(1,803)>So if this is where the wind brought me, I guess I’ll try<br>living here!
msgctxt "3255:339"
msgid "<$voicel(1,7)><$comeff(1,16)><$motion(1,805)>Uaaaaaah... Oh, ¡hola! ¿Dónde estoy?<clear><br><$voicel(1,4)><$emotion(1,29)>Me habrá traído una corriente de aire mientras dormía...<br><$voicel(1,6)><$emotion(1,8)>¡pero la verdad es que parece un sitio muy chuli!<clear><br><$voicel(1,7)><$comeff(1,10)><$motion(1,803)>Me ha causado una buena primera impresión y, si el<br>viento me ha traído, por algo será. ¡Me quedo a vivir!"
msgstr "<$voicel(1,7)><$comeff(1,16)><$motion(1,805)>Uaaaaaah... Oh, ¡hola! ¿Dónde estoy?<clear><br><$voicel(1,4)><$emotion(1,29)>Me habrá traído una corriente de aire mientras dormía...<br><$voicel(1,6)><$emotion(1,8)>¡pero la verdad es que parece un lugar muy lindo!<clear><br><$voicel(1,7)><$comeff(1,10)><$motion(1,803)>Me causó una buena primera impresión y, si el<br>viento me trajo, por algo será. ¡Me quedo a vivir!"

#. en: <$voicel(1,5)><$emotion(1,14)>Hey, check it out! Isn’t my flower so nice and pretty?<clear><br><$voicel(1,8)><$comeff(1,9)><$motion(1,666)>It’s full of energy ’cause, I mean, this whole place is just so<br>nice, y’know?<clear><br><$voicel(1,9)><$emotion(1,49)>So yeah, I’m thinking about living here! I hope we can<br>be friends!
msgctxt "3255:340"
msgid "<$voicel(1,5)><$emotion(1,14)>Oye, mira, échale un ojo a mi flor... <wait(0.5)>¿Cómo te quedas?<br>¿A que está preciosa?<clear><br><$voicel(1,8)><$comeff(1,9)><$motion(1,666)>Se ve que este sitio le ha sentado genial.<clear><br><$voicel(1,9)><$emotion(1,49)>Pues, visto lo visto, creo que me voy a quedar a vivir aquí.<br>Encantaaad<gen;-3(o,a)>."
msgstr "<$voicel(1,5)><$emotion(1,14)>Oye, mira, échale un ojo a mi flor... <wait(0.5)>¿Qué te parece?<br>¿Verdad que está preciosa?<clear><br><$voicel(1,8)><$comeff(1,9)><$motion(1,666)>Se ve que este lugar le hizo muy bien.<clear><br><$voicel(1,9)><$emotion(1,49)>Pues, visto lo visto, creo que me voy a quedar a vivir aquí.<br>Encantaaad<gen;-3(o,a)>."

#. en: <$voicel(1,5)><$emotion(1,62)>Pluuuff! ♪ How very nice to meet you! My, this place sure<br>is lovely.<clear><br><$voicel(1,9)><$comeff(1,10)><$motion(1,816)>It’s nice and breezy—I feel like I might be whisked off at<br>any moment!<clear><br><$voicel(1,5)><$comeff(1,9)><$motion(1,805)>If you ever see me floating by around here, please<br>don’t hesitate to say hello! ♪
msgctxt "3255:341"
msgid "<$voicel(1,5)><$emotion(1,62)>♪¡Pluff!♪ Un placer, criatura. Oy, este lugar es magnífico.<clear><br><$voicel(1,9)><$comeff(1,10)><$motion(1,816)>¡Sopla mucho airecito y siento que podría dejarme llevar<br>por la brisilla y terminar en cualquier lugar!<clear><br><$voicel(1,5)><$comeff(1,9)><$motion(1,805)>Me gusta mucho. No dudes en darme cháchara cuando<br>me veas deambulando por aquí, ¿vale, chiquit<gen;-2(ín,ina)>?"
msgstr "<$voicel(1,5)><$emotion(1,62)>♪¡Pluff!♪ Un placer, criatura. Oy, este lugar es magnífico.<clear><br><$voicel(1,9)><$comeff(1,10)><$motion(1,816)>¡Sopla mucho airecito y siento que podría dejarme llevar<br>por la brisita y terminar en cualquier lugar!<clear><br><$voicel(1,5)><$comeff(1,9)><$motion(1,805)>Me gusta mucho. No dudes en saludarme cuando<br>me veas deambulando por aquí, ¿de acuerdo, chiquit<gen;-2(ín,ina)>?"

#. en: <$voicel(1,7)><$emotion(1,1)>Why, hello there! I’m pleased to meet you. This area really<br>is quite lovely.<clear><br><$voicel(1,5)><$comeff(1,21)><$motion(1,805)>I do get the sense I can rest and relax here—I’m quite<br>smitten with the place!<clear><br><$voicel(1,5)><$comeff(1,9)><$motion(1,659)><$facial(1,5)>Yes, I think I’ll be happy to call this my home. I hope to<br>see you around from time to time!
msgctxt "3255:342"
msgid "<$voicel(1,7)><$emotion(1,1)>Ah, hola, encantad<gen;-3(o,a)>. En este lugar se respira un ambiente<br>de lo más apacible.<clear><br><$voicel(1,5)><$comeff(1,21)><$motion(1,805)>Siento que es uno de esos sitios donde un<gen;-3(o,a)> puede<br>desconectar y relajarse de verdad...<clear><br>Sí, la verdad es que me gusta mucho.<clear><br><$voicel(1,5)><$comeff(1,9)><$motion(1,659)><$facial(1,5)>Vale, lo he decidido: voy a mudarme aquí. Espero que no<br>te suponga ningún inconveniente."
msgstr "<$voicel(1,7)><$emotion(1,1)>Ah, hola, encantad<gen;-3(o,a)>. En este lugar se respira un ambiente<br>de lo más apacible.<clear><br><$voicel(1,5)><$comeff(1,21)><$motion(1,805)>Siento que es uno de esos lugares donde un<gen;-3(o,a)> puede<br>desconectar y relajarse de verdad...<clear><br>Sí, la verdad es que me gusta mucho.<clear><br><$voicel(1,5)><$comeff(1,9)><$motion(1,659)><$facial(1,5)>Bueno, ya lo decidí: voy a mudarme aquí. Espero que no<br>te suponga ningún inconveniente."

#. en: <$voicel(1,7)><$emotion(1,27)>Why, hello, there! Welcome to my restaurant!<clear><br><$voicel(1,7)><$emotion(1,49)>Hee hee—just joking, pumpkin. I actually just found this<br>kitchen!<clear><br><$voicel(1,5)><$comeff(1,6)><$motion(1,666)><$facial(1,4)>But it really is the perfect place for me, wouldn’t you say?<br>I’ll be living here from now on, <$voicel(1,8)><$emotion(1,14)>so I hope to see<slide><br>you around!<clear><br><$voicel(1,9)><$comeff(1,9)><$motion(1,664)>If you’re ever hungry, just let me know anytime—we can<br>cook up something tasty together!
msgctxt "3255:343"
msgid "<$voicel(1,7)><$emotion(1,27)>¡Adelante, pase! ¡Le doy la bienvenida a mi restaurante!<clear><br><$voicel(1,7)><$emotion(1,49)>¡Que estoy de broma, tesorete! Acabo de dar con esta<br>cocina tan maja y estaba fantaseando un poco. ¡Jus, jus!<clear><br><$voicel(1,5)><$motion(1,666)><$facial(1,4)>Parece que la hayan hecho pa mí, <$comeff(1,6)>¿sí o no?<clear><br><$voicel(1,8)><$emotion(1,14)>Pues, ¿sabes qué? ¡Que me voy a quedar a vivir aquí!<br>Te va a tocar aguantarme.<clear><br><$voicel(1,9)><$comeff(1,9)><$motion(1,664)>Así que ya sabes: si te entra la hambruna en algún<br>momento, ¡aquí estaré yo pa ayudarte en los fogones!"
msgstr "<$voicel(1,7)><$emotion(1,27)>¡Adelante, pase! ¡Le doy la bienvenida a mi restaurante!<clear><br><$voicel(1,7)><$emotion(1,49)>¡Es broma, tesoro! Acabo de dar con esta<br>cocina tan linda y estaba fantaseando un poco. ¡Jus, jus!<clear><br><$voicel(1,5)><$motion(1,666)><$facial(1,4)>Parece que la hubieran hecho pa mí, <$comeff(1,6)>¿sí o no?<clear><br><$voicel(1,8)><$emotion(1,14)>Pues, ¿sabes qué? ¡Que me voy a quedar a vivir aquí!<br>Te va a tocar aguantarme.<clear><br><$voicel(1,9)><$comeff(1,9)><$motion(1,664)>Así que ya sabes: si te entra la hambruna en algún<br>momento, ¡aquí estaré yo pa ayudarte en la cocina!"

#. en: <$se2d(1092)>*rumble rumble rumble*<br><wait(1.0)><$voicel(1,4)><$comeff(1,14)><$motion(1,666)>This here food sure looks tasty!<wait(1.2)><$comcan(1)><$motion(0,824)><wait(1.4)><$motion(0,652)><wait(0.7)><clear><br><$voicel(1,7)><$comeff(1,5)><$motion(1,665)>Say what, now? YOU brought it? Fer ME?!<clear><br><$voicel(1,5)><$comeff(1,21)><$motion(1,659)>Well ain’t that nice o’ ya! Say, why don’t we be friends?
msgctxt "3255:344"
msgid "<$se2d(1092)>Gru, gru... Grrrrrrrrr...<wait(1.0)> <$voicel(1,4)><$comeff(1,14)><$motion(1,666)>Qué buena pinta tiene...<wait(1.2)><$comcan(1)><$motion(0,824)><wait(1.4)><$motion(0,652)><wait(0.7)><clear><br><$voicel(1,7)><$comeff(1,5)><$motion(1,665)>¿Cómo? ¿Que has preparado tú eso? ¡¿Y que puedo<br>comérmelo?!<clear><br><$voicel(1,5)><$comeff(1,21)><$motion(1,659)>¡Tú sí que sabes cómo alegrarle el día a un<gen;-3(o,a)>, zaga<gen;-2(l,la)>!<br>¿Quieres que seamos amigos?"
msgstr "<$se2d(1092)>Gru, gru... Grrrrrrrrr...<wait(1.0)> <$voicel(1,4)><$comeff(1,14)><$motion(1,666)>Qué rico se ve...<wait(1.2)><$comcan(1)><$motion(0,824)><wait(1.4)><$motion(0,652)><wait(0.7)><clear><br><$voicel(1,7)><$comeff(1,5)><$motion(1,665)>¿Cómo? ¿Que preparaste tú eso? ¡¿Y que puedo<br>comérmelo?!<clear><br><$voicel(1,5)><$comeff(1,21)><$motion(1,659)>¡Tú sí que sabes cómo alegrarle el día a un<gen;-3(o,a)>, zaga<gen;-2(l,la)>!<br>¿Quieres que seamos amigos?"

#. en: <$voicel(1,5)><$comeff(1,6)><$motion(1,805)>Huh? Who are you? I’m thinkin’ about making this place<br>my home—<$voicel(1,8)><$emotion(1,14)>hope ya don’t mind the extra company!<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,666)><$facial(1,2)>Say, that’s a pretty heavy-duty bag you’re carrying...<br><$voicel(1,4)><$emotion(1,29)>Whatcha got in there?<clear><br><$voicel(1,7)><$emotion(1,49)>If you have cool stuff, you gotta show me! I bet I could use<br>it to make even awesomer stuff!
msgctxt "3255:345"
msgid "<$voicel(1,5)><$comeff(1,6)><$motion(1,805)>¿Oh? ¿A quién tenemos aquí? He decidido venirme<br>a vivir aquí, <$voicel(1,8)><$emotion(1,14)>¡así que espero que nos llevemos bien!<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,666)><$facial(1,2)>Uh... Ahora que me fijo, esa cosa que llevas colgada<br>a la espalda tiene pinta de pesar un quintal y medio.<clear><br><$voicel(1,4)><$emotion(1,29)>¿Qué llevas ahí metido, si puede saberse?<clear><br><$voicel(1,7)><$emotion(1,49)>¡Si tienes algún material chulo, enséñamelo, tuerquita!<br>¡Estas manitas se encargan del resto!"
msgstr "<$voicel(1,5)><$comeff(1,6)><$motion(1,805)>¿Oh? ¿A quién tenemos aquí? Decidí venirme<br>a vivir aquí, <$voicel(1,8)><$emotion(1,14)>¡así que espero que nos llevemos bien!<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,666)><$facial(1,2)>Uh... Ahora que me fijo, esa cosa que llevas colgada<br>a la espalda parece pesar un quintal y medio.<clear><br><$voicel(1,4)><$emotion(1,29)>¿Qué llevas ahí metido, si puede saberse?<clear><br><$voicel(1,7)><$emotion(1,49)>¡Si tienes algún material genial, enséñamelo, tuerquita!<br>¡Estas manitas se encargan del resto!"

#. en: <$voicel(1,9)><$emotion(1,14)>Whoa—what a MAGNIFICENT area! It’s like this place was<br><$voicel(1,8)>just MADE for me!<wait(1.0)><$motion(0,824)><wait(1.4)><$motion(0,652)><wait(0.7)><clear><br><$voicel(1,5)><$comeff(1,6)><$motion(1,666)>Hmm? Oh, uh, you the one who made it?<clear><br><$voicel(1,7)><$emotion(1,49)>Heh, you’ve got some artistic sense, I’ll give you that. You<br>should drop by and check out my art sometime.
msgctxt "3255:346"
msgid "<$voicel(1,9)><$emotion(1,14)>¡Oooh! Pero este atelier... ¡es soberbio!<clear><br>Es casi como si alguien supiese que iba a pasar por aquí<br><$voicel(1,8)>y lo hubiese dejado preparado para mí.<wait(1.0)><$motion(0,824)><wait(1.4)><$motion(0,652)><wait(0.7)><clear><br><$voicel(1,5)><$comeff(1,6)><$motion(1,666)>¿Oh? ¡No me digas que es una de tus obras maestras!<clear><br><$voicel(1,7)><$emotion(1,49)>Pues deja que te diga que tienes un sentido estético<br>ex-qui-si-to. Dime, ¿te gusta el arte?<clear><br>¿Te gustaría ver algunas de mis obras, aprovechando<br>que estás aquí?"
msgstr "<$voicel(1,9)><$emotion(1,14)>¡Oooh! Pero este atelier... ¡es soberbio!<clear><br>Es casi como si alguien supiera que iba a pasar por aquí<br><$voicel(1,8)>y lo hubiera dejado preparado para mí.<wait(1.0)><$motion(0,824)><wait(1.4)><$motion(0,652)><wait(0.7)><clear><br><$voicel(1,5)><$comeff(1,6)><$motion(1,666)>¿Oh? ¡No me digas que es una de tus obras maestras!<clear><br><$voicel(1,7)><$emotion(1,49)>Pues deja que te diga que tienes un sentido estético<br>ex-qui-si-to. Dime, ¿te gusta el arte?<clear><br>¿Te gustaría ver algunas de mis obras, aprovechando<br>que estás aquí?"

#. en: <$voicel(1,5)><$comeff(1,10)><$motion(1,803)>Yo yo yooo! You vibin’, friend? I know I sure am! And you<br>know why? <$voicel(1,8)><$emotion(1,8)>It’s ’cause I found this totally SWEET home!<wait(1.0)><$motion(0,824)><wait(1.4)><$motion(0,652)><wait(0.7)><clear><br><$voicel(1,5)><$comeff(1,3)><$motion(1,807)>Say WHAAAT?! You MADE this place?
msgctxt "3255:347"
msgid "<$voicel(1,5)><$comeff(1,10)><$motion(1,803)>¡Ey! ¿Qué pasa, tí<gen;-2(ooo,aaa)>? ¿Desfasando o en plan chill?<br>¡Yo, desde luego, estoy on fireee!<clear><br><$voicel(1,8)><$emotion(1,8)>¡Y como para no estarlo! ¡No veas el spot tan flama que<br>he pillado para vivir!<wait(1.0)><$motion(0,824)><wait(1.4)><$motion(0,652)><wait(0.7)><clear><br><$voicel(1,5)><$comeff(1,3)><$motion(1,807)>¡Venga yaaa! ¿Que lo has preparado tú? ¡Mis dieces!"
msgstr "<$voicel(1,5)><$comeff(1,10)><$motion(1,803)>¡Ey! ¿Qué tal, amig<gen;-2(ooo,aaa)>? ¿De fiesta o en modo chill?<br>¡Yo, desde luego, estoy on fireee!<clear><br><$voicel(1,8)><$emotion(1,8)>¡Y como para no estarlo! ¡No sabes qué spot tan épico<br>conseguí para vivir!<wait(1.0)><$motion(0,824)><wait(1.4)><$motion(0,652)><wait(0.7)><clear><br><$voicel(1,5)><$comeff(1,3)><$motion(1,807)>¡No puede seeer! ¿Que lo preparaste tú? ¡Te luciste!"

#. en: <$voicel(1,9)><$comeff(1,5)><$motion(1,665)>You’re TOO GOOD, yo! That makes the vibes here<br>even better!<clear><br><$voicel(1,7)><$comeff(1,9)><$motion(1,806)>So we’re basically best friends now, yeah?! Let’s party<br>right, twin—WOOO!
msgctxt "3255:348"
msgid "<$voicel(1,9)><$comeff(1,5)><$motion(1,665)>Tú tienes unas pintas tremendas de fliparlo, ¿no, amig<gen;-2(o,a)>?<br>Venga, ¡la fiesta está ON, p'alante y sin frenos!<clear><br><$voicel(1,7)><$comeff(1,9)><$motion(1,806)>¡Me has caído genial, <gen;-2(brother,sister)>! A partir de ahora seremos<br>amigos del alma. ¡Venga, que no decaiga la cosa! YEAH!"
msgstr "<$voicel(1,9)><$comeff(1,5)><$motion(1,665)>Se nota que tú también estás alucinando, ¿no, amig<gen;-2(o,a)>?<br>Vamos, ¡la fiesta está ON, p'alante y sin frenos!<clear><br><$voicel(1,7)><$comeff(1,9)><$motion(1,806)>¡Me caíste genial, <gen;-2(brother,sister)>! A partir de ahora seremos<br>amigos del alma. ¡Vamos, que no decaiga la cosa! YEAH!"

#. en: <$voicel(1,7)><$emotion(1,49)>Whoa! It’s been a minute since I’ve seen another Pokémon!<br><$voicel(1,6)><$comeff(1,14)><$motion(1,666)>I’ve been all alone here for a while.<clear><br><$voicel(1,3)><$emotion(1,14)><$motion(1,806)>I might wanna follow you outta here <$voicel(1,10)><$comeff(1,9)><$motion(1,817)>and explore the wider<br>world! So I don’t lose my edge, y’know?
msgctxt "3255:349"
msgid "<$voicel(1,7)><$emotion(1,49)>¡Oh! ¡Hacía la tira que no me topaba con otro Pokémon!<br><$voicel(1,6)><$comeff(1,14)><$motion(1,666)>Se nota que llevo aquí demasiado tiempo...<clear><br><$voicel(1,3)><$emotion(1,14)><$motion(1,806)>¿Qué te parece si salimos a estirar un poco las patas?<clear><br><$voicel(1,10)><$comeff(1,9)><$motion(1,817)>¡Me apetece pegarme una buena carrerita después<br>de tanto tiempo apalancad<gen;-3(o,a)> aquí!"
msgstr "<$voicel(1,7)><$emotion(1,49)>¡Oh! ¡Hacía muchísimo que no me topaba con otro Pokémon!<br><$voicel(1,6)><$comeff(1,14)><$motion(1,666)>Se nota que llevo aquí demasiado tiempo...<clear><br><$voicel(1,3)><$emotion(1,14)><$motion(1,806)>¿Qué te parece si salimos a estirar un poco las patas?<clear><br><$voicel(1,10)><$comeff(1,9)><$motion(1,817)>¡Tengo ganas de darme una buena carrerita después<br>de tanto tiempo encerrad<gen;-3(o,a)> aquí!"

#. en: <$voicel(1,5)><$comeff(1,16)><$motion(1,807)>*yaaawn* Dang—what a great nap!<clear><br><$voicel(1,4)><$emotion(1,14)>Oh, hey! Who are you? You need me for somethin’?<$motion(0,824)><wait(1.0)><wait(0.8)><$motion(0,652)><wait(0.5)><clear><br><$voicel(1,5)><$comeff(1,6)><$motion(1,805)>Huh? You wanna be my friend?<clear><br><$voicel(1,7)><$emotion(1,8)>Ahaha! HECK YEAH! Let’s be buddies! Come chat with me<br>whenever you have time!
msgctxt "3255:350"
msgid "<$voicel(1,5)><$comeff(1,16)><$motion(1,807)>Uaaah... ¡He dormido como un tronco! Hmm... <$voicel(1,4)><$emotion(1,14)>¿Hm?<br>¿Y tú quién eres? ¿Vienes a pedirme algo?<$motion(0,824)><wait(1.0)><wait(0.8)><$motion(0,652)><wait(0.5)><clear><br><$voicel(1,5)><$comeff(1,6)><$motion(1,805)>¿Cómo? ¿Que quieres ser mi amig<gen;-2(o,a)>?<clear><br><$voicel(1,7)><$emotion(1,8)>¡Ja, jaaa! ¡Me parece estupendo! ¡Pues habrá que hablar<br>por los codos para conocernos mejor!"
msgstr "<$voicel(1,5)><$comeff(1,16)><$motion(1,807)>Uaaah... ¡Dormí como un tronco! Hmm... <$voicel(1,4)><$emotion(1,14)>¿Hm?<br>¿Y tú quién eres? ¿Vienes a pedirme algo?<$motion(0,824)><wait(1.0)><wait(0.8)><$motion(0,652)><wait(0.5)><clear><br><$voicel(1,5)><$comeff(1,6)><$motion(1,805)>¿Cómo? ¿Que quieres ser mi amig<gen;-2(o,a)>?<clear><br><$voicel(1,7)><$emotion(1,8)>¡Ja, jaaa! ¡Me parece estupendo! ¡Pues habrá que hablar<br>por los codos para conocernos mejor!"

#. en: <$voicel(1,5)><$emotion(1,14)>... ... ...<br>Hm. I did not expect any visitors here.<clear><br><$voicel(1,3)><$comeff(1,14)><$motion(1,666)>I’ve been on my own here for quite some time... I suppose<br>this is as good an opportunity as any to venture outside.<clear><br><$voicel(1,5)><$emotion(1,38)>And I’d like to learn more about you as well.
msgctxt "3255:351"
msgid "<$voicel(1,5)><$emotion(1,14)>Hm. No esperaba ver a nadie por aquí.<clear><br><$voicel(1,3)><$comeff(1,14)><$motion(1,666)>He pasado mucho tiempo aquí en soledad. Demasiado.<br>Tal vez esta sea mi señal para salir al exterior.<clear><br><$voicel(1,5)><$emotion(1,38)>Estaré encantad<gen;-3(o,a)> de intercambiar ideas contigo."
msgstr "<$voicel(1,5)><$emotion(1,14)>Hm. No esperaba ver a nadie por aquí.<clear><br><$voicel(1,3)><$comeff(1,14)><$motion(1,666)>Pasé mucho tiempo aquí en soledad. Demasiado.<br>Tal vez esta sea mi señal para salir al exterior.<clear><br><$voicel(1,5)><$emotion(1,38)>Estaré encantad<gen;-3(o,a)> de intercambiar ideas contigo."

#. en: <$voicel(1,5)><$comeff(1,6)><$motion(1,805)>Whoa, whoa, whoa! What’s with the merrymakin’ you’ve<br>got goin’ on here?<clear><br><$voicel(1,7)><$emotion(1,14)>A par...ty? You get all your buds together to have a good<br>time? <$voicel(1,10)><$emotion(1,8)>That sounds pretty awesome!<clear><br><$voicel(1,5)><$comeff(1,6)><$motion(1,666)>Hey, whaddya say to us bein’ buds? <$voicel(1,8)><$emotion(1,38)>I wanna get in on<br>these parties of yours too!
msgctxt "3255:352"
msgid "<$voicel(1,5)><$motion(1,805)>Epa, <$comeff(1,6)>¿qué pasa aquí? ¿Por qué está esto tan animao?<clear><br><$voicel(1,7)><$emotion(1,14)>Oh, ¿así que se llama \"fiestuqui\" y consiste en reunirse<br>con amigos pa pasarlo en grande? <$voicel(1,10)><$emotion(1,8)>¡Qué ideaza!<clear><br><$voicel(1,5)><$motion(1,666)>Espero no parecer oportunista, pero <$comeff(1,6)>¿te gustaría tenerme<br>como amig<gen;-3(o,a)>?<clear><br><$voicel(1,8)><$emotion(1,38)>¡Yo también quiero pasármelo pipa en la fiestuqui esta!"
msgstr "<$voicel(1,5)><$motion(1,805)>Epa, <$comeff(1,6)>¿qué pasa aquí? ¿Por qué está esto tan animao?<clear><br><$voicel(1,7)><$emotion(1,14)>Oh, ¿así que se llama \"fiestita\" y consiste en reunirse<br>con amigos pa pasarla en grande? <$voicel(1,10)><$emotion(1,8)>¡Qué ideaza!<clear><br><$voicel(1,5)><$motion(1,666)>Espero no parecer oportunista, pero <$comeff(1,6)>¿te gustaría tenerme<br>como amig<gen;-3(o,a)>?<clear><br><$voicel(1,8)><$emotion(1,38)>¡Yo también quiero pasarla genial en la fiestita esta!"

#. en: <$voicel(1,5)><$comeff(1,6)><$motion(1,666)>I came ’cause I heard the bell ringin’, but I wasn’t expectin’<br>to find a Pokémon. You...are a Pokémon, aren’t ya?<slide><br><$voicel(1,8)><$emotion(1,14)><$facial(1,4)>Anyway, nice to meet ya!<clear><br><$voicel(1,5)><$emotion(1,38)>I usually fly around this area, so if you ever wanna chat,<br><$voicel(1,8)><$comeff(1,9)><$motion(1,803)>just ring that bell again!
msgctxt "3255:353"
msgid "<$voicel(1,5)><$comeff(1,6)><$motion(1,666)>He venido aquí, atraíd<gen;-3(o,a)> por el sonido del cascabel,<br>y ¿qué me encuentro? ¿<gen;-2(Un,Una)> Pokémon?<clear><br><$voicel(1,8)><$emotion(1,14)><$facial(1,4)>Pues nada podría alegrarme más, qué quieres que te diga.<br>¡U<gen;-2(n,na)> nuev<gen;-2(o,a)> amig<gen;-2(o,a)> pa la saca!<clear><br><$voicel(1,5)><$emotion(1,38)>Me encontrarás sobrevolando los cielos de esta zona<br>con frecuencia.<clear><br>Cuando quieras hablar, <$voicel(1,8)><$comeff(1,9)><$motion(1,803)>¡tan solo tienes que hacer sonar<br>el cascabel!"
msgstr "<$voicel(1,5)><$comeff(1,6)><$motion(1,666)>Vine aquí, atraíd<gen;-3(o,a)> por el sonido del cascabel,<br>y ¿qué me encuentro? ¿<gen;-2(Un,Una)> Pokémon?<clear><br><$voicel(1,8)><$emotion(1,14)><$facial(1,4)>Pues nada podría alegrarme más, qué quieres que te diga.<br>¡U<gen;-2(n,na)> nuev<gen;-2(o,a)> amig<gen;-2(o,a)> pa la colección!<clear><br><$voicel(1,5)><$emotion(1,38)>Me encontrarás sobrevolando los cielos de esta zona<br>con frecuencia.<clear><br>Cuando quieras hablar, <$voicel(1,8)><$comeff(1,9)><$motion(1,803)>¡tan solo tienes que hacer sonar<br>el cascabel!"

#. en: <$voicel(1,3)><$comeff(1,21)><$motion(1,666)>That bell has SUCH a lovely and soothing tone...<clear><br><$voicel(1,5)><$emotion(1,14)>AND I’ve met a new Pokémon! Oh, today IS a good day!<clear><br><$voicel(1,7)><$emotion(1,38)>I’ll come visit again when I hear that bell, so I hope we’ll<br>get along!
msgctxt "3255:354"
msgid "<$voicel(1,3)><$comeff(1,21)><$motion(1,666)>Oy, qué melodía tan agradable la de ese cascabelillo...<clear><br><$voicel(1,5)><$emotion(1,14)>Y además me ha traído direct<gen;-3(o,a)> hasta <gen;-2(un,una)> nuev<gen;-2(o,a)> Pokémon.<br>¡El día no podría ir mejor!<clear><br><$voicel(1,7)><$emotion(1,38)>Haz sonar el cascabel cada vez que te apetezca hablar<br>conmigo, criatura, y vendré a verte."
msgstr "<$voicel(1,3)><$comeff(1,21)><$motion(1,666)>Oy, qué melodía tan agradable la de ese cascabelito...<clear><br><$voicel(1,5)><$emotion(1,14)>Y además me trajo direct<gen;-3(o,a)> hasta <gen;-2(un,una)> nuev<gen;-2(o,a)> Pokémon.<br>¡El día no podría ir mejor!<clear><br><$voicel(1,7)><$emotion(1,38)>Haz sonar el cascabel cada vez que quieras hablar<br>conmigo, criatura, y vendré a verte."

#. en: <$voicel(1,7)><$emotion(1,14)>Howdy! Sure is nice runnin’ into you again. It’s been a<br>while, huh?<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,666)>I sometimes hear y’all laughin’ it up on the surface while<br>I’m restin’ underwater. <$voicel(1,8)><$comeff(1,21)><$motion(1,806)>Always sounds like a good time!<clear><br><$voicel(1,10)><$emotion(1,38)>Can’t have too many good times, if ya ask me! Keep ’em<br>comin’, ya hear?
msgctxt "3255:355"
msgid "<$voicel(1,7)><$emotion(1,14)>¡Dichosos los ojos! ¡Cuánto me alegro de verte de nuevo!<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Como vivo en el fondo marino, a veces me llegan ecos<br>de vuestras risillas <$voicel(1,8)><$comeff(1,21)><$motion(1,806)>y lo cierto es que me alegran el día.<clear><br><$voicel(1,10)><$emotion(1,38)>¡Seguid disfrutando de la vida, jóvenes! Que no os falten<br>las ganas de pasarlo bien."
msgstr "<$voicel(1,7)><$emotion(1,14)>¡Dichosos los ojos! ¡Cuánto me alegro de verte de nuevo!<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Como vivo en el fondo marino, a veces me llegan ecos<br>de sus risitas <$voicel(1,8)><$comeff(1,21)><$motion(1,806)>y lo cierto es que me alegran el día.<clear><br><$voicel(1,10)><$emotion(1,38)>¡Sigan disfrutando de la vida, jóvenes! Que no les falten<br>las ganas de pasarla bien."

#. en: <$voicel(1,5)><$comeff(1,14)><$motion(1,666)>I got woken from a deep sleep by a buncha laughter on<br>the surface... That was y’all, wasn’t it?<clear><br><$voicel(1,7)><$emotion(1,49)>Gwahaha! Sure sounded like y’all were havin’ a good time!<br>It’s infectious, really! Bet I’ll have fun dreams tonight!<clear><br><$voicel(1,5)><$emotion(1,8)>Keep up the good times, ya hear? I’d love to hear y’all’s<br>voices again. I’ll be listenin’ fer yer merrymakin’!
msgctxt "3255:356"
msgid "<$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Me pareció oír unas risas provenientes de la superficie<br>terrestre y... ¡resulta que eran vuestras!<clear><br><$voicel(1,7)><$emotion(1,49)>¡Bua, ja, ja! ¡Pues seguid pasándolo así de bien, jóvenes!<clear><br>Gracias a eso, seguro que hoy duermo mejor que nunca<br>y tengo sueños la mar de apacibles.<clear><br><$voicel(1,5)><$emotion(1,8)>Pase lo que pase, ¡que nadie os quite esas ganas de vivir!<br>Espero que vuestras risas vuelvan a alegrarme el día."
msgstr "<$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Me pareció oír unas risas provenientes de la superficie<br>terrestre y... ¡resulta que eran de ustedes!<clear><br><$voicel(1,7)><$emotion(1,49)>¡Bua, ja, ja! ¡Pues sigan pasándola así de bien, jóvenes!<clear><br>Gracias a eso, seguro que hoy duermo mejor que nunca<br>y tengo sueños muy apacibles.<clear><br><$voicel(1,5)><$emotion(1,8)>Pase lo que pase, ¡que nadie les quite esas ganas de vivir!<br>Espero que sus risas vuelvan a alegrarme el día."

#. en: <$comeff(1,21)><$motion(1,801)><$voicel(1,9)>Shell, shell, shelllll... I’m so relaxed... <$comeff(1,9)><$motion(1,803)><$voicel(1,8)>This place is perfect<br>for hiding!<clear><br><$comeff(1,6)><$motion(1,805)><$voicel(1,5)>Oh, hey! Wanna chill here together? <$comeff(1,10)><$facial(1,4)><$motionoff(1,804)><$voicel(1,10)>Shell, shelllll...
msgctxt "3255:357"
msgid "<$comeff(1,21)><$motion(1,801)><$voicel(1,9)>She, she, sheeell... Jolín, qué tranquil<gen;-3(o,a)> se está aquí.<br><wait(1.0)><$comeff(1,9)><$motion(1,803)><$voicel(1,8)>Este sitio es perfecto para esconderse.<clear><br>O-oye... <$comeff(1,6)><$motion(1,805)><$voicel(1,5)>¿quieres quedarte a descansar conmigo?<br><wait(1.0)><$comeff(1,10)><$facial(1,4)><$motionoff(1,804)><$voicel(1,10)>She, sheeell..."
msgstr "<$comeff(1,21)><$motion(1,801)><$voicel(1,9)>She, she, sheeell... Ay, qué tranquil<gen;-3(o,a)> se está aquí.<br><wait(1.0)><$comeff(1,9)><$motion(1,803)><$voicel(1,8)>Este lugar es perfecto para esconderse.<clear><br>O-oye... <$comeff(1,6)><$motion(1,805)><$voicel(1,5)>¿quieres quedarte a descansar conmigo?<br><wait(1.0)><$comeff(1,10)><$facial(1,4)><$motionoff(1,804)><$voicel(1,10)>She, sheeell..."

#. en: <$comeff(1,5)><$motion(1,803)><$voicel(1,9)>Whoooaaa! Almost bumped into somethin’ again!<clear><br><$emotion(1,38)><$voicel(1,7)>Phew. Y’see, I jus’ bumped into a big boulder a minute ago<br>’n’ sent it flyin’! <$emotion(1,51)><$voicel(1,6)>Glad I didn’t do that to you too!<clear><br><$emotion(1,14)><$voicel(1,7)>This big ol’ shell o’ mine gets in the way from time to time,<br><$emotion(1,38)><$voicel(1,10)>but I hope you’ll lemme hang around anyhow! Gwahaha!
msgctxt "3255:358"
msgid "<$comeff(1,5)><$motion(1,803)><$voicel(1,9)>¡Caramba, casi vuelvo a chocarme con algo!<clear><br><$emotion(1,38)><$voicel(1,7)>Antes me he dado de lleno contra una roca y ha salido<br>disparada.<clear><br><$emotion(1,51)><$voicel(1,6)>Menos mal que no me he estampado también contra ti...<clear><br><$emotion(1,14)><$voicel(1,7)>Esto de ser tan grandull<gen;-3(ón,ona)> a veces es un incordio de<br>aúpa. <$emotion(1,38)><$voicel(1,10)>En fin, espero que nos volvamos a ver, ¡bua, ja, ja!"
msgstr "<$comeff(1,5)><$motion(1,803)><$voicel(1,9)>¡Caramba, casi vuelvo a chocarme con algo!<clear><br><$emotion(1,38)><$voicel(1,7)>Antes me di de lleno contra una roca y salió<br>disparada.<clear><br><$emotion(1,51)><$voicel(1,6)>Menos mal que no me estampé también contra ti...<clear><br><$emotion(1,14)><$voicel(1,7)>Esto de ser tan grandull<gen;-3(ón,ona)> a veces es un fastidio<br>total. <$emotion(1,38)><$voicel(1,10)>En fin, espero que nos volvamos a ver, ¡bua, ja, ja!"

#. en: <$comeff(1,9)><$motion(1,801)><$voicel(1,9)>Hey! Nice to meetcha! The coral here is so nice and round,<br>don’tcha think?<clear><br><$comeff(1,21)><$motion(1,661)><$voicel(1,6)>Hiding in spots like this is so calming... <$comeff(1,3)><$motion(1,803)><$voicel(1,7)>Um, we should<br>relax here together, if you wanna!
msgctxt "3255:359"
msgid "<$comeff(1,9)><$motion(1,801)><$voicel(1,9)>Anda, hola. E-encantad<gen;-3(o,a)>... Qué corales tan redonditos<br>tenéis por aquí, ¿no? Me gustan mucho...<clear><br><$comeff(1,21)><$motion(1,661)><$voicel(1,6)>Me vienen de maravilla para esconderme y estar más<br>tranquil<gen;-3(o,a)> cuando no me apetece que nadie me vea...<clear><br><$comeff(1,3)><$motion(1,803)><$voicel(1,7)>S-si te apetece, puedes venir a relajarte conmigo..."
msgstr "<$comeff(1,9)><$motion(1,801)><$voicel(1,9)>Oh, hola. E-encantad<gen;-3(o,a)>... Qué corales tan redonditos<br>tienen por aquí, ¿no? Me gustan mucho...<clear><br><$comeff(1,21)><$motion(1,661)><$voicel(1,6)>Me vienen de maravilla para esconderme y estar más<br>tranquil<gen;-3(o,a)> cuando no quiero que nadie me vea...<clear><br><$comeff(1,3)><$motion(1,803)><$voicel(1,7)>S-si quieres, puedes venir a relajarte conmigo..."

#. en: <$comeff(1,5)><$motionoff(1,804)><$voicel(1,9)>Whoa, whoa, WHOA! You tryin’ to trash my turf?<clear><br><$comeff(1,14)><$motion(1,814)><$voicel(1,7)>Bring it on! You see these spikes? They sting real bad<br>when I stick ’em—<clear><br><$comeff(1,6)><$motion(1,805)><$voicel(1,5)>...Say what? You made this sweet spot? <wait(0.4)><$emotion(1,60)><$voicel(1,9)>Dang, you shoulda<br>opened with that, pal!<clear><br><$emotion(1,8)><$voicel(1,9)>I’ve decided I’m gonna live here from now on, so swim on<br>by sometime!
msgctxt "3255:360"
msgid "<$comeff(1,5)><$motionoff(1,804)><$voicel(1,9)>¡Oye! ¿Tú de qué vas? Has venido a liarla a mi territorio,<br>¿o qué?<clear><br><$comeff(1,14)><$motion(1,814)><$voicel(1,7)>Pues ojito, ¿eh? ¡Que como te pique con mis púas vas a<br>ver las estrellas!<clear><br>... <wait(1.0)><$comeff(1,6)><$motion(1,805)><$voicel(1,5)>¿Eh? ¿Eres tú quien me ha preparado esta keli?<wait(1.0)><br><$emotion(1,60)><$voicel(1,9)>Pero bueno, ¡haberlo dicho antes!<clear><br><$emotion(1,8)><$voicel(1,9)>He decidido quedarme a vivir aquí, así que me alegro<br>de haberte conocido y tal."
msgstr "<$comeff(1,5)><$motionoff(1,804)><$voicel(1,9)>¡Oye! ¿Qué te traes? Viniste a armar lío a mi territorio,<br>¿o qué?<clear><br><$comeff(1,14)><$motion(1,814)><$voicel(1,7)>Pues ojito, ¿eh? ¡Que si te pico con mis púas vas a<br>ver las estrellas!<clear><br>... <wait(1.0)><$comeff(1,6)><$motion(1,805)><$voicel(1,5)>¿Eh? ¿Eres tú quien me preparó esta casita?<wait(1.0)><br><$emotion(1,60)><$voicel(1,9)>Pero bueno, ¡haberlo dicho antes!<clear><br><$emotion(1,8)><$voicel(1,9)>Decidí quedarme a vivir aquí, así que me alegro<br>de haberte conocido y tal."

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Whoa! A human! Time to play! <wait(0.4)><$comeff(1,5)><$motion(1,814)><$voicel(1,6)>*chomp*<clear><br><$comeff(1,7)><$facial(1,9)><$motion(1,802)><$voicel(1,4)>Huh? I missed... <wait(1.5)><$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,7)>Hold up—you’re <$cdef(27)>Ditto</color>!<clear><br><$comeff(1,4)><$facial(1,9)><$motion(1,807)><$voicel(1,7)>Sorry for trying to bite you.<clear><br><$comeff(1,3)><$facial(1,2)><$motion(1,805)><$voicel(1,5)>I just can’t help it when I see someone moving around<br>like that. <wait(0.4)><$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,10)>But I’ll be careful from now on!
msgctxt "3255:361"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Ualaaa, ¡<gen;-2(un,una)> human<gen;-2(ooo,aaa)>! ¡Vamos a jugar, vengaaa!<clear><br><$comeff(1,5)><$motion(1,814)><$voicel(1,6)>¡Ñaaam!<clear><br><$comeff(1,7)><$facial(1,9)><$motion(1,802)><$voicel(1,4)>¿Eh? Anda, he fallado...<wait(1.5)><$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,7)> ¡¡Un momento!! Ahora que me fijo<br>bien, tú eres un <$cdef(27)>Ditto</color> gastándome una broma, ¿a que síii?<clear><br><$comeff(1,4)><$facial(1,9)><$motion(1,807)><$voicel(1,7)>Ay... Perdona, que casi te pego un bocado antes.<clear><br><$comeff(1,3)><$facial(1,2)><$motion(1,805)><$voicel(1,5)>Es que cuando veo una cosa moverse de un lado a otro,<br>no puedo resistirme...<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,10)>Tendré más cuidado a partir de ahora, te lo prometo."
msgstr "<$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Guaaau, ¡<gen;-2(un,una)> human<gen;-2(ooo,aaa)>! ¡Vamos a jugar, vamooos!<clear><br><$comeff(1,5)><$motion(1,814)><$voicel(1,6)>¡Ñaaam!<clear><br><$comeff(1,7)><$facial(1,9)><$motion(1,802)><$voicel(1,4)>¿Eh? Vaya, fallé...<wait(1.5)><$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,7)> ¡¡Un momento!! Ahora que me fijo<br>bien, tú eres un <$cdef(27)>Ditto</color> haciéndome una broma, ¿verdaaad?<clear><br><$comeff(1,4)><$facial(1,9)><$motion(1,807)><$voicel(1,7)>Ay... Perdona, casi te doy un mordisco hace un momento.<clear><br><$comeff(1,3)><$facial(1,2)><$motion(1,805)><$voicel(1,5)>Es que cuando veo una cosa moverse de un lado a otro,<br>no puedo resistirme...<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,10)>Tendré más cuidado a partir de ahora, te lo prometo."

#. en: <$comeff(1,10)><$facial(1,4)><$motionoff(1,804)><$voicel(1,7)>Whoa, this spot’s super spacious! <wait(0.3)><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,10)>The water’s crystal clear,<br>too. Dang, this rules!<$lookat(1,0,0)><$lookat(1,1,0)><waitactor(1)><$facial(1,1)><clear><br><$emotion(1,29)><$voicel(1,7)>Hey, you! What’s your deal, pal? You live around here?<clear><br><$emotion(1,38)><$voicel(1,9)>Great—let’s go swimming together! Nothin’ beats a<br>good swim!
msgctxt "3255:362"
msgid "<$comeff(1,10)><$facial(1,4)><$motionoff(1,804)><$voicel(1,7)>Buaaah, esta zona es enormeee...<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,10)>Y el agua está megalimpia... ¡Mola mazo!<$lookat(1,0,0)><$lookat(1,1,0)><waitactor(1)><$facial(1,1)><clear><br><$emotion(1,29)><$voicel(1,7)>¡Oye, chava<gen;-2(l,la)>! ¿Tú vives por aquí o qué?<clear><br><$emotion(1,38)><$voicel(1,9)>Espero que nos demos unos chapuzones juntos.<br>¡Lo pasaremos genial, ya verás!"
msgstr "<$comeff(1,10)><$facial(1,4)><$motionoff(1,804)><$voicel(1,7)>Guaaau, esta zona es enormeee...<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,10)>Y el agua está megalimpia... ¡Es increíble!<$lookat(1,0,0)><$lookat(1,1,0)><waitactor(1)><$facial(1,1)><clear><br><$emotion(1,29)><$voicel(1,7)>¡Oye, chava<gen;-2(l,la)>! ¿Tú vives por aquí o qué?<clear><br><$emotion(1,38)><$voicel(1,9)>Espero que nos demos unos chapuzones juntos.<br>¡La pasaremos genial, ya verás!"

#. en: <$emotion(1,14)><$voicel(1,5)>Wow! You’re a <$cdef(27)>Ditto</color>, eh? What’re ya doin’ out here?<br><$comeff(1,6)><$motion(1,666)><$voicel(1,6)>And lookin’ like a human, no less!<wait(1.2)><$comeff(0,14)><$motion(0,824)><wait(1.2)><$comcan(0)><$motion(0,652)><wait(0.6)><clear><br><$emotion(1,16)><$voicel(1,8)>What’s that, now? You’re gettin’ this place all spruced up?<wait(1.2)><$voicel(1,10)><$comeff(1,10)><$facial(1,4)><$motion(1,806)><br>Gwahaha! Ain’t you a funny li’l Pokémon!<clear><br><$comeff(1,21)><$motion(1,816)><$facial(1,4)><$voicel(1,5)>Then it’s ’cause of yer hard work that I managed to snag<br>me this mighty fine home! <$emotion(1,8)><$voicel(1,10)>Thank ya kindly, <$cdef(27)>Ditto</color>!
msgctxt "3255:363"
msgid "<$emotion(1,14)><$voicel(1,5)>Vaya, tú eres un <$cdef(27)>Ditto</color>, si no me traicionan ya los ojos...<wait(1.0)><br><$comeff(1,6)><$motion(1,666)><$voicel(1,6)>Pero ¿qué haces con esas pintas en un sitio como este?<wait(1.2)><$comeff(0,14)><$motion(0,824)><wait(1.2)><$comcan(0)><$motion(0,652)><wait(0.6)><clear><br><$emotion(1,16)><$voicel(1,8)>¿Cómo dices? ¿Eres tú quien está adecentando todo esto?<wait(1.2)><br><$voicel(1,10)><$comeff(1,10)><$facial(1,4)><$motion(1,806)>¡Bua, ja, ja! Mira que eres <gen;-2(un mozo curioso,una moza curiosa)>.<clear><br><$comeff(1,21)><$motion(1,816)><$facial(1,4)><$voicel(1,5)>Gracias a ti he dado con este nuevo hogar tan apañado.<wait(0.5)><br><$cdef(27)><$emotion(1,8)></color><$voicel(1,10)>No sabes cuán agradecid<gen;-3(o,a)> te estoy."
msgstr "<$emotion(1,14)><$voicel(1,5)>Vaya, tú eres un <$cdef(27)>Ditto</color>, si no me traicionan ya los ojos...<wait(1.0)><br><$comeff(1,6)><$motion(1,666)><$voicel(1,6)>Pero ¿qué haces con ese aspecto en un lugar como este?<wait(1.2)><$comeff(0,14)><$motion(0,824)><wait(1.2)><$comcan(0)><$motion(0,652)><wait(0.6)><clear><br><$emotion(1,16)><$voicel(1,8)>¿Cómo dices? ¿Eres tú quien está adecentando todo esto?<wait(1.2)><br><$voicel(1,10)><$comeff(1,10)><$facial(1,4)><$motion(1,806)>¡Bua, ja, ja! Mira que eres <gen;-2(un mozo curioso,una moza curiosa)>.<clear><br><$comeff(1,21)><$motion(1,816)><$facial(1,4)><$voicel(1,5)>Gracias a ti di con este nuevo hogar tan cómodo.<wait(0.5)><br><$cdef(27)><$emotion(1,8)></color><$voicel(1,10)>No sabes cuán agradecid<gen;-3(o,a)> te estoy."

#. en: <$emotion(1,14)><$voicel(1,8)>Whoa, hey! Nice to meet you.<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,9)>This place is neat, huh? I feel like my, y’know, light is<br>shining brighter than usual. <$comeff(1,14)><$facial(1,1)><$motion(1,805)><$voicel(1,7)>Means I can see you clearly.<clear><br><$emotion(1,38)><$voicel(1,9)>All right... I memorized exactly how you, uh, look, so...<br>When I see you around, I’ll know who you are!
msgctxt "3255:364"
msgid "<$emotion(1,14)><$voicel(1,8)>Ey, ¿qué hay? Encantad<gen;-3(o,a)> de conocerte.<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,9)>Qué sitio más chulo este, ¿no? Igual son cosas mías,<br>pero diría que mi luz brilla más y todo...<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,805)><$voicel(1,7)>Mira tú qué bien, así puedo verte mejor la cara... A ver...<clear><br><$emotion(1,38)><$voicel(1,9)>Perfe, ahora me acordaré de ti, fijo. Espero verte más por<br>aquí, colegui."
msgstr "<$emotion(1,14)><$voicel(1,8)>Ey, ¿qué hay? Encantad<gen;-3(o,a)> de conocerte.<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,9)>Qué lugar más bonito este, ¿no? Quizás son cosas mías,<br>pero diría que mi luz brilla más y todo...<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,805)><$voicel(1,7)>Mira tú qué bien, así puedo verte mejor la cara... A ver...<clear><br><$emotion(1,38)><$voicel(1,9)>Listo, ahora me acordaré de ti, seguro. Espero verte más por<br>aquí, ¿eh?"

#. en: <$comeff(1,10)><$motion(1,801)><$voicel(1,7)>Why, hello there! How nice to meet you, sweetie!<br>I suppose you must have been drawn here by my light?<clear><br><$comeff(1,9)><$motion(1,805)><$voicel(1,9)>Hee hee. It’s so bright and lovely, isn’t it? It gives off a<br>wonderful shine everywhere I go!<clear><br><$comeff(1,3)><$motion(1,662)><$voicel(1,5)>If you’re ever hoping for a chat with me, hon, just look for<br>my light!
msgctxt "3255:365"
msgid "<$comeff(1,10)><$motion(1,801)><$voicel(1,7)>Vaya, encantad<gen;-3(o,a)> de conocerte, tesoro. ¿Acaso has venido<br><gen;-2(atraído,atraída)> por la luz que emito?<clear><br><$comeff(1,9)><$motion(1,805)><$voicel(1,9)>No solo tiene un brillo precioso; también viene de perlas.<br>Da igual dónde me encuentre, que nunca estaré a oscuras.<clear><br><$comeff(1,3)><$motion(1,662)><$voicel(1,5)>Cuando quieras dar conmigo, ya sabes: busca la luz."
msgstr "<$comeff(1,10)><$motion(1,801)><$voicel(1,7)>Vaya, encantad<gen;-3(o,a)> de conocerte, tesoro. ¿Acaso viniste<br><gen;-2(atraído,atraída)> por la luz que emito?<clear><br><$comeff(1,9)><$motion(1,805)><$voicel(1,9)>No solo tiene un brillo precioso; también viene de perlas.<br>Da igual dónde me encuentre, que nunca estaré a oscuras.<clear><br><$comeff(1,3)><$motion(1,662)><$voicel(1,5)>Cuando quieras dar conmigo, ya sabes: busca la luz."

#. en: <$comeff(1,16)><$facial(1,14)><$motion(1,807)><$voicel(1,5)>*yawn* Now, let’s see. What is this place? It certainly has<br>a pleasant atmosphere.<wait(1.0)><$facial(1,1)><$motion(0,824)><wait(1.2)><$motion(0,652)><wait(0.6)><clear><br><$emotion(1,14)><$voicel(1,7)>...What’s that?! You arranged this place for me? <$emotion(1,8)><$voicel(1,10)>That’s<br>very generous. It’s quite comfortable.<clear><br><$comeff(1,6)><$facial(1,1)><$motion(1,805)><$voicel(1,5)>Are you planning to work on other places as well? If so, I’d<br>be pleased to help. <$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,10)>I seem to have slept for a long time,<slide><br>so I’m eager for some physical activity.
msgctxt "3255:366"
msgid "<$comeff(1,16)><$facial(1,14)><$motion(1,807)><$voicel(1,5)>Uuaah... <wait(1.0)>¿Dónde me hallo? No estoy segur<gen;-3(o,a)>, pero me<br>agrada esta atmósfera, he de decir.<wait(1.0)><$facial(1,1)><$motion(0,824)><wait(1.2)><$motion(0,652)><wait(0.6)><clear><br><$emotion(1,14)><$voicel(1,7)>Vaya, ¿de veras has sido tú quien me preparó este hogar?<br><$emotion(1,8)><$voicel(1,10)>Te estoy muy agradecid<gen;-3(o,a)>, resulta la mar de acogedor...<clear><br><$facial(1,1)><$motion(1,805)><$voicel(1,5)>Por curiosidad, <$comeff(1,6)>¿tienes en mente construir más hogares?<br>Si así fuera, puedes contar con mi ayuda.<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,10)>He dormido a aleta suelta y me hallo pletóric<gen;-3(o,a)> de energía."
msgstr "<$comeff(1,16)><$facial(1,14)><$motion(1,807)><$voicel(1,5)>Uuaah... <wait(1.0)>¿Dónde me hallo? No estoy segur<gen;-3(o,a)>, pero me<br>agrada esta atmósfera, he de decir.<wait(1.0)><$facial(1,1)><$motion(0,824)><wait(1.2)><$motion(0,652)><wait(0.6)><clear><br><$emotion(1,14)><$voicel(1,7)>Vaya, ¿de veras fuiste tú quien me preparó este hogar?<br><$emotion(1,8)><$voicel(1,10)>Te estoy muy agradecid<gen;-3(o,a)>, resulta de lo más acogedor...<clear><br><$facial(1,1)><$motion(1,805)><$voicel(1,5)>Por curiosidad, <$comeff(1,6)>¿tienes en mente construir más hogares?<br>Si así fuera, puedes contar con mi ayuda.<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,10)>Dormí a aleta suelta y me hallo pletóric<gen;-3(o,a)> de energía."

#. en: <$emotion(1,14)><$voicel(1,7)>Hehehe... I just knew you’d show up! <$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>My whisker radar was<br>getting all twitchy.<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>I was gonna run away if you were scary, but your face looks<br>kinda droopy and soft. <$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,8)>I think you’re probably friendly!<clear><br><$emotion(1,8)><$voicel(1,10)>I hope we can be friends!
msgctxt "3255:367"
msgid "<$emotion(1,14)><$voicel(1,7)>Je, je... Sabía que ibas a venir hacia aquí...<wait(1.0)><$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,9)> y todo gracias<br>a mis bigotitos, que sirven como radar y me han avisado.<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Tenía pensado huir si me hubieras dado mala espina,<br>pero tienes carita de ser de todo menos peligros<gen;-2(o,a)>...<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,8)>Sí, algo me dice que eres buen<gen;-2(o,a)> y puedo fiarme de ti.<wait(1.0)><br><$emotion(1,8)><$voicel(1,10)>O-ojalá podamos ser <gen;-2(buenos amigos,buenas amigas)>..."
msgstr "<$emotion(1,14)><$voicel(1,7)>Je, je... Sabía que ibas a venir hacia aquí...<wait(1.0)><$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,9)> y todo gracias<br>a mis bigotitos, que sirven como radar y me avisaron.<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Tenía pensado huir si me hubieras dado mala espina,<br>pero tienes carita de ser de todo menos peligros<gen;-2(o,a)>...<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,8)>Sí, algo me dice que eres buen<gen;-2(o,a)> y puedo fiarme de ti.<wait(1.0)><br><$emotion(1,8)><$voicel(1,10)>O-ojalá podamos ser <gen;-2(buenos amigos,buenas amigas)>..."

#. en: <$comeff(1,5)><$facial(1,7)><$motionoff(1,804)><$voicel(1,5)><$textsize(2)>Scaaaaaahhh!</textsize><clear><br><$comeff(1,3)><$motion(1,803)><$voicel(1,2)>This is myyy spot. <wait(1.0)><$comeff(1,10)><$motion(1,816)><$voicel(1,4)>Go awayyy.<clear><br><$comeff(1,14)><$facial(1,2)><$motion(1,802)><$voicel(1,6)>Well, that’s what I would nooormally say...<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>But this spot is reeeaaally nice, so I’m in a good mood.<clear><br><$comeff(1,10)><$motion(1,801)><$voicel(1,9)>I’ll make a special exception just for you... Come see me<br>whenever you waaant.
msgctxt "3255:368"
msgid "<$comeff(1,5)><$facial(1,7)><$motionoff(1,804)><$voicel(1,5)><$textsize(2)>¡Whiiish!</textsize><clear><br><$comeff(1,3)><$motion(1,803)><$voicel(1,2)>¡Este es mi territooorio!<wait(1.0)><$comeff(1,10)><$motion(1,816)><$voicel(1,4)> Hala, ya estás levantando el<br>campamento...<clear><br><$comeff(1,14)><$facial(1,2)><$motion(1,802)><$voicel(1,6)>Eso te diría normalmente, pero... <wait(1.0)><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>este sitio me está<br>gustando tanto que tengo una sonrisa de bigote a bigote.<clear><br><$comeff(1,10)><$motion(1,801)><$voicel(1,9)>Veeenga, por ser tú, te dejo venir cuando te apetezca."
msgstr "<$comeff(1,5)><$facial(1,7)><$motionoff(1,804)><$voicel(1,5)><$textsize(2)>¡Whiiish!</textsize><clear><br><$comeff(1,3)><$motion(1,803)><$voicel(1,2)>¡Este es mi territooorio!<wait(1.0)><$comeff(1,10)><$motion(1,816)><$voicel(1,4)> Vamos, ya estás levantando el<br>campamento...<clear><br><$comeff(1,14)><$facial(1,2)><$motion(1,802)><$voicel(1,6)>Eso te diría normalmente, pero... <wait(1.0)><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>este lugar me está<br>gustando tanto que tengo una sonrisa de bigote a bigote.<clear><br><$comeff(1,10)><$motion(1,801)><$voicel(1,9)>Bueeeno, por ser tú, te dejo venir cuando quieras."

#. en: <$comeff(1,4)><$facial(1,9)><$motion(1,807)><$voicel(1,1)>*pant pant*...<br>Um, hi! Nice to meetcha!<clear><br><$comeff(1,3)><$facial(1,2)><$motion(1,661)><$voicel(1,3)>Sorry, I was just practicing my moves, so I’m all tired out...<br><$comeff(1,14)><$motion(1,805)><$voicel(1,7)>But this place is really comfy and perfect for a rest.<clear><br>... ... ...<br>... ... ...<$comeff(1,5)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>OK! I got a little rest!<clear><br><$comeff(1,9)><$motion(1,802)><$voicel(1,6)>Now it’s time for a bit more practice! ♪
msgctxt "3255:369"
msgid "<$comeff(1,4)><$facial(1,9)><$motion(1,807)><$voicel(1,1)>Uf, uf... Bu-buenas. Ay, encantad<gen;-3(o,a)>...<clear><br><$comeff(1,3)><$facial(1,2)><$motion(1,661)><$voicel(1,3)>Perdonaaa, es que estaba practicando un movimiento<br>y me ha dejado supercansad<gen;-3(o,a)>...<clear><br><$comeff(1,14)><$motion(1,805)><$voicel(1,7)>Oye, pues esta zona no está nada pero que nada mal.<br>Me viene que ni pintada para descansar un ratito...<slide><br><$comeff(1,5)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>Listo, ¡ya he recuperado un poco el aliento!<clear><br><$comeff(1,9)><$motion(1,802)><$voicel(1,6)>Toca retomar el entrenamiento. ♪Ji, ji.♪"
msgstr "<$comeff(1,4)><$facial(1,9)><$motion(1,807)><$voicel(1,1)>Uf, uf... Bu-buenas. Ay, encantad<gen;-3(o,a)>...<clear><br><$comeff(1,3)><$facial(1,2)><$motion(1,661)><$voicel(1,3)>Perdonaaa, es que estaba practicando un movimiento<br>y me dejó supercansad<gen;-3(o,a)>...<clear><br><$comeff(1,14)><$motion(1,805)><$voicel(1,7)>Oye, pues esta zona no está nada pero que nada mal.<br>Me viene que ni pintada para descansar un ratito...<slide><br><$comeff(1,5)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>Listo, ¡ya recuperé un poco el aliento!<clear><br><$comeff(1,9)><$motion(1,802)><$voicel(1,6)>Hora de retomar el entrenamiento. ♪Ji, ji.♪"

#. en: <$emotion(1,8)><$voicel(1,9)>Briooo! Brioooooo! ♪ Nice to meet you! ♪<br><$comeff(1,6)><$facial(1,4)><$motionoff(1,804)><$voicel(1,8)>Wanna dance together?<wait(1.0)><$motion(0,250)><wait(0.6)><clear><br><$comeff(1,5)><$facial(1,1)><$motion(1,803)><$voicel(1,9)>WHOA! Such unique, floppy movement! <$comeff(1,14)><$motion(1,666)><$voicel(1,8)>I’m totally<br>OBSESSED with the way you dance!<clear><br><$emotion(1,50)><$voicel(1,9)>Hehe, that’s so fun! I’ll practice it a bunch!<clear><br><$emotion(1,38)><$voicel(1,7)>Thanks for teaching me your sweet moves. In return, I’ll<br>help you out with anything. Just lemme know!
msgctxt "3255:370"
msgid "<$emotion(1,8)><$voicel(1,9)>♪¡Briooo! ¡Neee!♪ ¡Encantad<gen;-3(o,a)> de conocerteee!<wait(1.0)><br><$comeff(1,6)><$facial(1,4)><$motionoff(1,804)><$voicel(1,8)>¿Qué te parece si bailas un rato conmigooo?<wait(1.0)><$motion(0,250)><wait(0.6)><clear><br><$comeff(1,5)><$facial(1,1)><$motion(1,803)><$voicel(1,9)>¡¡Halaaa!! Qué pasos tan fluidos y elásticos te has marcado.<br><wait(1.0)><$comeff(1,14)><$motion(1,666)><$voicel(1,8)>Oye, espérate, que quizá pueda incorporarlos a mi baile...<clear><br><$emotion(1,50)><$voicel(1,9)>Ahora me toca practicar y más practicar. Buf, ¡qué ganas!<br>Gracias por ayudarme a ampliar mi repertorio, máquina.<clear><br><$emotion(1,38)><$voicel(1,7)>Puedes pedirme ayuda para lo que sea, que te debo una."
msgstr "<$emotion(1,8)><$voicel(1,9)>♪¡Briooo! ¡Neee!♪ ¡Encantad<gen;-3(o,a)> de conocerteee!<wait(1.0)><br><$comeff(1,6)><$facial(1,4)><$motionoff(1,804)><$voicel(1,8)>¿Qué te parece si bailas un rato conmigooo?<wait(1.0)><$motion(0,250)><wait(0.6)><clear><br><$comeff(1,5)><$facial(1,1)><$motion(1,803)><$voicel(1,9)>¡¡Guaaau!! Qué pasos tan fluidos y elásticos hiciste.<br><wait(1.0)><$comeff(1,14)><$motion(1,666)><$voicel(1,8)>Oye, espérate, que quizás pueda incorporarlos a mi baile...<clear><br><$emotion(1,50)><$voicel(1,9)>Ahora me toca practicar y más practicar. Buf, ¡qué ganas!<br>Gracias por ayudarme a ampliar mi repertorio, genio.<clear><br><$emotion(1,38)><$voicel(1,7)>Puedes pedirme ayuda para lo que sea, que te debo una."

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,817)><$voicel(1,10)>Laaa la la laaa... ♪<$lookat(1,1,0)><waitactor(1)><$facial(1,1)><clear><br><$lookat(1,0,0)><$emotion(1,14)><$voicel(1,6)>Oh, hello there. Pleasure to meet you.<clear><br><$emotion(1,38)><$voicel(1,7)>I’d not realized my song had attracted such an adorable<br>audience!<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,9)>Once I found this cozy little spot, I couldn’t help but sing!<br>Soon enough, I was completely swept up in my song.<slide><br><$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,8)>Now then, what shall I sing about next?<clear><br><$voicel(1,6)>The stunning blue sky? The clear ocean water? <wait(0.8)><$emotion(1,38)><$voicel(1,10)>Why, I can<br>hardly choose!
msgctxt "3255:371"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,817)><$voicel(1,10)>♪¡Pri, ma, pri! ¡Na, ri, naaa!♪<$lookat(1,1,0)><waitactor(1)><$facial(1,1)><clear><br><$lookat(1,0,0)><$emotion(1,14)><$voicel(1,6)>Anda, es un placer conocerte...<wait(1.0)> <$emotion(1,38)><$voicel(1,7)>Parece que, una vez más,<br>mi melodía ha captado la atención de una gentil alma...<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,9)>Esta zona es una preciosidad; tanto que no he podido<br>evitar ponerme a cantar en voz alta.<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,8)>Ju, ju, ¿sobre qué debería cantar a continuación?<clear><br><$voicel(1,6)>Podría inspirarme en la belleza del cielo o en la calma<br>de estas aguas cristalinas...<wait(0.8)><clear><br><$emotion(1,38)><$voicel(1,10)>Hmm, no estoy <gen;-3(seguro,segura)>, la verdad. Qué dilema."
msgstr "<$comeff(1,9)><$facial(1,4)><$motion(1,817)><$voicel(1,10)>♪¡Pri, ma, pri! ¡Na, ri, naaa!♪<$lookat(1,1,0)><waitactor(1)><$facial(1,1)><clear><br><$lookat(1,0,0)><$emotion(1,14)><$voicel(1,6)>Oh, es un placer conocerte...<wait(1.0)> <$emotion(1,38)><$voicel(1,7)>Parece que, una vez más,<br>mi melodía ha captado la atención de una gentil alma...<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,9)>Esta zona es una preciosidad; tanto que no pude<br>evitar ponerme a cantar en voz alta.<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,8)>Ju, ju, ¿sobre qué debería cantar a continuación?<clear><br><$voicel(1,6)>Podría inspirarme en la belleza del cielo o en la calma<br>de estas aguas cristalinas...<wait(0.8)><clear><br><$emotion(1,38)><$voicel(1,10)>Hmm, no estoy <gen;-3(seguro,segura)>, la verdad. Qué dilema."

#. en: <$comeff(1,5)><$motion(1,803)><$voicel(1,9)>Oh hey! I’m here! Inside the apple! <$comeff(1,14)><$motion(1,807)><$voicel(1,3)>It gets mistaken for a<br>regular apple all the time, and it always makes me sad...<clear><br><$comeff(1,9)><$motion(1,801)><$voicel(1,9)>But I’m so happy you found me today! ♪
msgctxt "3255:372"
msgid "<$comeff(1,5)><$motion(1,803)><$voicel(1,9)>¡Hola! ¡Aquí, dentro de la manzana!<clear><br><$comeff(1,14)><$motion(1,807)><$voicel(1,3)>No sabes la de veces que me confunden con una fruta<br>corriente y moliente... Me pone un poquito triste...<clear><br><$comeff(1,9)><$motion(1,801)><$voicel(1,9)>¡Así que tengo que celebrar que nos hayamos encontrado!"
msgstr ""

#. en: <$comeff(1,11)><$motion(1,663)><$voicel(1,7)>Ahhh! You scared me, yo! It’s been so long since I saw any<br>humans, so...<clear><br><$comeff(1,5)><$motion(1,801)><$voicel(1,9)>Hold on a sec... Now that I got a good look at you, you’re<br>...a Pokémon?!<clear><br><$comeff(1,10)><$motion(1,806)><$voicel(1,5)>You had me so surprised thinkin’ I’d seen a human, I curled<br>right up into a li’l apple ball!
msgctxt "3255:373"
msgid "<$comeff(1,11)><$motion(1,663)><$voicel(1,7)>¡Aaaa!<wait(1.0)> Hala, tú, ¡vaya susto me has pegado! Hacía la tira<br>que no me topaba con <gen;-2(un,una)> human<gen;-2(o,a)>...<clear><br><$comeff(1,5)><$motion(1,801)><$voicel(1,9)>Aunque, ahora que me fijo bien, eres un Pokémon, ¿no?<clear><br><$comeff(1,10)><$motion(1,806)><$voicel(1,5)>Fiu... A punto he estado de encerrarme en la manzana<br>a cal y canto, real."
msgstr "<$comeff(1,11)><$motion(1,663)><$voicel(1,7)>¡Aaaa!<wait(1.0)> Oye, tú, ¡qué susto me diste! Hacía muchísimo<br>que no me topaba con <gen;-2(un,una)> human<gen;-2(o,a)>...<clear><br><$comeff(1,5)><$motion(1,801)><$voicel(1,9)>Aunque, ahora que me fijo bien, eres un Pokémon, ¿no?<clear><br><$comeff(1,10)><$motion(1,806)><$voicel(1,5)>Fiu... Estuve a punto de encerrarme en la manzana<br>a cal y canto, en serio."

#. en: <$comeff(1,3)><$motion(1,801)><$voicel(1,8)>Oh, heyyy. Nice to meet you...<clear><br><$comeff(1,6)><$motion(1,805)><$voicel(1,5)>Did my yummy scent bring you here, too?<clear><br><$comeff(1,14)><$motion(1,806)><$voicel(1,7)>Everyone says I smell sweet and yummyyyy...<clear><br><$comeff(1,10)><$motion(1,807)><$voicel(1,9)>I just looove eating sweet stuff. Maybe that’s why I smell<br>this way...
msgctxt "3255:374"
msgid "<$comeff(1,3)><$motion(1,801)><$voicel(1,8)>Ah, encantaaad<gen;-3(o,a)>. <wait(1.0)>Deja que adivine... <$comeff(1,6)><$motion(1,805)><$voicel(1,5)>¿Acaso a ti también<br>te ha atraído mi aroma?<clear><br><$comeff(1,14)><$motion(1,806)><$voicel(1,7)>Me suelen decir que desprendo un olorcico dulzón que<br>resulta muy agradable...<clear><br><$comeff(1,10)><$motion(1,807)><$voicel(1,9)>Me pirro por las cosas dulces, así que quizá por eso ahora<br>huela así. ¡Si es que somos lo que comemos!"
msgstr "<$comeff(1,3)><$motion(1,801)><$voicel(1,8)>Ah, encantaaad<gen;-3(o,a)>. <wait(1.0)>Deja que adivine... <$comeff(1,6)><$motion(1,805)><$voicel(1,5)>¿Acaso a ti también<br>te atrajo mi aroma?<clear><br><$comeff(1,14)><$motion(1,806)><$voicel(1,7)>Me suelen decir que desprendo un olorcito dulzón que<br>resulta muy agradable...<clear><br><$comeff(1,10)><$motion(1,807)><$voicel(1,9)>Me encantan las cosas dulces, así que quizás por eso ahora<br>huela así. ¡Si es que somos lo que comemos!"

#. en: <$comeff(1,3)><$motion(1,803)><$voicel(1,5)>Nice to meet you. You’re...a Pokémon, right?
msgctxt "3255:375"
msgid "<$comeff(1,3)><$motion(1,803)><$voicel(1,5)>Encantad<gen;-3(o,a)> de conocerte. <wait(1.0)>Hmm, eres un Pokémon, ¿no?"
msgstr ""

#. en: <$comeff(1,6)><$motion(1,801)><$voicetonevar(1,8)>What’s up? Someone out there?
msgctxt "3255:376"
msgid "<$motion(1,801)><$voicetonevar(1,8)>Uala, ¡cuánto alboroto! <wait(1.0)><$comeff(1,6)>¿Qué está pasando, bro?"
msgstr "<$motion(1,801)><$voicetonevar(1,8)>Guau, ¡cuánto alboroto! <wait(1.0)><$comeff(1,6)>¿Qué está pasando, bro?"

#. en: <$comeff(1,14)><$motion(1,805)><$voicel(1,5)>Yeah, a Pokémon that kinda looks like a human just struck<br>up a conversation.
msgctxt "3255:377"
msgid "<$comeff(1,14)><$motion(1,805)><$voicel(1,5)>Nada, ha venido un Pokémon con apariencia medio<br>humana a hablar con nosotr<gen;-3(o,a)>s..."
msgstr "<$comeff(1,14)><$motion(1,805)><$voicel(1,5)>Nada, vino un Pokémon con apariencia medio<br>humana a hablar con nosotr<gen;-3(o,a)>s..."

#. en: <$comeff(1,10)><$motion(1,802)><$voicetonevar(1,7)>Huh, sounds interesting! Guess I’ll say hi, too.<clear><br><$comeff(1,5)><$motion(1,801)><$voicetonevar(1,9)>Hey there, pal! Greetings from inside this apple! Thanks<br>for coming to chat with us!
msgctxt "3255:378"
msgid "<$comeff(1,10)><$motion(1,802)><$voicetonevar(1,7)>Buah, qué flipe. ¡Yo también quiero saludarl<gen;-2(o,a)>!<clear><br><$comeff(1,5)><$motion(1,801)><$voicetonevar(1,9)>¡Ey! ¡Aquí, dentro de la manzana! Gracias por pasarte<br>a charlar con nosotros, ¡te llevas un dos por uno! Jua, jua."
msgstr "<$comeff(1,10)><$motion(1,802)><$voicetonevar(1,7)>Guau, qué locura. ¡Yo también quiero saludarl<gen;-2(o,a)>!<clear><br><$comeff(1,5)><$motion(1,801)><$voicetonevar(1,9)>¡Ey! ¡Aquí, dentro de la manzana! Gracias por pasarte<br>a charlar con nosotros, ¡te llevas un dos por uno! Jua, jua."

#. en: <$comeff(1,14)><$motion(1,807)><$voicel(1,5)>That was the owner of the tail you see sticking out. I’m the<br>face you see here. The two of us are like peas in a pod.<slide><br><$comeff(1,3)><$motion(1,803)><$voicel(1,8)>Or...wyrms in an apple, I guess.<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,10)>Anyway, hope we can all be friends.
msgctxt "3255:379"
msgid "<$comeff(1,14)><$motion(1,807)><$voicel(1,5)>La cola es <gen;-3(del,de la)> que acaba de hablar contigo, y la cabeza<br>que ves es mía. <wait(1.0)><$comeff(1,3)><$motion(1,803)><$voicel(1,8)>Entre l<gen;-3(o,a)>s dos formamos un solo Pokémon.<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,10)>Encantad<gen;-3(o,a)>s de conocerte."
msgstr ""

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Wow! You’re a <$cdef(27)>Ditto</color>, aren’t ya? That’s one heck of a<br>transformation!
msgctxt "3255:380"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Que me aspen... ¡Pero si eres un <$cdef(27)>Ditto</color>! He de reconocer<br>que se te da muy bien cambiar de apariencia."
msgstr "<$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Válgame... ¡Pero si eres un <$cdef(27)>Ditto</color>! He de reconocer<br>que se te da muy bien cambiar de apariencia."

#. en: <$comeff(1,5)><$facial(1,2)><$motion(1,644)><$voicel(1,8)>Hey! Lemme get a look too... Wow! You’re right!
msgctxt "3255:381"
msgid "<$comeff(1,5)><$facial(1,2)><$motion(1,644)><$voicel(1,8)>A ver, a ver... <wait(0.5)>¡Cáspita, tienes razón!"
msgstr ""

#. en: <$comeff(1,3)><$motion(1,815)><$voicel(1,4)>Hm. They’re the spittin’ image of a human fer sure.
msgctxt "3255:382"
msgid "<$comeff(1,3)><$motion(1,815)><$voicel(1,4)>Sí que te asemejas a <gen;-2(un humano,una humana)>, sí."
msgstr ""

#. en: <$comeff(1,10)><$motionoff(1,804)><$voicel(1,10)>What a peculiar li’l <$cdef(27)>Ditto</color>.
msgctxt "3255:383"
msgid "<$comeff(1,10)><$motionoff(1,804)><$voicel(1,10)>Debes de ser un <$cdef(27)>Ditto</color> de gustos un tanto peculiares,<br>eso está claro."
msgstr ""

#. en: <$comeff(1,14)><$motion(1,806)><$voicel(1,2)>Think I’ve got ’em beat in the looks department, though.
msgctxt "3255:384"
msgid "<$comeff(1,14)><$motion(1,806)><$voicel(1,2)>¿No preferirías transformarte en manzana?..."
msgstr ""

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,802)><$voicel(1,9)>Gwahaha! You’ll have to excuse the ruckus! <$comeff(1,9)><$motion(1,801)><$voicel(1,8)>Hope we can<br>all be good friends!
msgctxt "3255:385"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,802)><$voicel(1,9)>¡Bua, ja, ja! Perdona por la murga que te estamos dando.<br><wait(1.0)><$comeff(1,9)><$motion(1,801)><$voicel(1,8)>Espero que seamos buenos amigos."
msgstr "<$comeff(1,10)><$facial(1,4)><$motion(1,802)><$voicel(1,9)>¡Bua, ja, ja! Perdona por la lata que te estamos dando.<br><wait(1.0)><$comeff(1,9)><$motion(1,801)><$voicel(1,8)>Espero que seamos buenos amigos."

#. en: <$comeff(1,5)><$motion(1,803)><$voicel(1,7)>Whoa! You, uh...you wanna talk to ME?!<$motion(0,40)><wait(1.3)><clear><br><$comeff(1,2)><$motion(1,807)><$voicel(1,9)>Yooo... Not many people wanna talk to me. <$motion(1,801)><$voicel(1,10)>You must be,<br>like, a suuuper nice Pokémon or somethin’!<clear><br><$comcan(1)><$comeff(1,9)><$motion(1,806)><$voicel(1,9)>It’d be real cool if we could be friends or whatever!
msgctxt "3255:386"
msgid "<$comeff(1,5)><$motion(1,803)><$voicel(1,7)>¡Oh! Me... <wait(1.0)>¡¿Me estás hablando?!<$motion(0,40)><wait(1.3)><clear><br><$comeff(1,2)><$motion(1,807)><$voicel(1,9)>Ayyy... Es que suelen pasar maaazo de mí y siempre me<br>quedo sol<gen;-3(o,a)>, en plan margi.<clear><br><$motion(1,801)><$voicel(1,10)>¡Me acabas de alegrar el día, la semana y el mes entero!<wait(1.0)><br><$comcan(1)><$comeff(1,9)><$motion(1,806)><$voicel(1,9)>Me caes bien. Podríamos ser besties, ¿no?<wait(1.0)> ¿NO?"
msgstr "<$comeff(1,5)><$motion(1,803)><$voicel(1,7)>¡Oh! Me... <wait(1.0)>¡¿Me estás hablando?!<$motion(0,40)><wait(1.3)><clear><br><$comeff(1,2)><$motion(1,807)><$voicel(1,9)>Ayyy... Es que casi todos me ignoraaan y siempre me<br>quedo sol<gen;-3(o,a)>, como un bicho raro.<clear><br><$motion(1,801)><$voicel(1,10)>¡Me acabas de alegrar el día, la semana y el mes entero!<wait(1.0)><br><$comcan(1)><$comeff(1,9)><$motion(1,806)><$voicel(1,9)>Me caes bien. Podríamos ser besties, ¿no?<wait(1.0)> ¿NO?"

#. en: <$comeff(1,6)><$motion(1,803)><$voicel(1,5)>...Hm? Did I catch your eye, little one?<clear><br><$comeff(1,21)><$facial(1,14)><$motion(1,805)><$voicel(1,7)>I’m not surprised. Others are often quite entranced by<br>my beauty.<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>But I must say that your gentle smile is also quite lovely.<clear><br><$comeff(1,3)><$facial(1,2)><$motion(1,806)><$voicel(1,8)>I hope you’ll return and visit with me on occasion.<br>No need to feel intimidated!
msgctxt "3255:387"
msgid "<$comeff(1,6)><$motion(1,803)><$voicel(1,5)>Vaya, ¿acaso te has quedado <gen;-2(absorto,absorta)> mirándome?<clear><br><$comeff(1,21)><$facial(1,14)><$motion(1,805)><$voicel(1,7)>Mi belleza no tiene parangón, así que no eres <gen;-2(el primero,la primera)><br>ni serás <gen;-2(el último,la última)>, ju, ju.<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Sea como fuere, no dejes que eso te intimide. Tú tienes<br>una sonrisa muy dulce y también una piel de lo más tersa.<clear><br><$comeff(1,3)><$facial(1,2)><$motion(1,806)><$voicel(1,8)>Encantad<gen;-3(o,a)> de que charlemos."
msgstr "<$comeff(1,6)><$motion(1,803)><$voicel(1,5)>Vaya, ¿acaso te quedaste <gen;-2(absorto,absorta)> mirándome?<clear><br><$comeff(1,21)><$facial(1,14)><$motion(1,805)><$voicel(1,7)>Mi belleza no tiene parangón, así que no eres <gen;-2(el primero,la primera)><br>ni serás <gen;-2(el último,la última)>, ju, ju.<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Sea como fuere, no dejes que eso te intimide. Tú tienes<br>una sonrisa muy dulce y también una piel de lo más tersa.<clear><br><$comeff(1,3)><$facial(1,2)><$motion(1,806)><$voicel(1,8)>Encantad<gen;-3(o,a)> de que charlemos."

#. en: <$comeff(1,5)><$motion(1,803)><$voicel(1,7)>Oh, a human! ...Wait, you’re actually a <$cdef(27)>Ditto</color>? <$comeff(1,6)><$motion(1,644)><$voicel(1,6)>Do you like<br>humans or something?<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Heh heh... I like humans, too. <$comeff(1,21)><$motion(1,802)><$voicel(1,8)>Looks like we might get<br>along well!
msgctxt "3255:388"
msgid "<$comeff(1,5)><$motion(1,803)><$voicel(1,7)>¡Anda, <gen;-2(un,una)> human<gen;-2(o,a)>! <wait(1.0)>A-ah, no... ¡Pero si eres un <$cdef(27)>Ditto</color>!<clear><br><$comeff(1,6)><$motion(1,644)><$voicel(1,6)>Y... ¿supongo que te interesan los humanos? Como vas<br>con esas pintas...<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Ji, ji... A mí también me caen simpáticos, así que fijo que<br>tú y yo nos llevaremos bien... <wait(1.0)><$comeff(1,21)><$motion(1,802)><$voicel(1,8)>B-bueno, eso espero..."
msgstr "<$comeff(1,5)><$motion(1,803)><$voicel(1,7)>¡Mira, <gen;-2(un,una)> human<gen;-2(o,a)>! <wait(1.0)>A-ah, no... ¡Pero si eres un <$cdef(27)>Ditto</color>!<clear><br><$comeff(1,6)><$motion(1,644)><$voicel(1,6)>Y... ¿supongo que te interesan los humanos? Como andas<br>con esa apariencia...<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Ji, ji... A mí también me caen simpáticos, así que seguro que<br>tú y yo nos llevaremos bien... <wait(1.0)><$comeff(1,21)><$motion(1,802)><$voicel(1,8)>B-bueno, eso espero..."

#. en: <$comeff(1,10)><$motion(1,803)><$voicel(1,9)>Why hello there, little one! Would you like to join me on a<br>little journey <wait(0.3)><$comeff(1,6)><$facial(1,4)><$motion(1,806)><$voicel(1,8)>to the most delightful, wondrous place?<slide><br><$comeff(1,8)><$motion(1,801)><$voicel(1,10)>Somewhere magical and dreamy, where everyone is happy.<clear><br><$comeff(1,14)><$facial(1,2)><$motion(1,802)><$voicel(1,7)>Here, simply take my hand and— Oh. Now that I’ve a better<br>look at you, <wait(0.3)><$motion(1,644)><$voicel(1,6)>you’re not human at all, are you?<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Well then, go ahead and forget what you just heard. ♪
msgctxt "3255:389"
msgid "<$motion(1,803)><$voicel(1,9)>Hola, peque... <$comeff(1,6)>¿Te apetece ir a un lugar superdivertido?<wait(1.0)><br><$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,8)>Podemos ir a jugar tú y yo.<clear><br><$comeff(1,8)><$motion(1,801)><$voicel(1,10)>Parece sacado de un sueño y allí cualquiera es feliz.<br><wait(1.0)><$comeff(1,14)><$facial(1,2)><$motion(1,802)><$voicel(1,7)>Venga, dame la manita...<clear><br><$motion(1,644)><$voicel(1,6)>Uy, ahora que te miro bien, no pareces <gen;-2(un,una)> niñ<gen;-2(o,a)> human<gen;-2(o,a)>.<br><wait(1.0)><$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Ju, ju, ju... Haz como si no hubieras oído nada, por favor."
msgstr "<$motion(1,803)><$voicel(1,9)>Hola, criaturita... <$comeff(1,6)>¿Quieres ir a un lugar superdivertido?<wait(1.0)><br><$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,8)>Podemos ir a jugar tú y yo.<clear><br><$comeff(1,8)><$motion(1,801)><$voicel(1,10)>Parece sacado de un sueño y allí cualquiera es feliz.<br><wait(1.0)><$comeff(1,14)><$facial(1,2)><$motion(1,802)><$voicel(1,7)>Vamos, dame la manita...<clear><br><$motion(1,644)><$voicel(1,6)>Uy, ahora que te miro bien, no pareces <gen;-2(un,una)> niñ<gen;-2(o,a)> human<gen;-2(o,a)>.<br><wait(1.0)><$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Ju, ju, ju... Haz como si no hubieras oído nada, por favor."

#. en: <$motion(1,807)><$facial(1,14)><$comeff(1,16)><$voicel(1,4)>*yawn* <wait(3.0)><$comcan(1)><$facial(1,2)><$comeff(1,3)><$voicel(1,8)>Oh, nice to meet you... <$emotion(1,29)><$voicel(1,5)>Do you want me to grant<br>you a wish or something?<wait(1.0)><$motion(0,41)><wait(2.0)><clear><br><$motion(1,802)><$facial(1,13)><$comeff(1,5)><$voicel(1,9)>Huh? ...No? <wait(0.5)>You want <$motion(1,806)><$facial(1,2)><$comeff(1,14)><$voicel(1,6)>to hear about MY wish?<clear><br><$comcan(1)><$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,10)>Hee hee, that’s the first time anyone’s asked me that!<br>You’re pretty interesting!<clear><br><$emotion(1,50)><$voicel(1,5)>I’m planning to stay here for a while, so I hope I can get to<br>know you better!
msgctxt "3255:390"
msgid "<$motion(1,807)><$facial(1,14)><$comeff(1,16)><$voicel(1,4)>Uuuaaah... <wait(3.0)><$comcan(1)><$facial(1,2)><$comeff(1,3)><$voicel(1,8)>Ay, ¡encantad<gen;-3(o,a)>!<clear><br><$emotion(1,29)><$voicel(1,5)>Dime, ¿quieres que te conceda un deseo o algo parecido?<wait(1.0)><$motion(0,41)><wait(2.0)><clear><br><$motion(1,802)><$facial(1,13)><$comeff(1,5)><$voicel(1,9)>Ah, ¿en serio? <wait(1.0)><$motion(1,806)><$facial(1,2)><$comeff(1,14)><$voicel(1,6)>¿Quieres que te cuente yo mi deseo?<clear><br><$comcan(1)><$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,10)>Je, je, es la primera vez que alguien me lo pregunta a mí.<br>Qué interesante...<clear><br><$emotion(1,50)><$voicel(1,5)>Tengo pensado quedarme aquí una temporada, así que<br>espero que nos veamos a menudo."
msgstr ""
