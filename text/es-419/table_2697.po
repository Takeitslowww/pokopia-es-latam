msgid "<$voicel(1,7)><$motion(1,661)>Así llamaban los humanos a una máquina que empleaban<br>a la hora de <$cdef(27)><$spwfull(12)></color>.<clear><br><$voicel(1,5)>Cuando intercambiaban objetos entre ellos, <$voicel(1,7)><$motion(1,803)>recuerdo oírla<br>emitir ese característico sonido."
msgstr ""

#. en: <$voicel(4,5)><$emotion(4,53)><$facial(4,4)>Wow, really? That sounds FUN! I wanna use a<br><$cdef(27)><fqty(1)><$ifull(1325)></color> and do some <$cdef(27)><$spwfull(12)>s</color> too!
msgctxt "2697:66"
msgid "<$voicel(4,5)><$emotion(4,53)><$facial(4,4)>¡Uala, qué guaaay! ¡Quiero jugar a <$cdef(27)><$spwfull(12)></color> en<br>la <$cdef(27)><fqty(1)><$ifull(1325)></color>!"
msgstr "<$voicel(4,5)><$emotion(4,53)><$facial(4,4)>¡Guau, qué geniaaal! ¡Quiero jugar a <$cdef(27)><$spwfull(12)></color> en<br>la <$cdef(27)><fqty(1)><$ifull(1325)></color>!"

#. en: <$voicel(1,5)><$motion(1,801)>Hohoho! You know, I think we Pokémon can indeed have<br>some fun imitating humans!
