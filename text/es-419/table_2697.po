#. en: <$voicel(4,9)><$emotion(4,38)>Ta-daaa! Here’s the machine I was telling you about!
msgctxt "2697:0"
msgid "<$voicel(4,9)><$emotion(4,38)>¡Tachán! Esta es la máquina."
msgstr ""

#. en: <$voicel(4,5)><$emotion(4,14)>I’m pretty sure this is a musicky instrument!<clear><br><$voicel(4,5)><$comeff(4,9)><$motion(4,806)>See, it’s got lotsa buttons, and when you push ’em, they<br>make sounds!
msgctxt "2697:1"
msgid "<$voicel(4,5)><$emotion(4,14)>¡Pues creo que es un instrumento musical!<clear><br><$voicel(4,5)><$comeff(4,9)><$motion(4,806)>¿Has visto todas las teclas que tiene? ¡Resulta que hacen<br>ruiditos cuando las pulsas!"
msgstr "<$voicel(4,5)><$emotion(4,14)>¡Pues creo que es un instrumento musical!<clear><br><$voicel(4,5)><$comeff(4,9)><$motion(4,806)>¿Viste todas las teclas que tiene? ¡Resulta que hacen<br>ruiditos cuando las presionas!"

#. en: <$voicel(4,6)>Here, watch this... <wait(0.3)><$motion(4,814)><wait(0.3)><$comeff(4,5)><$voicel(4,8)>Yah!
msgctxt "2697:2"
msgid "<$voicel(4,6)>Mira, mira... Una, dos y... <wait(0.3)><$motion(4,814)><wait(0.3)><$comeff(4,5)><$voicel(4,8)>¡tres!"
msgstr ""

#. en: <$se2d(970)>*cha-ching!*
msgctxt "2697:3"
msgid "<$se2d(970)>¡Chin!"
msgstr ""

#. en: <$voicel(4,5)><$emotion(4,8)>Didja hear that? Wasn’t it a pretty sound?!
msgctxt "2697:4"
msgid "<$voicel(4,5)><$emotion(4,8)>¿Ves? Hace este sonidito tan bonito."
msgstr ""

#. en: *ring ring!*
msgctxt "2697:5"
msgid "Pururu... Pururu..."
msgstr ""

#. en: <oneline><$voicel(1,5)><$motion(1,661)>Oh, <$cdef(27)><pname;0></color>, whereabouts<br>are<slide><br>you<slide><br>right now?<clear><br><$voicel(1,8)><$facial(1,4)>I’m trying to polish up my <$cdef(27)>PC </color>skills at the moment.
msgctxt "2697:6"
msgid "<oneline><$voicel(1,5)><$motion(1,661)><$cdef(27)><pname;0></color>, ¿dónde te encuentras?<br><$voicel(1,8)><$facial(1,4)>Yo sigo intentando<slide><br>familiarizarme con el dichoso <$cdef(27)>PC</color>."
msgstr ""

#. en: <$voicel(4,8)><$comeff(4,9)><$motion(4,817)>And a-tap, and a-tap, and a-TAP!
msgctxt "2697:7"
msgid "<$voicel(4,8)><$comeff(4,9)><$motion(4,817)>¡Más, más, más!"
msgstr ""

#. en: <$se2d(970)>*cha-ching!* <$se2d(970)>*cha-ching!* <$se2d(970)>*cha-ching!*
msgctxt "2697:8"
msgid "<$se2d(970)>¡Chin! <$se2d(970)>¡Chin! <$se2d(970)>¡Chin!"
msgstr ""

#. en: <$voicel(1,10)><$comeff(1,5)><$motion(1,665)>Wh-what’s all that racket?!
msgctxt "2697:9"
msgid "<$voicel(1,10)><$comeff(1,5)><$motion(1,665)>¡Cuánto alboroto!"
msgstr ""

#. en: <$voicel(1,5)><$motion(1,666)>Actually...I get the feeling I’ve heard that sound<br>somewhere before.
msgctxt "2697:10"
msgid "<$voicel(1,5)><$motion(1,666)>Un momento... Ese sonido me resulta algo familiar..."
msgstr ""

#. en: <$voicel(4,8)><$comeff(4,10)><$motion(4,806)>It’s the sound of this musicky instrument!
msgctxt "2697:11"
msgid "<$voicel(4,8)><$comeff(4,10)><$motion(4,806)>¡Soy yo tocando este instrumento!"
msgstr ""

#. en: <$se2d(970)>*cha-ching!*
msgctxt "2697:12"
msgid "<$se2d(970)>¡Chin!"
msgstr ""

#. en: <$voicel(1,7)><$motion(1,803)>Oh, wait, now I remember! That’s no instrument—it’s a<br>machine known as a <$cdef(27)><fqty(1)><$ifull(1325)></color>!
msgctxt "2697:13"
msgid "<$voicel(1,7)><$motion(1,803)>¡Ah! Ya recuerdo. No se trata de ningún instrumento,<br>sino de una máquina llamada <$cdef(27)><fqty(1)><$ifull(1325)></color>."
msgstr ""

#. en: <$voicel(4,5)><$comeff(4,6)><$motion(4,666)>Huh? What’s a <$cdef(27)><fqty(1)><$ifull(1325)></color>?
msgctxt "2697:14"
msgid "<$cdef(27)><$voicel(4,5)></color><$comeff(4,6)><$motion(4,666)>¿Y eso qué es?"
msgstr ""

#. en: <$voicel(1,7)><$motion(1,661)>It’s a machine humans used to make <$cdef(27)><$spwfull(12)>s</color>!<clear><br><$voicel(1,5)>Whenever they exchanged things with each other, <$voicel(1,7)><$motion(1,803)>for some<br>reason, they also used this machine to go “cha-ching!”
msgctxt "2697:15"
msgid "<$voicel(1,7)><$motion(1,661)>Así llamaban los humanos a una máquina que empleaban<br>a la hora de <$cdef(27)><$spwfull(12)></color>.<clear><br><$voicel(1,5)>Cuando intercambiaban objetos entre ellos, <$voicel(1,7)><$motion(1,803)>recuerdo oírla<br>emitir ese característico sonido."
msgstr ""

#. en: <$voicel(4,5)><$emotion(4,53)><$facial(4,4)>Wow, really? That sounds FUN! I wanna use a<br><$cdef(27)><fqty(1)><$ifull(1325)></color> and do some <$cdef(27)><$spwfull(12)>s</color> too!
msgctxt "2697:16"
msgid "<$voicel(4,5)><$emotion(4,53)><$facial(4,4)>¡Uala, qué guaaay! ¡Quiero jugar a <$cdef(27)><$spwfull(12)></color> en<br>la <$cdef(27)><fqty(1)><$ifull(1325)></color>!"
msgstr "<$voicel(4,5)><$emotion(4,53)><$facial(4,4)>¡Guau, qué geniaaal! ¡Quiero jugar a <$cdef(27)><$spwfull(12)></color> en<br>la <$cdef(27)><fqty(1)><$ifull(1325)></color>!"

#. en: <$voicel(1,5)><$motion(1,801)>Hohoho! You know, I think we Pokémon can indeed have<br>some fun imitating humans!
msgctxt "2697:17"
msgid "<$voicel(1,5)><$motion(1,801)>¡Jo, jo, jo! Ver a Pokémon imitar lo que hacían los<br>humanos resulta harto entretenido."
msgstr ""

#. en: <$voicel(4,7)><$comeff(4,9)><$motion(4,806)>YAY! Then I’ll start getting ready right away! You should<br>come back to see when I’m finished!
msgctxt "2697:18"
msgid "<$voicel(4,7)><$comeff(4,9)><$motion(4,806)>¡Vale! Pues voy a preparar todas las cositas. ¡Ven a verme<br>cuando tenga todo listooo!"
msgstr "<$voicel(4,7)><$comeff(4,9)><$motion(4,806)>¡Bueno! Pues voy a preparar todas las cositas. ¡Ven a verme<br>cuando tenga todo listooo!"

#. en: <$voicel(4,9)><$emotion(4,38)>Ta-daaa! Here’s the machine I was telling you about!
msgctxt "2697:30"
msgid "<$voicel(4,9)><$emotion(4,38)>¡Tachán! Esta es la máquina."
msgstr ""

#. en: <$voicel(4,5)><$emotion(4,14)>I’m pretty sure this is a musicky instrument!<clear><br><$voicel(4,5)><$comeff(4,9)><$motion(4,806)>See, it’s got lotsa buttons, and when you push ’em, they<br>make sounds!
msgctxt "2697:31"
msgid "<$voicel(4,5)><$emotion(4,14)>¡Creo que es un instrumento musical!<clear><br><$voicel(4,5)><$comeff(4,9)><$motion(4,806)>¿Has visto todas las teclas que tiene? ¡Pues hacen ruiditos<br>cuando las pulsas!"
msgstr "<$voicel(4,5)><$emotion(4,14)>¡Creo que es un instrumento musical!<clear><br><$voicel(4,5)><$comeff(4,9)><$motion(4,806)>¿Viste todas las teclas que tiene? ¡Pues hacen ruiditos<br>cuando las presionas!"

#. en: <$voicel(4,6)>Here, watch this... <wait(0.3)><$motion(4,814)><wait(0.3)><$comeff(4,5)><$voicel(4,8)>Yah!
msgctxt "2697:32"
msgid "<$voicel(4,6)>Mira, mira... Una, dos y... <wait(0.3)><$motion(4,814)><wait(0.3)><$comeff(4,5)><$voicel(4,8)>¡tres!"
msgstr ""

#. en: ...<wait(0.8)><$voicel(4,4)><$comeff(4,6)><$motion(4,666)>Huh? It’s not working. How come?<clear><br><$voicel(4,5)><$comeff(4,3)><$motion(4,807)>When I poked it before, it made really pretty noises! And<br>I think it even lit up a little.
msgctxt "2697:33"
msgid "... <wait(0.8)><$voicel(4,4)><$comeff(4,6)><$motion(4,666)>Uy... No funciona... ¿Por qué será?<clear><br><$voicel(4,5)><$comeff(4,3)><$motion(4,807)>Cuando he estado toqueteándolo hace un rato, se le han<br>encendido unas luces y se ha puesto a hacer unos sonidos<slide><br>muy chachis..."
msgstr "... <wait(0.8)><$voicel(4,4)><$comeff(4,6)><$motion(4,666)>Uy... No funciona... ¿Por qué será?<clear><br><$voicel(4,5)><$comeff(4,3)><$motion(4,807)>Cuando estuve toqueteándolo hace un rato, se le<br>encendieron unas luces y se puso a hacer unos sonidos<slide><br>muy lindos..."

#. en: <$voicel(4,5)><$emotion(4,27)>Ohhh, it needs electricity to work? That’s too bad!
msgctxt "2697:34"
msgid "<$voicel(4,5)><$emotion(4,27)>¿Que necesita electricidad para funcionar? Jo, qué rabia..."
msgstr "<$voicel(4,5)><$emotion(4,27)>¿Que necesita electricidad para funcionar? Ay, qué lástima..."

#. en: <oneline><$voicel(4,5)><$comeff(4,3)><$motion(4,666)>Sorry to bug you, <$cdef(27)><pname;0></color>, but could<br>you<slide><br>maybe<slide><br><$voicel(4,5)><$emotion(4,29)>connect<slide><br>electricity<slide><br>to<slide><br>this spot?
msgctxt "2697:35"
msgid "<$voicel(4,5)><$comeff(4,3)><$motion(4,666)>¿Tú crees que podrías traer electricidad hasta aquí?<br><$voicel(4,5)><$emotion(4,29)>Si no te importa hacerme el favor... ¿Porfi?"
msgstr ""

#. en: <$voicel(4,7)><$emotion(4,49)>I want us to play with this machine together!
msgctxt "2697:36"
msgid "<$voicel(4,7)><$emotion(4,49)>Ya que hemos encontrado este instrumento tan chuli,<br>me encantaría tocarlo contigo."
msgstr "<$voicel(4,7)><$emotion(4,49)>Ya que encontramos este instrumento tan lindo,<br>me encantaría tocarlo contigo."

#. en: <$voicel(4,8)><$emotion(4,14)>Please hook this machine up to electricity!
msgctxt "2697:43"
msgid "<$voicel(4,8)><$emotion(4,14)>¡Quiero que conectes este instrumento a la corriente!"
msgstr ""

#. en: <$voicel(4,5)><$emotion(4,49)>Then once it’s working, let’s play together!
msgctxt "2697:44"
msgid "<$voicel(4,5)><$emotion(4,49)>¡Así luego podemos tocar una canción chachi!"
msgstr "<$voicel(4,5)><$emotion(4,49)>¡Así luego podemos tocar una canción genial!"

#. en: <$voicel(4,5)><$emotion(4,38)>YAY! The machine should work now, right?!
msgctxt "2697:51"
msgid "<$voicel(4,5)><$emotion(4,38)>¡Uala! ¡Ahora el instrumento debería funcionar!"
msgstr "<$voicel(4,5)><$emotion(4,38)>¡Guau! ¡Ahora el instrumento debería funcionar!"

#. en: <$voicel(4,6)>OK, here I go... <wait(0.3)><$motion(4,814)><wait(0.3)><$comeff(4,5)><$voicel(4,8)>Yah!
msgctxt "2697:52"
msgid "<$voicel(4,6)>¡Venga, que voy! Una, dos y... <wait(0.3)><$motion(4,814)><wait(0.3)><$comeff(4,5)><$voicel(4,8)>¡tres!"
msgstr "<$voicel(4,6)>¡Bien, ahí voy! Una, dos y... <wait(0.3)><$motion(4,814)><wait(0.3)><$comeff(4,5)><$voicel(4,8)>¡tres!"

#. en: <$se2d(970)>*cha-ching!*
msgctxt "2697:53"
msgid "<$se2d(970)>¡Chin!"
msgstr ""

#. en: <$voicel(4,5)><$emotion(4,8)>Didja hear that? Wasn’t it a pretty sound?!
msgctxt "2697:54"
msgid "<$voicel(4,5)><$emotion(4,8)>¿Ves? Hace este sonidito tan bonito."
msgstr ""

