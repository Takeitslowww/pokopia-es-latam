msgid "<oneline><$voicel(1,5)><$comeff(1,4)><$motion(1,807)>Pueees... ¡yo de<br><$cdef(27)><fqty(2)><class><referrmate;0></color><slide><br>controlo entre cero y nada!<clear><br><$voicel(1,7)><$emotion(1,14)>Pero si me das<br><genqty;2(algún,alguna,algunos,algunas)> <$cdef(27)><fqty(1)><class><refmateid;2></color>,<slide><br><$voicel(1,6)><genqty;2(lo,la,los,las)> puedo convertir en<slide><br><$cdef(27)><fqty(2)><class><reftarid;3></color>.<clear><br><$voicel(1,4)><$comeff(1,6)><$facial(1,4)>¿Qué me dices, figura?"
msgstr "<oneline><$voicel(1,5)><$comeff(1,4)><$motion(1,807)>Pueees... ¡yo de<br><$cdef(27)><fqty(2)><class><referrmate;0></color><slide><br>sé entre cero y nada!<clear><br><$voicel(1,7)><$emotion(1,14)>Pero si me das<br><genqty;2(algún,alguna,algunos,algunas)> <$cdef(27)><fqty(1)><class><refmateid;2></color>,<slide><br><$voicel(1,6)><genqty;2(lo,la,los,las)> puedo convertir en<slide><br><$cdef(27)><fqty(2)><class><reftarid;3></color>.<clear><br><$voicel(1,4)><$comeff(1,6)><$facial(1,4)>¿Qué me dices, crack?"

#. en: <oneline><$voicel(1,4)><$comeff(1,6)><$motion(1,666)>Y’need <$cdef(27)><fqty(2)><class><reftarid;0></color>?<clear><br><$voicel(1,7)><$emotion(1,14)>Then just throw some<br><$cdef(27)><fqty(2)><class><refmateid;2></color><slide><br>into<slide><br>the<slide><br><$cdef(27)><fqty(1)><reftable;1></color>!<clear><br><$voicel(1,6)><$comeff(1,9)><$facial(1,4)><$motion(1,806)>I’ll get to processin’ as soon as I can!
msgctxt "1986:573"
msgid "<oneline><$voicel(1,4)><$comeff(1,6)><$motion(1,666)>¿Necesitas<br><$cdef(27)><fqty(2)><class><reftarid;0></color>,<slide><br>figura?<clear><br><$voicel(1,7)><$emotion(1,14)>¡Pues déjame<br><dart;2()><$cdef(27)><fqty(1)><class><refmateid;2></color><slide><br>en <dart;1()><$cdef(27)><fqty(1)><class><reftable;1></color>!<slide><br><$voicel(1,6)><$comeff(1,9)><$facial(1,4)><$motion(1,806)>¡Yo me encargo de procesar<genqty;2(lo,la,los,las)>!"
msgstr "<oneline><$voicel(1,4)><$comeff(1,6)><$motion(1,666)>¿Necesitas<br><$cdef(27)><fqty(2)><class><reftarid;0></color>,<slide><br>crack?<clear><br><$voicel(1,7)><$emotion(1,14)>¡Pues déjame<br><dart;2()><$cdef(27)><fqty(1)><class><refmateid;2></color><slide><br>en <dart;1()><$cdef(27)><fqty(1)><class><reftable;1></color>!<slide><br><$voicel(1,6)><$comeff(1,9)><$facial(1,4)><$motion(1,806)>¡Yo me encargo de procesar<genqty;2(lo,la,los,las)>!"

#. en: <oneline><$voicel(1,5)><$emotion(1,14)>I’m gonna need <iart;1()><$cdef(27)><fqty(1)><reftable;1></color><br>to<slide><br>make<slide><br><$cdef(27)><fqty(2)><class><reftarid;0></color>!<clear><br><$voicel(1,3)><$comeff(1,6)><$motion(1,666)>Couldja set me up with<br><iart;2()><$cdef(27)><fqty(1)><reftable;2></color>?
msgctxt "1986:574"
msgid "<oneline><$cdef(27)><$voicel(1,5)></color><$emotion(1,14)>Me encantaría ayudarte, fiera, pero necesito<br><iart;1()><$cdef(27)><fqty(1)><class><reftable;1></color><slide><br>para procesar<slide><br><$cdef(27)><fqty(2)><class><reftarid;0></color>...<clear><br><$voicel(1,3)><$comeff(1,6)><$motion(1,666)>¿Te importa traerme <genqty;1(uno,una,unos,unas)>?"
msgstr "<oneline><$cdef(27)><$voicel(1,5)></color><$emotion(1,14)>Me encantaría ayudarte, crack, pero necesito<br><iart;1()><$cdef(27)><fqty(1)><class><reftable;1></color><slide><br>para procesar<slide><br><$cdef(27)><fqty(2)><class><reftarid;0></color>...<clear><br><$voicel(1,3)><$comeff(1,6)><$motion(1,666)>¿Te importa traerme <genqty;1(uno,una,unos,unas)>?"

#. en: <$voicel(1,9)><$emotion(1,8)>Oh, and I made ANOTHER awesome thing, too! I really<br>went all-out on this one! Here ya go, bestie!
msgctxt "1986:575"
msgid "<$voicel(1,9)><$emotion(1,8)>¡Ah, y mira qué cosa tan guapa me ha salido también!<br>¡Si es que hoy estoy sembrad<gen;-3(o,a)>! ¡Aquí tienes, fiera!"
msgstr "<$voicel(1,9)><$emotion(1,8)>¡Ah, y mira qué cosa tan genial me salió también!<br>¡Es que hoy estoy inspirad<gen;-3(o,a)>! ¡Aquí tienes, crack!"

#. en: <$voicel(1,7)><$emotion(1,14)>Oh yeah—I’ve got something for ya! I picked it up on the<br>way over here!
msgctxt "1986:576"
msgid "<$voicel(1,7)><$emotion(1,14)>¡Ah, tengo algo para ti! ¡Toma! Me lo he encontrado<br>de camino hacia acá."
msgstr "<$voicel(1,7)><$emotion(1,14)>¡Ah, tengo algo para ti! ¡Toma! Me lo encontré<br>de camino hacia acá."

#. en: <oneline><$voicel(1,7)><$emotion(1,39)><$cdef(27)><pname;0></color>! The<br><$cdef(27)><cdirbname;1></color><slide><br>is finished!<clear><br><$voicel(1,6)><$comeff(1,9)><$motion(1,661)>Do you have time right now?! Check it out!
msgctxt "1986:585"
msgid "<$voicel(1,7)><$emotion(1,39)><oneline>¡<$cdef(27)><pname;0></color>! ¡Hemos terminado<br><dart;1()><$cdef(27)><cdirbname;1></color>!<clear><br><$voicel(1,6)><$comeff(1,9)><$motion(1,661)>¡Échal<qty;1(e,es)> un ojo, venga!"
msgstr "<$voicel(1,7)><$emotion(1,39)><oneline>¡<$cdef(27)><pname;0></color>! ¡Terminamos<br><dart;1()><$cdef(27)><cdirbname;1></color>!<clear><br><$voicel(1,6)><$comeff(1,9)><$motion(1,661)>¡Échal<qty;1(e,es)> un ojo, vamos!"

#. en: <$voicel(1,7)><$comeff(1,10)><$facial(1,4)><$motion(1,806)>And now for the BIG REVEAL! Dun da da daaaaaah!
msgctxt "1986:586"
msgid "<$voicel(1,7)><$comeff(1,10)><$facial(1,4)><$motion(1,806)>¡Es la hora de la revelación! ¿Estás list<gen;-2(ooo,aaa)>?<br>¡Tatatacháaan!"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,8)>Well, whatcha think? I’m really proud of this one, so I<br>hope you like it!<clear><br><$voicel(1,5)><$emotion(1,49)>And the next one’ll be even BETTER, so lemme know any<br>time you need me to <$cdef(27)><$spwfull(1)> </color>something!
msgctxt "1986:587"
msgid "<$voicel(1,7)><$emotion(1,8)>¿Y bien, qué te parece? ¡Estoy bastante orgullos<gen;-3(o,a)> de<br>cómo ha quedado! Espero que a ti también te guste.<clear><br><$voicel(1,5)><$emotion(1,49)>¡Ya ves que tengo mucha maña! ¡Avísame cuando haga<br>falta <$cdef(27)><$spwfull(1)> </color>algo más!"
msgstr "<$voicel(1,7)><$emotion(1,8)>¿Y bien, qué te parece? ¡Estoy bastante orgullos<gen;-3(o,a)> de<br>cómo quedó! Espero que a ti también te guste.<clear><br><$voicel(1,5)><$emotion(1,49)>¡Ya ves que tengo mucha maña! ¡Avísame cuando haga<br>falta <$cdef(27)><$spwfull(1)> </color>algo más!"

#. en: <$voicel(1,7)><$emotion(1,49)>Let’s play “look that way”! C’mooon, pleeeaaase?
msgctxt "1986:593"
msgid "<$voicel(1,7)><$emotion(1,49)>Oye, fiera, ¿quieres que juguemos a \"esquiva la baya\"?"
msgstr "<$voicel(1,7)><$emotion(1,49)>Oye, crack, ¿quieres que juguemos a \"esquiva la baya\"?"

#. en: <$voicel(1,9)><$emotion(1,53)>YEAHHH! OK, here we go!
msgctxt "1986:594"
msgid "<$voicel(1,9)><$emotion(1,53)>¡Genial! ¡Pues prepárate!"
msgstr ""

#. en: <$voicel(1,5)><$emotion(1,14)>Gotcha! No prob, let’s play some other time!
msgctxt "1986:595"
msgid "<$voicel(1,5)><$emotion(1,14)>¡Vale, no hay problema! Ya jugaremos en otro momento."
msgstr "<$voicel(1,5)><$emotion(1,14)>¡Está bien, no hay problema! Ya jugaremos en otro momento."

#. en: <$voicel(1,9)><$comeff(1,5)><$motion(1,805)>Ack, I lost! Congrats, <$cdef(27)><pname;0></color>!<clear><br><$voicel(1,5)><$emotion(1,49)>We GOTTA play again! I’ll definitely win next time!
msgctxt "1986:596"
msgid "<oneline><$voicel(1,9)><$comeff(1,5)><$motion(1,805)>Jaaa, me has ganado. ¡Menud<gen;-2(o,a)> crack eres,<br><$cdef(27)><pname;0></color>!<clear><br><$voicel(1,5)><$emotion(1,49)>¡Pero que sepas que la próxima vez te ganaré! ¡Ya verás!"
msgstr "<oneline><$voicel(1,9)><$comeff(1,5)><$motion(1,805)>Jaaa, me ganaste. ¡Menud<gen;-2(o,a)> crack eres,<br><$cdef(27)><pname;0></color>!<clear><br><$voicel(1,5)><$emotion(1,49)>¡Pero que sepas que la próxima vez te ganaré! ¡Ya verás!"

#. en: <oneline><$voicel(1,7)><$emotion(1,8)>OH YEAH! Looks like I win! Hehe, thanks for playing,<br><$cdef(27)><pname;1></color>!<clear><br><$voicel(1,6)><$emotion(1,49)>Let’s play again sometime! You’d better believe I’m gonna<br>win next time too!
msgctxt "1986:597"
msgid "<oneline><$voicel(1,7)><$emotion(1,8)>¡Síii! ¡He ganado! ¡Muchas gracias por jugar,<br><$cdef(27)><pname;1></color>!<clear><br><$voicel(1,6)><$emotion(1,49)>Ya nos echaremos otra partida... ¡en la que pienso ganar<br>otra vez! ¡Jaaa, ja, ja!"
msgstr "<oneline><$voicel(1,7)><$emotion(1,8)>¡Síii! ¡Gané! ¡Muchas gracias por jugar,<br><$cdef(27)><pname;1></color>!<clear><br><$voicel(1,6)><$emotion(1,49)>Ya jugaremos otra partida... ¡en la que pienso ganar<br>otra vez! ¡Jaaa, ja, ja!"

#. en: <$voicel(1,7)><$emotion(1,49)>HEY! Wanna play hide-and-sneak?! C’mon, I’ll be “it“—all<br>you gotta do is hide!
msgctxt "1986:610"
msgid "<$voicel(1,7)><$emotion(1,49)>¡Qué hayyy! Oye, ¿jugamos al escondite camuflado?<br>¡Te toca a ti esconderte!"
msgstr "<$voicel(1,7)><$emotion(1,49)>¡Holaaa! Oye, ¿jugamos al escondite camuflado?<br>¡Te toca a ti esconderte!"

#. en: <$voicel(1,7)><$emotion(1,1)>YEAH! There’s no way I’m gonna lose!
msgctxt "1986:611"
msgid "<$voicel(1,7)><$emotion(1,1)>¡Tomaaa! ¡No pienso perdeeer!"
msgstr "<$voicel(1,7)><$emotion(1,1)>¡Síii! ¡No pienso perdeeer!"

#. en: <$voicel(1,7)><$emotion(1,14)>Gotcha! No prob, let’s play some other time!
msgctxt "1986:612"
msgid "<$voicel(1,7)><$emotion(1,14)>¡Vale, no pasa nadaaa! ¡Otra vez será!"
msgstr "<$voicel(1,7)><$emotion(1,14)>¡Bueno, no pasa nadaaa! ¡Otra vez será!"

#. en: <$voicel(1,2)><$comeff(1,7)><$motion(1,805)>Ack, I lost?!
msgctxt "1986:617"
msgid "<$voicel(1,2)><$comeff(1,7)><$motion(1,805)>Qué maaal... ¡He perdido!"
msgstr "<$voicel(1,2)><$comeff(1,7)><$motion(1,805)>Qué maaal... ¡Perdí!"

#. en: <oneline><$voicel(1,9)><$emotion(1,48)>You are unbelievably good at this, <$cdef(27)><pname;0></color>!<br>You’re,<slide><br>like,<slide><br>a<slide><br>hide-and-sneak<slide><br>MASTER!<clear><br><$voicel(1,8)><$emotion(1,8)>So here’s a present worthy of a master!
msgctxt "1986:618"
msgid "<oneline><$voicel(1,9)><$emotion(1,48)>¡Eres <gen;-2(un,una)> fenómen<gen;-2(o,a)> jugando al escondite camuflado,<br><$cdef(27)><pname;0></color>!<slide><br><$voicel(1,8)><$emotion(1,8)>¡Te has ganado este regalo!"
msgstr "<oneline><$voicel(1,9)><$emotion(1,48)>¡Eres <gen;-2(un,una)> fenómen<gen;-2(o,a)> jugando al escondite camuflado,<br><$cdef(27)><pname;0></color>!<slide><br><$voicel(1,8)><$emotion(1,8)>¡Te ganaste este regalo!"

#. en: <$voicel(1,7)><$emotion(1,49)>Today was tons of fun! And you’d better believe I’m gonna<br>win NEXT time!
msgctxt "1986:619"
msgid "<$voicel(1,7)><$emotion(1,49)>¡Me lo he pasado que no veas, máquina! ¡Pero que conste<br>que la próxima vez voy a ganar yo!"
msgstr "<$voicel(1,7)><$emotion(1,49)>¡Me la pasé increíble, máquina! ¡Pero que conste<br>que la próxima vez voy a ganar yo!"

#. en: <$voicel(1,5)><$emotion(1,14)>Hehe... Is it all right if I call you that? To me it says like,<br>“WE’RE BESTIES!” <$voicel(1,8)><$facial(1,4)>Isn’t it the greatest?!<clear><br><$voicel(1,9)><$emotion(1,8)>OK! Then that’s what I’ll call you from now on! Lookin’<br>forward to it!
msgctxt "1986:620"
msgid "<$voicel(1,5)><$emotion(1,14)>¡Jaaa, ja, ja! ¡Oye, crack, espero que no te importe que<br>te llame por tu mote también!<clear><br><$voicel(1,8)><$facial(1,4)>¡Que para algo somos ya colegas del alma!<clear><br><$voicel(1,9)><$emotion(1,8)>¡Vete acostumbrando, es lo que toca a partir de ahora!"
msgstr "<$voicel(1,5)><$emotion(1,14)>¡Jaaa, ja, ja! ¡Oye, crack, espero que no te importe que<br>te llame por tu apodo también!<clear><br><$voicel(1,8)><$facial(1,4)>¡Que para algo ya somos inseparables!<clear><br><$voicel(1,9)><$emotion(1,8)>¡Vete acostumbrando, es lo que toca a partir de ahora!"

#. en: <$voicel(1,7)><$emotion(1,8)><$pkcry;0(1,2)>! ♪ YEAH! I’m unstoppable!
msgctxt "1986:622"
msgid "<$voicel(1,7)><$emotion(1,8)>¡<$pkcry;0(1,2)>! ¡Soy <gen;-3(un,una)> máquina jugando a esto!"
msgstr ""

#. en: <$voicel(1,9)><$emotion(1,53)>YEAH! There’s no way I’m gonna lose!
msgctxt "1986:623"
msgid "<$voicel(1,9)><$emotion(1,53)>¡Bieeen! ¡No me voy a dejar ganar, leyenda!"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,14)>Gotcha! No prob, let’s play some other time!
msgctxt "1986:624"
msgid "<$voicel(1,7)><$emotion(1,14)>¡Vale, pues hasta otra!"
msgstr "<$voicel(1,7)><$emotion(1,14)>¡Bueno, hasta la próxima!"

#. en: <$voicel(1,5)><$comeff(1,6)><$motion(1,805)><$facial(1,9)>Huh? What the heck?! The <$cdef(27)><fqty(1)><$ifull(1325)> </color>totally<br>stopped working!<clear><br><$voicel(1,3)><$emotion(1,47)>I’m SURE I didn’t press any weird buttons or anything...<br>But there’s no way I can <$cdef(27)><$spwfull(12)> </color>with anyone right now.
msgctxt "1986:667"
msgid "<$voicel(1,5)><$comeff(1,6)><$motion(1,805)><$facial(1,9)>¿Eh? ¿Qué pasa? La <$cdef(27)><fqty(1)><$ifull(1325)> </color>no tira...<clear><br><$voicel(1,3)><$emotion(1,47)>¡Te juro que yo no he hecho nada raro! Jo, qué palo.<br>Así no podemos <$cdef(27)><$spwfull(12)></color>."
msgstr "<$voicel(1,5)><$comeff(1,6)><$motion(1,805)><$facial(1,9)>¿Eh? ¿Qué pasa? La <$cdef(27)><fqty(1)><$ifull(1325)> </color>no funciona...<clear><br><$voicel(1,3)><$emotion(1,47)>¡Te juro que yo no hice nada raro! Ay, qué fastidio.<br>Así no podemos <$cdef(27)><$spwfull(12)></color>."

#. en: <oneline><$voicel(1,7)><$emotion(1,14)>Here are your<br><$cdef(27)><fqty(2)><class><reftarid;0></color>!<clear><br><$voicel(1,5)><$comeff(1,10)><$motion(1,806)>Uh—what I’ve had time to make, anyway! I’ll give ya the<br>rest when I’m finished!
msgctxt "1986:670"
msgid "<oneline><$voicel(1,7)><$emotion(1,14)>¡Aquí tienes <genqty;0(un,una,algunos,algunas)><br><$cdef(27)><class><reftarid;0></color>!<slide><br><$voicel(1,5)><$comeff(1,10)><$motion(1,806)>Vuelve más tarde a por el resto."
msgstr "<oneline><$voicel(1,7)><$emotion(1,14)>¡Aquí tienes <genqty;0(un,una,algunos,algunas)><br><$cdef(27)><class><reftarid;0></color>!<slide><br><$voicel(1,5)><$comeff(1,10)><$motion(1,806)>Vuelve más tarde por el resto."

#. en: <oneline><$emotion(1,14)><$voicel(1,7)>OH YEAH! I know where <$cdef(27)><pksrchtar;0></color> is!<br>Want<slide><br>me<slide><br>to<slide><br>bring<slide><br>you<slide><br>there?<slide><br><$emotion(1,8)><$voicel(1,10)>I<slide><br>can<slide><br>fly<slide><br>us<slide><br>over<slide><br>in<slide><br>the<slide><br>blink<slide><br>of<slide><br>an eye!
msgctxt "1986:680"
msgid "<$emotion(1,14)><$cdef(27)><$voicel(1,7)></color>¡Creo que sé dónde está! ¿Te acompaño, figura?<br><$emotion(1,8)><$voicel(1,10)>¡Volando llegamos en un segundo!"
msgstr "<$emotion(1,14)><$cdef(27)><$voicel(1,7)></color>¡Creo que sé dónde está! ¿Te acompaño, crack?<br><$emotion(1,8)><$voicel(1,10)>¡Volando llegamos en un segundo!"

#. en: <$voicel(1,5)><$emotion(1,14)><$facial(1,4)>I bet <$cdef(27)><pksrchtar;0> </color>is at their house! <clear><br><$voicel(1,7)><$comeff(1,6)><$motion(1,806)>Want me to bring you there? I can fly us over in the blink<br>of an eye!
msgctxt "1986:681"
msgid "<$voicel(1,5)><$emotion(1,14)><$cdef(27)><$facial(1,4)></color>¡Ah! ¡Pues, ahora que lo dices, creo que está en su casa!<br><$comeff(1,6)>¿Quieres que te lleve, fiera? <$voicel(1,7)><$motion(1,806)>¡Volando llegamos en un tris!"
msgstr "<$voicel(1,5)><$emotion(1,14)><$cdef(27)><$facial(1,4)></color>¡Ah! ¡Pues, ahora que lo dices, creo que está en su casa!<br><$comeff(1,6)>¿Quieres que te lleve, crack? <$voicel(1,7)><$motion(1,806)>¡Volando llegamos en nada!"

#. en: <oneline><$comeff(1,7)><$motion(1,802)><$voicel(1,3)>Sorry—haven’t seen <$cdef(27)><pksrchtar;0></color> at<br>all today!<clear><br><$comeff(1,6)><$motion(1,806)><$voicel(1,7)>But I could bring ya to their home! Wanna fly there? It’d<br>be super quick!
msgctxt "1986:682"
msgid "<$cdef(27)><$comeff(1,7)></color><$motion(1,802)><$voicel(1,3)>¡Lo siento, no tengo ni idea de dónde se ha metido hoy!<clear><br><$comeff(1,6)><$motion(1,806)><$voicel(1,7)>¿Quieres que te lleve a su casa a ver si está, máquina?<br>Volando llegamos en un momentillo."
msgstr "<$cdef(27)><$comeff(1,7)></color><$motion(1,802)><$voicel(1,3)>¡Lo siento, no tengo ni idea de dónde se metió hoy!<clear><br><$comeff(1,6)><$motion(1,806)><$voicel(1,7)>¿Quieres que te lleve a su casa a ver si está, máquina?<br>Volando llegamos en un momentito."

#. en: <oneline><$comeff(1,6)><$motion(1,805)><$voicel(1,5)><$cdef(27)><pksrchtar;0></color>? Haven’t ever seen ’em<br>around here!<clear><br><$comeff(1,3)><$motion(1,803)><$voicel(1,6)>Maybe they live somewhere far away?
msgctxt "1986:683"
msgid "<oneline><$comeff(1,6)><$motion(1,805)><$voicel(1,5)>¿<fcap><dart;0()><$cdef(27)><pksrchtar;0></color>? ¡Por aquí no está,<br>figura!<slide><br><$comeff(1,3)><$motion(1,803)><$voicel(1,6)>¿No vivirá en el quinto pino?"
msgstr "<oneline><$comeff(1,6)><$motion(1,805)><$voicel(1,5)>¿<fcap><dart;0()><$cdef(27)><pksrchtar;0></color>? ¡Por aquí no está,<br>crack!<slide><br><$comeff(1,3)><$motion(1,803)><$voicel(1,6)>¿No vivirá lejísimos?"

#. en: <$voicel(1,7)><$emotion(1,53)>ALL RIGHT! Hold on tight, it’s time to SOAR!
msgctxt "1986:684"
msgid "<$voicel(1,7)><$emotion(1,53)>¡Entendido! Tres... Dos... Uno... ¡Despegamooos!"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,49)>TOUCHDOWN! If you ever want to hit the skies again, you<br>know who to call!
msgctxt "1986:685"
msgid "<$voicel(1,7)><$emotion(1,49)>¡Aquí estamos! ¡Avísame si quieres ir a algún otro sitio!"
msgstr "<$voicel(1,7)><$emotion(1,49)>¡Aquí estamos! ¡Avísame si quieres ir a algún otro lugar!"

#. en: <oneline><$comeff(1,10)><$motion(1,801)><$voicel(1,7)>TOUCHDOWN! But, uhhh... I don’t see<br><$cdef(27)><pksrchtar;0></color><slide><br>ANYWHERE!
msgctxt "1986:686"
msgid "<$cdef(27)><$comeff(1,10)></color><$motion(1,801)><$voicel(1,7)>¡Hemos llegado! Ah, parece que no ha habido suerte.<br>No está aquí. Je."
msgstr "<$cdef(27)><$comeff(1,10)></color><$motion(1,801)><$voicel(1,7)>¡Llegamos! Ah, parece que no hubo suerte.<br>No está aquí. Je."

#. en: <$voicel(1,7)><$emotion(1,49)>Gotcha! But I’ll help out whenever you need, so just let<br>me know!
msgctxt "1986:687"
msgid "<$voicel(1,7)><$emotion(1,49)>¡De acuerdo! Tú avísame cuando quieras."
msgstr ""

#. en: <oneline><$emotion(1,14)><$voicel(1,7)>OH YEAH! I know where <$cdef(27)><pksrchtar;0></color> is!<br>Want<slide><br>me<slide><br>to<slide><br>bring<slide><br>you<slide><br>there?<slide><br><$emotion(1,8)><$voicel(1,10)><fcap><$cdef(27)><$spwfull(35)></color><slide><br>will<slide><br>get<slide><br>us<slide><br>there<slide><br>like FWOOM!
msgctxt "1986:688"
msgid "<$cdef(27)><$emotion(1,14)></color><$voicel(1,7)>¡Puede que sepa dónde está! ¿Quieres que te lleve?<br><$emotion(1,8)><$voicel(1,10)>¡Nos puedo <$cdef(27)><$spwfull(35)></color> y llegamos en nada!"
msgstr ""

#. en: <$voicel(1,5)><$emotion(1,14)><$facial(1,4)>I bet <$cdef(27)><pksrchtar;0> </color>is at their house! <clear><br><$voicel(1,7)><$comeff(1,6)><$motion(1,806)>Want me to bring you there? <fcap><$cdef(27)><$spwfull(35)></color> will get us there<br>like FWOOM!
msgctxt "1986:689"
msgid "<$voicel(1,5)><$cdef(27)><$emotion(1,14)></color><$facial(1,4)>¡Creo que está en su casa! Creo, ¿eh? <$comeff(1,6)>¿Vamos a ver?<br><$voicel(1,7)><$motion(1,806)>¡Te puedo <$cdef(27)><$spwfull(35)></color> allí en un tris!"
msgstr "<$voicel(1,5)><$cdef(27)><$emotion(1,14)></color><$facial(1,4)>¡Creo que está en su casa! Creo, ¿eh? <$comeff(1,6)>¿Vamos a ver?<br><$voicel(1,7)><$motion(1,806)>¡Te puedo <$cdef(27)><$spwfull(35)></color> allá en un instante!"

#. en: <oneline><$comeff(1,7)><$motion(1,802)><$voicel(1,3)>Sorry—haven’t seen <$cdef(27)><pksrchtar;0></color> at<br>all today!<clear><br><$motion(1,806)><$voicel(1,7)>But I could bring ya to their home! <$comeff(1,6)>You wanna <$cdef(27)><$spwfull(35)><br></color>there? It’d be super quick!
msgctxt "1986:690"
msgid "<oneline><$comeff(1,7)><$motion(1,802)><$voicel(1,3)>¡Lo siento, no tengo ni idea de dónde puede estar!<br><$comeff(1,6)><$motion(1,806)>¿Quieres que te lleve a su casa a ver si hay suerte?<clear><br><$cdef(27)><$voicel(1,7)></color>¡Te puedo <$cdef(27)><$spwfull(35)></color> y llegamos en un pispás!"
msgstr "<oneline><$comeff(1,7)><$motion(1,802)><$voicel(1,3)>¡Lo siento, no tengo ni idea de dónde puede estar!<br><$comeff(1,6)><$motion(1,806)>¿Quieres que te lleve a su casa a ver si hay suerte?<clear><br><$cdef(27)><$voicel(1,7)></color>¡Te puedo <$cdef(27)><$spwfull(35)></color> y llegamos en un dos por tres!"

#. en: <oneline><$comeff(1,6)><$motion(1,805)><$voicel(1,5)><$cdef(27)><pksrchtar;0></color>? Haven’t ever seen ’em<br>around here!<clear><br><$comeff(1,3)><$motion(1,803)><$voicel(1,6)>Maybe they live somewhere far away?
msgctxt "1986:691"
msgid "<$comeff(1,3)><$motion(1,805)><$voicel(1,5)>Creo que<$cdef(27)> </color>no está por aquí, no. <$comeff(1,6)><$motion(1,803)><$voicel(1,6)>¿Vivirá lejísimos o qué?"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,53)>ALL RIGHT! Get ready for my patented IIINSTAAANT...
msgctxt "1986:692"
msgid "<$voicel(1,7)><$emotion(1,53)>¡Entendido! ¡Venga, que te llevo!"
msgstr "<$voicel(1,7)><$emotion(1,53)>¡Entendido! ¡Vamos, que te llevo!"

#. en: <$voicel(1,7)><$voicel(1,7)><$emotion(1,49)>TELEPORTATIOOON! Here we are! And you know who to<br>call if you ever wanna <$cdef(27)><$spwfull(35)></color> again.
msgctxt "1986:693"
msgid "<$voicel(1,7)><$voicel(1,7)><$emotion(1,49)>¡Hemos llegado! ¡Avísame si quieres que te<br><$cdef(27)>teletransporte</color><nbs2><$spwicon(35)> a algún otro sitio!"
msgstr "<$voicel(1,7)><$voicel(1,7)><$emotion(1,49)>¡Llegamos! ¡Avísame si quieres que te<br><$cdef(27)>teletransporte</color><nbs2><$spwicon(35)> a algún otro lugar!"

#. en: <$comeff(1,10)><$motion(1,801)><$voicel(1,7)>...TELEPORTATIOOON! Here we are! But, uhhh... I don’t<br>see <$cdef(27)><pksrchtar;0> </color>ANYWHERE!
msgctxt "1986:694"
msgid "<$cdef(27)><$comeff(1,10)></color><$motion(1,801)><$voicel(1,7)>¡Hemos llegado! <wait(0.6)>Ah, pero parece que no está aquí."
msgstr "<$cdef(27)><$comeff(1,10)></color><$motion(1,801)><$voicel(1,7)>¡Llegamos! <wait(0.6)>Ah, pero parece que no está aquí."

#. en: <$voicel(1,7)><$emotion(1,49)>Gotcha! But I’ll help out whenever you need, so just let<br>me know!
msgctxt "1986:695"
msgid "<$voicel(1,7)><$emotion(1,49)>¡De acuerdo! ¡Tú avísame cuando lo necesites!"
msgstr ""

#. en: <oneline><$comeff(1,3)><$motion(1,803)><$voicel(1,7)><$cdef(27)><pksrchtar;0></color>? I’ve got a feeling they’re<br>over thataway!
msgctxt "1986:696"
msgid "<$cdef(27)><$comeff(1,3)></color><$motion(1,803)><$voicel(1,7)>¡Me suena que estaba por ahí!"
msgstr ""

#. en: <$comeff(1,3)><$motion(1,803)><$voicel(1,7)>I think <$cdef(27)><pksrchtar;0></color>’s prolly at their home!
msgctxt "1986:697"
msgid "<$cdef(27)><$comeff(1,3)></color><$motion(1,803)><$voicel(1,7)>¡Sí, sí, creo que está en su casa!"
msgstr ""

#. en: <oneline><$comeff(1,6)><$motion(1,805)><$voicel(1,8)><$cdef(27)><pksrchtar;0></color>? Ummm... Nope! Haven’t<br>seen<slide><br>’em<slide><br>at<slide><br>all today!
msgctxt "1986:698"
msgid "<$cdef(27)><$comeff(1,6)></color><$motion(1,805)><$voicel(1,8)>¿Hm? Pues no sé dónde se ha metido hoy, la verdad..."
msgstr "<$cdef(27)><$comeff(1,6)></color><$motion(1,805)><$voicel(1,8)>¿Hm? Pues no sé dónde se metió hoy, la verdad..."

#. en: <oneline><$comeff(1,6)><$motion(1,805)><$voicel(1,5)><$cdef(27)><pksrchtar;0></color>? Haven’t ever seen ’em<br>around here!<clear><br><$comeff(1,3)><$motion(1,803)><$voicel(1,6)>Maybe they live somewhere far away?
msgctxt "1986:699"
msgid "<$comeff(1,3)><$motion(1,805)><$voicel(1,5)>Por aquí no está, ¿eh? <$comeff(1,6)><$cdef(27)><$motion(1,803)></color><$voicel(1,6)>¿Será que vive en la otra punta del<br>mundo?"
msgstr ""

#. en: <oneline><$voicel(1,7)><$emotion(1,14)><$cdef(27)><pname;0></color>! I know that look—you’re<br>trying<slide><br>to<slide><br>FIND someone!
msgctxt "1986:700"
msgid "<oneline><$voicel(1,7)><$emotion(1,14)>¡Eyyy, máquina! ¿Estás buscando a alguien?"
msgstr ""

#. en: <$voicel(1,7)><$comeff(1,10)><$motion(1,805)><$facial(1,4)>Oh, really?! Guess I was wrong!
msgctxt "1986:701"
msgid "<$voicel(1,7)><$comeff(1,10)><$motion(1,805)><$facial(1,4)>¿Ah, no? ¡Ja! Tenías toda la pinta. Pues nada."
msgstr "<$voicel(1,7)><$comeff(1,10)><$motion(1,805)><$facial(1,4)>¿Ah, no? ¡Ja! Pues eso parecía. Me equivoqué."

#. en: <oneline><$comeff(1,10)><$motion(1,803)><$voicel(1,7)><$cdef(27)><pksrchtar;0></color>? I don’t know where they<br>are!<slide><br>Sorry, bestie!
msgctxt "1986:702"
msgid "<$comeff(1,10)><$motion(1,803)><$voicel(1,7)>Pues no tengo ni idea, ¿eh? ¡Se siente!"
msgstr "<$comeff(1,10)><$motion(1,803)><$voicel(1,7)>Pues no tengo ni idea, ¿eh? ¡Lo siento!"

#. en: <$voicel(1,3)><$comeff(1,7)><$motion(1,807)>How comfortable am I? Hmmm... Pretty <$cdef(27)><flow><$stflevel;0(1)></color>, I guess.
msgctxt "1986:750"
msgid "<$voicel(1,3)><$comeff(1,7)><$motion(1,807)>Crack, es <$cdef(27)><$stflevel;0(1)></color>, sin más."
msgstr ""

#. en: <$voicel(1,5)><$emotion(1,14)>How comfortable am I? Hmmm... Living here is <$cdef(27)><flow><$stflevel;0(2)></color>,<br>I guess!
msgctxt "1986:751"
msgid "<$voicel(1,5)><$emotion(1,14)>Pues, figura... <wait(1.0)>diría que es <$cdef(27)><$stflevel;0(2)></color>, no sé."
msgstr "<$voicel(1,5)><$emotion(1,14)>Pues, crack... <wait(1.0)>diría que es <$cdef(27)><$stflevel;0(2)></color>, no sé."

#. en: <$voicel(1,7)><$emotion(1,50)>How comfortable am I? Um... Living here is pretty <$cdef(27)><flow><$stflevel;0(3)></color>!
msgctxt "1986:752"
msgid "<oneline><$voicel(1,7)><$emotion(1,50)>¡Fiera, por ahora es <$cdef(27)><$stflevel;0(3)></color>!"
msgstr "<oneline><$voicel(1,7)><$emotion(1,50)>¡Crack, por ahora es <$cdef(27)><$stflevel;0(3)></color>!"

#. en: <$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>How comfortable am I? Well, living here is <$cdef(27)><flow><$stflevel;0(4)></color>!
msgctxt "1986:753"
msgid "<oneline><$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Venga, ¿te preocupa eso?...<wait(1.0)> ¡Si es <$cdef(27)><$stflevel;0(4)></color>,<br>máquina!"
msgstr "<oneline><$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Vamos, ¿te preocupa eso?...<wait(1.0)> ¡Si es <$cdef(27)><$stflevel;0(4)></color>,<br>máquina!"

#. en: <$voicel(1,7)><$emotion(1,7)>How comfortable am I?! Living here is <$cdef(27)><flow><$stflevel;0(5)></color>!<br><$voicel(1,7)><$emotion(1,49)>Seriously—every day is the absolute BEST!
msgctxt "1986:754"
msgid "<oneline><$voicel(1,7)><$emotion(1,7)>¡¡Es <$cdef(27)><$stflevel;0(5)></color>, fiera!!<clear><br><$voicel(1,7)><$emotion(1,49)>¡Se nota que has dado el callo a tope!"
msgstr "<oneline><$voicel(1,7)><$emotion(1,7)>¡¡Es <$cdef(27)><$stflevel;0(5)></color>, crack!!<clear><br><$voicel(1,7)><$emotion(1,49)>¡Se nota que te esforzaste un montón!"

#. en: <$voicel(1,8)><$emotion(1,49)>I mean, it’s better than it was before!
msgctxt "1986:756"
msgid "<$voicel(1,8)><$emotion(1,49)>¡Se está mejor que antes, que lo sepas también!"
msgstr ""

#. en: <oneline><$voicel(1,7)><$comeff(1,21)><$motion(1,805)><$facial(1,4)>Hey—it’s gotten pretty nice! Thanks a million,<br><$cdef(27)><pname;0></color>!
msgctxt "1986:757"
msgid "<oneline><$voicel(1,7)><$comeff(1,21)><$motion(1,805)><$facial(1,4)>¡Está bastante mejor! ¡Gracias, <$cdef(27)><pname;0></color>,<br>leyenda,<slide><br>figura!"
msgstr "<oneline><$voicel(1,7)><$comeff(1,21)><$motion(1,805)><$facial(1,4)>¡Está bastante mejor! ¡Gracias, <$cdef(27)><pname;0></color>,<br>leyenda,<slide><br>crack!"

#. en: <oneline><$voicel(1,3)><$comeff(1,7)><$facial(1,9)><$motion(1,666)>Hmmm... Hey, I appreciate this<br><$cdef(27)><fqty(1)><class><aireactp;0></color>,<slide><br>and<slide><br>all,<slide><br>but<slide><br>it<slide><br>might<slide><br>be<slide><br>a<slide><br>touch<slide><br>too<slide><br>small!<clear><br><$voicel(1,6)><$emotion(1,14)><$facial(1,4)>Got anything on the bigger side?
msgctxt "1986:758"
msgid "<oneline><$voicel(1,3)><$comeff(1,7)><$facial(1,9)><$motion(1,666)>Hmm... Est<genqty;0(e,a,os,as)> <$cdef(27)><fqty(1)><aireactp;0></color> me<br><qty;0(resulta,resultan)> un poco<slide><br>pequeñ<genqty;0(o,a,os,as)>,<slide><br>¿no te parece?<clear><br><$voicel(1,6)><$emotion(1,14)><$facial(1,4)>¡Molaría que me trajeses algo más grande!"
msgstr "<oneline><$voicel(1,3)><$comeff(1,7)><$facial(1,9)><$motion(1,666)>Hmm... Est<genqty;0(e,a,os,as)> <$cdef(27)><fqty(1)><aireactp;0></color> me<br><qty;0(resulta,resultan)> un poco<slide><br>pequeñ<genqty;0(o,a,os,as)>,<slide><br>¿no te parece?<clear><br><$voicel(1,6)><$emotion(1,14)><$facial(1,4)>¡Ojalá me trajeras algo más grande!"

#. en: <oneline><$voicel(1,7)><$emotion(1,49)>Thanks for the <$cdef(27)><fqty(1)><class><aireactp;0></color>,<br>by the way!
msgctxt "1986:761"
msgid "<oneline><$voicel(1,7)><$emotion(1,49)>¡Gracias por<br><dart;0()><$cdef(27)><fqty(1)><aireactp;0></color>!<slide><br>¡Eres <gen;-2(un,una)> crack!"
msgstr ""

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>How comfortable is my home? Uhhh... I couldn’t tell you<br>for sure unless I went back to check, but...<clear><br><$comeff(1,7)><$motion(1,802)><$voicel(1,4)>I’m PRETTY sure it was <$cdef(27)><flow><$stflevel;0(1)></color>...
msgctxt "1986:762"
msgid "<$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Complicado pensarlo estando lejos de casa...<wait(1.0)> <$comeff(1,7)><$motion(1,802)><$voicel(1,4)>pero<br>supongo que es <$cdef(27)><$stflevel;0(1)></color>."
msgstr ""

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>How comfortable is my home? Uhhh... I couldn’t tell you<br>for sure unless I went back to check, but...<clear><br><$comeff(1,3)><$motion(1,803)><$voicel(1,6)>I thiiink it was <$cdef(27)><flow><$stflevel;0(2)></color>...?
msgctxt "1986:763"
msgid "<$voicel(1,5)><$comeff(1,14)><$motion(1,666)>¿Eso quieres saber, máquina? Buah, y yo lejos de casa...<br><wait(1.0)><$comeff(1,3)><$motion(1,803)><$voicel(1,6)>Supongo que es <$cdef(27)><$stflevel;0(2)></color>."
msgstr "<$voicel(1,5)><$comeff(1,14)><$motion(1,666)>¿Eso quieres saber, máquina? Uf, y yo lejos de casa...<br><wait(1.0)><$comeff(1,3)><$motion(1,803)><$voicel(1,6)>Supongo que es <$cdef(27)><$stflevel;0(2)></color>."

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>How comfortable is my home? Uhhh... I couldn’t tell you<br>for sure unless I went back to check, but...<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,8)>I’m pretty sure it was <$cdef(27)><flow><$stflevel;0(3)></color>!
msgctxt "1986:764"
msgid "<$voicel(1,5)><$comeff(1,14)><$motion(1,666)>¡Ya podría estar en casa para responderte bien! Pues...<wait(1.0)><br><$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,8)>¡Yo diría que <$cdef(27)><$stflevel;0(3)></color>, crack!"
msgstr ""

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>How comfortable is my home? Uhhh... I couldn’t tell you<br>for sure unless I went back to check, but...<clear><br><$comeff(1,21)><$motion(1,801)><$voicel(1,10)>Hmmm... Yeah, I think it was <$cdef(27)><flow><$stflevel;0(4)></color>!
msgctxt "1986:765"
msgid "<$voicel(1,5)><$comeff(1,14)><$motion(1,666)>A ver... No lo sabré al 100<nbs4>% hasta que esté en casa,<br>pero... <wait(1.0)><$comeff(1,21)><$motion(1,801)><$voicel(1,10)>¡yo diría que es <$cdef(27)><$stflevel;0(4)> </color>como poco!"
msgstr "<$voicel(1,5)><$comeff(1,14)><$motion(1,666)>A ver... No lo sabré al 100<nbs4>% hasta que esté en casa,<br>pero... <wait(1.0)><$comeff(1,21)><$motion(1,801)><$voicel(1,10)>¡yo diría que es <$cdef(27)><$stflevel;0(4)> </color>como mínimo!"

#. en: <oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>How comfortable is my home? Uhhh... I couldn’t tell you<br>for sure unless I went back to check, but...<clear><br><$comeff(1,8)><$motion(1,801)><$voicel(1,9)>Oh yeah! It was totally <$cdef(27)><flow><$stflevel;0(5)></color>! Living there makes<br>me<slide><br>super happy! ♪
msgctxt "1986:766"
msgid "<oneline><$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Máquinaaa, esto no se pregunta estando yo fuera de casa.<br>Menuda dudaaa... <wait(1.0)><$comeff(1,8)><$motion(1,801)><$voicel(1,9)>¡Jaaa, es broma, lo tengo clarísimo!<clear><br>¡Es <$cdef(27)><$stflevel;0(5)></color>! ¡Se está que da gusto!"
msgstr "<oneline><$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Máquinaaa, esto no se pregunta estando yo fuera de casa.<br>Qué dilemaaa... <wait(1.0)><$comeff(1,8)><$motion(1,801)><$voicel(1,9)>¡Jaaa, es broma, lo tengo clarísimo!<clear><br>¡Es <$cdef(27)><$stflevel;0(5)></color>! ¡Se está que da gusto!"

#. en: <$voicel(1,6)><$emotion(1,49)>I think it’s better than before!
msgctxt "1986:767"
msgid "<$voicel(1,6)><$emotion(1,49)>¡Mejor que antes, la verdad!"
msgstr ""

#. en: <oneline><$voicel(1,7)><$emotion(1,49)>I think it’s WAY better than before! Thanks a million,<br><$cdef(27)><pname;0></color>!
msgctxt "1986:768"
msgid "<oneline><$voicel(1,7)><$emotion(1,49)>¡Ha mejorado tela! ¡Muchas gracias,<br><$cdef(27)><pname;0></color>!"
msgstr "<oneline><$voicel(1,7)><$emotion(1,49)>¡Mejoró muchísimo! ¡Muchas gracias,<br><$cdef(27)><pname;0></color>!"

#. en: <$voicel(1,7)><$emotion(1,38)>My place is over this way! C’mon, keep up!
msgctxt "1986:769"
msgid "<$voicel(1,7)><$emotion(1,38)>Sígueme, figura, que te llevo a mi casa. ¡Por aquí!"
msgstr "<$voicel(1,7)><$emotion(1,38)>Sígueme, crack, que te llevo a mi casa. ¡Por aquí!"

#. en: <$voicel(1,7)><$emotion(1,14)>My home is over thataway!<clear><br><$voicel(1,3)><$comeff(1,4)><$motion(1,807)><$facial(1,9)>Oh wait—I’m actually a little busy right now, so I can’t<br>show you the way! My bad!
msgctxt "1986:770"
msgid "<$voicel(1,7)><$emotion(1,14)>¡Mi casa está para allá!<clear><br><$voicel(1,3)><$comeff(1,4)><$motion(1,807)><$facial(1,9)>Pero ahora mismo tengo cosas que hacer, así que no<br>puedo ir contigo..."
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,53)>For real?! You put what I asked for in my house? YESSS!<br>Thank yooouuu!
msgctxt "1986:771"
msgid "<$voicel(1,7)><$emotion(1,53)>¿Has ido cargando con eso hasta mi casa? ¡Te sales!<br>¡Mil gracias, crack!"
msgstr "<$voicel(1,7)><$emotion(1,53)>¿Cargaste con eso hasta mi casa? ¡Eres lo máximo!<br>¡Mil gracias, crack!"

#. en: <oneline><$voicel(1,7)><$emotion(1,27)>Wha—?! Did you put that<br><$cdef(27)><fqty(1)><class></color><$cdef(27)><stfrevp;0></color><slide><br><$voicel(1,10)><$emotion(1,38)>outside<slide><br>for<slide><br>me?<slide><br>Thanks<slide><br>a bunch!
msgctxt "1986:772"
msgid "<oneline><$voicel(1,7)><$emotion(1,27)>¡Pero si hay<br><iart;0()><$cdef(27)><fqty(1)><class><stfrevp;0><slide><br></color>fuera!<slide><br><$voicel(1,10)><$emotion(1,38)>¡Muchas gracias, fiera!"
msgstr "<oneline><$voicel(1,7)><$emotion(1,27)>¡Pero si hay<br><iart;0()><$cdef(27)><fqty(1)><class><stfrevp;0><slide><br></color>afuera!<slide><br><$voicel(1,10)><$emotion(1,38)>¡Muchas gracias, crack!"

#. en: <$comeff(1,6)><$motion(1,666)><$voicel(1,5)>How comfortable is my home? Uh, I, like, JUST started<br>living in it...<$comeff(1,14)><$motion(1,807)><$voicel(1,6)>so I’ve got NO clue yet!<clear><br><$comeff(1,3)><$motion(1,803)><$voicel(1,8)>Ask me again once I’ve had time to get my bearings!
msgctxt "1986:773"
msgid "<$comeff(1,6)><$motion(1,666)><$voicel(1,5)>¿Cómo? ¡Pero si me acabo de mudaaar! A saber.<clear><br><$comeff(1,14)><$motion(1,807)><$voicel(1,6)>Necesito un tiempillo para pensarlo, figura... <wait(1.0)><$comeff(1,3)><$motion(1,803)><$voicel(1,8)>Mejor<br>pregúntame más tarde."
msgstr "<$comeff(1,6)><$motion(1,666)><$voicel(1,5)>¿Cómo? ¡Pero si me acabo de mudaaar! Quién sabe.<clear><br><$comeff(1,14)><$motion(1,807)><$voicel(1,6)>Necesito un tiempito para pensarlo, crack... <wait(1.0)><$comeff(1,3)><$motion(1,803)><$voicel(1,8)>Mejor<br>pregúntame más tarde."

#. en: <oneline><$emotion(1,8)><$voicel(1,8)>Thanks so much, <$cdef(27)><pname;0></color>!<clear><br><$emotion(1,14)><$voicel(1,5)>Oh, wait. <$emotion(1,41)><$voicel(1,4)>I’m actually not a huge fan of stuff like this<br><$cdef(27)><fqty(1)><class><stfrevp;2></color>.<clear><br><$comeff(1,6)><$facial(1,1)><$motion(1,666)><$voicel(1,6)>Got anything else?
msgctxt "1986:774"
msgid "<oneline><$emotion(1,8)><$voicel(1,8)>¡Gracias, crack!<clear><br><oneline><$emotion(1,14)><$voicel(1,5)>Ah, pero <qty;2(es,son)><br><iart;2()><$cdef(27)><fqty(1)><class><stfrevp;2></color>...<slide><br><$emotion(1,41)><$voicel(1,4)>La verdad es que no me mat<qty;2(a,an)>.<clear><br><$comeff(1,6)><$facial(1,1)><$motion(1,666)><$voicel(1,6)>Prefiero otra cosa."
msgstr "<oneline><$emotion(1,8)><$voicel(1,8)>¡Gracias, crack!<clear><br><oneline><$emotion(1,14)><$voicel(1,5)>Ah, pero <qty;2(es,son)><br><iart;2()><$cdef(27)><fqty(1)><class><stfrevp;2></color>...<slide><br><$emotion(1,41)><$voicel(1,4)>La verdad, no me encant<qty;2(a,an)>.<clear><br><$comeff(1,6)><$facial(1,1)><$motion(1,666)><$voicel(1,6)>Prefiero otra cosa."

#. en: <oneline><$voicel(1,3)><$comeff(1,7)><$facial(1,9)><$motion(1,666)>Hmmm... Hey, I appreciate that<br><$cdef(27)><fqty(1)><class><stfrevp;0></color><slide><br>and<slide><br>all,<slide><br>but<slide><br>it<slide><br>might<slide><br>be<slide><br>a<slide><br>touch<slide><br>too<slide><br>small!<clear><br><$voicel(1,6)><$emotion(1,14)><$facial(1,4)>Got anything on the bigger side?
msgctxt "1986:775"
msgid "<oneline><$voicel(1,3)><$comeff(1,7)><$facial(1,9)><$motion(1,666)>Ufff, no sé yo.<br><fcap><iart;0()><fqty(1)><class><$cdef(27)><stfrevp;0></color><slide><br><genqty;0(lo,la,los,las)> veo pequeñ<genqty;0(o,a,os,as)><slide><br>para mí.<clear><br><$voicel(1,6)><$emotion(1,14)><$facial(1,4)>Sería genial si tuvieras algo más grande."
msgstr ""

#. en: <oneline><$voicel(1,7)><$emotion(1,49)><$cdef(27)><pname;0></color>! You’ve sure been busy pickin’<br>stuff<slide><br>up lately!<clear><br><$voicel(1,9)><$comeff(1,6)><$motion(1,666)><$facial(1,5)>Are you gonna craft something TOTALLY AWESOME?!<br><$voicel(1,8)><$comeff(1,5)><$motion(1,801)><$facial(1,4)>You GOTTA show me if you do!
msgctxt "1986:801"
msgid "<oneline><$voicel(1,7)><$emotion(1,49)>¡Qué hayyy, <$cdef(27)><pname;0></color>! ¡No hago más<br>que verte recoger cosas por ahí!<clear><br><$voicel(1,9)><$motion(1,666)><$facial(1,5)>Eso es que vas a fabricar algo muy guapo, <$comeff(1,6)>¿a que sí?<br><$voicel(1,8)><$comeff(1,5)><$motion(1,801)><$facial(1,4)>¡Necesito saber qué eeesss!"
msgstr "<oneline><$voicel(1,7)><$emotion(1,49)>¡Holaaa, <$cdef(27)><pname;0></color>! ¡No hago más<br>que verte recoger cosas por ahí!<clear><br><$voicel(1,9)><$motion(1,666)><$facial(1,5)>Eso es que vas a fabricar algo increíble, <$comeff(1,6)>¿verdad?<br><$voicel(1,8)><$comeff(1,5)><$motion(1,801)><$facial(1,4)>¡Necesito saber qué eeesss!"

#. en: <$voicel(1,5)><$emotion(1,29)>Whatcha got planned for today? Same as yesterday?<$voicel(1,7)><$emotion(1,38)> Let’s<br>hang out together if you’ve got time!
msgctxt "1986:802"
msgid "<$voicel(1,5)><$emotion(1,29)>¿Qué vas a hacer hoy? ¿Vas a seguir con lo de ayer?<br><$voicel(1,7)><$emotion(1,38)>¡Si tienes un rato, podríamos jugar a algo, máquina!"
msgstr ""

#. en: <oneline><$voicel(1,5)><$comeff(1,14)><$motion(1,805)><$facial(1,4)>What’s that, you say? The<br><$cdef(27)><asnbname;0></color><slide><br>is<slide><br>just<slide><br>SO awesome?<clear><br><$voicel(1,9)><$comeff(1,5)><$motion(1,801)>Hehehe... Well of COURSE it is! I’m the one who made it!<br><$voicel(1,8)><$emotion(1,49)>Please, please...do NOT hold your applause! Hehehe!
msgctxt "1986:803"
msgid "<oneline><$voicel(1,5)><$comeff(1,14)><$motion(1,805)><$facial(1,4)>¡Quien haya construido<br><dart;0()><$cdef(27)><asnbname;0></color><$cdef(27)></color><slide><br>es<genqty;0(e,a,os,as)> debe de ser <gen;-3(un,una)> crack!<clear><br><$voicel(1,9)><$comeff(1,5)><$motion(1,801)>Jaaa. ¡Es broma! ¡<gen;-3(El,La)> que lo ha construido soy yo!<br><$voicel(1,8)><$emotion(1,49)>¡Un aplauso por mi obraaa!"
msgstr "<oneline><$voicel(1,5)><$comeff(1,14)><$motion(1,805)><$facial(1,4)>¡Quien haya construido<br><dart;0()><$cdef(27)><asnbname;0></color><$cdef(27)></color><slide><br>es<genqty;0(e,a,os,as)> debe de ser <gen;-3(un,una)> crack!<clear><br><$voicel(1,9)><$comeff(1,5)><$motion(1,801)>Jaaa. ¡Es broma! ¡<gen;-3(El,La)> que lo construyó soy yo!<br><$voicel(1,8)><$emotion(1,49)>¡Un aplauso por mi obraaa!"

#. en: <oneline><$voicel(1,7)><$comeff(1,5)><$motion(1,803)><$facial(1,13)>Wha—?! When the heck did that<br><$cdef(27)><rctbname;0></color><slide><br>get finished?!<clear><br><$voicel(1,5)><$comeff(1,4)><$motion(1,805)><$facial(1,9)>I’m so sad that I missed the unveiling... I LOVE new stuff!
msgctxt "1986:804"
msgid "<oneline><$voicel(1,7)><$comeff(1,5)><$motion(1,803)><$facial(1,13)>¡Halaaa! ¿Cuándo se ha construido<br><dart;0()><$cdef(27)><rctbname;0></color>?<clear><br><$voicel(1,5)><$comeff(1,4)><$motion(1,805)><$facial(1,9)>¡Con lo que me gusta meterme en todos los fregaos,<br>y ni me había enterado!"
msgstr "<oneline><$voicel(1,7)><$comeff(1,5)><$motion(1,803)><$facial(1,13)>¡Guaaau! ¿Cuándo se construyó<br><dart;0()><$cdef(27)><rctbname;0></color>?<clear><br><$voicel(1,5)><$comeff(1,4)><$motion(1,805)><$facial(1,9)>¡Con lo que me gusta estar al tanto de todo,<br>y ni me había enterado!"

#. en: <oneline><$voicel(1,7)><$comeff(1,21)><$motion(1,803)><$facial(1,4)>Oh YEAH! I can’t wait to see<br><$cdef(27)><acqpname;0></color><slide><br>again!<clear><br><$voicel(1,5)><$emotion(1,38)>I just suddenly remembered how much fun we had hanging<br>out together!
msgctxt "1986:805"
msgid "<oneline><$voicel(1,7)><$comeff(1,21)><$motion(1,803)><$facial(1,4)>¡Qué ganas más locas de volver a ver a<br><$cdef(27)><acqpname;0></color>!<clear><br><$voicel(1,5)><$emotion(1,38)>Me he acordado, así de repente, de lo bien que nos<br>lo pasamos la última vez que jugamos."
msgstr "<oneline><$voicel(1,7)><$comeff(1,21)><$motion(1,803)><$facial(1,4)>¡Qué ganas más locas de volver a ver a<br><$cdef(27)><acqpname;0></color>!<clear><br><$voicel(1,5)><$emotion(1,38)>Me acordé, así de repente, de lo bien que nos<br>la pasamos la última vez que jugamos."

#. en: <$voicel(1,5)><$emotion(1,27)>Hey! Don’t think I’ve ever seen you rockin’ that look<br>before, <$cdef(27)><pname;0></color>!<clear><br><$voicel(1,7)><$emotion(1,38)>Yup yup, looking STY-L-ISH! I totally love it!
msgctxt "1986:806"
msgid "<$voicel(1,5)><$emotion(1,27)>¡Ey, leyendaaa! Nunca te había visto llevar eso puesto.<br>¿Estás de estreno?<clear><br><$voicel(1,7)><$emotion(1,38)>¡Toma estilazooo! ¡Me encanta cómo te queda!"
msgstr "<$voicel(1,5)><$emotion(1,27)>¡Ey, leyendaaa! Nunca te había visto llevar eso puesto.<br>¿Estás de estreno?<clear><br><$voicel(1,7)><$emotion(1,38)>¡Qué estilazooo! ¡Me encanta cómo te queda!"

#. en: <$voicel(1,5)><$comeff(1,6)><$motion(1,666)>Wha—?! Could it be? Have you done some sorta SUPER<br>tiny transformation, <$cdef(27)><pname;0></color>?<clear><br><$voicel(1,7)><$emotion(1,49)>Wow! I almost didn’t notice AT ALL! Kinda annoyed I<br>didn’t see it sooner!
msgctxt "1986:807"
msgid "<oneline><$voicel(1,5)><$comeff(1,6)><$motion(1,666)>¿Eh? Oye, <$cdef(27)><pname;0></color>...<br>¿esa transformación<slide><br>es nueva?<clear><br><$voicel(1,7)><$emotion(1,49)>Vaya, ¡es que acabo de darme cuenta del cambio!<br>¡Tengo que fijarme un poco más!"
msgstr ""

#. en: <oneline><$voicel(1,7)><$emotion(1,14)><$pkcry;0(1,2)>! Any day is a perfect day whenever<$voicel(1,6)><$comeff(1,21)><$motion(1,806)><$facial(1,4)> I get<br>to<slide><br>see<slide><br>YOU, <$cdef(27)><pname;1></color>!<clear><br><$voicel(1,8)><$emotion(1,49)>Thanks for always being there, bestie!
msgctxt "1986:808"
msgid "<oneline><$voicel(1,7)><$emotion(1,14)>¡<$pkcry;0(1,2)>! Desde que nos conocimos,<br><$cdef(27)><pname;1></color>,<slide><br><$voicel(1,6)><$comeff(1,21)><$motion(1,806)><$facial(1,4)>¡todos los días son una pasada!<clear><br><$voicel(1,8)><$emotion(1,49)>¡Gracias por todo, monstru<gen;-2(o,a)>!"
msgstr "<oneline><$voicel(1,7)><$emotion(1,14)>¡<$pkcry;0(1,2)>! Desde que nos conocimos,<br><$cdef(27)><pname;1></color>,<slide><br><$voicel(1,6)><$comeff(1,21)><$motion(1,806)><$facial(1,4)>¡todos los días son geniales!<clear><br><$voicel(1,8)><$emotion(1,49)>¡Gracias por todo, amig<gen;-2(o,a)>!"

#. en: <$voicel(1,3)><$emotion(1,29)>What the heck even IS that weird ring thing on <$cdef(27)>Professor<br>Tangrowth</color>’s<$cdef(27)> </color>head?<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,666)>I’ve heard humans had this sweet treat that’s shaped like<br>a ring... <$voicel(1,4)>Do you think it’s one of those? *drool*
msgctxt "1986:809"
msgid "<$voicel(1,3)><$emotion(1,29)>¿Qué crees que será el coso redondo ese tan raro que<br>lleva el <$cdef(27)>Profesor Tangrowth</color> en la cabeza?<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Me han dicho que los humanos tenían un dulce con<br>esa forma y un agujero en el centro, pero...<slide><br><$voicel(1,4)>¿de verdad será eso lo que lleva? Y... <wait(0.5)>¿estará rico?"
msgstr "<$voicel(1,3)><$emotion(1,29)>¿Qué crees que será esa cosa redonda tan rara que<br>lleva el <$cdef(27)>Profesor Tangrowth</color> en la cabeza?<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Me dijeron que los humanos tenían un dulce con<br>esa forma y un agujero en el centro, pero...<slide><br><$voicel(1,4)>¿de verdad será eso lo que lleva? Y... <wait(0.5)>¿estará rico?"

#. en: <oneline><$voicel(1,8)><$comeff(1,10)><$facial(1,4)>Hehehe... <$voicel(1,5)>I’m REALLY happy you chose me as a roommate,<br><$cdef(27)><pname;0></color>!<slide><br><$voicel(1,7)><$emotion(1,8)>But<slide><br>I<slide><br>knew<slide><br>ya would!<clear><br><$voicel(1,5)><$comeff(1,8)><$motion(1,803)>I hope you love living here too!
msgctxt "1986:810"
msgid "<$voicel(1,8)><$comeff(1,10)><$facial(1,4)>¡Jaaa, ja, ja!<clear><br><$voicel(1,5)>Saber que te voy a ver en casa todos los días hace que<br>me entre una risita tonta, <$voicel(1,7)><$emotion(1,8)>¡no lo puedo evitar!<clear><br><$voicel(1,5)><$comeff(1,8)><$motion(1,803)>¡Espero que a ti también te haga ilusión verme todos los<br>días, <$cdef(27)><pname;0></color>!"
msgstr ""

#. en: <oneline><$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,6)>Hey, hey! <$cdef(27)><pname;0></color>! Check this out—I<br>wrote<slide><br>a<slide><br>song<slide><br>about you!<clear><br><$comeff(1,13)><$facial(1,14)><$motion(1,805)><$voicel(1,9)>Ohhh,  <$cdef(27)><pname;1></color>... ♪ The best at building<br>hooomes! ♪<slide><br>You’re<slide><br>everyone’s<slide><br>favorite,<slide><br>every<slide><br>daaay! ♪ <$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>YAYYY! ♪
msgctxt "1986:811"
msgid "<oneline><$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,6)>¡Oye, oyeee! He compuesto una canción, así que dime<br>qué te parece, ¿valeee?<clear><br><oneline><$comeff(1,13)><$facial(1,14)><$motion(1,805)><$voicel(1,9)>♪Las casas de <$cdef(27)><pname;1></color> parten la pana.<br><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>Si no te da una hoy, ¡ya te tocará mañana!♪"
msgstr "<oneline><$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,6)>¡Oye, oyeee! He compuesto una canción, así que dime<br>qué te parece, ¿síii?<clear><br><oneline><$comeff(1,13)><$facial(1,14)><$motion(1,805)><$voicel(1,9)>♪Las casas de <$cdef(27)><pname;1></color> son lo máximo, ¡qué ganas!<br><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>Si no te da una hoy, ¡ya te tocará mañana!♪"

#. en: <$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Now, what’s on today’s workout plan? Should I practice the<br>same move I did yesterday? <$voicel(1,4)>Or should I try to learn a<slide><br>new one?<clear><br><$voicel(1,10)><$comeff(1,5)><$motionoff(1,804)>AHH! Just the THOUGHT of it gets me all hyped up!
msgctxt "1986:812"
msgid "<$voicel(1,5)><$comeff(1,14)><$motion(1,666)>A ver, ¿qué entreno hoy? Igual puedo ver si ya domino<br>mejor el movimiento que practiqué ayer...<clear><br><$voicel(1,4)>O, idea muy loca: ¡puedo practicar otro!<clear><br><$voicel(1,10)><$comeff(1,5)><$motionoff(1,804)>¡No me decido, pero solo de pensarlo ya me estoy<br>viniendo arriba!"
msgstr "<$voicel(1,5)><$comeff(1,14)><$motion(1,666)>A ver, ¿qué entreno hoy? Tal vez puedo ver si ya domino<br>mejor el movimiento que practiqué ayer...<clear><br><$voicel(1,4)>O, idea muy loca: ¡puedo practicar otro!<clear><br><$voicel(1,10)><$comeff(1,5)><$motionoff(1,804)>¡No me decido, pero solo de pensarlo ya me estoy<br>emocionando!"

#. en: <$voicel(1,7)><$emotion(1,49)>I always make super-DUPER sure that my beautiful coat<br>stays nice and clean!<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Like when I’m eating—I try not to drool on it! <$voicel(1,8)><$emotion(1,27)>And when<br>I’m sleeping...I try not to drool on it! Stuff like that!
msgctxt "1986:815"
msgid "<$voicel(1,7)><$emotion(1,49)>¡Me esfuerzo mucho por mantener mi pelaje siempre<br>limpio! No me gusta que se ensucie.<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,666)>¡Intento evitar que se manche de babas cuando me pongo<br>a comer <$voicel(1,8)><$emotion(1,27)>o cuando me duermo como un tronco!"
msgstr ""

#. en: <$voicel(1,8)><$comeff(1,14)><$motion(1,803)>Argh, I can’t WAIT to grow up!<clear><br><$voicel(1,9)><$emotion(1,38)>When I get bigger, I’ll be strong enough to play all day<br>AND night!<$voicel(1,8)><$comeff(1,9)><$motion(1,805)> <$pkcry;0(1,1)>! I can’t wait! ♪
msgctxt "1986:817"
msgid "<$voicel(1,8)><$comeff(1,14)><$motion(1,803)>¡Quiero hacerme mayooor!<clear><br><$voicel(1,9)><$emotion(1,38)>¡Cuando crezca y tenga más fuerzas, podré pasarme el<br>día entero, de la mañana a la noche, jugando sin parar!<slide><br><$voicel(1,8)><$comeff(1,9)><$motion(1,805)>¡Va a ser la leche! ♪<$pkcry;0(1,1)>.♪"
msgstr "<$voicel(1,8)><$comeff(1,14)><$motion(1,803)>¡Quiero hacerme grandeee!<clear><br><$voicel(1,9)><$emotion(1,38)>¡Cuando crezca y tenga más fuerzas, podré pasarme el<br>día entero, de la mañana a la noche, jugando sin parar!<slide><br><$voicel(1,8)><$comeff(1,9)><$motion(1,805)>¡Va a ser lo máximo! ♪<$pkcry;0(1,1)>.♪"

#. en: <oneline><$voicel(1,5)><$emotion(1,14)>The other day I saw <$cdef(27)><$tonepk;0(6)></color> wander<br>right<slide><br>into<slide><br>a<slide><br>ROCK<slide><br><$voicel(1,8)><$comeff(1,10)><$facial(1,4)>because<slide><br>they<slide><br>were<slide><br>so sleepy!<clear><br><$voicel(1,9)><$emotion(1,8)>That absent-mindedness is actually kinda endearing!
msgctxt "1986:823"
msgid "<oneline><$voicel(1,5)><$emotion(1,14)>¡No te lo vas a creer!<clear><br>¡Antes vi <esa;0()><$cdef(27)><$tonepk;0(6)></color> con una cara<br>de sueño de aúpa<slide><br><$voicel(1,8)><$comeff(1,10)><$facial(1,4)>pegarse un batacazo<slide><br>contra una roca!<clear><br><$voicel(1,9)><$emotion(1,8)>¡Casi me parto de la risa! Pero ese toque empanado suyo<br>la verdad es que tiene mucho encanto."
msgstr "<oneline><$voicel(1,5)><$emotion(1,14)>¡No te lo vas a creer!<clear><br>¡Antes vi <esa;0()><$cdef(27)><$tonepk;0(6)></color> con una cara<br>de sueño tremenda<slide><br><$voicel(1,8)><$comeff(1,10)><$facial(1,4)>darse un golpazo<slide><br>contra una roca!<clear><br><$voicel(1,9)><$emotion(1,8)>¡Casi me muero de la risa! Pero ese toque despistado suyo<br>la verdad es que tiene mucho encanto."

#. en: <oneline><$voicel(1,5)>So like, even if it’s a little hard to understand what<br><$cdef(27)><$tonepk;0(17)></color><slide><br>is<slide><br>thinkin’ sometimes...<clear><br><$voicel(1,10)><$emotion(1,14)><$facial(1,4)>They’re actually SUPER nice! <$voicel(1,7)><$emotion(1,8)>Like earlier—they went to<br>all this trouble to find my favorite berry just so they<slide><br>could share it with me! ♪
msgctxt "1986:834"
msgid "<$voicel(1,5)>Me cuesta mucho saber qué le ronda por la cabeza<br><esa;0()><$cdef(27)><$tonepk;0(17)></color>.<clear><br><$voicel(1,10)><$emotion(1,14)><$facial(1,4)>Pero cuando le hablas, ¡te das cuenta de lo maj<gen;0(o,a)> que es!<clear><br><$voicel(1,7)><$emotion(1,8)>El otro día hasta me trajo una de mis bayas favoritas así<br>porque sí. ¡Flipas!"
msgstr "<$voicel(1,5)>Me cuesta mucho saber qué le ronda por la cabeza<br><esa;0()><$cdef(27)><$tonepk;0(17)></color>.<clear><br><$voicel(1,10)><$emotion(1,14)><$facial(1,4)>Pero al hablarle, ¡te das cuenta de lo simpátic<gen;0(o,a)> que es!<clear><br><$voicel(1,7)><$emotion(1,8)>El otro día hasta me trajo una de mis bayas favoritas así<br>porque sí. ¡Increíble!"

#. en: <oneline><$emotion(1,8)><$voicel(1,7)>Hey, <$cdef(27)><pname;0></color>! You’re always cutting and<br>breaking<slide><br>stuff,<slide><br>right?<clear><br><$emotion(1,55)><$voicel(1,6)>It’d be SO useful if I could do that too! <wait(1.5)><$comeff(1,21)><$facial(1,4)><$voicel(1,8)>D’you think I’ll get<br>updated with that feature at some point?
msgctxt "1986:835"
msgid "<$emotion(1,8)><$voicel(1,7)>Oye, figura, te veo siempre cortando y rompiendo cosas<br>por aquí y por allá.<clear><br><$emotion(1,55)><$voicel(1,6)>¿No habrá algún parche o algo que pueda instalarme<br>para aprender a hacerlo yo también? <wait(1.5)><$comeff(1,21)><$facial(1,4)><$voicel(1,8)>¡Sería tela de útil!"
msgstr "<$emotion(1,8)><$voicel(1,7)>Oye, crack, te veo siempre cortando y rompiendo cosas<br>por aquí y por allá.<clear><br><$emotion(1,55)><$voicel(1,6)>¿No habrá algún parche o algo que pueda instalarme<br>para aprender a hacerlo yo también? <wait(1.5)><$comeff(1,21)><$facial(1,4)><$voicel(1,8)>¡Sería superútil!"

#. en: <$emotion(1,15)><$voicel(1,8)>If you wanna make good hammers, you’ll hafta work real<br>hard EVERY DAY!<clear><br><$motionoff(1,804)><$comeff(1,10)><$facial(1,4)><$voicel(1,7)>You’ve gotta gather up and try out LOTS of materials to<br>make ’em stronger bit by bit!
msgctxt "1986:836"
msgid "<$emotion(1,15)><$voicel(1,8)>Si quieres hacerte un martillo to guapo, ¡te lo tienes que<br>currar día sí y día también!<clear><br><$motionoff(1,804)><$comeff(1,10)><$facial(1,4)><$voicel(1,7)>Hay que buscar buenos materiales y hacer un millón<br>de pruebas para ir reforzándolo poco a poco."
msgstr "<$emotion(1,15)><$voicel(1,8)>Si quieres hacerte un martillo genial, ¡te tienes que<br>esforzar día sí y día también!<clear><br><$motionoff(1,804)><$comeff(1,10)><$facial(1,4)><$voicel(1,7)>Hay que buscar buenos materiales y hacer un millón<br>de pruebas para ir reforzándolo poco a poco."

#. en: <$voicel(1,7)><$emotion(1,27)><$cdef(27)><gevcmainpk;0> </color>has been all hyped up recently! They keep<br><$voicel(1,6)><$comeff(1,10)><$facial(1,4)>talkin’ about this BIG PLAN they have with you!
msgctxt "1986:851"
msgid "<oneline><$voicel(1,7)><$emotion(1,27)>¡<fcap><dart;0()><$cdef(27)><gevcmainpk;0></color> está más feliz que nunca!<br><$voicel(1,6)><$comeff(1,10)><$facial(1,4)>¡Dice que te tiene<slide><br>preparado algo genial!"
msgstr ""

#. en: <$emotion(1,60)><$voicel(1,8)>...Heh heh, how was THAT?<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,9)>Think I nailed the impression? We’re gonna find out,<br>’cause it’s QUIZ TIME! <$emotion(1,29)><$voicel(1,8)>Who was I just now?
msgctxt "1986:853"
msgid "...<clear><br><$emotion(1,60)><$voicel(1,8)>¡Ya paro, ya paro!<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,9)>¿Qué te ha parecido? ¿Se me da bien imitar a los demás<br>o qué? Y ahora... ¡adivina, adivinanza!<clear><br><$emotion(1,29)><$voicel(1,8)>¿A quién he imitado?"
msgstr "...<clear><br><$emotion(1,60)><$voicel(1,8)>¡Ya paro, ya paro!<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,9)>¿Qué te pareció? ¿Se me da bien imitar a los demás<br>o qué? Y ahora... ¡adivina, adivinanza!<clear><br><$emotion(1,29)><$voicel(1,8)>¿A quién imité?"

#. en: <$comeff(1,20)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Exactly! I knew you’d get it, bestie!
msgctxt "1986:854"
msgid "<$comeff(1,20)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Correctooo! ¡No esperaba menos de ti, crack!"
msgstr ""

#. en: <oneline><$comeff(1,1)><$facial(1,4)><$motion(1,806)><$voicel(1,9)>Nope! I was trying to be <$cdef(27)><apfquizpk;0(0)></color>!<br><$emotion(1,8)><$voicel(1,8)><$pkcry;1(1,2)>! ♪<slide><br>Doing<slide><br>impressions<slide><br>is fun!
msgctxt "1986:855"
msgid "<oneline><$comeff(1,1)><$facial(1,4)><$motion(1,806)><$voicel(1,9)>¡Has fallado, eeeh! ¡Estaba clarísimo que era<br><dart;0()><$cdef(27)><apfquizpk;0(0)></color>!<clear><br><$emotion(1,8)><$voicel(1,8)>♪¡<$pkcry;1(1,2)>!♪ ¡Buah, cómo molan las imitaciones!"
msgstr "<oneline><$comeff(1,1)><$facial(1,4)><$motion(1,806)><$voicel(1,9)>¡Fallaste, eeeh! ¡Estaba clarísimo que era<br><dart;0()><$cdef(27)><apfquizpk;0(0)></color>!<clear><br><$emotion(1,8)><$voicel(1,8)>♪¡<$pkcry;1(1,2)>!♪ ¡Me encantan las imitaciones!"

#. en: <$voicel(1,3)><$motion(1,666)><$facial(1,2)><$comeff(1,6)>Hm? I should hold on to that <$cdef(27)><fqty(1)><$ifull(432)></color>? <$emotion(1,60)><$voicel(1,6)>You got it!
msgctxt "1986:859"
msgid "<$cdef(27)><$voicel(1,3)></color><$motion(1,666)><$facial(1,2)><$comeff(1,6)>¿Cómooo? ¿Que me quede este <$cdef(27)><fqty(1)><$ifull(432)></color>?<br><wait(1.0)><$emotion(1,60)><$voicel(1,6)>Jaaa, ¡por mí bien! Qué guapo."
msgstr "<$cdef(27)><$voicel(1,3)></color><$motion(1,666)><$facial(1,2)><$comeff(1,6)>¿Cómooo? ¿Que me quede este <$cdef(27)><fqty(1)><$ifull(432)></color>?<br><wait(1.0)><$emotion(1,60)><$voicel(1,6)>Jaaa, ¡por mí bien! Qué bonito."

#. en: <$voicel(1,9)><$emotion(1,39)>WHOA! The shine on this thing’s unreal! Here—it’s<br>all yours!
msgctxt "1986:860"
msgid "<$voicel(1,9)><$emotion(1,39)>¡Halaaa, está brillando! Bah, será mejor que te lo quedes<br>tú, <$cdef(27)><pname;0></color>."
msgstr "<$voicel(1,9)><$emotion(1,39)>¡Guaaau, está brillando! Bah, será mejor que te lo quedes<br>tú, <$cdef(27)><pname;0></color>."

#. en: <oneline><$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>Wha—?! <$cdef(27)><pname;0></color>?! I couldn’t tell it was<br>you<slide><br>at<slide><br>ALL!<slide><br><$comeff(1,3)><$facial(1,4)><$motion(1,805)><$voicel(1,8)>You’re<slide><br>really<slide><br>good<slide><br>at<slide><br>transforming, huh?<clear><br><$comeff(1,9)><$motion(1,801)><$voicel(1,10)>Here ya go! <$cdef(27)><fcap><fqty(1)><$ifull(532)></color>!
msgctxt "1986:862"
msgid "<oneline><$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>Halaaa, ¡si eres <$cdef(27)><pname;0></color>! ¡¡Esto sí que no<br>me lo veía<slide><br>venir!!<slide><br><wait(1.0)><$comeff(1,3)><$facial(1,4)><$motion(1,805)><$voicel(1,8)>Te transformas de lujo, eh.<clear><br><$comeff(1,9)><$motion(1,801)><$voicel(1,10)>Toma, te has ganado esta <$cdef(27)><fqty(1)><$ifull(532)></color>."
msgstr "<oneline><$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>Guaaau, ¡si eres <$cdef(27)><pname;0></color>! ¡¡Esto sí que no<br>me lo veía<slide><br>venir!!<slide><br><wait(1.0)><$comeff(1,3)><$facial(1,4)><$motion(1,805)><$voicel(1,8)>Te transformas de lujo, eh.<clear><br><$comeff(1,9)><$motion(1,801)><$voicel(1,10)>Toma, te ganaste esta <$cdef(27)><fqty(1)><$ifull(532)></color>."

#. en: <oneline><$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>Wha—?! <$cdef(27)><pname;0></color>?! I couldn’t tell it was<br>you<slide><br>at<slide><br>ALL!<slide><br><$comeff(1,3)><$facial(1,4)><$motion(1,805)><$voicel(1,8)>You’re<slide><br>really<slide><br>good<slide><br>at<slide><br>transforming, huh?<clear><br><$comeff(1,9)><$motion(1,801)><$voicel(1,10)>Here ya go! <$cdef(27)><fcap><fqty(1)><$ifull(532)></color>!
msgctxt "1986:863"
msgid "<oneline><$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>Halaaa, ¡si eres <$cdef(27)><pname;0></color>! ¡¡Esto sí que no<br>me lo veía<slide><br>venir!!<slide><br><wait(1.0)><$comeff(1,3)><$facial(1,4)><$motion(1,805)><$voicel(1,8)>Te transformas de lujo, eh.<clear><br><$comeff(1,9)><$motion(1,801)><$voicel(1,10)>Toma, te has ganado unas <$cdef(27)><fqty(2)><$ifull(532)></color>."
msgstr "<oneline><$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>Guaaau, ¡si eres <$cdef(27)><pname;0></color>! ¡¡Esto sí que no<br>me lo veía<slide><br>venir!!<slide><br><wait(1.0)><$comeff(1,3)><$facial(1,4)><$motion(1,805)><$voicel(1,8)>Te transformas de lujo, eh.<clear><br><$comeff(1,9)><$motion(1,801)><$voicel(1,10)>Toma, te ganaste unas <$cdef(27)><fqty(2)><$ifull(532)></color>."

#. en: <$voicel(1,8)><$emotion(1,14)>Aww, I WANT to go...<clear><br><$voicel(1,3)><$comeff(1,14)><$motion(1,666)>But I gotta say no this time! I mean, <$voicel(1,6)>there’s LOTS of<br>other Pokémon who want to visit, right?<clear><br><$voicel(1,8)><$emotion(1,49)>Just promise you’ll invite me again soon, OK?!
msgctxt "1986:902"
msgid "<$voicel(1,8)><$emotion(1,14)>Hala, ¡me encantaría ir! Pero creo que tengo que <$voicel(1,3)>rechazar<br>la invitación.<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,6)>Sé que hay muchos otros Pokémon interesados en ir,<br>así que estaría feo quitarles la oportunidad.<clear><br><$voicel(1,8)><$emotion(1,49)>¡Tú avísame la próxima vez!"
msgstr "<$voicel(1,8)><$emotion(1,14)>Ay, ¡me encantaría ir! Pero creo que tengo que <$voicel(1,3)>rechazar<br>la invitación.<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,6)>Sé que hay muchos otros Pokémon interesados en ir,<br>así que estaría feo quitarles la oportunidad.<clear><br><$voicel(1,8)><$emotion(1,49)>¡Tú avísame la próxima vez!"

#. en: <oneline><$voicel(1,7)><$emotion(1,8)>Hey, thanks for hanging out today,<br><$cdef(27)><pname;0></color>!<slide><br>I<slide><br>had<slide><br>a<slide><br>blast,<slide><br>all<slide><br>’cause<slide><br>of<slide><br>YOU!<slide><br><$voicel(1,6)><$emotion(1,49)>Invite<slide><br>me<slide><br>again soon!
msgctxt "1986:903"
msgid "<oneline><$voicel(1,7)><$emotion(1,8)>¡Muchas gracias por invitarme, <$cdef(27)><pname;0></color>!<br>¡Me lo he pasado<slide><br>en grandeee!<clear><br><$voicel(1,6)><$emotion(1,49)>¡Vuelve a invitarme cuando quieras, ¿eh?!"
msgstr "<oneline><$voicel(1,7)><$emotion(1,8)>¡Muchas gracias por invitarme, <$cdef(27)><pname;0></color>!<br>¡Me la pasé<slide><br>en grandeee!<clear><br><$voicel(1,6)><$emotion(1,49)>¡Vuelve a invitarme cuando quieras, ¿eh?!"

#. en: <$voicel(1,6)><$emotion(1,14)>What?! Heck yeah I wanna visit!<clear><br><$voicel(1,7)><$emotion(1,8)>All right, it’s a plan! I’ll stop by later on to hang out!<br>Thanks a bunch! ♪
msgctxt "1986:904"
msgid "<$voicel(1,6)><$emotion(1,14)>¿En seriooo? ¡Claro que sí, figura, me encantaría ir!<br><$voicel(1,7)><$emotion(1,8)>Me pasaré dentro de un rato, ¿vale?"
msgstr "<$voicel(1,6)><$emotion(1,14)>¿En seriooo? ¡Claro que sí, crack, me encantaría ir!<br><$voicel(1,7)><$emotion(1,8)>Me pasaré dentro de un rato, ¿sí?"

#. en: <$voicel(1,7)><$emotion(1,38)>Oh—you headed off somewhere?! C’mon, bring me with!<br>PLEASE!
msgctxt "1986:905"
msgid "<$voicel(1,7)><$emotion(1,38)>¡Eyyy, fiera! ¿Te vas de viaje? ¿Te importa si voy?"
msgstr "<$voicel(1,7)><$emotion(1,38)>¡Eyyy, crack! ¿Te vas de viaje? ¿Te importa si voy?"

#. en: <$voicel(1,5)><$emotion(1,14)>Oh, really? OK! No prob, I’ll come along next time!
msgctxt "1986:906"
msgid "<$voicel(1,5)><$emotion(1,14)>Vale, no te rayes. ¡A la próxima será!"
msgstr "<$voicel(1,5)><$emotion(1,14)>Bueno, no te preocupes. ¡A la próxima será!"

#. en: <$voicel(1,7)><$emotion(1,8)>Ahh, that was SOOO fun! I can’t wait for our next outing!
msgctxt "1986:907"
msgid "<$voicel(1,7)><$emotion(1,8)>¡Me lo he pasado en grande! ¡Qué ganas de la siguiente<br>excursión!"
msgstr "<$voicel(1,7)><$emotion(1,8)>¡Me la pasé en grande! ¡Qué ganas de la siguiente<br>excursión!"

#. en: <oneline><$comeff(1,3)><$motion(1,803)><$voicel(1,8)>HEYOOO!<clear><br><$comeff(1,6)><$motion(1,666)><$voicel(1,5)>Remember me? I’m buddies with<br><$cdef(27)><nowner;1></color>!<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,7)>I came to hang out where YOU live,<br><$cdef(27)><pname;2></color>!<slide><br><$comeff(1,10)><$motion(1,801)><$voicel(1,10)>Wow,<slide><br>it’s<slide><br>pretty<slide><br>nice here!
msgctxt "1986:921"
msgid "<oneline><$comeff(1,3)><$motion(1,803)><$voicel(1,8)>¡Buenaaas! No sé si te acuerdas de mí.<clear><br><$motion(1,666)><$voicel(1,5)>Soy colega de <$cdef(27)><nowner;1></color>. <$comeff(1,6)>¿Te suena?<br>Vengo de visita.<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,7)>Así que aquí es donde vives, ¿eh,<br><$cdef(27)><pname;2></color>?<slide><br><$comeff(1,10)><$motion(1,801)><$voicel(1,10)>¡Pues mola mucho!"
msgstr "<oneline><$comeff(1,3)><$motion(1,803)><$voicel(1,8)>¡Buenaaas! No sé si te acuerdas de mí.<clear><br><$motion(1,666)><$voicel(1,5)>Me llevo muy bien con <$cdef(27)><nowner;1></color>.<br><$comeff(1,6)>¿Te suena? Vengo de visita.<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,7)>Así que aquí es donde vives, ¿eh,<br><$cdef(27)><pname;2></color>?<slide><br><$comeff(1,10)><$motion(1,801)><$voicel(1,10)>¡Pues está genial!"
