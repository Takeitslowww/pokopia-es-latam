#. en: <$voicel(1,7)><$emotion(1,14)>HEY! Nice to meet ya! You look like a pretty nice<br>Pokémon!<$voicel(1,10)><$emotion(1,8)> You wanna be friends?<clear><br><$voicel(1,8)><$emotion(1,49)>Let’s hang out a BUNCH!
msgctxt "1986:3"
msgid "<$voicel(1,7)><$emotion(1,14)>¡Qué hayyy! Oye, ¡pareces buena gente!<br><$voicel(1,10)><$emotion(1,8)>¿Quieres ser <gen;-2(amigo mío,amiga mía)>?<clear><br><$voicel(1,8)><$emotion(1,49)>¡Así podemos quedar y pasar el rato!"
msgstr "<$voicel(1,7)><$emotion(1,14)>¡Holaaa! Oye, ¡pareces buena gente!<br><$voicel(1,10)><$emotion(1,8)>¿Quieres ser <gen;-2(amigo mío,amiga mía)>?<clear><br><$voicel(1,8)><$emotion(1,49)>¡Así podemos vernos y pasar el rato!"

#. en: <oneline><$voicel(1,7)><$emotion(1,50)><$pkcry;0(1,2)>! ♪ Nice to meet ya!<clear><br><$voicel(1,5)><$emotion(1,38)>I’m buddies with <$cdef(27)><nowner;2></color>.<$voicel(1,7)><$emotion(1,14)><$facial(1,4)> And I’d LOVE<br>to<slide><br>be<slide><br>friends<slide><br>with<slide><br>YOU too!
msgctxt "1986:4"
msgid "<$voicel(1,7)><$emotion(1,50)>¡<$pkcry;0(1,2)>! ¡Hola, fiera! ¡Encantad<gen;-3(o,a)>!<clear><br><$voicel(1,5)><$emotion(1,38)>¡Soy amig<gen;-3(o,a)> de <$cdef(27)><nowner;2></color>!<br><$voicel(1,7)><$emotion(1,14)><$facial(1,4)>¡Y sería lo más poder hacerme también amig<gen;-3(o,a)> tuy<gen;-3(o,a)>!"
msgstr "<$voicel(1,7)><$emotion(1,50)>¡<$pkcry;0(1,2)>! ¡Hola, crack! ¡Encantad<gen;-3(o,a)>!<clear><br><$voicel(1,5)><$emotion(1,38)>¡Soy amig<gen;-3(o,a)> de <$cdef(27)><nowner;2></color>!<br><$voicel(1,7)><$emotion(1,14)><$facial(1,4)>¡Y sería genial poder hacerme también amig<gen;-3(o,a)> tuy<gen;-3(o,a)>!"

#. en: <oneline><$voicel(1,7)><$emotion(1,50)><$pkcry;0(1,2)>! ♪ Nice to meet ya!<clear><br><$voicel(1,5)><$emotion(1,38)>I’m buddies with <$cdef(27)><acqpname;2></color>.<$voicel(1,7)><$emotion(1,14)><$facial(1,4)> And I’d LOVE<br>to<slide><br>be<slide><br>friends<slide><br>with<slide><br>YOU too!
msgctxt "1986:5"
msgid "<$voicel(1,7)><$emotion(1,50)>¡<$pkcry;0(1,2)>! ¡Hola, fiera! ¡Encantad<gen;-3(o,a)>!<clear><br><$voicel(1,5)><$emotion(1,38)>¡Soy amig<gen;-3(o,a)> de <$cdef(27)><acqpname;2></color>!<br><$voicel(1,7)><$emotion(1,14)><$facial(1,4)>¡Y sería lo más poder hacerme también amig<gen;-3(o,a)> tuy<gen;-3(o,a)>!"
msgstr "<$voicel(1,7)><$emotion(1,50)>¡<$pkcry;0(1,2)>! ¡Hola, crack! ¡Encantad<gen;-3(o,a)>!<clear><br><$voicel(1,5)><$emotion(1,38)>¡Soy amig<gen;-3(o,a)> de <$cdef(27)><acqpname;2></color>!<br><$voicel(1,7)><$emotion(1,14)><$facial(1,4)>¡Y sería genial poder hacerme también amig<gen;-3(o,a)> tuy<gen;-3(o,a)>!"

#. en: <$voicel(1,7)><$emotion(1,50)><$pkcry;0(1,2)>! ♪ Nice to meet ya!<clear><br><$voicel(1,5)><$emotion(1,38)>I’m friends with that other Ditto. And I’d LOVE to be<br>friends with YOU too!
msgctxt "1986:6"
msgid "<$voicel(1,7)><$emotion(1,50)>¡<$pkcry;0(1,2)>! ¡Hola, fiera! ¡Encantad<gen;-3(o,a)>!<clear><br><$voicel(1,5)><$emotion(1,38)>¡Soy amig<gen;-3(o,a)> del Ditto que vive aquí!<br>¡Y sería lo más poder hacerme también amig<gen;-3(o,a)> tuy<gen;-3(o,a)>!"
msgstr "<$voicel(1,7)><$emotion(1,50)>¡<$pkcry;0(1,2)>! ¡Hola, crack! ¡Encantad<gen;-3(o,a)>!<clear><br><$voicel(1,5)><$emotion(1,38)>¡Soy amig<gen;-3(o,a)> del Ditto que vive aquí!<br>¡Y sería genial poder hacerme también amig<gen;-3(o,a)> tuy<gen;-3(o,a)>!"

#. en: <$voicel(1,7)><$emotion(1,7)><$pkcry;0(1,1)>... I followed some awesome smell and<br>ended up back HOME?!
msgctxt "1986:8"
msgid "<$voicel(1,7)><$emotion(1,7)><$pkcry;0(1,1)>... Iba siguiendo un olor muy rico y...<br>¡sin enterarme, he llegado de vuelta a casa!"
msgstr "<$voicel(1,7)><$emotion(1,7)><$pkcry;0(1,1)>... Iba siguiendo un olor muy rico y...<br>¡sin enterarme, llegué de vuelta a casa!"

#. en: <oneline><$facial(1,5)><$motion(1,801)><$voicel(1,10)><$comeff(1,10)><$cdef(27)><pname;0></color>! Hi!!! Ohmygosh, I’m THRILLED<br>to see<slide><br>you!<slide><br>Let’s<slide><br>hang out!
msgctxt "1986:9"
msgid "<$facial(1,5)><$motion(1,801)><$voicel(1,10)><$comeff(1,10)>¡<$cdef(27)><pname;0></color>! ¡Cuánto tiempo sin verte!<br>¡Ya te echaba de menos, máquina, fiera, figura!"
msgstr "<$facial(1,5)><$motion(1,801)><$voicel(1,10)><$comeff(1,10)>¡<$cdef(27)><pname;0></color>! ¡Cuánto tiempo sin verte!<br>¡Ya te extrañaba, crack, genio, leyenda!"

#. en: <$voicel(1,5)><$emotion(1,50)><$pkcry;0(1,2)>! ♪ HEYO! You takin’ a little stroll?<clear><br><$voicel(1,7)><$comeff(1,10)><$motion(1,805)><$facial(1,4)>I came to check this place out too! Seems like a totally<br>sweet place to live!
msgctxt "1986:10"
msgid "<$voicel(1,5)><$emotion(1,50)>¡<$pkcry;0(1,2)>! ¡Qué pasa, leyenda! ¿Estás de paseo?<clear><br><$voicel(1,7)><$comeff(1,10)><$motion(1,805)><$facial(1,4)>Igual yo también me doy una vuelta, en plan tranqui,<br>que este sitio está guapísimo."
msgstr "<$voicel(1,5)><$emotion(1,50)>¡<$pkcry;0(1,2)>! ¡Qué tal, leyenda! ¿Estás de paseo?<clear><br><$voicel(1,7)><$comeff(1,10)><$motion(1,805)><$facial(1,4)>Tal vez yo también me doy una vuelta, bien tranqui,<br>que este lugar está increíble."

#. en: <$emotion(1,55)><$voicel(1,5)>No matter where I am, my scent always gives me away...
msgctxt "1986:46"
msgid "<$emotion(1,55)><$voicel(1,5)>Todo el mundo sabe siempre dónde encontrarme por<br>culpa de mi olor... ¡Así no hay quien se escaquee, eh!"
msgstr "<$emotion(1,55)><$voicel(1,5)>Todo el mundo sabe siempre dónde encontrarme por<br>culpa de mi olor... ¡Así no hay forma de escaparse, eh!"

#. en: <$emotion(1,55)><$voicel(1,5)>Without any humans around, I haven’t undergone<br>maintenance in a while.<clear><br><$comeff(1,10)><$motion(1,807)><$facial(1,9)><$voicel(1,4)>Makes it a little tricky to relax, y’know?
msgctxt "1986:48"
msgid "<$emotion(1,55)><$voicel(1,5)>Nadie me ha hecho una puesta a punto en condiciones<br>desde que los humanos se dieron el piro.<clear><br><$comeff(1,10)><$motion(1,807)><$facial(1,9)><$voicel(1,4)>Uf, como un día me falle algo y la líe parda, verás tú."
msgstr "<$emotion(1,55)><$voicel(1,5)>Nadie me ha hecho una puesta a punto como se debe<br>desde que los humanos se fueron.<clear><br><$comeff(1,10)><$motion(1,807)><$facial(1,9)><$voicel(1,4)>Uf, si un día me falla algo y armo un desastre, ya verás."

#. en: <$emotion(1,65)><$voicel(1,5)>Think anyone’s dropped some nice metal around here?<br>I need some material for my hammer!
msgctxt "1986:49"
msgid "<$emotion(1,65)><$voicel(1,5)>No habrás visto cachos de metal resultones por ahí, ¿no?<br>¡Me vendrían de lujo para mi martillo, máquina!"
msgstr "<$emotion(1,65)><$voicel(1,5)>No habrás visto pedazos de metal buenos por ahí, ¿no?<br>¡Me vendrían de lujo para mi martillo, crack!"

#. en: <$emotion(1,65)><$voicel(1,5)>Pretty seashells...round stones... The more you explore the<br>ocean, <$motionoff(1,804)><$comeff(1,9)><$facial(1,4)><$voicel(1,8)>the more awesome things you’ll discover!
msgctxt "1986:50"
msgid "<$emotion(1,65)><$voicel(1,5)>Vieiras guapísimas, cantos rodados...<clear><br><$motionoff(1,804)><$comeff(1,9)><$facial(1,4)><$voicel(1,8)>¡El mar esconde tela de secretos para los que se atreven<br>a explorar!"
msgstr "<$emotion(1,65)><$voicel(1,5)>Vieiras preciosas, cantos rodados...<clear><br><$motionoff(1,804)><$comeff(1,9)><$facial(1,4)><$voicel(1,8)>¡El mar esconde muchos secretos para los que se atreven<br>a explorar!"

#. en: <$voicel(1,7)><$emotion(1,14)><$facial(1,4)>Isn’t my fluffy coat just the CUTEST?! Seriously! <$voicel(1,10)><$comeff(1,9)><$motion(1,806)>There’s no<br>way your run-of-the-mill Pokémon could ever compare!
msgctxt "1986:51"
msgid "<$voicel(1,7)><$emotion(1,14)><$facial(1,4)>¡Eh, figura! ¿Has visto lo bonito que tengo el pelaje?<br>¡Es porque compararme con los demás me motiva mucho!<clear><br><$voicel(1,10)><$comeff(1,9)><$motion(1,806)>¡No pienso quedarme atráaas!"
msgstr "<$voicel(1,7)><$emotion(1,14)><$facial(1,4)>¡Oye, crack! ¿Ya viste lo bonito que tengo el pelaje?<br>¡Es porque compararme con los demás me motiva mucho!<clear><br><$voicel(1,10)><$comeff(1,9)><$motion(1,806)>¡No pienso quedarme atráaas!"

#. en: <$voicel(1,7)><$emotion(1,14)>Y’know, they say when you get bigger, you see just how<br>big the world is too.<clear><br><$voicel(1,4)><$comeff(1,6)><$motion(1,666)>Uh, what the heck does THAT mean?! Like...is my vision<br>going to get better or something?
msgctxt "1986:52"
msgid "<$voicel(1,7)><$emotion(1,14)>¡Qué pasaaa! Oye, ¿tú entiendes eso de que cuando te<br>haces mayor, tus horizontes se expanden?<clear><br><$voicel(1,4)><$comeff(1,6)><$motion(1,666)>¿Qué querrá decir? ¿Que voy a crecer horizontalmente?"
msgstr "<$voicel(1,7)><$emotion(1,14)>¡Holaaa! Oye, ¿tú entiendes eso de que cuando te<br>haces mayor, tus horizontes se expanden?<clear><br><$voicel(1,4)><$comeff(1,6)><$motion(1,666)>¿Qué querrá decir? ¿Que voy a crecer horizontalmente?"

#. en: <oneline><$voicel(1,7)><$emotion(1,39)>This <$cdef(27)><fqty(1)><class><usingp;0> </color>is<br>SICK,<slide><br>right?<slide><br>Heh,<slide><br>I<slide><br>really<slide><br>gave<slide><br>it<slide><br>my all!
msgctxt "1986:53"
msgid "<oneline><$voicel(1,7)><$emotion(1,39)><fcap><dart;0()><fqty(1)><$cdef(27)><usingp;0> </color>est<genqty;0(e,a,os,as)> <qty;0(ha,han)><br>quedado<slide><br>muy guap<genqty;0(o,a,os,as)>, ¿eh?<clear><br>Es que cuando lo das todo en la construcción, se nota."
msgstr "<oneline><$voicel(1,7)><$emotion(1,39)><fcap><dart;0()><fqty(1)><$cdef(27)><usingp;0> </color>est<genqty;0(e,a,os,as)> <qty;0(ha,han)><br>quedado<slide><br>muy bonit<genqty;0(o,a,os,as)>, ¿eh?<clear><br>Es que cuando lo das todo en la construcción, se nota."

#. en: <oneline><$voicel(1,7)><$emotion(1,49)>What an AWESOME<br><$cdef(27)><fqty(1)><class><usingp;0></color>!<slide><br>Just<slide><br>LOOKING<slide><br>at<slide><br>it<slide><br>hypes<slide><br>me up!
msgctxt "1986:54"
msgid "<$voicel(1,7)><$emotion(1,49)>¡Qué pasada <dart;0()><$cdef(27)><fqty(1)><usingp;0></color>!<br>¡Solo con ver<genqty;0(lo,la,los,las)>, me lleno de energía!"
msgstr "<$voicel(1,7)><$emotion(1,49)>¡Qué increíble <dart;0()><$cdef(27)><fqty(1)><usingp;0></color>!<br>¡Solo con ver<genqty;0(lo,la,los,las)>, me lleno de energía!"

#. en: <$comeff(1,10)><$facial(1,1)><$motion(1,801)><$voicel(1,9)>Going on walks in new places is awesome! Doesn’t it just<br>make you wanna look for treasure?
msgctxt "1986:56"
msgid "<$comeff(1,10)><$facial(1,1)><$motion(1,801)><$voicel(1,9)>Me apetece salir de paseo y ponerme a buscar tesoros.<br>¿Qué me dices? ¿Vamos a algún sitio nuevo? Vengaaa."
msgstr "<$comeff(1,10)><$facial(1,1)><$motion(1,801)><$voicel(1,9)>Quiero salir de paseo y ponerme a buscar tesoros.<br>¿Qué me dices? ¿Vamos a algún lugar nuevo? Anímateee."

#. en: <$comeff(1,3)><$facial(1,1)><$motion(1,805)><$voicel(1,6)>Think there’s any trash lyin’ around? I wanna <$cdef(27)><$spwfull(17)> </color>it!
msgctxt "1986:58"
msgid "<$comeff(1,3)><$facial(1,1)><$motion(1,805)><$voicel(1,6)>Oyeee, ¿no habrás encontrado basura tirada por ahí?<br>Pues tú tráemela toda, ¡¡que yo la puedo <$cdef(27)><$spwfull(17)></color>!!"
msgstr ""

#. en: <$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,7)>My Pokémon-searching skills are pretty sweet! Just say the<br>word and I’ll lead you right to ’em!
msgctxt "1986:60"
msgid "<$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,7)>Oyeee, yo te puedo ayudar a buscar Pokémon. Te llevo<br>en un pispás adonde quieras, crack. ¡Tú mandas!"
msgstr "<$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,7)>Oyeee, yo te puedo ayudar a buscar Pokémon. Te llevo<br>en un dos por tres adonde quieras, crack. ¡Tú mandas!"

#. en: <$emotion(1,8)><$voicel(1,7)>HECK YEAH! Mornin’, <$cdef(27)><pname;0></color>!
msgctxt "1986:101"
msgid "<$cdef(27)><$emotion(1,8)></color><$voicel(1,7)>¡Eeey, buenos días, máquina!"
msgstr "<$cdef(27)><$emotion(1,8)></color><$voicel(1,7)>¡Eeey, buenos días, genio!"

#. en: <$emotion(1,29)><$voicel(1,9)>Good mooorning! Whatcha got planned for today?
msgctxt "1986:102"
msgid "<$emotion(1,29)><$voicel(1,9)>¡Buenos díaaaaaas! ¿Hoy qué vas a hacer?"
msgstr ""

#. en: <$emotion(1,37)><$voicel(1,7)>Heyooo! Got anything fun going on?
msgctxt "1986:103"
msgid "<$emotion(1,37)><$voicel(1,7)>¿Qué pasa, leyenda? ¿Has visto algo emocionante?"
msgstr "<$emotion(1,37)><$voicel(1,7)>¿Qué tal, leyenda? ¿Viste algo emocionante?"

#. en: <$emotion(1,38)><$voicel(1,9)>HECK YEAH! I don’t even know what to DO with all<br>this energy!
msgctxt "1986:104"
msgid "<$emotion(1,38)><$voicel(1,9)>¡Aaah, no sé qué hacer con tanta energía!"
msgstr ""

#. en: <$emotion(1,60)><$voicel(1,7)>Dang, the sun is already calling it quits. It’s like<br>WHOOSH—you blink once and the whole day is over!
msgctxt "1986:105"
msgid "<$emotion(1,60)><$voicel(1,7)>Ya es la puesta de sol... Se me ha pasao el día en un tris."
msgstr "<$emotion(1,60)><$voicel(1,7)>Ya es la puesta de sol... Se me pasó el día volando."

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Hmm, ’bout time to eat dinner, y’think?
msgctxt "1986:106"
msgid "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Hmm, no sé si cenar ya o esperar un poco."
msgstr ""

#. en: <oneline><$emotion(1,14)><$voicel(1,5)><$cdef(27)><pname;0></color>! Evenin’! Day’s almost over!<br>Can<slide><br>you<slide><br>believe it?
msgctxt "1986:107"
msgid "<oneline><$emotion(1,14)><$voicel(1,5)>¡Hola, <$cdef(27)><pname;0></color>! Ya enseguida se acaba<br>el día."
msgstr ""

#. en: <$emotion(1,8)><$voicel(1,9)>I 100 percent LOVE the night sky. Them stars really do<br>shine bright!
msgctxt "1986:108"
msgid "<$emotion(1,8)><$voicel(1,9)>¡Me chiflan los cielos estrellados! ¡Hay taaantas estrellas<br>brillantes!"
msgstr "<$emotion(1,8)><$voicel(1,9)>¡Me encantan los cielos estrellados! ¡Hay taaantas estrellas<br>brillantes!"

#. en: <$emotion(1,8)><$voicel(1,9)>HECK YEAH! Getting to meet up with you means that<br>today is my lucky day, <$cdef(27)><pname;0></color>!
msgctxt "1986:109"
msgid "<$cdef(27)><$emotion(1,8)></color><$voicel(1,9)>¡Vamooos! ¡Qué suerte haberme encontrado hoy contigo!"
msgstr ""

#. en: <$emotion(1,14)><$voicel(1,7)>Whoa! Your timing is PER-FECT! I was literally JUST<br>thinking about heading over to see ya!
msgctxt "1986:110"
msgid "<$emotion(1,14)><$voicel(1,7)>¡No puede ser! ¡Justo ahora iba a ir a buscarte!"
msgstr ""

#. en: <$emotion(1,8)><$voicel(1,7)>Mmm-hmm, today totally has that “somethin’ good is<br>gonna happen” vibe! ♪
msgctxt "1986:111"
msgid "<$emotion(1,8)><$voicel(1,7)>♪¡Me da que hoy van a ocurrir cosas buenas!♪"
msgstr "<$emotion(1,8)><$voicel(1,7)>♪¡Presiento que hoy van a ocurrir cosas buenas!♪"

#. en: <$emotion(1,29)><$voicel(1,7)>Hmm, I think my “someone needs my help” sense is<br>tingling! <$emotion(1,8)><$voicel(1,10)>If I’m right, you got it, bud! Whatever you<slide><br>need, I’m there!
msgctxt "1986:112"
msgid "<$emotion(1,29)><$voicel(1,7)>¿Qué pasa, figura? ¿Necesitas ayuda con algún tema?<clear><br><$emotion(1,8)><$voicel(1,10)>¡Tú pide por esa boca, ¿eh?! ¡Hay confianza!"
msgstr "<$emotion(1,29)><$voicel(1,7)>¿Qué tal, crack? ¿Necesitas ayuda con algún tema?<clear><br><$emotion(1,8)><$voicel(1,10)>¡Tú pide lo que quieras, ¿eh?! ¡Hay confianza!"

#. en: <oneline><$emotion(1,37)><$voicel(1,9)>Whoa—you look busy, <$cdef(27)><pname;0></color>! You<br>gotta<slide><br>take<slide><br>it<slide><br>easy<slide><br>now<slide><br>and then!
msgctxt "1986:113"
msgid "<$cdef(27)><$emotion(1,37)></color><$voicel(1,9)>¡A ver si bajas la marcha un poco! Siempre estás como<br>superocupad<gen;-2(o,a)>."
msgstr ""

#. en: <oneline><$emotion(1,38)><$voicel(1,9)><$cdef(27)><pname;0></color>! Your style is like, straight-up<br>super COOL!
msgctxt "1986:114"
msgid "<$cdef(27)><$emotion(1,38)></color><$voicel(1,9)>¡Me encantan tus pintas, crack! Qué estilazo tienes."
msgstr "<$cdef(27)><$emotion(1,38)></color><$voicel(1,9)>¡Me encanta cómo te ves, crack! Qué estilazo tienes."

#. en: <$emotion(1,60)><$voicel(1,9)>You know I got energy to spare, so lemme share some with<br>you, <$cdef(27)><pname;1></color>! <$pkcry;2(1,2)>!
msgctxt "1986:115"
msgid "<$cdef(27)><$emotion(1,60)></color><$voicel(1,9)>¡Tengo demasiada energía, así que quiero compartirla<br>contigo! ¡<$pkcry;2(1,2)>!"
msgstr ""

#. en: <oneline><$emotion(1,8)><$voicel(1,9)>There’s so, SO much we gotta do<br>together, <$cdef(27)><pname;0></color>!
msgctxt "1986:116"
msgid "<$cdef(27)><$emotion(1,8)></color><$voicel(1,9)>¡Hay taaantas cosas que quiero hacer contigo!"
msgstr ""

#. en: <$emotion(1,38)><$voicel(1,9)>What should I get up to today? There’s just way too much<br>I wanna do!
msgctxt "1986:117"
msgid "<$emotion(1,38)><$voicel(1,9)>¿Y hoy qué hago? ¡Hay taaantas posibilidades!"
msgstr ""

#. en: <$emotion(1,64)><$voicel(1,7)>The humans left like, a TON of stuff around. Doesn’t it<br>make you curious?
msgctxt "1986:118"
msgid "<$emotion(1,64)><$voicel(1,7)>Los humanos dejaron un porrón de cosas atrás...<br>¿Cómo te quedas?"
msgstr "<$emotion(1,64)><$voicel(1,7)>Los humanos dejaron un montón de cosas atrás...<br>¿Puedes creerlo?"

#. en: <$emotion(1,1)><$voicel(1,7)>Look—whenever you’re feeling down in the dumps, you<br>KNOW you can always count on me!
msgctxt "1986:119"
msgid "<$emotion(1,1)><$voicel(1,7)>¡Si estás algo alicaíd<gen;-2(o,a)>, cuenta conmigo cuando quieras!"
msgstr ""

#. en: <oneline><$emotion(1,38)><$voicel(1,9)><$cdef(27)><pname;1></color>! Let’s hang out together a LOT,<br>OK?<slide><br>I<slide><br>can’t wait!
msgctxt "1986:120"
msgid "<$cdef(27)><$emotion(1,38)></color><$voicel(1,9)>¡Yo lo que quiero es divertirme contigo, monstru<gen;-2(o,a)>!"
msgstr "<$cdef(27)><$emotion(1,38)></color><$voicel(1,9)>¡Yo lo que quiero es divertirme contigo, amig<gen;-2(o,a)>!"

#. en: <$comeff(1,16)><$facial(1,14)><$voicel(1,3)>Zzz... Whoa! <$facial(1,1)>Was I seriously just snoozing?
msgctxt "1986:121"
msgid "<$comeff(1,16)><$facial(1,14)><$voicel(1,3)>Zzz... Qué sueñooo... <wait(0.9)><$facial(1,1)>Uy, ¿estaba durmiendo?"
msgstr ""

#. en: <oneline><$comeff(1,16)><$facial(1,14)><$voicel(1,3)>Zzz...<$facial(1,1)> Wha—? <$cdef(27)><pname;0></color>? I woke up from<br>my<slide><br>dream,<slide><br>but<slide><br>you’re<slide><br>still here?
msgctxt "1986:122"
msgid "<$cdef(27)><$comeff(1,16)></color><$facial(1,14)><$voicel(1,3)>Zzz... <wait(0.9)><$facial(1,1)>¿Uy? ¿Me despierto de un sueño y sigues aquí?"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,8)>Living around here looks so FUN! <$pkcry;0(1,2)>! ♪
msgctxt "1986:123"
msgid "<$voicel(1,7)><$emotion(1,8)>¡Qué bien me lo voy a pasar viviendo aquí, figura!<br>♪¡<$pkcry;0(1,2)>!♪"
msgstr "<$voicel(1,7)><$emotion(1,8)>¡Qué bien me la voy a pasar viviendo aquí, crack!<br>♪¡<$pkcry;0(1,2)>!♪"

#. en: <$voicel(1,7)><$emotion(1,14)><$facial(1,4)>I REALLY wanna get out and explore more of this place,<br>y’know?
msgctxt "1986:124"
msgid "<$voicel(1,7)><$emotion(1,14)><$facial(1,4)>¡Qué ganas de ir a investigar la zona! Jaaa, ja, ja."
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,49)>Hey, you totally know all about this place, right?<br>You gotta show me the ropes!
msgctxt "1986:125"
msgid "<$voicel(1,7)><$emotion(1,49)>Oye, máquina, tú te conocerás bien la zona, ¿no?<br>¿Hay algo guapo por aquí cerca?"
msgstr "<$voicel(1,7)><$emotion(1,49)>Oye, crack, tú te conocerás bien la zona, ¿no?<br>¿Hay algo genial por aquí cerca?"

#. en: <$voicel(1,7)><$comeff(1,3)><$motion(1,806)><$facial(1,4)>I wonder what sorta thing this is gonna become.<br>I’m lookin’ forward to it!
msgctxt "1986:126"
msgid "<$voicel(1,7)><$comeff(1,3)><$motion(1,806)><$facial(1,4)>¿Qué estáis montando? ¡Qué ganas de ver el resultado!"
msgstr "<$voicel(1,7)><$comeff(1,3)><$motion(1,806)><$facial(1,4)>¿Qué están armando? ¡Qué ganas de ver el resultado!"

#. en: <$emotion(1,37)><$voicel(1,9)>Time to <$cdef(27)><$spwfull(1)> </color>it to the max! I’m gonna make this<br>the best thing ever!
msgctxt "1986:127"
msgid "<$emotion(1,37)><$voicel(1,9)>¡Ya verás, leyenda! ¡Voy a <$cdef(27)><$spwfull(1)></color> algo guapísimo!"
msgstr "<$emotion(1,37)><$voicel(1,9)>¡Ya verás, leyenda! ¡Voy a <$cdef(27)><$spwfull(1)></color> algo increíble!"

#. en: <$voicel(1,7)><$emotion(1,8)>This place is totally jam-packed with Pokémon! Every<br>single day here is wild!
msgctxt "1986:128"
msgid "<$voicel(1,7)><$emotion(1,8)>¡Cuánta gente, qué guapo! ¡Lo vamos a pasar genial todos<br>los días!"
msgstr "<$voicel(1,7)><$emotion(1,8)>¡Cuánta gente, qué bien! ¡La vamos a pasar genial todos<br>los días!"

#. en: <$voicel(1,3)><$emotion(1,13)>I wanna make my place just a LITTLE easier to live in,<br>you feel me?
msgctxt "1986:129"
msgid "<$voicel(1,3)><$emotion(1,13)>¡Me gustaría añadirle un algo a mi casa!"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,8)>OK! My place is really starting to get a nice vibe<br>going on now!
msgctxt "1986:130"
msgid "<$voicel(1,7)><$emotion(1,8)>¡Mi casa está quedando superguay, la verdad!"
msgstr "<$voicel(1,7)><$emotion(1,8)>¡Mi casa está quedando increíble, la verdad!"

#. en: <$voicel(1,9)><$emotion(1,7)>I love love LOVE my place now! You’re the absolute<br>best, <$cdef(27)><pname;1></color>!
msgctxt "1986:131"
msgid "<$cdef(27)><$voicel(1,9)></color><$emotion(1,7)>¡Qué guapa me has dejado la casa! ¡Menud<gen;-2(o,a)> máquina!"
msgstr "<$cdef(27)><$voicel(1,9)></color><$emotion(1,7)>¡Qué bonita me dejaste la casa! ¡Qué talentos<gen;-2(o,a)>!"

#. en: <$voicel(1,9)><$emotion(1,9)><$facial(1,4)>Hey, <$cdef(27)><pname;0></color>! Let’s hang out today too!
msgctxt "1986:132"
msgid "<oneline><$voicel(1,9)><$emotion(1,9)><$facial(1,4)>¡Ah, <$cdef(27)><pname;0></color>! ¿Qué te ape que<br>hagamos hoy?"
msgstr "<oneline><$voicel(1,9)><$emotion(1,9)><$facial(1,4)>¡Ah, <$cdef(27)><pname;0></color>! ¿Qué quieres que<br>hagamos hoy?"

#. en: <$cdef(27)><$voicel(1,9)><$emotion(1,1)><pname;0></color>! I missed you so bad, buddy!
msgctxt "1986:133"
msgid "<$voicel(1,9)><$emotion(1,1)>¡<$cdef(27)><pname;0></color>! ¡Tenía mazo de ganas de verte!"
msgstr "<$voicel(1,9)><$emotion(1,1)>¡<$cdef(27)><pname;0></color>! ¡Tenía muchísimas ganas de verte!"

#. en: <$voicel(1,7)><$emotion(1,8)>It’s super fun to visit new places! You gotta take me along<br>next time too!
msgctxt "1986:134"
msgid "<$voicel(1,7)><$emotion(1,8)>¡Me encanta conocer sitios nuevos! ¡Habrá que repetir!"
msgstr "<$voicel(1,7)><$emotion(1,8)>¡Me encanta conocer lugares nuevos! ¡Habrá que repetir!"

#. en: <oneline><$voicel(1,7)><$emotion(1,49)><$cdef(27)><pname;0></color>! Welcome back! You find<br>anything<slide><br>good<slide><br>out there?
msgctxt "1986:135"
msgid "<$cdef(27)><$voicel(1,7)><$emotion(1,49)></color>¿Qué pasa, fiera? ¿Has encontrado algo guapo por ahí?"
msgstr "<$cdef(27)><$voicel(1,7)><$emotion(1,49)></color>¿Qué tal, crack? ¿Encontraste algo genial por ahí?"

#. en: <oneline><$voicel(1,5)><$emotion(1,14)><$cdef(27)><pname;0></color>! Were you off having fun<br>somewhere<slide><br>far<slide><br>away?<slide><br>That<slide><br>is<slide><br>sooo cool!
msgctxt "1986:136"
msgid "<$cdef(27)><$voicel(1,5)><$emotion(1,14)></color>¿Dónde te habías metido, crack? ¡Qué envidia!"
msgstr ""

#. en: <$emotion(1,1)><$voicel(1,7)>I’ll toss some really good stuff in the <$cdef(27)><fqty(1)><$ifull(1460)><br></color>every now and then! Give it a look!
msgctxt "1986:137"
msgid "<$emotion(1,1)><$voicel(1,7)>Iré metiendo cosas chulas en alguna <$cdef(27)><fqty(1)><$ifull(1460)></color><br>de tanto en tanto, ¿vale?"
msgstr "<$emotion(1,1)><$voicel(1,7)>Iré metiendo cosas buenas en alguna <$cdef(27)><fqty(1)><$ifull(1460)></color><br>de tanto en tanto, ¿sí?"

#. en: <$emotion(1,37)><$voicel(1,7)>Leave your <$cdef(27)><$spwfull(1)>ing</color> to me! ’Cause anything I’d make<br>would come out PERFECT!
msgctxt "1986:138"
msgid "<$emotion(1,37)><$voicel(1,7)>¡Si necesitas <$cdef(27)><$spwfull(1)></color> algo, déjalo en mis manos, fiera!<br>¡Te monto cualquier cosa en na!"
msgstr "<$emotion(1,37)><$voicel(1,7)>¡Si necesitas <$cdef(27)><$spwfull(1)></color> algo, déjalo en mis manos, crack!<br>¡Te armo cualquier cosa en un santiamén!"

#. en: <$emotion(1,60)><$voicel(1,7)>You’d never guess just by looking at me, but I can actually<br>spout fire!<clear><br>...Wait, you COULD tell just by looking?
msgctxt "1986:139"
msgid "<$emotion(1,60)><$voicel(1,7)>Puede que no lo aparente, pero puedo crear fuego.<clear><br>¿Ein? ¿Cómo que se ve a la legua?"
msgstr "<$emotion(1,60)><$voicel(1,7)>Puede que no lo aparente, pero puedo crear fuego.<clear><br>¿Eh? ¿Cómo que se ve a la legua?"

#. en: <$emotion(1,14)><$voicel(1,7)>Call me up any time you need some water! Seriously,<br>WATER you waiting for?
msgctxt "1986:140"
msgid "<$emotion(1,14)><$voicel(1,7)>¡Si necesitas agua, pídemela a mí! ¡No seas aguafiestas!"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,38)>Isn’t my electricity AMAZING?! Just one little shock can<br>get any machine buzzing!
msgctxt "1986:141"
msgid "<$voicel(1,7)><$emotion(1,38)>Igual está feo que lo diga yo, pero tengo una potencia<br>eléctrica de envidia.<clear><br>Con un chasquido pongo en marcha cualquier máquina."
msgstr "<$voicel(1,7)><$emotion(1,38)>Quizás está feo que lo diga yo, pero tengo una potencia<br>eléctrica de envidia.<clear><br>Con un chasquido pongo en marcha cualquier máquina."

#. en: <$comeff(1,21)><$facial(1,1)><$motion(1,805)><$voicel(1,8)>Whenever I see veggies and flowers and stuff, I just start<br>cheering ’em on, like, “You got this! Grow! GROW!”
msgctxt "1986:142"
msgid "<$comeff(1,21)><$facial(1,1)><$motion(1,805)><$voicel(1,8)>Cuando veo flores o cultivos, me sale del alma gritarles<br>\"¡Vamos, creceeed!\" para animarlos."
msgstr "<$comeff(1,21)><$facial(1,1)><$motion(1,805)><$voicel(1,8)>Cuando veo flores o cultivos, me sale del alma gritarles<br>\"¡Vamos, crezcaaan!\" para animarlos."

#. en: <oneline><$emotion(1,29)><$voicel(1,7)><$cdef(27)><pname;0></color>! You want some<br><$cdef(27)><fqty(2)><class><pdcitem;1></color>?<slide><br><$emotion(1,8)><$voicel(1,9)>I’ll<slide><br>collect<slide><br>some<slide><br>for<slide><br>ya, bestie!
msgctxt "1986:143"
msgid "<oneline><$emotion(1,29)><$voicel(1,7)>¡Qué hayyy, <$cdef(27)><pname;0></color>!<br>¿Quieres <$cdef(27)><fqty(2)><class><pdcitem;1></color>?<slide><br><$emotion(1,8)><$voicel(1,9)>¡Yo suelo tener,<slide><br>y no me importa compartir!"
msgstr "<oneline><$emotion(1,29)><$voicel(1,7)>¡Holaaa, <$cdef(27)><pname;0></color>!<br>¿Quieres <$cdef(27)><fqty(2)><class><pdcitem;1></color>?<slide><br><$emotion(1,8)><$voicel(1,9)>¡Yo suelo tener,<slide><br>y no me importa compartir!"

#. en: <$comeff(1,3)><$facial(1,1)><$motion(1,805)><$voicel(1,6)>Whenever I’m walking around, I always keep an eye out for<br>awesome stuff on the ground! <$comeff(1,9)><$facial(1,4)><$motion(1,661)><$voicel(1,7)>If I find something cool, you<slide><br>can <$cdef(27)><$spwfull(12)> </color>me for it!
msgctxt "1986:144"
msgid "<$comeff(1,3)><$facial(1,1)><$motion(1,805)><$voicel(1,6)>Cuando salgo a dar una vuelta, aprovecho para buscar<br>cosas que molen tiradas por ahí.<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,661)><$voicel(1,7)>La próxima vez que encuentre algo, puedes <$cdef(27)><$spwfull(12)><br></color>conmigo, figura. ¡Igual me convences para que te lo dé!"
msgstr "<$comeff(1,3)><$facial(1,1)><$motion(1,805)><$voicel(1,6)>Cuando salgo a dar una vuelta, aprovecho para buscar<br>cosas geniales tiradas por ahí.<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,661)><$voicel(1,7)>La próxima vez que encuentre algo, puedes <$cdef(27)><$spwfull(12)><br></color>conmigo, crack. ¡Tal vez me convences para que te lo dé!"

#. en: <$emotion(1,38)><$voicel(1,9)>I dance! I sing! You need hype? I got just the thing! ♪<br><$comeff(1,9)><$voicel(1,9)>You know who to call when it’s party time!
msgctxt "1986:146"
msgid "<$emotion(1,38)><$voicel(1,9)>¡Cantando y bailando nadie me supera, fiera!<clear><br><$comeff(1,9)><$voicel(1,9)>¡Si quieres un fiestón, ya sabes a quién llamar!"
msgstr "<$emotion(1,38)><$voicel(1,9)>¡Cantando y bailando nadie me supera, crack!<clear><br><$comeff(1,9)><$voicel(1,9)>¡Si quieres un fiestón, ya sabes a quién llamar!"

#. en: <oneline><$comeff(1,14)><$motion(1,805)><$voicel(1,5)>So this is <$cdef(27)><wndhmownerpk;0></color>’s home, huh?<br><$emotion(1,1)><$voicel(1,8)>Ahaha!<slide><br>Yup,<slide><br>looks<slide><br>just<slide><br>like ’em!
msgctxt "1986:148"
msgid "<oneline><$comeff(1,14)><$motion(1,805)><$voicel(1,5)>Así que aquí vive <dart;0()><$cdef(27)><wndhmownerpk;0></color>,<br>¿eeeh?<slide><br><$emotion(1,1)><$voicel(1,8)>¡Le pega mogollón, la verdad!"
msgstr "<oneline><$comeff(1,14)><$motion(1,805)><$voicel(1,5)>Así que aquí vive <dart;0()><$cdef(27)><wndhmownerpk;0></color>,<br>¿eeeh?<slide><br><$emotion(1,1)><$voicel(1,8)>¡Le queda perfecto, la verdad!"

#. en: <oneline><$voicel(1,9)><$emotion(1,8)><$cdef(27)><pname;0></color>! Heyooo! Did you suddenly feel<br>drawn<slide><br>to<slide><br>this<slide><br>place,<slide><br>too?<slide><br><$voicel(1,8)><$emotion(1,49)>Ahaha, twinsies!
msgctxt "1986:149"
msgid "<oneline><$voicel(1,9)><$emotion(1,8)>Ey, ¿qué pasaaa, <$cdef(27)><pname;0></color>? ¿Te ha<br>llamado<slide><br>la atención<slide><br>este sitio<slide><br>y has venido a curiosear?<clear><br><$voicel(1,8)><$emotion(1,49)>¡Pues ya somos dos!"
msgstr "<oneline><$voicel(1,9)><$emotion(1,8)>Ey, ¿qué taaal, <$cdef(27)><pname;0></color>? ¿Te<br>llamó<slide><br>la atención<slide><br>este lugar<slide><br>y viniste a curiosear?<clear><br><$voicel(1,8)><$emotion(1,49)>¡Pues ya somos dos!"

#. en: <$emotion(1,62)><$voicel(1,9)>This is SOOO fun! I could seriously play with <qty;0(this,these)><br><$cdef(27)><fqty(1)><class><usingp;0> </color>ALL DAY!
msgctxt "1986:150"
msgid "<oneline><$emotion(1,62)><$voicel(1,9)>¡Qué guap<genqty;0(o,a,os,as)><br><dart;0()><$cdef(27)><fqty(1)><class><usingp;0></color>!<slide><br>¡Podría quedarme<slide><br>aquí jugando la vida!"
msgstr "<oneline><$emotion(1,62)><$voicel(1,9)>¡Qué bonit<genqty;0(o,a,os,as)><br><dart;0()><$cdef(27)><fqty(1)><class><usingp;0></color>!<slide><br>¡Podría quedarme<slide><br>aquí jugando la vida!"

#. en: <$emotion(1,64)><$voicel(1,9)>Huh? What is this thing? No, really, what IS it?
msgctxt "1986:151"
msgid "<$emotion(1,64)><$voicel(1,9)>¿Eeeh? ¿Y esto qué es? Dímelo, anda."
msgstr "<$emotion(1,64)><$voicel(1,9)>¿Eeeh? ¿Y esto qué es? Dímelo, porfa."

#. en: <oneline><$emotion(1,38)><$voicel(1,9)>This <$cdef(27)><fqty(1)><class><usingp;0> </color>is SO<br>CUTE.<slide><br>Cuteness<slide><br>overload!<slide><br>Heck yeah!
msgctxt "1986:152"
msgid "<oneline><$emotion(1,38)><$voicel(1,9)>¡Eyyy! ¡Qué monada de<br><$cdef(27)><fqty(1)><class><usingp;0></color>!"
msgstr "<oneline><$emotion(1,38)><$voicel(1,9)>¡Eyyy! ¡Qué lindura de<br><$cdef(27)><fqty(1)><class><usingp;0></color>!"

#. en: <oneline><$emotion(1,55)><$voicel(1,7)>I CANNOT take my eyes off of this<br><$cdef(27)><fqty(1)><class><usingp;0></color>!
msgctxt "1986:153"
msgid "<oneline><$emotion(1,55)><$voicel(1,7)>¡No sé qué me pasa, pero no puedo dejar de mirar est<genqty;0(e,a,os,as)><br><$cdef(27)><fqty(1)><class><usingp;0></color>!"
msgstr ""

#. en: <oneline><$emotion(1,63)><$voicel(1,9)>Heck yeah! This<br><$cdef(27)><fqty(1)><class><usingp;0></color><slide><br>is<slide><br>totally<slide><br>my jam!
msgctxt "1986:155"
msgid "<oneline><$emotion(1,63)><$voicel(1,9)>¡Qué guap<genqty;0(o,a,os,as)> est<genqty;0(e,a,os,as)><br><$cdef(27)><fqty(1)><class><usingp;0></color>!<slide><br>¡<qty;0(Es,Son)> de mi estilo, total!"
msgstr "<oneline><$emotion(1,63)><$voicel(1,9)>¡Qué bonit<genqty;0(o,a,os,as)> est<genqty;0(e,a,os,as)><br><$cdef(27)><fqty(1)><class><usingp;0></color>!<slide><br>¡<qty;0(Es,Son)> muy de mi estilo!"

#. en: <$emotion(1,14)><$voicel(1,9)>Wha—? Do you think this is supposed to be ME? That<br>would totally make my day!
msgctxt "1986:156"
msgid "<$emotion(1,14)><$voicel(1,9)>¿Cómooorr? ¿Soy yo o qué? ¡Qué ilusióoon!"
msgstr "<$emotion(1,14)><$voicel(1,9)>¿Cómooo? ¿Soy yo o qué? ¡Qué emocióoon!"

#. en: <oneline><$emotion(1,62)><$voicel(1,9)>Uh-oh! <qty;0(This,These)> <$cdef(27)><fqty(1)><noweating;0> </color><qty;0(is,are)><br>WAY<slide><br>too tasty!
msgctxt "1986:157"
msgid "<$emotion(1,62)><$voicel(1,9)>¿Pero cómo puede estar esto tan ricooo? ¡Nunca diré que<br>no a <iart;0()><$cdef(27)><fqty(1)><class><noweating;0></color>!"
msgstr ""

#. en: <oneline><$comeff(1,7)><$facial(1,9)><$motion(1,802)><$voicel(1,3)>Hmm, y’know, I’m not sure <qty;0(this,these)><br><$cdef(27)><fqty(1)><class><noweating;0></color><slide><br><qty;0(is,are)><slide><br>really<slide><br>my thing...
msgctxt "1986:158"
msgid "<oneline><$comeff(1,7)><$facial(1,9)><$motion(1,802)><$voicel(1,3)>¿<fcap><iart;0()><$cdef(27)><fqty(1)><class><noweating;0></color>? A ver...<br>No sé,<slide><br>prefiero<slide><br>otras<slide><br>cosas..."
msgstr ""

#. en: <$emotion(1,37)><$voicel(1,9)>That’s the <$cdef(27)><pname;0> </color>I know! Wahoo!
msgctxt "1986:159"
msgid "<$cdef(27)><$emotion(1,37)></color><$voicel(1,9)>¡Si es que eres u<gen;-2(n,na)> máquina, leyenda!"
msgstr "<$cdef(27)><$emotion(1,37)></color><$voicel(1,9)>¡Eres u<gen;-2(n,na)> crack, leyenda!"

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,9)><$voicel(1,9)><$cdef(27)><blsspwkpk;0> </color>is AWESOME! I gotta pull my weight too!
msgctxt "1986:160"
msgid "<oneline><$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,9)><$voicel(1,9)>¡Alucino con <dart;0()><$cdef(27)><blsspwkpk;0></color>! ¡Yo también tendré<br>que ponerme<slide><br>las pilas!"
msgstr ""

#. en: <$comeff(1,4)><$motion(1,803)><$voicel(1,7)>If I keep on running like this, my stomach is gonna be<br>running on empty!
msgctxt "1986:161"
msgid "<$comeff(1,4)><$motion(1,803)><$voicel(1,7)>Buf, si sigo yendo de aquí para allá, me va a entrar<br>un hambre..."
msgstr ""

#. en: <$emotion(1,8)><$voicel(1,8)><$cdef(27)><nnowpairpk;0></color> is such a riot! ♪
msgctxt "1986:162"
msgid "<$emotion(1,8)><$voicel(1,8)>¡Me parto con <dart;0()><$cdef(27)><nnowpairpk;0></color>!"
msgstr "<$emotion(1,8)><$voicel(1,8)>¡Me río mucho con <dart;0()><$cdef(27)><nnowpairpk;0></color>!"

#. en: <$comeff(1,16)><$facial(1,14)><$motion(1,807)><$voicel(1,3)>It’s already totally dark out. I just wanna crash...
msgctxt "1986:163"
msgid "<$comeff(1,16)><$facial(1,14)><$motion(1,807)><$voicel(1,3)>Pues ya se ha hecho de noche... ¡Qué oscuro está todo!<br>La verdad es que me caigo de sueño..."
msgstr "<$comeff(1,16)><$facial(1,14)><$motion(1,807)><$voicel(1,3)>Pues ya se hizo de noche... ¡Qué oscuro está todo!<br>La verdad es que me caigo de sueño..."

#. en: <$comeff(1,16)><$motion(1,807)><$voicel(1,3)>Phew, we really got stuff done today! I’m gonna sleep like<br>a log! *yawn*
msgctxt "1986:164"
msgid "<$comeff(1,16)><$motion(1,807)><$voicel(1,3)>Hoy también ha sido un buen día... Voy a dormir como<br>un tronco..."
msgstr "<$comeff(1,16)><$motion(1,807)><$voicel(1,3)>Hoy también fue un buen día... Voy a dormir como<br>un tronco..."

#. en: <oneline><$comeff(1,3)><$facial(1,1)><$motion(1,666)><$voicel(1,5)><$cdef(27)><pname;0></color>! Good mooorning! I was just<br>about<slide><br>to<slide><br>head<slide><br>to<slide><br>sleep,<slide><br>actually!
msgctxt "1986:165"
msgid "<oneline><$comeff(1,3)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>¡Buenaaas, <$cdef(27)><pname;0></color>! Me pillas<br>a puntito<slide><br>de irme<slide><br>a dormiiir."
msgstr "<oneline><$comeff(1,3)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>¡Buenaaas, <$cdef(27)><pname;0></color>! Me agarras<br>a puntito<slide><br>de irme<slide><br>a dormiiir."

#. en: <$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Today sure was fun, huh? I bet I’m gonna sleep like a log!<br><$pkcry;0(1,2)>! ♪
msgctxt "1986:166"
msgid "<$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Buah, hoy ha sido una pasada. Fijo que voy a tener<br>unos sueños guapísimos. ♪¡<$pkcry;0(1,2)>!♪"
msgstr "<$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Guau, hoy fue increíble. Seguro que voy a tener<br>unos sueños geniales. ♪¡<$pkcry;0(1,2)>!♪"

#. en: <$emotion(1,37)><$voicel(1,9)>I do a TON of singing whenever I’m soarin’ through the<br>sky—’cause nobody can actually HEAR me up there!
msgctxt "1986:167"
msgid "<$emotion(1,37)><$voicel(1,9)>¡Me gusta cantar cuando vuelo! ¡Así no me oye nadie!"
msgstr ""

#. en: <$emotion(1,8)><$voicel(1,9)>When sunlight hits my body, I get SUPER sparkly and<br>shiny, y’know! <$emotion(1,37)><$voicel(1,8)>Oh—only on sunny days, though!
msgctxt "1986:168"
msgid "<$emotion(1,8)><$voicel(1,9)>¡No veas qué flipada cómo brilla mi cuerpo cuando le dan<br>los rayos del sol!<clear><br><$emotion(1,37)><$voicel(1,8)>Solo en los días despejados, ¡pero menos da una piedra!"
msgstr "<$emotion(1,8)><$voicel(1,9)>¡No te imaginas cómo brilla mi cuerpo cuando le dan<br>los rayos del sol!<clear><br><$emotion(1,37)><$voicel(1,8)>Solo en los días despejados, ¡pero algo es algo!"

#. en: <$comeff(1,6)><$motion(1,666)><$voicel(1,7)>Heh, I wonder how far my body could stretch if you<br>pulled on it...
msgctxt "1986:170"
msgid "<$comeff(1,6)><$motion(1,666)><$voicel(1,7)>Me pregunto cuánto se me podría estirar el cuerpo si<br>alguien tirara con fuerza..."
msgstr ""

#. en: <$comeff(1,5)><$facial(1,1)><$motion(1,806)><$voicel(1,10)><$pkcry;0(1,1)>!!!<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,661)><$voicel(1,7)>I may be small, but I’ve got TONS of energy!
msgctxt "1986:172"
msgid "<$comeff(1,5)><$facial(1,1)><$motion(1,806)><$voicel(1,10)>¡¡¡<$pkcry;0(1,1)>!!!<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,661)><$voicel(1,7)>Soy peque, ¡pero energía no me falta nuncaaa!"
msgstr ""

#. en: <$emotion(1,37)><$voicel(1,7)>The best thing about being huge? You can always see where<br>I’m at! You feel me?
msgctxt "1986:173"
msgid "<$emotion(1,37)><$voicel(1,7)>¡Con lo grande que soy, es fácil encontrarme! ¿A que sí?"
msgstr "<$emotion(1,37)><$voicel(1,7)>¡Con lo grande que soy, es fácil encontrarme! ¿Verdad que sí?"

#. en: <$emotion(1,38)><$voicel(1,9)><$pkcry;0(1,1)>! I’m fired up like usual today!
msgctxt "1986:174"
msgid "<oneline><$emotion(1,38)><$voicel(1,9)>¡<$pkcry;0(1,1)>! Hoy también estoy que ardo en ganas<br>de hacer<slide><br>cosas, máquina."
msgstr "<oneline><$emotion(1,38)><$voicel(1,9)>¡<$pkcry;0(1,1)>! Hoy también estoy que ardo en ganas<br>de hacer<slide><br>cosas, genio."

#. en: <$emotion(1,8)><$voicel(1,9)>Yup—this confirms it, living near water is AWESOME!<br>Safety! Deliciousness! Beauty! IT! IS! THE! BEST!
msgctxt "1986:175"
msgid "<$emotion(1,8)><$voicel(1,9)>¡Es guapísimo vivir cerca del agua! ¡Puedes usarla para<br>esconderte, beberla cuando quieras y es tan bonitaaa!"
msgstr "<$emotion(1,8)><$voicel(1,9)>¡Es genial vivir cerca del agua! ¡Puedes usarla para<br>esconderte, beberla cuando quieras y es tan bonitaaa!"

#. en: <$emotion(1,14)><$voicel(1,7)>Oh, you wanna know the secret to all my energy? Hehehe,<br>all right! <$emotion(1,8)><$voicel(1,10)>It’s some shiny rays from my buddy the sun,<slide><br>and some tasty water to go with it!
msgctxt "1986:176"
msgid "<$emotion(1,14)><$voicel(1,7)>¿Sabes cuál es la fuente de mi energía? ¿Quieres saberlo?<clear><br><$emotion(1,8)><$voicel(1,10)>Pues muy sencillo... ¡La luz del sol y algo de agua fresca!"
msgstr ""

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,807)><$voicel(1,9)>Let’s nuzzle cheeks to say hi to each other!<clear><br>...Wait, you’re gonna end up getting shocked, so we’d<br>better not!
msgctxt "1986:177"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,807)><$voicel(1,9)>¡Ven que te doy un achuchón! Bueno... o mejor no,<br>que igual te da un calambre."
msgstr "<$comeff(1,10)><$facial(1,4)><$motion(1,807)><$voicel(1,9)>¡Ven que te doy un abrazo! Bueno... o mejor no,<br>que a lo mejor te da un calambre."

#. en: <$comeff(1,14)><$voicel(1,7)>Did you know? I can peek into the fuuuture! I mean, kiiind<br>of! And when I read YOURS...<clear><br><$emotion(1,8)><$voicel(1,9)>I see... I see...YOU...chilling with your best bud? And<br>you’re both laughing your faces off! ♪
msgctxt "1986:178"
msgid "<$comeff(1,14)><$voicel(1,7)>A veces puedo ver el futuro. Déjame que te lea el tuyo...<clear><br><$emotion(1,8)><$voicel(1,9)>A veeer... ¡Veo que estás con alguien a quien aprecias<br>mucho, y que os partís de risa!"
msgstr "<$comeff(1,14)><$voicel(1,7)>A veces puedo ver el futuro. Déjame que te lea el tuyo...<clear><br><$emotion(1,8)><$voicel(1,9)>A veeer... ¡Veo que estás con alguien a quien aprecias<br>mucho, y que se mueren de risa!"

#. en: <$comeff(1,7)><$facial(1,9)><$motion(1,802)><$voicel(1,3)>Yup, this confirms it, I HATE hot places! And it’s really<br>saying something when someone like ME is feelin’ down.
msgctxt "1986:179"
msgid "<$comeff(1,7)><$facial(1,9)><$motion(1,802)><$voicel(1,3)>¡No me gustan nada los sitios calurosos! Para alguien frí<gen;-3(o,a)><br>como yo, es duro..."
msgstr "<$comeff(1,7)><$facial(1,9)><$motion(1,802)><$voicel(1,3)>¡No me gustan nada los lugares calurosos! Para alguien frí<gen;-3(o,a)><br>como yo, es duro..."

#. en: <$voicel(1,7)><$emotion(1,1)>Looks like there’s even more Pokémon living here now!<br>Oh man, think of all the fun we can have!
msgctxt "1986:181"
msgid "<$voicel(1,7)><$emotion(1,1)>¡Dicen que se han mudado aquí nuevos Pokémon!<br>¡Qué ganas de conocerlos!"
msgstr "<$voicel(1,7)><$emotion(1,1)>¡Dicen que se mudaron aquí nuevos Pokémon!<br>¡Qué ganas de conocerlos!"

#. en: <oneline><$voicel(1,7)><$emotion(1,1)>It’s<$cdef(27)> <pname;0></color>! I’m totes stoked to see<br>you again!
msgctxt "1986:182"
msgid "<$cdef(27)><$voicel(1,7)><$emotion(1,1)></color>¡Hola, leyendaaa! ¡Me alegro un montón de verte!"
msgstr ""

#. en: <oneline><$voicel(1,7)><$emotion(1,1)>Gooood morning,<$cdef(27)> <pname;0></color>! Today’s<br>weather<slide><br>is<slide><br>RIDICULOUSLY<slide><br>good, right?
msgctxt "1986:183"
msgid "<oneline><$voicel(1,7)><$emotion(1,1)>¡<$cdef(27)><pname;0></color>! ¡Buenos díaaas! ¡Qué tiempazo<br>hace hoy!"
msgstr "<oneline><$voicel(1,7)><$emotion(1,1)>¡<$cdef(27)><pname;0></color>! ¡Buenos díaaas! ¡Qué buen clima<br>hace hoy!"

#. en: <$voicel(1,7)><$emotion(1,60)>That sun sure is shining, right? I’m gonna go all out<br>playing today!
msgctxt "1986:184"
msgid "<$voicel(1,7)><$emotion(1,60)>¡Qué solazo! ¡Dan ganas de jugar a tope y pasarlo bien!<br>¿Qué me dices, máquina?"
msgstr "<$voicel(1,7)><$emotion(1,60)>¡Qué solazo! ¡Dan ganas de jugar con todo y pasarla bien!<br>¿Qué me dices, genio?"

#. en: <oneline><$voicel(1,7)><$facial(1,4)><$comeff(1,21)><$motion(1,803)><$cdef(27)><pname;0></color>! Evenin’, buddy! What a<br>FAN-TA-STIC<slide><br>night, right?
msgctxt "1986:185"
msgid "<$cdef(27)><$voicel(1,7)><$facial(1,4)><$comeff(1,21)><$motion(1,803)></color>¡Hola, figura! Hace una noche de escándalo, ¿no crees?"
msgstr "<$cdef(27)><$voicel(1,7)><$facial(1,4)><$comeff(1,21)><$motion(1,803)></color>¡Hola, crack! Hace una noche increíble, ¿no crees?"

#. en: <$emotion(1,62)><$voicel(1,9)>I love love LOVE rainy days! Hahaha, YEAH! Let it all<br>splash down!
msgctxt "1986:186"
msgid "<$emotion(1,62)><$voicel(1,9)>¡Me pirra la lluvia! ¡Vamooos, que llueva a mares!"
msgstr "<$emotion(1,62)><$voicel(1,9)>¡Me encanta la lluvia! ¡Vamooos, que llueva a mares!"

#. en: <$emotion(1,58)><$voicel(1,3)><$pkcry;0(1,3)>! I can’t STAND the rain!
msgctxt "1986:187"
msgid "<$emotion(1,58)><$voicel(1,3)>¡<$pkcry;0(1,3)>! ¡No me gusta nada de naaada la lluvia!"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,1)>Pfft, OK. Sure, the sky might be dark today, but you know<br>me! Nothin’ can stop this hype train!
msgctxt "1986:188"
msgid "<$voicel(1,7)><$emotion(1,1)>Hoy hace malo, pero no dejo que el clima me afecte.<br>¡Llueva, nieve o haga sol, yo siempre disfruto a tope!"
msgstr "<$voicel(1,7)><$emotion(1,1)>Hoy el clima está feo, pero no dejo que me afecte.<br>¡Llueva, nieve o haga sol, yo siempre la paso genial!"

#. en: <$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,7)><$cdef(27)>Professor Tangrowth</color> took some time to goof off with<br>me earlier!
msgctxt "1986:189"
msgid "<$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>¡El otro día el<$cdef(27)> Profesor Tangrowth</color> jugó conmigooo!<br>¡Lo pasamos tela de bien!"
msgstr "<$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>¡El otro día el<$cdef(27)> Profesor Tangrowth</color> jugó conmigooo!<br>¡La pasamos súper bien!"

#. en: <$voicel(1,8)><$comeff(1,10)><$motion(1,806)><$facial(1,4)>I always, ALWAYS give everything 100 percent!
msgctxt "1986:190"
msgid "<$voicel(1,8)><$comeff(1,10)><$motion(1,806)><$facial(1,4)>¡Yo siempre doy el 300<nbs4>%!"
msgstr ""

#. en: <$voicel(1,4)><$comeff(1,14)><$motion(1,805)>The more I wait, the hungrier I get! I WANNA EAT!
msgctxt "1986:191"
msgid "<$voicel(1,4)><$comeff(1,14)><$motion(1,805)>Esperar a que la comida esté lista hace que me entre<br>un hambre..."
msgstr ""

#. en: <$voicel(1,10)><$emotion(1,38)>Heyooo! Let’s GOOO!
msgctxt "1986:192"
msgid "<$voicel(1,10)><$emotion(1,38)>¡Venga, vamos! ¡A tope!"
msgstr "<$voicel(1,10)><$emotion(1,38)>¡Vamos, vamos! ¡Con todo!"

#. en: <oneline><$voicel(1,7)><$emotion(1,14)>So THAT’S how fast you can walk, eh<br><$cdef(27)><pname;0></color>?<slide><br>Hehehe, iiinteresting...
msgctxt "1986:193"
msgid "<$voicel(1,7)><$emotion(1,14)>Ya veo, ya veo... Así que este es tu ritmo para hacer las<br>cosas, ¿no, <$cdef(27)><pname;0></color>? ¡Menud<gen;-2(o,a)> crack!"
msgstr "<$voicel(1,7)><$emotion(1,14)>Ya veo, ya veo... Así que este es tu ritmo para hacer las<br>cosas, ¿no, <$cdef(27)><pname;0></color>? ¡Qué rápid<gen;-2(o,a)>!"

#. en: <oneline><$voicel(1,7)><$emotion(1,14)><$cdef(27)><pname;0></color>! You feeling chipper? ’Cause I’m<br>chipper<slide><br>enough<slide><br>for<slide><br>the<slide><br>both<slide><br>of us!
msgctxt "1986:194"
msgid "<oneline><$voicel(1,7)><$emotion(1,14)>Ey, <$cdef(27)><pname;0></color>, fiera, ¿cómo vas?<br>¡Yo hoy reboso energía!"
msgstr "<oneline><$voicel(1,7)><$emotion(1,14)>Ey, <$cdef(27)><pname;0></color>, crack, ¿cómo vas?<br>¡Yo hoy reboso energía!"

#. en: <$voicel(1,7)><$emotion(1,6)>Dang, I can’t believe I even get to hang out with you at<br>HOME too! Seriously, this is the LIFE!
msgctxt "1986:195"
msgid "<$voicel(1,7)><$emotion(1,6)>Buah, ¡con <$cdef(27)><pname;0></color> en la misma casa!<br>¿Se puede ser más feliz que yo ahora mismo?"
msgstr "<$voicel(1,7)><$emotion(1,6)>Guau, ¡con <$cdef(27)><pname;0></color> en la misma casa!<br>¿Se puede ser más feliz que yo ahora mismo?"

#. en: <$voicel(1,7)><$emotion(1,38)>Oh yeah! The other day I picked up these super pretty<br>feathers! <$voicel(1,5)><$emotion(1,14)>One was like, BLAZING hot! And the other was<slide><br>like, WHOOSH! Super windy!<clear><br>Why not go look for some, <$cdef(27)><pname;0></color>?
msgctxt "1986:196"
msgid "<$voicel(1,7)><$emotion(1,38)>Oh, ¡el otro día me encontré unas plumas guapísimas!<br><$voicel(1,5)><$emotion(1,14)>¡Una llameante y otra como con una corriente de aire!<clear><br>¡A lo mejor tú también puedes encontrar unas plumas<br>parecidas si te pones, <$cdef(27)><pname;0></color>!"
msgstr "<$voicel(1,7)><$emotion(1,38)>Oh, ¡el otro día me encontré unas plumas preciosas!<br><$voicel(1,5)><$emotion(1,14)>¡Una llameante y otra como con una corriente de aire!<clear><br>¡A lo mejor tú también puedes encontrar unas plumas<br>parecidas si te lo propones, <$cdef(27)><pname;0></color>!"

#. en: <oneline><$voicel(1,7)><$comeff(1,13)><$motion(1,801)><$facial(1,4)><$cdef(27)><pname;0></color>! Heyooo! You caught me<br>singing<slide><br>my<slide><br>favorite song! ♪
msgctxt "1986:197"
msgid "<$voicel(1,7)><$comeff(1,13)><$motion(1,801)><$facial(1,4)>¡Qué hayyy, <$cdef(27)><pname;0></color>!<br>♪Me pillas cantando una de mis canciones favoritas.♪"
msgstr "<$voicel(1,7)><$comeff(1,13)><$motion(1,801)><$facial(1,4)>¡Holaaa, <$cdef(27)><pname;0></color>!<br>♪Me agarras cantando una de mis canciones favoritas.♪"

#. en: <oneline><$voicel(1,9)><$emotion(1,38)><$cdef(27)><pname;0></color>! Heyooo! You also got a<br>high-intensity<slide><br>workout<slide><br>planned<slide><br>for<slide><br>today?
msgctxt "1986:198"
msgid "<$voicel(1,9)><$emotion(1,38)>¡Holaaa, <$cdef(27)><pname;0></color>, máquina! ¿Qué?<br>¿Ya has terminado de entrenar hoy?"
msgstr "<$voicel(1,9)><$emotion(1,38)>¡Holaaa, <$cdef(27)><pname;0></color>, genio! ¿Qué?<br>¿Ya terminaste de entrenar hoy?"

#. en: <oneline><$voicel(1,7)><$emotion(1,14)>Bring me <$cdef(27)><nquestinum;1></color><br><$cdef(27)><class><nquestitem;0></color>!
msgctxt "1986:201"
msgid "<oneline><$voicel(1,7)><$emotion(1,14)>¡Necesito <$cdef(27)><nquestinum;1></color><br><$cdef(27)><class><nquestitem;0></color>!<slide><br>¿Me <genqty;0(lo,la,los,las)> consigues?<slide><br>¡Va!"
msgstr "<oneline><$voicel(1,7)><$emotion(1,14)>¡Necesito <$cdef(27)><nquestinum;1></color><br><$cdef(27)><class><nquestitem;0></color>!<slide><br>¿Me <genqty;0(lo,la,los,las)> consigues?<slide><br>¡Porfa!"

#. en: <$voicel(1,7)><$emotion(1,38)>Yeah! Just what I wanted! Thanks!
msgctxt "1986:202"
msgid "<$voicel(1,7)><$emotion(1,38)>¡Toma yaaa! ¡Eres <gen;-2(un,una)> crack! Sabía que podía confiar en ti."
msgstr "<$voicel(1,7)><$emotion(1,38)>¡Así se haceee! ¡Eres <gen;-2(un,una)> crack! Sabía que podía confiar en ti."

#. en: <$voicel(1,6)><$comeff(1,14)><$motion(1,666)>Y’know, I’d be curious to see a place like THIS!
msgctxt "1986:203"
msgid "<$voicel(1,6)><$comeff(1,14)><$motion(1,666)>¡Tengo unas ganas locas de ver un sitio así!"
msgstr "<$voicel(1,6)><$comeff(1,14)><$motion(1,666)>¡Tengo unas ganas locas de ver un lugar así!"

#. en: <oneline><$voicel(1,7)><$emotion(1,8)>Heck yeah, I can’t believe you already made it!<br><$pkcry;0(1,2)>!<slide><br>Thanks<slide><br>a million!
msgctxt "1986:204"
msgid "<$voicel(1,7)><$emotion(1,8)>¡<$pkcry;0(1,2)>! ¡No me lo creo! ¡Qué rápido has<br>terminado, máquina! ¡Graciaaas!"
msgstr "<$voicel(1,7)><$emotion(1,8)>¡<$pkcry;0(1,2)>! ¡No me lo creo! ¡Qué rápido<br>terminaste, genio! ¡Graciaaas!"

#. en: <$comeff(1,10)><$facial(1,1)><$motion(1,661)><$voicel(1,8)>I’ve got a path I need you to fix up for me, bestie!
msgctxt "1986:205"
msgid "<$comeff(1,10)><$facial(1,1)><$motion(1,661)><$voicel(1,8)>¡Necesito que me despejes un camino, fiera!"
msgstr "<$comeff(1,10)><$facial(1,1)><$motion(1,661)><$voicel(1,8)>¡Necesito que me despejes un camino, crack!"

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>We made it! You’re the BEST, <$cdef(27)><pname;0></color>!
msgctxt "1986:206"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Jaaa, he llegado! Mil gracias, <$cdef(27)><pname;0></color>."
msgstr "<$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Jaaa, llegué! Mil gracias, <$cdef(27)><pname;0></color>."

#. en: <$voicel(1,7)><$emotion(1,27)>OH! That right there! That’s EXACTLY what I wanted!<br>Can I have it?! C’mon, please?!
msgctxt "1986:209"
msgid "<$voicel(1,7)><$emotion(1,27)>¡Pero si ya tienes! ¡Ole, tú! ¿Me puedo agenciar eso<br>entonces?"
msgstr "<$voicel(1,7)><$emotion(1,27)>¡Pero si ya tienes! ¡Bravo! ¿Me puedo quedar con eso<br>entonces?"

#. en: <$voicel(1,7)><$emotion(1,49)>OK! No sweat! I can wait a bit!
msgctxt "1986:210"
msgid "<$voicel(1,7)><$emotion(1,49)>Vale, ¡no pasa na! Aquí estaré esperando."
msgstr "<$voicel(1,7)><$emotion(1,49)>Bueno, ¡no pasa nada! Aquí estaré esperando."

#. en: <oneline><$voicel(1,7)><$emotion(1,14)>Could you bring me to where <$cdef(27)><nquestappk;0> </color>is? It’d<br>make<slide><br>my<slide><br>day<slide><br>if<slide><br>you did!
msgctxt "1986:212"
msgid "<oneline><oneline><$voicel(1,7)><$emotion(1,14)>¿Me llevas junto <esa;0()><$cdef(27)><nquestappk;0></color>?<br>¡Me haría una ilusión tremenda!"
msgstr "<oneline><oneline><$voicel(1,7)><$emotion(1,14)>¿Me llevas junto <esa;0()><$cdef(27)><nquestappk;0></color>?<br>¡Me haría muy feliz!"

#. en: <oneline><$voicel(1,7)><$emotion(1,8)>YEAH! Meetup successful! Thanks a bunch,<br><$cdef(27)><pname;0></color>!
msgctxt "1986:213"
msgid "<oneline><$voicel(1,7)><$emotion(1,8)>¡Toma ya, me encanta visitar a la peña! ¡Gracias,<br><$cdef(27)><pname;0></color>!"
msgstr "<oneline><$voicel(1,7)><$emotion(1,8)>¡Genial, me encanta visitar a todos! ¡Gracias,<br><$cdef(27)><pname;0></color>!"

#. en: <$voicel(1,7)><$emotion(1,49)>We GOTTA snap a pic together! I thought up the<br>COOLEST pose!
msgctxt "1986:214"
msgid "<$voicel(1,7)><$emotion(1,49)>¡Tenemos que hacernos una foto, leyenda! ¡Se me ha<br>ocurrido una pose guapísima!"
msgstr "<$voicel(1,7)><$emotion(1,49)>¡Tenemos que tomarnos una foto, leyenda! ¡Se me<br>ocurrió una pose genial!"

#. en: <$voicel(1,7)><$emotion(1,14)>So that’s our pic? WOW, isn’t this just the best picture in<br>the universe?! <$voicel(1,10)><$emotion(1,8)>Thanks a million, <$cdef(27)><pname;0></color>!
msgctxt "1986:215"
msgid "<$voicel(1,7)><$emotion(1,14)>¡Ey, pero si es nuestra foto! Buah, ¿existe una fotaza mejor<br>en el mundo?<clear><br><$voicel(1,10)><$emotion(1,8)>¡Gracias por posar conmigo, <$cdef(27)><pname;0></color>!"
msgstr "<$voicel(1,7)><$emotion(1,14)>¡Ey, pero si es nuestra foto! Guau, ¿existe una fotaza mejor<br>en el mundo?<clear><br><$voicel(1,10)><$emotion(1,8)>¡Gracias por posar conmigo, <$cdef(27)><pname;0></color>!"

#. en: <$comeff(1,6)><$motion(1,666)><$voicel(1,7)>Wait, what?! Is <$cdef(27)><nquestappk;0> </color>ALREADY nearby?!
msgctxt "1986:217"
msgid "<$comeff(1,6)><$motion(1,666)><$voicel(1,7)>¿Quéee? ¡Pero si <dart;0()><$cdef(27)><nquestappk;0></color> está ahí al ladooo!"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,1)><$pkcry;0(1,1)>! Got a favor to ask you!
msgctxt "1986:224"
msgid "<oneline><$voicel(1,7)><$emotion(1,1)>¡<$pkcry;0(1,1)>! ¡Tengo algo que pedirte, máquina!<br>¿Me ayudas?"
msgstr "<oneline><$voicel(1,7)><$emotion(1,1)>¡<$pkcry;0(1,1)>! ¡Tengo algo que pedirte, genio!<br>¿Me ayudas?"

#. en: <$voicel(1,7)><$emotion(1,14)>Gotcha! No worries! I’ll ask you to help out another time!
msgctxt "1986:225"
msgid "<$voicel(1,7)><$emotion(1,14)>Bueno, no pasa nada. ¡Ya si eso en otro momento!"
msgstr "<$voicel(1,7)><$emotion(1,14)>Bueno, no pasa nada. ¡Ya será en otro momento!"

#. en: <oneline><$voicel(1,7)><$emotion(1,14)>I really want<br><iart;0()><$cdef(27)><fqty(1)><class><nquestitem;0></color><slide><br>near<slide><br>my place!
msgctxt "1986:226"
msgid "<oneline><$voicel(1,7)><$emotion(1,14)>¡Estaría guapísimo tener<br><iart;0()><$cdef(27)><fqty(1)><class><nquestitem;0></color><slide><br>en mi casa!"
msgstr "<oneline><$voicel(1,7)><$emotion(1,14)>¡Sería genial tener<br><iart;0()><$cdef(27)><fqty(1)><class><nquestitem;0></color><slide><br>en mi casa!"

#. en: <$voicel(1,7)><$emotion(1,8)>I saw you set up what I wanted! Thank you sooo much,<br>bestie! <$pkcry;0(1,2)>!
msgctxt "1986:227"
msgid "<$voicel(1,7)><$emotion(1,8)>¿En seriooo? ¡Buah! ¡Vaya crack! ¡Graciaaas! ¡Eres <gen;-2(el,la)> mejor,<br><flow><$pkcry;0(1,2)>!"
msgstr "<$voicel(1,7)><$emotion(1,8)>¿En seriooo? ¡Guau! ¡Qué crack! ¡Graciaaas! ¡Eres <gen;-2(el,la)> mejor,<br><flow><$pkcry;0(1,2)>!"

#. en: <$voicel(1,5)><$comeff(1,6)><$motion(1,666)>Whaaa? Wait, have you somehow already finished it?!
msgctxt "1986:232"
msgid "<$voicel(1,5)><$comeff(1,6)><$motion(1,666)>Hala, ¿cómo es posible? ¡¿Ya lo has hecho?!"
msgstr "<$voicel(1,5)><$comeff(1,6)><$motion(1,666)>Guau, ¿cómo es posible? ¡¿Ya lo hiciste?!"

#. en: <$voicel(1,7)><$comeff(1,6)><$motion(1,666)>...OH! Wait, did you seriously already set it up?!
msgctxt "1986:233"
msgid "<$voicel(1,7)><$comeff(1,6)><$motion(1,666)>¿Cómooo? ¡No me digas que ya está! Eres <gen;-2(un,una)> crack."
msgstr ""

#. en: <$voicel(1,7)><$comeff(1,6)><$motion(1,666)>Whaaa? Did you somehow ALREADY do what I asked?
msgctxt "1986:234"
msgid "<$voicel(1,7)><$comeff(1,6)><$motion(1,666)>¡Halaaa! ¡Pero si ya lo has hecho!"
msgstr "<$voicel(1,7)><$comeff(1,6)><$motion(1,666)>¡Guaaau! ¡Pero si ya lo hiciste!"

#. en: <$voicel(1,8)><$facial(1,4)><$emotion(1,14)><$cdef(27)><pname;0></color>! Perfect timing!<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,666)><$facial(1,1)>I’m in a little bit of a pickle right now, so I’m asking<br>everyone for help!<$voicel(1,4)><$emotion(1,29)> Think you could lend me a hand too?
msgctxt "1986:235"
msgid "<$voicel(1,8)><$facial(1,4)><$emotion(1,14)>¡Llegas en el mejor momento, <$cdef(27)><pname;0></color>!<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,666)><$facial(1,1)>Tengo un pequeeeño problemilla, y ya les he pedido<br>ayuda a los demás, pero oye, cuantos más, mejooor.<slide><br><$voicel(1,4)><$emotion(1,29)>¿Qué me dices? ¿Te animas?"
msgstr "<$voicel(1,8)><$facial(1,4)><$emotion(1,14)>¡Llegas en el mejor momento, <$cdef(27)><pname;0></color>!<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,666)><$facial(1,1)>Tengo un pequeeeño problemita, y ya les pedí<br>ayuda a los demás, pero oye, cuantos más, mejooor.<slide><br><$voicel(1,4)><$emotion(1,29)>¿Qué me dices? ¿Te animas?"

#. en: <$voicel(1,5)><$emotion(1,14)>Hey! So, all that stuff I was asking everyone to help out<br>with earlier? <$voicel(1,8)><$emotion(1,38)>It’s all totally sorted out now!<clear><br><$voicel(1,7)><$comeff(1,9)><$facial(1,4)><$motion(1,661)>If anything else comes up, I’ll be counting on ya next<br>time, <$cdef(27)><pname;0></color>!
msgctxt "1986:236"
msgid "<$voicel(1,5)><$emotion(1,14)>Oye, ¿recuerdas el favor por el que os molesté a unos<br>cuantos? <$voicel(1,8)><$emotion(1,38)>¡Pues ya está resuelto!<clear><br><$voicel(1,7)><$comeff(1,9)><$facial(1,4)><$motion(1,661)>¡Ya te pediré ayuda si vuelve a hacerme falta!"
msgstr "<$voicel(1,5)><$emotion(1,14)>Oye, ¿recuerdas el favor por el que los molesté a unos<br>cuantos? <$voicel(1,8)><$emotion(1,38)>¡Pues ya está resuelto!<clear><br><$voicel(1,7)><$comeff(1,9)><$facial(1,4)><$motion(1,661)>¡Ya te pediré ayuda si vuelve a hacerme falta!"

#. en: <$emotion(1,14)><$voicel(1,5)>You should make a new house! It’d give the town even<br>better vibes, <$emotion(1,39)><$voicel(1,8)>and I bet everyone would be PSYCHED!
msgctxt "1986:237"
msgid "<$emotion(1,14)><$voicel(1,5)>¡Estaría guapísimo que montaras alguna casa humana<br>nueva!<$emotion(1,39)><$voicel(1,8)> ¡Seguro que a todos les haría mazo de ilusión!"
msgstr "<$emotion(1,14)><$voicel(1,5)>¡Sería genial que construyeras alguna casa humana<br>nueva!<$emotion(1,39)><$voicel(1,8)> ¡Seguro que a todos les encantaría!"

#. en: <$comeff(1,9)><$motion(1,801)><$voicel(1,9)>NO WAY! Did you really make a house?! Thank you<br>SOOO much!
msgctxt "1986:238"
msgid "<$comeff(1,9)><$motion(1,801)><$voicel(1,9)>¡Una casaaa! ¡Gracias, máquinaaa!"
msgstr "<$comeff(1,9)><$motion(1,801)><$voicel(1,9)>¡Una casaaa! ¡Gracias, geniooo!"

#. en: <oneline><$comeff(1,5)><$motion(1,806)><$voicel(1,7)>I could REALLY go for<br><iart;0()><$cdef(27)><fqty(1)><class><nquestitem;0></color>!<slide><br>If<slide><br>you<slide><br>find<slide><br>any,<slide><br>you<slide><br>GOTTA<slide><br>share<slide><br>with me!
msgctxt "1986:239"
msgid "<oneline><$comeff(1,5)><$motion(1,806)><$voicel(1,7)>¡Necesito<br><iart;0()><fqty(1)><class><$cdef(27)><nquestitem;0></color><slide><br>ahora mismo!<slide><br>¿No tendrás un<genqty;0(o,a,os,as)> para mí?"
msgstr ""

#. en: <oneline><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)><$cdef(27)><pname;0></color>! Thank yooouuu! I’m gonna eat<br>SOOO<slide><br>much<slide><br>of this!
msgctxt "1986:240"
msgid "<oneline><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Gracias, crack! ¡Con esto ya tengo pa comer hoy!"
msgstr ""

#. en: <$comeff(1,3)><$motion(1,801)><$voicel(1,8)>Wha—?! Well, everything’s all nice ’n’ solved, then!
msgctxt "1986:241"
msgid "<$comeff(1,3)><$motion(1,801)><$voicel(1,8)>¡Pues mira, todo resuelto!"
msgstr ""

#. en: <oneline><$comeff(1,9)><$motion(1,801)><$voicel(1,9)>Knew I could count on ya, <$cdef(27)><pname;0></color>!<br>You<slide><br>always<slide><br>have<slide><br>my back!
msgctxt "1986:242"
msgid "<oneline><$comeff(1,9)><$motion(1,801)><$voicel(1,9)>¡Si es que eres u<gen;-2(n,na)> máquina, <$cdef(27)><pname;0></color>!<br>¡Gracias!"
msgstr "<oneline><$comeff(1,9)><$motion(1,801)><$voicel(1,9)>¡Eres u<gen;-2(n,na)> crack, <$cdef(27)><pname;0></color>!<br>¡Gracias!"

#. en: <$comeff(1,3)><$facial(1,1)><$motion(1,666)><$voicel(1,9)>Wha—?! Did you ALREADY make some? C’mon, you gotta<br>share with me!
msgctxt "1986:243"
msgid "<$comeff(1,3)><$facial(1,1)><$motion(1,666)><$voicel(1,9)>¿Quéee? ¿Ya está? ¿Y hay algo para mí?"
msgstr ""

#. en: <oneline><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)><$cdef(27)><pname;0></color>! Thank yooouuu! I’m gonna eat<br>SOOO<slide><br>much<slide><br>of this!
msgctxt "1986:244"
msgid "<oneline><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Gracias, <$cdef(27)><pname;0></color>! Con esto ya tengo<br>pa comer hoy."
msgstr ""

#. en: <oneline><$voicel(1,7)><$emotion(1,38)>Oh, <$cdef(27)><pname;0></color>! Take this! It’s a present<br>for you!<clear><br><$voicel(1,10)><$comeff(1,9)>I hope we’ll be besties for a long, long time!
msgctxt "1986:301"
msgid "<oneline><$voicel(1,7)><$emotion(1,38)>¡<$cdef(27)><pname;0></color>! Tengo un regalo para ti.<br><$voicel(1,10)><$comeff(1,9)>¡Espero que te mole!"
msgstr "<oneline><$voicel(1,7)><$emotion(1,38)>¡<$cdef(27)><pname;0></color>! Tengo un regalo para ti.<br><$voicel(1,10)><$comeff(1,9)>¡Espero que te guste!"

#. en: <$comeff(1,4)><$facial(1,1)><$motion(1,807)><$voicel(1,3)>You’ve got tons of Pokémon with you already, bestie! I<br>don’t wanna bump into anyone! Gonna pass for now!
msgctxt "1986:302"
msgid "<$comeff(1,4)><$facial(1,1)><$motion(1,807)><$voicel(1,3)>Uy, qué de peña, ¡si no se puede ni andar sin chocarse!<br>Ya quedaremos tú y yo otro día, ¿eh?"
msgstr "<$comeff(1,4)><$facial(1,1)><$motion(1,807)><$voicel(1,3)>Uy, cuánta gente, ¡si no se puede ni andar sin chocarse!<br>Ya nos veremos tú y yo otro día, ¿eh?"

#. en: <$comeff(1,4)><$motion(1,802)><$voicel(1,3)>Sorry, bestie! Maybe some other time, yeah?
msgctxt "1986:303"
msgid "<$comeff(1,4)><$motion(1,802)><$voicel(1,3)>¡Ups! ¡Perdona, me viene mejor luego!"
msgstr ""

#. en: <$voicel(1,8)><$comeff(1,5)><$motion(1,814)>Oof! There we go! <wait(0.5)><$voicel(1,10)><$facial(1,4)><$comeff(1,9)>We’re gonna <$cdef(27)><$spwfull(1)></color> this thing in no<br>time at all!
msgctxt "1986:304"
msgid "<$voicel(1,8)><$comeff(1,5)><$motion(1,814)>¡Aúpa, ahí!<wait(0.5)> <$voicel(1,10)><$facial(1,4)><$comeff(1,9)>¡La <$cdef(27)>construcción<nbs2><$spwicon(1)></color> va sobre ruedas!"
msgstr "<$voicel(1,8)><$comeff(1,5)><$motion(1,814)>¡Upa, ahí!<wait(0.5)> <$voicel(1,10)><$facial(1,4)><$comeff(1,9)>¡La <$cdef(27)>construcción<nbs2><$spwicon(1)></color> va sobre ruedas!"

#. en: <$emotion(1,50)><$voicel(1,8)>Headin’ out! Headin’ out! Headin’ out with my BESTIE! ♪
msgctxt "1986:305"
msgid "<$emotion(1,50)><$voicel(1,8)>♪Vamos de excursión, ¡a topeee!♪"
msgstr "<$emotion(1,50)><$voicel(1,8)>♪Vamos de excursión, ¡con todooo!♪"

#. en: <$voicel(1,7)><$emotion(1,14)>Well, bye-bye for now! Catch ya later!
msgctxt "1986:306"
msgid "<$voicel(1,7)><$emotion(1,14)>¡Vale, no te rayes! ¡Nos vemos!"
msgstr "<$voicel(1,7)><$emotion(1,14)>¡Bueno, no te preocupes! ¡Nos vemos!"

#. en: <$voicel(1,3)><$comeff(1,7)><$motion(1,807)><$facial(1,9)>Sorry, bestie... I’m so hungry that I can’t move an INCH!<br>Maybe we could go for a walk later on?
msgctxt "1986:307"
msgid "<$voicel(1,3)><$comeff(1,7)><$motion(1,807)><$facial(1,9)>Lo siento, fiera, pero tengo un hambre que me subo por<br>las paredes. ¿Lo dejamos para otro momento?"
msgstr "<$voicel(1,3)><$comeff(1,7)><$motion(1,807)><$facial(1,9)>Lo siento, crack, pero tengo un hambre que me subo por<br>las paredes. ¿Lo dejamos para otro momento?"

#. en: <$voicel(1,3)><$comeff(1,7)><$motion(1,807)><$facial(1,9)>I’m so hungry that I can’t take another step! Arghhh, this is<br>the absolute WORST!
msgctxt "1986:308"
msgid "<$voicel(1,3)><$comeff(1,7)><$motion(1,807)><$facial(1,9)>¡AGH! ¡Hasta aquí, crack! ¡Tengo tanta hambre que no<br>puedo dar un paso más!"
msgstr ""

#. en: <$voicel(1,5)><$comeff(1,7)><$facial(1,9)><$motion(1,805)>Oh, it’s raining! Can’t stay out too long or I’ll catch<br>a cold...
msgctxt "1986:311"
msgid "<$voicel(1,5)><$comeff(1,7)><$facial(1,9)><$motion(1,805)>¡Qué rollo de lluvia! Mejor me voy a casa, que no quiero<br>pillar un resfriado."
msgstr "<$voicel(1,5)><$comeff(1,7)><$facial(1,9)><$motion(1,805)>¡Qué molesta la lluvia! Mejor me voy a casa, que no quiero<br>pescar un resfriado."

#. en: <$voicel(1,7)><$comeff(1,7)><$motion(1,803)><$facial(1,13)>ACK! Hey, quit it! Don’t scare me like that!
msgctxt "1986:315"
msgid "<$voicel(1,7)><$comeff(1,7)><$motion(1,803)><$facial(1,13)>¡Ay, ay, ay! ¡Oyeee, ya te vale!"
msgstr "<$voicel(1,7)><$comeff(1,7)><$motion(1,803)><$facial(1,13)>¡Ay, ay, ay! ¡Oyeee, ya basta!"

#. en: <oneline><$voicel(1,8)><$emotion(1,1)>This <$cdef(27)><fqty(1)><class><aireactp;0> </color>is<br>the BEST!<clear><br><$voicel(1,3)><$comeff(1,7)><$motion(1,805)><$facial(1,9)>But it’s a little too far from my home, y’know?<$voicel(1,6)><$emotion(1,29)><$facial(1,1)> Think you<br>could do me a solid and move it a little closer?
msgctxt "1986:317"
msgid "<$voicel(1,8)><$emotion(1,1)>¡Est<genqty;0(e,a,os,as)> <$cdef(27)><fqty(1)><aireactp;0></color> <qty;0(es,son)> la leche!<clear><br><$voicel(1,3)><$comeff(1,7)><$motion(1,805)><$facial(1,9)>Peeero est<qty;0(á,án)> un poco lejos de mi casa, me da a mí...<br><wait(0.4)><$voicel(1,6)><$emotion(1,29)><$facial(1,1)>¿Te importaría ponérmel<genqty;0(o,a,os,as)> allí?"
msgstr "<$voicel(1,8)><$emotion(1,1)>¡Est<genqty;0(e,a,os,as)> <$cdef(27)><fqty(1)><aireactp;0></color> <qty;0(es,son)> lo máximo!<clear><br><$voicel(1,3)><$comeff(1,7)><$motion(1,805)><$facial(1,9)>Peeero est<qty;0(á,án)> un poco lejos de mi casa, creo yo...<br><wait(0.4)><$voicel(1,6)><$emotion(1,29)><$facial(1,1)>¿Te importaría ponérmel<genqty;0(o,a,os,as)> allá?"

#. en: <oneline><$voicel(1,7)><$emotion(1,38)>NO WAY!<br><fcap><iart;0()><fqty(1)><class><$cdef(27)><aireactp;0></color>?! <slide><br>Thank<slide><br>you<slide><br>SOOO much!
msgctxt "1986:318"
msgid "<oneline><$voicel(1,7)><$emotion(1,38)>¡Halaaa, qué pasada! Gracias mil por traerme<br><iart;0()><$cdef(27)><fqty(1)><class><aireactp;0></color>."
msgstr "<oneline><$voicel(1,7)><$emotion(1,38)>¡Guaaau, qué genial! Gracias mil por traerme<br><iart;0()><$cdef(27)><fqty(1)><class><aireactp;0></color>."

#. en: <oneline><$voicel(1,7)><$emotion(1,8)>Ehehe... That feels amazing!<br>C’mon, <$cdef(27)><pname;0></color>!<slide><br>More! More!
msgctxt "1986:319"
msgid "<$voicel(1,7)><$emotion(1,8)>¡Uy, je, je! ¡Qué gustitooo! ¡Quiero más!"
msgstr ""

#. en: <$voicel(1,5)><$comeff(1,6)><$motion(1,805)>Huh? Hmmm... I guess that tickled a little!
msgctxt "1986:320"
msgid "<$voicel(1,5)><$comeff(1,6)><$motion(1,805)>¿Hm? ¡Me haces cosquillas!"
msgstr ""

#. en: <oneline><$voicel(1,7)><$facial(1,13)><$comeff(1,4)><$motion(1,805)>Wha—?! My <$cdef(27)><fqty(1)><class><aireactp;0><br></color>is<slide><br>gone!<slide><br>Where<slide><br>could<slide><br>it<slide><br>have<slide><br>run<slide><br>off to?
msgctxt "1986:322"
msgid "<oneline><$voicel(1,7)><$facial(1,13)><$comeff(1,4)><$motion(1,805)>¿Y <dart;0()><$cdef(27)><fqty(1)><aireactp;0></color>?<br>¡Se <qty;0(ha,han)> esfumado<slide><br>como por arte<slide><br>de magia!"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,39)>My home has gotten SOOO nice and warm!
msgctxt "1986:323"
msgid "<$voicel(1,7)><$emotion(1,39)>¡Qué a gusto estoy ahora que hace más calorcillo!"
msgstr "<$voicel(1,7)><$emotion(1,39)>¡Qué a gusto estoy ahora que hace más calorcito!"

#. en: <$voicel(1,5)><$comeff(1,4)><$motion(1,805)><$facial(1,9)>My place has definitely gotten a lot hotter recently, yeah?<br><$voicel(1,4)><$emotion(1,47)>Ugh... This heat’s gonna be rough...
msgctxt "1986:324"
msgid "<$voicel(1,5)><$comeff(1,4)><$motion(1,805)><$facial(1,9)>Hace un poco de calor en casa... <wait(0.4)><$voicel(1,4)><$emotion(1,47)>Lo estoy pasando<br>regulero..."
msgstr "<$voicel(1,5)><$comeff(1,4)><$motion(1,805)><$facial(1,9)>Hace un poco de calor en casa... <wait(0.4)><$voicel(1,4)><$emotion(1,47)>La estoy pasando<br>medio mal..."

#. en: <$voicel(1,7)><$emotion(1,39)>My home’s nice and cool now! Gotta say, it makes living<br>here feel a heck of a lot easier!
msgctxt "1986:325"
msgid "<$voicel(1,7)><$emotion(1,39)>¡Se nota que ha refrescado en casa! ¡Ahora se está de lujo!"
msgstr "<$voicel(1,7)><$emotion(1,39)>¡Se nota que refrescó en casa! ¡Ahora se está de lujo!"

#. en: <$voicel(1,3)><$comeff(1,23)><$motion(1,807)><$facial(1,9)>Doesn’t my home feel a little colder lately?<$voicel(1,6)><$emotion(1,29)> Are you<br>really OK with temps like this, <$cdef(27)><pname;0></color>?
msgctxt "1986:326"
msgid "<$voicel(1,3)><$comeff(1,23)><$motion(1,807)><$facial(1,9)>Brrr... Qué frío hace en casa... <wait(0.4)><$voicel(1,6)><$emotion(1,29)>¿Tú no lo notas?"
msgstr ""

#. en: <$voicel(1,5)><$comeff(1,3)><$motion(1,805)><$facial(1,4)>HECK YEAH! My place has gotten a little brighter!<br><$voicel(1,8)><$emotion(1,6)>No doubt about it—this is how a home should be!
msgctxt "1986:327"
msgid "<$voicel(1,5)><$comeff(1,3)><$motion(1,805)><$facial(1,4)>¡Qué luminosa está la casa ahora! <wait(0.4)><$voicel(1,8)><$emotion(1,6)>Este es el ambiente<br>perfecto para mi hogar."
msgstr ""

#. en: <$voicel(1,3)><$emotion(1,47)>Ugh... My place has been TOO bright lately! I wish<br>it were a little darker so I could actually unwind!
msgctxt "1986:328"
msgid "<$voicel(1,3)><$emotion(1,47)>Hay demasiada luz en casa... Así no hay quien se relaje."
msgstr ""

#. en: <$voicel(1,7)><$comeff(1,3)><$motion(1,805)><$pkcry;0(1,2)>! YEAH! My place got a little darker!<$voicel(1,6)><$emotion(1,6)><br>Ahh... This is more relaxing for SURE!
msgctxt "1986:329"
msgid "<oneline><$voicel(1,7)><$comeff(1,3)><$motion(1,805)>¡<$pkcry;0(1,2)>! ¡Qué bien se está a oscuras!<br><wait(0.4)><$voicel(1,6)><$emotion(1,6)>Era justo lo que<slide><br>necesitaba para estar de relax total."
msgstr ""

#. en: <$voicel(1,3)><$comeff(1,7)><$motion(1,666)><$facial(1,9)>Hmmm... My place has been getting sorta dark recently.<br>Gotta say, I prefer it a LITTLE bit brighter...
msgctxt "1986:330"
msgid "<$voicel(1,3)><$comeff(1,7)><$motion(1,666)><$facial(1,9)>¿Quién ha apagado las luces? Se estaba mucho mejor<br>antes, con esto más iluminado..."
msgstr "<$voicel(1,3)><$comeff(1,7)><$motion(1,666)><$facial(1,9)>¿Quién apagó las luces? Se estaba mucho mejor<br>antes, con esto más iluminado..."

#. en: <$voicel(1,7)><$emotion(1,6)>The extra humidity makes my place feel SOOO nice! ♪
msgctxt "1986:331"
msgid "<$voicel(1,7)><$emotion(1,6)>¡El aire en casa tiene el grado de humedad perfecto!<br>¡Así da gusto!"
msgstr ""

#. en: <$comeff(1,19)><$facial(1,9)><$voicel(1,3)><$motion(1,826)>It’s kinda humid around here, don’tcha think? It’d be way<br>nicer if the area were sorta drier!
msgctxt "1986:332"
msgid "<$comeff(1,19)><$facial(1,9)><$voicel(1,3)><$motion(1,826)>¡Ey! ¿De dónde ha salido tanta humedad de repente?<br>Se estaba más a gusto antes."
msgstr "<$comeff(1,19)><$facial(1,9)><$voicel(1,3)><$motion(1,826)>¡Ey! ¿De dónde salió tanta humedad de repente?<br>Se estaba más a gusto antes."

#. en: <$comeff(1,13)><$voicel(1,9)><$pkcry;0(1,2)>! It feels like the air got drier!<br><$comeff(1,1)><$motion(1,801)><$voicel(1,10)><$facial(1,4)>I LOVE that!
msgctxt "1986:333"
msgid "<$comeff(1,13)><$voicel(1,9)>¡<$pkcry;0(1,2)>! ¡Juraría que ha bajado la humedad!<br><$comeff(1,1)><$motion(1,801)><$voicel(1,10)><$facial(1,4)>¡Menos mal! Jaaa."
msgstr "<$comeff(1,13)><$voicel(1,9)>¡<$pkcry;0(1,2)>! ¡Juraría que bajó la humedad!<br><$comeff(1,1)><$motion(1,801)><$voicel(1,10)><$facial(1,4)>¡Menos mal! Jaaa."

#. en: <$comeff(1,19)><$facial(1,9)><$voicel(1,3)><$motion(1,826)>Errr, this area feels kinda too dry. I need more moisture<br>in the air!
msgctxt "1986:334"
msgid "<$comeff(1,19)><$facial(1,9)><$voicel(1,3)><$motion(1,826)>¡Buf, el aire por aquí está sequísimo! Falta humedad<br>en el ambiente."
msgstr ""

#. en: <oneline><$voicel(1,7)><$comeff(1,14)><$motion(1,805)>Look, I WANT to go check out that thing you just put<br>down, <$voicel(1,5)><$comeff(1,4)><$motion(1,807)><$facial(1,9)>but I don’t think I can even GET there from here!<clear><br><$voicel(1,7)><$emotion(1,29)><$facial(1,1)>Think you could clear a path for me? I’m begging<br>you, <$cdef(27)><pname;2></color>!
msgctxt "1986:335"
msgid "<$voicel(1,7)><$comeff(1,14)><$motion(1,805)>Oye, fiera, me encantaría ir a ver lo que me has traído,<br>de veras, pero... <wait(0.4)><$voicel(1,5)><$comeff(1,4)><$motion(1,807)><$facial(1,9)>¡resulta que no tengo cómo llegar!<clear><br><$voicel(1,7)><$emotion(1,29)><$facial(1,1)>¿Podríaaas... despejar un poco el camino hasta allí?<br>¡Vaaa, pórtate!"
msgstr "<$voicel(1,7)><$comeff(1,14)><$motion(1,805)>Oye, crack, me encantaría ir a ver lo que me trajiste,<br>de veras, pero... <wait(0.4)><$voicel(1,5)><$comeff(1,4)><$motion(1,807)><$facial(1,9)>¡resulta que no tengo cómo llegar!<clear><br><$voicel(1,7)><$emotion(1,29)><$facial(1,1)>¿Podríaaas... despejar un poco el camino hasta allá?<br>¡Porfaaa!"

#. en: <$voicel(1,8)><$comeff(1,10)><$motion(1,806)><$facial(1,4)>All right! Time to go ALL OUT!
msgctxt "1986:336"
msgid "<$voicel(1,8)><$comeff(1,10)><$motion(1,806)><$facial(1,4)>¡Jaaa! ¡Haré lo que pueda!"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,14)>Wait, somethin’ weird’s going on over here! Come check it<br>out, <$cdef(27)><pname;0></color>!
msgctxt "1986:337"
msgid "<$voicel(1,7)><$emotion(1,14)>Oye, figura, aquí hay algo raro, ¿no te parece?"
msgstr "<$voicel(1,7)><$emotion(1,14)>Oye, crack, aquí hay algo raro, ¿no te parece?"

#. en: <$voicel(1,7)><$emotion(1,8)><$pkcry;0(1,2)>! ♪ Hehe... Demolition is way too fun!
msgctxt "1986:338"
msgid "<$voicel(1,7)><$emotion(1,8)>¡<$pkcry;0(1,2)>! ¡Me lo paso de miedo demoliendo!"
msgstr "<$voicel(1,7)><$emotion(1,8)>¡<$pkcry;0(1,2)>! ¡Me la paso genial demoliendo!"

#. en: <$voicel(1,7)><$comeff(1,8)><$facial(1,5)><$motion(1,805)>That smells AMAZING! I bet it’s gonna taste so good!
msgctxt "1986:339"
msgid "<$voicel(1,7)><$comeff(1,8)><$facial(1,5)><$motion(1,805)>¡Buah, esto huele que alimenta!"
msgstr "<$voicel(1,7)><$comeff(1,8)><$facial(1,5)><$motion(1,805)>¡Guau, esto huele delicioso!"

#. en: <$voicel(1,9)><$emotion(1,8)>I LOVE to <$cdef(27)><$spwfull(23)></color>! YEAHHH!
msgctxt "1986:340"
msgid "<$voicel(1,9)><$emotion(1,8)>¡Yujuuu! ¡Nada como una buena <$cdef(27)>fiestuqui</color><nbs2><$spwicon(23)>!"
msgstr ""

#. en: <$voicel(1,6)><$comeff(1,8)><$motion(1,807)><$facial(1,14)>Ahhhhhh... Hot springs are the BEST!
msgctxt "1986:341"
msgid "<$voicel(1,6)><$comeff(1,8)><$motion(1,807)><$facial(1,14)>Ah... Qué a gustito se está en el agua calentita..."
msgstr ""

#. en: <oneline><$voicel(1,5)><$comeff(1,10)><$motion(1,806)><$facial(1,4)><$cdef(27)><pname;0></color>! My<br><fqty(1)><class><$cdef(27)><aireactp;1></color><slide><br><$voicel(1,8)><$emotion(1,27)>is<slide><br>a<slide><br>LITTLE<slide><br>tough<slide><br>to<slide><br>access<slide><br>right now!<clear><br><$voicel(1,6)><$comeff(1,3)><$motion(1,805)>Think you could put it somewhere else for me?
msgctxt "1986:343"
msgid "<oneline><$voicel(1,5)><$comeff(1,10)><$motion(1,806)><$facial(1,4)>¡Oyeee, <$cdef(27)><pname;0></color>! Hay un problema con<br><dart;1()><$cdef(27)><fqty(1)><aireactp;1></color>.<clear><br><$voicel(1,8)><$emotion(1,27)>Tal y donde est<qty;1(á,án)> ahora mismo, no se pued<qty;1(e,en)> usar...<br><$voicel(1,6)><$comeff(1,3)><$motion(1,805)>¡Pon<genqty;1(lo,la,los,las)> en otro sitio, fiera!"
msgstr "<oneline><$voicel(1,5)><$comeff(1,10)><$motion(1,806)><$facial(1,4)>¡Oyeee, <$cdef(27)><pname;0></color>! Hay un problema con<br><dart;1()><$cdef(27)><fqty(1)><aireactp;1></color>.<clear><br><$voicel(1,8)><$emotion(1,27)>Tal y donde est<qty;1(á,án)> ahora mismo, no se pued<qty;1(e,en)> usar...<br><$voicel(1,6)><$comeff(1,3)><$motion(1,805)>¡Pon<genqty;1(lo,la,los,las)> en otro lugar, crack!"

#. en: <$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>It’s been really easy living around here lately! And it’s<br>all thanks to YOUR hard work, bestie!
msgctxt "1986:344"
msgid "<$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Qué guapa ha quedado mi casa! ¡Muchísimas gracias!"
msgstr "<$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Qué bonita quedó mi casa! ¡Muchísimas gracias!"

#. en: <$comeff(1,10)><$facial(1,1)><$motion(1,805)><$voicel(1,7)>The area around my home is starting to get SUPER comfy!<br>Keep it up! I’m counting on ya, bestie!
msgctxt "1986:345"
msgid "<$comeff(1,10)><$facial(1,1)><$motion(1,805)><$voicel(1,7)>¡Está quedando genial mi casa! ¡Cada vez me mola más!"
msgstr "<$comeff(1,10)><$facial(1,1)><$motion(1,805)><$voicel(1,7)>¡Está quedando genial mi casa! ¡Cada vez me gusta más!"

#. en: <oneline><$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,8)><$cdef(27)><pname;0></color>! It is TREASURE HUNTING<br>time,<slide><br>my<slide><br>friend!<slide><br>I<slide><br>literally<slide><br>cannot<slide><br>wait<slide><br>a<slide><br>second longer!<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,805)><$voicel(1,7)>So c’mon! Grab a <$cdef(27)><fqty(1)><$ifull(2793)> </color>and let’s get to it!
msgctxt "1986:400"
msgid "<oneline><$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,8)>¡Ey, <$cdef(27)><pname;0></color>, vámonos a buscar tesoros!<clear><br>Llevo todo el día con unas ganas locas.<br><$comeff(1,9)><$facial(1,4)><$motion(1,805)><$voicel(1,7)>¡Saca el <$cdef(27)><fqty(1)><$ifull(2793)> </color>y vamos allá!"
msgstr "<oneline><$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,8)>¡Ey, <$cdef(27)><pname;0></color>, vámonos a buscar tesoros!<clear><br>Llevo todo el día con unas ganas locas.<br><$comeff(1,9)><$facial(1,4)><$motion(1,805)><$voicel(1,7)>¡Saca el <$cdef(27)><fqty(1)><$ifull(2793)> </color>y vámonos!"

#. en: <$cdef(27)><oneline><$voicel(1,5)><$emotion(1,29)><pname;0></color>! Got the road all cleared and<br>ready to go?
msgctxt "1986:402"
msgid "<$cdef(27)><$voicel(1,5)><$emotion(1,29)></color>¡Ey, leyenda! ¿Cómo va ese camino? ¿Está ya listo?"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,8)>For real?! All right, let’s gooo!
msgctxt "1986:403"
msgid "<$voicel(1,7)><$emotion(1,8)>¿En serio? ¡Menud<gen;-2(o,a)> crack! ¿Te vienes conmigo?"
msgstr "<$voicel(1,7)><$emotion(1,8)>¿En serio? ¡Eres buenísim<gen;-2(o,a)>! ¿Te vienes conmigo?"

#. en: <$voicel(1,5)><$emotion(1,49)>No prob! No rush at all!
msgctxt "1986:404"
msgid "<$voicel(1,5)><$emotion(1,49)>Ah, bueno, ¡no te rayes! ¡Hazlo cuando mejor te venga!"
msgstr "<$voicel(1,5)><$emotion(1,49)>Ah, bueno, ¡no te preocupes! ¡Hazlo cuando mejor te venga!"

#. en: <oneline><$voicel(1,3)><$emotion(1,47)><$pkcry;0(1,4)>... I just don’t think there’s any way I can<br>get<slide><br>through here...<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,805)>I bet I could pass through if someone would clear the way<br>just a little bit more!<clear><br><$cdef(27)><$voicel(1,8)><$emotion(1,29)></color>Sorry to ask, but couldja help me out here,<br><$cdef(27)><pname;1></color>?
msgctxt "1986:405"
msgid "<$voicel(1,3)><$emotion(1,47)><$pkcry;0(1,4)>... Me da que no voy a poder ir por aquí,<br>viendo cómo está el camino.<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,805)>Creo que si le hicieses un arreglillo, la cosa cambiaría...<clear><br><$cdef(27)><$voicel(1,8)><$emotion(1,29)></color>Me sabe mal pedírtelo, pero seguro que no te cuesta<br>nada, fiera."
msgstr "<$voicel(1,3)><$emotion(1,47)><$pkcry;0(1,4)>... Creo que no voy a poder ir por aquí,<br>viendo cómo está el camino.<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,805)>Creo que si le hicieras un arreglito, la cosa cambiaría...<clear><br><$cdef(27)><$voicel(1,8)><$emotion(1,29)></color>Me da pena pedírtelo, pero seguro que no te cuesta<br>nada, crack."

#. en: <$comeff(1,7)><$motion(1,802)><$voicel(1,3)>Wha—?! There’s nooo way I can get past this! Dang it...<clear><br><$comeff(1,3)><$motion(1,803)><$voicel(1,8)>Let me know when the path is clear!
msgctxt "1986:408"
msgid "<$comeff(1,7)><$motion(1,802)><$voicel(1,3)>¡Qué raro! ¡Si por aquí no hay camino! <$comeff(1,3)><$motion(1,803)><$voicel(1,8)>Oye, ¿me avisas<br>cuando se pueda pasar?"
msgstr ""

#. en: <$voicel(1,5)><$emotion(1,29)>Hey! Is <$cdef(27)><wowner;0></color> one of your buddies?<clear><br><$voicel(1,7)><$emotion(1,1)>Someone said they live around here and it made me<br>wanna drop in to say hi!
msgctxt "1986:409"
msgid "<oneline><$voicel(1,5)><$emotion(1,29)>¿<$cdef(27)><wowner;0></color> es tu colega?<br>Vive por aquí, ¿no?<slide><br><$voicel(1,7)><$emotion(1,1)>¡Me encantaría conocerl<gen;0(o,a)>!"
msgstr ""

#. en: <$comeff(1,3)><$motion(1,803)><$voicel(1,7)>Gotcha! OK—I’ll head back to my place for now!
msgctxt "1986:410"
msgid "<$comeff(1,3)><$motion(1,803)><$voicel(1,7)>¡Valeee! Pues entonces, mejor te espero en casa."
msgstr "<$comeff(1,3)><$motion(1,803)><$voicel(1,7)>¡Bueeeno! Pues entonces, mejor te espero en casa."

#. en: <$voicel(1,4)><$emotion(1,29)>Heyo, whatcha got there?
msgctxt "1986:411"
msgid "<$voicel(1,4)><$emotion(1,29)>¡Halaaa! ¿Qué es eso que llevas, fiera?"
msgstr "<$voicel(1,4)><$emotion(1,29)>¡Guaaau! ¿Qué es eso que llevas, crack?"

#. en: <$voicel(1,4)><$comeff(1,3)>Oh, all right!
msgctxt "1986:412"
msgid "<$voicel(1,4)><$comeff(1,3)>¡Qué chasco!"
msgstr ""

#. en: <$voicel(1,10)><$emotion(1,38)>Oh, for real?! YEAHHH!
msgctxt "1986:413"
msgid "<$voicel(1,10)><$emotion(1,38)>¿En serio? ¡Toma yaaa!"
msgstr "<$voicel(1,10)><$emotion(1,38)>¿En serio? ¡Sííí!"

#. en: <oneline><$comeff(1,10)><$facial(1,1)><$motion(1,661)><$voicel(1,7)>Whoa! You’ve GOTTA show me that<br><$cdef(27)><fqty(1)><class><refmateid;0></color>!
msgctxt "1986:414"
msgid "<oneline><$comeff(1,10)><$facial(1,1)><$motion(1,661)><$voicel(1,7)>¡Hala, qué guap<genqty;0(o,a,os,as)> es<genqty;0(e,a,os,as)><br><$cdef(27)><fqty(1)><class><refmateid;0></color>!"
msgstr "<oneline><$comeff(1,10)><$facial(1,1)><$motion(1,661)><$voicel(1,7)>¡Guau, qué bonit<genqty;0(o,a,os,as)> es<genqty;0(e,a,os,as)><br><$cdef(27)><fqty(1)><class><refmateid;0></color>!"

#. en: <$voicel(1,7)><$emotion(1,38)>Treasure hunting?! YEAHHH! Team Treasure Hunters,<br>ASSEMBLE!
msgctxt "1986:415"
msgid "<$voicel(1,7)><$emotion(1,38)>¿Toca buscar tesoros? ¡Pues yo me apuntooo!<br>¡Vamos a encontrar un montón de cosas guapísimas!"
msgstr "<$voicel(1,7)><$emotion(1,38)>¿Toca buscar tesoros? ¡Pues yo me apuntooo!<br>¡Vamos a encontrar un montón de cosas geniales!"

#. en: <$voicel(1,9)><$emotion(1,38)>Thanks for always being a blast to hang out with! <$voicel(1,8)><$comeff(1,21)><$motion(1,661)>I got ya<br>something to say thanks—and I’m looking forward to<slide><br>all our future talks too!
msgctxt "1986:416"
msgid "<$voicel(1,9)><$emotion(1,38)>Muchas gracias por quedar siempre conmigo, fiera.<br>¡Aquí me tienes siempre que quieras hablar un rato!<clear><br><$voicel(1,8)><$comeff(1,21)><$motion(1,661)>Toma, quería darte esto."
msgstr "<$voicel(1,9)><$emotion(1,38)>Muchas gracias por estar siempre conmigo, crack.<br>¡Aquí me tienes siempre que quieras hablar un rato!<clear><br><$voicel(1,8)><$comeff(1,21)><$motion(1,661)>Toma, quería darte esto."

#. en: <oneline><$voicel(1,7)><$emotion(1,39)>Really, I just want to say thanks for everything,<br><$cdef(27)><pname;0></color>!<slide><br>Let’s<slide><br>be<slide><br>besties forever!
msgctxt "1986:417"
msgid "<$voicel(1,7)><$emotion(1,39)>Tan solo quería decirte que te aprecio un montón como<br>amig<gen;-2(o,a)>, <$cdef(27)><pname;0></color>."
msgstr ""

#. en: <oneline><$voicel(1,9)><$emotion(1,53)>YAY! This is the find of a lifetime! Shoulda known you’d<br>be a treasure hunting expert, <$cdef(27)><pname;0></color>!<slide><br><$voicel(1,6)><$emotion(1,49)>Let’s<slide><br>do<slide><br>this<slide><br>together<slide><br>again sometime!
msgctxt "1986:418"
msgid "<oneline><$voicel(1,9)><$emotion(1,53)>¡Tomaaa! ¡Lo hemos petado! ¡<$cdef(27)><pname;0></color>,<br>eres <gen;-2(un,una)> crack<slide><br>buscando tesoros!<clear><br><$voicel(1,6)><$emotion(1,49)>¡Yo me apunto todas las veces que haga falta, así que<br>avísame siempre!"
msgstr "<oneline><$voicel(1,9)><$emotion(1,53)>¡Sííí! ¡Lo logramos! ¡<$cdef(27)><pname;0></color>,<br>eres <gen;-2(un,una)> crack<slide><br>buscando tesoros!<clear><br><$voicel(1,6)><$emotion(1,49)>¡Yo me apunto todas las veces que haga falta, así que<br>avísame siempre!"

#. en: <$voicel(1,7)><$emotion(1,7)>Wha—this is my FAVORITE! I love it so much! Thank<br>you, <$cdef(27)><pname;0></color>!
msgctxt "1986:419"
msgid "<oneline><$voicel(1,7)><$emotion(1,7)>¡Cómo molaaa! ¡Qué buen ojo tienes para los regalos,<br><$cdef(27)><pname;0></color>!"
msgstr "<oneline><$voicel(1,7)><$emotion(1,7)>¡Qué geniaaal! ¡Qué buen ojo tienes para los regalos,<br><$cdef(27)><pname;0></color>!"

#. en: <$comeff(1,14)><$facial(1,1)><$motion(1,805)><$voicel(1,6)>So—I would LOVE to head over thataway...
msgctxt "1986:420"
msgid "<$comeff(1,14)><$facial(1,1)><$motion(1,805)><$voicel(1,6)>¡Hay un sitio guapísimo por allá al que me molaría ir!"
msgstr "<$comeff(1,14)><$facial(1,1)><$motion(1,805)><$voicel(1,6)>¡Hay un lugar precioso por allá al que me encantaría ir!"

#. en: <oneline><$voicel(1,7)><$emotion(1,14)>Oh! You headed off thataway, <$cdef(27)><pname;0></color>?<br>Guess<slide><br>this<slide><br>is<slide><br>bye-bye<slide><br>for now!
msgctxt "1986:421"
msgid "<$voicel(1,7)><$emotion(1,14)>Oye, crack, si quieres irte de aquí, ya nos veremos en otro<br>momento. ¡Hasta luegooo!"
msgstr ""

#. en: <$comeff(1,3)><$facial(1,1)><$motion(1,807)><$voicel(1,3)>But the path is all messed up! And that means my plan to<br>get there is all messed up too!
msgctxt "1986:422"
msgid "<$comeff(1,3)><$facial(1,1)><$motion(1,807)><$voicel(1,3)>Pero, como el camino está fatalmente maaal, ¡no hay<br>quien vaya hasta allí, máquina!"
msgstr "<$comeff(1,3)><$facial(1,1)><$motion(1,807)><$voicel(1,3)>Pero, como el camino está fatalmente maaal, ¡no hay<br>quien vaya hasta allá, genio!"

#. en: <$voicel(1,7)><$emotion(1,14)>Hmmm... Don’tcha think this house is a little too small for<br>someone my size? I’d love a bigger place!
msgctxt "1986:426"
msgid "<$voicel(1,7)><$emotion(1,14)>No me convence... Aquí no quepo ni de broma.<br>¡Necesito una casa humana más grande!"
msgstr ""

#. en: <$voicel(1,7)><$comeff(1,21)><$motion(1,805)><$facial(1,4)>This house is NIIICE! Seriously, it’s like, the IDEAL house!
msgctxt "1986:427"
msgid "<$voicel(1,7)><$comeff(1,21)><$motion(1,805)><$facial(1,4)>¡Esta casa humana me flipa! Si yo viviera aquí... ¡buah,<br>sería lo más!"
msgstr "<$voicel(1,7)><$comeff(1,21)><$motion(1,805)><$facial(1,4)>¡Esta casa humana me encanta! Si yo viviera aquí...<br>¡guau, sería lo máximo!"

#. en: <oneline><$voicel(1,7)><$emotion(1,8)>Oh, for real?! Yesss! Thank you SOOO much,<br><$cdef(27)><pname;0></color>!
msgctxt "1986:428"
msgid "<$voicel(1,7)><$emotion(1,8)>¿Va en serio? ¡Pues me vengo a vivir aquí de cabeza!<br>¡Gracias, <$cdef(27)><pname;0></color>!"
msgstr "<$voicel(1,7)><$emotion(1,8)>¿Es en serio? ¡Pues me vengo a vivir aquí ya mismo!<br>¡Gracias, <$cdef(27)><pname;0></color>!"

#. en: <oneline><$voicel(1,7)><$emotion(1,49)>For sure! Dang, you really are talented,<br><$cdef(27)><pname;0></color>!
msgctxt "1986:429"
msgid "<oneline><$voicel(1,7)><$emotion(1,49)>¡Ya te digooo! ¡Se ve que entiendes del tema,<br><$cdef(27)><pname;0></color>!"
msgstr "<oneline><$voicel(1,7)><$emotion(1,49)>¡Claro que sííí! ¡Se ve que entiendes del tema,<br><$cdef(27)><pname;0></color>!"

#. en: <$voicel(1,7)><$comeff(1,3)><$motion(1,805)>Wha—no way! Are you SURE it’s OK for me to live here?!
msgctxt "1986:430"
msgid "<$voicel(1,7)><$comeff(1,3)><$motion(1,805)>¡Buah! ¡No me lo creo! ¿En serio me puedo mudar aquí?"
msgstr "<$voicel(1,7)><$comeff(1,3)><$motion(1,805)>¡Guau! ¡No lo puedo creer! ¿En serio me puedo mudar aquí?"

#. en: <$voicel(1,8)><$emotion(1,8)>YEAH! You’re the best, <$cdef(27)><pname;0></color>!
msgctxt "1986:431"
msgid "<oneline><$voicel(1,8)><$emotion(1,8)>¡Te tendría que poner un monumento,<br><$cdef(27)><pname;0></color>!<slide><br>¡Graciaaas!"
msgstr "<oneline><$voicel(1,8)><$emotion(1,8)>¡Te tendría que hacer un monumento,<br><$cdef(27)><pname;0></color>!<slide><br>¡Graciaaas!"

#. en: <$voicel(1,6)><$emotion(1,49)><$pkcry;0(1,3)>! Understood!
msgctxt "1986:432"
msgid "<$voicel(1,6)><$emotion(1,49)>¡<$pkcry;0(1,3)>! ¡Tú mandas, fiera!"
msgstr "<$voicel(1,6)><$emotion(1,49)>¡<$pkcry;0(1,3)>! ¡Tú mandas, crack!"

#. en: <$voicel(1,7)><$emotion(1,14)>Huh? But like, there’s already somebody living<br>here, right?<clear><br><$voicel(1,3)><$comeff(1,14)><$motion(1,666)>Adding ME into the mix would make this house super<br>crowded, yeah?<$voicel(1,6)><$emotion(1,49)> I’m good—for now!
msgctxt "1986:433"
msgid "<$voicel(1,7)><$emotion(1,14)>¿Eh? ¡Pero si este sitio ya está pilladooo!<clear><br><$voicel(1,3)><$comeff(1,14)><$motion(1,666)>Si entro a vivir aquí, vamos a estar en plan apretuje total.<br><$voicel(1,6)><$emotion(1,49)>Mejor lo dejamos. ¡Gracias de todas formas, leyenda!"
msgstr "<$voicel(1,7)><$emotion(1,14)>¿Eh? ¡Pero si este lugar ya está ocupadooo!<clear><br><$voicel(1,3)><$comeff(1,14)><$motion(1,666)>Si entro a vivir aquí, vamos a estar todos súper apretados.<br><$voicel(1,6)><$emotion(1,49)>Mejor lo dejamos. ¡Gracias de todas formas, leyenda!"

#. en: <$voicel(1,8)><$emotion(1,50)><$pkcry;0(1,2)>! ♪Treasure hunt SUCCESS!<clear><br><$voicel(1,7)><$emotion(1,39)>There’s nothing the two of us couldn’t track down!<$voicel(1,8)><$emotion(1,49)> Let’s<br>find some awesome stuff next time too!
msgctxt "1986:434"
msgid "<oneline><$voicel(1,8)><$emotion(1,50)>¡<$pkcry;0(1,2)>! ¡Esta vez la búsqueda ha sido todo<br>un éxito! <$voicel(1,7)><$emotion(1,39)>¡No se nos escapa una!<clear><br><$voicel(1,8)><$emotion(1,49)>¡Y seguro que la próxima vez nos va aún mejor!"
msgstr "<oneline><$voicel(1,8)><$emotion(1,50)>¡<$pkcry;0(1,2)>! ¡Esta vez la búsqueda fue todo<br>un éxito! <$voicel(1,7)><$emotion(1,39)>¡No se nos escapa una!<clear><br><$voicel(1,8)><$emotion(1,49)>¡Y seguro que la próxima vez nos va aún mejor!"

#. en: <$voicel(1,7)><$emotion(1,14)>Hey! What is THAT?! It’s so sparkly...and AWESOME!
msgctxt "1986:435"
msgid "<$voicel(1,7)><$emotion(1,14)>¿Qué es eso que llevas ahí? ¡Brilla mogollón!"
msgstr "<$voicel(1,7)><$emotion(1,14)>¿Qué es eso que llevas ahí? ¡Brilla muchísimo!"

#. en: <$voicel(1,7)><$emotion(1,8)>Wha—you’re seriously giving this to me?! Thank you sooo<br>much! In exchange... Uh... Here! Take this!
msgctxt "1986:436"
msgid "<$voicel(1,7)><$emotion(1,8)>¿Cómo? ¿Me lo das? ¡Ualaaa! ¡Qué generos<gen;-2(o,a)> eres!<br>Pues toma esto a cambio, que si no, me sabe fatal."
msgstr "<$voicel(1,7)><$emotion(1,8)>¿Cómo? ¿Me lo das? ¡Guaaau! ¡Qué generos<gen;-2(o,a)> eres!<br>Pues toma esto a cambio, que si no, me siento fatal."

#. en: <$voicel(1,5)><$comeff(1,4)><$motion(1,666)>Hmmm... It’d kinda be a waste to give this to ME, yeah?<clear><br><$voicel(1,7)><$emotion(1,49)>But I bet someone else would be SUPER happy to have it!
msgctxt "1986:437"
msgid "<$voicel(1,5)><$comeff(1,4)><$motion(1,666)>No te lo tomes a mal, máquina, pero igual este regalo<br>sería mejor para otro Pokémon.<clear><br><$voicel(1,7)><$emotion(1,49)>¡Fijo que encuentras a alguien que se alegre un montón<br>cuando se lo des!"
msgstr "<$voicel(1,5)><$comeff(1,4)><$motion(1,666)>No te lo tomes a mal, genio, pero tal vez este regalo<br>sería mejor para otro Pokémon.<clear><br><$voicel(1,7)><$emotion(1,49)>¡Seguro que encuentras a alguien que se alegre un montón<br>cuando se lo des!"

#. en: <$voicel(1,3)><$comeff(1,14)><$motion(1,666)>Hmmm... I’m glad you thought of me, but I’d have<br>no clue what to even do with this!<clear><br><$voicel(1,8)><$emotion(1,49)>You can hang on to it for now, but I super appreciate it!
msgctxt "1986:438"
msgid "<$voicel(1,3)><$comeff(1,14)><$motion(1,666)>Agradezco el detalle, pero creo que no sabría darle<br>provecho...<clear><br><$voicel(1,8)><$emotion(1,49)>¡Pero que sepas que solo con el gesto ya me has alegrado<br>el día!"
msgstr "<$voicel(1,3)><$comeff(1,14)><$motion(1,666)>Agradezco el detalle, pero creo que no sabría darle<br>provecho...<clear><br><$voicel(1,8)><$emotion(1,49)>¡Pero que sepas que solo con el gesto ya me alegraste<br>el día!"

#. en: <$voicel(1,7)><$emotion(1,49)>Uhhh... This is ALREADY my house, silly!
msgctxt "1986:439"
msgid "<$voicel(1,7)><$emotion(1,49)>¡Que yo ya vivo aquí, figura! ¡Céntrateee!"
msgstr "<$voicel(1,7)><$emotion(1,49)>¡Que yo ya vivo aquí, crack! ¡Concéntrateee!"

#. en: <$comeff(1,5)><$facial(1,1)><$motion(1,806)><$voicel(1,7)><$pkcry;0(1,4)>! <$cdef(27)><pname;1></color>! Help meee!
msgctxt "1986:442"
msgid "<oneline><$comeff(1,5)><$facial(1,1)><$motion(1,806)><$voicel(1,7)>¡<$pkcry;0(1,4)>! ¡<$cdef(27)><pname;1></color>, crack,<br>leyenda,<slide><br>figura!<slide><br>¡Arréglalo, te lo pido por favooor!"
msgstr "<oneline><$comeff(1,5)><$facial(1,1)><$motion(1,806)><$voicel(1,7)>¡<$pkcry;0(1,4)>! ¡<$cdef(27)><pname;1></color>, crack,<br>leyenda,<slide><br>genio!<slide><br>¡Arréglalo, te lo pido por favooor!"

#. en: <$voicel(1,7)><$emotion(1,27)><$cdef(27)><pname;0></color>! Time is UP, my friend!
msgctxt "1986:443"
msgid "<$voicel(1,7)><$emotion(1,27)>¡<$cdef(27)><pname;0></color>, se acabó el tiempooo!"
msgstr ""

#. en: <oneline><$voicel(1,7)><$comeff(1,4)><$motion(1,805)><$facial(1,13)>I... I can’t BELIEVE we lost! I thought we were the<br>super ultra invincible team!<clear><br><$voicel(1,7)><$emotion(1,49)>You are a LEGEND, <$cdef(27)><pname;0></color>! So here’s<br>a<slide><br>legendary present!
msgctxt "1986:444"
msgid "<oneline><$voicel(1,7)><$comeff(1,4)><$motion(1,805)><$facial(1,13)>No puede ser... ¡Hemos perdido! ¡Y eso que nuestro<br>equipo era superior e invencible!<clear><br><$voicel(1,7)><$emotion(1,49)>¡<$cdef(27)><pname;0></color>, eres una leyenda! ¡Por eso<br>te mereces<slide><br>un premio legendario!"
msgstr "<oneline><$voicel(1,7)><$comeff(1,4)><$motion(1,805)><$facial(1,13)>No puede ser... ¡Perdimos! ¡Y eso que nuestro<br>equipo era superior e invencible!<clear><br><$voicel(1,7)><$emotion(1,49)>¡<$cdef(27)><pname;0></color>, eres una leyenda! ¡Por eso<br>te mereces<slide><br>un premio legendario!"

#. en: <$voicel(1,8)><$emotion(1,38)>Rematch! Rematch! C’mon, wanna play once more?
msgctxt "1986:445"
msgid "<$voicel(1,8)><$emotion(1,38)>¡Vamos a echar la revanchaaa! Venga, ¿te animas?"
msgstr "<$voicel(1,8)><$emotion(1,38)>¡Vamos por la revanchaaa! ¿Qué dices? ¿Te animas?"

#. en: <$voicel(1,7)><$emotion(1,50)>YEAH! There’s no way I’m gonna lose!
msgctxt "1986:446"
msgid "<$voicel(1,7)><$emotion(1,50)>¡Vamos allá! ¡No pienso perder!"
msgstr "<$voicel(1,7)><$emotion(1,50)>¡Vamos! ¡No pienso perder!"

#. en: <$voicel(1,5)><$emotion(1,14)>Oh, OK! Let’s play some other time!
msgctxt "1986:447"
msgid "<$voicel(1,5)><$emotion(1,14)>Jo, qué chasco... ¡Pues nada, otra vez será!"
msgstr "<$voicel(1,5)><$emotion(1,14)>Ay, qué chasco... ¡Pues nada, otra vez será!"

#. en: <$voicel(1,6)><$comeff(1,14)><$motion(1,805)><$facial(1,9)>Hmmm... Sorry, <$cdef(27)><pname;0></color>!<clear><br><$voicel(1,7)><$emotion(1,14)>For whatever reason, this house doesn’t pass the vibe<br>check! I’m gonna pass on this one for now, bestie!
msgctxt "1986:449"
msgid "<$voicel(1,6)><$comeff(1,14)><$motion(1,805)><$facial(1,9)>¡Lo siento, máquina! Esta casa me llama entre cero y nada.<br><$voicel(1,7)><$emotion(1,14)>¿Te importa si me achanto?"
msgstr "<$voicel(1,6)><$comeff(1,14)><$motion(1,805)><$facial(1,9)>¡Lo siento, genio! Esta casa no me llama para nada.<br><$voicel(1,7)><$emotion(1,14)>¿Te importa si paso?"

#. en: <$voicel(1,7)><$emotion(1,14)>OK, I’ll hop right to it! Gimme a bit and then come<br>see me!
msgctxt "1986:452"
msgid "<$voicel(1,7)><$emotion(1,14)>¡Eso está hecho, leyenda! ¡Enseguida me pongo con ello!<br>¡Vuelve a verme en un rato!"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,49)>I’m still workin’ on it! Give me just a little bit longer, OK?
msgctxt "1986:453"
msgid "<$voicel(1,7)><$emotion(1,49)>¡Todavía estoy en ello, fiera! ¡Dame tiempooo!"
msgstr "<$voicel(1,7)><$emotion(1,49)>¡Todavía estoy en ello, crack! ¡Dame tiempooo!"

#. en: <oneline><$voicel(1,9)><$emotion(1,32)>I’ve got the <$cdef(27)><class><reftarid;1></color><br>you<slide><br>asked<slide><br>for, <$cdef(27)><pname;0></color>!
msgctxt "1986:454"
msgid "<$cdef(27)><oneline></color><$voicel(1,9)><$emotion(1,32)>¡Toma, monstru<gen;-2(o,a)>,<br><dart;1()><$cdef(27)><class><reftarid;1></color><slide><br>que tanto querías!"
msgstr "<$cdef(27)><oneline></color><$voicel(1,9)><$emotion(1,32)>¡Toma, amig<gen;-2(o,a)>,<br><dart;1()><$cdef(27)><class><reftarid;1></color><slide><br>que tanto querías!"

#. en: <$voicel(1,3)><$comeff(1,4)><$motion(1,807)><$facial(1,9)>Sorry, bestie! I’ve got my hands full with other stuff<br>right now!
msgctxt "1986:455"
msgid "<$voicel(1,3)><$comeff(1,4)><$motion(1,807)><$facial(1,9)>¡Perdonaaa! ¡Me sabe fatal decirte que no, pero es que<br>me pillas muy liad<gen;-3(o,a)>!"
msgstr "<$voicel(1,3)><$comeff(1,4)><$motion(1,807)><$facial(1,9)>¡Perdonaaa! ¡Me da pena decirte que no, pero es que<br>estoy muy ocupad<gen;-3(o,a)>!"

#. en: <$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>GASP! My home is GONE! <$comeff(1,6)><$facial(1,9)><$voicel(1,9)><$motion(1,802)>Do you know what happened<br>to it, <$cdef(27)><pname;1></color>?!
msgctxt "1986:459"
msgid "<$cdef(27)><$comeff(1,11)></color><$facial(1,13)><$motion(1,803)><$voicel(1,9)>¡Oye, que no está mi casa! ¡Si estaba aquí mismooo!<br><$comeff(1,6)><$facial(1,9)><$voicel(1,9)><$motion(1,802)>¿Tú no sabrás qué ha pasado?"
msgstr "<$cdef(27)><$comeff(1,11)></color><$facial(1,13)><$motion(1,803)><$voicel(1,9)>¡Oye, que no está mi casa! ¡Si estaba aquí mismooo!<br><$comeff(1,6)><$facial(1,9)><$voicel(1,9)><$motion(1,802)>¿Tú no sabrás qué pasó?"

#. en: <$comeff(1,7)><$facial(1,9)><$voicel(1,9)><$motion(1,802)>I can’t believe my home would just...disappear, like, boom!
msgctxt "1986:460"
msgid "<$comeff(1,7)><$facial(1,9)><$voicel(1,9)><$motion(1,802)>¿Pero cómo desaparece una casa de repente?"
msgstr ""

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>Welp, nothing I can do about it now. Guess I’ll start<br>looking for a new home! <$pkcry;0(1,4)>!
msgctxt "1986:461"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>De nada sirve lamentarse. ¡Hala, a buscar dónde vivir!<br>¡<$pkcry;0(1,4)>!"
msgstr "<$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>De nada sirve lamentarse. ¡Vamos, a buscar dónde vivir!<br>¡<$pkcry;0(1,4)>!"

#. en: <oneline><$voicel(1,10)><$comeff(1,10)><$pkcry;0(1,2)>! This place looks SUPER! You made this,<br>right, <$cdef(27)><pname;1></color>?!<clear><br><$motion(1,801)><$facial(1,5)><$comeff(1,13)><$voicel(1,9)>I’m totally gonna start living here! Thanks sooo much!
msgctxt "1986:462"
msgid "<oneline><$cdef(27)><$voicel(1,10)></color><$comeff(1,10)>¡Qué buen sitio, <flow><$pkcry;0(1,2)>! ¿Lo has preparado tú,<br>verdad?<slide><br><$motion(1,801)><$facial(1,5)><$comeff(1,13)><$voicel(1,9)>¡Pues me lo quedo! ¡Gracias, leyenda!"
msgstr "<oneline><$cdef(27)><$voicel(1,10)></color><$comeff(1,10)>¡Qué buen lugar, <flow><$pkcry;0(1,2)>! ¿Lo preparaste tú,<br>verdad?<slide><br><$motion(1,801)><$facial(1,5)><$comeff(1,13)><$voicel(1,9)>¡Pues me lo quedo! ¡Gracias, leyenda!"

#. en: <oneline><$comeff(1,13)><$voicel(1,7)><fcap><iart;1()><fqty(1)><class><$cdef(27)><stfrevp;1></color>? For<br>me?!<slide><br><$pkcry;0(1,2)>!<slide><br><$comeff(1,10)><$facial(1,4)><$voicel(1,10)><$motion(1,801)>Thank<slide><br>you<slide><br>so<slide><br>much,<slide><br>I’ll<slide><br>take<slide><br>a look!
msgctxt "1986:463"
msgid "<oneline><$comeff(1,13)><$voicel(1,7)>¡<$pkcry;0(1,2)>! ¡Me has traído<br><iart;1()><fqty(1)><class><$cdef(27)><stfrevp;1></color>!<slide><br><$comeff(1,10)><$facial(1,4)><$voicel(1,10)><$motion(1,801)>¡Gracias, máquina, te debo una! A ver, a ver."
msgstr "<oneline><$comeff(1,13)><$voicel(1,7)>¡<$pkcry;0(1,2)>! ¡Me trajiste<br><iart;1()><fqty(1)><class><$cdef(27)><stfrevp;1></color>!<slide><br><$comeff(1,10)><$facial(1,4)><$voicel(1,10)><$motion(1,801)>¡Gracias, genio, te debo una! A ver, a ver."

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Whether you look left, right, below, or up ABOVE—<br>living in such a fun house is something I’m gonna LOVE! ♪
msgctxt "1986:464"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Mire donde mire, hay tantas cosas guais por descubrir...<br>¡Tengo una casa que parte la pana!"
msgstr "<$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Mire donde mire, hay tantas cosas lindas por descubrir...<br>¡Tengo una casa de lujo!"

#. en: <oneline><$comeff(1,6)><$facial(1,1)><$motion(1,666)><$voicel(1,6)>HEY! Could I ask you a favor? <$cdef(27)><refpname;0><br></color>asked<slide><br>me<slide><br>for this.<clear><br><$comeff(1,3)><$facial(1,4)><$motion(1,661)><$voicel(1,7)>Would ya do me a solid and deliver it to them?
msgctxt "1986:465"
msgid "<oneline><$facial(1,1)><$motion(1,666)><$voicel(1,6)>Oye, <$comeff(1,6)>¿tienes un segundo? ¿Puedes ir donde<br><$cdef(27)><refpname;0></color><slide><br>y darle esto?<slide><br><$comeff(1,3)><$facial(1,4)><$motion(1,661)><$voicel(1,7)>¡Me harías un favorazo!"
msgstr "<oneline><$facial(1,1)><$motion(1,666)><$voicel(1,6)>Oye, <$comeff(1,6)>¿tienes un segundo? ¿Puedes ir donde<br><$cdef(27)><refpname;0></color><slide><br>y darle esto?<slide><br><$comeff(1,3)><$facial(1,4)><$motion(1,661)><$voicel(1,7)>¡Me harías un gran favor!"

#. en: <$voicel(1,7)><$emotion(1,38)>Oh, hey there! Guess what—it’s quiz-game time! You in?
msgctxt "1986:466"
msgid "<$voicel(1,7)><$emotion(1,38)>¡Qué pasa, máquina! Tengo una pregunta para ti.<br>Venga, anímate."
msgstr "<$voicel(1,7)><$emotion(1,38)>¡Qué tal, genio! Tengo una pregunta para ti.<br>Vamos, anímate."

#. en: <$voicel(1,4)><$emotion(1,14)><$pkcry;0(1,2)>! Then without further ado...<clear><br><$voicel(1,1)><$emotion(1,64)>Between me and <$cdef(27)><sizecmppk;2></color>—whooo’s...taller?!
msgctxt "1986:467"
msgid "<$voicel(1,4)><$emotion(1,14)>¡Pues voy, <flow><$pkcry;0(1,2)>!<clear><br><$voicel(1,1)><$emotion(1,64)>¿Quién crees que mide más, <dart;2()><$cdef(27)><sizecmppk;2> </color>o yo?"
msgstr ""

#. en: <$voicel(1,1)><$emotion(1,14)>Aww, OK. You better play with me next time, though!
msgctxt "1986:468"
msgid "<$voicel(1,1)><$emotion(1,14)>¡Vale, pues ya te pregunto otro día!"
msgstr "<$voicel(1,1)><$emotion(1,14)>¡Bueno, pues ya te pregunto otro día!"

#. en: <oneline>...<wait(0.4)><$voicel(1,5)><$emotion(1,40)>Ding-ding-ding! You got it!<clear><br><$voicel(1,9)><$emotion(1,8)>I knew our keen-eyed <$cdef(27)><pname;0></color> would get<br>it right!
msgctxt "1986:469"
msgid "<oneline>... <wait(0.4)><$voicel(1,5)><$emotion(1,40)>¡Coooorrectísimo! <$voicel(1,9)><$emotion(1,8)>¡Muy buena,<br><$cdef(27)><pname;0></color>!<slide><br>¡Qué ojo tienes!"
msgstr ""

#. en: ...<wait(0.4)><$voicel(1,7)><$comeff(1,3)>Bzzzt. Nope, that’s not it!<clear><br><$voicel(1,5)><$emotion(1,49)>But I bet you’ll get it next time!
msgctxt "1986:470"
msgid "... <wait(0.4)><$voicel(1,7)><$comeff(1,3)>¡Ay, qué penaaa! ¡Era la otraaa!<br><$voicel(1,5)><$emotion(1,49)>La próxima vez tendrás más suerte, ya verás."
msgstr ""

#. en: <$comeff(1,5)><$voicel(1,9)><$facial(1,13)><$motion(1,803)>Huh? Are you sure it’s OK? Cool! Yeah, starting now, this’ll<br>be my new home! <$comeff(1,21)><$voicel(1,10)><$facial(1,5)><$motion(1,801)>Thank you, <$cdef(27)><pname;0></color>!
msgctxt "1986:471"
msgid "<$comeff(1,5)><$voicel(1,9)><$facial(1,13)><$motion(1,803)>¿De verdad puedo quedarme a vivir aquí? ¡Pues vale!<br><$comeff(1,21)><$voicel(1,10)><$facial(1,5)><$motion(1,801)>Me has salvao, <$cdef(27)><pname;0></color>."
msgstr "<$comeff(1,5)><$voicel(1,9)><$facial(1,13)><$motion(1,803)>¿De verdad puedo quedarme a vivir aquí? ¡Pues genial!<br><$comeff(1,21)><$voicel(1,10)><$facial(1,5)><$motion(1,801)>Me salvaste, <$cdef(27)><pname;0></color>."

#. en: <oneline><$voicel(1,7)><$emotion(1,27)><$facial(1,4)>Nice to meet—wait, you’re <$cdef(27)><pname;0></color>!<br><$voicel(1,6)><$emotion(1,49)>I knew<slide><br>you<slide><br>were<slide><br>good at<slide><br>using<slide><br><$cdef(27)><fcap><$spwfull(36)></color>,<slide><br>but WOW!
msgctxt "1986:472"
msgid "<oneline><$voicel(1,7)><$emotion(1,27)><$facial(1,4)>Hola, mucho gus... ¡Uy, si eres <$cdef(27)><pname;0></color>!<br><$voicel(1,6)><$emotion(1,49)>Jaaa.<slide><br>Claro, vas <$cdef(27)>transformad<gen;-2(o,a)></color><nbs2><$spwicon(36)>. ¡Qué crack!"
msgstr ""

#. en: <$voicel(1,7)><$comeff(1,5)><$motion(1,805)>WAIT A SEC! We do NOT have enough space to play! You<br>gotta make us some, <$voicel(1,7)><$emotion(1,14)><$cdef(27)><pname;0></color>!
msgctxt "1986:476"
msgid "<oneline><$voicel(1,7)><$comeff(1,5)><$motion(1,805)>Eh, ¡aquí no tenemos suficiente sitio para jugar!<clear><br><$voicel(1,7)><$emotion(1,14)>¿Podrías hacer algo de espacio,<br><$cdef(27)><pname;0></color>?"
msgstr "<oneline><$voicel(1,7)><$comeff(1,5)><$motion(1,805)>Eh, ¡aquí no tenemos suficiente lugar para jugar!<clear><br><$voicel(1,7)><$emotion(1,14)>¿Podrías hacer algo de espacio,<br><$cdef(27)><pname;0></color>?"

#. en: <$voicel(1,5)><$emotion(1,47)>Hmmm... Sorry! It’s not for me! I bet someone would like<br>it here, it’s just that other types of homes are more my jam!
msgctxt "1986:477"
msgid "<$voicel(1,5)><$emotion(1,47)>Este no parece el sitio adecuado para mí, no sé...<br>¡Creo que preferiría buscar otro lugar!"
msgstr "<$voicel(1,5)><$emotion(1,47)>Este no parece el lugar adecuado para mí, no sé...<br>¡Creo que preferiría buscar en otra parte!"

#. en: <$voicel(1,8)><$emotion(1,1)>For me? Really?!<clear><br><$voicel(1,3)><$emotion(1,13)>Oh, but...I’m so full right now. There’s no way I could<br>eat any more. <$voicel(1,8)><$emotion(1,49)>You go ahead and eat that yourself,<slide><br><$cdef(27)><pname;1></color>!
msgctxt "1986:478"
msgid "<$cdef(27)><$voicel(1,8)></color><$emotion(1,1)>¿Para mí? <$voicel(1,3)><$emotion(1,13)>Guau, te lo agradezco, pero es que estoy<br>bastante llen<gen;-3(o,a)>. <$voicel(1,8)><$emotion(1,49)>Quédatelo tú, tranqui."
msgstr ""

#. en: <$voicel(1,6)><$emotion(1,29)>Where should I move?!
msgctxt "1986:481"
msgid "<$voicel(1,6)><$emotion(1,29)>¡¿Dónde, dónde?!"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,14)>For real?! Is this SERIOUSLY my new home?
msgctxt "1986:482"
msgid "<$voicel(1,7)><$emotion(1,14)>¿Esa es mi nueva casaaa? ¡¡No me digas!!"
msgstr ""

#. en: <$voicel(1,4)><$emotion(1,14)><$pkcry;0(1,2)>! Then without further ado...<clear><br><$voicel(1,1)><$emotion(1,64)>Between me and <$cdef(27)><weightcmppk;2></color>—whooo’s heavier?!
msgctxt "1986:484"
msgid "<$voicel(1,4)><$emotion(1,14)>¡Vamooos! ¡Allá va, <flow><$pkcry;0(1,2)>!<clear><br><$voicel(1,1)><$emotion(1,64)>¿Quién crees que pesa más, <$cdef(27)><weightcmppk;2></color> o yo?"
msgstr ""

#. en: <$comeff(1,6)><$motion(1,827)><$voicel(1,8)>Ooh! That caught your eye, huh?
msgctxt "1986:489"
msgid "<$motion(1,827)><$voicel(1,8)>¡Qué pasa, figura! <$comeff(1,6)>¿Te mola eso?"
msgstr "<$motion(1,827)><$voicel(1,8)>¡Qué tal, crack! <$comeff(1,6)>¿Te gusta eso?"

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Yippee! So, what’ll you trade me for it?
msgctxt "1986:490"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Vale, ¿y tú qué me ofreces?"
msgstr "<$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Bueno, ¿y tú qué me ofreces?"

#. en: <$facial(1,4)><$comeff(1,1)><$voicel(1,7)>Aww, OK. Well, lemme know if you change your mind!
msgctxt "1986:491"
msgid "<$facial(1,4)><$comeff(1,1)><$voicel(1,7)>Jaaa, ja, ja, qué cosas tienes. Nada, pues ya me dirás."
msgstr ""

#. en: <$comeff(1,10)><$motion(1,801)><$voicel(1,10)><$facial(1,5)>Yaaay! Thank you!
msgctxt "1986:492"
msgid "<$comeff(1,10)><$motion(1,801)><$voicel(1,10)><$facial(1,5)>¡Gracias, máquina!"
msgstr "<$comeff(1,10)><$motion(1,801)><$voicel(1,10)><$facial(1,5)>¡Gracias, genio!"

#. en: <$comeff(1,1)><$voicel(1,7)><$facial(1,4)>Huh? You don’t wanna trade after all? Well, lemme know<br>if you change your mind!
msgctxt "1986:493"
msgid "<$comeff(1,1)><$voicel(1,7)><$facial(1,4)>Oh, ¿ya no te interesa? Cómo me mareas. Jaaa, ja, ja."
msgstr ""

#. en: <$comeff(1,10)><$motion(1,801)><$voicel(1,10)><$facial(1,5)>Yaaay! Thank you!<clear><br><$comeff(1,13)><$voicel(1,9)><$motion(1,803)>Welp, that’s the last of what I’ve got today! I’ll bring a<br>buncha different stuff next time for sure!
msgctxt "1986:494"
msgid "<$comeff(1,10)><$motion(1,801)><$voicel(1,10)><$facial(1,5)>¡Guau, gracias! <$comeff(1,13)><$voicel(1,9)><$motion(1,803)>Ya no tengo nada más que ofrecer.<br>Otro día <$cdef(27)>negociamos<nbs2><$spwicon(12)> </color>otro poco."
msgstr ""

#. en: <$comeff(1,10)><$motion(1,801)><$facial(1,4)><$voicel(1,9)>Hey, just so you know, I’m about to go use<br>the<$cdef(27)> <fqty(1)><$ifull(1325)></color>!
msgctxt "1986:495"
msgid "<$comeff(1,10)><$motion(1,801)><$facial(1,4)><$voicel(1,9)>¿Qué pasa, crack? ¡Voy derech<gen;-3(o,a)> a la <$cdef(27)><fqty(1)><$ifull(1325)></color>!"
msgstr "<$comeff(1,10)><$motion(1,801)><$facial(1,4)><$voicel(1,9)>¿Qué tal, crack? ¡Voy derech<gen;-3(o,a)> a la <$cdef(27)><fqty(1)><$ifull(1325)></color>!"

#. en: <$comeff(1,13)><$facial(1,5)><$motion(1,803)><$voicel(1,7)>Aw, sorry! All the stuff I brought today is already sold out!
msgctxt "1986:496"
msgid "<$comeff(1,13)><$facial(1,5)><$motion(1,803)><$voicel(1,7)>¡Cero, cerito, cero! Eso es lo que me queda hoy."
msgstr ""

#. en: <$voicel(1,10)><$motion(1,801)><$comeff(1,13)><$facial(1,5)><$pkcry;0(1,2)>! I think I kinda need this!
msgctxt "1986:497"
msgid "<$voicel(1,10)><$motion(1,801)><$comeff(1,13)><$facial(1,5)>¡<$pkcry;0(1,2)>, quiero estooo!"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,8)><$pkcry;0(1,2)>! ♪ For real?! I can’t wait to chow down!
msgctxt "1986:500"
msgid "<$voicel(1,7)><$emotion(1,8)>Qué diceees, ¿en serio es para mí? ♪¡<$pkcry;0(1,2)>!♪<br>¡En dos segundos me lo ventilo!"
msgstr "<$voicel(1,7)><$emotion(1,8)>Qué diceees, ¿en serio es para mí? ♪¡<$pkcry;0(1,2)>!♪<br>¡En dos segundos me lo devoro!"

#. en: <$voicel(1,3)><$comeff(1,6)><$motion(1,666)>Now, what should I have for breakfast today? You got any<br>recommendations, <$cdef(27)><pname;0></color>?<clear><br><$voicel(1,5)><$comeff(1,14)>I always just end up eating the same ol’ faves! <$voicel(1,8)><$emotion(1,49)>So let ME<br>know if YOU know where to find something tasty to eat!
msgctxt "1986:501"
msgid "<$voicel(1,3)><$comeff(1,6)><$motion(1,666)>No sé qué desayunar hoy... ¿Tú qué me recomiendas,<br><$cdef(27)><pname;0></color>?<clear><br><$voicel(1,5)><$comeff(1,14)>Es que suelo comer solo cosas que ya sé que me gustan,<br>y no varío mucho...<clear><br><$voicel(1,8)><$emotion(1,49)>¡Si se te ocurre algo rico que pueda probar, dímelo!"
msgstr ""

#. en: <$voicel(1,7)><$comeff(1,5)><$motion(1,806)><$facial(1,4)>HECK YEAH! The sun is shining today!<clear><br><$voicel(1,5)>It’s almost like it’s giving me SOLAR POWER—enough to<br>carry extra-heavy stuff!<$voicel(1,8)><$emotion(1,8)> Let me know if you need<slide><br>the ol’ heave-ho!
msgctxt "1986:502"
msgid "<$voicel(1,7)><$comeff(1,5)><$motion(1,806)><$facial(1,4)>¡Hoy el sol brilla tope de fuerteee!<clear><br><$voicel(1,5)>¡Me siento en plan como si me diera fuerza a mí también!<br><$voicel(1,8)><$emotion(1,8)>¡Como que podría levantar más peso que de costumbre!"
msgstr "<$voicel(1,7)><$comeff(1,5)><$motion(1,806)><$facial(1,4)>¡Hoy el sol brilla súper fuerteee!<clear><br><$voicel(1,5)>¡Siento como si me diera fuerza a mí también!<br><$voicel(1,8)><$emotion(1,8)>¡Como que podría levantar más peso que de costumbre!"

#. en: <$voicel(1,5)><$comeff(1,3)><$motion(1,805)>When I look at the sunset, I just wanna shout at the top of<br>my lungs!<clear><br><$voicel(1,7)><$emotion(1,27)>Like, “I TOTALLY CRUSHED IT TODAY!” or “I’M GONNA<br>MAKE SURE TOMORROW IS GOOD TOO!” or...<slide><br><$voicel(1,8)><$comeff(1,14)><$motion(1,807)>“I REALLY HATE DOING CHORES!”
msgctxt "1986:503"
msgid "<$voicel(1,5)><$comeff(1,3)><$motion(1,805)>¡Cuando miro el atardecer, me entran ganas de pegar<br>un grito al cielo!<clear><br>Algo en plan: <$voicel(1,7)><$emotion(1,27)>\"¡Hoy lo he dado todooo!\" o \"¡Mañana va<br>a ser un día increíbleee!\"...<clear><br><$voicel(1,8)><$comeff(1,14)><$motion(1,807)>O quizá: \"¡Limpiar es un rollazooo!\"."
msgstr "<$voicel(1,5)><$comeff(1,3)><$motion(1,805)>¡Cuando miro el atardecer, me entran ganas de pegar<br>un grito al cielo!<clear><br>Algo así como: <$voicel(1,7)><$emotion(1,27)>\"¡Hoy lo di todooo!\" o \"¡Mañana va<br>a ser un día increíbleee!\"...<clear><br><$voicel(1,8)><$comeff(1,14)><$motion(1,807)>O quizás: \"¡Limpiar es un fastidiooo!\"."

#. en: <$voicel(1,8)><$comeff(1,21)><$motion(1,661)><$facial(1,5)>The stars are SOOO pretty!<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,805)><$facial(1,1)>OK, there are SO many stars that—hear me out—<$voicel(1,7)><$emotion(1,29)>what if<br>some of them are Pokémon PRETENDING to be stars?!
msgctxt "1986:504"
msgid "<$voicel(1,8)><$comeff(1,21)><$motion(1,661)><$facial(1,5)>¡Qué chulas son las estrellas!<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,805)><$facial(1,1)>Como hay tantas, a veces pienso cosas en plan: \"¿Y si<br>algunas son Pokémon haciendo como que son estrellas?\"<slide><br><$voicel(1,7)><$emotion(1,29)>¿Tú nunca lo has pensado, figura?"
msgstr "<$voicel(1,8)><$comeff(1,21)><$motion(1,661)><$facial(1,5)>¡Qué bonitas son las estrellas!<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,805)><$facial(1,1)>Como hay tantas, a veces pienso cosas como: \"¿Y si<br>algunas son Pokémon haciendo como que son estrellas?\"<slide><br><$voicel(1,7)><$emotion(1,29)>¿Tú nunca lo has pensado, crack?"

#. en: <oneline><$voicel(1,7)><$emotion(1,14)><$cdef(27)><pname;0></color>! You’re always gathering sticks<br>and<slide><br>stones<slide><br>’n’<slide><br>stuff, huh?<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,666)>I guess you must find some super-awesome sticks or<br>cool <$voicel(1,4)><$emotion(1,29)>rocks or whatever sometimes, right?
msgctxt "1986:507"
msgid "<oneline><$voicel(1,7)><$emotion(1,14)><$cdef(27)><pname;0></color>, tú sueles recoger ramas,<br>piedras<slide><br>y esas cosas, ¿verdad?<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Alguna vez te habrás encontrado alguna rama muy guapa<br>o una piedra con forma graciosa, ¿no?<clear><br><$voicel(1,4)><$emotion(1,29)>¡Dime que sí!"
msgstr "<oneline><$voicel(1,7)><$emotion(1,14)><$cdef(27)><pname;0></color>, tú sueles recoger ramas,<br>piedras<slide><br>y esas cosas, ¿verdad?<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,666)>Alguna vez te habrás encontrado alguna rama muy bonita<br>o una piedra con forma graciosa, ¿no?<clear><br><$voicel(1,4)><$emotion(1,29)>¡Dime que sí!"

#. en: <$voicel(1,5)><$comeff(1,10)><$motion(1,806)>Ugh, doing nothing makes me feel so restless!<clear><br><$voicel(1,7)><$emotion(1,8)>Lemme know if I can help ya with anything!
msgctxt "1986:508"
msgid "<$voicel(1,5)><$comeff(1,10)><$motion(1,806)>Cuando estoy sin hacer nada, me siento como intranquil<gen;-3(o,a)>.<br><$voicel(1,7)><$emotion(1,8)>Así que si te puedo ayudar en algo, lo que sea, ¡tú pídelo!"
msgstr ""

#. en: <$voicel(1,5)><$emotion(1,14)>When you see veggies growing in the fields...<clear><br><$voicel(1,3)><$comeff(1,6)><$motion(1,666)>Do you ever think “AHH! I wanna eat them NOW!” even if<br>they aren’t big enough to eat yet?
msgctxt "1986:509"
msgid "<$voicel(1,5)><$emotion(1,14)>Oye, leyenda, cuando tienes verdura plantada en tu<br>huerto y estás esperando a que crezca del todo...<slide><br><$voicel(1,3)><$comeff(1,6)><$motion(1,666)>¿no te pasa que piensas: \"¡Qué hambre, me la quiero<slide><br>comer yaaa!\"?"
msgstr ""

#. en: <$voicel(1,6)><$emotion(1,14)>OK, guess I’ll turn in for today!<clear><br><$voicel(1,7)><$emotion(1,8)>I had a blast! Looking forward to next time!
msgctxt "1986:516"
msgid "<$voicel(1,6)><$emotion(1,14)>Tú mandas, fiera. ¡Cierro el chiringuito por hoy!<clear><br><$voicel(1,7)><$emotion(1,8)>¡Qué corto se me ha hecho el día! Estoy deseando repetir."
msgstr "<$voicel(1,6)><$emotion(1,14)>Tú mandas, crack. ¡Cierro el negocio por hoy!<clear><br><$voicel(1,7)><$emotion(1,8)>¡Qué corto se me hizo el día! Estoy deseando repetir."

#. en: <oneline><$voicel(1,7)><$emotion(1,49)><$cdef(27)><pname;0></color>! Heyooo! Wanna <$cdef(27)><$spwfull(12)><br></color>somethin’<slide><br>with me?
msgctxt "1986:517"
msgid "<oneline><$voicel(1,7)><$emotion(1,49)>¡Buenas, <$cdef(27)><pname;0></color>! ¿Quieres <$cdef(27)><$spwfull(12)><br></color>conmigo?"
msgstr ""

#. en: <$voicel(1,5)><$emotion(1,49)>Heyyy! <$cdef(27)><shoppk;0> </color>is at the<$cdef(27)> <fqty(1)><$ifull(1325)></color><br>RIGHT now!
msgctxt "1986:518"
msgid "<$cdef(27)><oneline><$voicel(1,5)><$emotion(1,49)></color>¡Oyeee, que está <dart;0()><$cdef(27)><shoppk;0></color> donde<br>la <$cdef(27)><fqty(1)><$ifull(1325)></color>!"
msgstr ""

#. en: <$emotion(1,49)><$voicel(1,5)>Back when humans were around, I would see these big,<br>er...THINGS up above me... <wait(0.3)><$comeff(1,6)><$facial(1,1)><$voicel(1,4)>What even WERE those?
msgctxt "1986:520"
msgid "<$emotion(1,49)><$voicel(1,5)>Me estoy acordando de unas enormes moles que flotaban<br>por la superficie cuando los humanos todavía vivían aquí...<clear><br><$comeff(1,6)><$facial(1,1)><$voicel(1,4)>¿Para qué necesitarían subirse a esas cosas tan grandes?"
msgstr ""

#. en: <oneline><$voicel(1,7)><$emotion(1,49)><$cdef(27)><pname;0></color>! You’re really crushing it out<br>there<slide><br>with<slide><br>the<slide><br>watering, huh?<clear><br><$voicel(1,6)><$emotion(1,8)>I can tell—this place is lookin’ great! Thanks a bunch!
msgctxt "1986:521"
msgid "<$voicel(1,7)><$emotion(1,49)>¡Cómo se nota que le has estado dando a la regadera,<br>crack!<clear><br><$voicel(1,6)><$emotion(1,8)>Has dejado esto que da gusto. ¡Se agradece!"
msgstr "<$voicel(1,7)><$emotion(1,49)>¡Cómo se nota que le has estado dando a la regadera,<br>crack!<clear><br><$voicel(1,6)><$emotion(1,8)>Dejaste esto que da gusto. ¡Se agradece!"

#. en: <$voicel(1,7)><$emotion(1,49)><$pkcry;0(1,1)>! I picked this up for ya!
msgctxt "1986:522"
msgid "<$voicel(1,7)><$emotion(1,49)>¡<$pkcry;0(1,1)>! ¡Toma, para ti!"
msgstr ""

#. en: <oneline><$voicel(1,7)><$emotion(1,38)>Y’know, me and <$cdef(27)><nlpairpk;0> </color>get along really well!<clear><br><$voicel(1,5)><$comeff(1,9)><$motion(1,661)>Now we just add a little dash of <$cdef(27)><pname;2></color><br>and<slide><br>the<slide><br>SUPER<slide><br>BESTIE<slide><br>SQUAD<slide><br>will<slide><br>be complete!
msgctxt "1986:523"
msgid "<$voicel(1,7)><$emotion(1,38)>¡Me estoy llevando genial con <dart;0()><$cdef(27)><nlpairpk;0></color>!<clear><br><$voicel(1,5)><$comeff(1,9)><$motion(1,661)>¡Y si te incluimos también a ti, fiera, no hay mejor grupo<br>de colegas!"
msgstr "<$voicel(1,7)><$emotion(1,38)>¡Me estoy llevando genial con <dart;0()><$cdef(27)><nlpairpk;0></color>!<clear><br><$voicel(1,5)><$comeff(1,9)><$motion(1,661)>¡Y si te incluimos también a ti, crack, no hay mejor grupo<br>de amigos!"

#. en: <oneline><$voicel(1,9)><$emotion(1,1)>Oh yeah! Thanks SOOO much for <qty;0(that,those)><br><fqty(1)><class><$cdef(27)><nlqueitem;0></color><slide><br>earlier!<clear><br><$voicel(1,7)><$comeff(1,8)><$motion(1,661)>Now <qty;0(it’s,they’re)> my favorite thing in the whole wide world!
msgctxt "1986:524"
msgid "<oneline><$voicel(1,9)><$emotion(1,1)>¡Por ciertooo, gracias por<br><dart;0()><fqty(1)><class><$cdef(27)><nlqueitem;0></color>!<clear><br><$voicel(1,7)><$comeff(1,8)><$motion(1,661)>¡No sabes la ilusión que me <qty;0(hizo,hicieron)>!"
msgstr "<oneline><$voicel(1,9)><$emotion(1,1)>¡Por ciertooo, gracias por<br><dart;0()><fqty(1)><class><$cdef(27)><nlqueitem;0></color>!<clear><br><$voicel(1,7)><$comeff(1,8)><$motion(1,661)>¡No sabes lo feliz que me <qty;0(hizo,hicieron)>!"

#. en: <oneline><$voicel(1,7)><$emotion(1,14)>Hey, <$cdef(27)><pname;0></color>!<$voicel(1,6)><$comeff(1,6)> Is it true that you can<br>build<slide><br>houses<slide><br>like<slide><br>the<slide><br>ones<slide><br>the<slide><br>humans had?!<clear><br><$voicel(1,7)><$emotion(1,39)>AWESOME! Ahhh, gosh! I’d really love to get the chance<br>to live in a house you made!
msgctxt "1986:525"
msgid "<$voicel(1,7)><$emotion(1,14)>Oye, <$cdef(27)><pname;0></color>...<clear><br><$voicel(1,6)><$comeff(1,6)>¿Es verdad eso de que vas por ahí construyendo casas<br>como las de los humanos?<clear><br><$voicel(1,7)><$emotion(1,39)>¡Qué guapo! Me fliparía dormir en una casa así hecha<br>por ti, aunque sea solo una vez."
msgstr "<$voicel(1,7)><$emotion(1,14)>Oye, <$cdef(27)><pname;0></color>...<clear><br><$voicel(1,6)><$comeff(1,6)>¿Es verdad eso de que vas por ahí construyendo casas<br>como las de los humanos?<clear><br><$voicel(1,7)><$emotion(1,39)>¡Genial! Me encantaría dormir en una casa así hecha<br>por ti, aunque sea solo una vez."

#. en: <$voicel(1,5)><$emotion(1,14)>Y’know, I never noticed before, but the sun is ALWAYS<br>round, right?<clear><br><$voicel(1,3)><$comeff(1,6)><$motion(1,666)>But why?! The MOON has lotsa different shapes! It’s such<br>a mystery...
msgctxt "1986:526"
msgid "<$voicel(1,5)><$emotion(1,14)>No lo había pensado nunca, pero... el sol siempre se ve<br>redondo, ¿verdad que sí?<clear><br><$voicel(1,3)><$motion(1,666)>Pero la luna sale con una forma distinta según la noche.<br><$comeff(1,6)>¿Por qué será? Me tiene intrigad<gen;-3(o,a)>..."
msgstr ""

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>When the sun comes up, I’m always like, “WHOA, total<br>morning vibes!” Y’know what I mean?<clear><br><$comeff(1,16)><$facial(1,14)><$motion(1,807)><$voicel(1,5)>I’ve gotta head to sleep soon, though!
msgctxt "1986:527"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>Cuando asoma el sol, ¡sabes que se va a hacer de día!<br><$comeff(1,16)><$facial(1,14)><$motion(1,807)><$voicel(1,5)>Y eso significa que ya me va tocando irme a dormir..."
msgstr ""

#. en: <$voicel(1,8)><$comeff(1,5)><$motion(1,806)>BEHOLD—MY WINGS!<clear><br><$voicel(1,5)><$emotion(1,49)>Sure, they’re pretty on the outside, but the inside is<br>gorgeous too!<clear><br><$voicel(1,8)><$emotion(1,8)>I just wanna keep ’em fancy—even if nobody else can see!
msgctxt "1986:528"
msgid "<$voicel(1,8)><$comeff(1,5)><$motion(1,806)>Qué, ¿te impresionan mis alas?<clear><br><$voicel(1,5)><$emotion(1,49)>¡Pues si crees que están guapas por fuera, espera a verlas<br>por dentro!<clear><br><$voicel(1,8)><$emotion(1,8)>Hay que ir con estilo por dentro y por fuera, ¡se vea o no!"
msgstr "<$voicel(1,8)><$comeff(1,5)><$motion(1,806)>Qué, ¿te impresionan mis alas?<clear><br><$voicel(1,5)><$emotion(1,49)>¡Pues si crees que están bonitas por fuera, espera a verlas<br>por dentro!<clear><br><$voicel(1,8)><$emotion(1,8)>Hay que ir con estilo por dentro y por fuera, ¡se vea o no!"

#. en: <$emotion(1,29)><$voicel(1,5)>They say your body’ll get stiff if you stay in the same pose<br>all the time, so <$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,8)>every once in a while, I’ve gotta streeetch!<clear><br><$emotion(1,38)><$voicel(1,9)>Welp... Not like I’ve ever been flexible anyway!
msgctxt "1986:529"
msgid "<$emotion(1,29)><$voicel(1,5)>¿No se te queda el cuerpo como rígido después de estar<br>en la misma posición durante mucho tiempo?<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,8)>Por eso hay que estirarse de vez en cuando.<wait(1.0)><$emotion(1,38)><$voicel(1,9)> Bueno, en mi<br>caso da igual, ¡que soy más rígido que una piedra, jaaa!"
msgstr ""

#. en: <oneline><$voicel(1,5)><$emotion(1,14)><$cdef(27)><pname;0></color>! You ever wanna throw a<br>bedtime<slide><br>cuddle<slide><br>party together?!<clear><br><$voicel(1,7)><$emotion(1,8)>I’m the softest, squishiest Pokémon around, so you’re<br>bound to have the best sleep of your life! Promise!
msgctxt "1986:531"
msgid "<oneline><$voicel(1,5)><$emotion(1,14)>Oye, <$cdef(27)><pname;0></color>, cuando te entre sueño,<br>¿qué tal si me usas<slide><br>de almohada?<clear><br><$voicel(1,7)><$emotion(1,8)>¡Como soy muy blandit<gen;-3(o,a)>, seguro que hasta descansas<br>mejor, máquina!"
msgstr "<oneline><$voicel(1,5)><$emotion(1,14)>Oye, <$cdef(27)><pname;0></color>, cuando te entre sueño,<br>¿qué tal si me usas<slide><br>de almohada?<clear><br><$voicel(1,7)><$emotion(1,8)>¡Como soy muy blandit<gen;-3(o,a)>, seguro que hasta descansas<br>mejor, genio!"

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,661)><$voicel(1,8)>I might be little, but I’ve got a BIG appetite, y’know!<clear><br><$comeff(1,10)><$facial(1,1)><$motion(1,806)><$voicel(1,7)>Not even the bigger Pokémon can compete with me!
msgctxt "1986:533"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,661)><$voicel(1,8)>Aunque parezca tan canij<gen;-3(o,a)>, ¡zampo que da gustooo!<br><$comeff(1,10)><$facial(1,1)><$motion(1,806)><$voicel(1,7)>¡No pienso perder contra los más grandullones, jaaa, ja, ja!"
msgstr "<$comeff(1,9)><$facial(1,4)><$motion(1,661)><$voicel(1,8)>Aunque parezca tan chiquit<gen;-3(o,a)>, ¡devoro que da gustooo!<br><$comeff(1,10)><$facial(1,1)><$motion(1,806)><$voicel(1,7)>¡No pienso perder contra los más grandotes, jaaa, ja, ja!"

#. en: <$voicel(1,5)><$emotion(1,14)>I always get found RIGHT AWAY during hide-and-seek<br>cause I’m so big...<clear><br><$voicel(1,7)><$comeff(1,9)><$motion(1,806)>But I’m also perfect for hiding BEHIND, so I always get<br>invited to play!
msgctxt "1986:534"
msgid "<$voicel(1,5)><$emotion(1,14)>Como soy tan grande, cuando juego al escondite me<br>encuentran enseguidaaa...<clear><br><$voicel(1,7)><$comeff(1,9)><$motion(1,806)>Pero los demás Pokémon me invitan a menudo a jugar,<br>¡para esconderse detrás de mí!"
msgstr "<$voicel(1,5)><$emotion(1,14)>Como soy tan grande, cuando juego a las escondidas me<br>encuentran enseguidaaa...<clear><br><$voicel(1,7)><$comeff(1,9)><$motion(1,806)>Pero los demás Pokémon me invitan a menudo a jugar,<br>¡para esconderse detrás de mí!"

#. en: <$comeff(1,3)><$motion(1,803)><$voicel(1,7)>You know when the sky gets cloudy, and you wonder<br>whether it’s gonna rain or not? <$comeff(1,14)><$motion(1,805)><$voicel(1,6)>It kinda puts me on edge.<clear><br><$emotion(1,37)><$voicel(1,7)>I’d honestly rather it just start pouring! At least that way,<br>I know for sure to go back inside!
msgctxt "1986:535"
msgid "<$comeff(1,3)><$motion(1,803)><$voicel(1,7)>Cuando está nublado, no se sabe si lloverá o no.<br><$comeff(1,14)><$motion(1,805)><$voicel(1,6)>Me pone de los nervios que el tiempo me maree así...<clear><br><$emotion(1,37)><$voicel(1,7)>¡Casi prefiero que se ponga a diluviar en cuanto asoman<br>las nubes, que así no me da tiempo a hacerme ilusiones!"
msgstr ""

#. en: <$voicel(1,5)><$emotion(1,14)>HEY! Wouldn’t it be sick if you could shoot your<br><$cdef(27)><$sklfull(3)> </color>straight up into the air?!<clear><br><$voicel(1,3)><$comeff(1,6)><$motion(1,666)>It’d be just like a fountain! Wouldn’t that be a blast?
msgctxt "1986:536"
msgid "<$voicel(1,5)><$emotion(1,14)>Si usaras <$cdef(27)><$sklfull(3)></color> apuntando hacia el cielo,<br>sería como si fueras una fuente. <$voicel(1,3)><$comeff(1,6)><$motion(1,666)>¿A que estaría guapo?"
msgstr "<$voicel(1,5)><$emotion(1,14)>Si usaras <$cdef(27)><$sklfull(3)></color> apuntando hacia el cielo,<br>sería como si fueras una fuente. <$voicel(1,3)><$comeff(1,6)><$motion(1,666)>¿No estaría genial?"

#. en: <$voicel(1,7)><$emotion(1,14)>Any time I see a big flower bud, I always subconsciously<br>cheer it on like, “you can do it little buddy!”<clear><br><$voicel(1,5)><$comeff(1,8)><$facial(1,4)><$motion(1,806)>“Just keep on growing big and strong so you can bloom all<br>safe and healthy!” ...Or something. Hehehe.
msgctxt "1986:537"
msgid "<$voicel(1,7)><$emotion(1,14)>Cuando veo que está brotando un capullo, me dan ganas<br>de animarlo, ¡como si me oyera!<clear><br><$voicel(1,5)><$comeff(1,8)><$facial(1,4)><$motion(1,806)>En plan: \"¡Sigue asíii! ¡Vas a ser una flor preciosaaa!\"<br>o \"¡Daleee! ¡Hermosaaa! ¡Reinotaaa!\"."
msgstr "<$voicel(1,7)><$emotion(1,14)>Cuando veo que está brotando un capullo, me dan ganas<br>de animarlo, ¡como si me oyera!<clear><br><$voicel(1,5)><$comeff(1,8)><$facial(1,4)><$motion(1,806)>Como: \"¡Sigue asíii! ¡Vas a ser una flor preciosaaa!\"<br>o \"¡Daleee! ¡Hermosaaa! ¡Reinaaa!\"."

#. en: <$voicel(1,7)><$comeff(1,21)><$motion(1,806)><$facial(1,4)>Aaah! I’ve got a ton of electricity stored up—it’s just the<br>greatest feeling!<clear><br><$voicel(1,5)><$emotion(1,38)>Now hooow should I discharge the shock today? Guess I<br>should do the ol’ run-and-jolt...
msgctxt "1986:538"
msgid "<$voicel(1,7)><$comeff(1,21)><$motion(1,806)><$facial(1,4)>¡Qué gustooo! ¡Me encanta sentir el cosquilleo de la<br>electricidad por el cuerpo!<clear><br><$voicel(1,5)><$emotion(1,38)>¿En qué puedo usar tanta energía? A ver, a veeer...<br>¡Creo que voy a ir a pegarme una carrera!"
msgstr "<$voicel(1,7)><$comeff(1,21)><$motion(1,806)><$facial(1,4)>¡Qué gustooo! ¡Me encanta sentir el cosquilleo de la<br>electricidad por el cuerpo!<clear><br><$voicel(1,5)><$emotion(1,38)>¿En qué puedo usar tanta energía? A ver, a veeer...<br>¡Creo que voy a ir a correr un rato!"

#. en: <oneline><$voicel(1,7)><$emotion(1,14)><$cdef(27)><pname;0></color>! Ready for me to divine your<br>lucky<slide><br>Pokémon<slide><br>of<slide><br>the day?!<clear><br><$comeff(1,14)><$facial(1,14)>... ... ...<clear><br><$voicel(1,9)><$emotion(1,40)><$facial(1,4)>Wha—?! Your lucky Pokémon for today is ME! ♪<br><$voicel(1,8)><$emotion(1,8)>Hehehe, now you’re SURE to have a great day!
msgctxt "1986:539"
msgid "<$voicel(1,7)><$emotion(1,14)>¡Ey, <$cdef(27)><pname;0></color>!<clear><br>¿Quieres que te adivine si algún encuentro te traerá<br>buena suerte hoy?<clear><br><$comeff(1,14)><$facial(1,14)>Hm... Hmm... Hmmm...<clear><br><$voicel(1,9)><$emotion(1,40)><$facial(1,4)>¿Eh? ¡Anda! ¡Fíjate si estás de suerte! Resulta que hablar<br>conmigo hoy te traerá buena suerte.<clear><br><$voicel(1,8)><$emotion(1,8)>¡Que pases un día de lujooo!"
msgstr "<$voicel(1,7)><$emotion(1,14)>¡Ey, <$cdef(27)><pname;0></color>!<clear><br>¿Quieres que te adivine si algún encuentro te traerá<br>buena suerte hoy?<clear><br><$comeff(1,14)><$facial(1,14)>Hm... Hmm... Hmmm...<clear><br><$voicel(1,9)><$emotion(1,40)><$facial(1,4)>¿Eh? ¡Vaya! ¡Fíjate si estás de suerte! Resulta que hablar<br>conmigo hoy te traerá buena suerte.<clear><br><$voicel(1,8)><$emotion(1,8)>¡Que pases un día de lujooo!"

#. en: <$voicel(1,5)><$emotion(1,29)>OK, hear me out: I could FREEZE carrots to make<br>CARROT ICE CREAM!<clear><br><$voicel(1,4)><$comeff(1,14)><$motion(1,666)>It would be tasty, right?! I should try it... Right?
msgctxt "1986:540"
msgid "<$voicel(1,5)><$emotion(1,29)>Si congelo unas zanahorias, ¿crees que estarían ricas así?<br><$voicel(1,4)><$comeff(1,14)><$motion(1,666)>La próxima vez que haga calor, igual hay que probarlo..."
msgstr "<$voicel(1,5)><$emotion(1,29)>Si congelo unas zanahorias, ¿crees que estarían ricas así?<br><$voicel(1,4)><$comeff(1,14)><$motion(1,666)>La próxima vez que haga calor, tal vez hay que probarlo..."

#. en: <$voicel(1,5)><$comeff(1,14)><$motion(1,805)>D’ya think I could make some human friends someday?<br><$voicel(1,7)><$comeff(1,5)><$motion(1,801)>AHHH! I sure hope so! I just can’t wait!<clear><br><$voicel(1,6)><$comeff(1,6)><$motion(1,666)><$facial(1,1)>Do you think humans like berries too?!
msgctxt "1986:542"
msgid "<$voicel(1,5)><$comeff(1,14)><$motion(1,805)>Estaba pensando queee... ¡sería lo más poder hacerme<br>amig<gen;-3(o,a)> de un humano algún día!<clear><br><$voicel(1,7)><$comeff(1,5)><$motion(1,801)>¡¡Anda que no molaría ni nada!!<clear><br><$voicel(1,6)><$motion(1,666)><$facial(1,1)>Oye, fiera, <$comeff(1,6)>¿tú crees que a los humanos también les<br>gustarán las bayas?"
msgstr "<$voicel(1,5)><$comeff(1,14)><$motion(1,805)>Estaba pensando queee... ¡sería genial poder hacerme<br>amig<gen;-3(o,a)> de un humano algún día!<clear><br><$voicel(1,7)><$comeff(1,5)><$motion(1,801)>¡¡Sería increíble!!<clear><br><$voicel(1,6)><$motion(1,666)><$facial(1,1)>Oye, crack, <$comeff(1,6)>¿tú crees que a los humanos también les<br>gustarán las bayas?"

#. en: <oneline><$voicel(1,7)><$emotion(1,14)>Hehehe... You’ve always got that goofy-lookin’ smile on<br>your face, <$cdef(27)><pname;0></color>! <$voicel(1,6)><$comeff(1,21)><$motion(1,806)>Just looking at ya<slide><br>makes<slide><br>my<slide><br>worries<slide><br>drift<slide><br>away!<slide><br><$voicel(1,8)><$emotion(1,8)>That’s<slide><br>why<slide><br>we’re besties!
msgctxt "1986:543"
msgid "<oneline><$voicel(1,7)><$emotion(1,14)>Ja, jaaa... ¡Pero qué sonrisa tan tranquilona tienes,<br><$cdef(27)><pname;0></color>, fiera!<clear><br><$voicel(1,6)><$comeff(1,21)><$motion(1,806)>Solo con verla, se me quitan las preocupaciones.<br><$voicel(1,8)><$emotion(1,8)>¡Mola miiil!"
msgstr "<oneline><$voicel(1,7)><$emotion(1,14)>Ja, jaaa... ¡Pero qué sonrisa tan tranquilona tienes,<br><$cdef(27)><pname;0></color>, crack!<clear><br><$voicel(1,6)><$comeff(1,21)><$motion(1,806)>Solo con verla, se me quitan las preocupaciones.<br><$voicel(1,8)><$emotion(1,8)>¡Me encantaaa!"

#. en: <$voicel(1,7)><$emotion(1,14)>Hey—what does it FEEL like when you transform?<clear><br><$voicel(1,5)><$comeff(1,6)><$motion(1,666)>Itchy-witchy? Creepy-weepy? Or is it...uh...some other<br>THIRD type of feeling? <$voicel(1,8)><$emotion(1,49)>I’m so curious! You gotta tell me!
msgctxt "1986:544"
msgid "<$voicel(1,7)><$emotion(1,14)>¡Pregunta! ¿Qué se siente al transformarse?<clear><br><$voicel(1,5)><$comeff(1,6)><$motion(1,666)>¿Cosquillas? ¿O es más bien como un hormigueo?<br>¿O una sensación totalmente distinta?<clear><br><$voicel(1,8)><$emotion(1,49)>¡Necesito respuestaaas!"
msgstr ""

#. en: <oneline><$voicel(1,7)><$emotion(1,14)>Argh! I just wanna go on an adventuuure!<clear><br><$voicel(1,5)><$motion(1,666)><$comeff(1,14)>Like, soaring way above the clouds!<$voicel(1,8)><$emotion(1,38)> Or to the very bottom<br>of the ocean!<clear><br><$voicel(1,5)><$comeff(1,9)><$motion(1,661)><$facial(1,4)>And of COURSE I’d have to bring my bestie,<br><$cdef(27)><pname;0></color>!
msgctxt "1986:545"
msgid "<oneline><$voicel(1,7)><$emotion(1,14)>¡Qué ganas tengo de irme de aventuras!<clear><br><$voicel(1,5)><$motion(1,666)><$comeff(1,14)>En plan... ¡saltando por el cielo de nube en nube! ¡O de<br>paseo por el fondo del mar! <$voicel(1,8)><$emotion(1,38)>¡Sería una pasadaaa!<clear><br><$voicel(1,5)><$comeff(1,9)><$motion(1,661)><$facial(1,4)>¡Sobre todo si tú vienes conmigo,<br><$cdef(27)><pname;0></color>!"
msgstr "<oneline><$voicel(1,7)><$emotion(1,14)>¡Qué ganas tengo de irme de aventuras!<clear><br><$voicel(1,5)><$motion(1,666)><$comeff(1,14)>Como... ¡saltando por el cielo de nube en nube! ¡O de<br>paseo por el fondo del mar! <$voicel(1,8)><$emotion(1,38)>¡Sería increíbleee!<clear><br><$voicel(1,5)><$comeff(1,9)><$motion(1,661)><$facial(1,4)>¡Sobre todo si tú vienes conmigo,<br><$cdef(27)><pname;0></color>!"

#. en: <oneline><$voicel(1,7)><$emotion(1,8)>I was just hanging out with <$cdef(27)><nlpairpk;0> </color>a little<br>bit<slide><br>ago!<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,805)><$facial(1,1)>Uhhh... But after we said goodbye, they<$cdef(27)> </color>got TOTALLY lost!<br><$voicel(1,8)><$emotion(1,49)>Oh, don’t worry—of course I helped them get home!
msgctxt "1986:546"
msgid "<$cdef(27)><oneline></color><$voicel(1,7)><$emotion(1,8)>¡He estado jugando con <dart;0()><$cdef(27)><nlpairpk;0> </color>hasta<br>hace nada!<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,805)><$facial(1,1)>Y después de despedirnos, cuando ya me iba, me he<br>girado a mirar... ¡y <gen;0(el,la)> pobre tenía cara de haberse perdido!<clear><br><$voicel(1,8)><$emotion(1,49)>Pero tranqui, ¡que <gen;0(lo,la)> he acompañado hasta su casa!"
msgstr "<$cdef(27)><oneline></color><$voicel(1,7)><$emotion(1,8)>¡Estuve jugando con <dart;0()><$cdef(27)><nlpairpk;0> </color>hasta<br>hace nada!<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,805)><$facial(1,1)>Y después de despedirnos, cuando ya me iba, me<br>giré a mirar... ¡y <gen;0(el,la)> pobre tenía cara de haberse perdido!<clear><br><$voicel(1,8)><$emotion(1,49)>Pero tranqui, ¡que <gen;0(lo,la)> acompañé hasta su casa!"

#. en: <oneline><$voicel(1,7)><$emotion(1,14)><$cdef(27)><pname;0></color>! The<br><$cdef(27)><fqty(1)><class><nlqueitem;1></color><slide><br>you<slide><br>gave<slide><br>me<slide><br>earlier<slide><br><$voicel(1,10)><$emotion(1,7)><qty;1(was,were)><slide><br>SOOOOOO<slide><br>tasty!<clear><br><$voicel(1,8)><$emotion(1,49)>Seriously! I’m even seeing <qty;1(it,them)> in my dreams!
msgctxt "1986:547"
msgid "<oneline><$voicel(1,7)><$emotion(1,14)>¡<$cdef(27)><pname;0></color>! ¿Te acuerdas<br><esde;1()><class><$cdef(27)><fqty(1)><nlqueitem;1></color><slide><br>que me diste?<clear><br><$voicel(1,10)><$emotion(1,7)>¡Estab<qty;1(a,an)> riquísim<genqty;1(o,a,os,as)>! <$voicel(1,8)><$emotion(1,49)>¡Tanto que ya hasta sueño con <genqty;1(él,ella,ellos,ellas)>!"
msgstr ""

#. en: <oneline><$voicel(1,7)><$emotion(1,49)>Hey—how would you describe<br><$cdef(27)><crstlktar;0></color>?<slide><br>I<slide><br>really<slide><br>wanna<slide><br>know<slide><br>if<slide><br>we<slide><br>could<slide><br>be friends!<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,805)><$facial(1,1)>I bet if the two of us lived closed together, we’d have tons<br>of stuff to talk about!
msgctxt "1986:548"
msgid "<oneline><$voicel(1,7)><$emotion(1,49)>¿Cómo es <dart;0()><$cdef(27)><crstlktar;0></color>?<br>¡Estaría guapo<slide><br>conocer<gen;0(lo,la)> mejor!<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,805)><$facial(1,1)>Si viviéramos más cerca, podríamos hablar un poco más..."
msgstr "<oneline><$voicel(1,7)><$emotion(1,49)>¿Cómo es <dart;0()><$cdef(27)><crstlktar;0></color>?<br>¡Sería genial<slide><br>conocer<gen;0(lo,la)> mejor!<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,805)><$facial(1,1)>Si viviéramos más cerca, podríamos hablar un poco más..."

#. en: <oneline><$voicel(1,9)><$comeff(1,5)><$motion(1,661)><$facial(1,4)>Lately, I’ve set my sights on having a chat<br>with <$cdef(27)><crstlktar;1></color>!<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,666)><$facial(1,1)>But frankly, as things stand, there’s no WAY we’d just run<br>into each other...<clear><br><$voicel(1,7)><$emotion(1,50)>I just wish <$cdef(27)><crstlktar;2> </color>lived super close<br>to<slide><br>my<slide><br>place! ♪
msgctxt "1986:549"
msgid "<oneline><$cdef(27)><$voicel(1,9)></color><$comeff(1,5)><$motion(1,661)><$facial(1,4)>¡Me he puesto una meta nueva! Y es... ¡charlar con<br><dart;1()><$cdef(27)><crstlktar;1></color>!<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,666)><$facial(1,1)>Lo que pasa es que nunca coincidimos por aquí...<clear><br><$voicel(1,7)><$emotion(1,50)>¡Ojalá se viniera a vivir cerca de mi casa!"
msgstr "<oneline><$cdef(27)><$voicel(1,9)></color><$comeff(1,5)><$motion(1,661)><$facial(1,4)>¡Me puse una meta nueva! Y es... ¡charlar con<br><dart;1()><$cdef(27)><crstlktar;1></color>!<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,666)><$facial(1,1)>Lo que pasa es que nunca coincidimos por aquí...<clear><br><$voicel(1,7)><$emotion(1,50)>¡Ojalá se viniera a vivir cerca de mi casa!"

