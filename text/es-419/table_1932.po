msgid "<$comeff(1,9)><$facial(1,1)><$motion(1,661)><$voicel(1,5)>Pues, sinceramente... <wait(1.0)>¡diría que está <$cdef(27)><$stflevel;0(3)></color>!"
msgstr ""

#. en: <$comeff(1,21)><$facial(1,4)><$motion(1,661)><$voicel(1,7)>My comfort level? It’s definitely <$cdef(27)><flow><$stflevel;0(4)></color>!
msgctxt "1932:753"
msgid "<oneline><$comeff(1,21)><$facial(1,4)><$motion(1,661)><$voicel(1,7)>Si tuviera que calificarlo... <wait(1.0)>¡diría que es <$cdef(27)><$stflevel;0(4)></color>!"
msgstr ""

#. en: <oneline><$comeff(1,8)><$facial(1,5)><$motion(1,803)><$voicel(1,7)>My comfort level? It’s <$cdef(27)><flow><$stflevel;0(5)></color>! <$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,10)><br>I’m<slide><br>so<slide><br>happy<slide><br>I<slide><br>get<slide><br>to<slide><br>live here!
msgctxt "1932:754"
msgid "<oneline><$comeff(1,8)><$facial(1,5)><$motion(1,803)><$voicel(1,7)>¡Uf, es <$cdef(27)><$stflevel;0(5)></color>!<clear><br><$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>¡Soy superfeliz viviendo aquí!"
msgstr ""

#. en: <$emotion(1,50)><$voicel(1,8)>It’s better than before!
msgctxt "1932:756"
msgid "<$emotion(1,50)><$voicel(1,8)>Estoy más cómod<gen;-3(o,a)> que antes, je, je."
msgstr ""

#. en: <$emotion(1,8)><$voicel(1,9)>Things have gotten a lot better! Thank you!
msgctxt "1932:757"
msgid "<$emotion(1,8)><$voicel(1,9)>Lo has mejorado todo un montón, ¿eh? ¡Gracias!"
msgstr "<$emotion(1,8)><$voicel(1,9)>Mejoraste todo un montón, ¿eh? ¡Gracias!"

#. en: <oneline><$emotion(1,31)><$voicel(1,3)>Sorry, it seems like this<br><$cdef(27)><fqty(1)><class><aireactp;0></color><slide><br>is<slide><br>a<slide><br>bit<slide><br>too<slide><br>small<slide><br>for me.<clear><br><$emotion(1,37)><$voicel(1,6)>Something just a little bigger would be perfect.
msgctxt "1932:758"
msgid "<oneline><$emotion(1,31)><$voicel(1,3)>Perdona, pero est<genqty;0(e,a,os,as)> <$cdef(27)><fqty(1)><aireactp;0><br></color>me parec<qty;0(e,en)><slide><br>un poco pequeñ<genqty;0(o,a,os,as)>...<clear><br><$emotion(1,37)><$voicel(1,6)>¿No tendrás otra cosa más grande a mano?"
msgstr ""

#. en: <oneline><$emotion(1,8)><$voicel(1,9)>Thanks for bringing me that<br><$cdef(27)><fqty(1)><class><aireactp;0></color>!
msgctxt "1932:761"
msgid "<oneline><$emotion(1,8)><$voicel(1,9)>¡Ahí va! ¡Me has conseguido<br><iart;0()><$cdef(27)><fqty(1)><class><aireactp;0></color>!<slide><br>¡Gracias!"
msgstr "<oneline><$emotion(1,8)><$voicel(1,9)>¡Guau! ¡Me conseguiste<br><iart;0()><$cdef(27)><fqty(1)><class><aireactp;0></color>!<slide><br>¡Gracias!"

#. en: <$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,6)>The comfort level? Well, as far as I can remember, it was...<br><$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,1)>Uhhh...<$cdef(27)><flow><$stflevel;0(1)></color>, I think?
msgctxt "1932:762"
msgid "<$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,6)>Pues lo digo de memoria, pero, por lo que recuerdo...<br><wait(1.0)><$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,1)>es <$cdef(27)><$stflevel;0(1)></color>."
msgstr ""

#. en: <$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,6)>The comfort level? Well, as far as I can remember, it was...<br><$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,5)>Well...<$cdef(27)><flow><$stflevel;0(2)></color>, I think?
msgctxt "1932:763"
msgid "<oneline><$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,6)>Déjame que piense, que sin estar en casa...<br><wait(1.0)><$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,5)>¡Es <$cdef(27)><$stflevel;0(2)></color>!<slide><br>O eso creo."
msgstr ""

#. en: <$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,6)>The comfort level? Well, as far as I can remember, it was...<br><$comeff(1,9)><$facial(1,1)><$motion(1,661)><$voicel(1,8)><$cdef(27)><flow><$stflevel;0(3)></color>, I’m pretty sure?
msgctxt "1932:764"
msgid "<$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,6)>Hala, pues ahora así lejos de casa... A ver qué pienso...<br><wait(1.0)><$comeff(1,9)><$facial(1,1)><$motion(1,661)><$voicel(1,8)>¡Pues es <$cdef(27)><$stflevel;0(3)></color>, la verdad!"
msgstr "<$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,6)>Vaya, pues ahora así lejos de casa... A ver qué pienso...<br><wait(1.0)><$comeff(1,9)><$facial(1,1)><$motion(1,661)><$voicel(1,8)>¡Pues es <$cdef(27)><$stflevel;0(3)></color>, la verdad!"

#. en: <$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,6)>The comfort level? Sure, I remember it was <$comeff(1,21)><$facial(1,1)><$motion(1,806)><$voicel(1,10)><$cdef(27)><flow><$stflevel;0(4)></color>!
msgctxt "1932:765"
msgid "<oneline><$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,6)>A ver que haga memoria de mi casita...<br><wait(1.0)><$comeff(1,21)><$facial(1,1)><$motion(1,806)><$voicel(1,10)>♪¡Es <$cdef(27)><$stflevel;0(4)></color>!♪"
msgstr ""

#. en: <$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,6)>The comfort level? Sure, I remember it was <$comeff(1,8)><$facial(1,4)><$motion(1,801)><$voicel(1,9)><$cdef(27)><flow><$stflevel;0(5)></color>!<br>I absolutely love my home!
msgctxt "1932:766"
msgid "<$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,6)>Estoy algo lejillos de casa ahora, pero... <wait(1.0)><$comeff(1,8)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡ya te confirmo<br>que es <$cdef(27)><$stflevel;0(5)></color>! ¡Una pasada!"
msgstr "<$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,6)>Estoy algo lejitos de casa ahora, pero... <wait(1.0)><$comeff(1,8)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡ya te confirmo<br>que es <$cdef(27)><$stflevel;0(5)></color>! ¡Increíble!"

#. en: <$emotion(1,50)><$voicel(1,8)>It’s gotten better than before!
msgctxt "1932:767"
msgid "<$emotion(1,50)><$voicel(1,8)>¡Está mejor que antes!"
msgstr ""

#. en: <$emotion(1,8)><$voicel(1,8)>I think it’s gotten a lot better! Thank you so much!
msgctxt "1932:768"
msgid "<$emotion(1,8)><$voicel(1,8)>¡Está mucho mejor! ¡Gracias!"
msgstr ""

#. en: <$emotion(1,37)><$voicel(1,7)>My home? It’s this way! Follow me and I’ll take you there!
msgctxt "1932:769"
msgid "<$emotion(1,37)><$voicel(1,7)>¿Mi casa? Está por aquí. ¡Ven, sígueme!"
msgstr ""

#. en: <$emotion(1,14)><$voicel(1,5)>My home’s that way. I wish I could take you there, but...<br><$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,4)>I’m kinda busy right now, sorry...
msgctxt "1932:770"
msgid "<$emotion(1,14)><$voicel(1,5)>Mi casa está por aquí. Y me encantaría invitarte, pero...<br><$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,4)>ahora es que no puedo. Lo siento."
msgstr ""

#. en: <$emotion(1,50)><$voicel(1,9)>Oh, you placed it in my home? Wow, thank you!
msgctxt "1932:771"
msgid "<$emotion(1,50)><$voicel(1,9)>¿En serio me has dejado eso en casa? ¡Aaay, qué bien!<br>¡Muchas gracias!"
msgstr "<$emotion(1,50)><$voicel(1,9)>¿En serio me dejaste eso en casa? ¡Aaay, qué bien!<br>¡Muchas gracias!"

#. en: <oneline><$comeff(1,21)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>Really?! <fcap><iart;0()><$cdef(27)><fqty(1)><class><stfrevp;0></color>?<br>Wow,<slide><br>thank<slide><br>you<slide><br>so much!
msgctxt "1932:772"
msgid "<oneline><$comeff(1,21)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>¿Me has colocado<br><iart;0()><$cdef(27)><fqty(1)><class><stfrevp;0></color>?<slide><br>Qué guay,<slide><br>¡muchas gracias!"
msgstr "<oneline><$comeff(1,21)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>¿Me colocaste<br><iart;0()><$cdef(27)><fqty(1)><class><stfrevp;0></color>?<slide><br>Qué genial,<slide><br>¡muchas gracias!"

#. en: <$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,6)>My comfort level? I think I need to live in my place a bit<br>longer <$voicel(1,5)>to really tell...<clear><br><$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,8)>Ask me again later!
msgctxt "1932:773"
msgid "<$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,6)>La verdad es que así, recién mudad<gen;-3(o,a)>,<$voicel(1,5)> no te sé decir...<wait(1.0)><br><$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,8)>Pregúntame más adelante, ¿vale?"
msgstr "<$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,6)>La verdad es que así, recién mudad<gen;-3(o,a)>,<$voicel(1,5)> no te sé decir...<wait(1.0)><br><$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,8)>Pregúntame más adelante, ¿sí?"

#. en: <oneline><$emotion(1,1)><$voicel(1,8)>Thanks, <$cdef(27)><pname;0></color>!<clear><br><$comeff(1,14)><$facial(1,9)><$motion(1,805)><$voicel(1,5)>To be honest, stuff like<br><$cdef(27)><fqty(2)><class><stfrevp;2></color><slide><$cdef(27)><br></color><$emotion(1,41)><$voicel(1,4)>isn’t<slide><br>my favorite.<clear><br><$emotion(1,29)><$voicel(1,6)>Could I have something else, please?
msgctxt "1932:774"
msgid "<oneline><$emotion(1,1)><$voicel(1,8)>¡Gracias, <$cdef(27)><pname;0></color>!<clear><br><$comeff(1,14)><$facial(1,9)><$motion(1,805)><$voicel(1,5)>La cosa es que no me chiflan<br><$emotion(1,41)><$voicel(1,4)><dart;2()><fqty(2)><class><$cdef(27)><stfrevp;2></color>.<clear><br><$emotion(1,29)><$voicel(1,6)>¿Me l<gen;0(o,a)> cambias por otra cosa?"
msgstr "<oneline><$emotion(1,1)><$voicel(1,8)>¡Gracias, <$cdef(27)><pname;0></color>!<clear><br><$comeff(1,14)><$facial(1,9)><$motion(1,805)><$voicel(1,5)>La cosa es que no me encantan<br><$emotion(1,41)><$voicel(1,4)><dart;2()><fqty(2)><class><$cdef(27)><stfrevp;2></color>.<clear><br><$emotion(1,29)><$voicel(1,6)>¿Me l<gen;0(o,a)> cambias por otra cosa?"

#. en: <oneline><$emotion(1,31)><$voicel(1,3)>Sorry, it seems like the<br><$cdef(27)><fqty(1)><class><stfrevp;0></color><slide><br>is<slide><br>a<slide><br>bit<slide><br>too<slide><br>small<slide><br>for me.<clear><br><$emotion(1,37)><$voicel(1,6)>Something just a little bigger would be perfect!
msgctxt "1932:775"
msgid "<oneline><$emotion(1,31)><$voicel(1,3)>Lo siento, pero no creo que<br><dart;0()><fqty(1)><class><$cdef(27)><stfrevp;0></color><slide><br>me sirv<qty;0(a,an)>...<clear><br><$emotion(1,37)><$voicel(1,6)>Necesito algo un pelín más grande."
msgstr "<oneline><$emotion(1,31)><$voicel(1,3)>Lo siento, pero no creo que<br><dart;0()><fqty(1)><class><$cdef(27)><stfrevp;0></color><slide><br>me sirv<qty;0(a,an)>...<clear><br><$emotion(1,37)><$voicel(1,6)>Necesito algo un poquito más grande."

#. en: <oneline><$emotion(1,14)><$voicel(1,5)>Hi, <$cdef(27)><pname;0></color>! You’ve been picking up a<br>lot<slide><br>of<slide><br>stuff<slide><br>these<slide><br>days, right?<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>You’re gonna make something new, aren’t you? I bet it’s<br>gonna be amazing! <$emotion(1,38)><$voicel(1,9)>But make sure you don’t overload your<slide><br>backpack, OK?
msgctxt "1932:801"
msgid "<oneline><$emotion(1,14)><$voicel(1,5)>Últimamente te veo recogiendo muchas cosas,<br><$cdef(27)><pname;0></color>.<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>¿Estás pensando en volver a fabricar algo? ¡Qué guay!<br><$emotion(1,38)><$voicel(1,9)>¡Pero ten cuidado de no cargarte demasiado!"
msgstr "<oneline><$emotion(1,14)><$voicel(1,5)>Últimamente te veo recogiendo muchas cosas,<br><$cdef(27)><pname;0></color>.<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>¿Estás pensando en volver a fabricar algo? ¡Qué genial!<br><$emotion(1,38)><$voicel(1,9)>¡Pero ten cuidado de no cargarte demasiado!"

#. en: <oneline><$emotion(1,14)><$voicel(1,7)>Oh, hey there, <$cdef(27)><pname;0></color>! We run into<br>each<slide><br>other<slide><br>a<slide><br>lot<slide><br>these<slide><br>days<slide><br>don’t we?<clear><br><$emotion(1,8)><$voicel(1,9)>I kinda figured I’d run into you today too!
msgctxt "1932:802"
msgid "<$cdef(27)><$emotion(1,14)></color><$voicel(1,7)>¡Ah, hola, <$cdef(27)><pname;0></color>! ¡Últimamente<br>te veo mucho por aquí!<clear><br><$emotion(1,8)><$voicel(1,9)>No sé por qué, pero tenía la corazonada de que hoy<br>también me toparía contigo..."
msgstr ""

#. en: <oneline><$comeff(1,3)><$voicel(1,7)>Building that <$cdef(27)><asnbname;0><br></color>was<slide><br>so<slide><br>much fun!<clear><br><$comeff(1,21)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>Just looking at it makes me so happy! <$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>And I know next<br>time we’ll be able to <$cdef(27)><$spwfull(1)></color> something even MORE<slide><br>amazing, so <$emotion(1,38)><$voicel(1,9)>let me know when you need help!
msgctxt "1932:803"
msgid "<oneline><$comeff(1,3)><$voicel(1,7)>Me lo pasé tan bien construyendo<br><dart;0()><$cdef(27)><asnbname;0></color>,<slide><br><$comeff(1,21)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>que cada vez<slide><br>que <genqty;0(lo,la,los,las)> miro me pongo de buen humor.<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>Yo creo que podría <$cdef(27)><$spwfull(1)> </color>otras cosas igual de<br>chulas o más. <$emotion(1,38)><$voicel(1,9)>¡Dime si te hace falta ayuda!"
msgstr "<oneline><$comeff(1,3)><$voicel(1,7)>Me la pasé tan bien construyendo<br><dart;0()><$cdef(27)><asnbname;0></color>,<slide><br><$comeff(1,21)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>que cada vez<slide><br>que <genqty;0(lo,la,los,las)> miro me pongo de buen humor.<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>Yo creo que podría <$cdef(27)><$spwfull(1)> </color>otras cosas igual de<br>geniales o más. <$emotion(1,38)><$voicel(1,9)>¡Dime si te hace falta ayuda!"

#. en: <oneline><$emotion(1,29)><$voicel(1,7)>When did that<br><$cdef(27)><rctbname;0></color><slide><br>get done?<clear><br><$emotion(1,38)><$voicel(1,9)>I bet everyone worked really hard to finish it!<$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,7)> I hope next<br>time, I can help <$cdef(27)><$spwfull(1)> </color>too!
msgctxt "1932:804"
msgid "<oneline><$emotion(1,29)><$voicel(1,7)>¿Cuánto <qty;0(lleva,llevan)> aquí<br><dart;0()><$cdef(27)><rctbname;0></color>?<clear><br><$emotion(1,38)><$voicel(1,9)>¡Seguro que todo el mundo ha colaborado en su<br>construcción!<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>¡La próxima vez yo también quiero participar<br>y <$cdef(27)><$spwfull(1)> </color>algo!"
msgstr "<oneline><$emotion(1,29)><$voicel(1,7)>¿Cuánto <qty;0(lleva,llevan)> aquí<br><dart;0()><$cdef(27)><rctbname;0></color>?<clear><br><$emotion(1,38)><$voicel(1,9)>¡Seguro que todo el mundo colaboró en su<br>construcción!<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>¡La próxima vez yo también quiero participar<br>y <$cdef(27)><$spwfull(1)> </color>algo!"

#. en: <oneline><$emotion(1,14)><$voicel(1,5)>By the way, <$cdef(27)><pname;0></color>, you remember<br><$cdef(27)><acqpname;1></color>,<slide><br>right?<slide><br><$emotion(1,38)><$voicel(1,10)>We<slide><br>had<slide><br>so<slide><br>much<slide><br>fun<slide><br>hanging out!<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>I hope we get to spend time together again soon!
msgctxt "1932:805"
msgid "<oneline><$emotion(1,14)><$voicel(1,5)>Por cierto, <$cdef(27)><pname;0></color>, ¿te acuerdas de<br>cuando jugamos<slide><br>con <$cdef(27)><acqpname;1></color>?<clear><br><$emotion(1,38)><$voicel(1,10)>Ay, nos lo pasamos tan bien... <$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>¡Ojalá volvamos a quedar<br>pronto!"
msgstr "<oneline><$emotion(1,14)><$voicel(1,5)>Por cierto, <$cdef(27)><pname;0></color>, ¿te acuerdas de<br>cuando jugamos<slide><br>con <$cdef(27)><acqpname;1></color>?<clear><br><$emotion(1,38)><$voicel(1,10)>Ay, nos la pasamos tan bien... <$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>¡Ojalá volvamos a vernos<br>pronto!"

#. en: <oneline><$emotion(1,29)><$voicel(1,7)>Hi there, <$cdef(27)><pname;0></color>! Trying out a<br>new look?<clear><br><$emotion(1,8)><$voicel(1,9)>I like it. I think it suits you really well!
msgctxt "1932:806"
msgid "<oneline><$emotion(1,29)><$voicel(1,7)>Anda, <$cdef(27)><pname;0></color>, ¿te has cambiado<br>de look?<slide><br><$emotion(1,8)><$voicel(1,9)>¡Te queda muy chulo! ¡Me encanta!"
msgstr "<oneline><$emotion(1,29)><$voicel(1,7)>Vaya, <$cdef(27)><pname;0></color>, ¿cambiaste<br>de look?<slide><br><$emotion(1,8)><$voicel(1,9)>¡Te queda genial! ¡Me encanta!"

#. en: <$emotion(1,14)><$voicel(1,7)>Oh, <$cdef(27)><pname;0></color>! You look different!<clear><br><$emotion(1,38)><$voicel(1,9)>I bet you thought nobody would notice, didn’t you? Well,<br>I’m sure to notice even the slightest change!
msgctxt "1932:807"
msgid "<oneline><$emotion(1,14)><$voicel(1,7)>¡Anda, <$cdef(27)><pname;0></color>, te veo diferente!<br><$emotion(1,38)><$voicel(1,9)>Que a mí no<slide><br>se me escapa nada, aunque sea un detalle."
msgstr "<oneline><$emotion(1,14)><$voicel(1,7)>¡Vaya, <$cdef(27)><pname;0></color>, te veo diferente!<br><$emotion(1,38)><$voicel(1,9)>Que a mí no<slide><br>se me escapa nada, aunque sea un detalle."

#. en: <$comeff(1,3)><$motion(1,803)><$voicel(1,7)>By the way, I’ve been wondering... Why are you always<br>transformed into a human?<clear><br><$comeff(1,14)><$voicel(1,5)>Do you admire how they lived?<$comeff(1,6)><$motion(1,666)><$voicel(1,8)> Have you always wanted<br>to be a human? Come on, tell me!
msgctxt "1932:808"
msgid "<oneline><$comeff(1,3)><$motion(1,803)><$voicel(1,7)>Por cierto, <$cdef(27)><pname;0></color>, ¿tú por qué te<br>transformas<slide><br>en human<gen;-2(o,a)>?<clear><br><$comeff(1,14)><$voicel(1,5)>Será que en el fondo... <wait(1.5)><$comeff(1,6)><$motion(1,666)><$voicel(1,8)>¿quieres ser una persona?"
msgstr ""

#. en: <$comeff(1,14)><$voicel(1,5)>I wonder if <$cdef(27)>Professor Tangrowth</color> <$comeff(1,6)><$motion(1,666)><$voicel(1,8)>ever gets tangled up in<br>their own vines?<clear><br><$emotion(1,38)><$voicel(1,9)>I mean, they’re so smart... They’d prolly never let<br>something like that happen, right?
msgctxt "1932:809"
msgid "<$comeff(1,14)><$voicel(1,5)>¿Tú crees que el <$cdef(27)>Profesor Tangrowth</color>... <wait(0.4)><$comeff(1,6)><$motion(1,666)><$voicel(1,8)>se enreda alguna<br>vez con sus lianas?<clear><br><$emotion(1,38)><$voicel(1,9)>Como es tan listo, supongo que no, pero por saber..."
msgstr ""

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,7)>I’ve never really thought about living with anyone else... But<br><$emotion(1,38)><$voicel(1,9)>living with you makes every day sooo exciting!
msgctxt "1932:810"
msgid "<$comeff(1,14)><$motion(1,666)><$voicel(1,7)>Nunca me había planteado lo de compartir casa, <$emotion(1,38)><$voicel(1,9)>¡pero<br>vivir contigo es más emocionante de lo que imaginaba!"
msgstr ""

#. en: <$emotion(1,50)><$voicel(1,5)>I try and take real good care of my fluffy coat. <$emotion(1,38)><$voicel(1,9)>It’s as soft<br>as those “cushions” the humans loved!
msgctxt "1932:815"
msgid "<$emotion(1,50)><$voicel(1,5)>Yo me cuido mucho el pelaje para que esté así de suave<br>y mullido. <$emotion(1,38)><$voicel(1,9)>No tiene nada que envidiar a los cojines que<slide><br>hacían los humanos."
msgstr ""

#. en: <$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,6)>I really want to grow up soon, but if I suddenly got super<br>tall, <$comeff(1,5)><$facial(1,1)><$motion(1,803)><$voicel(1,4)>I’d probably fall over!<clear><br><$comeff(1,21)><$facial(1,4)><$motion(1,806)><$voicel(1,9)>I’d rather grow up slow and steady instead.
msgctxt "1932:817"
msgid "<$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,6)>Estoy deseando hacerme mayor, pero... si doy el estirón de<br>repente, <$comeff(1,5)><$facial(1,1)><$motion(1,803)><$voicel(1,4)>¡igual se me fastidia el equilibrio y me la pego!<clear><br><$comeff(1,21)><$facial(1,4)><$motion(1,806)><$voicel(1,9)>Creo que prefiero ir creciendo poco a poco..."
msgstr "<$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,6)>Tengo muchas ganas de crecer, pero... si doy el estirón de<br>repente, <$comeff(1,5)><$facial(1,1)><$motion(1,803)><$voicel(1,4)>¡a lo mejor pierdo el equilibrio y me caigo!<clear><br><$comeff(1,21)><$facial(1,4)><$motion(1,806)><$voicel(1,9)>Creo que prefiero ir creciendo poco a poco..."

#. en: <oneline><$emotion(1,14)><$voicel(1,5)><$cdef(27)><$tonepk;0(7)></color> is always so energetic!<br>I don’t<slide><br>think<slide><br>I’ve<slide><br>ever<slide><br>seen<slide><br>them<slide><br>be<slide><br><$emotion(1,38)><$voicel(1,8)>tired<slide><br>or gloomy.<clear><br><$comeff(1,14)><$facial(1,9)><$motion(1,666)><$voicel(1,5)>I wish I could be that way too, but...I don’t think I got it<br>in me.
msgctxt "1932:824"
msgid "<oneline><$emotion(1,14)><$voicel(1,5)>No sé cómo lo hace <dart;0()><$cdef(27)><$tonepk;0(7)><br></color>para estar siempre<slide><br>así de bien.<clear><br><$emotion(1,38)><$voicel(1,8)>Nunca l<gen;0(o,a)> he visto cansad<gen;0(o,a)> ni de mal humor. <$comeff(1,14)><$facial(1,9)><$motion(1,666)><$voicel(1,5)>Yo también<br>quiero ser así, pero... Buf, lo veo difícil..."
msgstr ""

#. en: <oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,5)><$cdef(27)><$tonepk;0(12)> </color>says some complicated<br>things<slide><br>sometimes,<slide><br>but<slide><br>I<slide><br>always<slide><br>try<slide><br>to<slide><br>figure<slide><br>out<slide><br>what<slide><br>they mean!<clear><br><$emotion(1,60)><$voicel(1,7)>Someday I hope I know as many things as they do...
msgctxt "1932:829"
msgid "<oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Siempre tengo que hacer un esfuerzo para entender<br><esa;0()><$cdef(27)><$tonepk;0(12)></color> cuando suelta algo<slide><br>complicado.<clear><br><$emotion(1,60)><$voicel(1,7)>¡Ojalá fuera yo igual de sabi<gen;-3(o,a)>!"
msgstr ""

#. en: <$emotion(1,59)><$voicel(1,3)>I’m actually really bad at hide-and-seek... <$emotion(1,77)><$facial(1,2)><$voicel(1,7)>No matter where<br>I hide, everybody says they can find me just by following<slide><br>my smell.
msgctxt "1932:837"
msgid "<$emotion(1,59)><$voicel(1,3)>El escondite no es lo mío, la verdad...<clear><br><$emotion(1,77)><$facial(1,2)><$voicel(1,7)>Da igual lo bien que me esconda; siempre dan conmigo<br>enseguida por culpa de mi olor."
msgstr "<$emotion(1,59)><$voicel(1,3)>Las escondidas no son lo mío, la verdad...<clear><br><$emotion(1,77)><$facial(1,2)><$voicel(1,7)>Da igual lo bien que me esconda; siempre dan conmigo<br>enseguida por culpa de mi olor."

#. en: <$emotion(1,14)><$voicel(1,5)>You know, even berries that look the same can have<br>different textures—some soft, some firm.<clear><br><$emotion(1,39)><$voicel(1,7)>I prefer firm ones. It’s more fun when they have a good<br>bite to them!
msgctxt "1932:838"
msgid "<$emotion(1,14)><$voicel(1,5)>Es muy difícil distinguir las bayas duras de las blanditas<br>a simple vista.<clear><br><$emotion(1,39)><$voicel(1,7)>Yo soy más de bayas duras. ¡Me chifla la sensación<br>al morderlas!"
msgstr "<$emotion(1,14)><$voicel(1,5)>Es muy difícil distinguir las bayas duras de las blanditas<br>a simple vista.<clear><br><$emotion(1,39)><$voicel(1,7)>Yo soy más de bayas duras. ¡Me encanta la sensación<br>al morderlas!"

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>I wonder what’s up with <$cdef(27)><gevcmainpk;0></color> these days. They’re<br>so full of energy! <$emotion(1,29)><$voicel(1,8)>Do you know anything about that?
msgctxt "1932:851"
msgid "<oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>¿Qué mosca le ha picado <esa;0()><$cdef(27)><gevcmainpk;0></color>? Está que<br>no para<slide><br>últimamente... <$emotion(1,29)><$voicel(1,8)>¿Tú sabes algo?"
msgstr "<oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>¿Qué mosca le picó <esa;0()><$cdef(27)><gevcmainpk;0></color>? Está que<br>no para<slide><br>últimamente... <$emotion(1,29)><$voicel(1,8)>¿Tú sabes algo?"

#. en: <$emotion(1,60)><$voicel(1,8)>...Hee hee, pretty good, right?<clear><br><$emotion(1,8)><$voicel(1,9)><$pkcry;0(1,2)>! ♪ Now I’ve got a question for you.<br>I was copying how another Pokémon talks just now. So...<slide><br><$emotion(1,29)><$voicel(1,8)>Who do you think I was copying?
msgctxt "1932:853"
msgid "...<clear><br><$emotion(1,60)><$voicel(1,8)>No te lo esperabas, ¿a que no?<clear><br><$emotion(1,8)><$voicel(1,9)>¡<$pkcry;0(1,2)>! Ahora quiero que me respondas a esta<br>pregunta: <$emotion(1,29)><$voicel(1,8)>¿a qué Pokémon crees que intentaba imitar?"
msgstr "...<clear><br><$emotion(1,60)><$voicel(1,8)>No te lo esperabas, ¿verdad?<clear><br><$emotion(1,8)><$voicel(1,9)>¡<$pkcry;0(1,2)>! Ahora quiero que me respondas a esta<br>pregunta: <$emotion(1,29)><$voicel(1,8)>¿a qué Pokémon crees que intentaba imitar?"

#. en: <$comeff(1,20)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>That’s right! Wow, you really know everyone super well,<br>don’t you, <$cdef(27)><pname;0></color>?
msgctxt "1932:854"
msgid "<$comeff(1,20)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Respuesta correcta! Se nota lo bien que nos conoces<br>a todos."
msgstr ""

#. en: <oneline><$emotion(1,37)><$voicel(1,9)>Sorry! That’s incorrect. It was actually<br><$cdef(27)><apfquizpk;0(0)></color>!<slide><br>Maybe<slide><br>that<slide><br>was<slide><br>a<slide><br>bit<slide><br>too<slide><br>hard, huh.
msgctxt "1932:855"
msgid "<oneline><$emotion(1,37)><$voicel(1,9)>Jopé, qué pena... ¡Has fallado! Estaba imitando<br><esa;0()><$cdef(27)><apfquizpk;0(0)></color>.<clear><br>No sé, igual era muy difícil de adivinar..."
msgstr "<oneline><$emotion(1,37)><$voicel(1,9)>Ay, qué pena... ¡Fallaste! Estaba imitando<br><esa;0()><$cdef(27)><apfquizpk;0(0)></color>.<clear><br>No sé, quizás era muy difícil de adivinar..."

#. en: <$cdef(27)><$motion(1,666)><$facial(1,2)><$comeff(1,6)></color><$voicel(1,3)>Hm? You want me to hold on to that <$cdef(27)><fqty(1)><$ifull(432)></color> for you?<br><$emotion(1,60)><$voicel(1,6)>Sure thing!
msgctxt "1932:859"
msgid "<$cdef(27)><$motion(1,666)></color><$facial(1,2)><$comeff(1,6)><$voicel(1,3)>¿Un <$cdef(27)><fqty(1)><$ifull(432)></color>? ¿Para mí? <$emotion(1,60)><$voicel(1,6)>¡Vale, gracias!"
msgstr "<$cdef(27)><$motion(1,666)></color><$facial(1,2)><$comeff(1,6)><$voicel(1,3)>¿Un <$cdef(27)><fqty(1)><$ifull(432)></color>? ¿Para mí? <$emotion(1,60)><$voicel(1,6)>¡Bueno, gracias!"

#. en: <$voicel(1,9)><$emotion(1,15)>Whoa! That scared me! I think you should have this back!
msgctxt "1932:860"
msgid "<$voicel(1,9)><$emotion(1,15)>¡Ahí va, no me esperaba esto! Casi mejor te lo devuelvo."
msgstr "<$voicel(1,9)><$emotion(1,15)>¡Vaya, no me esperaba esto! Casi mejor te lo devuelvo."

#. en: <oneline><$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>Whoa! You startled me! I can’t believe that was you,<br><$cdef(27)><pname;0></color>!<slide><br><$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,8)>Your<slide><br>transformations<slide><br>are<slide><br>really good!<clear><br><$comeff(1,9)><$motion(1,801)><$voicel(1,10)>Oh, yeah! Here’s your <$cdef(27)><fqty(1)><$ifull(532)></color>!
msgctxt "1932:862"
msgid "<$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>¡Pero bueno! Menudo susto más tonto. Quién me iba<br>a decir que eras tú, <$cdef(27)><pname;0></color>.<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,8)>Sabes transformarte a las mil maravillas, la verdad.<br><wait(1.0)><$comeff(1,9)><$motion(1,801)><$voicel(1,10)>Toma, te acabas de ganar esta <$cdef(27)><fqty(1)><$ifull(532)></color>."
msgstr "<$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>¡Pero bueno! Qué susto más tonto. Quién me iba<br>a decir que eras tú, <$cdef(27)><pname;0></color>.<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,8)>Sabes transformarte a las mil maravillas, la verdad.<br><wait(1.0)><$comeff(1,9)><$motion(1,801)><$voicel(1,10)>Toma, te acabas de ganar esta <$cdef(27)><fqty(1)><$ifull(532)></color>."

#. en: <oneline><$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>Whoa! You startled me! I can’t believe that was you,<br><$cdef(27)><pname;0></color>!<slide><br><$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,8)>Your<slide><br>transformations<slide><br>are<slide><br>really good!<clear><br><$comeff(1,9)><$motion(1,801)><$voicel(1,10)>Oh, yeah! Here’s your <$cdef(27)><fqty(1)><$ifull(532)></color>!
msgctxt "1932:863"
msgid "<$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>¡Pero bueno! Menudo susto más tonto. Quién me iba<br>a decir que eras tú, <$cdef(27)><pname;0></color>.<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,8)>Sabes transformarte a las mil maravillas, la verdad.<br><wait(1.0)><$comeff(1,9)><$motion(1,801)><$voicel(1,10)>Toma, te acabas de ganar estas <$cdef(27)><fqty(2)><$ifull(532)></color>."
msgstr "<$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>¡Pero bueno! Qué susto más tonto. Quién me iba<br>a decir que eras tú, <$cdef(27)><pname;0></color>.<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,8)>Sabes transformarte a las mil maravillas, la verdad.<br><wait(1.0)><$comeff(1,9)><$motion(1,801)><$voicel(1,10)>Toma, te acabas de ganar estas <$cdef(27)><fqty(2)><$ifull(532)></color>."

#. en: <$comeff(1,5)><$motion(1,803)><$voicel(1,10)>What? Now I’m really curious!<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>...But I guess lots of Pokémon feel that way,<br>don’t they?<clear><br><$emotion(1,38)><$voicel(1,9)>I can wait it out this time, but invite me next time, OK?<br>I’ll be waiting!
msgctxt "1932:902"
msgid "<$comeff(1,5)><$motion(1,803)><$voicel(1,10)>¡Hala! La verdad es que tengo muchas ganas de ir...<br><wait(0.4)><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>pero creo que hay otros Pokémon que también tienen<slide><br>un montón de ganas, así que les cedo el turno.<clear><br><$emotion(1,38)><$voicel(1,9)>Invítame a la próxima, ¿vale?"
msgstr "<$comeff(1,5)><$motion(1,803)><$voicel(1,10)>¡Guau! La verdad es que tengo muchas ganas de ir...<br><wait(0.4)><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>pero creo que hay otros Pokémon que también tienen<slide><br>un montón de ganas, así que les cedo el turno.<clear><br><$emotion(1,38)><$voicel(1,9)>Invítame a la próxima, ¿sí?"

#. en: <oneline><$comeff(1,14)><$motion(1,803)><$voicel(1,5)>I should really head home now... Today went by so fast!<clear><br><$emotion(1,8)><$voicel(1,10)>Let’s definitely hang out again soon,<br><$cdef(27)><pname;0></color>!
msgctxt "1932:903"
msgid "<$comeff(1,14)><$motion(1,803)><$voicel(1,5)>Es hora de que me vaya a casa... La verdad es que se me<br>ha pasado el tiempo volando.<clear><br><$emotion(1,8)><$voicel(1,10)>¡Prométeme que repetiremos!"
msgstr "<$comeff(1,14)><$motion(1,803)><$voicel(1,5)>Es hora de que me vaya a casa... La verdad es que se me<br>pasó el tiempo volando.<clear><br><$emotion(1,8)><$voicel(1,10)>¡Prométeme que repetiremos!"

#. en: <$emotion(1,14)><$voicel(1,7)>Really? It’s OK for me to visit? Then I’d love to!<clear><br><$emotion(1,8)><$voicel(1,9)>I’ll be sure to drop by later!
msgctxt "1932:904"
msgid "<$emotion(1,14)><$voicel(1,7)>¿De verdad? ¡Me encantaría!<clear><br><$emotion(1,8)><$voicel(1,9)>Vale, pues en un rato me paso. ¡Espérame, eh!"
msgstr "<$emotion(1,14)><$voicel(1,7)>¿De verdad? ¡Me encantaría!<clear><br><$emotion(1,8)><$voicel(1,9)>Bueno, pues en un rato me paso. ¡Espérame, eh!"

#. en: <oneline><$emotion(1,29)><$voicel(1,7)>Hey, <$cdef(27)><pname;0></color>, where’re you headed?<br>Can<slide><br>I come?
msgctxt "1932:905"
msgid "<oneline><$emotion(1,29)><$voicel(1,7)>¿A dónde vas, <$cdef(27)><pname;0></color>? ¿Puedo ir<br>contigo?"
msgstr ""

#. en: <$emotion(1,14)><$voicel(1,7)>Awww, OK... I hope I can tag along some other time!
msgctxt "1932:906"
msgid "<$emotion(1,14)><$voicel(1,7)>Jo, vale, ¡pero invítame la próxima vez!"
msgstr "<$emotion(1,14)><$voicel(1,7)>Ay, bueno, ¡pero invítame la próxima vez!"

#. en: <$emotion(1,8)><$voicel(1,9)>Thanks for letting me tag along! It was so much fun doing<br>all sorts of things with you!
msgctxt "1932:907"
msgid "<$emotion(1,8)><$voicel(1,9)>Gracias por invitarme a ir contigo. ¡Ha estado genial!"
msgstr "<$emotion(1,8)><$voicel(1,9)>Gracias por invitarme a ir contigo. ¡Estuvo genial!"

#. en: <oneline><$comeff(1,5)><$facial(1,1)><$motion(1,803)><$voicel(1,7)>Oh hi there, <$cdef(27)><pname;0></color>! I let myself in.<clear><br><$comeff(1,6)><$voicel(1,8)>I’m <$cdef(27)><nowner;2></color>’s friend. Remember me?<clear><br><$comeff(1,21)><$facial(1,1)><$motion(1,805)><$voicel(1,5)>Everything’s so different from where I live... It’s really<br>fascinating!
msgctxt "1932:921"
msgid "<oneline><$comeff(1,5)><$facial(1,1)><$motion(1,803)><$voicel(1,7)>¡Hola, <$cdef(27)><pname;0></color>! He venido de visita.<br>Soy <gen;-3(el,la)> amig<gen;-3(o,a)><slide><br>de <$cdef(27)><nowner;2></color>.<slide><br><$comeff(1,6)><$voicel(1,8)>¿Te acuerdas?<clear><br><$comeff(1,21)><$facial(1,1)><$motion(1,805)><$voicel(1,5)>Jo, qué sensación tan curiosa... Esto no se parece en nada<br>al lugar donde vivo yo."
msgstr "<oneline><$comeff(1,5)><$facial(1,1)><$motion(1,803)><$voicel(1,7)>¡Hola, <$cdef(27)><pname;0></color>! Vine de visita.<br>Soy <gen;-3(el,la)> amig<gen;-3(o,a)><slide><br>de <$cdef(27)><nowner;2></color>.<slide><br><$comeff(1,6)><$voicel(1,8)>¿Te acuerdas?<clear><br><$comeff(1,21)><$facial(1,1)><$motion(1,805)><$voicel(1,5)>Vaya, qué sensación tan curiosa... Esto no se parece en nada<br>al lugar donde vivo yo."
