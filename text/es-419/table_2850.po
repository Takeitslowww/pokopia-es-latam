#. en: <$voicel(3,7)><$comeff(3,21)><$motion(3,1148)>Yooo! We’re almost there!!! <$voicel(3,10)><$comeff(3,9)><$motion(3,1147)>Keep on makin’ the <$cdef(27)>mood </color>as<br>awesome as possible!
msgctxt "2850:55"
msgid "<$voicel(3,7)><$comeff(3,21)><$motion(3,1148)>¡La leche! ¡Estamos on fire, <gen;-2(tío,tía)>, pero todavía nos falta<br>un empujoncito!<clear><br><$voicel(3,10)><$comeff(3,9)><$motion(3,1147)>¡Sigue levantando el <$cdef(27)>ánimo</color>, que esto va a ser DINAMITA!"
msgstr "<$voicel(3,7)><$comeff(3,21)><$motion(3,1148)>¡Guau! ¡Estamos on fire, <gen;-2(tío,tía)>, pero todavía nos falta<br>un empujoncito!<clear><br><$voicel(3,10)><$comeff(3,9)><$motion(3,1147)>¡Sigue levantando el <$cdef(27)>ánimo</color>, que esto va a ser DINAMITA!"

