msgid "<$voicel(3,8)><$comeff(3,4)><$motion(3,1149)>¡Nos falta un toque final para petarlo del todo!"
msgstr "<$voicel(3,8)><$comeff(3,4)><$motion(3,1149)>¡Nos falta un toque final para que sea épica!"

#. en: <$voicel(3,9)><$comeff(3,9)><$motion(3,1147)>But this is it, yo! We’re REALLY almost there! Maybe go ask<br>around and see if anyone has any ideas!
msgctxt "2850:65"
msgid "<$voicel(3,9)><$comeff(3,9)><$motion(3,1147)>Ahora sí que sí, este es el último empujoncito, literal.<clear><br>¡Para manifestar la tarde más loca del universo, tenemos<br>que hablar con los demás Pokémon y ver qué vibra hay!"
msgstr ""

