#. en: <$voicel(3,6)><$comeff(3,10)><$motion(3,1137)>The vibes are gettin’ pretty nice, huh?<clear><br><$voicel(3,7)><$comeff(3,5)><$motion(3,1138)>But I know this isn’t all you got! I believe in you, yo!<br><$voicel(3,10)><$comeff(3,9)><$motion(3,1147)>Let’s make the <$cdef(27)>mood </color>as awesome as possible!
msgctxt "2850:36"
msgid "<$voicel(3,6)><$comeff(3,10)><$motion(3,1137)>¡Vamos mejorando, <gen;-2(tío,tía)>!<clear><br><$voicel(3,7)><$comeff(3,5)><$motion(3,1138)>Pero yo sé que tú y yo podemos revolucionar las vibras<br>aún más. <$voicel(3,10)><$comeff(3,9)><$motion(3,1147)>¡Cuento contigo para seguir subiendo el <$cdef(27)>ánimo</color>!"
msgstr ""

