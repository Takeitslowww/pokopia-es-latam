msgstr ""

#. en: <$voicel(3,3)><$comeff(3,7)><$motion(3,1134)>Not so hot to be honest, yo. But that just means<br>there’s nowhere to go but up, up, UP!<clear><br><$voicel(3,8)><$comeff(3,9)><$motion(3,1144)>Let’s make the <$cdef(27)>mood </color>AWESOME!
msgctxt "2850:18"
msgid "<$voicel(3,3)><$comeff(3,7)><$motion(3,1134)>¡Qué fail, tí<gen;-2(o,a)>! ¡Como no mejoremos un poco las vibras,<br>la peña se va a aplatanar! Pero no te rayes, que desde<slide><br>aquí solo podemos ir a mejor.<clear><br><$voicel(3,8)><$comeff(3,9)><$motion(3,1144)>¡Ubícate y vamos a levantar el <$cdef(27)>ánimo</color> a full!"
msgstr "<$voicel(3,3)><$comeff(3,7)><$motion(3,1134)>¡Qué fail, amig<gen;-2(o,a)>! ¡Si no mejoramos un poco las vibras,<br>la gente se va a aburrir! Pero tranqui, que desde<slide><br>aquí solo podemos ir a mejor.<clear><br><$voicel(3,8)><$comeff(3,9)><$motion(3,1144)>¡Arriba, vamos a levantar el <$cdef(27)>ánimo</color> a full!"

#. en: <$voicel(3,7)><$emotion(3,49)>You wanna know how the <$cdef(27)>mood</color>’s doin’? I got you!
