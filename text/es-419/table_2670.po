#. en: <$comeff(3,15)><$facial(3,14)>Zzzzzzz...
msgctxt "2670:0"
msgid "<$comeff(3,15)><$facial(3,14)>Zzz... Zzz... Snor..."
msgstr ""

#. en: <$comeff(1,7)><$facial(1,9)><$motion(1,667)><$voicel(1,1)>Hrmmm... <$cdef(27)>Snorlax</color>’s flower bed-head is only worth <$cdef(27)><illuminance;0><br>bloom <qty;0(point,points)></color>. The area’s not nearly bright enough yet.
msgctxt "2670:1"
msgid "<$comeff(1,7)><$facial(1,9)><$motion(1,667)><$voicel(1,1)>Hmm... A la flor ahora mismo le daría <$cdef(27)><illuminance;0> punt<qty;0(o,os)></color>.<br>Le hace falta muchísima más luz..."
msgstr ""

#. en: <$comeff(3,15)><$facial(3,14)>Zzzzzzz...
msgctxt "2670:2"
msgid "<$comeff(3,15)><$facial(3,14)>Zzz... Zzz... Snorrr..."
msgstr ""

#. en: <$comeff(1,14)><$facial(1,9)><$motion(1,663)><$voicel(1,3)>I’d give <$cdef(27)>Snorlax</color>’s flower bed-head about <$cdef(27)><illuminance;0> bloom<br><qty;0(point,points)> </color>now. This area still isn’t bright enough, I’d say.
msgctxt "2670:3"
msgid "<$comeff(1,14)><$facial(1,9)><$motion(1,663)><$voicel(1,3)>A la flor ahora mismo le daría <$cdef(27)><illuminance;0> punt<qty;0(o,os)></color>. Aún no tiene<br>suficiente luz."
msgstr ""

#. en: <$comeff(3,15)><$facial(3,14)>Zzzzzzz...
msgctxt "2670:4"
msgid "<$comeff(3,15)><$facial(3,14)>Zzz... Zzz... Lax..."
msgstr ""

#. en: <$comeff(1,3)><$facial(1,2)><$motion(1,803)><$voicel(1,5)><$cdef(27)>Snorlax</color>’s flower bed-head is up to about <$cdef(27)><illuminance;0> bloom<br>points </color>now. Keep up the good work illuminating the town!
msgctxt "2670:5"
msgid "<$comeff(1,3)><$facial(1,2)><$motion(1,803)><$voicel(1,5)>A la flor ahora mismo le daría <$cdef(27)><illuminance;0> punt<qty;0(o,os)></color>. Vamos bien<br>encaminados. Hay que seguir iluminando el vecindario."
msgstr ""

#. en: <$comeff(3,15)><$facial(3,14)>Zzzzzzz...<br>Nngh... Zzz...
msgctxt "2670:6"
msgid "<$comeff(3,15)><$facial(3,14)>Zzz... Zzz... Snooor... Lax..."
msgstr ""

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,664)><$voicel(1,7)>I’d give <$cdef(27)>Snorlax</color>’s flower bed-head a solid <$cdef(27)><illuminance;0> bloom<br>points</color>. There’s even another bud now!
msgctxt "2670:7"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,664)><$voicel(1,7)>A la flor ahora mismo le daría <$cdef(27)><illuminance;0> punt<qty;0(o,os)></color>. Y si te fijas,<br>¡le ha salido otro brote!"
msgstr ""

#. en: <$comeff(3,15)><$facial(3,14)>Zzzzzzz...<br>Nngh... Zzz...
msgctxt "2670:8"
msgid "<$comeff(3,15)><$facial(3,14)>Zzz... Zzz... Snor... Laaax..."
msgstr ""

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,7)><$cdef(27)>Snorlax</color>’s flower bed-head is up to <$cdef(27)><illuminance;0> bloom points</color>.<br>Just a bit more, and that second flower should bloom!
msgctxt "2670:9"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>A las flores ahora mismo les daría <$cdef(27)><illuminance;0> punt<qty;0(o,os)></color>.<br>¡Parece que el segundo brote está a punto de florecer!"
msgstr ""

#. en: <$comeff(3,15)><$facial(3,14)>Zzzzzzz...<br>Nngh... Zzz...
msgctxt "2670:10"
msgid "<$comeff(3,15)><$facial(3,14)>Zzz... Snooor... Zzz... Lax..."
msgstr ""

#. en: <$comeff(1,14)><$facial(1,2)><$motion(1,666)><$voicel(1,5)>Snorlax’s flower bed-head is now worth <$cdef(27)><illuminance;0> bloom points</color>.<br>I’m guessing the number of flowers may still increase...
msgctxt "2670:11"
msgid "<$comeff(1,14)><$facial(1,2)><$motion(1,666)><$voicel(1,5)>A las flores ahora mismo les daría <$cdef(27)><illuminance;0> punt<qty;0(o,os)></color>.<br>Algo me dice que todavía podrían salirle más..."
msgstr ""

#. en: <$comeff(3,15)><$facial(3,14)>Zzzzzzz...<br>Nngh... Nrrrgh... Zzz...
msgctxt "2670:12"
msgid "<$comeff(3,15)><$facial(3,14)>Zzz... Zzz... Gñe... Snor..."
msgstr ""

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,659)><$voicel(1,9)>You’ve gotten <$cdef(27)>Snorlax</color>’s flower bed-head up to <$cdef(27)><illuminance;0> bloom<br>points</color>. That’s excellent progress!
msgctxt "2670:13"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,659)><$voicel(1,9)>A las flores ahora mismo les daría <$cdef(27)><illuminance;0> punt<qty;0(o,os)></color>.<br>¡Siento que están a puntito de caramelo!"
msgstr "<$comeff(1,9)><$facial(1,4)><$motion(1,659)><$voicel(1,9)>A las flores ahora mismo les daría <$cdef(27)><illuminance;0> punt<qty;0(o,os)></color>.<br>¡Siento que ya están a puntito!"

#. en: <$comeff(3,15)><$facial(3,14)>Zzzzzzz...<br>Nngh... Nrrrgh... Zzz...
msgctxt "2670:14"
msgid "<$comeff(3,15)><$facial(3,14)>Zzz... Zzz... Gñe... Snor... Lax..."
msgstr ""

#. en: <$comeff(1,5)><$facial(1,4)><$motion(1,803)><$voicel(1,9)><$cdef(27)>Snorlax</color>’s flower bed-head is up to <$cdef(27)><illuminance;0> bloom points</color> now.<br>Just a little bit more ought to do it!
msgctxt "2670:15"
msgid "<$comeff(1,5)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>A las flores ahora mismo les daría <$cdef(27)><illuminance;0> punt<qty;0(o,os)></color>.<br>¡Un último empujoncito y ya lo tenemos!"
msgstr ""

#. en: <$comeff(3,15)><$facial(3,14)>Zzz... Zzz... Nnngh...
msgctxt "2670:21"
msgid "<$comeff(3,15)><$facial(3,14)>Zzz... Zzz... Ngh..."
msgstr ""

#. en: They should be close to waking up now! What can we do<br>to provide that last little push?
msgctxt "2670:22"
msgid "¡Parece que está a punto de despertar! Si tuviésemos<br>alguna forma de darle un último estímulo..."
msgstr "¡Parece que está a punto de despertar! Si tuviéramos<br>alguna forma de darle un último estímulo..."

#. en: <$comeff(2,3)><$facial(2,2)><$motion(2,803)><$voicel(2,8)>Shall we go check in on <$cdef(27)>Snorlax</color>?
msgctxt "2670:28"
msgid "<$comeff(2,3)><$facial(2,2)><$motion(2,803)><$voicel(2,8)>Es buen momento para hablar con <$cdef(27)>Snorlax</color>."
msgstr ""

#. en: <$comeff(2,14)><$facial(2,2)><$motion(2,666)><$voicel(2,4)><$facial(2,9)>I wonder if they’ll have woken up by now...
msgctxt "2670:29"
msgid "<$comeff(2,14)><$facial(2,2)><$motion(2,666)><$voicel(2,4)><$facial(2,9)>Espero que ahora se despierte..."
msgstr ""

#. en: <$comeff(1,3)><$facial(1,4)><$motion(1,661)><$voicel(1,7)>With this much light, I daresay even <$cdef(27)>Snorlax </color>ought to have<br>woken up.
msgctxt "2670:35"
msgid "<$comeff(1,3)><$facial(1,4)><$motion(1,661)><$voicel(1,7)>Con esta cantidad de luz tan abrumadora, ni el mismísimo<br><$cdef(27)>Snorlax </color>podría hacerse el remolón."
msgstr "<$comeff(1,3)><$facial(1,4)><$motion(1,661)><$voicel(1,7)>Con esta cantidad de luz tan abrumadora, ni el mismísimo<br><$cdef(27)>Snorlax </color>podría seguir durmiendo."

#. en: <oneline><$comeff(1,6)><$facial(1,2)><$motion(1,666)><$voicel(1,5)><$cdef(27)><pname;0></color>, would you please go check on<br>how<slide><br><$cdef(27)>Snorlax</color><slide><br>is doing?
msgctxt "2670:36"
msgid "<$cdef(27)><$comeff(1,6)></color><$facial(1,2)><$motion(1,666)><$voicel(1,5)>¿Por qué no le echas un vistazo para evaluar la situación,<br><$cdef(27)><pname;0></color>?"
msgstr ""

#. en: <$comeff(4,6)><$facial(4,2)><$motion(4,667)><$voicel(4,4)>How much longer are they gonna sleep?
msgctxt "2670:38"
msgid "<$comeff(4,6)><$facial(4,2)><$motion(4,667)><$voicel(4,4)>¿Hasta cuándo piensa dormir? ¡Ya hay que ser vago!"
msgstr "<$comeff(4,6)><$facial(4,2)><$motion(4,667)><$voicel(4,4)>¿Hasta cuándo piensa dormir? ¡Qué perezoso!"

#. en: <$comeff(4,5)><$facial(4,4)><$motion(4,801)><$voicel(4,9)>I didn’t expect it to get THIS bright! Let’s go check on<br><$cdef(27)>Snorlax</color>!
msgctxt "2670:39"
msgid "<$comeff(4,5)><$facial(4,4)><$motion(4,801)><$voicel(4,9)>¡No me esperaba tanta luz de repente! ¿Comprobamos<br>a ver si <$cdef(27)>Snorlax </color>se despierta?"
msgstr ""

#. en: <$comeff(4,9)><$facial(4,4)><$motion(4,801)><$voicel(4,7)>Yooo! I bet even <$cdef(27)>Snorlax </color>couldn’t sleep through<br>this brightness!
msgctxt "2670:40"
msgid "<$comeff(4,9)><$facial(4,4)><$motion(4,801)><$voicel(4,7)>¡Con toda esta luz, <$cdef(27)>Musgorlax </color>ya no tiene excusa!"
msgstr ""

#. en: <$comeff(4,3)><$facial(4,4)><$motion(4,801)><$voicel(4,7)>It’s SO BRIGHT now! Does that mean <$cdef(27)>Snorlax </color>is gonna<br>wake up?!
msgctxt "2670:41"
msgid "<$comeff(4,3)><$facial(4,4)><$motion(4,801)><$voicel(4,7)>¡Hay mogollón de luz, <$cdef(27)>Snorlax </color>tiene que despertar sí o sí!"
msgstr "<$comeff(4,3)><$facial(4,4)><$motion(4,801)><$voicel(4,7)>¡Hay un montón de luz, <$cdef(27)>Snorlax </color>tiene que despertar sí o sí!"

#. en: <$comeff(2,6)><$facial(2,2)><$motion(2,666)><$voicel(2,5)>How did it go with <$cdef(27)>Snorlax</color>?
msgctxt "2670:42"
msgid "<$comeff(2,6)><$facial(2,2)><$motion(2,666)><$voicel(2,5)>¿Qué tal se encuentra <$cdef(27)>Snorlax</color>? ¿Ha habido suerte?"
msgstr "<$comeff(2,6)><$facial(2,2)><$motion(2,666)><$voicel(2,5)>¿Qué tal se encuentra <$cdef(27)>Snorlax</color>? ¿Hubo suerte?"

#. en: <$comeff(1,14)><$facial(1,9)><$motion(1,806)><$voicel(1,3)>We’re getting quite close to waking them, but no luck yet.<clear><br><$comeff(1,10)><$facial(1,2)><$motion(1,661)><$voicel(1,8)>That’s some serious dedication to sleep!
msgctxt "2670:43"
msgid "<$comeff(1,14)><$facial(1,9)><$motion(1,806)><$voicel(1,3)>Parece que está a punto, pero aún no logra despertar...<br><$comeff(1,10)><$facial(1,2)><$motion(1,661)><$voicel(1,8)>Desde luego, su apego por el sueño es pasmoso."
msgstr ""

#. en: <$comeff(2,3)><$facial(2,2)><$motion(2,803)><$voicel(2,8)>I wonder... Do we need to up the excitement level around<br>here even further?
msgctxt "2670:44"
msgid "<$comeff(2,3)><$facial(2,2)><$motion(2,803)><$voicel(2,8)>¿Y si le diéramos un estímulo más potente?"
msgstr ""

#. en: <$comeff(1,7)><$facial(1,9)><$motion(1,802)><$voicel(1,4)>Hrmmm... Perhaps, but how could we possibly do any more<br>than we already have?
msgctxt "2670:45"
msgid "<$comeff(1,7)><$facial(1,9)><$motion(1,802)><$voicel(1,4)>Hmm... ¿Pero qué más podríamos hacer?"
msgstr ""

#. en: <$comeff(1,6)><$facial(1,2)><$motion(1,803)><$voicel(1,8)>Hm? What was that sound?
msgctxt "2670:46"
msgid "<$comeff(1,6)><$facial(1,2)><$motion(1,803)><$voicel(1,8)>¿Eh? ¿Qué ha sido ese ruido?"
msgstr "<$comeff(1,6)><$facial(1,2)><$motion(1,803)><$voicel(1,8)>¿Eh? ¿Qué fue ese ruido?"

#. en: <$comeff(1,11)><$facial(1,2)><$motion(1,665)><$voicel(1,9)>Wh-what in the world?! <$cdef(27)>Snorlax </color>has been struck<br>by lightning!
msgctxt "2670:52"
msgid "<$comeff(1,11)><$facial(1,2)><$motion(1,665)><$voicel(1,9)>¡N-no doy crédito a lo que veo! ¡¿Acaba de caerle un rayo<br>a <$cdef(27)>Snorlax</color>?!"
msgstr ""

#. en: <$voicel(1,7)>Not only that—<wait(0.8)><$comeff(1,5)><$facial(1,2)><$motion(1,664)>a Pokémon I’ve never seen before has<br>appeared over there!
msgctxt "2670:53"
msgid "<$voicel(1,7)>¿Y quién...? <wait(0.8)><$comeff(1,5)><$facial(1,2)><$motion(1,664)>¿Quién es ese Pokémon de allí?"
msgstr "<$voicel(1,7)>¿Y quién...? <wait(0.8)><$comeff(1,5)><$facial(1,2)><$motion(1,664)>¿Quién es ese Pokémon de allá?"

#. en: <$comeff(2,3)><$facial(2,2)><$motion(2,665)><$voicel(2,8)>Why is that Pokémon...
msgctxt "2670:54"
msgid "<$comeff(2,3)><$facial(2,2)><$motion(2,665)><$voicel(2,8)>¡Pero si es...!"
msgstr ""

#. en: <$comeff(1,10)><$facial(1,2)><$motion(1,661)><$voicel(1,7)><$cdef(27)><pname;0></color>! You can leave <$cdef(27)>Snorlax </color>to us!<clear><br><$comeff(1,6)><$facial(1,2)><$motion(1,801)><$voicel(1,8)>Go find out what that other Pokémon has to say!
msgctxt "2670:55"
msgid "<oneline><$comeff(1,10)><$facial(1,2)><$motion(1,661)><$voicel(1,7)>¡<$cdef(27)><pname;0></color>! Nosotros nos hacemos cargo<br>de <$cdef(27)>Snorlax</color>.<clear><br><$comeff(1,6)><$facial(1,2)><$motion(1,801)><$voicel(1,8)>¿Por qué no vas tú a hablar con ese Pokémon?"
msgstr ""

#. en: <$comeff(1,6)><$facial(1,2)><$motion(1,661)><$voicel(1,8)>Could you go find out what that Pokémon has to say? You<br>can leave <$cdef(27)>Snorlax </color>to us!
msgctxt "2670:60"
msgid "<$facial(1,2)><$motion(1,661)><$voicel(1,8)>Deja a <$cdef(27)>Snorlax </color>en nuestras manos. <$comeff(1,6)>¿Por qué no vas tú<br>a hablar con ese Pokémon?"
msgstr ""

#. en: <$comeff(2,14)><$facial(2,9)><$motion(2,667)><$voicel(2,4)>I hope <$cdef(27)>Snorlax </color>is all right...
msgctxt "2670:73"
msgid "<$comeff(2,14)><$facial(2,9)><$motion(2,667)><$voicel(2,4)>Espero que <$cdef(27)>Snorlax </color>se encuentre bien..."
msgstr ""

#. en: <$comeff(4,5)><$facial(4,2)><$motion(4,665)><$voicel(4,8)>What the heck was that sound?!
msgctxt "2670:79"
msgid "<$comeff(4,5)><$facial(4,2)><$motion(4,665)><$voicel(4,8)>¡¿Qué ha sido ese estruendo?!"
msgstr "<$comeff(4,5)><$facial(4,2)><$motion(4,665)><$voicel(4,8)>¡¿Qué fue ese estruendo?!"

#. en: <$comeff(4,23)><$facial(4,9)><$motion(4,802)><$voicel(4,2)>L-lightning! I’m scared!
msgctxt "2670:85"
msgid "<$comeff(4,23)><$facial(4,9)><$motion(4,802)><$voicel(4,2)>¡Los truenos no me gustan nada!"
msgstr ""

#. en: <$comeff(4,14)><$facial(4,9)><$motion(4,806)><$voicel(4,3)>Y-yooo, that HAD to have woken up <$cdef(27)>Snorlax</color>...
msgctxt "2670:91"
msgid "<$comeff(4,14)><$facial(4,9)><$motion(4,806)><$voicel(4,3)>G-garrampazo épico... Ni siquiera <$cdef(27)>Musgorlax </color>podría seguir<br>durmiendo después de algo así..."
msgstr "<$comeff(4,14)><$facial(4,9)><$motion(4,806)><$voicel(4,3)>R-rayazo épico... Ni siquiera <$cdef(27)>Musgorlax </color>podría seguir<br>durmiendo después de algo así..."

#. en: <$comeff(4,6)><$facial(4,2)><$motion(4,805)><$voicel(4,8)>What WAS that just now? Thunder?
msgctxt "2670:97"
msgid "<$comeff(4,6)><$facial(4,2)><$motion(4,805)><$voicel(4,8)>¿Qué ha sido ese ruido? ¿Un trueno?"
msgstr "<$comeff(4,6)><$facial(4,2)><$motion(4,805)><$voicel(4,8)>¿Qué fue ese ruido? ¿Un trueno?"

#. en: <$comeff(3,23)><$voicel(3,6)>Nngh? Ngh... NNNGH!
msgctxt "2670:103"
msgid "<$comeff(3,23)><$voicel(3,6)>S-S-S-Snooor... l-l-l-laaax..."
msgstr ""

#. en: <$cdef(27)>Snorlax</color> woke up, but it seems they can’t move because of<br>the shock from the lightning!
msgctxt "2670:104"
msgid "¡Parece que ha despertado, pero el rayo lo ha dejado<br>inmovilizado!"
msgstr "¡Parece que despertó, pero el rayo lo dejó<br>inmovilizado!"
