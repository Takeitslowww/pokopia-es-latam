#. en: <$emotion(1,14)><$voicel(1,5)>Hey, heyyy! Not sure we’ve met before. It’d be great if we<br>could be friends! <$emotion(1,8)><$voicel(1,10)>We can do all sorts of stuff together!
msgctxt "2049:3"
msgid "<$emotion(1,14)><$voicel(1,5)>¡Ey! Yo a ti no te tengo vist<gen;-2(o,a)> por aquí. ¿Quieres tenerme<br>de amig<gen;-3(o,a)>? <$emotion(1,8)><$voicel(1,10)>¡Podemos hacer la tira de planes!"
msgstr "<$emotion(1,14)><$voicel(1,5)>¡Ey! Yo a ti no te había vist<gen;-2(o,a)> por aquí. ¿Quieres tenerme<br>de amig<gen;-3(o,a)>? <$emotion(1,8)><$voicel(1,10)>¡Podemos hacer un montón de planes!"

#. en: <oneline><$emotion(1,29)><$voicel(1,7)><$pkcry;0(1,2)>! Hey, heyyy! You friends<br>with <$cdef(27)><nowner;2></color>?<clear><br><$emotion(1,38)><$voicel(1,9)>If so, I bet we could be friends too, bud! Can I call ya bud?<br>I’m gonna call ya bud.
msgctxt "2049:4"
msgid "<oneline><$emotion(1,29)><$voicel(1,7)>¡<$pkcry;0(1,2)>! Espera, déjame adivinar...<br>Tú eres amig<gen;-2(o,a)><slide><br>de <$cdef(27)><nowner;2></color>, ¿no?<clear><br><$emotion(1,38)><$voicel(1,9)>Pues que no se diga. A partir de hoy, somos colegas."
msgstr "<oneline><$emotion(1,29)><$voicel(1,7)>¡<$pkcry;0(1,2)>! Espera, déjame adivinar...<br>Tú eres amig<gen;-2(o,a)><slide><br>de <$cdef(27)><nowner;2></color>, ¿no?<clear><br><$emotion(1,38)><$voicel(1,9)>Pues que no se diga. A partir de hoy, somos amigos."

#. en: <oneline><$emotion(1,29)><$voicel(1,7)><$pkcry;0(1,2)>! Hey, heyyy! You friends with<br><$cdef(27)><acqpname;2></color>?<clear><br><$emotion(1,38)><$voicel(1,9)>If so, I bet we could be friends too, bud! Can I call ya bud?<br>I’m gonna call ya bud.
msgctxt "2049:5"
msgid "<oneline><$emotion(1,29)><$voicel(1,7)>¡<$pkcry;0(1,2)>! Espera, déjame adivinar...<br>Tú eres amig<gen;-2(o,a)><slide><br>de <$cdef(27)><acqpname;2></color>, ¿no?<clear><br><$emotion(1,38)><$voicel(1,9)>Pues que no se diga. A partir de hoy, somos colegas."
msgstr "<oneline><$emotion(1,29)><$voicel(1,7)>¡<$pkcry;0(1,2)>! Espera, déjame adivinar...<br>Tú eres amig<gen;-2(o,a)><slide><br>de <$cdef(27)><acqpname;2></color>, ¿no?<clear><br><$emotion(1,38)><$voicel(1,9)>Pues que no se diga. A partir de hoy, somos amigos."

#. en: <oneline><$emotion(1,29)><$voicel(1,7)><$pkcry;0(1,2)>! Hey, heyyy! You friends with that<br>Pokémon<slide><br>over there?<clear><br><$emotion(1,38)><$voicel(1,9)>If so, I bet we could be friends too, bud! Can I call ya bud?<br>I’m gonna call ya bud.
msgctxt "2049:6"
msgid "<oneline><$emotion(1,29)><$voicel(1,7)>¡<$pkcry;0(1,2)>! Espera, déjame adivinar...<br>Tú eres amig<gen;-2(o,a)><slide><br>de otro Ditto, ¿no?<clear><br><$emotion(1,38)><$voicel(1,9)>Pues que no se diga. A partir de hoy, somos colegas."
msgstr "<oneline><$emotion(1,29)><$voicel(1,7)>¡<$pkcry;0(1,2)>! Espera, déjame adivinar...<br>Tú eres amig<gen;-2(o,a)><slide><br>de otro Ditto, ¿no?<clear><br><$emotion(1,38)><$voicel(1,9)>Pues que no se diga. A partir de hoy, somos amigos."

#. en: <$emotion(1,50)><$voicel(1,7)>Somethin’ around here smells SO good! Made me wanna<br>come right back home!
msgctxt "2049:8"
msgid "<$emotion(1,50)><$voicel(1,7)>Madre mía, aquí huele tan bien que no he podido<br>resistirme a pasarme a ver."
msgstr "<$emotion(1,50)><$voicel(1,7)>Vaya, aquí huele tan bien que no pude<br>resistirme a pasar a ver."

#. en: <oneline><$facial(1,4)><$comeff(1,10)><$motion(1,801)><$voicel(1,10)>Hey, heyyy! Well, if it isn’t <$cdef(27)><pname;0></color>!<br>It’s<slide><br>been<slide><br>a<slide><br>while, huh?
msgctxt "2049:9"
msgid "<$facial(1,4)><$comeff(1,10)><$motion(1,801)><$voicel(1,10)>¡Vaya, mira a quién tenemos por aquí! ¡Cuánto tiempo<br>sin verte el pelo, <$cdef(27)><pname;0></color>!"
msgstr ""

#. en: <$emotion(1,29)><$voicel(1,5)><$pkcry;0(1,2)>! Hey, heyyy. Who’re you?<clear><br><$comeff(1,9)><$facial(1,1)><$motion(1,806)><$voicel(1,7)>This is a pretty cool place. I think I’m gonna live here!<br><$emotion(1,38)><$voicel(1,10)>Hopefully I’ll see ya around and we can chat, yeah?
msgctxt "2049:10"
msgid "<$emotion(1,29)><$voicel(1,5)>¡<$pkcry;0(1,2)>! No sé quién eres, pero hola.<clear><br><$comeff(1,9)><$facial(1,1)><$motion(1,806)><$voicel(1,7)>Me gusta el ambiente que se respira en este lugar...<br>Tanto que creo que me voy a venir a vivir aquí. Hale.<clear><br><$emotion(1,38)><$voicel(1,10)>¡A ver si nos vemos y tenemos ocasión de charlar un rato!"
msgstr "<$emotion(1,29)><$voicel(1,5)>¡<$pkcry;0(1,2)>! No sé quién eres, pero hola.<clear><br><$comeff(1,9)><$facial(1,1)><$motion(1,806)><$voicel(1,7)>Me gusta el ambiente que se respira en este lugar...<br>Tanto que creo que me voy a venir a vivir aquí. Listo.<clear><br><$emotion(1,38)><$voicel(1,10)>¡A ver si nos vemos y tenemos ocasión de charlar un rato!"

#. en: <$comeff(1,3)><$motion(1,803)><$voicel(1,7)>Hm... This is just a hunch, but I’m guessin’ you’re not from<br>around here, are ya?<clear><br><$comeff(1,5)><$motion(1,806)><$voicel(1,9)>If you know someone who knows this place better than<br>anyone, send ’em my way!
msgctxt "2049:12"
msgid "<$comeff(1,3)><$motion(1,803)><$voicel(1,7)>¿Eh? Niñ<gen;-2(o,a)>, tú has venío del quinto pino, ¿a que sí?<clear><br><$comeff(1,5)><$motion(1,806)><$voicel(1,9)>Pero oye, si sabes de alguien que se conozca esta zona<br>de por aquí, ¡preséntamelo!"
msgstr "<$comeff(1,3)><$motion(1,803)><$voicel(1,7)>¿Eh? Niñ<gen;-2(o,a)>, tú vienes de muy lejos, ¿verdad?<clear><br><$comeff(1,5)><$motion(1,806)><$voicel(1,9)>Pero oye, si sabes de alguien que conozca esta zona<br>de por aquí, ¡preséntamelo!"

#. en: <oneline><$voicel(1,7)><$motion(1,805)><$comeff(1,21)><$facial(1,5)><$pkcry;0(1,2)>... I can’t stop starin’ at my hammer! It’s<br>just<slide><br>so<slide><br>cool, y’know?
msgctxt "2049:49"
msgid "<oneline><$voicel(1,7)><$motion(1,805)><$comeff(1,21)><$facial(1,5)><$pkcry;0(1,2)>... ¡Mi martillo es lo máximo!<br>¡Podría pasarme<slide><br>el día<slide><br>entero mirándolo!"
msgstr ""

#. en: <$comeff(1,17)><$facial(1,14)><$voicel(1,3)>I just love to relax and float around aimlessly, y’know?<br>Really helps me forget about any bad stuff goin’ on.
msgctxt "2049:50"
msgid "<$comeff(1,17)><$facial(1,14)><$voicel(1,3)>Cuando me relajo y me dejo mecer por las olas, es como<br>si todas mis preocupaciones se esfumasen de pronto."
msgstr "<$comeff(1,17)><$facial(1,14)><$voicel(1,3)>Cuando me relajo y me dejo mecer por las olas, es como<br>si todas mis preocupaciones se esfumaran de pronto."

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,659)><$voicel(1,8)>Check out this coat of mine, bud! Pretty awesome, huh.<br><$comeff(1,21)><$motionoff(1,804)><$voicel(1,9)>If you ever wanna pet it, gimme a shout! You can see<slide><br>for yourself just how awesome it feels!
msgctxt "2049:51"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,659)><$voicel(1,8)>¿Cómo ves mi pelaje? ¿A que te mola? ¡Si ya lo sé yo!<br>Y por ser tú, <$comeff(1,21)><$motionoff(1,804)><$voicel(1,9)>¡puedes acariciarlo siempre que quieras!"
msgstr "<$comeff(1,9)><$facial(1,4)><$motion(1,659)><$voicel(1,8)>¿Cómo ves mi pelaje? Te gusta, ¿no? ¡Si ya lo sé yo!<br>Y por ser tú, <$comeff(1,21)><$motionoff(1,804)><$voicel(1,9)>¡puedes acariciarlo siempre que quieras!"

#. en: <$comeff(1,3)><$facial(1,4)><$motion(1,806)><$voicel(1,10)>Another day of workin’ hard and bein’ awesome!<br><$comeff(1,10)><$facial(1,1)><$motion(1,661)><$voicel(1,7)>Can’t wait to show everyone what I’ve got—I just wanna<slide><br>grow up already!
msgctxt "2049:52"
msgid "<$comeff(1,3)><$facial(1,4)><$motion(1,806)><$voicel(1,10)>¡Venga, a darlo todo hoy también!<clear><br><$comeff(1,10)><$facial(1,1)><$motion(1,661)><$voicel(1,7)>¡No veas qué ganas tengo de crecer y que todo el mundo<br>me tome en serio de una vez!"
msgstr "<$comeff(1,3)><$facial(1,4)><$motion(1,806)><$voicel(1,10)>¡Vamos, a darlo todo hoy también!<clear><br><$comeff(1,10)><$facial(1,1)><$motion(1,661)><$voicel(1,7)>¡No sabes qué ganas tengo de crecer y que todo el mundo<br>me tome en serio de una vez!"

#. en: <oneline><$emotion(1,38)><$voicel(1,9)>It was a real challenge to make that<br><$cdef(27)><fqty(1)><class><usingp;0></color>!
msgctxt "2049:53"
msgid "<$emotion(1,38)><$voicel(1,9)>¡Anda que no le dimos bien al callo para construir<br><dart;0()><fqty(1)><$cdef(27)><usingp;0></color>!"
msgstr "<$emotion(1,38)><$voicel(1,9)>¡Sí que trabajamos duro para construir<br><dart;0()><fqty(1)><$cdef(27)><usingp;0></color>!"

#. en: <oneline><$comeff(1,21)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>That <$cdef(27)><fqty(1)><class><usingp;0> </color>over<br>there...is<slide><br>really,<slide><br>REALLY cool!
msgctxt "2049:54"
msgid "<$comeff(1,21)><$facial(1,4)><$motion(1,803)><$voicel(1,9)><fcap><dart;0()><$cdef(27)><fqty(1)><usingp;0></color>... ¡<qty;0(es,son)> la releche!"
msgstr "<$comeff(1,21)><$facial(1,4)><$motion(1,803)><$voicel(1,9)><fcap><dart;0()><$cdef(27)><fqty(1)><usingp;0></color>... ¡<qty;0(es,son)> lo máximo!"

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,8)>When you’re as good as me, choppin’ logs is easier<br>than breathin’!
msgctxt "2049:55"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,8)>A mí no hay tronco que se me resista. ¡Te puedo cortar<br>el que tú quieras en un visto y no visto!"
msgstr "<$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,8)>A mí no hay tronco que se me resista. ¡Te puedo cortar<br>el que tú quieras en un abrir y cerrar de ojos!"

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,805)><$voicel(1,7)>I just can’t stop treasure huntin’, ya know? Sometimes you<br>find the most AMAZING stuff. How could I stop?!
msgctxt "2049:56"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,805)><$voicel(1,7)>¡No puedo dejar de buscar tesoros! Menudo subidón<br>de adrenalina cuando me toca un premio de los gordos."
msgstr "<$comeff(1,10)><$facial(1,4)><$motion(1,805)><$voicel(1,7)>¡No puedo dejar de buscar tesoros! Qué subida<br>de adrenalina cuando me toca un premio de los gordos."

#. en: <$comeff(1,6)><$facial(1,1)><$motion(1,803)><$voicel(1,5)>Need my help, bud? I’m real good at crushin’ up berries<br>and stuff, y’know.
msgctxt "2049:57"
msgid "<$facial(1,1)><$motion(1,803)><$voicel(1,5)>Lo mío es pulverizar bayas y demás cosillas de esas.<br><$comeff(1,6)>¿Quieres que te eche una mano?"
msgstr "<$facial(1,1)><$motion(1,803)><$voicel(1,5)>Lo mío es pulverizar bayas y demás cositas de esas.<br><$comeff(1,6)>¿Quieres que te eche una mano?"

#. en: <$comeff(1,10)><$facial(1,4)><$motionoff(1,804)><$voicel(1,7)>I dunno if you can tell by lookin’ at me, but I’m a pro at<br>demolishin’ buildings! Gimme a yell if you ever need<slide><br>somethin’ <$cdef(27)><$spwfull(33)>d</color>!
msgctxt "2049:59"
msgid "<$comeff(1,10)><$facial(1,4)><$motionoff(1,804)><$voicel(1,7)>Aquí donde me ves, se me da de lujo <$cdef(27)><$spwfull(33)></color> cosas.<br>¡Avísame cuando quieras que me ponga a destruir algo!"
msgstr "<$comeff(1,10)><$facial(1,4)><$motionoff(1,804)><$voicel(1,7)>Aquí donde me ves, lo mío es <$cdef(27)><$spwfull(33)></color> cosas.<br>¡Avísame cuando quieras que me ponga a destruir algo!"

#. en: <$comeff(1,3)><$facial(1,1)><$motion(1,805)><$voicel(1,5)>Lemme know if you’re ever lookin’ for a specific Pokémon.<br>I can take ya right to ’em!
msgctxt "2049:60"
msgid "<$comeff(1,3)><$facial(1,1)><$motion(1,805)><$voicel(1,5)>Si buscas a algún Pokémon, dímelo y te llevo adonde<br>haga falta."
msgstr ""

#. en: <oneline><$emotion(1,60)><$voicel(1,7)><$cdef(27)><pname;0></color>! Hey heyyy! Gettin’ started<br>bright<slide><br>and<slide><br>early, huh?
msgctxt "2049:101"
msgid "<oneline><$emotion(1,60)><$voicel(1,7)>¡Ey, <$cdef(27)><pname;0></color>! ¿Cómo va? Trabajando<br>duro<slide><br>ya desde<slide><br>la mañaneja,<slide><br>¿eeeh?"
msgstr "<oneline><$emotion(1,60)><$voicel(1,7)>¡Ey, <$cdef(27)><pname;0></color>! ¿Cómo va? Trabajando<br>duro<slide><br>ya desde<slide><br>la mañanita,<slide><br>¿eeeh?"

#. en: <oneline><$emotion(1,8)><$voicel(1,7)>Hey heyyy, <$cdef(27)><pname;0></color>! Seein’ you in the<br>mornin’<slide><br>really<slide><br>gets<slide><br>my<slide><br>day<slide><br>off<slide><br>to<slide><br>a<slide><br>good<slide><br>start, bud!
msgctxt "2049:102"
msgid "<$emotion(1,8)><$voicel(1,7)>Toparme contigo bien temprano es la mejor forma de<br>empezar el día, <$cdef(27)><pname;0></color>."
msgstr ""

#. en: <$emotion(1,14)><$voicel(1,7)><$cdef(27)><pname;0></color>! Hey, bud! Busy as always, huh?
msgctxt "2049:103"
msgid "<oneline><$emotion(1,14)><$voicel(1,7)>¡Ey, <$cdef(27)><pname;0></color>! ¿Qué, ocupad<gen;-2(o,a)>, como<br>siempre?"
msgstr ""

#. en: <oneline><$emotion(1,29)><$voicel(1,5)>Hey, <$cdef(27)><pname;0></color>! What’s up, bud? You need<br>me<slide><br>for somethin’?
msgctxt "2049:104"
msgid "<oneline><$emotion(1,29)><$voicel(1,5)>Bo qué pacha, <$cdef(27)><pname;0></color>. ¿Necesitas que<br>te eche<slide><br>un cabo?"
msgstr "<oneline><$emotion(1,29)><$voicel(1,5)>¿Qué pasa, <$cdef(27)><pname;0></color>? ¿Necesitas que<br>te eche<slide><br>una mano?"

#. en: <$comeff(1,10)><$motion(1,666)><$voicel(1,7)>Y’know in the evening when the sky kinda looks like it’s on<br>fire? That’s cool. Real cool.
msgctxt "2049:105"
msgid "<$comeff(1,10)><$motion(1,666)><$voicel(1,7)>¿Sabes cuando el cielo del atardecer se pone casi como<br>si estuviera ardiendo? A mí es algo que me flipa."
msgstr "<$comeff(1,10)><$motion(1,666)><$voicel(1,7)>¿Sabes cuando el cielo del atardecer se pone casi como<br>si estuviera ardiendo? A mí es algo que me encanta."

#. en: <$emotion(1,38)><$voicel(1,7)>I dunno what it is, but something about the evening really<br>makes me wanna go for a little run. Ya feel me?
msgctxt "2049:106"
msgid "<$emotion(1,38)><$voicel(1,7)>No me preguntes por qué, pero cuando se pone el sol me<br>vienen unas ganas locas de echarme un par de carreracas."
msgstr "<$emotion(1,38)><$voicel(1,7)>No me preguntes por qué, pero cuando se pone el sol me<br>vienen unas ganas locas de echarme un par de carreritas."

#. en: <oneline><$emotion(1,14)><$voicel(1,5)>Hey heyyy, <$cdef(27)><pname;0></color>! It’s gotten pretty<br>dark, huh?
msgctxt "2049:107"
msgid "<$emotion(1,14)><$voicel(1,5)>Eyyy, ¿qué tal? Se nos ha echado la noche encima, ¿eh?<br>Y es oscura que no veas, <$cdef(27)><pname;0></color>."
msgstr "<$emotion(1,14)><$voicel(1,5)>Eyyy, ¿qué tal? Se nos echó la noche encima, ¿eh?<br>Y está oscurísima, <$cdef(27)><pname;0></color>."

#. en: <$emotion(1,38)><$voicel(1,9)>Nice night, huh? Makes me wanna go do somethin’!
msgctxt "2049:108"
msgid "<$emotion(1,38)><$voicel(1,9)>¡Pedazo noche se ha quedado! Dan ganas de<br>aprovecharla con alguna actividad."
msgstr "<$emotion(1,38)><$voicel(1,9)>¡Qué buena noche quedó! Dan ganas de<br>aprovecharla con alguna actividad."

#. en: <$emotion(1,38)><$voicel(1,7)>Pokémon who train their bodies to get stronger are real<br>cool, y’know? Like, uh...me, for example!
msgctxt "2049:109"
msgid "<$emotion(1,38)><$voicel(1,7)>Los Pokémon que entrenan son los que más molan.<br>Por ejemplo, hmm, no sé... ¡yo!"
msgstr "<$emotion(1,38)><$voicel(1,7)>Los Pokémon que entrenan son los más geniales.<br>Por ejemplo, hmm, no sé... ¡yo!"

#. en: <$emotion(1,14)><$voicel(1,9)>The more I look at you, the more I can tell—you’re cool,<br>bud! Real cool!
msgctxt "2049:110"
msgid "<$emotion(1,14)><$voicel(1,9)>Cuando te miro, pienso que eres la pera. Pero cuando te<br>vuelvo a mirar, me digo: \"No, ¡eres la repera!\"."
msgstr "<$emotion(1,14)><$voicel(1,9)>Cuando te miro, pienso que eres genial. Pero cuando te<br>vuelvo a mirar, me digo: \"No, ¡eres requetegenial!\"."

#. en: <$emotion(1,60)><$voicel(1,7)>Hey, heyyy! Need my help, huh? Yeah, you KNOW I’m up<br>for it!
msgctxt "2049:111"
msgid "<$emotion(1,60)><$voicel(1,7)>¡Ey, qué pasa! ¿Necesitas mi ayuda? Qué buen ojo tienes,<br>¡faltaría más!"
msgstr "<$emotion(1,60)><$voicel(1,7)>¡Ey, qué pasa! ¿Necesitas mi ayuda? Qué buen ojo tienes,<br>¡faltaba más!"

#. en: <oneline><$emotion(1,29)><$voicel(1,5)>You feelin’ a little tired, <$cdef(27)><pname;0></color>? Don’t<br>work<slide><br>yourself<slide><br>too<slide><br>hard, bud!
msgctxt "2049:112"
msgid "<$emotion(1,29)><$voicel(1,5)>Te veo un poco pa'l arrastre, que lo sepas. ¡Que no te dé<br>un yuyu por ir tan a lo bestia, <$cdef(27)><pname;0></color>!"
msgstr "<$emotion(1,29)><$voicel(1,5)>Te veo con poca energía, que lo sepas. ¡Que no te dé<br>un soponcio por ir tan a lo loco, <$cdef(27)><pname;0></color>!"

#. en: <oneline><$emotion(1,14)><$voicel(1,7)>Hey heyyy, <$cdef(27)><pname;0></color>! Missed the sound<br>of<slide><br>my<slide><br>voice, huh?
msgctxt "2049:113"
msgid "<$emotion(1,14)><$voicel(1,7)>¿Qué pasa por tu casa? Echabas de menos escuchar mi<br>dulce vozarrón, ¿verdad, <$cdef(27)><pname;0></color>?"
msgstr "<$emotion(1,14)><$voicel(1,7)>¿Qué tal todo? Extrañabas escuchar mi<br>dulce vozarrón, ¿verdad, <$cdef(27)><pname;0></color>?"

#. en: <oneline><$emotion(1,60)><$voicel(1,7)>Hey, <$cdef(27)><pname;0></color>! How ya doin’, bud? I’m<br>doin’<slide><br>GREAT myself!
msgctxt "2049:114"
msgid "<$emotion(1,60)><$cdef(27)><$voicel(1,7)></color>¡Me siento en plena forma! ¿Y a ti qué tal te trata la vida?"
msgstr ""

#. en: <oneline><$emotion(1,37)><$voicel(1,7)>Hey heyyy, <$cdef(27)><pname;0></color>! Got a minute to<br>stop<slide><br>and<slide><br>chat, bud?
msgctxt "2049:115"
msgid "<oneline><$emotion(1,37)><$voicel(1,7)>Ey, <$cdef(27)><pname;0></color>. ¿Tienes un segundejo pa<br>parlotear<slide><br>un poco?"
msgstr "<oneline><$emotion(1,37)><$voicel(1,7)>Ey, <$cdef(27)><pname;0></color>. ¿Tienes un segundito pa<br>parlotear<slide><br>un poco?"

#. en: <oneline><$emotion(1,14)><$voicel(1,7)>Hey heyyy, <$cdef(27)><pname;0></color>! Carryin’ a bunch of<br>stuff<slide><br>again<slide><br>today, bud?
msgctxt "2049:116"
msgid "<oneline><$emotion(1,14)><$voicel(1,7)>¡Eyy, es<gen;-2(e,a)> <$cdef(27)><pname;0></color>! ¿Hoy te toca currar<br>mucho<slide><br>de nuevo?"
msgstr "<oneline><$emotion(1,14)><$voicel(1,7)>¡Eyy, es<gen;-2(e,a)> <$cdef(27)><pname;0></color>! ¿Hoy te toca trabajar<br>mucho<slide><br>de nuevo?"

#. en: <oneline><$emotion(1,50)><$voicel(1,7)>Hey heyyy, <$cdef(27)><pname;0></color>! How far out are you<br>gonna<slide><br>explore today?
msgctxt "2049:117"
msgid "<oneline><$emotion(1,50)><$voicel(1,7)>¡Ey, <$cdef(27)><pname;0></color>! ¿Adónde te piras hoy?<br>¿Algún plan en mente?"
msgstr "<oneline><$emotion(1,50)><$voicel(1,7)>¡Ey, <$cdef(27)><pname;0></color>! ¿Adónde vas hoy?<br>¿Algún plan en mente?"

#. en: <$emotion(1,65)><$voicel(1,5)>I really like the vibes around here, bud!
msgctxt "2049:118"
msgid "<$emotion(1,65)><$voicel(1,5)>Me mola pero mucho el ambientazo que se respira por<br>esta zona, no sé por qué."
msgstr "<$emotion(1,65)><$voicel(1,5)>Me gusta muchísimo el ambientazo que se respira por<br>esta zona, no sé por qué."

#. en: <oneline><$emotion(1,38)><$voicel(1,9)><$cdef(27)><pname;0></color>! You know I’ve got your back,<br>right?<slide><br>Never<slide><br>forget that!
msgctxt "2049:119"
msgid "<$emotion(1,38)><$voicel(1,9)>Oye, ya sabes que puedes contar con <gen;-3(el,la)> menda pa lo<br>que sea, ¿no? ¡No lo olvides, <$cdef(27)><pname;0></color>!"
msgstr "<$emotion(1,38)><$voicel(1,9)>Oye, ya sabes que puedes contar con <gen;-3(el,la)> que te habla<br>pa lo que sea, ¿no? ¡No lo olvides, <$cdef(27)><pname;0></color>!"

#. en: <oneline><$emotion(1,1)><$voicel(1,7)>Whatever you wanna do—I’m down for it!
msgctxt "2049:120"
msgid "<$emotion(1,1)><$voicel(1,7)>Si tienes algún plan en mente, ¡yo me acoplo encantad<gen;-3(o,a)>,<br><$cdef(27)><pname;0></color>!"
msgstr "<$emotion(1,1)><$voicel(1,7)>Si tienes algún plan en mente, ¡yo me uno encantad<gen;-3(o,a)>,<br><$cdef(27)><pname;0></color>!"

#. en: <$comeff(1,16)><$facial(1,14)><$voicel(1,7)>ZzzZZZ... ZzzZZZZZZ<wait(0.4)><$comeff(1,5)><$facial(1,1)><$motion(1,803)>...huh?! Wha—?! Was I sleepin’?!
msgctxt "2049:121"
msgid "<$comeff(1,16)><$facial(1,14)><$voicel(1,7)>Rooonc... Fiuuu... <wait(0.4)><$comeff(1,5)><$facial(1,1)><$motion(1,803)>¡Uah! ¡¿Me había quedado sopa?!"
msgstr "<$comeff(1,16)><$facial(1,14)><$voicel(1,7)>Rooonc... Fiuuu... <wait(0.4)><$comeff(1,5)><$facial(1,1)><$motion(1,803)>¡Uah! ¡¿Me había dormido?!"

#. en: <$comeff(1,16)><$motion(1,807)><$voicel(1,3)>Huh? I’m awake. Totally...a...wake...
msgctxt "2049:122"
msgid "<$comeff(1,16)><$motion(1,807)><$voicel(1,3)>Mñrm... ¿Qué pasa? Estoy despiert<gen;-3(o,a)>, ¿eh? Totalmente<br>despierzzz..."
msgstr ""

#. en: <$voicel(1,7)><$motion(1,803)><$comeff(1,1)><$facial(1,4)>Everything’s fresh and exciting in a new place. Looks like I<br>won’t be getting bored anytime soon!
msgctxt "2049:123"
msgid "<$voicel(1,7)><$motion(1,803)><$comeff(1,1)><$facial(1,4)>Cuando no tienes ni pajolera idea de cómo es un sitio,<br>¡todo es novedoso! ¡Tengo entretenimiento pa rato!"
msgstr "<$voicel(1,7)><$motion(1,803)><$comeff(1,1)><$facial(1,4)>Cuando no tienes ni la menor idea de cómo es un lugar,<br>¡todo es novedoso! ¡Tengo entretenimiento pa rato!"

#. en: <$voicel(1,7)><$emotion(1,48)>Hey, heyyy! You seem to know this place pretty well!<br>I’m countin’ on ya to help me settle in, bud!
msgctxt "2049:124"
msgid "<$voicel(1,7)><$emotion(1,48)>¡Tienes pinta de conocer esta zona como la palma de<br>la mano, niñ<gen;-2(o,a)>! Ya sé a quién darle la murga entonces."
msgstr "<$voicel(1,7)><$emotion(1,48)>¡Parece que conoces esta zona como la palma de<br>la mano, niñ<gen;-2(o,a)>! Ya sé a quién darle lata entonces."

#. en: <$voicel(1,7)><$motion(1,824)><$comeff(1,9)><$facial(1,4)>I’m thinkin’ I could really enjoy this place! Looking forward<br>to just wanderin’ around!
msgctxt "2049:125"
msgid "<$voicel(1,7)><$motion(1,824)><$comeff(1,9)><$facial(1,4)>No está nada mal el ambiente de por aquí. ¡Me voy a ir<br>a dar una vueltilla!"
msgstr "<$voicel(1,7)><$motion(1,824)><$comeff(1,9)><$facial(1,4)>No está nada mal el ambiente de por aquí. ¡Me voy a ir<br>a dar una vueltita!"

#. en: <$voicel(1,7)><$emotion(1,32)>What’re they doin’ over there? <$cdef(27)><fcap><$spwfull(1)>ing</color> something?<br>Looks like a good time!
msgctxt "2049:126"
msgid "<$voicel(1,7)><$emotion(1,32)>¡Ahí va! ¿Os ha dado por empezar a <$cdef(27)><$spwfull(1)></color> algo?<br>¡Buah, tiene pinta de ser divertido!"
msgstr "<$voicel(1,7)><$emotion(1,32)>¡Vaya! ¿Les dio por empezar a <$cdef(27)><$spwfull(1)></color> algo?<br>¡Guau, parece divertido!"

#. en: <$emotion(1,60)><$voicel(1,7)>All riiight! Feast your eyes on my fancy <$cdef(27)><$spwfull(1)>in’ </color>skills!
msgctxt "2049:127"
msgid "<$emotion(1,60)><$voicel(1,7)>¡Vaaamos allá! Lo mío es <$cdef(27)><$spwfull(1)></color>. Ya verás, te vas<br>a quedar de piedra."
msgstr "<$emotion(1,60)><$voicel(1,7)>¡Vaaamos! Lo mío es <$cdef(27)><$spwfull(1)></color>. Ya verás, te vas<br>a quedar de piedra."

#. en: <$voicel(1,9)><$motion(1,806)><$comeff(1,9)><$facial(1,5)>Looks like our population’s growin’ here! I get to meet so<br>many different Pokémon—it’s pretty great!
msgctxt "2049:128"
msgid "<$voicel(1,9)><$motion(1,806)><$comeff(1,9)><$facial(1,5)>¡Veo más Pokémon que antes por aquí! ¡Anda que no!<br>Me lo voy a pasar pipa conociendo a los nuevos."
msgstr "<$voicel(1,9)><$motion(1,806)><$comeff(1,9)><$facial(1,5)>¡Veo más Pokémon que antes por aquí! ¡Y vaya que sí!<br>Me la voy a pasar genial conociendo a los nuevos."

#. en: <$voicel(1,3)><$emotion(1,13)>I don’t know how to say this exactly, but uh...my pad could<br>probably be a little better, y’know?
msgctxt "2049:129"
msgid "<$voicel(1,3)><$emotion(1,13)>¿Mi casa? Bueh, no sé, cómo te diría yo... Pues podría ser<br>algo mejor, no te lo voy a negar."
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,49)>My pad’s gettin’ nicer bit by bit!
msgctxt "2049:130"
msgid "<$voicel(1,7)><$emotion(1,49)>¿Sabes qué, niñ<gen;-2(o,a)>? ¡Mi casa me mola cada vez más!"
msgstr "<$voicel(1,7)><$emotion(1,49)>¿Sabes qué, niñ<gen;-2(o,a)>? ¡Mi casa me gusta cada vez más!"

#. en: <oneline><$voicel(1,9)><$motion(1,801)><$facial(1,5)><$comeff(1,21)>Hey, heyyy! My pad’s really awesome now,<br><$cdef(27)><pname;0></color>!<slide><br>Thanks, bud!
msgctxt "2049:131"
msgid "<$voicel(1,9)><$motion(1,801)><$facial(1,5)><$comeff(1,21)>¡Buah, en mi casa estoy como <gen;-3(un rey,una reina)>! ¡Muchas gracias<br>por la parte que te toca, <$cdef(27)><pname;0></color>!"
msgstr "<$voicel(1,9)><$motion(1,801)><$facial(1,5)><$comeff(1,21)>¡Guau, en mi casa estoy como <gen;-3(un rey,una reina)>! ¡Muchas gracias<br>por la parte que te toca, <$cdef(27)><pname;0></color>!"

#. en: <oneline><$voicel(1,7)><$motion(1,803)><$comeff(1,1)><$facial(1,4)>Hey heyyy, <$cdef(27)><pname;0></color>! Didn’t think I’d see<br>you<slide><br>today,<slide><br>bud.<slide><br>Must<slide><br>be<slide><br>my<slide><br>lucky day!
msgctxt "2049:132"
msgid "<oneline><$voicel(1,7)><$motion(1,803)><$comeff(1,1)><$facial(1,4)>¡Buah, <$cdef(27)><pname;0></color>, si me topo contigo<br>es señal de que<slide><br>hoy estoy de suerte!"
msgstr "<oneline><$voicel(1,7)><$motion(1,803)><$comeff(1,1)><$facial(1,4)>¡Guau, <$cdef(27)><pname;0></color>, si me topo contigo<br>es señal de que<slide><br>hoy estoy de suerte!"

#. en: <$voicel(1,7)><$emotion(1,49)>Hey, bud. Y’know, it’s all thanks to you that we’re able to<br>enjoy livin’ here. <$voicel(1,10)><$motion(1,801)><$comeff(1,9)><$facial(1,5)>You’re doin’ a really amazing thing!
msgctxt "2049:133"
msgid "<$voicel(1,7)><$emotion(1,49)>Si estamos todos más felices que unas pascuas, es porque<br>tú te dejas las pestañas en el asunto, amig<gen;-2(o,a)>.<clear><br><$voicel(1,10)><$motion(1,801)><$comeff(1,9)><$facial(1,5)>¡Estás que te sales, vamos!"
msgstr "<$voicel(1,7)><$emotion(1,49)>Si estamos todos más felices que unas pascuas, es porque<br>tú te esfuerzas un montón, amig<gen;-2(o,a)>.<clear><br><$voicel(1,10)><$motion(1,801)><$comeff(1,9)><$facial(1,5)>¡Eres increíble, de verdad!"

#. en: <$voicel(1,7)><$emotion(1,60)>Going to a new place is a nice change of pace! We should<br>do it again sometime, <$cdef(27)><pname;0></color>!
msgctxt "2049:134"
msgid "<$voicel(1,7)><$emotion(1,60)>Cuando visitas sitios que no conoces, te entra el gusanillo,<br>¡así que hay que repetir, <$cdef(27)><pname;0></color>!"
msgstr "<$voicel(1,7)><$emotion(1,60)>Cuando visitas lugares nuevos, te entra el gusanillo,<br>¡así que hay que repetir, <$cdef(27)><pname;0></color>!"

#. en: <oneline><$voicel(1,5)><$emotion(1,29)>Hey heyyy, <$cdef(27)><pname;0></color>! Welcome back!<br>Where’d<slide><br>you<slide><br>run<slide><br>off<slide><br>to<slide><br>this time?
msgctxt "2049:135"
msgid "<oneline><$voicel(1,5)><$emotion(1,29)>Ey, ¿qué tal, <$cdef(27)><pname;0></color>?<br>¿Por dónde paras últimamente?"
msgstr "<oneline><$voicel(1,5)><$emotion(1,29)>Ey, ¿qué tal, <$cdef(27)><pname;0></color>?<br>¿Por dónde andas últimamente?"

#. en: <oneline><$voicel(1,5)><$comeff(1,10)><$motion(1,806)>Hey heyyy, <$cdef(27)><pname;0></color>! Welcome back!<br>Seems<slide><br>you<slide><br>went<slide><br>out<slide><br>pretty<slide><br>far<slide><br>today, huh?
msgctxt "2049:136"
msgid "<oneline><$voicel(1,5)><$comeff(1,10)><$motion(1,806)>Ey, ¿cómo te va, <$cdef(27)><pname;0></color>?<br>Menuda pateada<slide><br>te has metido<slide><br>esta vez, ¿no?"
msgstr "<oneline><$voicel(1,5)><$comeff(1,10)><$motion(1,806)>Ey, ¿cómo te va, <$cdef(27)><pname;0></color>?<br>Qué caminata<slide><br>te echaste<slide><br>esta vez, ¿no?"

#. en: <$emotion(1,14)><$voicel(1,7)>Make sure you check the <$cdef(27)><fqty(1)><$ifull(1460)></color> often, bud!<br>You just might find <$emotion(1,8)><$voicel(1,10)>a little somethin’ in there I picked up!
msgctxt "2049:137"
msgid "<$emotion(1,14)><$voicel(1,7)>¡Échales un ojo a las <$cdef(27)><fqty(2)><$ifull(1460)> </color>a menudo, niñ<gen;-2(o,a)>!<br>Igual ves alguna cosilla <$emotion(1,8)><$voicel(1,10)>que haya pillado yo de paso."
msgstr "<$emotion(1,14)><$voicel(1,7)>¡Échales un ojo a las <$cdef(27)><fqty(2)><$ifull(1460)> </color>a menudo, niñ<gen;-2(o,a)>!<br>Quizás veas alguna cosita <$emotion(1,8)><$voicel(1,10)>que agarré yo de paso."

#. en: <$emotion(1,50)><$voicel(1,7)>Got somethin’ you want <$spwicon(1)><$cdef(27)>built</color>? If so, you can always<br>count on me, bud!
msgctxt "2049:138"
msgid "<$emotion(1,50)><$voicel(1,7)>Si te apetece ponerte a <$cdef(27)><$spwfull(1)> </color>algo, ya sabes que<br>puedes contar conmigo, ¿no? ¡Pa eso estamos!"
msgstr "<$emotion(1,50)><$voicel(1,7)>Si quieres ponerte a <$cdef(27)><$spwfull(1)> </color>algo, ya sabes que<br>puedes contar conmigo, ¿no? ¡Pa eso estamos!"

#. en: <$emotion(1,38)><$voicel(1,7)>I just can’t stand to see an unlit campfire. I’ll get ’em all<br>blazin’ again for ya!
msgctxt "2049:139"
msgid "<$emotion(1,38)><$voicel(1,7)>Ver una fogata o lo que sea que se está apagando es algo<br>que me supera. ¡Me dan ganas de avivarla a saco!"
msgstr "<$emotion(1,38)><$voicel(1,7)>Ver una fogata o lo que sea que se está apagando es algo<br>que me supera. ¡Me dan ganas de avivarla con todo!"

#. en: <$emotion(1,8)><$voicel(1,7)>I could produce electricity for days! Lemme know if you’ve<br>got a machine or whatever that needs some juice!
msgctxt "2049:141"
msgid "<$emotion(1,8)><$voicel(1,7)>Si lo que necesitas es electricidad, ¡a mí me sobra! Si hay<br>que accionar alguna máquina o algo así, ¡yo me encargo!"
msgstr ""

#. en: <oneline><$comeff(1,14)><$voicel(1,5)>Help yourself to any<br><$cdef(27)><fqty(2)><class><pdcitem;1></color><slide><br>you<slide><br>find<slide><br><$emotion(1,37)><$voicel(1,8)>scattered<slide><br>around<slide><br>my<slide><br>pad, bud.
msgctxt "2049:143"
msgid "<oneline><$comeff(1,14)><$voicel(1,5)>Suelo tener un<gen;1(os,as)> cuant<gen;1(os,as)><br><fqty(2)><class><$cdef(27)><pdcitem;1></color><slide><br>por casa.<slide><br><$emotion(1,37)><$voicel(1,8)>Píllate l<gen;1(os,as)> que quieras."
msgstr "<oneline><$comeff(1,14)><$voicel(1,5)>Suelo tener un<gen;1(os,as)> cuant<gen;1(os,as)><br><fqty(2)><class><$cdef(27)><pdcitem;1></color><slide><br>por casa.<slide><br><$emotion(1,37)><$voicel(1,8)>Agarra l<gen;1(os,as)> que quieras."

#. en: <$emotion(1,1)><$voicel(1,7)>Hey, heyyy! How about treatin’ yourself to a good time<br><$spwicon(12)><$cdef(27)>trading </color>with yours truly at the <$cdef(27)><fqty(1)><$ifull(1325)></color>?
msgctxt "2049:144"
msgid "<$emotion(1,1)><$voicel(1,7)>¡Ey, niñ<gen;-2(o,a)>! ¿No te suena a planazo <$cdef(27)><$spwfull(12)></color> conmigo<br>en la <$cdef(27)><fqty(1)><$ifull(1325)></color> la próxima vez que esté allí?"
msgstr "<$emotion(1,1)><$voicel(1,7)>¡Ey, niñ<gen;-2(o,a)>! ¿No sería genial <$cdef(27)><$spwfull(12)></color> conmigo<br>en la <$cdef(27)><fqty(1)><$ifull(1325)></color> la próxima vez que esté allí?"

#. en: <$emotion(1,38)><$voicel(1,9)>Whenever you wanna have a good time, you know who to<br>call! That’s right, ME! I’m the life of the party!
msgctxt "2049:146"
msgid "<$emotion(1,38)><$voicel(1,9)>Si buscas a alguien para animar el cotarro... ¡tacháaan!<br>¡Déjamelo a mí, que soy la alegría de la huerta!"
msgstr "<$emotion(1,38)><$voicel(1,9)>Si buscas a alguien para animar el ambiente... ¡tacháaan!<br>¡Déjamelo a mí, que soy el alma de la fiesta!"

#. en: <$voicel(1,9)><$facial(1,5)><$motion(1,668)><$comeff(1,21)>Whoa. So we kinda float around when we’re in the water,<br>huh? Pretty cool!
msgctxt "2049:147"
msgid "<$voicel(1,9)><$facial(1,5)><$motion(1,668)><$comeff(1,21)>¡Tuercas! ¡Qué liger<gen;-3(o,a)> me siento en el agua! Es como flotar<br>en el aire... <wait(1.0)>¡Una sensación bien raruna!"
msgstr "<$voicel(1,9)><$facial(1,5)><$motion(1,668)><$comeff(1,21)>¡Rayos! ¡Qué liger<gen;-3(o,a)> me siento en el agua! Es como flotar<br>en el aire... <wait(1.0)>¡Una sensación bien rarita!"

#. en: <oneline><$comeff(1,3)><$facial(1,1)><$motion(1,805)><$voicel(1,6)>This is <$cdef(27)><wndhmownerpk;0></color>’s pad, yeah? It’s real<br>obvious<slide><br>just<slide><br>by<slide><br>the<slide><br>look<slide><br>of<slide><br>the place!
msgctxt "2049:148"
msgid "<oneline><$comeff(1,3)><$facial(1,1)><$motion(1,805)><$voicel(1,6)>Aquí es donde vive <dart;0()><$cdef(27)><wndhmownerpk;0></color>,<br>¿no?<slide><br>Está claro que<slide><br>le pega<slide><br>un montón un sitio así."
msgstr "<oneline><$comeff(1,3)><$facial(1,1)><$motion(1,805)><$voicel(1,6)>Aquí es donde vive <dart;0()><$cdef(27)><wndhmownerpk;0></color>,<br>¿no?<slide><br>Está claro que<slide><br>le queda<slide><br>perfecto un lugar así."

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,805)><$voicel(1,6)>This place has some real cool scenery, y’know?
msgctxt "2049:149"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,805)><$voicel(1,6)>¡Qué paisaje tan interesante! Esta zona no está mal."
msgstr ""

#. en: <oneline><$emotion(1,39)><$voicel(1,9)>Whoa! This <$cdef(27)><fqty(1)><class><usingp;0><br></color>is<slide><br>seriously<slide><br>a<slide><br>good time!
msgctxt "2049:150"
msgid "<$emotion(1,39)><$voicel(1,9)>¡Buah, te digo que me estoy partiendo la caja con <genqty;0(este,esta,estos,estas)><br><$cdef(27)><fqty(1)><class><usingp;0></color>!"
msgstr "<$emotion(1,39)><$voicel(1,9)>¡Guau, me estoy divirtiendo un montón con <genqty;0(este,esta,estos,estas)><br><$cdef(27)><fqty(1)><class><usingp;0></color>!"

#. en: <oneline><$emotion(1,64)><$voicel(1,7)>Uhhh...<iart;0()><$cdef(27)><fqty(1)><class><usingp;0></color>,<br>yeah?<slide><br>What<slide><br>the<slide><br>heck<slide><br>is<slide><br>this for?
msgctxt "2049:151"
msgid "<oneline><$emotion(1,64)><$voicel(1,7)>¿<fcap><iart;0()><fqty(1)><$cdef(27)><class><usingp;0></color>?<br>¿Lo cualo?"
msgstr "<oneline><$emotion(1,64)><$voicel(1,7)>¿<fcap><iart;0()><fqty(1)><$cdef(27)><class><usingp;0></color>?<br>¿Y eso qué es?"

#. en: <oneline><$comeff(1,8)><$facial(1,4)><$motion(1,666)><$voicel(1,7)>This <$cdef(27)><fqty(1)><class><usingp;0> </color>is,<br>uh...heh.<slide><br>It’s<slide><br>kinda cute.
msgctxt "2049:152"
msgid "<oneline><$comeff(1,8)><$facial(1,4)><$motion(1,666)><$voicel(1,7)>Qué <$cdef(27)><fqty(1)><class><usingp;0><br></color>más cuc<genqty;0(o,a,os,as)>, oye."
msgstr "<oneline><$comeff(1,8)><$facial(1,4)><$motion(1,666)><$voicel(1,7)>Qué <$cdef(27)><fqty(1)><class><usingp;0><br></color>más lind<genqty;0(o,a,os,as)>, oye."

#. en: <oneline><$comeff(1,14)><$motion(1,806)><$voicel(1,7)>I’ve been starin’ at it for a while now, but this<br><$cdef(27)><fqty(1)><class><usingp;0></color><slide><br>doesn’t<slide><br>seem<slide><br>to<slide><br>do anything...
msgctxt "2049:153"
msgid "<oneline><$comeff(1,14)><$motion(1,806)><$voicel(1,7)>Llevo ya un buen ratejo mirando <genqty;0(este,esta,estos,estas)><br><$cdef(27)><fqty(1)><class><usingp;0></color>...<slide><br>pa na."
msgstr "<oneline><$comeff(1,14)><$motion(1,806)><$voicel(1,7)>Llevo ya un buen rato mirando <genqty;0(este,esta,estos,estas)><br><$cdef(27)><fqty(1)><class><usingp;0></color>...<slide><br>y nada."

#. en: <oneline><$emotion(1,38)><$voicel(1,9)>This <$cdef(27)><fqty(1)><class><usingp;0> </color>is just<br>what<slide><br>I like!
msgctxt "2049:155"
msgid "<oneline><$emotion(1,38)><$voicel(1,9)>¡Me mol<qty;0(a,an)> est<genqty;0(e,a,os,as)><br><$cdef(27)><fqty(1)><class><usingp;0></color>!"
msgstr "<oneline><$emotion(1,38)><$voicel(1,9)>¡Me gust<qty;0(a,an)> est<genqty;0(e,a,os,as)><br><$cdef(27)><fqty(1)><class><usingp;0></color>!"

#. en: <$emotion(1,50)><$voicel(1,7)>I thought I saw somethin’ super cool here, so I came to<br>check it out—and found me! No wonder it’s so cool!
msgctxt "2049:156"
msgid "<$emotion(1,50)><$voicel(1,7)>Yo de lejos pensando: \"¡Buah, qué porte tiene <gen;-3(el tío ese,la tía esa)>!\".<br>¡Y resulta que era un mueble clavadito a mí! ¡Ya decía yo!"
msgstr "<$emotion(1,50)><$voicel(1,7)>Yo de lejos pensando: \"¡Guau, qué porte tiene <gen;-3(el tío ese,la tía esa)>!\".<br>¡Y resulta que era un mueble clavadito a mí! ¡Ya decía yo!"

#. en: <oneline><$emotion(1,8)><$voicel(1,7)><qty;0(This,These)> <$cdef(27)><fqty(1)><noweating;0> </color><qty;0(is,are)> so good!<br>Hey,<slide><br>bud,<slide><br>we<slide><br>got<slide><br>any<slide><br>more<slide><br>of<slide><br>this<slide><br>lyin’ around?
msgctxt "2049:157"
msgid "<oneline><$emotion(1,8)><$voicel(1,7)>¡<fcap><dart;0()><$cdef(27)><fqty(1)><noweating;0></color> <qty;0(está,están)><br>de vicio, amig<gen;-2(o,a)>!<slide><br>No tendrás más, ¿no?"
msgstr "<oneline><$emotion(1,8)><$voicel(1,7)>¡<fcap><dart;0()><$cdef(27)><fqty(1)><noweating;0></color> <qty;0(está,están)><br>de lujo, amig<gen;-2(o,a)>!<slide><br>No tendrás más, ¿no?"

#. en: <$emotion(1,17)><$voicel(1,5)>I’m not really a fan of this flavor, but I can eat it!
msgctxt "2049:158"
msgid "<$emotion(1,17)><$voicel(1,5)>No es que me pirre por este sabor, si te digo la verdad...<br>Pero bueno, bajar baja."
msgstr "<$emotion(1,17)><$voicel(1,5)>No es que me muera por este sabor, si te digo la verdad...<br>Pero bueno, bajar baja."

#. en: <$emotion(1,8)><$voicel(1,7)>Nice one, <$cdef(27)><pname;0></color>! Well done!
msgctxt "2049:159"
msgid "<$emotion(1,8)><$voicel(1,7)>¡Es<gen;-2(e,a)> <$cdef(27)><pname;0></color>! ¡Qué hacha!"
msgstr "<$emotion(1,8)><$voicel(1,7)>¡Es<gen;-2(e,a)> <$cdef(27)><pname;0></color>! ¡Qué genio!"

#. en: <$emotion(1,37)><$voicel(1,7)>Nice, <$cdef(27)><blsspwkpk;0></color>! Didn’t know you could do that!
msgctxt "2049:160"
msgid "<$emotion(1,37)><$voicel(1,7)>¡Olé, <$cdef(27)><blsspwkpk;0></color>! ¿De dónde sacará esa maña?"
msgstr "<$emotion(1,37)><$voicel(1,7)>¡Bravo, <$cdef(27)><blsspwkpk;0></color>! ¿De dónde sacará esa maña?"

#. en: <$emotion(1,60)><$voicel(1,7)>There’s NO WAY I’ll lose at tag!
msgctxt "2049:161"
msgid "<$emotion(1,60)><$voicel(1,7)>¿Tú crees que <gen;-3(un,una)> fuera de serie como yo puede perder<br>a algo tan simplón como el pillapilla? ¡Anda ya!"
msgstr "<$emotion(1,60)><$voicel(1,7)>¿Tú crees que <gen;-3(un,una)> fuera de serie como yo puede perder<br>en algo tan simplón como las atrapadas? ¡Por favor!"

#. en: <oneline><$emotion(1,8)><$voicel(1,7)><$cdef(27)><nnowpairpk;0> </color>sure is interesting! We’re<br>hittin’<slide><br>it<slide><br>off great!
msgctxt "2049:162"
msgid "<oneline><$emotion(1,8)><$voicel(1,7)><fcap><dart;0()><$cdef(27)><nnowpairpk;0> </color>es la caña.<br>¡Nos llevamos de maravilla!"
msgstr "<oneline><$emotion(1,8)><$voicel(1,7)><fcap><dart;0()><$cdef(27)><nnowpairpk;0> </color>es genial.<br>¡Nos llevamos de maravilla!"

#. en: <$comeff(1,16)><$motion(1,807)><$voicel(1,3)>*yaaaaaawn*<br>Wow, it’s already so late. I’m gettin’ a little sleepy...
msgctxt "2049:163"
msgid "<$comeff(1,16)><$motion(1,807)><$voicel(1,3)>¡Buah, qué tarde se me ha hecho! Ya decía yo que me<br>estaba quedando un poco sobad<gen;-3(o,a)>..."
msgstr "<$comeff(1,16)><$motion(1,807)><$voicel(1,3)>¡Guau, qué tarde se me hizo! Ya decía yo que me<br>estaba quedando un poco dormid<gen;-3(o,a)>..."

#. en: <$comeff(1,16)><$motion(1,805)><$voicel(1,5)>Ahhhhhh, I’m so sleepy! Guess I’ll head to bed and dream<br>about some tasty food or somethin’.
msgctxt "2049:164"
msgid "<$comeff(1,16)><$motion(1,805)><$voicel(1,5)>¡Buah, con esta modorraca me quedaré sopa en cualquier<br>momento! ¡Hora de irse al sobre y soñar con comida rica!"
msgstr "<$comeff(1,16)><$motion(1,805)><$voicel(1,5)>¡Uf, con esta modorra me voy a dormir en cualquier<br>momento! ¡Hora de irse a la cama y soñar con comida rica!"

#. en: <$emotion(1,14)><$voicel(1,5)>Wh-whoa. Why’s the sky so bright?! Ugh. See, this is why I<br>hate mornings...
msgctxt "2049:165"
msgid "<$emotion(1,14)><$voicel(1,5)>¡Me quedo cieg<gen;-3(o,a)> con esta luz! Cómo odio las dichosas<br>mañanitas..."
msgstr ""

#. en: <$comeff(1,16)><$motion(1,807)><$voicel(1,3)>Already morning, huh? I hate to say it, but I think it’s<br>about time for me to go to bed, bud...
msgctxt "2049:166"
msgid "<$comeff(1,16)><$motion(1,807)><$voicel(1,3)>Ya ha amanecido... Pues, sintiéndolo mucho, me piro a<br>dormir."
msgstr "<$comeff(1,16)><$motion(1,807)><$voicel(1,3)>Ya amaneció... Pues, sintiéndolo mucho, me voy a<br>dormir."

#. en: <$emotion(1,38)><$voicel(1,7)>If I just spread my wings and fly, I can go anywhere!<br>ANYWHERE! <$motion(1,803)><$facial(1,1)><$voicel(1,6)>...Well, most anywhere.
msgctxt "2049:167"
msgid "<$emotion(1,38)><$voicel(1,7)>¡El cielo no tiene fronteras pa mí! Podría volar adonde<br>me dé la real gana, ¡incluso al horizonte!<clear><br><$motion(1,803)><$facial(1,1)><$voicel(1,6)>Bueno, al menos eso creo. Tampoco es que haya probado<br>nunca."
msgstr ""

#. en: <$emotion(1,14)><$voicel(1,6)>My poison’s the real deal—real dangerous, that is!<clear><br><$emotion(1,38)><$voicel(1,7)>But this place is pretty peaceful, I guess. I’ll probably<br>never have to use it, huh?
msgctxt "2049:169"
msgid "<$emotion(1,14)><$voicel(1,6)>¡Ojito con mi veneno, que es la leche de peligroso, eh!<clear><br><$emotion(1,38)><$voicel(1,7)>Aunque este lugar es tan tranquilo que no creo que lo<br>vaya a tener que usar nunca."
msgstr "<$emotion(1,14)><$voicel(1,6)>¡Ojito con mi veneno, que es peligrosísimo, eh!<clear><br><$emotion(1,38)><$voicel(1,7)>Aunque este lugar es tan tranquilo que no creo que lo<br>vaya a tener que usar nunca."

#. en: <$emotion(1,8)><$voicel(1,7)>My body’s real solid, see? You won’t catch me losin’ to<br>ANYONE in a tackle-off!
msgctxt "2049:171"
msgid "<$emotion(1,8)><$voicel(1,7)>¡Tengo un cuerpo más duro que una roca! ¿No se nota?<br>A ver quién es el guapo que me gana a placajes."
msgstr "<$emotion(1,8)><$voicel(1,7)>¡Tengo un cuerpo más duro que una roca! ¿No se nota?<br>A ver quién es capaz de ganarme a empujones."

#. en: <$emotion(1,37)><$voicel(1,7)>My body’s kinda small, but I make up for it by havin’ a<br>big heart!
msgctxt "2049:172"
msgid "<$emotion(1,37)><$voicel(1,7)>Como tengo este cuerpo tan pequeñajo, ¡he decidido que<br>lo compensaré con un corazón bien grande!"
msgstr "<$emotion(1,37)><$voicel(1,7)>Como tengo este cuerpo tan pequeñito, ¡he decidido que<br>lo compensaré con un corazón bien grande!"

#. en: <$comeff(1,14)><$motion(1,803)><$voicel(1,5)>There are a lot of Pokémon smaller than me, but I’ve never<br>thought of ’em as weak.<clear><br><$emotion(1,38)><$voicel(1,8)>Everyone’s got their own strengths, y’know?
msgctxt "2049:173"
msgid "<$comeff(1,14)><$motion(1,803)><$voicel(1,5)>Hay un porrón de Pokémon más pequeñajos que yo, pero<br>no creas que por eso los considero unos enclenques, ¿eh?<slide><br><$emotion(1,38)><$voicel(1,8)>Cada uno tiene sus propias fortalezas."
msgstr "<$comeff(1,14)><$motion(1,803)><$voicel(1,5)>Hay un montón de Pokémon más pequeñitos que yo, pero<br>no creas que por eso los considero unos enclenques, ¿eh?<slide><br><$emotion(1,38)><$voicel(1,8)>Cada uno tiene sus propias fortalezas."

#. en: <oneline><$comeff(1,3)><$motion(1,807)><$voicel(1,7)>Watch yourself, <$cdef(27)><pname;0></color>! If ya touch me,<br>you’re<slide><br>gonna<slide><br>get<slide><br>burned!<clear><br><$emotion(1,38)><$voicel(1,10)>Just kidding! Heh, I’ve always wanted to say that.
msgctxt "2049:174"
msgid "<$comeff(1,3)><$motion(1,807)><$voicel(1,7)>Si me tocas, te puedes llevar una buena quemadura,<br>así que... ¡ándate con ojo, <$cdef(27)><pname;0></color>!<clear><br><$emotion(1,38)><$voicel(1,10)>¡Naaah, es broma! Pero si te quieres calentar las manos,<br>adelante."
msgstr "<$comeff(1,3)><$motion(1,807)><$voicel(1,7)>Si me tocas, te puedes llevar una buena quemadura,<br>así que... ¡mucho ojo, <$cdef(27)><pname;0></color>!<clear><br><$emotion(1,38)><$voicel(1,10)>¡Naaah, es broma! Pero si te quieres calentar las manos,<br>adelante."

#. en: <$emotion(1,1)><$voicel(1,7)>All I need to get by in life are tasty berries and some nice,<br>clear water.
msgctxt "2049:175"
msgid "<$emotion(1,1)><$voicel(1,7)>Pa vivir tranquilamente, yo ante todo necesito unas<br>bayas sabrosonas y agua fresca."
msgstr ""

#. en: <$comeff(1,14)><$motion(1,803)><$voicel(1,6)>I’ve got, like, an electric field around me, OK?<clear><br><$emotion(1,8)><$voicel(1,7)>If ya stick close by, you might just feel your body relax and<br>all your fatigue melt away!
msgctxt "2049:177"
msgid "<$comeff(1,14)><$motion(1,803)><$voicel(1,6)>¿Notas esa especie de electricidad estática que emito?<clear><br><$emotion(1,8)><$voicel(1,7)>Pues, si te pones a mi lado, verás como te relaja y te<br>quedas más panch<gen;-2(o,a)> que yo qué sé."
msgstr "<$comeff(1,14)><$motion(1,803)><$voicel(1,6)>¿Notas esa especie de electricidad estática que emito?<clear><br><$emotion(1,8)><$voicel(1,7)>Pues, si te pones a mi lado, verás como te relaja y te<br>quedas más tranquil<gen;-2(o,a)> que yo qué sé."

#. en: <$comeff(1,10)><$facial(1,1)><$motion(1,803)><$voicel(1,5)>Hey, heyyy! I could sense that you were gonna come talk<br>to me. What’s up, bud?
msgctxt "2049:178"
msgid "<$comeff(1,10)><$facial(1,1)><$motion(1,803)><$voicel(1,5)>¿Qué pasa, tronc<gen;-2(o,a)>? Mira tú por dónde, presentía que<br>vendrías a hablar con <gen;-3(el,la)> menda lerenda."
msgstr "<$comeff(1,10)><$facial(1,1)><$motion(1,803)><$voicel(1,5)>¿Qué pasa, amig<gen;-2(o,a)>? Fíjate que presentía que<br>vendrías a hablar con <gen;-3(el,la)> que te habla."

#. en: <$emotion(1,60)><$voicel(1,7)>You aren’t scared of me? Well, you’ve got guts, then! I’ll<br>give ya that, <$cdef(27)><pname;1></color>!
msgctxt "2049:180"
msgid "<$emotion(1,60)><$voicel(1,7)>¡Desde luego, se ve que tienes arrestos pa que no te dé<br>canguelo mi presencia, <$cdef(27)><pname;1></color>!"
msgstr "<$emotion(1,60)><$voicel(1,7)>¡Desde luego, se ve que tienes arrestos pa que no te dé<br>miedo mi presencia, <$cdef(27)><pname;1></color>!"

#. en: <$voicel(1,7)><$emotion(1,38)>Looks like there are more Pokémon around here now, huh?<br>Hope we can get along well!
msgctxt "2049:181"
msgid "<$voicel(1,7)><$emotion(1,38)>Yo diría que cada vez hay más Pokémon por aquí, niñ<gen;-2(o,a)>.<br>Y si son encima de los que me caen bien, ¡qué puntazo!"
msgstr "<$voicel(1,7)><$emotion(1,38)>Yo diría que cada vez hay más Pokémon por aquí, niñ<gen;-2(o,a)>.<br>Y si son encima de los que me caen bien, ¡qué genial!"

#. en: <oneline><$voicel(1,7)><$emotion(1,1)>Heyyy, uhhh...<$cdef(27)><pname;0></color>, right? Nice to<br>see<slide><br>ya, bud!
msgctxt "2049:182"
msgid "<$voicel(1,7)><$emotion(1,1)>Ey, ¿qué tal? Te llamabas <$cdef(27)><pname;0></color>, ¿no?<br>¡Pues qué alegrón volver a verte!"
msgstr ""

#. en: <oneline><$voicel(1,7)><$emotion(1,60)>Hey hey, <$cdef(27)><pname;0></color>! Good morning!<br>A<slide><br>little<slide><br>morning<slide><br>sunshine<slide><br>is<slide><br>a<slide><br>great<slide><br>way<slide><br>to<slide><br>start<slide><br>the day!
msgctxt "2049:183"
msgid "<oneline><$voicel(1,7)><$emotion(1,60)>¡A los buenos días, <$cdef(27)><pname;0></color>!<br>¡Sentir el sol por la mañana<slide><br>te da un subidón de energía!"
msgstr "<oneline><$voicel(1,7)><$emotion(1,60)>¡A los buenos días, <$cdef(27)><pname;0></color>!<br>¡Sentir el sol por la mañana<slide><br>te llena de energía!"

#. en: <oneline><$voicel(1,9)><$motion(1,801)><$facial(1,4)><$comeff(1,10)>Hey heyyy, <$cdef(27)><pname;0></color>! This weather is just<br>stupidly<slide><br>good,<slide><br>isn’t it?
msgctxt "2049:184"
msgid "<$voicel(1,9)><$motion(1,801)><$facial(1,4)><$comeff(1,10)>¡Ey, <$cdef(27)><pname;0></color>! Vaya diazo que hace, ¿no?"
msgstr "<$voicel(1,9)><$motion(1,801)><$facial(1,4)><$comeff(1,10)>¡Ey, <$cdef(27)><pname;0></color>! Qué gran día hace, ¿no?"

#. en: <$voicel(1,5)><$motion(1,803)><$facial(1,4)><$comeff(1,1)>Wanderin’ around on a starry night isn’t a bad way to<br>spend some time!
msgctxt "2049:185"
msgid "<$voicel(1,5)><$motion(1,803)><$facial(1,4)><$comeff(1,1)>¡Qué gustazo poder darse un paseo bajo la luz de<br>las estrellas!"
msgstr ""

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>I love the rain! It’s like a gift fallin’ straight outta the sky.<br>Must be ’cause I’ve been such a good Pokémon!
msgctxt "2049:186"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>¡Esta lluvia me viene literalmente como agua de mayo!<br>Debe de ser un premio por lo bien que me porto."
msgstr ""

#. en: <$emotion(1,17)><$voicel(1,3)>Ughhh, rain?! I’m not good with rain...
msgctxt "2049:187"
msgid "<$emotion(1,17)><$voicel(1,3)>¿Lluvia? Bah, qué fastidio... ¡Odio empaparme!"
msgstr ""

#. en: <oneline><$voicel(1,7)><$emotion(1,49)>Hey heyyy, <$cdef(27)><pname;0></color>! The weather may<br>be<slide><br>gloomy,<slide><br>but<slide><br>that<slide><br>doesn’t<slide><br>mean<slide><br>we<slide><br>have<slide><br>to be!
msgctxt "2049:188"
msgid "<oneline><$voicel(1,7)><$emotion(1,49)>¡Ey, <$cdef(27)><pname;0></color>! Por muy nublado y feucho<br>que esté el día,<slide><br>¡hay que poner al mal tiempo buena cara!"
msgstr ""

#. en: <$emotion(1,55)><$voicel(1,5)><$cdef(27)>Professor Tangrowth</color>’s got this air of confidence about<br>’em, y’know?<clear><br><$emotion(1,14)><$voicel(1,8)>I bet they’re strong. I mean...they’ve gotta be. Right?
msgctxt "2049:189"
msgid "<$emotion(1,55)><$voicel(1,5)>El <$cdef(27)>Profesor Tangrowth </color>siempre está de vuelta de todo...<br>No se le escapa nada al tío...<clear><br><$emotion(1,14)><$voicel(1,8)>Yo creo que anda sobrado de fuerza, ¿no te parece?"
msgstr "<$emotion(1,55)><$voicel(1,5)>El <$cdef(27)>Profesor Tangrowth </color>siempre está de vuelta de todo...<br>No se le escapa nada de nada...<clear><br><$emotion(1,14)><$voicel(1,8)>Yo creo que anda sobrado de fuerza, ¿no te parece?"

#. en: <oneline><$comeff(1,9)><$motion(1,806)><$voicel(1,9)><$pkcry;0(1,2)>! ♪ The wait before startin’ always gets<br>me<slide><br>kinda<slide><br>excited!
msgctxt "2049:190"
msgid "<$comeff(1,9)><$motion(1,806)><$voicel(1,9)>¡Lo único que hacen los ratos de espera es darme más<br>ganas de empezar! ♪¡<$pkcry;0(1,2)>!♪"
msgstr ""

#. en: <$emotion(1,60)><$voicel(1,9)>I’m gonna show you just how good I am at cookin’, bud!
msgctxt "2049:191"
msgid "<$emotion(1,60)><$voicel(1,9)>¡Vas a ver la maña que tengo en la cocina!"
msgstr ""

#. en: <$comeff(1,6)><$facial(1,1)><$motion(1,805)><$voicel(1,6)>What’s up, bud? You find somethin’ interestin’ for us to<br>check out?
msgctxt "2049:192"
msgid "<oneline><$comeff(1,6)><$facial(1,1)><$motion(1,805)><$voicel(1,6)>¿Qué pasa, tronc<gen;-2(o,a)>? ¿Has visto algo que te ha llamao<br>la atención?"
msgstr "<oneline><$comeff(1,6)><$facial(1,1)><$motion(1,805)><$voicel(1,6)>¿Qué pasa, amig<gen;-2(o,a)>? ¿Viste algo que te llamó<br>la atención?"

#. en: <$comeff(1,3)><$facial(1,1)><$motion(1,803)><$voicel(1,5)>Lemme know if you’re gettin’ tired! No need to push on if<br>you’re not feelin’ up to it.
msgctxt "2049:193"
msgid "<$comeff(1,3)><$facial(1,1)><$motion(1,803)><$voicel(1,5)>Si sientes flojera, avísame, ¿vale? Que tampoco vale la<br>pena pasarse de rosca."
msgstr "<$comeff(1,3)><$facial(1,1)><$motion(1,803)><$voicel(1,5)>Si sientes flojera, avísame, ¿sí? Que tampoco vale la<br>pena pasarse de rosca."

#. en: <oneline><$comeff(1,9)><$facial(1,4)><$motionoff(1,804)><$voicel(1,9)>I’m havin’ such a good time! Let’s keep<br>movin’, <$cdef(27)><pname;0></color>!
msgctxt "2049:194"
msgid "<$comeff(1,9)><$facial(1,4)><$motionoff(1,804)><$voicel(1,9)>¡Estoy a tope! ¡Tú tira p'alante, que yo te sigo el ritmo!"
msgstr "<$comeff(1,9)><$facial(1,4)><$motionoff(1,804)><$voicel(1,9)>¡Estoy con todo! ¡Tú adelante, que yo te sigo el ritmo!"

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Our pad’s got a real cool feel to it, don’t ya think? I can<br>dig it! <$pkcry;0(1,1)>! ♪
msgctxt "2049:195"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡<$pkcry;0(1,1)>! Qué bien se está en nuestra casa, ¿no?<br>¡Tiene un rollo que me encanta!"
msgstr "<$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡<$pkcry;0(1,1)>! Qué bien se está en nuestra casa, ¿no?<br>¡Tiene un ambiente que me encanta!"

#. en: <oneline><$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,6)><$cdef(27)><pname;0></color>! Hey, bud! Have you heard<br>about<slide><br>the<slide><br>huge<slide><br>Pokémon<slide><br>flyin’ around?<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,666)><$voicel(1,8)>Apparently you can see ’em around here sometimes!
msgctxt "2049:196"
msgid "<$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,6)>¡Eh, camarada! ¿Has oído eso de que hay un Pokémon<br>enorme que cruza el cielo?<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,666)><$voicel(1,8)>Pues, por lo visto, a veces se deja ver por esta zona."
msgstr "<$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,6)>¡Eh, camarada! ¿Oíste eso de que hay un Pokémon<br>enorme que cruza el cielo?<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,666)><$voicel(1,8)>Pues, por lo visto, a veces se deja ver por esta zona."

#. en: <oneline><$comeff(1,3)><$facial(1,4)><$motion(1,661)><$voicel(1,6)>Hey, heyyy! Lookin’ squishy as usual today,<br><$cdef(27)><pname;0></color>!<clear><br><$comeff(1,6)><$motion(1,806)><$voicel(1,7)>Want me to make you a trainin’ plan to pack on some<br>solid muscle?!
msgctxt "2049:198"
msgid "<oneline><$comeff(1,3)><$facial(1,4)><$motion(1,661)><$voicel(1,6)>¡Eh, <$cdef(27)><pname;0></color>! ¿Cómo es posible que<br>estés siempre<slide><br>tan fofainas?<clear><br><$comeff(1,6)><$motion(1,806)><$voicel(1,7)>¡Te voy a tener que poner a echar músculo conmigo!"
msgstr "<oneline><$comeff(1,3)><$facial(1,4)><$motion(1,661)><$voicel(1,6)>¡Eh, <$cdef(27)><pname;0></color>! ¿Cómo es posible que<br>estés siempre<slide><br>tan blandengue?<clear><br><$comeff(1,6)><$motion(1,806)><$voicel(1,7)>¡Te voy a tener que poner a echar músculo conmigo!"

#. en: <$comeff(1,21)><$facial(1,1)><$motionoff(1,804)><$voicel(1,9)>Bring on the badness! I’m the baddest there is! Chillin’ like<br>a villain every day!<clear><br><$comeff(1,10)><$motion(1,803)><$voicel(1,8)>I mean, y’know...that’s just my style. I don’t actually DO<br>bad stuff. Heh.
msgctxt "2049:199"
msgid "<$comeff(1,21)><$facial(1,1)><$motionoff(1,804)><$voicel(1,9)>Ja, ja... Ser malot<gen;-3(e,a)> es lo más. Hoy también pienso hacer<br>de las mías, <$comeff(1,10)><$motion(1,803)><$voicel(1,8)>¡pa que la peña no se aburra, más que nada!"
msgstr "<$comeff(1,21)><$facial(1,1)><$motionoff(1,804)><$voicel(1,9)>Ja, ja... Ser malot<gen;-3(e,a)> es lo más. Hoy también pienso hacer<br>de las mías, <$comeff(1,10)><$motion(1,803)><$voicel(1,8)>¡pa que la gente no se aburra, más que nada!"

#. en: <$comeff(1,6)><$facial(1,1)><$motion(1,805)><$voicel(1,4)>Hunh? Whaddya want, <$cdef(27)><pname;0></color>?!<clear><br><$comeff(1,3)><$motion(1,803)><$voicel(1,6)>Oh, uh... I’m not angry or anything. This is just how my<br>face looks, y’know? <$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,8)>So don’t be scared, bud!
msgctxt "2049:200"
msgid "<$comeff(1,6)><$facial(1,1)><$motion(1,805)><$voicel(1,4)>¿Eh? ¿Qué pasa, <$cdef(27)><pname;0></color>?<clear><br><$comeff(1,3)><$motion(1,803)><$voicel(1,6)>Por si acaso, que sepas que no estoy de mal humor ni na,<br>es que mi careto es así. <$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,8)>No te me asustes, ¿vale?"
msgstr "<$comeff(1,6)><$facial(1,1)><$motion(1,805)><$voicel(1,4)>¿Eh? ¿Qué pasa, <$cdef(27)><pname;0></color>?<clear><br><$comeff(1,3)><$motion(1,803)><$voicel(1,6)>Por si acaso, que sepas que no estoy de mal humor ni na,<br>es que mi cara es así. <$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,8)>No te me asustes, ¿sí?"

#. en: <oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>D’ya think I could get <$cdef(27)><nquestinum;1></color><br><$cdef(27)><class><nquestitem;0></color>?
msgctxt "2049:201"
msgid "<oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Me vendrí<qty;1(a,an)> bien <$cdef(27)><nquestinum;1></color><br><$cdef(27)><class><nquestitem;0></color>...<slide><br>¿Me <genqty;0(lo,la,los,las)> puedes conseguir?"
msgstr ""

#. en: <$emotion(1,60)><$voicel(1,9)>I knew I could count on you, bud! That’s a great help!<br>Thanks a ton!
msgctxt "2049:202"
msgid "<$emotion(1,60)><$voicel(1,9)>¡Vaya con <gen;-2(el chaval,la chavala)>, cómo se lo curra! ¡Gracias!"
msgstr "<$emotion(1,60)><$voicel(1,9)>¡Vaya con <gen;-2(el chaval,la chavala)>, cómo se esfuerza! ¡Gracias!"

#. en: <$motion(1,806)><$voicel(1,5)>I really wanna check out a place like this, bud. I’d be real<br>happy if you could make it for me!
msgctxt "2049:203"
msgid "<$motion(1,806)><$voicel(1,5)>Me encantaría un sitio así. ¿Crees que podrías montar<br>algo parecido?"
msgstr "<$motion(1,806)><$voicel(1,5)>Me encantaría un lugar así. ¿Crees que podrías montar<br>algo parecido?"

#. en: <oneline><$emotion(1,38)><$voicel(1,9)>You made it for me?! Nice one, <$cdef(27)><pname;0></color>!<br>I knew<slide><br>I<slide><br>could<slide><br>count<slide><br>on<slide><br>you, bud!
msgctxt "2049:204"
msgid "<oneline><$emotion(1,38)><$voicel(1,9)>¡Dicho y hecho! ¡Sabía que podía contar contigo,<br><$cdef(27)><pname;0></color>!<slide><br>¡Eres <gen;-2(un,una)> fenómen<gen;-2(o,a)>!"
msgstr ""

#. en: <$comeff(1,5)><$facial(1,2)><$motion(1,803)><$voicel(1,7)>Hey, heyyy! I’ve got a path I could use your help clearin’!
msgctxt "2049:205"
msgid "<$comeff(1,5)><$facial(1,2)><$motion(1,803)><$voicel(1,7)>¡Necesito que me apañes un camino!"
msgstr "<$comeff(1,5)><$facial(1,2)><$motion(1,803)><$voicel(1,7)>¡Necesito que me arregles un camino!"

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Nice! I made it! Thanks, bud!
msgctxt "2049:206"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Gracias, niñ<gen;-2(o,a)>. De no haber sido por ti, no habría llegado."
msgstr ""

#. en: <$comeff(1,3)><$facial(1,1)><$motion(1,803)><$voicel(1,6)>Whoa, wait... You already have what I asked for?! Well hey,<br>if you don’t mind, <$comeff(1,6)><$motion(1,666)><$voicel(1,4)>could I go ahead and grab what I need<slide><br>off ya, bud?
msgctxt "2049:209"
msgid "<$comeff(1,3)><$facial(1,1)><$motion(1,803)><$voicel(1,6)>¡Qué me dices! ¿Que ya tienes lo que necesito? Pueees...<br><$comeff(1,6)><$motion(1,666)><$voicel(1,4)>¿Me lo puedes dar?"
msgstr ""

#. en: <$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,3)>All right. No big deal!<clear><br><$comeff(1,10)><$facial(1,1)><$motion(1,803)><$voicel(1,6)>Lemme know if ya change your mind, though! It’d be a<br>big help!
msgctxt "2049:210"
msgid "<$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,3)>Si es que no, es que no... <$comeff(1,10)><$facial(1,1)><$motion(1,803)><$voicel(1,6)>En fin, si cambias de opinión,<br>me harías un favorazo."
msgstr ""

#. en: <$emotion(1,29)><$voicel(1,5)>Hey, bud. I really wanna talk to <$cdef(27)><nquestappk;0></color>. Can ya<br>take me to them?
msgctxt "2049:212"
msgid "<oneline><$emotion(1,29)><$voicel(1,5)>¿Me puedes llevar con <dart;0()><$cdef(27)><nquestappk;0></color>? Me apetece<br>charlar<slide><br>con <gen;0(él,ella)>,<slide><br>pero ni idea de dónde anda."
msgstr "<oneline><$emotion(1,29)><$voicel(1,5)>¿Me puedes llevar con <dart;0()><$cdef(27)><nquestappk;0></color>? Quiero<br>charlar<slide><br>con <gen;0(él,ella)>,<slide><br>pero ni idea de dónde anda."

#. en: <$emotion(1,8)><$voicel(1,9)>We made it! Awesome! Thanks, <$cdef(27)><pname;0></color>!
msgctxt "2049:213"
msgid "<oneline><$emotion(1,8)><$voicel(1,9)>¡Así que aquí andaba! ¡Gracias por traerme,<br><$cdef(27)><pname;0></color>!"
msgstr ""

#. en: <$emotion(1,29)><$voicel(1,7)>I’m kinda interested in this photo thing I’ve heard about.<br>Think we could take one together, bud?
msgctxt "2049:214"
msgid "<$emotion(1,29)><$voicel(1,7)>Todo el mundo va loco con esto de las fotos... y ya me<br>ha picao la curiosidad. ¿Quieres que nos hagamos una?"
msgstr "<$emotion(1,29)><$voicel(1,7)>Todo el mundo anda loco con esto de las fotos... y ya me<br>picó la curiosidad. ¿Quieres que nos tomemos una?"

#. en: <$emotion(1,14)><$voicel(1,8)>Hey, heyyy! This is our photo, huh?<clear><br><$emotion(1,38)><$voicel(1,7)>It’s pretty cool! Thanks for doin’ that with me, bud!
msgctxt "2049:215"
msgid "<$emotion(1,14)><$voicel(1,8)>Conque así ha quedado la foto de marras...<clear><br><$emotion(1,38)><$voicel(1,7)>Pues no hemos salido nada mal. ¡Gracias, niñ<gen;-2(o,a)>!"
msgstr "<$emotion(1,14)><$voicel(1,8)>Conque así quedó la famosa foto...<clear><br><$emotion(1,38)><$voicel(1,7)>Pues no salimos nada mal. ¡Gracias, amig<gen;-2(o,a)>!"

#. en: <oneline><$comeff(1,5)><$motion(1,803)><$voicel(1,7)>Whoa! Hold up! I just realized that <$cdef(27)><nquestappk;0> </color>is<br>literally<slide><br>right there!
msgctxt "2049:217"
msgid "<$comeff(1,5)><$motion(1,803)><$voicel(1,7)>Madre mía, ¡si es que no veo tres en un Mudbray! Yo aquí<br>buscando <esa;0()><$cdef(27)><nquestappk;0></color>, ¡y está ahí mismo!"
msgstr "<$comeff(1,5)><$motion(1,803)><$voicel(1,7)>Cielos, ¡si es que estoy ciego como un Diglett! Yo aquí<br>buscando <esa;0()><$cdef(27)><nquestappk;0></color>, ¡y está ahí mismo!"

#. en: <$comeff(1,6)><$facial(1,1)><$motion(1,661)><$voicel(1,6)>Hey, heyyy! You got a minute, bud? Got somethin’ I could<br>use a li’l help with...
msgctxt "2049:224"
msgid "<oneline><$comeff(1,6)><$facial(1,1)><$motion(1,661)><$voicel(1,6)>Oye, <$cdef(27)><pname;0></color>, ¿te puedo pedir un<br>favorcete?"
msgstr "<oneline><$comeff(1,6)><$facial(1,1)><$motion(1,661)><$voicel(1,6)>Oye, <$cdef(27)><pname;0></color>, ¿te puedo pedir un<br>favorcito?"

#. en: <$comeff(1,10)><$facial(1,1)><$motion(1,807)><$voicel(1,3)>Gotcha! Sorry for botherin’ ya, then!
msgctxt "2049:225"
msgid "<$comeff(1,10)><$facial(1,1)><$motion(1,807)><$voicel(1,3)>Vale, tampoco quiero molestar."
msgstr "<$comeff(1,10)><$facial(1,1)><$motion(1,807)><$voicel(1,3)>Bueno, tampoco quiero molestar."

#. en: <oneline><$comeff(1,14)><$voicel(1,5)>Could you maybe put<br><iart;1()><$cdef(27)><fqty(1)><class><nquestitem;1></color><slide><br><$emotion(1,29)><$voicel(1,8)>in<slide><br>my<slide><br>livin’ space?
msgctxt "2049:226"
msgid "<oneline><$comeff(1,14)><$voicel(1,5)>Quiero algo en casa...<wait(0.5)><br><$emotion(1,29)><$voicel(1,8)>¡<fcap><iart;1()><$cdef(27)><fqty(1)><class><nquestitem;1></color>!"
msgstr ""

#. en: <$emotion(1,60)><$voicel(1,7)>Hey, heyyy! Ya got it for me, huh? Thanks, bud! <$emotion(1,8)><$voicel(1,10)>That’s a<br>big help!
msgctxt "2049:227"
msgid "<$emotion(1,60)><$voicel(1,7)>¿En serio? ¡Cómo te portas! Gracias, niñ<gen;-2(o,a)>.<br><$emotion(1,8)><$voicel(1,10)>¡Qué haría yo sin ti!"
msgstr "<$emotion(1,60)><$voicel(1,7)>¿En serio? ¡Eres lo máximo! Gracias, amig<gen;-2(o,a)>.<br><$emotion(1,8)><$voicel(1,10)>¡Qué haría yo sin ti!"

#. en: <$comeff(1,6)><$facial(1,1)><$motion(1,806)><$voicel(1,8)>Huh? You’re tellin’ me you already took care of it?!<br>Awesome, bud!
msgctxt "2049:232"
msgid "<$comeff(1,6)><$facial(1,1)><$motion(1,806)><$voicel(1,8)>¿Eh? ¿Ya está todo listo? ¡No puede ser!"
msgstr ""

#. en: <$comeff(1,5)><$facial(1,1)><$motion(1,805)><$voicel(1,7)>Whoa... You already got it set up for me?! Nice!
msgctxt "2049:233"
msgid "<$comeff(1,5)><$facial(1,1)><$motion(1,805)><$voicel(1,7)>Jo, no me digas que ya has colocao eso. ¡No me lo creo!"
msgstr "<$comeff(1,5)><$facial(1,1)><$motion(1,805)><$voicel(1,7)>Vaya, no me digas que ya colocaste eso. ¡No me lo creo!"

#. en: <$comeff(1,6)><$facial(1,1)><$motion(1,803)><$voicel(1,6)>Whoa, wait... You already took care of it?! Nice one, bud!
msgctxt "2049:234"
msgid "<$comeff(1,6)><$facial(1,1)><$motion(1,803)><$voicel(1,6)>¿Eh? ¿Que ya has hecho lo que te había pedido?<br>¡Cómo te lo curras!"
msgstr "<$comeff(1,6)><$facial(1,1)><$motion(1,803)><$voicel(1,6)>¿Eh? ¿Que ya hiciste lo que te había pedido?<br>¡Cómo te esfuerzas!"

#. en: <$emotion(1,14)><$voicel(1,8)>Hey heyyy, <$cdef(27)><pname;0></color>!<clear><br><$comeff(1,14)><$voicel(1,5)>I’ve got some things I’m havin’ everybody help me with<br>right now, <$emotion(1,38)><$voicel(1,10)>and I’d love to have you join ’em!
msgctxt "2049:235"
msgid "<$emotion(1,14)><$voicel(1,8)>¡Ey, <$cdef(27)><pname;0></color>! Amig<gen;-2(o,a)>, colega...<clear><br><$comeff(1,14)><$voicel(1,5)>Aquí la peña me está ayudando con un asuntillo...<br><$emotion(1,38)><$voicel(1,10)>¡y me gustaría que me echaras un cable tú también!"
msgstr "<$emotion(1,14)><$voicel(1,8)>¡Ey, <$cdef(27)><pname;0></color>! Amig<gen;-2(o,a)> del alma...<clear><br><$comeff(1,14)><$voicel(1,5)>Aquí todos me están ayudando con un asuntito...<br><$emotion(1,38)><$voicel(1,10)>¡y me gustaría que me echaras una mano tú también!"

#. en: <$comeff(1,14)><$motion(1,803)><$voicel(1,7)>Y’know that thing I was havin’ everybody help me with?<br><$emotion(1,8)><$voicel(1,10)>Well, we managed to get it all done!<clear><br><$emotion(1,37)><$voicel(1,7)>Hope you don’t mind me askin’ ya for help again next time<br>somethin’ comes up, bud!
msgctxt "2049:236"
msgid "<$comeff(1,14)><$motion(1,803)><$voicel(1,7)>¿Sabes aquello que te comenté de que todos me estaban<br>ayudando con algo? <$emotion(1,8)><$voicel(1,10)>¡Pues ya está finiquitado!<clear><br><$emotion(1,37)><$voicel(1,7)>Si surge cualquier otra cosa, te digo."
msgstr ""

#. en: <$emotion(1,50)><$voicel(1,5)>Y’know when you’re wanderin’ around and you notice that<br>the town’s changed a bit? Doesn’t that excite ya?<clear><br><$comeff(1,3)><$facial(1,4)><$motionoff(1,804)><$voicel(1,8)>So anyway, what I’m tryin’ to say here is that it’d be real<br>cool if ya could build a new house for the town!
msgctxt "2049:237"
msgid "<$emotion(1,50)><$voicel(1,5)>Ir de paseo y ver que el vecindario va cambiando siempre<br>me da un alegrón.<clear><br><$comeff(1,3)><$facial(1,4)><$motionoff(1,804)><$voicel(1,8)>¿Qué tal si me haces el favor de construir alguna casa<br>humana nueva?"
msgstr ""

#. en: <oneline><$comeff(1,9)><$motion(1,801)><$voicel(1,9)>You built a house? Awesome! Thanks a<br>ton, <$cdef(27)><pname;0></color>!
msgctxt "2049:238"
msgid "<oneline><$comeff(1,9)><$motion(1,801)><$voicel(1,9)>¿Has construido una casa humana? ¡Eres un hacha,<br><$cdef(27)><pname;0></color>!"
msgstr "<oneline><$comeff(1,9)><$motion(1,801)><$voicel(1,9)>¿Construiste una casa humana? ¡Eres lo máximo,<br><$cdef(27)><pname;0></color>!"

#. en: <oneline><$comeff(1,14)><$motion(1,806)><$voicel(1,5)>I could REALLY go for<br><iart;0()><$cdef(27)><fqty(1)><class><nquestitem;0></color><slide><$cdef(27)><br></color>right<slide><br>about now...<clear><br><$comeff(1,3)><$motion(1,803)><$voicel(1,8)>Lemme know if you have any you wouldn’t mind sharin’!
msgctxt "2049:239"
msgid "<oneline><$comeff(1,14)><$motion(1,806)><$voicel(1,5)>Ahora mismo me llenaría el buche con<br><iart;0()><$cdef(27)><fqty(1)><class><nquestitem;0></color>.<slide><br><$comeff(1,3)><$motion(1,803)><$voicel(1,8)>¡Si tienes pa compartir, sería un detallazo!"
msgstr ""

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,9)>Awesome, bud! Thanks for sharin’!
msgctxt "2049:240"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,9)>¡Eres <gen;-2(el,la)> mejor, tronc<gen;-2(o,a)>! ¡Hala, pa'l buche!"
msgstr "<$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,9)>¡Eres <gen;-2(el,la)> mejor, amig<gen;-2(o,a)>! ¡Y ahora, pa'l buche!"

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>Well, dang. That was fast! Guess I’m all good to go now!
msgctxt "2049:241"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>¡Buah, qué rapidez! ¡Pos ya está solucionao!"
msgstr "<$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>¡Guau, qué rapidez! ¡Pos ya está solucionao!"

#. en: <oneline><$comeff(1,9)><$motion(1,801)><$voicel(1,9)>I knew I could count on you, <$cdef(27)><pname;0></color>!<br>Thanks, bud!
msgctxt "2049:242"
msgid "<$comeff(1,9)><$motion(1,801)><$voicel(1,9)>¡<$cdef(27)><pname;0></color>, tú siempre cumples! ¡Gracias!"
msgstr ""

#. en: <$comeff(1,5)><$facial(1,1)><$motion(1,661)><$voicel(1,7)>Whoa, what?! You already got some on you? Mind sharin’<br>with me?
msgctxt "2049:243"
msgid "<$comeff(1,5)><$facial(1,1)><$motion(1,661)><$voicel(1,7)>¿Eh? ¡Pero si ya has cocinao el plato que te he pedío!<br>¿Me das un poco, amig<gen;-2(o,a)>?"
msgstr "<$comeff(1,5)><$facial(1,1)><$motion(1,661)><$voicel(1,7)>¿Eh? ¡Pero si ya cocinaste el platillo que te pedí!<br>¿Me das un poco, amig<gen;-2(o,a)>?"

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,9)>Awesome, bud! Thanks for sharin’!
msgctxt "2049:244"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,9)>¡Qué alegrón! ¡Gracias por compartir!"
msgstr ""

#. en: <oneline><$voicel(1,7)><$emotion(1,9)><$facial(1,4)>Hey hey, <$cdef(27)><pname;0></color>! Thanks for everything<br>you<slide><br>do<slide><br>for us!<clear><br><$voicel(1,10)><$emotion(1,8)>Here! Just a little somethin’ to show how much it means<br>to me!
msgctxt "2049:301"
msgid "<oneline><$voicel(1,7)><$emotion(1,9)><$facial(1,4)>¡Ey, qué pasa, <$cdef(27)><pname;0></color>! Siempre ahí<br>ayudando<slide><br>al personal, ¿no?<slide><br>¡Se agradece!<clear><br><$voicel(1,10)><$emotion(1,8)>Pues aquí tienes un detallazo <gen;-3(del,de la)> menda.<br>¡Que no se diga!"
msgstr "<oneline><$voicel(1,7)><$emotion(1,9)><$facial(1,4)>¡Ey, qué pasa, <$cdef(27)><pname;0></color>! Siempre ahí<br>ayudando<slide><br>a la gente, ¿no?<slide><br>¡Se agradece!<clear><br><$voicel(1,10)><$emotion(1,8)>Toma un detallito <gen;-3(del,de la)> que te aprecia.<br>¡Que no se diga!"

#. en: <$comeff(1,7)><$motion(1,802)><$voicel(1,3)>Think I’ll pass! Walkin’ with so many Pokémon sounds<br>annoying!
msgctxt "2049:302"
msgid "<$comeff(1,7)><$motion(1,802)><$voicel(1,3)>Debe de ser un rollazo ir pendiente de tantos Pokémon<br>a la vez, así que ya iremos tú y yo de paseo otro día, ¿va?"
msgstr "<$comeff(1,7)><$motion(1,802)><$voicel(1,3)>Debe de ser una lata estar pendiente de tantos Pokémon<br>a la vez, así que ya iremos tú y yo de paseo otro día, ¿sí?"

#. en: <$comeff(1,4)><$motion(1,802)><$voicel(1,3)>Can’t right now. Sorry, bud. Maybe some other time?
msgctxt "2049:303"
msgid "<$comeff(1,4)><$motion(1,802)><$voicel(1,3)>Perdona, ahora me viene mal. ¿Te importa volver en un<br>ratejo?"
msgstr "<$comeff(1,4)><$motion(1,802)><$voicel(1,3)>Perdona, ahora me viene mal. ¿Te importa volver en un<br>ratito?"

#. en: <$voicel(1,7)><$motionoff(1,804)><$comeff(1,10)><$facial(1,4)>Ngh! Yahhh! Just a bit more work! <$pkcry;0(1,2)>!
msgctxt "2049:304"
msgid "<$voicel(1,7)><$motionoff(1,804)><$comeff(1,10)><$facial(1,4)>¡Uno, dos! ¡Uno, dos! ¡Aumpf! ¡Un arreón final y listos!<br>¡<$pkcry;0(1,2)>!"
msgstr "<$voicel(1,7)><$motionoff(1,804)><$comeff(1,10)><$facial(1,4)>¡Uno, dos! ¡Uno, dos! ¡Aumpf! ¡Un último empujón y listo!<br>¡<$pkcry;0(1,2)>!"

#. en: <$voicel(1,8)><$emotion(1,1)>All right, bud. I’ll follow ya!
msgctxt "2049:305"
msgid "<$voicel(1,8)><$emotion(1,1)>¡Pues venga, arreando!"
msgstr "<$voicel(1,8)><$emotion(1,1)>¡Pues vamos, en marcha!"

#. en: <$emotion(1,14)><$voicel(1,8)>All right. Catch ya later!
msgctxt "2049:306"
msgid "<$emotion(1,14)><$voicel(1,8)>Vale. ¡Ya nos vemos por ahí!"
msgstr "<$emotion(1,14)><$voicel(1,8)>Bueno. ¡Ya nos vemos por ahí!"

#. en: <$comeff(1,19)><$facial(1,9)><$motion(1,802)><$voicel(1,1)>Sorry, bud... I’m just so hungry right now. I dunno if I could<br>take a single step...
msgctxt "2049:307"
msgid "<$comeff(1,19)><$facial(1,9)><$motion(1,802)><$voicel(1,1)>Lo siento, pero ahora mismo tengo un hambre que no<br>me puedo ni mover."
msgstr ""

#. en: <$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,1)>Ugh... I’m just...so hungry... I dunno if I can take another<br>step, bud.
msgctxt "2049:308"
msgid "<$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,1)>Buah, qué hambre más tonta me ha entrao de pronto.<br>No puedo dar ni un paso más."
msgstr "<$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,1)>Uf, qué hambre más tonta me entró de pronto.<br>No puedo dar ni un paso más."

#. en: <$comeff(1,14)><$facial(1,9)><$motion(1,807)><$voicel(1,4)>Why’s rain gotta be so chilly? I feel like I’m gonna catch a<br>cold if I stay out here too long!
msgctxt "2049:311"
msgid "<$comeff(1,14)><$facial(1,9)><$motion(1,807)><$voicel(1,4)>¿Por qué tiene que estar tan fría la lluvia? ¡Como siga así,<br>me voy a resfriar pero bien!"
msgstr ""

#. en: <$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,3)>Whoa, whoa, WHOA! Cut that out, bud!
msgctxt "2049:315"
msgid "<$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,3)>¿Pero qué haces, niñ<gen;-2(o,a)>? ¡Córtate un poco!"
msgstr "<$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,3)>¿Pero qué haces, amig<gen;-2(o,a)>? ¡Cálmate un poco!"

#. en: <oneline><$emotion(1,38)><$voicel(1,9)>This <$cdef(27)><fqty(1)><class><aireactp;0> </color>is<br>pretty<slide><br>cool, bud!<clear><br><$emotion(1,29)><$voicel(1,7)>Hey, would you mind puttin’ it closer to my livin’ space?
msgctxt "2049:317"
msgid "<oneline><$emotion(1,38)><$voicel(1,9)>¡Ey, <genqty;0(este,esta,estos,estas)> <$cdef(27)><fqty(1)><aireactp;0> </color><qty;0(es,son)> la caña!<br><$emotion(1,29)><$voicel(1,7)>¿Pero no podría estar en mi casa?"
msgstr "<oneline><$emotion(1,38)><$voicel(1,9)>¡Ey, <genqty;0(este,esta,estos,estas)> <$cdef(27)><fqty(1)><aireactp;0> </color><qty;0(es,son)> lo máximo!<br><$emotion(1,29)><$voicel(1,7)>¿Pero no podría estar en mi casa?"

#. en: <oneline><$emotion(1,8)><$voicel(1,9)>Ya put this <$cdef(27)><fqty(1)><class><aireactp;0><br></color>here<slide><br>for<slide><br>me?<slide><br><$pkcry;1(1,2)>! ♪<slide><br>Thanks, bud!
msgctxt "2049:318"
msgid "<oneline><$emotion(1,8)><$voicel(1,9)>♪¡<$pkcry;1(1,2)>!♪ ¡Gracias por<br><dart;0()><$cdef(27)><fqty(1)><aireactp;0></color>,<slide><br>niñ<gen;-2(o,a)>!"
msgstr "<oneline><$emotion(1,8)><$voicel(1,9)>♪¡<$pkcry;1(1,2)>!♪ ¡Gracias por<br><dart;0()><$cdef(27)><fqty(1)><aireactp;0></color>,<slide><br>amig<gen;-2(o,a)>!"

#. en: <$comeff(1,9)><$motion(1,806)><$voicel(1,7)><$pkcry;0(1,2)>! ♪ That’s a nice move ya got there!
msgctxt "2049:319"
msgid "<$comeff(1,9)><$motion(1,806)><$voicel(1,7)>♪¡<$pkcry;0(1,2)>!♪ ¡Qué movimiento más guapo!"
msgstr "<$comeff(1,9)><$motion(1,806)><$voicel(1,7)>♪¡<$pkcry;0(1,2)>!♪ ¡Qué movimiento tan genial!"

#. en: <$comeff(1,6)><$motion(1,666)><$voicel(1,5)>Huh? What was that just now, <$cdef(27)><pname;0></color>?
msgctxt "2049:320"
msgid "<$comeff(1,6)><$motion(1,666)><$voicel(1,5)>¿Eh? ¿Qué ha sido eso, <$cdef(27)><pname;0></color>?"
msgstr "<$comeff(1,6)><$motion(1,666)><$voicel(1,5)>¿Eh? ¿Qué fue eso, <$cdef(27)><pname;0></color>?"

#. en: <oneline><$emotion(1,31)><$voicel(1,3)>The <$cdef(27)><fqty(1)><class><aireactp;1></color><br>is gone...<slide><br><$pkcry;0(1,4)>...
msgctxt "2049:322"
msgid "<oneline><$emotion(1,31)><$voicel(1,3)>Me he quedao sin <qty;1(mi,mis)><br><$cdef(27)><fqty(1)><aireactp;1></color>...<slide><br><$pkcry;0(1,4)>..."
msgstr "<oneline><$emotion(1,31)><$voicel(1,3)>Me quedé sin <qty;1(mi,mis)><br><$cdef(27)><fqty(1)><aireactp;1></color>...<slide><br><$pkcry;0(1,4)>..."

#. en: <$emotion(1,38)><$voicel(1,9)>Woo! My home’s nice and warm now!
msgctxt "2049:323"
msgid "<$emotion(1,38)><$voicel(1,9)>¡Buah! ¡No veas lo bien que se está ahora en casa con<br>este calorcito!"
msgstr "<$emotion(1,38)><$voicel(1,9)>¡Guau! ¡No sabes lo bien que se está ahora en casa con<br>este calorcito!"

#. en: <$emotion(1,51)><$voicel(1,3)>My home’s a li’l too hot for me now... <$emotion(1,31)><$voicel(1,2)>Uggghhh. The heat<br>really saps my energy...
msgctxt "2049:324"
msgid "<$emotion(1,51)><$voicel(1,3)>Buf, mi casa está ahora mismo que parece un horno...<br><$emotion(1,31)><$voicel(1,2)>Estoy aplatan<gen;-3(á,ao)> con tanto calor."
msgstr "<$emotion(1,51)><$voicel(1,3)>Buf, mi casa está ahora mismo que parece un horno...<br><$emotion(1,31)><$voicel(1,2)>Estoy agot<gen;-3(á,ao)> con tanto calor."

#. en: <$emotion(1,8)><$voicel(1,9)>Hey, heyyy! My home’s...cooler than it was before? It’s<br>pretty awesome!
msgctxt "2049:325"
msgid "<$emotion(1,8)><$voicel(1,9)>En casa, con el fresquito que hace ahora, se está de lujo."
msgstr ""

#. en: <$comeff(1,23)><$facial(1,9)><$motion(1,807)><$voicel(1,4)>Brrr... My home’s a li’l too cold for me now... <$emotion(1,31)><$voicel(1,2)>It’s got me<br>feelin’ kinda off, y’know what I mean?
msgctxt "2049:326"
msgid "<$comeff(1,23)><$facial(1,9)><$motion(1,807)><$voicel(1,4)>Brrr... Qué frío que hace ahora en casa, madre mía...<br><$emotion(1,31)><$voicel(1,2)>Al final voy a pillar un catarrazo."
msgstr "<$comeff(1,23)><$facial(1,9)><$motion(1,807)><$voicel(1,4)>Brrr... Qué frío que hace ahora en casa, cielos...<br><$emotion(1,31)><$voicel(1,2)>Al final voy a agarrar un resfriado."

#. en: <$emotion(1,50)><$voicel(1,7)>My home’s a li’l brighter now! <$emotion(1,38)><$voicel(1,10)>I’m really likin’ it!
msgctxt "2049:327"
msgid "<$emotion(1,50)><$voicel(1,7)>Ahora en casa hay un poco más de luz... ¡y vaya si se nota!<br><$emotion(1,38)><$voicel(1,10)>¡De repente estoy como más animad<gen;-3(o,a)>!"
msgstr ""

#. en: <$comeff(1,14)><$facial(1,9)><$motion(1,803)><$voicel(1,3)>Oof... My home’s gotten a li’l too bright. <$emotion(1,41)><$voicel(1,2)>I liked it better<br>when it was just a tad darker.
msgctxt "2049:328"
msgid "<$comeff(1,14)><$facial(1,9)><$motion(1,803)><$voicel(1,3)>Últimamente en casa hay demasiada luz pa mi gusto.<br><$emotion(1,41)><$voicel(1,2)>A este paso voy a necesitar unas gafas de sol..."
msgstr "<$comeff(1,14)><$facial(1,9)><$motion(1,803)><$voicel(1,3)>Últimamente en casa hay demasiada luz pa mi gusto.<br><$emotion(1,41)><$voicel(1,2)>A este paso voy a necesitar unos lentes de sol..."

#. en: <$emotion(1,8)><$voicel(1,9)>Hey, heyyy! My home’s gotten darker! I like it better<br>this way!
msgctxt "2049:329"
msgid "<$emotion(1,8)><$voicel(1,9)>Ahora hay menos luz en casa. ¡Justo como a mí me gusta!"
msgstr ""

#. en: <$comeff(1,3)><$facial(1,9)><$motion(1,803)><$voicel(1,3)>Oh. Hey, bud... My home’s a little darker now than it was<br>before. <$comeff(1,19)><$facial(1,9)><$motion(1,802)><$voicel(1,2)>It’s got me feelin’ kinda gloomy...
msgctxt "2049:330"
msgid "<$comeff(1,3)><$facial(1,9)><$motion(1,803)><$voicel(1,3)>Ey, ¿qué pasa por tu casa, niñ<gen;-2(o,a)>?<clear><br><$comeff(1,19)><$facial(1,9)><$motion(1,802)><$voicel(1,2)>En la mía ahora hay menos luz que antes, y la verdad es<br>que me apaga un poco a mí también..."
msgstr "<$comeff(1,3)><$facial(1,9)><$motion(1,803)><$voicel(1,3)>Ey, ¿qué pasa por tu casa, amig<gen;-2(o,a)>?<clear><br><$comeff(1,19)><$facial(1,9)><$motion(1,802)><$voicel(1,2)>En la mía ahora hay menos luz que antes, y la verdad es<br>que me apaga un poco a mí también..."

#. en: <$comeff(1,9)><$motion(1,806)><$voicel(1,9)>My home’s gotten a li’l humid...and it feels great!
msgctxt "2049:331"
msgid "<$comeff(1,9)><$motion(1,806)><$voicel(1,9)>Ahora hay más humedad en casa... ¡y es una gozada!"
msgstr "<$comeff(1,9)><$motion(1,806)><$voicel(1,9)>Ahora hay más humedad en casa... ¡y es una maravilla!"

#. en: <oneline><$facial(1,9)><$comeff(1,19)><$motion(1,802)><$voicel(1,1)>Hey, <$cdef(27)><pname;0></color>. Sure is humid around<br>here,<slide><br>don’t<slide><br>you think?<clear><br><$facial(1,1)><$comeff(1,1)><$voicel(1,8)>I’m thinkin’ it’d feel a lot better if it were a bit drier!
msgctxt "2049:332"
msgid "<$cdef(27)><$facial(1,9)></color><$comeff(1,19)><$motion(1,802)><$voicel(1,1)>Uf, hay una humedad aquí que tira p'atrás. ¿Me equivoco?<clear><br><$facial(1,1)><$comeff(1,1)><$voicel(1,8)>¡Anda que no me llevaría un buen alegrón si estuviese<br>más seco el tema!"
msgstr "<$cdef(27)><$facial(1,9)></color><$comeff(1,19)><$motion(1,802)><$voicel(1,1)>Uf, hay una humedad aquí que no se aguanta. ¿Me equivoco?<clear><br><$facial(1,1)><$comeff(1,1)><$voicel(1,8)>¡Ay, qué alegrón me llevaría si estuviera<br>más seco el ambiente!"

#. en: <oneline><$facial(1,4)><$comeff(1,10)><$motion(1,801)><$voicel(1,9)>Hey heyyy, <$cdef(27)><pname;0></color>! I’m feelin’ good<br>now<slide><br>that<slide><br>there’s<slide><br>a bit<slide><br>less humidity in the air. Thanks, bud!
msgctxt "2049:333"
msgid "<$facial(1,4)><$comeff(1,10)><$motion(1,801)><$voicel(1,9)>Buah, estoy aquí como <gen;-3(un,una)> <gen;-3(rey,reina)> con este aire tan seco.<br>¡Eres un hacha, <$cdef(27)><pname;0></color>!"
msgstr "<$facial(1,4)><$comeff(1,10)><$motion(1,801)><$voicel(1,9)>Guau, estoy aquí como <gen;-3(un,una)> <gen;-3(rey,reina)> con este aire tan seco.<br>¡Eres lo máximo, <$cdef(27)><pname;0></color>!"

#. en: <$facial(1,9)><$comeff(1,19)><$motion(1,802)><$voicel(1,7)>My home’s feelin’ a bit dry. Might be nice to have a little<br>more humidity around here!
msgctxt "2049:334"
msgid "<$facial(1,9)><$comeff(1,19)><$motion(1,802)><$voicel(1,7)>Llámame loc<gen;-3(o,a)>, pero a mí me parece que mi casa está<br>más seca que un traje de paja.<clear><br>Le vendría bien un flis flis de humedad."
msgstr "<$facial(1,9)><$comeff(1,19)><$motion(1,802)><$voicel(1,7)>Llámame loc<gen;-3(o,a)>, pero a mí me parece que mi casa está<br>más seca que un traje de paja.<clear><br>Le vendría bien un chorrito de humedad."

#. en: <$comeff(1,14)><$facial(1,9)><$voicel(1,3)>Well, this is no good... I can’t get through! I just wanna get<br>over to that thing <$emotion(1,31)><$voicel(1,2)>you set down for me...<clear><br><$emotion(1,29)><$voicel(1,5)>Sorry for asking you to do every li’l thing for me, but could<br>you make a path for me to get over there?
msgctxt "2049:335"
msgid "<$comeff(1,14)><$facial(1,9)><$voicel(1,3)>Vaya, hombre... Quiero ver lo que has colocado...<br><$emotion(1,31)><$voicel(1,2)>pero yo por aquí no puedo pasar ni queriendo.<clear><br><$emotion(1,29)><$voicel(1,5)>Siento estar siempre dándote la murga, ¿pero podrías<br>abrirme un camino?"
msgstr "<$comeff(1,14)><$facial(1,9)><$voicel(1,3)>Vaya, hombre... Quiero ver lo que colocaste...<br><$emotion(1,31)><$voicel(1,2)>pero yo por aquí no puedo pasar ni queriendo.<clear><br><$emotion(1,29)><$voicel(1,5)>Siento estar siempre dándote lata, ¿pero podrías<br>abrirme un camino?"

#. en: <$emotion(1,37)><$voicel(1,8)>I got this—no problem!
msgctxt "2049:336"
msgid "<$emotion(1,37)><$voicel(1,8)>¡Déjamelo a mí!"
msgstr ""

#. en: <$comeff(1,6)><$facial(1,1)><$motion(1,805)><$voicel(1,6)>Somethin’ kinda weird is goin’ on here... Let’s check it<br>out, <$cdef(27)><pname;0></color>!
msgctxt "2049:337"
msgid "<oneline><$comeff(1,6)><$facial(1,1)><$motion(1,805)><$voicel(1,6)>Aquí hay algo raro, ¿no crees? ¡Echa un vistazo,<br><$cdef(27)><pname;0></color>!"
msgstr ""

#. en: <$emotion(1,29)><$voicel(1,7)><$pkcry;0(1,2)>! We makin’ good progress?
msgctxt "2049:338"
msgid "<oneline><$emotion(1,29)><$voicel(1,7)>¡<$pkcry;0(1,2)>! Progresando adecuadamente,<br>¿no crees?"
msgstr ""

#. en: <oneline><$comeff(1,9)><$motion(1,806)><$voicel(1,9)><$pkcry;0(1,2)>! Nothin’ beats the smell of a good meal<br>cookin’!
msgctxt "2049:339"
msgid "<$comeff(1,9)><$motion(1,806)><$voicel(1,9)>¡<$pkcry;0(1,2)>! Este olor... ¡es irresistible!"
msgstr ""

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Woo-hoooo! Don’t ya just love parties, bud?
msgctxt "2049:340"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Cómo me gusta esto de estar de fiestuqui!"
msgstr "<$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Cómo me gusta esto de estar de fiesta!"

#. en: <$comeff(1,21)><$facial(1,4)><$motion(1,803)><$voicel(1,5)>The hot water’s warmin’ me up all the way to my core!
msgctxt "2049:341"
msgid "<$comeff(1,21)><$facial(1,4)><$motion(1,803)><$voicel(1,5)>Qué bueno el calorcito del agua..."
msgstr ""

#. en: <oneline><$emotion(1,29)><$voicel(1,5)>Hey, bud. Do ya think you could move that<br><$cdef(27)><fqty(1)><class><aireactp;0></color><slide><br>someplace<slide><br>where<slide><br>there’s<slide><br>no water?<clear><br><$emotion(1,38)><$voicel(1,9)>It’s kinda hard to use as is, y’know? I’m countin’ on<br>ya, <$cdef(27)><pname;1></color>!
msgctxt "2049:343"
msgid "<$emotion(1,29)><$voicel(1,5)>Llámame loc<gen;-3(o,a)>, ¿pero no le vendría mejor un sitio sin agua<br><esa;0()><fqty(1)><$cdef(27)><aireactp;0></color>?<clear><br><$emotion(1,38)><$voicel(1,9)>Usarl<genqty;0(o,a,os,as)> tal y como est<qty;0(á,án)> va a ser chungo de narices.<br>¡Hazme ese favorazo, <$cdef(27)><pname;1></color>!"
msgstr "<$emotion(1,29)><$voicel(1,5)>Llámame loc<gen;-3(o,a)>, ¿pero no le vendría mejor un lugar sin agua<br><esa;0()><fqty(1)><$cdef(27)><aireactp;0></color>?<clear><br><$emotion(1,38)><$voicel(1,9)>Usarl<genqty;0(o,a,os,as)> tal y como est<qty;0(á,án)> va a ser dificilísimo.<br>¡Hazme ese favorazo, <$cdef(27)><pname;1></color>!"

#. en: <$comeff(1,9)><$motion(1,801)><$voicel(1,9)>My pad’s really awesome now! Thanks a ton for all your<br>help, bud!
msgctxt "2049:344"
msgid "<$comeff(1,9)><$motion(1,801)><$voicel(1,9)>¡Ole mi casa, qué bien está quedando! Gracias por el<br>currazo, tronc<gen;-2(o,a)>."
msgstr "<$comeff(1,9)><$motion(1,801)><$voicel(1,9)>¡Mira mi casa, qué bien está quedando! Gracias por el<br>trabajazo, amig<gen;-2(o,a)>."

#. en: <$comeff(1,21)><$motion(1,806)><$voicel(1,7)>The area around my pad’s gettin’ pretty nice. Keep doin’<br>what you’re doin’—I really appreciate it!
msgctxt "2049:345"
msgid "<$comeff(1,21)><$motion(1,806)><$voicel(1,7)>¡Buah, la zona de mi casa está cada día mejor! ¡Sigue<br>currándotelo como hasta ahora, camarada!"
msgstr "<$comeff(1,21)><$motion(1,806)><$voicel(1,7)>¡Guau, la zona de mi casa está cada día mejor! ¡Sigue<br>esforzándote como hasta ahora, camarada!"

#. en: <$comeff(1,6)><$facial(1,1)><$motion(1,805)><$voicel(1,5)>Hey, heyyy! You up for some treasure huntin’, bud?<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>Let’s fire up the<$cdef(27)> <fqty(1)><$ifull(2793)></color> and have some fun!
msgctxt "2049:400"
msgid "<oneline><$comeff(1,6)><$facial(1,1)><$motion(1,805)><$voicel(1,5)><$cdef(27)><pname;0></color>, niñ<gen;-2(o,a)>, ¿nos vamos un ratejo<br>a buscar tesoros?<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>Para eso tienes el <$cdef(27)><fqty(1)><$ifull(2793)></color>, tronc<gen;-2(o,a)>. ¡Anímate, que es<br>un planazo!"
msgstr "<oneline><$comeff(1,6)><$facial(1,1)><$motion(1,805)><$voicel(1,5)><$cdef(27)><pname;0></color>, amig<gen;-2(o,a)>, ¿nos vamos un ratito<br>a buscar tesoros?<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>Para eso tienes el <$cdef(27)><fqty(1)><$ifull(2793)></color>, compañer<gen;-2(o,a)>. ¡Anímate,<br>que es un gran plan!"

#. en: <oneline><$emotion(1,29)><$voicel(1,7)>Hey heyyy, <$cdef(27)><pname;0></color>! Is the road good to<br>go already?
msgctxt "2049:402"
msgid "<oneline><$emotion(1,29)><$voicel(1,7)>¡Ey, <$cdef(27)><pname;0></color>! ¿Es que ya has apañado<br>el camino?"
msgstr "<oneline><$emotion(1,29)><$voicel(1,7)>¡Ey, <$cdef(27)><pname;0></color>! ¿Es que ya arreglaste<br>el camino?"

#. en: <$emotion(1,8)><$voicel(1,9)>Awesome! Well then, let’s head over together, bud!
msgctxt "2049:403"
msgid "<$emotion(1,8)><$voicel(1,9)>¡Genial! ¡Arreando que vamos!"
msgstr "<$emotion(1,8)><$voicel(1,9)>¡Genial! ¡Vamos, en marcha!"

#. en: <$emotion(1,38)><$voicel(1,7)>Don’t feel like ya have to rush or anything! I can wait!
msgctxt "2049:404"
msgid "<$emotion(1,38)><$voicel(1,7)>Tampoco te estreses, ¿eh? Me puedo esperar lo que<br>haga falta."
msgstr ""

#. en: <oneline><$emotion(1,31)><$voicel(1,3)><$pkcry;0(1,4)>... Sorry, bud! Looks like I still can’t<br>get through!<clear><br><$emotion(1,29)><$voicel(1,5)>Sorry to keep buggin’ ya, but could ya maybe clean up the<br>road just a bit more?
msgctxt "2049:405"
msgid "<oneline><$emotion(1,31)><$voicel(1,3)><$pkcry;0(1,4)>... Me sabe fatal, pero es que me sigue<br>costando<slide><br>horrores pasar<slide><br>por aquí.<clear><br><$emotion(1,29)><$voicel(1,5)>Con que me apañes el camino una mijita más, ya me vale."
msgstr "<oneline><$emotion(1,31)><$voicel(1,3)><$pkcry;0(1,4)>... Me da mucha pena, pero es que me sigue<br>costando<slide><br>horrores pasar<slide><br>por aquí.<clear><br><$emotion(1,29)><$voicel(1,5)>Con que me arregles el camino un poquito más, me basta."

#. en: <$comeff(1,7)><$facial(1,9)><$motion(1,805)><$voicel(1,3)>Ugh... I dunno if I can go any farther.<clear><br><$comeff(1,3)><$motion(1,803)><$voicel(1,8)>Hit me up again when the path’s clear!
msgctxt "2049:408"
msgid "<$comeff(1,7)><$facial(1,9)><$motion(1,805)><$voicel(1,3)>Uf... Por aquí no paso ni p'atrás.<clear><br><$comeff(1,3)><$motion(1,803)><$voicel(1,8)>¡Cuando hayas adecentao un poco el camino, avísame!"
msgstr "<$comeff(1,7)><$facial(1,9)><$motion(1,805)><$voicel(1,3)>Uf... Por aquí no paso ni p'atrás.<clear><br><$comeff(1,3)><$motion(1,803)><$voicel(1,8)>¡Cuando hayas arreglao un poco el camino, avísame!"

#. en: <$emotion(1,14)><$voicel(1,5)>Hey, heyyy! I heard that someone who goes by the name<br>of <$cdef(27)><wowner;0></color> lives around here.<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,7)>You two are friends, right? Any friend of yours is someone<br>I’d really like to meet! Think we could set that up?
msgctxt "2049:409"
msgid "<$emotion(1,14)><$voicel(1,5)>Me he enterado de que por aquí cerca vive alguien<br>que se llama <$cdef(27)><wowner;0></color>.<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,7)>Me suena el nombre... ¿No sois colegas? Pues a ver si<br>me <gen;0(lo,la)> presentas."
msgstr "<$emotion(1,14)><$voicel(1,5)>Me enteré de que por aquí cerca vive alguien<br>que se llama <$cdef(27)><wowner;0></color>.<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,7)>Me suena el nombre... ¿No son amigos? Pues a ver si<br>me <gen;0(lo,la)> presentas."

#. en: <$comeff(1,3)><$motion(1,803)><$voicel(1,5)>Cool. I’ll be waitin’ at my pad.
msgctxt "2049:410"
msgid "<$comeff(1,3)><$motion(1,803)><$voicel(1,5)>Pos na, me marcho pa casa."
msgstr "<$comeff(1,3)><$motion(1,803)><$voicel(1,5)>Pos na, me voy pa casa."

#. en: <$emotion(1,29)><$voicel(1,8)>Hey, bud! What’s that ya got there?
msgctxt "2049:411"
msgid "<$emotion(1,29)><$voicel(1,8)>¿Qué es eso que llevas, <$cdef(27)><pname;0></color>?"
msgstr ""

#. en: <$emotion(1,38)><$voicel(1,10)>All right. No prob, bud!
msgctxt "2049:412"
msgid "<$emotion(1,38)><$voicel(1,10)>Bueno, pues vale."
msgstr "<$emotion(1,38)><$voicel(1,10)>Bueno, está bien."

#. en: <$emotion(1,8)><$voicel(1,9)>Yeah? For real? Awesome, bud. Thanks a ton!
msgctxt "2049:413"
msgid "<$emotion(1,8)><$voicel(1,9)>¿En serio? Gracias, niñ<gen;-2(o,a)>. ¡Tú sí que sabes!"
msgstr "<$emotion(1,8)><$voicel(1,9)>¿En serio? Gracias, amig<gen;-2(o,a)>. ¡Tú sí que sabes!"

#. en: <oneline><$comeff(1,3)><$motion(1,803)><$voicel(1,7)>Hey, bud. That<br><iart;0()><$cdef(27)><fqty(1)><class><refmateid;0></color><slide><$cdef(27)><br></color>ya<slide><br>got there?
msgctxt "2049:414"
msgid "<oneline><$comeff(1,3)><$motion(1,803)><$voicel(1,7)>¡Ahí va! ¿Eso que llevas es<br><iart;0()><$cdef(27)><fqty(1)><class><refmateid;0></color>?"
msgstr "<oneline><$comeff(1,3)><$motion(1,803)><$voicel(1,7)>¡Vaya! ¿Eso que llevas es<br><iart;0()><$cdef(27)><fqty(1)><class><refmateid;0></color>?"

#. en: <$emotion(1,14)><$voicel(1,7)>Hey, heyyy! I know that device ya got there. Let’s go hunt<br>for some treasure together, bud!
msgctxt "2049:415"
msgid "<$emotion(1,14)><$voicel(1,7)>¡Eh, este aparatejo me lo conozco yo bien!<br>¿Quieres que vayamos por ahí a buscar tesoros?"
msgstr "<$emotion(1,14)><$voicel(1,7)>¡Eh, este aparatito me lo conozco yo bien!<br>¿Quieres que vayamos por ahí a buscar tesoros?"

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,661)><$voicel(1,8)>Every day with you is a new adventure, bud! The fun<br>never ends!<clear><br><$comeff(1,3)><$motion(1,806)><$voicel(1,9)>Here’s a li’l token of my appreciation for all the<br>good times!
msgctxt "2049:416"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,661)><$voicel(1,8)>Contigo siempre me lo paso chachi pistachi, hagamos lo<br>que hagamos. <$comeff(1,3)><$motion(1,806)><$voicel(1,9)>¡Toma esto pa celebrarlo!"
msgstr "<$comeff(1,9)><$facial(1,4)><$motion(1,661)><$voicel(1,8)>Contigo siempre la paso de maravilla, hagamos lo<br>que hagamos. <$comeff(1,3)><$motion(1,806)><$voicel(1,9)>¡Toma esto pa celebrarlo!"

#. en: <oneline><$comeff(1,8)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Thanks for all the good times, <$cdef(27)><pname;0></color>!<br>You’re<slide><br>not<slide><br>just<slide><br>my<slide><br>bud—you’re<slide><br>my<slide><br>BEST bud!
msgctxt "2049:417"
msgid "<$comeff(1,8)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Me alegro tanto, pero taaanto, de haberte conocido...<br>¡Tú y yo somos ya inseparables, camarada!"
msgstr ""

#. en: <oneline><$emotion(1,60)><$voicel(1,7)><$pkcry;0(1,2)>! Go us! Treasure huntin’ sure is<br>fun, huh?<clear><br><$comeff(1,9)><$facial(1,1)><$motion(1,806)><$voicel(1,10)>Hit me up again next time you wanna hunt down some<br>treasure, bud!
msgctxt "2049:418"
msgid "<$emotion(1,60)><$voicel(1,7)>¡<$pkcry;0(1,2)>! ¡Ese trabajazo en equipo!<clear><br>Esto de buscar tesoros es una pasada, la verdad.<br><$comeff(1,9)><$facial(1,1)><$motion(1,806)><$voicel(1,10)>¡Tenemos que repetir otro día!"
msgstr "<$emotion(1,60)><$voicel(1,7)>¡<$pkcry;0(1,2)>! ¡Ese trabajazo en equipo!<clear><br>Esto de buscar tesoros es increíble, la verdad.<br><$comeff(1,9)><$facial(1,1)><$motion(1,806)><$voicel(1,10)>¡Tenemos que repetir otro día!"

#. en: <$emotion(1,8)><$voicel(1,9)>Hey, seriously?! I LOVE this! Thanks a ton, bud!
msgctxt "2049:419"
msgid "<$emotion(1,8)><$voicel(1,9)>¿Estás segur<gen;-2(o,a)>? Mira que esto a mí me pirra...<br>¡Gracias, niñ<gen;-2(o,a)>!"
msgstr "<$emotion(1,8)><$voicel(1,9)>¿Estás segur<gen;-2(o,a)>? Mira que esto a mí me encanta...<br>¡Gracias, amig<gen;-2(o,a)>!"

#. en: <$comeff(1,14)><$facial(1,2)><$motion(1,805)><$voicel(1,4)>I wanna head over that way, y’know? But, uh...
msgctxt "2049:420"
msgid "<$comeff(1,14)><$facial(1,2)><$motion(1,805)><$voicel(1,4)>Por querer, quiero ir allí, pero..."
msgstr "<$comeff(1,14)><$facial(1,2)><$motion(1,805)><$voicel(1,4)>Por querer, quiero ir allá, pero..."

#. en: <$comeff(1,3)><$facial(1,1)><$motion(1,805)><$voicel(1,4)>Whoa... You’re headin’ out real far today, huh. Sorry, bud,<br>but I’m gonna have to stop here! <$comeff(1,10)><$motion(1,803)><$voicel(1,5)>Catch ya later!
msgctxt "2049:421"
msgid "<$comeff(1,3)><$facial(1,1)><$motion(1,805)><$voicel(1,4)>¡Espera! ¿Quieres ir tan lejos? Menuda barbaridá...<br><$comeff(1,10)><$motion(1,803)><$voicel(1,5)>¡Yo me quedo aquí! ¡Chao, <$cdef(27)><pname;1></color>!"
msgstr "<$comeff(1,3)><$facial(1,1)><$motion(1,805)><$voicel(1,4)>¡Espera! ¿Quieres ir tan lejos? Qué barbaridá...<br><$comeff(1,10)><$motion(1,803)><$voicel(1,5)>¡Yo me quedo aquí! ¡Chao, <$cdef(27)><pname;1></color>!"

#. en: <$comeff(1,7)><$facial(1,9)><$motion(1,802)><$voicel(1,3)>The path leadin’ over there is way too rough!
msgctxt "2049:422"
msgid "<$comeff(1,7)><$facial(1,9)><$motion(1,802)><$voicel(1,3)>Es que desde aquí lo tengo crudo para llegar..."
msgstr "<$comeff(1,7)><$facial(1,9)><$motion(1,802)><$voicel(1,3)>Es que desde aquí lo tengo difícil para llegar..."

#. en: <$comeff(1,14)><$facial(1,9)><$motion(1,666)><$voicel(1,5)>Looks like this home’s a bit too small for me, bud... <$emotion(1,37)><$voicel(1,8)>Could I<br>get one that’s a little bigger?
msgctxt "2049:426"
msgid "<$comeff(1,14)><$facial(1,9)><$motion(1,666)><$voicel(1,5)>Para vivir yo aquí me parece un poco chiquiñaja, ¿no?<br><$emotion(1,37)><$voicel(1,8)>¡Una un poco más grande sería perfecta!"
msgstr "<$comeff(1,14)><$facial(1,9)><$motion(1,666)><$voicel(1,5)>Para vivir yo aquí me parece un poco chiquitita, ¿no?<br><$emotion(1,37)><$voicel(1,8)>¡Una un poco más grande sería perfecta!"

#. en: <$emotion(1,14)><$voicel(1,7)><$pkcry;0(1,2)>! This home’s AWESOME, bud!
msgctxt "2049:427"
msgid "<oneline><$emotion(1,14)><$voicel(1,7)>¡<$pkcry;0(1,2)>! Las casas humanas son demasié.<br>¡Quién me diera una!"
msgstr "<oneline><$emotion(1,14)><$voicel(1,7)>¡<$pkcry;0(1,2)>! Las casas humanas son lo máximo.<br>¡Quién me diera una!"

#. en: <oneline><$emotion(1,8)><$voicel(1,9)><$cdef(27)><pname;0></color>! Generous as always, aren’t ya,<br>bud!<slide><br>Thanks<slide><br>a ton!
msgctxt "2049:428"
msgid "<oneline><$emotion(1,8)><$voicel(1,9)>¡Qué generosidad la tuya, <$cdef(27)><pname;0></color>!<br>¡Gracias, te debo una!"
msgstr ""

#. en: <$emotion(1,38)><$voicel(1,9)>Yeah, you sure have a good eye for this kinda stuff, bud!
msgctxt "2049:429"
msgid "<oneline><$emotion(1,38)><$voicel(1,9)>¡Ya te digo! ¡Qué buen ojo tienes para estas cosas,<br><$cdef(27)><pname;0></color>!"
msgstr "<oneline><$emotion(1,38)><$voicel(1,9)>¡Claro que sí! ¡Qué buen ojo tienes para estas cosas,<br><$cdef(27)><pname;0></color>!"

#. en: <$comeff(1,5)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>Seriously?! I’ll definitely live here! You sure, bud?
msgctxt "2049:430"
msgid "<$comeff(1,5)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>¡¿De verdad?! ¿En serio puedo mudarme aquí?"
msgstr ""

#. en: <oneline><$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,9)><$pkcry;0(1,2)>! Heck yeah! Awesome! Thanks a ton,<br><$cdef(27)><pname;1></color>!
msgctxt "2049:431"
msgid "<oneline><oneline><$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡<$pkcry;0(1,2)>! ¡Macanudo!<br>¡Gracias, <$cdef(27)><pname;1></color>!"
msgstr "<oneline><oneline><$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡<$pkcry;0(1,2)>! ¡Fantástico!<br>¡Gracias, <$cdef(27)><pname;1></color>!"

#. en: <$motion(1,807)><$voicel(1,5)>Oof... Pulled the ol’ bait and switch on me, huh?
msgctxt "2049:432"
msgid "<$motion(1,807)><$voicel(1,5)>Te gusta ponerme la miel en los labios, ¿eh?"
msgstr ""

#. en: <$comeff(1,14)><$facial(1,9)><$motion(1,666)><$voicel(1,3)>Uh... I think there’ll be too many Pokémon living here if I<br>move in. <$emotion(1,37)><$voicel(1,8)>Don’t try to cram me in here, bud!
msgctxt "2049:433"
msgid "<$comeff(1,14)><$facial(1,9)><$motion(1,666)><$voicel(1,3)>Uuuy... Si me vengo a vivir aquí, creo que seremos ciento<br>y la madre... <$emotion(1,37)><$voicel(1,8)>¡Gracias, pero paso!"
msgstr "<$comeff(1,14)><$facial(1,9)><$motion(1,666)><$voicel(1,3)>Uuuy... Si me vengo a vivir aquí, creo que seremos<br>demasiados... <$emotion(1,37)><$voicel(1,8)>¡Gracias, pero paso!"

#. en: <oneline><$comeff(1,14)><$motion(1,803)><$voicel(1,5)><$pkcry;0(1,3)>! How many Pokémon can find somethin’<br>THIS cool?!<clear><br><$emotion(1,38)><$voicel(1,8)>Not many, I bet! We’re pretty awesome, huh, bud?!<clear><br><$comeff(1,9)><$facial(1,1)><$motion(1,806)><$voicel(1,9)>Let’s find somethin’ even COOLER next time!
msgctxt "2049:434"
msgid "<$comeff(1,14)><$motion(1,803)><$voicel(1,5)>¡<$pkcry;0(1,3)>! ¡Pero mira lo que hemos encontrado!<br><$emotion(1,38)><$voicel(1,8)>Tú y yo somos un peazo equipo, ¿eh?<clear><br><$comeff(1,9)><$facial(1,1)><$motion(1,806)><$voicel(1,9)>¡A ver si a la próxima nos superamos!"
msgstr "<$comeff(1,14)><$motion(1,803)><$voicel(1,5)>¡<$pkcry;0(1,3)>! ¡Pero mira lo que encontramos!<br><$emotion(1,38)><$voicel(1,8)>Tú y yo somos un equipazo, ¿eh?<clear><br><$comeff(1,9)><$facial(1,1)><$motion(1,806)><$voicel(1,9)>¡A ver si a la próxima nos superamos!"

#. en: <oneline><$comeff(1,6)><$motion(1,666)><$voicel(1,7)>Hey, <$cdef(27)><pname;0></color>! What’s that ya got there?<br>It’s<slide><br>real shiny!
msgctxt "2049:435"
msgid "<oneline><$comeff(1,6)><$motion(1,666)><$voicel(1,7)>¿Qué es eso que llevas ahí, <$cdef(27)><pname;0></color>?<br>¡Con lo que brilla,<slide><br>como pa no verlo!"
msgstr ""

#. en: <$emotion(1,8)><$voicel(1,7)>For me? Wow! Thanks, bud! Here’s a little something for<br>you in return!
msgctxt "2049:436"
msgid "<$emotion(1,8)><$voicel(1,7)>¿Para mí? ¡Gracias, niñ<gen;-2(o,a)>! Pues toma esto a cambio,<br>que no se diga."
msgstr "<$emotion(1,8)><$voicel(1,7)>¿Para mí? ¡Gracias, amig<gen;-2(o,a)>! Pues toma esto a cambio,<br>que no se diga."

#. en: <$emotion(1,37)><$voicel(1,7)>Whoa! I dunno, though. Something like that might be<br>wasted on me... <$emotion(1,8)><$voicel(1,6)>You should let someone else have it!
msgctxt "2049:437"
msgid "<$emotion(1,37)><$voicel(1,7)>Nah, quita, quita... Eso sería desperdiciarlo tontamente.<br><$emotion(1,8)><$voicel(1,6)>Mejor regálaselo a otro."
msgstr "<$emotion(1,37)><$voicel(1,7)>Nah, no, no... Eso sería desperdiciarlo tontamente.<br><$emotion(1,8)><$voicel(1,6)>Mejor regálaselo a otro."

#. en: <$comeff(1,3)><$facial(1,9)><$motion(1,803)><$voicel(1,4)>Oooh... Sorry, bud, but I don’t think I can accept that<br>right now.<clear><br><$comeff(1,14)><$voicel(1,5)>I’m happy that you want me to have it, of course! <$emotion(1,37)><$voicel(1,7)>But I<br>dunno if I have any use for it!
msgctxt "2049:438"
msgid "<$comeff(1,3)><$facial(1,9)><$motion(1,803)><$voicel(1,4)>Naaah. Lo siento, pero paso.<clear><br><$emotion(1,37)><$voicel(1,5)>Es todo un detalle, no me malinterpretes, pero es que<br><$comeff(1,14)><$voicel(1,7)>qué hago yo con eso, ¿eh?"
msgstr ""

#. en: <$emotion(1,37)><$voicel(1,9)>Uh, bud... You forget where I live or somethin’? It’s only a<br>“move” if it’s a NEW home—I already live here!
msgctxt "2049:439"
msgid "<$emotion(1,37)><$voicel(1,9)>Amos a ver: cuando te mudas, es a otra casa. A otra.<br>No a la que ya tienes. ¿Me explico?"
msgstr "<$emotion(1,37)><$voicel(1,9)>Vamos a ver: cuando te mudas, es a otra casa. A otra.<br>No a la que ya tienes. ¿Me explico?"

#. en: <$comeff(1,6)><$facial(1,2)><$motion(1,803)><$voicel(1,5)>Sorry for the trouble, bud, but would it be possible to do<br>somethin’ about that?
msgctxt "2049:442"
msgid "<$comeff(1,6)><$facial(1,2)><$motion(1,803)><$voicel(1,5)>Si tienes tiempo, ¿me lo puedes arreglar un poco?<br>Te lo agradecería mil."
msgstr "<$comeff(1,6)><$facial(1,2)><$motion(1,803)><$voicel(1,5)>Si tienes tiempo, ¿me lo puedes arreglar un poco?<br>Te lo agradecería un montón."

#. en: <$emotion(1,37)><$voicel(1,9)>Hey, <$cdef(27)><pname;0></color>! Time’s up, bud!
msgctxt "2049:443"
msgid "<$emotion(1,37)><$voicel(1,9)>¡Se t'acabao el tiempo, <$cdef(27)><pname;0></color>!"
msgstr "<$emotion(1,37)><$voicel(1,9)>¡Se te acabó el tiempo, <$cdef(27)><pname;0></color>!"

#. en: <$comeff(1,21)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>Beating us is no easy feat! You’re just TOO awesome,<br><$cdef(27)><pname;0></color>!<clear><br><$emotion(1,38)><$voicel(1,8)>Here! An awesome present for an awesome friend!
msgctxt "2049:444"
msgid "<$comeff(1,21)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>Mira que éramos un equipo duro, pero te nos has comido.<br>¡Lo tuyo es muy fuerte, niñ<gen;-2(o,a)>!<clear><br><$emotion(1,38)><$voicel(1,8)>¡Te mereces un peazo de premio como este!"
msgstr "<$comeff(1,21)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>Mira que éramos un equipo duro, pero nos ganaste.<br>¡Eres increíble, amig<gen;-2(o,a)>!<clear><br><$emotion(1,38)><$voicel(1,8)>¡Te mereces un premiazo como este!"

#. en: <$emotion(1,29)><$voicel(1,6)>How ya feel about playin’ again, bud?
msgctxt "2049:445"
msgid "<$emotion(1,29)><$voicel(1,6)>¿Jugamos otra?"
msgstr ""

#. en: <$emotion(1,8)><$voicel(1,10)>Awesome! Let’s do it!
msgctxt "2049:446"
msgid "<$emotion(1,8)><$voicel(1,10)>¡Pues al turrón!"
msgstr "<$emotion(1,8)><$voicel(1,10)>¡Pues a darle!"

#. en: <$motion(1,806)><$voicel(1,5)>Too busy, huh? Maybe next time, then!
msgctxt "2049:447"
msgid "<$motion(1,806)><$voicel(1,5)>Estás ataread<gen;-2(o,a)>, ¿eh? Nada, otra vez será."
msgstr ""

#. en: <$comeff(1,14)><$facial(1,9)><$motion(1,666)><$voicel(1,5)>Hm... Somethin’ about this house seems...unfinished?<clear><br><$emotion(1,41)><$voicel(1,3)>Sorry, bud. I don’t think I’m gonna live here.
msgctxt "2049:449"
msgid "<$comeff(1,14)><$facial(1,9)><$motion(1,666)><$voicel(1,5)>Hmm, pues hablando en plata... la verdad es que me<br>parece un poco cutre.<clear><br><$emotion(1,41)><$voicel(1,3)>Se siente, camarada, pero creo que paso de vivir aquí."
msgstr "<$comeff(1,14)><$facial(1,9)><$motion(1,666)><$voicel(1,5)>Hmm, pues hablando claro... la verdad es que me<br>parece un poco simplona.<clear><br><$emotion(1,41)><$voicel(1,3)>Lo siento, camarada, pero creo que no voy a vivir aquí."

#. en: <$emotion(1,14)><$voicel(1,7)>Gotcha! Gimme a li’l bit of time to work, OK?
msgctxt "2049:452"
msgid "<$emotion(1,14)><$voicel(1,7)>¡Oído! Espera un poco hasta que termine."
msgstr "<$emotion(1,14)><$voicel(1,7)>¡Entendido! Espera un poco hasta que termine."

#. en: <$comeff(1,14)><$motion(1,803)><$voicel(1,6)><$pkcry;0(1,2)>! Need just a bit more time, bud!
msgctxt "2049:453"
msgid "<$comeff(1,14)><$motion(1,803)><$voicel(1,6)>¡<$pkcry;0(1,2)>! ¡Dame tiempo, <gen;-2(hombre,mujer)>!"
msgstr ""

#. en: <oneline><$voicel(1,7)><$emotion(1,60)>There ya go, <$cdef(27)><pname;0></color>! Got your<br><$cdef(27)><class><reftarid;1></color><slide><br>all<slide><br>ready!<slide><br><$voicel(1,10)><$motion(1,801)><$comeff(1,1)>You’re<slide><br>good<slide><br>to go!
msgctxt "2049:454"
msgid "<oneline><$voicel(1,7)><$emotion(1,60)>¡Al loro, <$cdef(27)><pname;0></color>! ¡Mira qué<br><$cdef(27)><class><reftarid;1></color><slide><br>me he marcado!<slide><br><$voicel(1,10)><$motion(1,801)><$comeff(1,1)>¡Pa ti, por tu cara bonita!"
msgstr "<oneline><$voicel(1,7)><$emotion(1,60)>¡Atención, <$cdef(27)><pname;0></color>! ¡Mira qué<br><$cdef(27)><class><reftarid;1></color><slide><br>te preparé!<slide><br><$voicel(1,10)><$motion(1,801)><$comeff(1,1)>¡Pa ti, por tu cara bonita!"

#. en: <$emotion(1,41)><$voicel(1,3)>Sorry, bud! I’ve got some other things I absolutely gotta<br>get done today...
msgctxt "2049:455"
msgid "<$emotion(1,41)><$voicel(1,3)>¡Lo siento, niñ<gen;-2(o,a)>, pero antes tengo que ocuparme de otras<br>cosas! ¡Se me acumula la faena!"
msgstr "<$emotion(1,41)><$voicel(1,3)>¡Lo siento, amig<gen;-2(o,a)>, pero antes tengo que ocuparme de otras<br>cosas! ¡Se me acumula el trabajo!"

#. en: <$facial(1,9)><$comeff(1,6)><$motion(1,827)><$voicel(1,8)>Hey! What?! Where’s my pad? I coulda sworn it was<br>right here...
msgctxt "2049:459"
msgid "<$facial(1,9)><$comeff(1,6)><$motion(1,827)><$voicel(1,8)>¿Eh? A ver, o se me ha ido la perola muchísimo o mi casa<br>estaba por aquí, que yo sepa."
msgstr "<$facial(1,9)><$comeff(1,6)><$motion(1,827)><$voicel(1,8)>¿Eh? A ver, o estoy perdiendo la cabeza o mi casa<br>estaba por aquí, que yo sepa."

#. en: <$facial(1,13)><$comeff(1,5)><$motion(1,803)><$voicel(1,8)>What the—! My pad’s gone! Where’d it go?!
msgctxt "2049:460"
msgid "<$facial(1,13)><$comeff(1,5)><$motion(1,803)><$voicel(1,8)>¡Pero bueno! ¿Se puede saber dónde está mi casa?<br>¿Ha cogido y se ha dado a la fuga o qué?"
msgstr "<$facial(1,13)><$comeff(1,5)><$motion(1,803)><$voicel(1,8)>¡Pero bueno! ¿Se puede saber dónde está mi casa?<br>¿Agarró y se dio a la fuga o qué?"

#. en: <$comeff(1,14)><$voicel(1,5)>Oh well. If that’s how it’s gonna be...<clear><br><$comeff(1,1)><$motion(1,803)><$voicel(1,7)>Guess I’ll just have to go hunting for a new home!
msgctxt "2049:461"
msgid "<$comeff(1,14)><$voicel(1,5)>Pues me tendré que fastidiar. ¡Menuda gracia! En fin...<br><$comeff(1,1)><$motion(1,803)><$voicel(1,7)>Habrá que ponerse a buscar casa nueva."
msgstr "<$comeff(1,14)><$voicel(1,5)>Pues me tendré que aguantar. ¡Qué fastidio! En fin...<br><$comeff(1,1)><$motion(1,803)><$voicel(1,7)>Habrá que ponerse a buscar casa nueva."

#. en: <$facial(1,4)><$comeff(1,10)><$motion(1,803)><$voicel(1,7)>Hey! This place looks really great! You made this,<br><$cdef(27)><pname;0></color>? <$comeff(1,9)><$voicel(1,10)>That’s awesome!<clear><br><$facial(1,5)><$comeff(1,21)><$motion(1,801)><$voicel(1,9)>I think I’ll make this my new home. Thanks, bud!
msgctxt "2049:462"
msgid "<$facial(1,4)><$comeff(1,10)><$motion(1,803)><$voicel(1,7)>¡Ostras, este sitio tiene una pinta bastante chula!<br>¿Te lo has currado tú, <$cdef(27)><pname;0></color>?<clear><br><$comeff(1,9)><$voicel(1,10)>¡Eres tremend<gen;-2(o,a)>! <$facial(1,5)><$comeff(1,21)><$motion(1,801)><$voicel(1,9)>Pues me mudo aquí hoy mismo, faltaría<br>más. ¡Te has portado, amig<gen;-2(o,a)>!"
msgstr "<$facial(1,4)><$comeff(1,10)><$motion(1,803)><$voicel(1,7)>¡Cielos, este lugar se ve bastante bonito!<br>¿Lo hiciste tú, <$cdef(27)><pname;0></color>?<clear><br><$comeff(1,9)><$voicel(1,10)>¡Eres tremend<gen;-2(o,a)>! <$facial(1,5)><$comeff(1,21)><$motion(1,801)><$voicel(1,9)>Pues me mudo aquí hoy mismo, faltaría<br>más. ¡Te luciste, amig<gen;-2(o,a)>!"

#. en: <oneline><$comeff(1,10)><$motion(1,803)><$voicel(1,7)>Hey, hey! You got me<br><iart;0()><$cdef(27)><fqty(1)><class><stfrevp;0></color>?<slide><br><$facial(1,4)><$comeff(1,9)><$motion(1,801)><$voicel(1,10)>Sweet!<slide><br>I’ll<slide><br>take<slide><br>a look!
msgctxt "2049:463"
msgid "<oneline><$comeff(1,10)><$motion(1,803)><$voicel(1,7)>¿Me has preparado<br><iart;0()><fqty(1)><class><$cdef(27)><stfrevp;0></color>?<slide><br>¡Halaaa!<slide><br><$facial(1,4)><$comeff(1,9)><$motion(1,801)><$voicel(1,10)>¡Voy a echar<qty;0(le,les)> un ojo a la de ya!"
msgstr "<oneline><$comeff(1,10)><$motion(1,803)><$voicel(1,7)>¿Me preparaste<br><iart;0()><fqty(1)><class><$cdef(27)><stfrevp;0></color>?<slide><br>¡Guaaau!<slide><br><$facial(1,4)><$comeff(1,9)><$motion(1,801)><$voicel(1,10)>¡Voy a echar<qty;0(le,les)> un ojo ahora mismo!"

#. en: <oneline><$comeff(1,9)><$facial(1,1)><$motion(1,805)><$voicel(1,9)><$pkcry;0(1,2)>. ♪ This is a nice pad, bud—REAL nice!
msgctxt "2049:464"
msgid "<$comeff(1,9)><$facial(1,1)><$motion(1,805)><$voicel(1,9)>¡<fcap><$pkcry;0(1,2)>! ¡Peazo de casa, qué bonica es!<br>¡Esto es lo que llaman amor a primera vista!"
msgstr "<$comeff(1,9)><$facial(1,1)><$motion(1,805)><$voicel(1,9)>¡<fcap><$pkcry;0(1,2)>! ¡Vaya casa, qué bonita es!<br>¡Esto es lo que llaman amor a primera vista!"

#. en: <oneline><$comeff(1,6)><$facial(1,1)><$motion(1,661)><$voicel(1,5)>Hey, I finished makin’ what <$cdef(27)><refpname;0><br></color>asked<slide><br>for.<slide><br>Think<slide><br>you<slide><br>could<slide><br>give<slide><br>this<slide><br>to<slide><br>’em<slide><br>for<slide><br>me, bud?
msgctxt "2049:465"
msgid "<oneline><$facial(1,1)><$motion(1,661)><$voicel(1,5)>Tengo aquí una cosa que me encargó<br><$cdef(27)><refpname;0></color>,<slide><br><$comeff(1,6)>¿te importa hacerme<slide><br>de mensajer<gen;-2(o,a)>?"
msgstr ""

#. en: <oneline><$voicel(1,5)><$motion(1,824)><$comeff(1,6)>Yo, <$cdef(27)><pname;0></color>, how you feel about a<br>quick<slide><br>quiz?<slide><br><$voicel(1,8)><$motion(1,801)><$comeff(1,10)><$facial(1,4)>I came<slide><br>up<slide><br>with<slide><br>a<slide><br>good one.
msgctxt "2049:466"
msgid "<$cdef(27)><$voicel(1,5)></color><$motion(1,824)><$comeff(1,6)>Oye, ¿qué me dices de una pequeña adivinanza,<br>así a bote pronto? <$voicel(1,8)><$motion(1,801)><$comeff(1,10)><$facial(1,4)>Se me ha ocurrido una buena."
msgstr "<$cdef(27)><$voicel(1,5)></color><$motion(1,824)><$comeff(1,6)>Oye, ¿qué me dices de una pequeña adivinanza,<br>así de improviso? <$voicel(1,8)><$motion(1,801)><$comeff(1,10)><$facial(1,4)>Se me ocurrió una buena."

#. en: <$voicel(1,7)><$emotion(1,1)>Good deal! I knew you’d be up for it! OK here we go...<clear><br><$voicel(1,5)><$emotion(1,33)>So, you’ve got me and <$cdef(27)><sizecmppk;1></color>—who’s taller?
msgctxt "2049:467"
msgid "<$voicel(1,7)><$emotion(1,1)>¡Ole! ¡Así se habla! Pues es esta, ¡prepárate!<clear><br><$voicel(1,5)><$emotion(1,33)>¿Quién mide más, <dart;1()><$cdef(27)><sizecmppk;1> </color>o yo?"
msgstr "<$voicel(1,7)><$emotion(1,1)>¡Bien! ¡Así se habla! Pues es esta, ¡prepárate!<clear><br><$voicel(1,5)><$emotion(1,33)>¿Quién mide más, <dart;1()><$cdef(27)><sizecmppk;1> </color>o yo?"

#. en: <$voicel(1,5)><$motion(1,803)><$comeff(1,3)><$facial(1,4)>Gotcha! Another time, then!
msgctxt "2049:468"
msgid "<$voicel(1,5)><$motion(1,803)><$comeff(1,3)><$facial(1,4)>¿No puedes ahora mismo? ¡Qué niñ<gen;-2(o,a)> tan ocupad<gen;-2(o,a)>!<br>A ver si te pilla mejor pa la próxima."
msgstr "<$voicel(1,5)><$motion(1,803)><$comeff(1,3)><$facial(1,4)>¿No puedes ahora mismo? ¡Qué niñ<gen;-2(o,a)> tan ocupad<gen;-2(o,a)>!<br>A ver si tienes tiempo pa la próxima."

#. en: <oneline>...<wait(0.4)><$voicel(1,9)><$motion(1,801)><$comeff(1,20)><$facial(1,4)>That’s right! I knew you’d get it,<br><$cdef(27)><pname;0></color>!<clear><br><$voicel(1,6)><$motion(1,827)><$comeff(1,10)><$facial(1,3)>Guess I’ve gotta come up with a harder question for ya<br>next time, huh?
msgctxt "2049:469"
msgid "<oneline>... <wait(0.4)><$voicel(1,9)><$motion(1,801)><$comeff(1,20)><$facial(1,4)>¡Sí, <gen;-2(señor,señora)>! ¡Si es que eres un hacha,<br><$cdef(27)><pname;0></color>!<clear><br><$voicel(1,6)><$motion(1,827)><$comeff(1,10)><$facial(1,3)>Me estrujaré las meninges pa ponértelo más difícil<br>la próxima vez."
msgstr "<oneline>... <wait(0.4)><$voicel(1,9)><$motion(1,801)><$comeff(1,20)><$facial(1,4)>¡Sí, <gen;-2(señor,señora)>! ¡Si es que eres lo máximo,<br><$cdef(27)><pname;0></color>!<clear><br><$voicel(1,6)><$motion(1,827)><$comeff(1,10)><$facial(1,3)>Me estrujaré las meninges pa ponértelo más difícil<br>la próxima vez."

#. en: ...<wait(0.4)><$voicel(1,3)><$motion(1,803)><$comeff(1,12)>Nope! Too bad! It’s actually the other way around!<clear><br><$voicel(1,5)><$facial(1,4)><$comeff(1,10)>I’m sure you’ll get it right next time, bud! <$voicel(1,8)><$emotion(1,8)>Thanks for<br>playin’, though!
msgctxt "2049:470"
msgid "... <wait(0.4)><$cdef(27)><$voicel(1,3)></color><$motion(1,803)><$comeff(1,12)>¡Pues va a ser que no! ¡Más bien al revés, amig<gen;-2(o,a)>!<clear><br><$voicel(1,5)><$facial(1,4)><$comeff(1,10)>Pero, bah, con lo buen<gen;-2(o,a)> que eres, la próxima vez seguro<br>que lo clavas. <$voicel(1,8)><$emotion(1,8)>¡He pasado un rato genial contigo, oye!"
msgstr "... <wait(0.4)><$cdef(27)><$voicel(1,3)></color><$motion(1,803)><$comeff(1,12)>¡Pues va a ser que no! ¡Más bien al revés, amig<gen;-2(o,a)>!<clear><br><$voicel(1,5)><$facial(1,4)><$comeff(1,10)>Pero, bah, con lo buen<gen;-2(o,a)> que eres, la próxima vez seguro<br>que lo clavas. <$voicel(1,8)><$emotion(1,8)>¡Pasé un rato genial contigo, oye!"

#. en: <oneline><$facial(1,4)><$comeff(1,10)><$motion(1,801)><$voicel(1,9)><$pkcry;0(1,2)>! This spot’s not half bad! All right,<br>this’ll<slide><br>be<slide><br>my<slide><br>new pad startin’ today!
msgctxt "2049:471"
msgid "<$facial(1,4)><$comeff(1,10)><$motion(1,801)><$voicel(1,9)>Este lugar me hace bastante tilín, ¿eh?<br>¡Me plantaré aquí desde hoy mismo, <flow><$pkcry;0(1,2)>!"
msgstr "<$facial(1,4)><$comeff(1,10)><$motion(1,801)><$voicel(1,9)>Este lugar me gusta bastante, ¿eh?<br>¡Me plantaré aquí desde hoy mismo, <flow><$pkcry;0(1,2)>!"

#. en: <oneline><$voicel(1,5)><$motion(1,803)><$comeff(1,3)>Oh, who’s this? Wait, no, I know you...<clear><br><$voicel(1,7)><$emotion(1,8)>You’re <$cdef(27)><pname;1></color>, aren’t you?! Didn’t<br>recognize<slide><br>ya<slide><br>for<slide><br>a<slide><br>second there!
msgctxt "2049:472"
msgid "<$voicel(1,5)><$motion(1,803)><$comeff(1,3)>¿Eh? Me tienes entre \"esta cara me suena\" y \"yo a est<gen;-2(e,a)> tí<gen;-2(o,a)><br>no l<gen;-2(o,a)> conozco de nada\".<clear><br><$voicel(1,7)><$emotion(1,8)>Pero eres <$cdef(27)><pname;1></color>, ¿no?<br>¡Por un momento no te había reconocido!"
msgstr "<$voicel(1,5)><$motion(1,803)><$comeff(1,3)>¿Eh? Me tienes entre \"esta cara me suena\" y \"yo a est<gen;-2(e,a)> chic<gen;-2(o,a)><br>no l<gen;-2(o,a)> conozco de nada\".<clear><br><$voicel(1,7)><$emotion(1,8)>Pero eres <$cdef(27)><pname;1></color>, ¿no?<br>¡Por un momento no te reconocí!"

#. en: <$comeff(1,5)><$facial(1,1)><$motion(1,805)><$voicel(1,3)>Wait, wait, wait! I dunno if there’s enough space for us to<br>play hide-and-sneak...<clear><br><$comeff(1,6)><$motion(1,806)><$voicel(1,6)>Might need to start by clearin’ out a little room for us to<br>play, bud!
msgctxt "2049:476"
msgid "<$comeff(1,5)><$facial(1,1)><$motion(1,805)><$voicel(1,3)>¡Eh, para el carro, niñ<gen;-2(o,a)>! ¡Aquí no se puede un<gen;-3(o,a)> ni mover!<br><$comeff(1,6)><$motion(1,806)><$voicel(1,6)>¿No podrías hacer algo para que haya más espacio?"
msgstr "<$comeff(1,5)><$facial(1,1)><$motion(1,805)><$voicel(1,3)>¡Eh, frena, amig<gen;-2(o,a)>! ¡Aquí no se puede un<gen;-3(o,a)> ni mover!<br><$comeff(1,6)><$motion(1,806)><$voicel(1,6)>¿No podrías hacer algo para que haya más espacio?"

#. en: <$emotion(1,31)><$voicel(1,3)>Sorry, bud... I dunno if I can live here...
msgctxt "2049:477"
msgid "<$emotion(1,31)><$voicel(1,3)>Pues mira que lo siento, pero no me veo viviendo aquí<br>ni en sueños."
msgstr ""

#. en: <$voicel(1,5)><$emotion(1,14)>Hey, heyyy. Sorry, bud. I’m real full right now. <$voicel(1,8)><$emotion(1,38)>Thanks for<br>thinkin’ of me, though!
msgctxt "2049:478"
msgid "<$voicel(1,5)><$emotion(1,14)>Mira que lo siento, amig<gen;-2(o,a)>, pero estoy bastante<br>empachad<gen;-3(o,a)>. <$voicel(1,8)><$emotion(1,38)>¡Te agradezco el detalle, eso sí!"
msgstr ""

#. en: <$comeff(1,6)><$motion(1,805)><$voicel(1,6)>Where’s my new pad gonna be?
msgctxt "2049:481"
msgid "<$comeff(1,6)><$motion(1,805)><$voicel(1,6)>¿Y adónde me mudo, si puede saberse?"
msgstr ""

#. en: <$emotion(1,14)><$voicel(1,5)>All riiight! That’s gonna be my new pad, huh?
msgctxt "2049:482"
msgid "<$emotion(1,14)><$voicel(1,5)>¡Ahí va! ¿Esta es mi nueva casa?"
msgstr "<$emotion(1,14)><$voicel(1,5)>¡Vaya! ¿Esta es mi nueva casa?"

#. en: <$voicel(1,7)><$emotion(1,8)>Good deal! I knew you’d be up for it! OK, here we go...<clear><br><$voicel(1,5)><$emotion(1,33)>So you’ve got me and <$cdef(27)><weightcmppk;1></color>—who’s heavier?
msgctxt "2049:484"
msgid "<$voicel(1,7)><$emotion(1,8)>¡Oleee! ¡Sin miedo! Pues la pregunta es... ¡esta!<clear><br><$voicel(1,5)><$emotion(1,33)>¿Quién pesa más, <dart;1()><$cdef(27)><weightcmppk;1> </color>o yo?"
msgstr "<$voicel(1,7)><$emotion(1,8)>¡Bieeen! ¡Sin miedo! Pues la pregunta es... ¡esta!<clear><br><$voicel(1,5)><$emotion(1,33)>¿Quién pesa más, <dart;1()><$cdef(27)><weightcmppk;1> </color>o yo?"

#. en: <$comeff(1,6)><$motion(1,827)><$voicel(1,8)><$cdef(27)><pname;0></color>! You think you want that, bud?
msgctxt "2049:489"
msgid "<$comeff(1,6)><$motion(1,827)><$voicel(1,8)>Ah, ¿te hace falta eso, <$cdef(27)><pname;0></color>?"
msgstr ""

#. en: <$facial(1,4)><$comeff(1,9)><$motion(1,803)><$voicel(1,7)>Sweet! OK, what are you gonna trade for it?
msgctxt "2049:490"
msgid "<$facial(1,4)><$comeff(1,9)><$motion(1,803)><$voicel(1,7)>¡Fenomenal! Venga, ¿qué me das a cambio?"
msgstr "<$facial(1,4)><$comeff(1,9)><$motion(1,803)><$voicel(1,7)>¡Fenomenal! A ver, ¿qué me das a cambio?"

#. en: <$comeff(1,10)><$motion(1,803)><$voicel(1,5)>Just window shoppin’, eh? Well, let me know if you change<br>your mind!
msgctxt "2049:491"
msgid "<$comeff(1,10)><$motion(1,803)><$voicel(1,5)>¿Ah, que solo estabas echando un ojo? ¡Sin problema!<br>Ya me dirás si cambias de idea."
msgstr ""

#. en: <$facial(1,5)><$comeff(1,10)><$motion(1,801)><$voicel(1,10)>It’s a deal! I think we both got something good out of this,<br>don’t you?
msgctxt "2049:492"
msgid "<$facial(1,5)><$comeff(1,10)><$motion(1,801)><$voicel(1,10)>¡Gracias, amig<gen;-2(o,a)>! Menudo chollo mutuo, ¿eh?"
msgstr "<$facial(1,5)><$comeff(1,10)><$motion(1,801)><$voicel(1,10)>¡Gracias, amig<gen;-2(o,a)>! Qué buen trato para los dos, ¿eh?"

#. en: <$facial(1,4)><$comeff(1,6)><$voicel(1,8)>Changed your mind? Let me know any time if you end up<br>wantin’ it!
msgctxt "2049:493"
msgid "<$facial(1,4)><$comeff(1,6)><$voicel(1,8)>¿Pasas, entonces? Vale, pero si te lo piensas mejor,<br>¡dímelo, eh!"
msgstr "<$facial(1,4)><$comeff(1,6)><$voicel(1,8)>¿Pasas, entonces? Bueno, pero si lo piensas mejor,<br>¡dímelo, eh!"

#. en: <oneline><$facial(1,5)><$comeff(1,10)><$motion(1,801)><$voicel(1,9)><$cdef(27)><pname;0></color>! Thanks, bud! Now I’m all out<br>of stuff!<clear><br><$facial(1,4)><$comeff(1,13)><$motion(1,803)><$voicel(1,7)>I’m sure I’ll be lookin’ to <$cdef(27)><$spwfull(12)> </color>again sometime. Hope<br>we can make another deal then!
msgctxt "2049:494"
msgid "<oneline><$facial(1,5)><$comeff(1,10)><$motion(1,801)><$voicel(1,9)>¡Gracias, <$cdef(27)><pname;0></color>! Menudo éxito,<br>tanto que me<slide><br>he quedado<slide><br>sin nada.<clear><br><$cdef(27)><$facial(1,4)></color><$comeff(1,13)><$motion(1,803)><$voicel(1,7)>¡Pero tú descuida, que ya volveremos a <$cdef(27)><$spwfull(12)></color><br>un día de estos!"
msgstr "<oneline><$facial(1,5)><$comeff(1,10)><$motion(1,801)><$voicel(1,9)>¡Gracias, <$cdef(27)><pname;0></color>! Qué éxito,<br>tanto que me<slide><br>quedé<slide><br>sin nada.<clear><br><$cdef(27)><$facial(1,4)></color><$comeff(1,13)><$motion(1,803)><$voicel(1,7)>¡Pero tú descuida, que ya volveremos a <$cdef(27)><$spwfull(12)></color><br>un día de estos!"

#. en: <oneline><$facial(1,4)><$comeff(1,10)><$motion(1,803)><$voicel(1,7)><$cdef(27)><pname;0></color>! Hey, heyyy! I’m headed over<br>to<slide><br>the<slide><$cdef(27)><br><$voicel(1,8)><fqty(1)><$ifull(1325)></color><slide><br>right now.<clear><br><$comeff(1,13)><$motion(1,801)><$voicel(1,10)>Come over and say hello if you’ve got time!
msgctxt "2049:495"
msgid "<oneline><$facial(1,4)><$comeff(1,10)><$motion(1,803)><$voicel(1,7)>¡Eh, <$cdef(27)><pname;0></color>! Me pillas de camino<br>a la <$cdef(27)><$voicel(1,8)><fqty(1)><$ifull(1325)></color>.<slide><br><$comeff(1,13)><$motion(1,801)><$voicel(1,10)>¡Pásate luego si tienes un ratejo!"
msgstr "<oneline><$facial(1,4)><$comeff(1,10)><$motion(1,803)><$voicel(1,7)>¡Eh, <$cdef(27)><pname;0></color>! Voy de camino<br>a la <$cdef(27)><$voicel(1,8)><fqty(1)><$ifull(1325)></color>.<slide><br><$comeff(1,13)><$motion(1,801)><$voicel(1,10)>¡Pásate luego si tienes un ratito!"

#. en: <oneline><$facial(1,4)><$comeff(1,10)><$motion(1,803)><$voicel(1,10)>Hey, hey! Sorry, <$cdef(27)><pname;0></color>! I’m done for<br>the<slide><br>day.<slide><br>Hope<slide><br>we<slide><br>can<slide><br><$cdef(27)><$spwfull(12)></color><slide><br>again<slide><br>some<slide><br>other time!
msgctxt "2049:496"
msgid "<oneline><$facial(1,4)><$comeff(1,10)><$motion(1,803)><$voicel(1,10)>Lo siento, <$cdef(27)><pname;0></color>, pero he terminado<br>de currar<slide><br>por hoy.<slide><br>¡Ya volveremos a <$cdef(27)><$spwfull(12)></color> otro día!"
msgstr "<oneline><$facial(1,4)><$comeff(1,10)><$motion(1,803)><$voicel(1,10)>Lo siento, <$cdef(27)><pname;0></color>, pero terminé<br>de trabajar<slide><br>por hoy.<slide><br>¡Ya volveremos a <$cdef(27)><$spwfull(12)></color> otro día!"

#. en: <$facial(1,4)><$comeff(1,6)><$motion(1,827)><$voicel(1,6)>Hmmm. What’s this? How do you use it?
msgctxt "2049:497"
msgid "<$facial(1,4)><$comeff(1,6)><$motion(1,827)><$voicel(1,6)>Uy, ¿y esto pa qué vale?"
msgstr "<$facial(1,4)><$comeff(1,6)><$motion(1,827)><$voicel(1,6)>Uy, ¿y esto pa qué sirve?"

#. en: <$emotion(1,38)><$voicel(1,9)>Whoa, awesome! I’m actually super hungry right now!
msgctxt "2049:500"
msgid "<$emotion(1,38)><$voicel(1,9)>¡Guau, me lees el pensamiento, niñ<gen;-2(o,a)>! ¡Ya me empezaban<br>a rugir las tripas!"
msgstr "<$emotion(1,38)><$voicel(1,9)>¡Guau, me lees el pensamiento, amig<gen;-2(o,a)>! ¡Ya me empezaban<br>a rugir las tripas!"

#. en: <$emotion(1,14)><$voicel(1,5)>The other day, I went home to go to sleep and found<br>somebody I’ve never seen before already sleepin’ there!<clear><br><$comeff(1,14)><$voicel(1,7)>I thought about runnin’ them off, but they were sleepin’<br>so peacefully... <$comcan(1)><$voicel(1,10)><$motion(1,807)>So I went and slept somewhere else.<clear><br><$emotion(1,8)><$voicel(1,8)>Am I nice or WHAT?
msgctxt "2049:501"
msgid "<$emotion(1,14)><$voicel(1,5)>No te lo vas a creer. El otro día volví a casa y me encontré<br>a un tipo que no conocía de nada durmiendo tan pancho.<clear><br><$comeff(1,14)><$voicel(1,7)>Mi primera reacción fue ir a echarlo a patadas, claro,<br>pero luego me acerco y... Ains, es que parecía un bebé...<clear><br>Total, que me dio penilla y, al final, <$comcan(1)><$voicel(1,10)><$motion(1,807)>quien se fue a dormir<br>a otra parte fui yo.<clear><br><$emotion(1,8)><$voicel(1,8)>¡Si es que en el fondo soy un cacho de pan, no me dirás<br>que no!"
msgstr "<$emotion(1,14)><$voicel(1,5)>No te lo vas a creer. El otro día volví a casa y me encontré<br>a un tipo que no conocía de nada durmiendo tan tranquilo.<clear><br><$comeff(1,14)><$voicel(1,7)>Mi primera reacción fue ir a echarlo a patadas, claro,<br>pero luego me acerco y... Ay, es que parecía un bebé...<clear><br>Total, que me dio penita y, al final, <$comcan(1)><$voicel(1,10)><$motion(1,807)>quien se fue a dormir<br>a otra parte fui yo.<clear><br><$emotion(1,8)><$voicel(1,8)>¡Si es que en el fondo soy un pan de Dios, no me dirás<br>que no!"

#. en: <oneline><$emotion(1,38)><$voicel(1,9)>Out in the sun on a clear afternoon is the BEST place to<br>do a li’l physical trainin’!<clear><br><$emotion(1,29)><$voicel(1,7)>Wanna join me, <$cdef(27)><pname;0></color>? Let’s<br>train together!
msgctxt "2049:502"
msgid "<$emotion(1,38)><$voicel(1,9)>Está claro que, si lo que quieres es entrenar en serio,<br>no hay nada como hacerlo cuando hace solazo.<clear><br><$emotion(1,29)><$voicel(1,7)>¿Qué, te animas a probar tú también? ¡Los límites están<br>para superarlos!"
msgstr ""

#. en: <$emotion(1,29)><$voicel(1,5)>Sunsets kinda have the same colors as a <$cdef(27)><fqty(1)><$ifull(1280)></color>,<br>don’tcha think?<clear><br><$comeff(1,14)><$motion(1,827)><$voicel(1,7)>Starin’ at the sky when it looks like this really makes me<br>wanna <$voicel(1,6)>sit by a <$cdef(27)><fqty(1)><$ifull(1280)></color>...
msgctxt "2049:503"
msgid "<$cdef(27)><$emotion(1,29)></color><$voicel(1,5)>¿El color del cielo al atardecer no te recuerda al de<br>una <$cdef(27)><fqty(1)><$ifull(1280)></color>?<clear><br><$comeff(1,14)><$motion(1,827)><$voicel(1,7)>Yo es que, cuando lo veo así, <$voicel(1,6)>me imagino sentad<gen;-3(o,a)> al raso<br>alrededor del fueguecito."
msgstr "<$cdef(27)><$emotion(1,29)></color><$voicel(1,5)>¿El color del cielo al atardecer no te recuerda al de<br>una <$cdef(27)><fqty(1)><$ifull(1280)></color>?<clear><br><$comeff(1,14)><$motion(1,827)><$voicel(1,7)>Yo es que, cuando lo veo así, <$voicel(1,6)>me imagino sentad<gen;-3(o,a)> al raso<br>alrededor del fueguito."

#. en: <$emotion(1,14)><$voicel(1,5)>Starin’ up at the blue sky durin’ the day kinda makes me<br>feel like I’m gonna get pulled right up into it!<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,3)>The night sky’s the opposite, though—makes me feel like<br>I’m gonna fall down into it! It’s a really weird feelin’!
msgctxt "2049:504"
msgid "<$emotion(1,14)><$voicel(1,5)>Cuando miro el cielo azul, siento como si me fuera<br>a succionar hacia lo alto.<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,3)>De noche me pasa lo contrario. Es como si me fuera<br>a caer en él. Ya ves tú qué cosas..."
msgstr "<$emotion(1,14)><$voicel(1,5)>Cuando miro el cielo azul, siento como si me fuera<br>a succionar hacia lo alto.<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,3)>De noche me pasa lo contrario. Es como si me fuera<br>a caer en él. Qué cosas, ¿no?"

#. en: <$emotion(1,29)><$voicel(1,5)>Hey, heyyy! Wanna hear one of my epic tales of<br>awesomeness today, bud?<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,7)>Like the AWESOME battle I had with a buddy, or the<br>INTENSE training I once did, or the time I found an<slide><br>AMAZING treasure...<clear><br><$emotion(1,37)><$voicel(1,9)>Gah! I don’t even know where to begin!
msgctxt "2049:507"
msgid "<$emotion(1,29)><$voicel(1,5)>¡Eh! ¿Quieres oír alguna de mis batallitas?<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,7)>A ver, podría contarte el peazo combate que libré con<br>un colega, o el entrenamiento superduro que me curré,<slide><br>o cuando encontré aquel tesoro tan guapardo...<clear><br><$emotion(1,37)><$voicel(1,9)>¡Buah! ¡Tengo tantas historias que no sé ni por dónde<br>empezar!"
msgstr "<$emotion(1,29)><$voicel(1,5)>¡Eh! ¿Quieres oír alguna de mis batallitas?<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,7)>A ver, podría contarte el gran combate que libré con<br>un amigo, o el entrenamiento superduro que hice,<slide><br>o cuando encontré aquel tesoro tan increíble...<clear><br><$emotion(1,37)><$voicel(1,9)>¡Uf! ¡Tengo tantas historias que no sé ni por dónde<br>empezar!"

#. en: <$motion(1,803)><$voicel(1,4)>Hmph... Uh, yeah, hey.<clear><br><$comeff(1,3)><$voicel(1,6)>Sorry, bud. I’m not in a bad mood or anything.<clear><br><$comeff(1,14)><$motion(1,827)><$voicel(1,7)>I’m just focusing really hard right now—doin’ some<br>visualization <$voicel(1,6)>before my next game of tag.<clear><br><$emotion(1,38)><$voicel(1,8)>I don’t wanna lose to anyone, y’know? Gotta stay sharp!
msgctxt "2049:508"
msgid "<$motion(1,803)><$voicel(1,4)>... <wait(2.0)>Oh. Hola.<clear><br><$comeff(1,3)><$voicel(1,6)>No, no estoy de mala leche ni nada de eso.<clear><br><$comeff(1,14)><$motion(1,827)><$voicel(1,7)>Es que no te había visto llegar porque estaba en pleno<br>entrenamiento imaginario <$voicel(1,6)>del pillapilla.<clear><br><$emotion(1,38)><$voicel(1,8)>Así practico algo al menos, que no quiero que nadie<br>me gane."
msgstr "<$motion(1,803)><$voicel(1,4)>... <wait(2.0)>Oh. Hola.<clear><br><$comeff(1,3)><$voicel(1,6)>No, no estoy de mal humor ni nada de eso.<clear><br><$comeff(1,14)><$motion(1,827)><$voicel(1,7)>Es que no te había visto llegar porque estaba en pleno<br>entrenamiento imaginario <$voicel(1,6)>de las atrapadas.<clear><br><$emotion(1,38)><$voicel(1,8)>Así practico algo al menos, que no quiero que nadie<br>me gane."

#. en: <oneline><$emotion(1,29)><$voicel(1,7)>Hey heyyy, <$cdef(27)><pname;0></color>! You livin’ your<br>best<slide><br>life<slide><br>again<slide><br>today, bud?<clear><br><$emotion(1,38)><$voicel(1,9)>Remember—be proud of everything you do! That’s how<br>you always stay cool!
msgctxt "2049:509"
msgid "<oneline><$emotion(1,29)><$voicel(1,7)>¿Qué pasa, <$cdef(27)><pname;0></color>?<br>¿Hoy también piensas<slide><br>exprimir el día<slide><br>al máximo?<clear><br><$emotion(1,38)><$voicel(1,9)>Mientras no hagas tonterías, por mí perfecto, niñ<gen;-2(o,a)>.<br>¡Que luego vienen las lamentaciones!"
msgstr "<oneline><$emotion(1,29)><$voicel(1,7)>¿Qué pasa, <$cdef(27)><pname;0></color>?<br>¿Hoy también piensas<slide><br>exprimir el día<slide><br>al máximo?<clear><br><$emotion(1,38)><$voicel(1,9)>Mientras no hagas tonterías, por mí perfecto, amig<gen;-2(o,a)>.<br>¡Que luego vienen las lamentaciones!"

#. en: <$emotion(1,14)><$voicel(1,7)>We all done for today? Till next time, bud!
msgctxt "2049:516"
msgid "<$emotion(1,14)><$voicel(1,7)>Se acabó lo que se daba por hoy. ¡Hasta otra!"
msgstr "<$emotion(1,14)><$voicel(1,7)>Esto es todo por hoy. ¡Hasta otra!"

#. en: <oneline><$emotion(1,14)><$voicel(1,7)>Hey heyyy, <$cdef(27)><pname;0></color>! Come <$cdef(27)><$spwfull(12)><br></color>with me!
msgctxt "2049:517"
msgid "<oneline><$emotion(1,14)><$voicel(1,7)>¡Ey, <$cdef(27)><pname;0></color>! ¡Vente p'acá<br>a <$cdef(27)><$spwfull(12)></color><slide><br>conmigo, anda!"
msgstr ""

#. en: <oneline><$voicel(1,5)><$emotion(1,14)>Hey, bud. I just saw <$cdef(27)><shoppk;0> </color>over at the<br><$cdef(27)><fqty(1)><$ifull(1325)></color>.
msgctxt "2049:518"
msgid "<$voicel(1,5)><$emotion(1,14)>¿Sabes qué? Antes me encontré con <dart;0()><$cdef(27)><shoppk;0></color><br>en la <$cdef(27)><fqty(1)><$ifull(1325)></color>."
msgstr ""

#. en: <$comeff(1,10)><$motion(1,807)><$facial(1,7)><$voicel(1,7)>It’s dangerous up by the water’s surface when the<br>weather’s bad. Might get struck by lightnin’, y’know?!<clear><br><$facial(1,1)>... ... ...<wait(0.8)><br><$comeff(1,4)><$motion(1,817)><$facial(1,9)><$voicel(1,3)>Not that I’m scared of a li’l lightnin’ or anything!
msgctxt "2049:520"
msgid "<$comeff(1,10)><$motion(1,807)><$facial(1,7)><$voicel(1,7)>Tú, ni se te ocurra acercarte al agua cuando haga mal<br>tiempo, ¿eh? A ver si va a caer un rayo y te deja ties<gen;-2(o,a)>.<clear><br><$facial(1,1)>... <wait(0.8)><$comeff(1,4)><$motion(1,817)><$facial(1,9)><$voicel(1,3)>¿Miedo? ¿YO? ¡Qué va! ¡Para nada! Ja... <wait(1.0)>Ja."
msgstr "<$comeff(1,10)><$motion(1,807)><$facial(1,7)><$voicel(1,7)>Tú, ni se te ocurra acercarte al agua cuando haga mal<br>tiempo, ¿eh? A ver si va a caer un rayo y te deja ties<gen;-2(o,a)>.<clear><br><$facial(1,1)>... <wait(0.8)><$comeff(1,4)><$motion(1,817)><$facial(1,9)><$voicel(1,3)>¿Miedo? ¿YO? ¡Claro que no! ¡Para nada! Ja... <wait(1.0)>Ja."

#. en: <oneline><$comeff(1,3)><$facial(1,4)><$motion(1,805)><$voicel(1,8)>Hey heyyy, <$cdef(27)><pname;0></color>! Looks like you’ve<br>been<slide><br>waterin’<slide><br>up a<slide><br>storm lately!<clear><br><$comeff(1,21)><$motion(1,801)><$voicel(1,9)>That’s real cool of ya! I better start helpin’ out around<br>here too. Can’t let you be the only one workin’ hard!
msgctxt "2049:521"
msgid "<oneline><$comeff(1,3)><$facial(1,4)><$motion(1,805)><$voicel(1,8)>¡Qué pasa, <$cdef(27)><pname;0></color>! Se nota que te has<br>ocupado<slide><br>de regar<slide><br>por aquí, ¿no?<clear><br><$comeff(1,21)><$motion(1,801)><$voicel(1,9)>¡Eres lo más! ¡Tengo que tomar ejemplo de ti!"
msgstr "<oneline><$comeff(1,3)><$facial(1,4)><$motion(1,805)><$voicel(1,8)>¡Qué pasa, <$cdef(27)><pname;0></color>! Se nota que te<br>ocupaste<slide><br>de regar<slide><br>por aquí, ¿no?<clear><br><$comeff(1,21)><$motion(1,801)><$voicel(1,9)>¡Eres lo más! ¡Tengo que tomar ejemplo de ti!"

#. en: <$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,6)>Hey, heyyy! Check out what I found. You can have it!
msgctxt "2049:522"
msgid "<$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,6)>Mira lo que me he encontrao. ¡Te lo regalo!"
msgstr "<$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,6)>Mira lo que me encontré. ¡Te lo regalo!"

#. en: <oneline><$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,8)>I was just hangin’ out with <$cdef(27)><nlpairpk;0> </color>a bit. They’re<br>a real<slide><br>cool<slide><br>Pokémon, y’know?<clear><br><$comeff(1,9)><$motion(1,805)><$voicel(1,9)>I think we could be the best of buds. I’m ready to hang out<br>with ’em again already!
msgctxt "2049:523"
msgid "<oneline><$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,8)>Últimamente me junto mucho con <dart;0()><$cdef(27)><nlpairpk;0></color>.<br>¡Es mu maj<gen;0(o,a)>! <clear><br><$comeff(1,9)><$motion(1,805)><$voicel(1,9)>¡Me cae tan bien que me pasaría horas y horas jugando<br>con <gen;0(él,ella)> cada día!"
msgstr "<oneline><$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,8)>Últimamente me junto mucho con <dart;0()><$cdef(27)><nlpairpk;0></color>.<br>¡Es muy simpátic<gen;0(o,a)>! <clear><br><$comeff(1,9)><$motion(1,805)><$voicel(1,9)>¡Me cae tan bien que me pasaría horas y horas jugando<br>con <gen;0(él,ella)> cada día!"

#. en: <$emotion(1,14)><$voicel(1,5)>Hey, bud! Can’t tell ya how much I appreciate you givin’<br>me <qty;0(that,those)> <$cdef(27)><fqty(1)><class><nlqueitem;0></color>!<clear><br><$emotion(1,8)><$voicel(1,7)>Don’t you worry one bit about <qty;0(it,them)>, either—I’m takin’<br>really good care of <qty;0(it,them)>. <qty;0(It’s,They’re)> one of my treasures now!
msgctxt "2049:524"
msgid "<oneline><$emotion(1,14)><$voicel(1,5)>¡Eh, gracias por<br><dart;0()><fqty(1)><class><$cdef(27)><nlqueitem;0></color><slide><br>que me diste!<clear><br><$emotion(1,8)><$voicel(1,7)>Tú tranquil<gen;-2(o,a)>, que pienso guardarl<genqty;0(o,a,os,as)> como oro en paño."
msgstr "<oneline><$emotion(1,14)><$voicel(1,5)>¡Eh, gracias por<br><dart;0()><fqty(1)><class><$cdef(27)><nlqueitem;0></color><slide><br>que me diste!<clear><br><$emotion(1,8)><$voicel(1,7)>Tú tranquil<gen;-2(o,a)>, que pienso guardarl<genqty;0(o,a,os,as)> como un tesoro."

#. en: <oneline><$comeff(1,21)><$facial(1,4)><$motion(1,803)><$voicel(1,9)><$cdef(27)><pname;0></color>! You can make houses like the<br>ones<slide><br>humans<slide><br>lived in,<slide><br>yeah?<slide><br>That’s awesome!<clear><br><$comeff(1,9)><$facial(1,1)><$motion(1,806)><$voicel(1,7)>Any house you make is sure to be real comfy too!<br><$emotion(1,38)><$voicel(1,10)>Ahhh! It’d be so cool to live in one of your houses!
msgctxt "2049:525"
msgid "<$comeff(1,21)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>¡Me parece taaan fuerte que sepas construir casas como<br>las de los humanos!<clear><br><$comeff(1,9)><$facial(1,1)><$motion(1,806)><$voicel(1,7)>Si me hicieras una a mí, fijo que sería supercómoda...<br><$emotion(1,38)><$voicel(1,10)>¡Buah, soñar es gratis!"
msgstr "<$comeff(1,21)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>¡Me parece taaan genial que sepas construir casas como<br>las de los humanos!<clear><br><$comeff(1,9)><$facial(1,1)><$motion(1,806)><$voicel(1,7)>Si me hicieras una a mí, seguro que sería supercómoda...<br><$emotion(1,38)><$voicel(1,10)>¡Ay, soñar es gratis!"

#. en: <$emotion(1,51)><$voicel(1,5)>Awww... Nighttime already?! But there are still so many<br>things I wanna do...<clear><br><$comeff(1,16)><$facial(1,1)><$motion(1,803)><$voicel(1,3)>*yaaawn*<br>Ugh. Maybe I’m runnin’ outta steam for the day, after all...
msgctxt "2049:526"
msgid "<$emotion(1,51)><$voicel(1,5)>Vaya hombre, ya se me ha ido el día así a lo tonto.<br>Con la de cosas que quería hacer todavía...<clear><br><$comeff(1,16)><$facial(1,1)><$motion(1,803)><$voicel(1,3)>Uaaah... Bah, mañana será otro día. Hoy ya no me queda<br>fuelle."
msgstr "<$emotion(1,51)><$voicel(1,5)>Vaya hombre, ya se me fue el día sin darme cuenta.<br>Con la de cosas que quería hacer todavía...<clear><br><$comeff(1,16)><$facial(1,1)><$motion(1,803)><$voicel(1,3)>Uaaah... Bah, mañana será otro día. Hoy ya no me queda<br>energía."

#. en: <$emotion(1,29)><$voicel(1,5)>You one of those Pokémon who gets really energetic when<br>the sun’s out, <$cdef(27)><pname;0></color>?<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,3)>I’m actually the opposite—sunshine makes me sleepy!<br><$comeff(1,16)><$motion(1,803)><$voicel(1,2)>*yaaawn*
msgctxt "2049:527"
msgid "<oneline><$emotion(1,29)><$voicel(1,5)>Oye, <$cdef(27)><pname;0></color>, ¿tú eres de l<gen;-2(os,as)> que<br>se sienten<slide><br>a tope<slide><br>cuando hace sol?<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,3)>A mí es que me pasa todo lo contrario. Lo que siento es<br>una modorra que pa qué... <$comeff(1,16)><$motion(1,803)><$voicel(1,2)>Uaaah..."
msgstr "<oneline><$emotion(1,29)><$voicel(1,5)>Oye, <$cdef(27)><pname;0></color>, ¿tú eres de l<gen;-2(os,as)> que<br>se sienten<slide><br>con energía<slide><br>cuando hace sol?<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,3)>A mí es que me pasa todo lo contrario. Lo que siento es<br>una modorra que pa qué... <$comeff(1,16)><$motion(1,803)><$voicel(1,2)>Uaaah..."

#. en: <$comeff(1,14)><$motion(1,827)><$voicel(1,8)>Wings come in all shapes ’n’ sizes, y’know?<clear><br><$voicel(1,3)>Ya got your soft ’n’ feathery wings, hard ’n’ sturdy wings,<br>big wings, li’l wings...<clear><br><$emotion(1,14)><$voicel(1,7)>But I betcha everybody with wings thinks theirs are the<br>coolest of all—<$emotion(1,38)><$voicel(1,10)>me included, of course! Haha!
msgctxt "2049:528"
msgid "<$comeff(1,14)><$motion(1,827)><$voicel(1,8)>Hay todo tipo de alas: <$voicel(1,3)>acolchadas, duras, grandotas,<br>pequeñajas...<clear><br><$emotion(1,14)><$voicel(1,7)>Todos piensan que las suyas son el no va más, pero<br>se equivocan, porque en realidad las mejores son...<slide><br><$emotion(1,38)><$voicel(1,10)>¡las mías, evidentemente! Je, je."
msgstr "<$comeff(1,14)><$motion(1,827)><$voicel(1,8)>Hay todo tipo de alas: <$voicel(1,3)>acolchadas, duras, grandotas,<br>pequeñitas...<clear><br><$emotion(1,14)><$voicel(1,7)>Todos piensan que las suyas son lo máximo, pero<br>se equivocan, porque en realidad las mejores son...<slide><br><$emotion(1,38)><$voicel(1,10)>¡las mías, evidentemente! Je, je."

#. en: <$emotion(1,14)><$voicel(1,6)>Listen up, bud. Poison is just one of many things Pokémon<br>can use to protect themselves.<clear><br><$comeff(1,14)><$voicel(1,7)>Not that there’s much need for protectin’ these days...<br>Still, if I had to, I’d gladly use my <$emotion(1,8)><$voicel(1,10)>poison to protect you<slide><br>too, <$cdef(27)><pname;0></color>!
msgctxt "2049:530"
msgid "<$emotion(1,14)><$voicel(1,6)>El veneno es un mecanismo de defensa morrocotudo.<clear><br><$comeff(1,14)><$voicel(1,7)>Que tampoco es que haya mucho de lo que protegerse<br>por aquí ahora mismo, pero oye, si se diera el caso...<slide><br><$emotion(1,8)><$voicel(1,10)>que sepas que no dudaré en usarlo para protegerte a ti."
msgstr "<$emotion(1,14)><$voicel(1,6)>El veneno es un mecanismo de defensa tremendo.<clear><br><$comeff(1,14)><$voicel(1,7)>Que tampoco es que haya mucho de lo que protegerse<br>por aquí ahora mismo, pero oye, si se diera el caso...<slide><br><$emotion(1,8)><$voicel(1,10)>que sepas que no dudaré en usarlo para protegerte a ti."

#. en: <$comeff(1,3)><$voicel(1,5)>Heyyy, <$cdef(27)><pname;0></color>! I’ve been wonderin’...<clear><br>If you transformed into me, <$emotion(1,29)><$voicel(1,8)>would your body get hard and<br>tough like mine?<clear><br><$emotion(1,38)><$voicel(1,9)>It’d be hilarious if you just LOOKED like me but were still<br>all squishy!
msgctxt "2049:532"
msgid "<$comeff(1,3)><$voicel(1,5)>Tengo una duda existencial: si te transformaras en mí,<br><$emotion(1,29)><$voicel(1,8)>¿tendrías el cuerpo igual de duro que yo?<clear><br><$emotion(1,38)><$voicel(1,9)>¡Sería rarísimo que tuvieras mi aspecto y el cuerpo<br>tan blandurrio como siempre!"
msgstr "<$comeff(1,3)><$voicel(1,5)>Tengo una duda existencial: si te transformaras en mí,<br><$emotion(1,29)><$voicel(1,8)>¿tendrías el cuerpo igual de duro que yo?<clear><br><$emotion(1,38)><$voicel(1,9)>¡Sería rarísimo que tuvieras mi aspecto y el cuerpo<br>tan blandito como siempre!"

#. en: <oneline><$emotion(1,29)><$voicel(1,5)>You sometimes carry stuff in your mouth,<br>right, <$cdef(27)><pname;0></color>?<clear><br><$emotion(1,38)><$voicel(1,9)>D’ya think you could carry me the same way?!<clear><br><$motion(1,807)><$facial(1,1)><$voicel(1,8)>Don’t even THINK about swallowin’ me whole, though!
msgctxt "2049:533"
msgid "<$emotion(1,29)><$voicel(1,5)>Oye, tú a veces llevas cosas en la boca, ¿verdad?<br><$emotion(1,38)><$voicel(1,9)>¿Crees que podrías llevarme ahí dentro a mí también?<slide><br><$motion(1,807)><$facial(1,1)><$voicel(1,8)>Mientras no te me tragues por accidente..."
msgstr "<$emotion(1,29)><$voicel(1,5)>Oye, tú a veces llevas cosas en la boca, ¿verdad?<br><$emotion(1,38)><$voicel(1,9)>¿Crees que podrías llevarme ahí adentro a mí también?<slide><br><$motion(1,807)><$facial(1,1)><$voicel(1,8)>Mientras no te me tragues por accidente..."

#. en: <$emotion(1,51)><$voicel(1,3)>Sometimes other Pokémon are scared of me ’cause I’m big<br>and don’t wanna get too close to me...<clear><br><$emotion(1,60)><$voicel(1,7)>But you don’t mind at all! You accepted me as a friend and<br>everything! <$emotion(1,8)><$voicel(1,10)>Can’t tell ya how much that means to me, bud.
msgctxt "2049:534"
msgid "<$emotion(1,51)><$voicel(1,3)>Como soy tan grandot<gen;-3(e,a)>, a veces los demás Pokémon<br>se asustan cuando me ven.<clear><br><$emotion(1,60)><$voicel(1,7)>Pero eso a ti nunca te ha importado y hasta nos hemos<br>hecho camaradas. <$emotion(1,8)><$voicel(1,10)>¡Te lo agradezco en el alma!"
msgstr "<$emotion(1,51)><$voicel(1,3)>Como soy tan grandot<gen;-3(e,a)>, a veces los demás Pokémon<br>se asustan cuando me ven.<clear><br><$emotion(1,60)><$voicel(1,7)>Pero eso a ti nunca te ha importado y hasta nos<br>hicimos camaradas. <$emotion(1,8)><$voicel(1,10)>¡Te lo agradezco en el alma!"

#. en: <$comeff(1,9)><$motion(1,806)><$voicel(1,7)>It’s not that I don’t like pretty flowers...I’d just rather enjoy<br>’em from a safe distance, y’know?<clear><br><$emotion(1,37)><$voicel(1,10)>If I get too close, I end up burnin’ ’em to a crisp!
msgctxt "2049:535"
msgid "<$comeff(1,9)><$motion(1,806)><$voicel(1,7)>Mira, no tengo nada en contra de las flores bonitas,<br>pero prefiero verlas de lejos.<clear><br><$emotion(1,37)><$voicel(1,10)>Si me acerco mucho, lo mismo las quemo sin querer."
msgstr "<$comeff(1,9)><$motion(1,806)><$voicel(1,7)>Mira, no tengo nada en contra de las flores bonitas,<br>pero prefiero verlas de lejos.<clear><br><$emotion(1,37)><$voicel(1,10)>Si me acerco mucho, a lo mejor las quemo sin querer."

#. en: <$emotion(1,37)><$voicel(1,9)>Hey bud, got a question for ya—do you like the ocean?<br>Me, I LOVE it!<clear><br><$motion(1,806)><$voicel(1,7)>The sound of the waves is so relaxin’... And of course, it’s<br>lotsa fun to go for a swim in the ocean too.<clear><br><$emotion(1,8)><$voicel(1,9)>Plus, the ocean’s HUGE, y’know? Just lookin’ at all that<br>vast oceany goodness gets me kinda excited!
msgctxt "2049:536"
msgid "<oneline><$emotion(1,37)><$voicel(1,9)>¿A ti te gusta el mar? ¡A mí me flipa mogollón!<clear><br><$motion(1,806)><$voicel(1,7)>El sonido de las olas me relaja mazo, y nadando me lo<br>paso bomba.<clear><br><$emotion(1,8)><$voicel(1,9)>¡Pero lo que más me gusta es sentarme a contemplarlo<br>en toda su inmensidad!"
msgstr "<oneline><$emotion(1,37)><$voicel(1,9)>¿A ti te gusta el mar? ¡A mí me encanta un montón!<clear><br><$motion(1,806)><$voicel(1,7)>El sonido de las olas me relaja muchísimo, y nadando la<br>paso genial.<clear><br><$emotion(1,8)><$voicel(1,9)>¡Pero lo que más me gusta es sentarme a contemplarlo<br>en toda su inmensidad!"

#. en: <$comeff(1,17)><$motion(1,807)><$voicel(1,5)>Uggghhh... I’m feelin’ kinda restless. I wonder if I stored up<br>too much electricity or somethin’...<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,4)>But if I discharge it all right now, it could be dangerous for<br>you, <$cdef(27)><pname;0></color>...<slide><br>Don’t worry, bud. I’ll do it later when I’m by myself.
msgctxt "2049:538"
msgid "<$comeff(1,17)><$motion(1,807)><$voicel(1,5)>Uf, me noto como sobrecargad<gen;-3(o,a)>... Creo que me he<br>pasado un poco acumulando electricidad.<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,4)>Tranquil<gen;-2(o,a)>, que no la voy a soltar aquí. No quiero que te<br>me electrocutes."
msgstr "<$comeff(1,17)><$motion(1,807)><$voicel(1,5)>Uf, me noto como sobrecargad<gen;-3(o,a)>... Creo que me<br>pasé un poco acumulando electricidad.<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,4)>Tranquil<gen;-2(o,a)>, que no la voy a soltar aquí. No quiero que te<br>me electrocutes."

#. en: <$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>Makin’ stuff float with my psychic powers is pretty<br>convenient most of the time.<clear><br><$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,3)>But, uh...the other day, I started noddin’ off while I was<br>floatin’ a berry and—THUD!—dropped it on my head!<clear><br><$comeff(1,10)><$facial(1,1)><$motion(1,661)><$voicel(1,7)>Convenience is cool and all, but ya still gotta pay<br>attention to what you’re doin’!
msgctxt "2049:539"
msgid "<$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>Hacer levitar cosas con mi poder psíquico es bien útil.<clear><br><$comeff(1,10)><$facial(1,1)><$motion(1,661)><$voicel(1,7)>Hay un porrón de maneras de usar este talento tan chulo,<br>pero hay que andarse con ojo.<clear><br><$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,3)>El otro día estaba haciendo flotar una baya. Con el<br>calorcito del sol me fui quedando sopa y... ¿qué pasó?<slide><br>Pues bayazo en toda la cabeza. No veas el chichón..."
msgstr "<$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>Hacer levitar cosas con mi poder psíquico es bien útil.<clear><br><$comeff(1,10)><$facial(1,1)><$motion(1,661)><$voicel(1,7)>Hay un montón de maneras de usar este talento tan genial,<br>pero hay que andarse con ojo.<clear><br><$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,3)>El otro día estaba haciendo flotar una baya. Con el<br>calorcito del sol me fue dando sueño y... ¿qué pasó?<slide><br>Pues bayazo en toda la cabeza. Qué chichón me salió..."

#. en: <$comeff(1,14)><$voicel(1,5)>It’s not like I WANT to scare everyone, y’know?<clear><br><$emotion(1,37)><$voicel(1,9)>That’s why I always have a big friendly smile on my face—<br>especially at night or in dark places!<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>See? Who doesn’t love a big smile comin’ at ’em outta<br>the darkness?!<wait(0.8)><clear><br><$comeff(1,6)><$facial(1,1)><$motion(1,803)><$voicel(1,6)>Oh... That’s, uh...pretty terrifying, huh?
msgctxt "2049:541"
msgid "<$comeff(1,14)><$voicel(1,5)>Aunque no lo creas, yo en realidad no tengo un interés<br>particular por asustar a nadie.<clear><br><$emotion(1,37)><$voicel(1,9)>Por eso siempre voy con la sonrisa puesta, sobre todo<br>de noche o en lugares oscuros.<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>¡Tal que así! ¿Ves? Imagina ver esta sonrisa en mitad de<br>la noche. ¿A que te... <wait(0.8)><$comeff(1,6)><$facial(1,1)><$motion(1,803)><$voicel(1,6)>falta tiempo para salir por patas?"
msgstr "<$comeff(1,14)><$voicel(1,5)>Aunque no lo creas, yo en realidad no tengo un interés<br>particular por asustar a nadie.<clear><br><$emotion(1,37)><$voicel(1,9)>Por eso siempre voy con la sonrisa puesta, sobre todo<br>de noche o en lugares oscuros.<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>¡Tal que así! ¿Ves? Imagina ver esta sonrisa en mitad de<br>la noche. ¿A que te... <wait(0.8)><$comeff(1,6)><$facial(1,1)><$motion(1,803)><$voicel(1,6)>dan ganas de salir corriendo?"

#. en: <$emotion(1,14)><$voicel(1,5)>I had human friends back in the day, y’know!<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,7)>And they had perfectly round eyes too, just like you.<clear><br><$emotion(1,37)><$voicel(1,6)>Well, maybe not perfectly round... Or even all that round...<br>Huh. Their eyes were actually nothing like yours!
msgctxt "2049:542"
msgid "<$emotion(1,14)><$voicel(1,5)>En otros tiempos, yo también tuve algún que otro amigo<br>humano, ¿sabes?<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,7)>Tenían unos ojos bien majetes, así como los tuyos...<br><$emotion(1,37)><$voicel(1,6)>Bueno, como los tuyos, no. Tu mirada es inconfundible."
msgstr "<$emotion(1,14)><$voicel(1,5)>En otros tiempos, yo también tuve algún que otro amigo<br>humano, ¿sabes?<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,7)>Tenían unos ojos bien lindos, así como los tuyos...<br><$emotion(1,37)><$voicel(1,6)>Bueno, como los tuyos, no. Tu mirada es inconfundible."

#. en: <oneline><$emotion(1,29)><$voicel(1,7)>How’re you so good at makin’ things,<br><$cdef(27)><pname;0></color>?<clear><br><$comeff(1,14)><$motion(1,827)><$voicel(1,5)>I bet if you keep workin’ at it you’ll be able to make, like...<br><$voicel(1,8)>a hundred chairs all at once or somethin’!
msgctxt "2049:543"
msgid "<oneline><$emotion(1,29)><$voicel(1,7)>¡Yo alucino contigo! ¿Cómo puedes tener tanta maña,<br><$cdef(27)><pname;0></color>?<clear><br><$comeff(1,14)><$motion(1,827)><$voicel(1,5)>¡Como sigas a este ritmo, te veo fabricando <$voicel(1,8)>cien sillas<br>del tirón!"
msgstr "<oneline><$emotion(1,29)><$voicel(1,7)>¡Yo alucino contigo! ¿Cómo puedes tener tanta maña,<br><$cdef(27)><pname;0></color>?<clear><br><$comeff(1,14)><$motion(1,827)><$voicel(1,5)>¡Como sigas a este ritmo, te veo fabricando <$voicel(1,8)>cien sillas<br>de una vez!"

#. en: <$emotion(1,14)><$voicel(1,7)>Hey, bud. So, you can transform into all kinds of stuff, but<br>your face always stays the same, huh?<clear><br><$emotion(1,8)><$voicel(1,9)>Can’t say I hate it, though! I’m a fan!
msgctxt "2049:544"
msgid "<$emotion(1,14)><$voicel(1,7)>Algo en lo que me he fijado es que da igual en qué te<br>transformes, siempre tienes la misma cara.<clear><br><$emotion(1,8)><$voicel(1,9)>Tampoco es algo malo. Supongo que justamente ahí<br>radica tu encanto."
msgstr ""

#. en: <$comeff(1,14)><$motion(1,827)><$voicel(1,5)>All the Pokémon here have different tastes in food and<br>livin’ spaces... <$voicel(1,8)>REALLY different, y’know?<clear><br><$emotion(1,38)><$voicel(1,9)>But we can all still be best buds despite our differences...<br>That’s pretty cool, huh?!
msgctxt "2049:545"
msgid "<$comeff(1,14)><$motion(1,827)><$voicel(1,5)>Cada uno es de su padre y de su madre con la comida o<br>con las casas... <$voicel(1,8)>Muchas veces tenemos gustos opuestos.<clear><br><$emotion(1,38)><$voicel(1,9)>¿Y eso impide que nos llevemos bien? ¡Claro que no!<br>¡Sin variedad, sería un rollazo!"
msgstr "<$comeff(1,14)><$motion(1,827)><$voicel(1,5)>Cada quien tiene sus gustos con la comida o<br>con las casas... <$voicel(1,8)>Muchas veces tenemos gustos opuestos.<clear><br><$emotion(1,38)><$voicel(1,9)>¿Y eso impide que nos llevemos bien? ¡Claro que no!<br>¡Sin variedad, sería aburridísimo!"

#. en: <$emotion(1,50)><$voicel(1,7)>I was talkin’ with <$cdef(27)><nlpairpk;0> </color>a bit ago, and lemme<br>tell ya—that Pokémon’s got potential!<clear><br><$emotion(1,38)><$voicel(1,9)>Maybe I’ll make ’em my apprentice in awesomeness...<br>Kidding! ♪
msgctxt "2049:546"
msgid "<oneline><$emotion(1,50)><$voicel(1,7)>Acabo de tener una buena charla con<br><dart;0()><$cdef(27)><nlpairpk;0></color>.<slide><br>¡La verdad es que me cae muy bien!<clear><br><$emotion(1,38)><$voicel(1,9)>Hasta me estoy planteando tomar su tutela y enseñarle<br>una cosa o dos sobre la vida... ¡Que nooo, que es broma!"
msgstr ""

#. en: <oneline><$emotion(1,14)><$voicel(1,10)><$cdef(27)><pname;0></color>! Hey, do you remember <qty;1(that,those)><br><$cdef(27)><fqty(1)><class><nlqueitem;1></color><slide><br>you<slide><br>gave<slide><br>me?<clear><br><$comeff(1,14)><$voicel(1,7)>Thanks again, bud! <qty;1(It was,They were)> super good! <$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>Oooh! I can still<br>taste <qty;1(it,’em)> just thinkin’ about it!
msgctxt "2049:547"
msgid "<oneline><$emotion(1,14)><$voicel(1,10)>¡Qué pasa, <$cdef(27)><pname;0></color>! ¡Oye, gracias por<br><dart;1()><$cdef(27)><fqty(1)><nlqueitem;1></color><slide><br>que me diste!<clear><br><$comeff(1,14)><$voicel(1,7)>Ahora me estoy acordando <$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>y se me hace la boca agua.<br>¡Qué cosa más rica, por favooor!"
msgstr ""

#. en: <oneline><$emotion(1,14)><$voicel(1,5)>I was thinkin’ about goin’ to see<br><$cdef(27)><crstlktar;0></color>...<clear><br><$emotion(1,31)><$voicel(1,1)>But it’s a bit of a trek from where I live, y’know?<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,3)>Maybe if we lived a li’l closer together we could hang<br>out more...
msgctxt "2049:548"
msgid "<oneline><$emotion(1,14)><$voicel(1,5)>Llevo un tiempo pensando en ir a visitar<br><esa;0()><$cdef(27)><crstlktar;0></color>.<clear><br><$emotion(1,31)><$voicel(1,1)>Lo malo es que desde aquí está la cosa un poco chunga...<br><$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,3)>Si viviéramos más cerca, sería otra historia."
msgstr "<oneline><$emotion(1,14)><$voicel(1,5)>Llevo un tiempo pensando en ir a visitar<br><esa;0()><$cdef(27)><crstlktar;0></color>.<clear><br><$emotion(1,31)><$voicel(1,1)>Lo malo es que desde aquí la cosa está algo difícil...<br><$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,3)>Si viviéramos más cerca, sería otra historia."

#. en: <oneline><$comeff(1,6)><$motion(1,805)><$voicel(1,5)>We don’t get to see <$cdef(27)><crstlktar;0> </color>around<br>here<slide><br>much,<slide><br>do we.<clear><br><$voicel(1,4)>I wish I could see them more often...<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>If only they lived next door to me. Then we could hang out<br>all the time!
msgctxt "2049:549"
msgid "<oneline><$comeff(1,6)><$motion(1,805)><$voicel(1,5)><fcap><esa;0()><$cdef(27)><crstlktar;0></color> no se le ve casi<br>el pelo por aquí,<slide><br>¿verdad?<clear><br><$voicel(1,4)>Lástima, me apetecía charlar un rato. <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>A ver si tendré que<br>sugerirle que se mude cerca de casa..."
msgstr "<oneline><$comeff(1,6)><$motion(1,805)><$voicel(1,5)><fcap><esa;0()><$cdef(27)><crstlktar;0></color> no se le ve casi<br>nunca por aquí,<slide><br>¿verdad?<clear><br><$voicel(1,4)>Lástima, quería charlar un rato. <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>A ver si tendré que<br>sugerirle que se mude cerca de casa..."

#. en: <$voicel(1,7)><$motion(1,824)><$comeff(1,1)><$facial(1,4)>And this is a prize for getting the right answer! Take it!
msgctxt "2049:550"
msgid "<$voicel(1,7)><$motion(1,824)><$comeff(1,1)><$facial(1,4)>Y pa que veas lo desprendid<gen;-3(o,a)> que soy con quien<br>acierta, ¡toma, regalazo al canto!"
msgstr "<$voicel(1,7)><$motion(1,824)><$comeff(1,1)><$facial(1,4)>Y pa que veas lo desprendid<gen;-3(o,a)> que soy con quien<br>acierta, ¡toma, aquí va un regalazo!"

#. en: <$comeff(1,9)><$motion(1,806)><$voicel(1,7)>Havin’ my own pad is pretty dang cool! Feels like I’m livin’<br>in luxury here.<clear><br><$emotion(1,29)><$voicel(1,5)>You worked hard to build this place for me, yeah? <$emotion(1,38)><$voicel(1,10)>Thanks<br>a ton, bud!
msgctxt "2049:551"
msgid "<$comeff(1,9)><$motion(1,806)><$voicel(1,7)>Tener tu propia casa, con sus cuatro paredes, es un lujazo.<br>¡Además, que vivo a cuerpo de <gen;-3(rey,reina)>!<clear><br><$emotion(1,29)><$voicel(1,5)>Y tú trabajaste muy duro para construirla, ¿verdad?<br><$emotion(1,38)><$voicel(1,10)>¡Muchas gracias, <$cdef(27)><pname;0></color>!"
msgstr ""

#. en: <oneline><$comeff(1,14)><$voicel(1,6)>Awesome! OK...<clear><br><$emotion(1,37)><$voicel(1,7)>What’s <$cdef(27)><qtargetpk;0></color>’s favorite flavor?! Take your<br>best guess!
msgctxt "2049:552"
msgid "<oneline><$comeff(1,14)><$voicel(1,6)>¡Ole! Pues es esta, ¡prepárate!<clear><br><$emotion(1,37)><$voicel(1,7)>¿A que no adivinas cuál es el sabor preferido<br><esde;0()><$cdef(27)><qtargetpk;0></color>?"
msgstr "<oneline><$comeff(1,14)><$voicel(1,6)>¡Bien! Pues es esta, ¡prepárate!<clear><br><$emotion(1,37)><$voicel(1,7)>¿A que no adivinas cuál es el sabor preferido<br><esde;0()><$cdef(27)><qtargetpk;0></color>?"

#. en: Thaaat’s...<wait(0.4)><$comeff(1,20)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>the right answer! You really know your stuff!
msgctxt "2049:554"
msgid "<oneline>...<wait(0.4)> <$comeff(1,20)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Sí, seño<gen;-2(r,ra)>! ¿Hay algo que no sepas,<br><$cdef(27)><pname;0></color>?"
msgstr ""

#. en: Thaaat’s...<wait(0.4)><$emotion(1,37)><$voicel(1,9)>the wrong answer! Uh-oh! The correct answer is<br><$cdef(27)><ltasteq;0></color>, bud!<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,7)>I’ll think up another quiz for ya. I’m sure you’ll get the<br>right answer next time!
msgctxt "2049:555"
msgid "...<wait(0.4)> <$emotion(1,37)><$voicel(1,9)>¡Pues va a ser que no! ¡Se siente! Tendrías que haber<br>dicho \"el <$cdef(27)><ltasteq;0></color>\".<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,7)>Pero no te preocupes, ¿eh? ¡La próxima vez seguro que<br>lo clavas!"
msgstr "...<wait(0.4)> <$emotion(1,37)><$voicel(1,9)>¡Pues va a ser que no! ¡Qué lástima! Tendrías que haber<br>dicho \"el <$cdef(27)><ltasteq;0></color>\".<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,7)>Pero no te preocupes, ¿eh? ¡La próxima vez seguro que<br>lo clavas!"

#. en: <oneline><$comeff(1,14)><$voicel(1,6)>Awesome! OK...<clear><br><$emotion(1,37)><$voicel(1,7)>What sorta flavor does <$cdef(27)><qtargetpk;0> </color>just REALLY<br>not<slide><br>like?<slide><br>Gimme<slide><br>your<slide><br>best guess!
msgctxt "2049:557"
msgid "<oneline><$comeff(1,14)><$voicel(1,6)>¡Genial! Veamos cuánto sabes...<clear><br><$emotion(1,37)><$voicel(1,7)>¿Cuál es el sabor que no soporta <dart;0()><$cdef(27)><qtargetpk;0></color><br>de ninguna<slide><br>de las maneras?"
msgstr ""

#. en: Thaaat’s...<wait(0.4)><$comeff(1,20)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>the right answer! You really know your stuff!
msgctxt "2049:559"
msgid "<oneline>...<wait(0.4)> <$comeff(1,20)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Ole! ¡Sí, seño<gen;-2(r,ra)>! Si es que lo que no sepas tú,<br><$cdef(27)><pname;0></color>..."
msgstr "<oneline>...<wait(0.4)> <$comeff(1,20)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Bien! ¡Sí, seño<gen;-2(r,ra)>! Si es que lo que no sepas tú,<br><$cdef(27)><pname;0></color>..."

#. en: That’s...<wait(0.4)><$emotion(1,37)><$voicel(1,9)>the wrong answer! Uh-oh! The right answer was<br><$cdef(27)><htasteq;0></color>, bud!<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,7)>I’ll think up another quiz for ya. I’m sure you’ll get the<br>right answer next time!
msgctxt "2049:560"
msgid "...<wait(0.4)> <$emotion(1,37)><$voicel(1,9)>¡Respuesta incorrecta! Lo que no le gusta <qty;0(es,son)><br><dart;0()><$cdef(27)><htasteq;0></color>.<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,7)>No te preocupes, ¡habrá más oportunidades como esta<br>para ponerte a prueba!"
msgstr ""

#. en: <oneline><$comeff(1,14)><$voicel(1,6)>Awesome! OK...<clear><br><$emotion(1,37)><$voicel(1,7)>What’s <$cdef(27)><qtargetpk;0></color>’s favorite thing? Take your<br>best guess!
msgctxt "2049:562"
msgid "<oneline><$comeff(1,14)><$voicel(1,6)>¡Olé! Pues es esta, ¡prepárate!<clear><br><$emotion(1,37)><$voicel(1,7)>¿Qué cosas le gustan más <esa;0()><$cdef(27)><qtargetpk;0></color>?"
msgstr "<oneline><$comeff(1,14)><$voicel(1,6)>¡Bien! Pues es esta, ¡prepárate!<clear><br><$emotion(1,37)><$voicel(1,7)>¿Qué cosas le gustan más <esa;0()><$cdef(27)><qtargetpk;0></color>?"

#. en: Thaaat’s...<wait(0.4)><$comeff(1,20)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>the right answer! You really know your stuff!
msgctxt "2049:564"
msgid "<oneline>...<wait(0.4)> <$comeff(1,20)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Toooma ya! ¡Sí, seño<gen;-2(r,ra)>! Si es que lo que no sepas tú,<br><$cdef(27)><pname;0></color>..."
msgstr "<oneline>...<wait(0.4)> <$comeff(1,20)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Bieeen! ¡Sí, seño<gen;-2(r,ra)>! Si es que lo que no sepas tú,<br><$cdef(27)><pname;0></color>..."

#. en: That’s...<wait(0.4)><$emotion(1,37)><$voicel(1,9)>the wrong answer! Uh-oh! The right answer was<br><$cdef(27)><likemtag;0></color>, bud!<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,7)>I’ll think up another quiz for ya. I’m sure you’ll get the<br>right answer next time!
msgctxt "2049:565"
msgid "...<wait(0.4)> <$emotion(1,37)><$voicel(1,9)>¡Respuesta incorrecta! Lo que le gusta de verdad<br><qty;0(es,son)> <dart;0()><$cdef(27)><likemtag;0></color>.<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,7)>No te preocupes, ¡que habrá más oportunidades como<br>esta para ponerte a prueba!"
msgstr ""

#. en: <$voicel(1,10)><$emotion(1,8)>See ya around, bud! Let’s hang again sometime!
msgctxt "2049:566"
msgid "<$voicel(1,10)><$emotion(1,8)>¡Hale, hasta más ver!"
msgstr "<$voicel(1,10)><$emotion(1,8)>¡Bueno, hasta más ver!"

#. en: <oneline><$emotion(1,29)><$voicel(1,5)>Hey, do you have any<br><$cdef(27)><fqty(2)><class><refmateid;1></color><slide><br>on<slide><br>ya<slide><br>right now?<clear><br><$emotion(1,8)><$voicel(1,9)>If you wanna give some to me, I could turn ’em into<br><$cdef(27)><fqty(2)><class><reftarid;2></color><slide><br>for<slide><br>ya, bud!
msgctxt "2049:569"
msgid "<oneline><$emotion(1,29)><$voicel(1,5)>Eh, ¿llevas<br><fqty(2)><class><$cdef(27)><refmateid;1></color><slide><br>encima?<clear><br><oneline><$emotion(1,8)><$voicel(1,9)>Si me <gen;1(los,las)> dejas, te puedo hacer<br><fqty(2)><class><$cdef(27)><reftarid;2></color>."
msgstr ""

#. en: <oneline><$emotion(1,51)><$voicel(1,3)>Sorry, bud! I don’t know much at all about<br><$cdef(27)><fqty(2)><class><referrmate;0></color>...<clear><br><$emotion(1,14)><$voicel(1,8)>I’ll bet <$cdef(27)><referrpk;1> </color>would know somethin’, though!
msgctxt "2049:570"
msgid "<oneline><$emotion(1,51)><$voicel(1,3)>Lo siento, no tengo ni idea de procesar<br><fqty(2)><class><$cdef(27)><referrmate;0></color>.<clear><br><$emotion(1,14)><$voicel(1,8)>Pero creo que <dart;1()><$cdef(27)><referrpk;1></color> sí sabe del tema."
msgstr ""

#. en: <oneline><$emotion(1,51)><$voicel(1,3)>Sorry, bud! I don’t know much at all about<br><$cdef(27)><fqty(2)><class><referrmate;0></color>...<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,6)>Can’t think of anyone who would, either...
msgctxt "2049:571"
msgid "<oneline><$emotion(1,51)><$voicel(1,3)>Lo siento, no tengo ni idea de procesar<br><fqty(2)><class><$cdef(27)><referrmate;0></color>.<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,6)>Ni tampoco de quién podría saber del tema."
msgstr ""

#. en: <oneline><$emotion(1,51)><$voicel(1,3)>Sorry, bud! I don’t know much at all about<br><$cdef(27)><fqty(2)><class><referrmate;0></color>...<clear><br><$emotion(1,14)><$voicel(1,5)>But, uh...I tell ya what I CAN do. If you’ve got any<br><$cdef(27)><fqty(2)><class><refmateid;1></color>,<slide><br>I<slide><br>can<slide><br>turn<slide><br>those<slide><br>into<slide><br><$voicel(1,8)><$cdef(27)><fqty(2)><class><reftarid;2></color><slide><br>for ya!<clear><br><$comeff(1,6)><$motion(1,666)><$voicel(1,10)>What do ya say?
msgctxt "2049:572"
msgid "<oneline><$emotion(1,51)><$voicel(1,3)>Lo siento, no tengo ni idea de procesar<br><fqty(2)><class><$cdef(27)><referrmate;0></color>.<clear><br><oneline><$emotion(1,14)><$voicel(1,5)>En cambio, <gen;1(los,las)><br><fqty(2)><class><$cdef(27)><refmateid;1></color><slide><br><$voicel(1,8)>te <gen;1(los,las)> puedo<slide><br>convertir en<slide><br><$cdef(27)><fqty(2)><class><reftarid;2></color>.<clear><br><$comeff(1,6)><$motion(1,666)><$voicel(1,10)>¿Qué me dices?"
msgstr ""

#. en: <oneline><$emotion(1,29)><$voicel(1,6)>Need some<br><$cdef(27)><fqty(2)><class><reftarid;0></color>,<slide><br>do ya?<clear><br><$comeff(1,14)><$voicel(1,7)>Just put some<br><$cdef(27)><fqty(2)><class><refmateid;2></color><slide><br>in<slide><br>the<slide><br><$cdef(27)><fqty(1)><reftable;1></color><slide><br>for<slide><br>me, then.<clear><br><$emotion(1,8)><$voicel(1,10)>I’ll process ’em soon as I can!
msgctxt "2049:573"
msgid "<oneline><$emotion(1,29)><$voicel(1,6)>¿Necesitas<br><fqty(2)><class><$cdef(27)><reftarid;0></color>?<clear><br><$comeff(1,14)><$voicel(1,7)>Deja <dart;2()><fqty(1)><class><$cdef(27)><refmateid;2></color><br>en <dart;1()><fqty(1)><class><$cdef(27)><reftable;1></color>.<slide><br><$emotion(1,8)><$voicel(1,10)>¡En cuanto pueda,<slide><br>me pondré con ello!"
msgstr ""

#. en: <oneline><$comeff(1,14)><$voicel(1,5)>I’m gonna need <iart;1()><$cdef(27)><fqty(1)><reftable;1><br></color>if<slide><br>you<slide><br>want<slide><br>me<slide><br>to<slide><br>make<slide><br>any<slide><br><$cdef(27)><fqty(2)><class><reftarid;0></color>.<clear><br><$emotion(1,29)><$voicel(1,7)>Would ya mind settin’ me up<br><iart;2()><$cdef(27)><fqty(1)><reftable;2></color>?
msgctxt "2049:574"
msgid "<oneline><$comeff(1,14)><$voicel(1,5)>Necesito<br><iart;1()><fqty(1)><class><$cdef(27)><reftable;1></color><slide><br>para elaborar<slide><br><$cdef(27)><fqty(2)><class><reftarid;0></color>.<clear><br><oneline><$emotion(1,29)><$cdef(27)><$voicel(1,7)></color>¿Me puedes colocar <genqty;1(uno,una,unos,unas)>?"
msgstr ""

#. en: <$emotion(1,37)><$voicel(1,7)>Also, hey...check this out, bud! <$voicel(1,8)><$motion(1,803)><$comeff(1,21)><$facial(1,4)>I made somethin’<br>kinda awesome!
msgctxt "2049:575"
msgid "<$emotion(1,37)><$voicel(1,7)>¡Bueno, bueno! ¡Y no te lo pierdas! Mira qué otra cosa<br>me he currao.<clear><br><$voicel(1,8)><$motion(1,803)><$comeff(1,21)><$facial(1,4)>¡Es aún mejor si cabe de lo que me suele salir!"
msgstr "<$emotion(1,37)><$voicel(1,7)>¡Bueno, bueno! ¡Y no te lo pierdas! Mira qué otra cosa<br>me hice.<clear><br><$voicel(1,8)><$motion(1,803)><$comeff(1,21)><$facial(1,4)>¡Es aún mejor si cabe de lo que me suele salir!"

#. en: <$emotion(1,8)><$voicel(1,7)>Oh yeah! I picked this up on my way over. You can have<br>it, bud!
msgctxt "2049:576"
msgid "<$emotion(1,8)><$voicel(1,7)>Por cierto, me he encontrado esto por ahí tirao mientras<br>venía hacia aquí. ¡Te lo puedes quedar!"
msgstr "<$emotion(1,8)><$voicel(1,7)>Por cierto, me encontré esto por ahí tirao mientras<br>venía hacia aquí. ¡Te lo puedes quedar!"

#. en: <oneline><$emotion(1,37)><$voicel(1,7)><$cdef(27)><pname;0></color>! There ya are, bud! The<br><$cdef(27)><cdirbname;1></color>’s<slide><br>all finished!<clear><br><$emotion(1,8)><$voicel(1,9)>You should definitely check it out while you’re here!
msgctxt "2049:585"
msgid "<oneline><$emotion(1,37)><$voicel(1,7)>¡Mira qué bien! ¡Llegas en el momento oportuno!<br>¡Ya est<qty;1(á,án)> list<genqty;1(o,a,os,as)><slide><br><dart;1()><$cdef(27)><cdirbname;1></color>!<clear><br><$emotion(1,8)><$voicel(1,9)>¡Aprovecha para echarl<qty;1(e,es)> un ojo!"
msgstr ""

#. en: <$emotion(1,38)><$voicel(1,10)>Ready for the big reveal?! Here we go!
msgctxt "2049:586"
msgid "<$emotion(1,38)><$voicel(1,10)>¿List<gen;-2(o,a)> pa la inauguración? ¡Te vas a quedar a cuadros!"
msgstr "<$emotion(1,38)><$voicel(1,10)>¿List<gen;-2(o,a)> pa la inauguración? ¡Vas a alucinar!"

#. en: <$emotion(1,8)><$voicel(1,7)>How ’bout it?! Pretty awesome, huh? I’m real proud of it!<clear><br><$emotion(1,37)><$voicel(1,9)>Lemme know when you wanna <$cdef(27)><$spwfull(1)> </color>something again!<br>I’m down to help anytime!
msgctxt "2049:587"
msgid "<$emotion(1,8)><$voicel(1,7)>¿Qué, a que es impresionante? Yo estoy superorgullos<gen;-3(o,a)><br>de haber participado.<clear><br><$emotion(1,37)><$voicel(1,9)>Dame un toque la próxima vez que te dé por <$cdef(27)><$spwfull(1)><br></color>algo, ¿me oyes? ¡Vendré a ayudarte sin falta!"
msgstr "<$emotion(1,8)><$voicel(1,7)>¿Qué, a que es impresionante? Yo estoy superorgullos<gen;-3(o,a)><br>de haber participado.<clear><br><$emotion(1,37)><$voicel(1,9)>Avísame la próxima vez que te dé por <$cdef(27)><$spwfull(1)><br></color>algo, ¿me oyes? ¡Vendré a ayudarte sin falta!"

#. en: <$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,5)>Hey heyyy, <$cdef(27)><pname;0></color>!<clear><br><$comeff(1,6)><$motion(1,805)><$voicel(1,8)>Wanna test your skills in a quick game of “look that way”<br>with me?!
msgctxt "2049:593"
msgid "<$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,5)>¡Ey, <$cdef(27)><pname;0></color>!<clear><br><$comeff(1,6)><$motion(1,805)><$voicel(1,8)>¿Te hace jugar conmigo un ratejo a \"esquiva la baya\"?"
msgstr "<$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,5)>¡Ey, <$cdef(27)><pname;0></color>!<clear><br><$comeff(1,6)><$motion(1,805)><$voicel(1,8)>¿Quieres jugar conmigo un ratito a \"esquiva la baya\"?"

#. en: <$comeff(1,10)><$facial(1,4)><$motionoff(1,804)><$voicel(1,7)>That’s what I like to hear! Get ready to lose, though! Haha!
msgctxt "2049:594"
msgid "<$comeff(1,10)><$facial(1,4)><$motionoff(1,804)><$voicel(1,7)>¡Así me gusta, niñ<gen;-2(o,a)>! ¡Prepárate para perder!"
msgstr "<$comeff(1,10)><$facial(1,4)><$motionoff(1,804)><$voicel(1,7)>¡Así me gusta, amig<gen;-2(o,a)>! ¡Prepárate para perder!"

#. en: <$comeff(1,3)><$facial(1,1)><$motion(1,807)><$voicel(1,3)>OK, no big deal. Let’s play some other time, then!
msgctxt "2049:595"
msgid "<$comeff(1,3)><$facial(1,1)><$motion(1,807)><$voicel(1,3)>Nada, pues, ya jugaremos otro día."
msgstr ""

#. en: <$comeff(1,3)><$facial(1,1)><$motion(1,665)><$voicel(1,9)>No way! I lost?! Well, it’s all good as long as we’re havin’<br>fun, I guess!<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,8)>Thanks for playin’! Let’s do this again sometime!
msgctxt "2049:596"
msgid "<$comeff(1,3)><$facial(1,1)><$motion(1,665)><$voicel(1,9)>¡Vaya, hombre, he perdido! ¡Pero me lo he pasado bomba<br>igualmente!<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,8)>Gracias, tronc<gen;-2(o,a)>. ¡A ver si no tardamos mucho en volver<br>a jugar!"
msgstr "<$comeff(1,3)><$facial(1,1)><$motion(1,665)><$voicel(1,9)>¡Vaya, hombre, perdí! ¡Pero la pasé genial<br>igualmente!<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,8)>Gracias, amig<gen;-2(o,a)>. ¡A ver si no tardamos mucho en volver<br>a jugar!"

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Nice! I won! Winning makes the game twice as fun!<clear><br><$comeff(1,10)><$motion(1,803)><$voicel(1,8)>Thanks for playin’! Let’s do this again sometime!
msgctxt "2049:597"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Victoriaaa! Dicen que lo importante es participar y tal,<br>pero, si además gano, ¡pues eso que me llevo!<clear><br><$comeff(1,10)><$motion(1,803)><$voicel(1,8)>Gracias, tronc<gen;-2(o,a)>. ¡A ver si no tardamos mucho en jugar<br>otra vez!"
msgstr "<$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Victoriaaa! Dicen que lo importante es participar y tal,<br>pero, si además gano, ¡pues eso que me llevo!<clear><br><$comeff(1,10)><$motion(1,803)><$voicel(1,8)>Gracias, amig<gen;-2(o,a)>. ¡A ver si no tardamos mucho en jugar<br>otra vez!"

#. en: <oneline><$emotion(1,29)><$voicel(1,5)>Hey heyyy, <$cdef(27)><pname;0></color>! How ya feel about<br>a<slide><br>quick<slide><br>round<slide><br>of<slide><br>hide-and-sneak?<clear><br><$emotion(1,38)><$voicel(1,8)>You can hide. I’ll go lookin’ for ya!
msgctxt "2049:610"
msgid "<$emotion(1,29)><$voicel(1,5)>¡Ey, qué pasa, <$cdef(27)><pname;0></color>!<clear><br>¿Te hace jugar al escondite camuflado un rato? <$emotion(1,38)><$voicel(1,8)>Tranqui,<br>que ya me ofrezco yo para llevarla."
msgstr "<$emotion(1,29)><$voicel(1,5)>¡Ey, qué pasa, <$cdef(27)><pname;0></color>!<clear><br>¿Quieres jugar al escondite camuflado un rato? <$emotion(1,38)><$voicel(1,8)>Tranqui,<br>que ya me ofrezco yo para buscar."

#. en: <$emotion(1,50)><$voicel(1,10)>Awesome! Let’s do it!
msgctxt "2049:611"
msgid "<$emotion(1,50)><$voicel(1,10)>Pueees... ¡al turrón!"
msgstr "<$emotion(1,50)><$voicel(1,10)>Pueees... ¡a darle!"

#. en: <$comeff(1,3)><$facial(1,1)><$motion(1,807)><$voicel(1,3)>OK, no big deal. Let’s play some other time, then!
msgctxt "2049:612"
msgid "<$comeff(1,3)><$facial(1,1)><$motion(1,807)><$voicel(1,3)>Bueno, es lo que hay. ¡A ver si te animas a la próxima!"
msgstr ""

#. en: <$emotion(1,51)><$voicel(1,4)>No way... I lost?!
msgctxt "2049:617"
msgid "<$emotion(1,51)><$voicel(1,4)>No fastidies que ya he perdido..."
msgstr "<$emotion(1,51)><$voicel(1,4)>No me digas que ya perdí..."

#. en: <oneline><$emotion(1,37)><$voicel(1,7)>Ugh! How’d I lose?! You’re just too good at this,<br><$cdef(27)><pname;1></color>.<clear><br><$emotion(1,8)><$voicel(1,6)>Here’s a present for ya, bud!
msgctxt "2049:618"
msgid "<$emotion(1,37)><$voicel(1,7)>No puedo creer que me hayas ganado. ¡Eres la repera,<br><$cdef(27)><pname;1></color>! <$emotion(1,8)><$voicel(1,6)>¡Te has ganado un premio!"
msgstr "<$emotion(1,37)><$voicel(1,7)>No puedo creer que me hayas ganado. ¡Eres lo máximo,<br><$cdef(27)><pname;1></color>! <$emotion(1,8)><$voicel(1,6)>¡Te ganaste un premio!"

#. en: <$emotion(1,37)><$voicel(1,7)>Thanks for the game! I’m definitely gonna win next<br>time, though!
msgctxt "2049:619"
msgid "<$emotion(1,37)><$voicel(1,7)>Gracias por jugar conmigo. ¡La próxima vez, me toca<br>ganar a mí!"
msgstr ""

#. en: <oneline><$comeff(1,10)><$facial(1,1)><$motion(1,661)><$voicel(1,6)>Heh... Did I surprise ya, bud?<clear><br><$comeff(1,3)><$motion(1,666)><$voicel(1,7)>I secretly decided a while ago that I’d start callin’ you<br><$comeff(1,21)><$motion(1,806)><$voicel(1,9)><$cdef(27)><pname;2> </color>once we became closer<slide><br>friends!<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>So that’s what I’m callin’ you from now on!
msgctxt "2049:620"
msgid "<oneline><$comeff(1,10)><$facial(1,1)><$motion(1,661)><$voicel(1,6)>¡Ja, ja, ja! ¿Sorprendid<gen;-2(o,a)>?<clear><br><$comeff(1,3)><$motion(1,666)><$voicel(1,7)>Ya tenía decidido que, si nuestra amistad seguía p'alante,<br><$comeff(1,21)><$motion(1,806)><$voicel(1,9)>te llamaría por tu mote, como tiene que ser.<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>¡Espero que sigamos siempre igual de bien,<br><$cdef(27)><pname;2></color>!"
msgstr "<oneline><$comeff(1,10)><$facial(1,1)><$motion(1,661)><$voicel(1,6)>¡Ja, ja, ja! ¿Sorprendid<gen;-2(o,a)>?<clear><br><$comeff(1,3)><$motion(1,666)><$voicel(1,7)>Ya tenía decidido que, si nuestra amistad seguía p'alante,<br><$comeff(1,21)><$motion(1,806)><$voicel(1,9)>te llamaría por tu apodo, como tiene que ser.<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>¡Espero que sigamos siempre igual de bien,<br><$cdef(27)><pname;2></color>!"

#. en: <$emotion(1,38)><$voicel(1,9)>Good game, bud! Don’t expect me to go easy on ya next<br>time, either!
msgctxt "2049:622"
msgid "<$emotion(1,38)><$voicel(1,9)>Pues ha estado muy bien. ¡Y no creas que a la próxima<br>te lo pondré más fácil!"
msgstr "<$emotion(1,38)><$voicel(1,9)>Pues estuvo muy bien. ¡Y no creas que a la próxima<br>te lo pondré más fácil!"

#. en: <$emotion(1,38)><$voicel(1,10)>Whoo! Let’s do it!
msgctxt "2049:623"
msgid "<$emotion(1,38)><$voicel(1,10)>¡Ole! ¡Pues al turrón!"
msgstr "<$emotion(1,38)><$voicel(1,10)>¡Bien! ¡Pues a darle!"

#. en: <$emotion(1,37)><$voicel(1,7)>All right, bud. No worries. Let’s just hang some other time!
msgctxt "2049:624"
msgid "<$emotion(1,37)><$voicel(1,7)>Bueno, es lo que hay. ¡A ver si te animas a la próxima!"
msgstr ""

#. en: <$comeff(1,5)><$motion(1,803)><$voicel(1,7)>Huh? What gives? The <$cdef(27)><fqty(1)><$ifull(1325)> </color>suddenly stopped<br>working...<clear><br><$comeff(1,6)><$motion(1,666)><$voicel(1,5)>Uhhh... Looks like it might not be gettin’ any power.<br>Well, how do we fix that?
msgctxt "2049:667"
msgid "<$comeff(1,5)><$motion(1,803)><$voicel(1,7)>¿Y ahora por qué no tira la <$cdef(27)><fqty(1)><$ifull(1325)></color>?<br>¿Se habrá escacharrao?<clear><br><$motion(1,666)><$voicel(1,5)>Hmm... Cosa más rara, parece que no le llega corriente.<br><$comeff(1,6)>¿Y ahora qué?"
msgstr "<$comeff(1,5)><$motion(1,803)><$voicel(1,7)>¿Y ahora por qué no funciona la <$cdef(27)><fqty(1)><$ifull(1325)></color>?<br>¿Se habrá descompuesto?<clear><br><$motion(1,666)><$voicel(1,5)>Hmm... Cosa más rara, parece que no le llega corriente.<br><$comeff(1,6)>¿Y ahora qué?"

#. en: <oneline><$comeff(1,3)><$facial(1,4)><$motion(1,805)><$voicel(1,7)>Here are some of the<br><$cdef(27)><fqty(2)><class><reftarid;0></color><slide><br>you<slide><br>asked for!<clear><br><$comeff(1,10)><$motion(1,661)><$voicel(1,6)>I’m still workin’ on the rest, so just gimme a li’l more time<br>to finish up!
msgctxt "2049:670"
msgid "<oneline><$comeff(1,3)><$facial(1,4)><$motion(1,805)><$voicel(1,7)>Ahí llevas parte<br><esde;0()><$cdef(27)><fqty(2)><class><reftarid;0></color>.<clear><br>Aún estoy con el resto, así que, ya sabes: <$comeff(1,10)><$motion(1,661)><$voicel(1,6)>¡te toca esperar<br>un ratejo más!"
msgstr "<oneline><$comeff(1,3)><$facial(1,4)><$motion(1,805)><$voicel(1,7)>Ahí llevas parte<br><esde;0()><$cdef(27)><fqty(2)><class><reftarid;0></color>.<clear><br>Aún estoy con el resto, así que, ya sabes: <$comeff(1,10)><$motion(1,661)><$voicel(1,6)>¡te toca esperar<br>un ratito más!"

#. en: <$emotion(1,1)><$voicel(1,7)>Yeah, I think I know where <$cdef(27)><pksrchtar;0></color> is!<clear><br><$emotion(1,29)><$voicel(1,5)>Wanna fly over together and look for ’em?
msgctxt "2049:680"
msgid "<$emotion(1,1)><$voicel(1,7)>¡Sé dónde está! Te llevo volando hasta allí, si quieres.<br><$emotion(1,29)><$voicel(1,5)>¿Vamos?"
msgstr "<$emotion(1,1)><$voicel(1,7)>¡Sé dónde está! Te llevo volando hasta allá, si quieres.<br><$emotion(1,29)><$voicel(1,5)>¿Vamos?"

#. en: <oneline><$emotion(1,38)><$voicel(1,9)>Yeah, I think <$cdef(27)><pksrchtar;0></color>’s at home<br>right now!<clear><br><$emotion(1,29)><$voicel(1,5)>Want me to fly ya over there, bud?
msgctxt "2049:681"
msgid "<$emotion(1,38)><$voicel(1,9)>¡Me da que estaba en su casa! <$emotion(1,29)><$voicel(1,5)>¿Te llevo volando hasta allí?"
msgstr "<$emotion(1,38)><$voicel(1,9)>¡Me parece que estaba en su casa! <$emotion(1,29)><$voicel(1,5)>¿Te llevo volando hasta allá?"

#. en: <oneline><$emotion(1,17)><$voicel(1,3)>Sorry, bud. Haven’t seen <$cdef(27)><pksrchtar;0><br></color>today...<clear><br><$emotion(1,29)><$voicel(1,5)>Want me to fly ya over to their home, though?
msgctxt "2049:682"
msgid "<$emotion(1,17)><$voicel(1,3)>Hoy no nos hemos cruzado ni una sola vez, lo siento.<br><$emotion(1,29)><$voicel(1,5)>¿Te llevo volando a su casa a ver si está?"
msgstr "<$emotion(1,17)><$voicel(1,3)>Hoy no nos cruzamos ni una sola vez, lo siento.<br><$emotion(1,29)><$voicel(1,5)>¿Te llevo volando a su casa a ver si está?"

#. en: <oneline><$comeff(1,14)><$motion(1,805)><$voicel(1,5)>Hm... Don’t think I’ve seen <$cdef(27)><pksrchtar;0><br></color>around here...<clear><br><$emotion(1,37)><$voicel(1,8)>Maybe they live in a different area!
msgctxt "2049:683"
msgid "<$comeff(1,14)><$motion(1,805)><$voicel(1,5)>Aquí fijísimo que no está... <$emotion(1,37)><$voicel(1,8)>¡Lo mismo vive en otro sitio!"
msgstr "<$comeff(1,14)><$motion(1,805)><$voicel(1,5)>Aquí segurísimo que no está... <$emotion(1,37)><$voicel(1,8)>¡A lo mejor vive en otro lugar!"

#. en: <$comeff(1,3)><$facial(1,4)><$motion(1,806)><$voicel(1,6)>All riiight! Prepare for takeoff!
msgctxt "2049:684"
msgid "<$comeff(1,3)><$facial(1,4)><$motion(1,806)><$voicel(1,6)>¡Vale! ¡Agárrate fuerte, que despegamos!"
msgstr "<$comeff(1,3)><$facial(1,4)><$motion(1,806)><$voicel(1,6)>¡De acuerdo! ¡Agárrate fuerte, que despegamos!"

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,661)><$voicel(1,10)>We made it, bud! Lemme know if ya ever need me to fly<br>you someplace again!
msgctxt "2049:685"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,661)><$voicel(1,10)>¡Ya hemos llegao! Avísame cuando quieras volver a dar<br>un voltio por el cielo."
msgstr "<$comeff(1,10)><$facial(1,4)><$motion(1,661)><$voicel(1,10)>¡Ya llegamos! Avísame cuando quieras volver a dar<br>una vuelta por el cielo."

#. en: <oneline><$emotion(1,65)><$voicel(1,5)>We made it, but, uh...looks like<br><$cdef(27)><pksrchtar;0></color>’s<slide><br>not around.<clear><br><$emotion(1,29)><$voicel(1,8)>Maybe they’re out somewhere else doin’ stuff today?
msgctxt "2049:686"
msgid "<$emotion(1,65)><$voicel(1,5)>Pues aquí estamos... pero parece que no está.<br><$emotion(1,29)><$voicel(1,8)>¿Habrá salido a algún sitio?"
msgstr "<$emotion(1,65)><$voicel(1,5)>Pues aquí estamos... pero parece que no está.<br><$emotion(1,29)><$voicel(1,8)>¿Habrá salido a algún lado?"

#. en: <$comeff(1,10)><$facial(1,1)><$motion(1,661)><$voicel(1,6)>Gotcha! Well, I’m happy to help whenever you need me!
msgctxt "2049:687"
msgid "<$comeff(1,10)><$facial(1,1)><$motion(1,661)><$voicel(1,6)>Tú mism<gen;-2(o,a)>. Si luego quieres, me avisas."
msgstr "<$comeff(1,10)><$facial(1,1)><$motion(1,661)><$voicel(1,6)>Tranquil<gen;-2(o,a)>. Si luego quieres, me avisas."

#. en: <$emotion(1,1)><$voicel(1,7)>Yeah, I think I know where <$cdef(27)><pksrchtar;0></color> is!<clear><br><$emotion(1,29)><$voicel(1,5)>Want me to <$cdef(27)><$spwfull(35)></color> ya over there, bud?
msgctxt "2049:688"
msgid "<$emotion(1,1)><$cdef(27)><$voicel(1,7)></color>¡Creo que sé dónde está! Podría <$cdef(27)>teletransportarnos</color><nbs2><$spwicon(35)> allí<br>sin problema. <$emotion(1,29)><$voicel(1,5)>¿Quieres?"
msgstr "<$emotion(1,1)><$cdef(27)><$voicel(1,7)></color>¡Creo que sé dónde está! Podría <$cdef(27)>teletransportarnos</color><nbs2><$spwicon(35)> allá<br>sin problema. <$emotion(1,29)><$voicel(1,5)>¿Quieres?"

#. en: <oneline><$emotion(1,38)><$voicel(1,9)>Yeah, I think <$cdef(27)><pksrchtar;0></color>’s at home<br>right now!<clear><br><$emotion(1,29)><$voicel(1,5)>Want me to <$cdef(27)><$spwfull(35)></color> ya over there, bud?
msgctxt "2049:689"
msgid "<$emotion(1,38)><$voicel(1,9)>¡Creo recordar que estaba en su casa! Esto con un<br><$cdef(27)>teletransporte</color><nbs2><$spwicon(35)> se soluciona fácil. <$emotion(1,29)><$voicel(1,5)>¿Te llevo?"
msgstr ""

#. en: <oneline><$emotion(1,17)><$voicel(1,3)>Sorry, bud. Haven’t seen <$cdef(27)><pksrchtar;0><br></color>today...<clear><br><$emotion(1,29)><$voicel(1,5)>Want me to <$cdef(27)><$spwfull(35)> </color>ya over to their home, though?
msgctxt "2049:690"
msgid "<$emotion(1,17)><$voicel(1,3)>Pues ni idea... Hoy no ha aparecido por aquí, lo siento.<br><$emotion(1,29)><$cdef(27)><$voicel(1,5)></color>¿Te <$cdef(27)>teletransporto<nbs2><$spwicon(35)></color> a su casa a ver si está?"
msgstr "<$emotion(1,17)><$voicel(1,3)>Pues ni idea... Hoy no apareció por aquí, lo siento.<br><$emotion(1,29)><$cdef(27)><$voicel(1,5)></color>¿Te <$cdef(27)>teletransporto<nbs2><$spwicon(35)></color> a su casa a ver si está?"

#. en: <oneline><$emotion(1,64)><$voicel(1,5)>Hm... Don’t think I’ve seen <$cdef(27)><pksrchtar;0><br></color>around here...<clear><br><$emotion(1,37)><$voicel(1,8)>Maybe they live in a different area!
msgctxt "2049:691"
msgid "<$emotion(1,64)><$voicel(1,5)>Aquí segurísimo que no está. <$emotion(1,37)><$voicel(1,8)>¡Lo mismo vive en otro lado!"
msgstr "<$emotion(1,64)><$voicel(1,5)>Aquí segurísimo que no está. <$emotion(1,37)><$voicel(1,8)>¡A lo mejor vive en otro lado!"

#. en: <$comeff(1,3)><$facial(1,4)><$motion(1,806)><$voicel(1,10)>All riiight! Off we go!
msgctxt "2049:692"
msgid "<$comeff(1,3)><$facial(1,4)><$motion(1,806)><$voicel(1,10)>¡Vale! ¡Agárrate fuerte que allá vamooos!"
msgstr "<$comeff(1,3)><$facial(1,4)><$motion(1,806)><$voicel(1,10)>¡De acuerdo! ¡Agárrate fuerte que allá vamooos!"

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,661)><$voicel(1,10)>We made it, bud! Lemme know if ya ever need me to<br><$cdef(27)><$spwfull(35)> </color>you someplace again!
msgctxt "2049:693"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,661)><$voicel(1,10)>¡Ya hemos llegao! Avísame si quieres <$cdef(27)>teletransportarte</color><nbs2><$spwicon(35)><br>a otro sitio."
msgstr "<$comeff(1,10)><$facial(1,4)><$motion(1,661)><$voicel(1,10)>¡Ya llegamos! Avísame si quieres <$cdef(27)>teletransportarte</color><nbs2><$spwicon(35)><br>a otro lugar."

#. en: <oneline><$emotion(1,65)><$voicel(1,5)>We made it, but, uh...looks like<br><$cdef(27)><pksrchtar;0></color>’s<slide><br>not around.<clear><br><$emotion(1,29)><$voicel(1,8)>Maybe they’re out somewhere else doin’ stuff today?
msgctxt "2049:694"
msgid "<$emotion(1,65)><$voicel(1,5)>Hemos llegao, aunqueee... parece que no está aquí.<br><$emotion(1,29)><$voicel(1,8)>¿Habrá salido a algún sitio?"
msgstr "<$emotion(1,65)><$voicel(1,5)>Llegamos, aunqueee... parece que no está aquí.<br><$emotion(1,29)><$voicel(1,8)>¿Habrá salido a algún lado?"

#. en: <$comeff(1,10)><$facial(1,1)><$motion(1,661)><$voicel(1,6)>Gotcha! Well, I’m happy to help whenever you need me!
msgctxt "2049:695"
msgid "<$comeff(1,10)><$facial(1,1)><$motion(1,661)><$voicel(1,6)>Tú mism<gen;-2(o,a)>. Si me necesitas, dame un toque."
msgstr "<$comeff(1,10)><$facial(1,1)><$motion(1,661)><$voicel(1,6)>Tranquil<gen;-2(o,a)>. Si me necesitas, avísame."

#. en: <oneline><$emotion(1,37)><$voicel(1,9)>You lookin’ for <$cdef(27)><pksrchtar;0></color>? They might<br>be<slide><br>over<slide><br>that<slide><br>way, bud.
msgctxt "2049:696"
msgid "<$emotion(1,37)><$voicel(1,9)>¿<fcap><dart;0()><$cdef(27)><pksrchtar;0></color>? ¿No estará por ahí?"
msgstr ""

#. en: <oneline><$emotion(1,37)><$voicel(1,9)>I think <$cdef(27)><pksrchtar;0></color>’s probably at home<br>right now!
msgctxt "2049:697"
msgid "<oneline><$emotion(1,37)><$voicel(1,9)>¡Me parece que <dart;0()><$cdef(27)><pksrchtar;0></color> estaba<br>en casa!"
msgstr ""

#. en: <oneline><$emotion(1,65)><$voicel(1,3)>Sorry, bud. Haven’t seen <$cdef(27)><pksrchtar;0><br></color>today...
msgctxt "2049:698"
msgid "<$emotion(1,65)><$voicel(1,3)>Naaah, hoy ni idea de por dónde anda."
msgstr ""

#. en: <oneline><$emotion(1,64)><$voicel(1,5)>Hm... Don’t think I’ve seen <$cdef(27)><pksrchtar;0><br></color>around here...<clear><br><$emotion(1,37)><$voicel(1,8)>Maybe they live in a different area!
msgctxt "2049:699"
msgid "<$emotion(1,64)><$voicel(1,5)>Ni rastro por ninguna parte... <$emotion(1,37)><$voicel(1,8)>Lo mismo vive en otro sitio."
msgstr "<$emotion(1,64)><$voicel(1,5)>Ni rastro por ninguna parte... <$emotion(1,37)><$voicel(1,8)>A lo mejor vive en otro lugar."

#. en: <oneline><$comeff(1,6)><$facial(1,1)><$motion(1,805)><$voicel(1,6)>Hey heyyy, <$cdef(27)><pname;0></color>! What’s up, bud?<br>Oh,<slide><br>you<slide><br>lookin’<slide><br>for someone?
msgctxt "2049:700"
msgid "<$comeff(1,6)><$facial(1,1)><$motion(1,805)><$voicel(1,6)>¿Qué pasa, <$cdef(27)><pname;0></color>? ¿Buscas a alguien?"
msgstr ""

#. en: <$comeff(1,10)><$facial(1,1)><$motion(1,803)><$voicel(1,8)>No? My bad! Seemed like you were!
msgctxt "2049:701"
msgid "<$comeff(1,10)><$facial(1,1)><$motion(1,803)><$voicel(1,8)>Vaya, perdona. Me había dado la impresión."
msgstr ""

#. en: <oneline><$comeff(1,7)><$facial(1,9)><$motion(1,803)><$voicel(1,5)><$voicel(1,5)>Sorry, bud. Can’t say I know where<br><$cdef(27)><pksrchtar;0></color><slide><br>is<slide><br>right now.
msgctxt "2049:702"
msgid "<$cdef(27)><$comeff(1,7)></color><$facial(1,9)><$motion(1,803)><$voicel(1,5)><$voicel(1,5)>Pos la verdad, no tengo ni idea de por dónde anda...<br>Perdona, tronc<gen;-2(o,a)>."
msgstr "<$cdef(27)><$comeff(1,7)></color><$facial(1,9)><$motion(1,803)><$voicel(1,5)><$voicel(1,5)>Pos la verdad, no tengo ni idea de por dónde anda...<br>Perdona, amig<gen;-2(o,a)>."

#. en: <$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,3)>My comfort level? Uhhh... <$cdef(27)><$stflevel;0(1)></color>, I guess.
msgctxt "2049:750"
msgid "<$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,3)>Buah, ¿cómo te diría? Es... <wait(1.0)>¿<$cdef(27)><$stflevel;0(1)></color>?"
msgstr "<$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,3)>Uf, ¿cómo te diría? Es... <wait(1.0)>¿<$cdef(27)><$stflevel;0(1)></color>?"

#. en: <$emotion(1,14)><$voicel(1,3)>My comfort level? Let’s see... I’m thinkin’ <$cdef(27)><flow><$stflevel;0(2)></color>.
msgctxt "2049:751"
msgid "<$emotion(1,14)><$voicel(1,3)>Pues... <wait(1.0)>es <$cdef(27)><$stflevel;0(2)></color>, tronc<gen;-2(o,a)>."
msgstr "<$emotion(1,14)><$voicel(1,3)>Pues... <wait(1.0)>es <$cdef(27)><$stflevel;0(2)></color>, amig<gen;-2(o,a)>."

#. en: <$voicel(1,5)><$comeff(1,9)><$facial(1,1)><$motion(1,661)>My comfort level? <$cdef(27)><$stflevel;0(3)> </color>for sure, bud.
msgctxt "2049:752"
msgid "<$voicel(1,5)><$comeff(1,9)><$facial(1,1)><$motion(1,661)>Pues ahora mismo es <$cdef(27)><$stflevel;0(3)></color>, hacha."
msgstr "<$voicel(1,5)><$comeff(1,9)><$facial(1,1)><$motion(1,661)>Pues ahora mismo es <$cdef(27)><$stflevel;0(3)></color>, sin duda."

#. en: <$emotion(1,8)><$comeff(1,21)><$facial(1,4)><$motion(1,661)>My comfort level? <$cdef(27)><$stflevel;0(4)></color>, bud!
msgctxt "2049:753"
msgid "<$emotion(1,8)><$comeff(1,21)><$facial(1,4)><$motion(1,661)>Buah, ¡ahora mismo es <$cdef(27)><$stflevel;0(4)></color>!"
msgstr "<$emotion(1,8)><$comeff(1,21)><$facial(1,4)><$motion(1,661)>Guau, ¡ahora mismo es <$cdef(27)><$stflevel;0(4)></color>!"

#. en: <oneline><$comeff(1,8)><$facial(1,5)><$motion(1,661)><$voicel(1,7)>My comfort level? Absolutely <$cdef(27)><flow><$stflevel;0(5)></color>, bud! <$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>I’m so<br>happy<slide><br>I<slide><br>get<slide><br>to<slide><br>live here!
msgctxt "2049:754"
msgid "<$comeff(1,8)><$facial(1,5)><$motion(1,661)><$voicel(1,7)>¿Que si estoy a gusto? <wait(1.0)>¡Es todo <$cdef(27)><$stflevel;0(5)></color>!<br><$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>¡Me alegro una barbaridad de haberme mudado!"
msgstr ""

#. en: <$emotion(1,50)><$voicel(1,8)>Things’re better than they were, bud!
msgctxt "2049:756"
msgid "<$emotion(1,50)><$voicel(1,8)>Mejor que antes se está, desde luego."
msgstr ""

#. en: <$emotion(1,8)><$voicel(1,9)>Things’re a lot better now thanks to you, bud!
msgctxt "2049:757"
msgid "<$emotion(1,8)><$voicel(1,9)>Mucho mejor ahora, dónde va a parar. ¡Gracias, niñ<gen;-2(o,a)>!"
msgstr "<$emotion(1,8)><$voicel(1,9)>Mucho mejor ahora, sin duda. ¡Gracias, amig<gen;-2(o,a)>!"

#. en: <oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,7)>Huh... This <$cdef(27)><fqty(1)><class><aireactp;0><br></color>seems<slide><br>a li’l<slide><br>too<slide><br>small<slide><br>for<slide><br>me, bud!<clear><br><$emotion(1,29)><$voicel(1,6)>Wouldn’t happen to have something slightly bigger,<br>would ya?
msgctxt "2049:758"
msgid "<oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,7)>Hmm... Lo mismo <qty;0(es,son)> un poco pequeñ<genqty;0(o,a,os,as)>,<br>est<genqty;0(e,a,os,as)> <$cdef(27)><fqty(1)><aireactp;0></color>.<slide><br><$emotion(1,29)><$voicel(1,6)>¿No había algo más grande?"
msgstr "<oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,7)>Hmm... A lo mejor <qty;0(es,son)> un poco pequeñ<genqty;0(o,a,os,as)>,<br>est<genqty;0(e,a,os,as)> <$cdef(27)><fqty(1)><aireactp;0></color>.<slide><br><$emotion(1,29)><$voicel(1,6)>¿No había algo más grande?"

#. en: <oneline><$emotion(1,8)><$voicel(1,9)>Thanks for the<br><$cdef(27)><fqty(1)><class><aireactp;0></color>, bud!
msgctxt "2049:761"
msgid "<oneline><$emotion(1,8)><$voicel(1,9)>¡Gracias por colocarme <genqty;0(ese,esa,esos,esas)><br><$cdef(27)><fqty(1)><aireactp;0></color>!"
msgstr ""

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>My comfort level, huh? Can’t say for sure without goin’<br>back to my pad real quick, but uh...<clear><br><$comeff(1,7)><$motion(1,802)><$voicel(1,4)>I think things were <$cdef(27)><flow><$stflevel;0(1)></color>.
msgctxt "2049:762"
msgid "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>No te lo puedo asegurar hasta que vuelva,<$comeff(1,7)><$motion(1,802)><$voicel(1,4)> pero me da<br>que era <$cdef(27)><$stflevel;0(1)></color>."
msgstr "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>No te lo puedo asegurar hasta que vuelva,<$comeff(1,7)><$motion(1,802)><$voicel(1,4)> pero creo<br>que era <$cdef(27)><$stflevel;0(1)></color>."

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>My comfort level, huh? Can’t say for sure without goin’<br>back to my pad real quick, but, uh...<clear><br><$comeff(1,3)><$motion(1,803)><$voicel(1,6)>I think it was <$cdef(27)><flow><$stflevel;0(2)></color>.
msgctxt "2049:763"
msgid "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>¿En mi casa? A ver que me lo piense... <wait(1.0)><$comeff(1,3)><$motion(1,803)><$voicel(1,6)>Casi seguro que<br>es <$cdef(27)><$stflevel;0(2)></color>."
msgstr ""

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>My comfort level, huh? Can’t say for sure without goin’<br>back to my pad real quick, but, uh...<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,8)>I think things were <$cdef(27)><flow><$stflevel;0(3)></color>!
msgctxt "2049:764"
msgid "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Pues así lejos de casa... Espérate, que la visualizo...<wait(1.0)><$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,8)><br>Buah, ¡es <$cdef(27)><$stflevel;0(3)></color>!"
msgstr "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Pues así lejos de casa... Espérate, que la visualizo...<wait(1.0)><$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,8)><br>Guau, ¡es <$cdef(27)><$stflevel;0(3)></color>!"

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>My comfort level, huh? Can’t say for sure without goin’<br>back to my pad real quick, but, uh...<clear><br><$comeff(1,21)><$motion(1,801)><$voicel(1,10)>Pretty sure things were <$cdef(27)><flow><$stflevel;0(4)></color>!
msgctxt "2049:765"
msgid "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Ando lejillos de casa como pa recordarlo bien, peeero...<br><wait(1.0)><$comeff(1,21)><$motion(1,801)><$voicel(1,10)>¡pa mí que era <$cdef(27)><$stflevel;0(4)></color>!"
msgstr "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Ando lejitos de casa como pa recordarlo bien, peeero...<br><wait(1.0)><$comeff(1,21)><$motion(1,801)><$voicel(1,10)>¡pa mí que era <$cdef(27)><$stflevel;0(4)></color>!"

#. en: <oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>My comfort level, huh? Can’t say for sure without goin’<br>back to my pad real quick, but, uh...<clear><br><$comeff(1,8)><$motion(1,801)><$voicel(1,9)>No, wait... Things were DEFINITELY <$cdef(27)><flow><$stflevel;0(5)></color>! Just<br>livin’<slide><br>in<slide><br>that<slide><br>pad<slide><br>of<slide><br>mine<slide><br>gets<slide><br>me<slide><br>excited<slide><br>about life!
msgctxt "2049:766"
msgid "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Qué complicado eso sin estar en casa, me lo voy a pensar<br>fuerte... <wait(1.0)><$comeff(1,8)><$motion(1,801)><$voicel(1,9)>¡Anda, que es broma! ¡Me acuerdo perfectamente!<slide><br>Es <$cdef(27)><$stflevel;0(5)></color>. ¡Menudo gustazo vivir en ella!"
msgstr "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Qué complicado eso sin estar en casa, me lo voy a pensar<br>fuerte... <wait(1.0)><$comeff(1,8)><$motion(1,801)><$voicel(1,9)>¡Nah, es broma! ¡Me acuerdo perfectamente!<slide><br>Es <$cdef(27)><$stflevel;0(5)></color>. ¡Qué gustazo vivir en ella!"

#. en: <$comeff(1,9)><$facial(1,1)><$motion(1,806)><$voicel(1,8)>I’m thinkin’ things are better than before!
msgctxt "2049:767"
msgid "<$comeff(1,9)><$facial(1,1)><$motion(1,806)><$voicel(1,8)>¡Tengo la sensación de que se está mejor que antes!"
msgstr ""

#. en: <$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>I’m thinkin’ things are a lot better than before! Thanks for<br>everything ya do, bud!
msgctxt "2049:768"
msgid "<$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Se está mucho mejor que antes! ¡Muchas gracias!"
msgstr ""

#. en: <$comeff(1,3)><$facial(1,4)><$motion(1,806)><$voicel(1,10)>My home’s over this way! Lemme show ya!
msgctxt "2049:769"
msgid "<$comeff(1,3)><$facial(1,4)><$motion(1,806)><$voicel(1,10)>Por aquí se va a mi casa. ¡Ven, que te llevo!"
msgstr ""

#. en: <$comeff(1,3)><$motion(1,803)><$facial(1,1)><$voicel(1,4)>My home’s over that way, bud! I’d love to show ya the<br>way, <$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,1)>but I’ve got some things I gotta get done right now!
msgctxt "2049:770"
msgid "<$comeff(1,3)><$motion(1,803)><$facial(1,1)><$voicel(1,4)>Por allí se va a mi casa. Me gustaría acompañarte, pero<br><$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,1)>tengo cuarenta cosas que hacer ahora mismo. Lo siento."
msgstr "<$comeff(1,3)><$motion(1,803)><$facial(1,1)><$voicel(1,4)>Por allá se va a mi casa. Me gustaría acompañarte, pero<br><$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,1)>tengo cuarenta cosas que hacer ahora mismo. Lo siento."

#. en: <$comeff(1,5)><$facial(1,4)><$motion(1,806)><$voicel(1,8)>Seriously?! Awesome, bud! Thanks a ton!
msgctxt "2049:771"
msgid "<$comeff(1,5)><$facial(1,4)><$motion(1,806)><$voicel(1,8)>Anda, ¿en serio? ¡Gracias, <$cdef(27)><pname;0></color>!"
msgstr "<$comeff(1,5)><$facial(1,4)><$motion(1,806)><$voicel(1,8)>Vaya, ¿en serio? ¡Gracias, <$cdef(27)><pname;0></color>!"

#. en: <oneline><$emotion(1,8)><$voicel(1,9)>You set up<br><iart;0()><$cdef(27)><fqty(1)><class><stfrevp;0></color><slide><$cdef(27)><br></color>outside<slide><br>for me?<slide><br>Cool!<slide><br>Thanks, bud!
msgctxt "2049:772"
msgid "<oneline><$emotion(1,8)><$voicel(1,9)>¿Me has dejado fuera<br><dart;0()><$cdef(27)><fqty(1)><class><stfrevp;0></color>?<slide><br>¡Gracias, tronc<gen;-3(o,a)>!"
msgstr "<oneline><$emotion(1,8)><$voicel(1,9)>¿Me dejaste afuera<br><dart;0()><$cdef(27)><fqty(1)><class><stfrevp;0></color>?<slide><br>¡Gracias, amig<gen;-3(o,a)>!"

#. en: <$comeff(1,6)><$motion(1,666)><$voicel(1,5)>My comfort level? Well, I just moved in, y’know... <$comeff(1,7)><$motion(1,802)><$voicel(1,4)>So I’m<br>not really sure yet.<clear><br><$comeff(1,3)><$motion(1,803)><$voicel(1,8)>Ask me again later, bud!
msgctxt "2049:773"
msgid "<$motion(1,666)><$voicel(1,5)>Amig<gen;-2(o,a)>, acabo de instalarme, así que... <wait(1.0)><$comeff(1,6)>¿quién sabe?<clear><br><$comeff(1,7)><$motion(1,802)><$voicel(1,4)>Estas cosas llevan su tiempo... <wait(1.0)><$comeff(1,3)><$motion(1,803)><$voicel(1,8)>¡Vuelve a preguntarme más<br>adelante y ya te diré!"
msgstr ""

#. en: <oneline><$comeff(1,14)><$facial(1,9)><$motion(1,805)><$voicel(1,5)>Oof. I wanna be happy about this, but I gotta tell it to ya<br>straight, <$cdef(27)><pname;0></color>...<clear><br><$emotion(1,41)><$voicel(1,3)>I’m not a big fan of stuff like that<br><$cdef(27)><fqty(1)><class><stfrevp;1></color>...<clear><br><$comeff(1,6)><$facial(1,1)><$motion(1,803)><$voicel(1,6)>Could I get somethin’ else instead, bud?
msgctxt "2049:774"
msgid "<$comeff(1,14)><$facial(1,9)><$motion(1,805)><$voicel(1,5)>Ah... Uf, me sabe fatal, <$cdef(27)><pname;0></color>, pero...<clear><br><$emotion(1,41)><$voicel(1,3)>Hablando en plata, no es que me pirre precisamente por<br><dart;1()><$cdef(27)><fqty(2)><class><stfrevp;1></color>...<clear><br><$comeff(1,6)><$facial(1,1)><$motion(1,803)><$voicel(1,6)>Dar pa na es tontería. ¿Sería mucho rollo cambiarl<genqty;1(o,a,os,as)> por<br>otra cosa?"
msgstr "<$comeff(1,14)><$facial(1,9)><$motion(1,805)><$voicel(1,5)>Ah... Uf, me da mucha pena, <$cdef(27)><pname;0></color>, pero...<clear><br><$emotion(1,41)><$voicel(1,3)>Hablando claro, no es que me muera precisamente por<br><dart;1()><$cdef(27)><fqty(2)><class><stfrevp;1></color>...<clear><br><$comeff(1,6)><$facial(1,1)><$motion(1,803)><$voicel(1,6)>No vale la pena darle vueltas. ¿Sería mucha molestia<br>cambiarl<genqty;1(o,a,os,as)> por otra cosa?"

#. en: <oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,7)>Huh... That <$cdef(27)><fqty(1)><class><stfrevp;0><br></color>seems<slide><br>a li’l<slide><br>too<slide><br>small<slide><br>for<slide><br>me, bud!<clear><br><$emotion(1,29)><$voicel(1,6)>Wouldn’t happen to have something slightly bigger,<br>would ya?
msgctxt "2049:775"
msgid "<oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,7)>No sé tú, tronc<gen;-2(o,a)>, pero a mí me da que<br><iart;0()><fqty(1)><class><$cdef(27)><stfrevp;0></color><slide><br><qty;0(es,son)> algo<slide><br>renacuaj<genqty;0(o,a,os,as)>.<clear><br><$emotion(1,29)><$voicel(1,6)>Si se pudies<qty;0(e,en)> cambiar por otra cosa más tocha, ¡sería un<br>puntazo!"
msgstr "<oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,7)>No sé tú, amig<gen;-2(o,a)>, pero a mí me parece que<br><iart;0()><fqty(1)><class><$cdef(27)><stfrevp;0></color><slide><br><qty;0(es,son)> algo<slide><br>renacuaj<genqty;0(o,a,os,as)>.<clear><br><$emotion(1,29)><$voicel(1,6)>Si se pudies<qty;0(e,en)> cambiar por otra cosa más grande, ¡sería lo<br>máximo!"

#. en: <$comeff(1,3)><$motion(1,666)><$voicel(1,9)>You’re always pickin’ up all sorts of stuff, aren’t ya, bud?<clear><br><$emotion(1,37)><$voicel(1,9)>Keep it up, and ya just might pick up every last li’l rock<br>around here!
msgctxt "2049:801"
msgid "<$comeff(1,3)><$motion(1,666)><$voicel(1,9)>No paras de recoger cosas, ¿eh? <$emotion(1,37)><$voicel(1,9)>A este paso, no van a<br>quedar ni piedras en el suelo."
msgstr ""

#. en: <$emotion(1,14)><$voicel(1,7)>Hey, heyyy! Workin’ that daily grind, huh, bud?<clear><br><$emotion(1,38)><$voicel(1,9)>You keepin’ real busy? Come see me sometime when<br>you’re takin’ a li’l break or whatever!
msgctxt "2049:802"
msgid "<$emotion(1,14)><$voicel(1,7)>¡Epa! ¡Otra vez por aquí, como cada día!<clear><br><$emotion(1,38)><$voicel(1,9)>¿Tienes mucho lío o qué? Si tienes un rato libre, vente<br>pa mi casa y pasamos el rato."
msgstr ""

#. en: <oneline><$comeff(1,3)><$voicel(1,5)>Hey heyyy, <$cdef(27)><pname;0></color>! Check out the<br><$cdef(27)><asnbname;1></color>!<slide><br><$emotion(1,29)><$voicel(1,8)>Pretty<slide><br>dang<slide><br>awesome<slide><br>job, huh?!<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,9)>Well, of COURSE it’s awesome. I helped ’em <$cdef(27)><$spwfull(1)></color><$cdef(27)><br></color>it myself! ♪
msgctxt "2049:803"
msgid "<oneline><$comeff(1,3)><$voicel(1,5)>¡Fíjate, <$cdef(27)><pname;0></color>! ¿Qué te parec<qty;1(e,en)><br><dart;1()><$cdef(27)><asnbname;1></color>?<clear><br><$emotion(1,29)><$voicel(1,8)>¿Est<qty;1(á,án)> bien hech<genqty;1(o,a,os,as)> o est<qty;1(á,án)> bien hech<genqty;1(o,a,os,as)>?<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,9)>¡Pues claro! ¡Como que yo mism<gen;-3(o,a)> he echado una mano<br>en su <$cdef(27)>construcción</color><nbs2><$spwicon(1)>!"
msgstr "<oneline><$comeff(1,3)><$voicel(1,5)>¡Fíjate, <$cdef(27)><pname;0></color>! ¿Qué te parec<qty;1(e,en)><br><dart;1()><$cdef(27)><asnbname;1></color>?<clear><br><$emotion(1,29)><$voicel(1,8)>¿Est<qty;1(á,án)> bien hech<genqty;1(o,a,os,as)> o est<qty;1(á,án)> bien hech<genqty;1(o,a,os,as)>?<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,9)>¡Pues claro! ¡Como que yo mism<gen;-3(o,a)> eché una mano<br>en su <$cdef(27)>construcción</color><nbs2><$spwicon(1)>!"

#. en: <oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Hey, bud. That <$cdef(27)><rctbname;0><br></color>is<slide><br>really<slide><br>well<slide><br>built, huh...<clear><br><$emotion(1,37)><$voicel(1,9)>Mrgh! I REALLY wanna <$cdef(27)><$spwfull(1)></color><$cdef(27)> </color>somethin’ like that myself!
msgctxt "2049:804"
msgid "<oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,5)><fcap><dart;0()><$cdef(27)><rctbname;0></color> est<qty;0(á,án)><br>muy bien hech<genqty;0(o,a,os,as)>.<slide><br>Menudo currazo os pegasteis...<clear><br><$emotion(1,37)><$voicel(1,9)>¡Aaah! ¡Yo también quiero <$cdef(27)><$spwfull(1)></color> algo así!"
msgstr "<oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,5)><fcap><dart;0()><$cdef(27)><rctbname;0></color> est<qty;0(á,án)><br>muy bien hech<genqty;0(o,a,os,as)>.<slide><br>Qué trabajazo hicieron...<clear><br><$emotion(1,37)><$voicel(1,9)>¡Aaah! ¡Yo también quiero <$cdef(27)><$spwfull(1)></color> algo así!"

#. en: <oneline><$emotion(1,29)><$voicel(1,7)>Whaddya think <$cdef(27)><acqpname;0></color>’s up to<br>these days?<clear><br><$emotion(1,38)><$voicel(1,9)>I had a really good time playin’ with ’em. Hope we can do<br>it again sometime!
msgctxt "2049:805"
msgid "<$emotion(1,29)><$voicel(1,7)>¿Qué será de <$cdef(27)><acqpname;0></color>?<clear><br><$emotion(1,38)><$voicel(1,9)>Espero que le vaya bien. ¡Lo pasamos muy bien jugando!"
msgstr "<$emotion(1,29)><$voicel(1,7)>¿Qué será de <$cdef(27)><acqpname;0></color>?<clear><br><$emotion(1,38)><$voicel(1,9)>Espero que le vaya bien. ¡La pasamos muy bien jugando!"

#. en: <$emotion(1,14)><$voicel(1,7)>Whoa! Hey, bud... What’s this new look?!<clear><br><$emotion(1,38)><$voicel(1,9)>Almost didn’t recognize ya! Sure looks good on ya, though!
msgctxt "2049:806"
msgid "<$emotion(1,14)><$voicel(1,7)>¡Eh! ¡Estás diferente, <$cdef(27)><pname;0></color>!<clear><br><$emotion(1,38)><$voicel(1,9)>Casi no te había reconocido... pero te queda de lujo.<br>¡Qué suerte tienen algun<gen;-2(os,as)>!"
msgstr "<$emotion(1,14)><$voicel(1,7)>¡Eh! ¡Estás diferente, <$cdef(27)><pname;0></color>!<clear><br><$emotion(1,38)><$voicel(1,9)>Casi no te reconocí... pero te queda de lujo.<br>¡Qué suerte tienen algun<gen;-2(os,as)>!"

#. en: <$emotion(1,29)><$voicel(1,7)>Hm... Did you change somethin’ about your appearance?<clear><br><$comeff(1,14)><$motion(1,827)><$voicel(1,5)>Somethin’ seems slightly different about ya, bud.<clear><br><$voicel(1,7)><$facial(1,9)>No idea WHAT changed, though—just a feelin’ I’m gettin’<br>for some reason!
msgctxt "2049:807"
msgid "<$emotion(1,29)><$voicel(1,7)>Eh, oye, te has cambiado algo, ¿verdad?<clear><br><$comeff(1,14)><$motion(1,827)><$voicel(1,5)>Hmm, sí, te veo diferente... A mí no me engañas...<br><$voicel(1,7)><$facial(1,9)>Algo hay, pero no sabría decirte el qué."
msgstr "<$emotion(1,29)><$voicel(1,7)>Eh, oye, te cambiaste algo, ¿verdad?<clear><br><$comeff(1,14)><$motion(1,827)><$voicel(1,5)>Hmm, sí, te veo diferente... A mí no me engañas...<br><$voicel(1,7)><$facial(1,9)>Algo hay, pero no sabría decirte el qué."

#. en: <$emotion(1,14)><$voicel(1,9)>Every day’s an adventure ever since you and I became<br>friends, <$cdef(27)><pname;0></color>!<clear><br><$voicel(1,6)>I don’t think anybody would believe you’re the<br>adventurous type <$emotion(1,38)><$voicel(1,8)>just from lookin’ at ya, though!<clear><br><$comeff(1,9)><$facial(1,1)><$motion(1,806)><$voicel(1,9)>Anyway, hope we can keep on adventurin’ together, bud!
msgctxt "2049:808"
msgid "<$emotion(1,14)><$voicel(1,9)>¡Cada día es una fiesta contigo, <$cdef(27)><pname;0></color>!<clear><br><$voicel(1,6)>Con esa cara simple tuya, <$emotion(1,38)><$voicel(1,8)>¡quién habría imaginado<br>que serías la alegría de la huerta!<clear><br><$comeff(1,9)><$facial(1,1)><$motion(1,806)><$voicel(1,9)>En fin, que ojalá nuestra amistad dure mucho tiempo."
msgstr "<$emotion(1,14)><$voicel(1,9)>¡Cada día es una fiesta contigo, <$cdef(27)><pname;0></color>!<clear><br><$voicel(1,6)>Con esa cara simple tuya, <$emotion(1,38)><$voicel(1,8)>¡quién habría imaginado<br>que serías el alma de la fiesta!<clear><br><$comeff(1,9)><$facial(1,1)><$motion(1,806)><$voicel(1,9)>En fin, que ojalá nuestra amistad dure mucho tiempo."

#. en: <$emotion(1,14)><$voicel(1,7)>I saw <$cdef(27)>Professor Tangrowth </color>trip over the tiniest li’l rock the<br>other day...<clear><br><$comeff(1,14)><$voicel(1,5)>I mean, I get it. With all those vines hangin’ off ’em, it’s<br>probably hard for the professor to see where they’re<slide><br>walkin’...<clear><br><$comeff(1,17)><$motion(1,807)><$voicel(1,4)>But I still worry about ’em, y’know!
msgctxt "2049:809"
msgid "<$emotion(1,14)><$voicel(1,7)>He visto al <$cdef(27)>Profesor Tangrowth</color> tropezarse con una<br>piedrecita y pegarse un trompazo de narices.<clear><br><$comeff(1,14)><$voicel(1,5)>Con tanta liana, normal que no se vea ni los pies.<br><$comeff(1,17)><$motion(1,807)><$voicel(1,4)>A veces me preocupa un poco..."
msgstr "<$emotion(1,14)><$voicel(1,7)>Vi al <$cdef(27)>Profesor Tangrowth</color> tropezarse con una<br>piedrita y darse un golpazo tremendo.<clear><br><$comeff(1,14)><$voicel(1,5)>Con tanta liana, normal que no se vea ni los pies.<br><$comeff(1,17)><$motion(1,807)><$voicel(1,4)>A veces me preocupa un poco..."

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,8)>Y’know, I never thought bein’ roomies with you would be<br>so much fun, <$cdef(27)><pname;0></color>!<clear><br><$comeff(1,21)><$motion(1,801)><$voicel(1,9)>I’m the luckiest Pokémon there is! I hope these fun times<br>never end!
msgctxt "2049:810"
msgid "<oneline><$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,8)>Esto de vivir contigo es aún mejor de lo que imaginaba,<br>amig<gen;-2(o,a)> mí<gen;-2(o,a)>. <$comeff(1,21)><$motion(1,801)><$voicel(1,9)>¡Estoy supercontent<gen;-3(o,a)>! ¡Y que dure!"
msgstr ""

#. en: <$comeff(1,7)><$facial(1,1)><$motion(1,663)><$voicel(1,3)>Owww... Oof...<clear><br><$comeff(1,3)><$motion(1,803)><$voicel(1,6)>I, uh...trained a li’l too hard yesterday, and now I’m all<br>achy. <$comeff(1,17)><$motion(1,805)><$voicel(1,1)>Turns out ya CAN have too much of a good thing.
msgctxt "2049:812"
msgid "<$comeff(1,7)><$facial(1,1)><$motion(1,663)><$voicel(1,3)>¡Ay, qué dolor!<clear><br><$comeff(1,3)><$motion(1,803)><$voicel(1,6)>Creo que me pasé un poco entrenando ayer...<br><$comeff(1,17)><$motion(1,805)><$voicel(1,1)>¡Ya dicen que cualquier cosa en exceso es mala!"
msgstr ""

#. en: <$comeff(1,10)><$facial(1,1)><$motion(1,661)><$voicel(1,6)>Y’know, every now and then, some Pokémon’ll come up to<br>me and be like, “Teach me your ways!”<clear><br><$comeff(1,3)><$motion(1,805)><$voicel(1,8)>When I ask ’em what they mean, they tell me my vibes are<br>bad—but, like, in a good way.<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,9)>Heh. It’s a problem, really! But also, like...in a good way.
msgctxt "2049:813"
msgid "<$comeff(1,10)><$facial(1,1)><$motion(1,661)><$voicel(1,6)>A veces me viene algún Pokémon chiquitajo y me suelta<br>que quiere ser mi amigo, así sin venir a cuento.<clear><br><$comeff(1,3)><$motion(1,805)><$voicel(1,8)>Y si pregunto por qué, siempre me dicen que es porque<br>\"les mola mi rollo en plan malote\".<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,9)>Je, je. Supongo que tendría que alegrarme."
msgstr "<$comeff(1,10)><$facial(1,1)><$motion(1,661)><$voicel(1,6)>A veces me viene algún Pokémon chiquitito y me suelta<br>que quiere ser mi amigo, así sin venir a cuento.<clear><br><$comeff(1,3)><$motion(1,805)><$voicel(1,8)>Y si pregunto por qué, siempre me dicen que es porque<br>\"les encanta mi estilo rebelde\".<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,9)>Je, je. Supongo que tendría que alegrarme."

#. en: <$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,6)>The other day, someone REALLY wanted to have a<br>funny-face contest with me, so I said OK...<clear><br><$comeff(1,5)><$facial(1,9)><$motion(1,805)><$voicel(1,4)>But when I made my funny face, they suddenly got all<br>scared <$comeff(1,7)><$motion(1,663)><$voicel(1,1)>and called off the contest!<clear><br><$comeff(1,17)><$facial(1,14)><$motion(1,807)><$voicel(1,3)>I, uh...I dunno how I feel about that...
msgctxt "2049:814"
msgid "<$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,6)>El otro día me enredaron para la típica movida de a ver<br>quién aguanta la mirada sin reírse.<clear><br><$comeff(1,5)><$facial(1,9)><$motion(1,805)><$voicel(1,4)>Puse cara de concentración, pero debí de pasarme de<br>seri<gen;-3(o,a)> o algo, porque el otro acabó temblando de miedo,<slide><br><$comeff(1,7)><$motion(1,663)><$voicel(1,1)>¡y ahí se acabó el juego!<clear><br><$comeff(1,17)><$facial(1,14)><$motion(1,807)><$voicel(1,3)>En fin, hay que ver lo delicados que son algunos..."
msgstr "<$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,6)>El otro día me enredaron para el típico juego de a ver<br>quién aguanta la mirada sin reírse.<clear><br><$comeff(1,5)><$facial(1,9)><$motion(1,805)><$voicel(1,4)>Puse cara de concentración, pero debí de pasarme de<br>seri<gen;-3(o,a)> o algo, porque el otro acabó temblando de miedo,<slide><br><$comeff(1,7)><$motion(1,663)><$voicel(1,1)>¡y ahí se acabó el juego!<clear><br><$comeff(1,17)><$facial(1,14)><$motion(1,807)><$voicel(1,3)>En fin, hay que ver lo delicados que son algunos..."

#. en: <$comeff(1,3)><$facial(1,4)><$motion(1,661)><$voicel(1,6)>This nice, thick coat of mine isn’t just for show, y’know!<clear><br><$comeff(1,21)><$motion(1,806)><$facial(1,1)><$voicel(1,8)>It also FEELS awesome! Do ya know how many Pokémon’s<br><$comeff(1,8)><$motion(1,801)><$voicel(1,9)>minds I’ve blown with its awesomeness? A lot!<clear><br><$comeff(1,10)><$motion(1,803)><$voicel(1,8)>Pretty cool, huh?!
msgctxt "2049:815"
msgid "<$comeff(1,3)><$facial(1,4)><$motion(1,661)><$voicel(1,6)>Mi pelaje no es solo la mar de bonito.<clear><br><$comeff(1,21)><$motion(1,806)><$facial(1,1)><$voicel(1,8)>Es que, además, ¡es tan suave y agradable que hasta tengo<br><$comeff(1,8)><$motion(1,801)><$voicel(1,9)>un montonaco de fans haciendo cola para acariciarlo!<clear><br><$comeff(1,10)><$motion(1,803)><$voicel(1,8)>¿Qué te parece? Una pasada, ¿eh? ¡Ya quisieran muchos!"
msgstr "<$comeff(1,3)><$facial(1,4)><$motion(1,661)><$voicel(1,6)>Mi pelaje no es solo súper bonito.<clear><br><$comeff(1,21)><$motion(1,806)><$facial(1,1)><$voicel(1,8)>Es que, además, ¡es tan suave y agradable que hasta tengo<br><$comeff(1,8)><$motion(1,801)><$voicel(1,9)>un montón de fans haciendo cola para acariciarlo!<clear><br><$comeff(1,10)><$motion(1,803)><$voicel(1,8)>¿Qué te parece? Increíble, ¿eh? ¡Ya quisieran muchos!"

#. en: <$comeff(1,14)><$facial(1,1)><$motion(1,806)><$voicel(1,6)>How much cooler do ya think I’m gonna be when I<br>grow up?!<clear><br><$comeff(1,8)><$motion(1,666)><$voicel(1,7)>I’m already pretty dang cool, y’know? If I get any cooler,<br>everyone might start goin’ gaga over me!<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,805)><$voicel(1,8)>Th-that’s a joke! But it WOULD be pretty nice...
msgctxt "2049:817"
msgid "<$comeff(1,14)><$facial(1,1)><$motion(1,806)><$voicel(1,6)>Si ya soy popular y molo cantidad, ¿qué pasará cuando<br>crezca aún más?<clear><br><$comeff(1,8)><$motion(1,666)><$voicel(1,7)>Mira que si mi nivel de molonería sube tanto que todos<br>terminan enamorándose de mí...<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,805)><$voicel(1,8)>Bueno, lo digo en broma, ¡pero a saber!"
msgstr "<$comeff(1,14)><$facial(1,1)><$motion(1,806)><$voicel(1,6)>Si ya soy popular y genial, ¿qué pasará cuando<br>crezca aún más?<clear><br><$comeff(1,8)><$motion(1,666)><$voicel(1,7)>Mira que si mi nivel de genialidad sube tanto que todos<br>terminan enamorándose de mí...<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,805)><$voicel(1,8)>Bueno, lo digo en broma, ¡pero a saber!"

#. en: <oneline><$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,6)>Did ya know <$cdef(27)><$tonepk;0(1)> </color>really looks up<br>to me?!<clear><br><$comeff(1,14)><$motion(1,805)><$voicel(1,8)>They say it’s because I’m super dependable and sooo cool!<br><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>It’s like I’ve got a cute li’l sibling!
msgctxt "2049:818"
msgid "<oneline><$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,6)><fcap><dart;0()><$cdef(27)><$tonepk;0(1)></color> me tiene en<br>un pedestal.<clear><br><$comeff(1,14)><$motion(1,805)><$voicel(1,8)>Según <gen;0(él,ella)>, soy dign<gen;-3(o,a)> de confianza y molo un montón.<br><$cdef(27)><$comeff(1,9)></color><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Je, je! ¡Qué mon<gen;0(o,a)> que es, por favor!"
msgstr "<oneline><$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,6)><fcap><dart;0()><$cdef(27)><$tonepk;0(1)></color> me tiene en<br>un pedestal.<clear><br><$comeff(1,14)><$motion(1,805)><$voicel(1,8)>Según <gen;0(él,ella)>, soy dign<gen;-3(o,a)> de confianza y lo máximo.<br><$cdef(27)><$comeff(1,9)></color><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Je, je! ¡Qué lind<gen;0(o,a)> que es, por favor!"

#. en: <oneline><$comeff(1,14)><$facial(1,1)><$motion(1,661)><$voicel(1,6)>Hangin’ out with someone like<br><$cdef(27)><$tonepk;0(13)></color><slide><br>is really<slide><br>interestin’,<slide><br>y’know?<slide><br>They’re<slide><br>just<slide><br>SO chill!<clear><br><$comeff(1,21)><$motion(1,805)><$voicel(1,8)>When we chat, I always forget all my li’l worries and<br>troubles and whatnot. <$comeff(1,3)><$motion(1,806)><$voicel(1,5)>It’s pretty cool.
msgctxt "2049:830"
msgid "<oneline><$comeff(1,14)><$facial(1,1)><$motion(1,661)><$voicel(1,6)>¡Me parto con <dart;0()><$cdef(27)><$tonepk;0(13)></color>!<br>Además, no pierde<slide><br>la calma<slide><br>por nada, <gen;0(el tío,la tía)>.<clear><br><$comeff(1,21)><$motion(1,805)><$voicel(1,8)>Cuando hablamos, hace que me olvide automáticamente<br>de todas las preocupaciones tontas del día a día.<clear><br><$comeff(1,3)><$motion(1,806)><$voicel(1,5)>¡Qué suertaza tengo de tenerl<gen;0(o,a)> como amig<gen;0(o,a)>!"
msgstr "<oneline><$comeff(1,14)><$facial(1,1)><$motion(1,661)><$voicel(1,6)>¡Me muero de risa con <dart;0()><$cdef(27)><$tonepk;0(13)></color>!<br>Además, no pierde<slide><br>la calma<slide><br>por nada, <gen;0(el tío,la tía)>.<clear><br><$comeff(1,21)><$motion(1,805)><$voicel(1,8)>Cuando hablamos, hace que me olvide automáticamente<br>de todas las preocupaciones tontas del día a día.<clear><br><$comeff(1,3)><$motion(1,806)><$voicel(1,5)>¡Qué suertaza tengo de tenerl<gen;0(o,a)> como amig<gen;0(o,a)>!"

#. en: <$emotion(1,38)><$voicel(1,7)>At this point, this hammer of mine’s basically an extension<br>of my arm!<clear><br><$emotion(1,55)><$voicel(1,3)>But I gotta tell ya—it took a hot minute and loads of<br>practice to swing it around like it’s nothin’!
msgctxt "2049:836"
msgid "<$emotion(1,38)><$voicel(1,7)>Mi martillo y yo somos uña y carne... ¡Inseparables!<clear><br><$emotion(1,55)><$voicel(1,3)>Pero aquí donde nos ves, ¡no te haces ni idea de lo que<br>me he tenido que esforzar pa moverlo así como si nada!"
msgstr "<$emotion(1,38)><$voicel(1,7)>Mi martillo y yo somos uña y carne... ¡Inseparables!<clear><br><$emotion(1,55)><$voicel(1,3)>Pero aquí donde nos ves, ¡no tienes ni idea de lo que<br>me tuve que esforzar pa moverlo así como si nada!"

#. en: <$emotion(1,14)><$voicel(1,5)><$cdef(27)><gevcmainpk;0> </color>seems to have somethin’ exciting in the works.<br>They’ve been lookin’ real busy lately! <$emotion(1,38)><$voicel(1,8)>You should go see<slide><br>what they’re up to, <$cdef(27)><pname;1></color>!
msgctxt "2049:851"
msgid "<oneline><$emotion(1,14)><$voicel(1,5)>Se ve que <esa;0()><$cdef(27)><gevcmainpk;0> </color>se le ha metido algo entre<br>ceja<slide><br>y ceja...<clear><br>Lleva unos días con la motivación por las nubes, ¿eh?<br><$emotion(1,38)><$voicel(1,8)>¡Pregúntale qué se cuece, <$cdef(27)><pname;1></color>!"
msgstr "<oneline><$emotion(1,14)><$voicel(1,5)>Se ve que <esa;0()><$cdef(27)><gevcmainpk;0> </color>se le metió algo entre<br>ceja<slide><br>y ceja...<clear><br>Lleva unos días con la motivación por las nubes, ¿eh?<br><$emotion(1,38)><$voicel(1,8)>¡Pregúntale qué está tramando, <$cdef(27)><pname;1></color>!"

#. en: <$emotion(1,1)><$voicel(1,10)>Heh... Just messin’ with ya, bud!<clear><br><$emotion(1,29)><$voicel(1,7)>Could ya tell who I was tryin’ to imitate? I bet I sounded<br>just like ’em!
msgctxt "2049:853"
msgid "...<clear><br><$emotion(1,1)><$voicel(1,10)>Je, je... ¡Te estoy vacilandooo!<clear><br><$emotion(1,29)><$voicel(1,7)>¡No me dirás que no he clavado su forma de hablar!<br>Fijo que sabes a quién estaba imitando, ¿a que sí?"
msgstr "...<clear><br><$emotion(1,1)><$voicel(1,10)>Je, je... ¡Te estoy tomando el pelooo!<clear><br><$emotion(1,29)><$voicel(1,7)>¡No me dirás que no clavé su forma de hablar!<br>Seguro que sabes a quién estaba imitando, ¿a que sí?"

#. en: <$comeff(1,20)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Yep, that’s right! Guess it was kinda silly of me to think<br>you wouldn’t figure it out, huh?
msgctxt "2049:854"
msgid "<$comeff(1,20)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Has acertao! Ojo, que no esperaba menos de ti."
msgstr "<$comeff(1,20)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Acertaste! Ojo, que no esperaba menos de ti."

#. en: <oneline><$emotion(1,38)><$voicel(1,9)>Oooh... Nope! I was actually imitatin’<br><$cdef(27)><apfquizpk;0(0)></color>!<slide><br>Guess<slide><br>I gotta<slide><br>work<slide><br>on it<slide><br>a bit more...
msgctxt "2049:855"
msgid "<oneline><$emotion(1,38)><$voicel(1,9)>¡Se siente! Era <dart;0()><$cdef(27)><apfquizpk;0(0)></color>.<clear><br>Vaya, está visto que tengo que practicar más...<br>¿Tan mal me ha salido?"
msgstr "<oneline><$emotion(1,38)><$voicel(1,9)>¡Lástima! Era <dart;0()><$cdef(27)><apfquizpk;0(0)></color>.<clear><br>Vaya, está visto que tengo que practicar más...<br>¿Tan mal me salió?"

#. en: <$cdef(27)><$voicel(1,3)><$motion(1,666)><$facial(1,2)><$comeff(1,6)></color>Huh? What’s up, bud? Want me to hang on to that<br><$voicel(1,6)><$emotion(1,14)><$cdef(27)><fqty(1)><$ifull(432)> </color>for ya?<clear><br><$voicel(1,8)><$facial(1,4)><$comeff(1,10)>No prob! I don’t mind at all!
msgctxt "2049:859"
msgid "<$cdef(27)><$voicel(1,3)></color><$motion(1,666)><$facial(1,2)><$comeff(1,6)>¿Ein? ¿Entonces este <$cdef(27)><fqty(1)><$ifull(432)></color> es pa mí?<br><wait(1.0)><$voicel(1,6)><$emotion(1,14)>Pues vale.<clear><br><$voicel(1,8)><$facial(1,4)><$comeff(1,10)>Trae p'acá."
msgstr "<$cdef(27)><$voicel(1,3)></color><$motion(1,666)><$facial(1,2)><$comeff(1,6)>¿Eh? ¿Entonces este <$cdef(27)><fqty(1)><$ifull(432)></color> es pa mí?<br><wait(1.0)><$voicel(1,6)><$emotion(1,14)>Pues bueno.<clear><br><$voicel(1,8)><$facial(1,4)><$comeff(1,10)>Trae p'acá."

#. en: <$emotion(1,58)><$voicel(1,6)>Whoa! It’s all shiny...<clear><br><$voicel(1,9)><$emotion(1,38)>I dunno what’s goin’ on, but it’s pretty obvious this is one<br>special <$cdef(27)><fqty(1)><$ifull(432)></color>!<clear><br><$emotion(1,14)><$voicel(1,7)>Here ya go, bud. You can have it back!
msgctxt "2049:860"
msgid "<$emotion(1,58)><$voicel(1,6)>Ahí va, esto está brillando cosa mala... y no tengo ni papa<br>de por qué... <wait(1.0)><$voicel(1,9)><$emotion(1,38)>Qué pasada de <$cdef(27)><fqty(1)><$ifull(432)></color>, ¿no?<clear><br><$emotion(1,14)><$voicel(1,7)>Oye, <$cdef(27)><pname;0></color>, mejor quédatelo tú."
msgstr "<$emotion(1,58)><$voicel(1,6)>Vaya, esto está brillando un montón... y no tengo ni idea<br>de por qué... <wait(1.0)><$voicel(1,9)><$emotion(1,38)>Qué increíble <$cdef(27)><fqty(1)><$ifull(432)></color>, ¿no?<clear><br><$emotion(1,14)><$voicel(1,7)>Oye, <$cdef(27)><pname;0></color>, mejor quédatelo tú."

#. en: <$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>Hahaha! So that was you all along, bud?! I had no idea!<br><$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,8)>Your <$cdef(27)><$sklfull(6)> </color>had ya lookin’ just like the real thing!<clear><br><$comeff(1,9)><$motion(1,801)><$voicel(1,9)>Here, have a li’l <$cdef(27)><fqty(1)><$ifull(532)></color>! You deserve it!
msgctxt "2049:862"
msgid "<$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>Ja, ja, ¡así que eras tú, <$cdef(27)><pname;0></color>!<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,8)>No hay quien use <$cdef(27)><$sklfull(6)></color> tan bien como tú...<br>¡Me has tomado el pelo pero a base de bien, niñ<gen;-2(o,a)>!<clear><br><$comeff(1,9)><$motion(1,801)><$voicel(1,9)>Toma, esta <$cdef(27)><fqty(1)><$ifull(532)> </color>es toda pa ti,<br>que no se diga."
msgstr "<$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>Ja, ja, ¡así que eras tú, <$cdef(27)><pname;0></color>!<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,8)>No hay quien use <$cdef(27)><$sklfull(6)></color> tan bien como tú...<br>¡Me tomaste el pelo pero bien, amig<gen;-2(o,a)>!<clear><br><$comeff(1,9)><$motion(1,801)><$voicel(1,9)>Toma, esta <$cdef(27)><fqty(1)><$ifull(532)> </color>es toda pa ti,<br>que no se diga."

#. en: <$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>Hahaha! That was you all along, bud?! I had no idea!<br><$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,8)>Your <$cdef(27)><$sklfull(6)> </color>had ya lookin’ just like the real thing!<clear><br><$comeff(1,9)><$motion(1,801)><$voicel(1,9)>Here, have a li’l <$cdef(27)><fqty(1)><$ifull(532)></color>! You deserve it!
msgctxt "2049:863"
msgid "<$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>Ja, ja, ¡así que eras tú, <$cdef(27)><pname;0></color>!<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,8)>No hay quien use <$cdef(27)><$sklfull(6)></color> tan bien como tú...<br>¡Me has tomado el pelo pero a base de bien, niñ<gen;-2(o,a)>!<clear><br><$comeff(1,9)><$motion(1,801)><$voicel(1,9)>Toma, estas <$cdef(27)><fqty(2)><$ifull(532)> </color>son todas pa ti,<br>que no se diga."
msgstr "<$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>Ja, ja, ¡así que eras tú, <$cdef(27)><pname;0></color>!<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,806)><$voicel(1,8)>No hay quien use <$cdef(27)><$sklfull(6)></color> tan bien como tú...<br>¡Me tomaste el pelo pero bien, amig<gen;-2(o,a)>!<clear><br><$comeff(1,9)><$motion(1,801)><$voicel(1,9)>Toma, estas <$cdef(27)><fqty(2)><$ifull(532)> </color>son todas pa ti,<br>que no se diga."

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,7)>Thanks a lot for the invite, bud! But maybe some other<br>time, huh?<clear><br><$emotion(1,29)><$voicel(1,5)>There are a bunch of other Pokémon who wanna visit<br>you, right?<clear><br><$emotion(1,38)><$voicel(1,9)>Why don’t you take them with ya first? You can invite me<br>again some other time!
msgctxt "2049:902"
msgid "<$comeff(1,14)><$motion(1,666)><$voicel(1,7)>Se agradece la invitación, niñ<gen;-2(o,a)>, pero otra vez será.<clear><br><$emotion(1,29)><$voicel(1,5)>Además, ¿no tienes ya un puñado de Pokémon que están<br>deseando ir a verte?<clear><br><$emotion(1,38)><$voicel(1,9)>Que vayan ellos primero y luego, si eso, ya me vuelves<br>a invitar a mí otro día."
msgstr "<$comeff(1,14)><$motion(1,666)><$voicel(1,7)>Se agradece la invitación, amig<gen;-2(o,a)>, pero otra vez será.<clear><br><$emotion(1,29)><$voicel(1,5)>Además, ¿no tienes ya un puñado de Pokémon que están<br>deseando ir a verte?<clear><br><$emotion(1,38)><$voicel(1,9)>Que vayan ellos primero y luego ya me vuelves<br>a invitar a mí otro día."

#. en: <$emotion(1,37)><$voicel(1,7)>Guess it’s time for me to head home... Today was real fun,<br><$cdef(27)><pname;0></color>! <$emotion(1,8)><$voicel(1,10)>Let’s do it again sometime!
msgctxt "2049:903"
msgid "<oneline><$emotion(1,37)><$voicel(1,7)>Creo que ya va siendo hora de ir tirando pa casita...<br>¡Hoy me lo he pasado pipa, <$cdef(27)><pname;0></color>!<slide><br><$emotion(1,8)><$voicel(1,10)>¡Hasta la próxima!"
msgstr "<oneline><$emotion(1,37)><$voicel(1,7)>Creo que ya va siendo hora de ir tirando pa casita...<br>¡Hoy la pasé genial, <$cdef(27)><pname;0></color>!<slide><br><$emotion(1,8)><$voicel(1,10)>¡Hasta la próxima!"

#. en: <$emotion(1,29)><$voicel(1,8)>Oh yeah? You want me to come visit?<clear><br><$emotion(1,38)><$voicel(1,9)>OK, bud! I’ll head on over in a bit! Thanks for the invite!
msgctxt "2049:904"
msgid "<$emotion(1,29)><$voicel(1,8)>¿Sí? ¿Quieres que me pase a verte? <$emotion(1,38)><$voicel(1,9)>¡Pues voy p'allá<br>dentro de nada! ¡Gracias!"
msgstr ""

#. en: <$comeff(1,5)><$facial(1,1)><$motion(1,803)><$voicel(1,8)>What’s up? You headed somewhere fun, bud?! You should<br>take me with you if you are!
msgctxt "2049:905"
msgid "<$comeff(1,5)><$facial(1,1)><$motion(1,803)><$voicel(1,8)>¿Vas a algún lado? ¡Déjame ir contigo!"
msgstr ""

#. en: <$comeff(1,3)><$facial(1,1)><$motion(1,807)><$voicel(1,4)>All right, all right! I’ll sit this one out! It’s cool!
msgctxt "2049:906"
msgid "<$comeff(1,3)><$facial(1,1)><$motion(1,807)><$voicel(1,4)>Vaya chasco... Pues a ver si a la próxima me invitas."
msgstr ""

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>That was a really cool experience! Thanks for the good<br>times, <$cdef(27)><pname;0></color>!
msgctxt "2049:907"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Uf, a eso llamo yo aprovechar bien el tiempo!<br>¡Gracias, <$cdef(27)><pname;0></color>!"
msgstr ""

#. en: <$emotion(1,14)><$voicel(1,7)>Hey heyyy, <$cdef(27)><pname;0></color>! I’m here!<clear><br><$comeff(1,6)><$motion(1,805)><$voicel(1,5)>Remember me? I’m <$cdef(27)><nowner;2></color>’s friend!<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>Y’know, where I live is pretty cool, but this place ain’t too<br>shabby either! <$emotion(1,38)><$voicel(1,10)>Looks like there’s a bunch of interesting<slide><br>stuff to see here!
msgctxt "2049:921"
msgid "<oneline><$emotion(1,14)><$voicel(1,7)>¡Eeey! Ya estoy aquí, <$cdef(27)><pname;0></color>.<clear><br><$comeff(1,6)><$motion(1,805)><$voicel(1,5)>¿Te acuerdas de mí? <$cdef(27)><nowner;2></color> y yo<br>somos<slide><br>coleguitas.<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>¡Guaaau! Mi casa está apañada, pero tú te lo montas a<br>otro nivel. <$emotion(1,38)><$voicel(1,10)>¡La de cosas interesantes que tienes por aquí!"
msgstr "<oneline><$emotion(1,14)><$voicel(1,7)>¡Eeey! Ya estoy aquí, <$cdef(27)><pname;0></color>.<clear><br><$comeff(1,6)><$motion(1,805)><$voicel(1,5)>¿Te acuerdas de mí? <$cdef(27)><nowner;2></color> y yo<br>somos<slide><br>amiguitos.<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>¡Guaaau! Mi casa no está mal, pero lo tuyo está a<br>otro nivel. <$emotion(1,38)><$voicel(1,10)>¡La de cosas interesantes que tienes por aquí!"
