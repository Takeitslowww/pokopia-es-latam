#. en: <$emotion(2,8)><$voicel(2,9)>We just gotta set up a <$cdef(27)><fqty(1)><$ifull(1457)></color> around here, and<br>it’ll connect to the island where the <$cdef(27)>Pokémon Center </color>is!
msgctxt "2931:0"
msgid "<$emotion(2,8)><$voicel(2,9)>¡Hay que colocar por aquí una <$cdef(27)><fqty(1)><$ifull(1457)></color><br>para poder llegar a la isla donde está el <$cdef(27)>Centro Pokémon</color>!"
msgstr ""

#. en: <$emotion(2,37)><$voicel(2,7)>Which means I should probably teach you how to make<br><$cdef(27)><fqty(2)><$ifull(1457)></color>!
msgctxt "2931:1"
msgid "<$emotion(2,37)><$voicel(2,7)>¡Y no te comas el tarro, que yo mism<gen;-3(o,a)> te voy a enseñar<br>cómo se fabrican!"
msgstr "<$emotion(2,37)><$voicel(2,7)>¡Y no te preocupes, que yo mism<gen;-3(o,a)> te voy a enseñar<br>cómo se fabrican!"

#. en: You learned a <$cdef(27)>recipe </color>for a <$cdef(27)><fqty(1)><$ifull(1457)></color>!
msgctxt "2931:2"
msgid "¡Has aprendido cómo construir<br><$cdef(27)><fqty(2)><$ifull(1457)></color>!"
msgstr "¡Aprendiste cómo construir<br><$cdef(27)><fqty(2)><$ifull(1457)></color>!"

#. en: <oneline><$emotion(2,1)><$voicel(2,7)>Well? Go on, <$cdef(27)><pname;0></color>! Try makin’ <$cdef(27)>one</color><br><$cdef(27)><fqty(1)><$ifull(1457)></color>,<slide><br>just<slide><br>like I<slide><br>taught ya!
msgctxt "2931:5"
msgid "<$emotion(2,1)><$voicel(2,7)>Ea, <$cdef(27)><pname;0></color>, ¡al lío! ¡Prueba a construir<br><$cdef(27)>1 <fqty(1)><$ifull(1457)></color>!"
msgstr "<$emotion(2,1)><$voicel(2,7)>¡Adelante, <$cdef(27)><pname;0></color>! ¡Intenta construir<br><$cdef(27)>1 <fqty(1)><$ifull(1457)></color>!"

#. en: <$emotion(2,37)><$voicel(2,8)>Try makin’ <$cdef(27)>one</color> <$cdef(27)><fqty(1)><$ifull(1457)></color>!
msgctxt "2931:10"
msgid "<$emotion(2,37)><$voicel(2,8)>¡Prueba a construir <$cdef(27)>1</color> <$cdef(27)><fqty(1)><$ifull(1457)></color>!"
msgstr "<$emotion(2,37)><$voicel(2,8)>¡Intenta construir <$cdef(27)>1</color> <$cdef(27)><fqty(1)><$ifull(1457)></color>!"

#. en: <oneline><$comeff(2,3)><$facial(2,4)><$motion(2,803)><$voicel(2,7)>Heyyy, that looks real good! You’ve got talent,<br><$cdef(27)><pname;0></color>!
msgctxt "2931:14"
msgid "<oneline><$comeff(2,3)><$facial(2,4)><$motion(2,803)><$voicel(2,7)>¡Ole, lo has clavao! ¡Estás hech<gen;-2(o,a)> <gen;-2(un,una)> artista,<br><$cdef(27)><pname;0></color>!"
msgstr "<oneline><$comeff(2,3)><$facial(2,4)><$motion(2,803)><$voicel(2,7)>¡Bravo, lo lograste! ¡Eres tod<gen;-2(o,a)> <gen;-2(un,una)> artista,<br><$cdef(27)><pname;0></color>!"

#. en: <$comeff(2,14)><$motion(2,824)><$voicel(2,5)>All right, try <$voicel(2,8)>placin’ a <$cdef(27)><fqty(1)><$ifull(1457)></color> so it connects to the<br>island where the <$cdef(27)>Pokémon Center</color> is!
msgctxt "2931:18"
msgid "<$comeff(2,14)><$motion(2,824)><$voicel(2,5)>Ahora solo queda lo más fácil: ¡que coloques<br>la <$cdef(27)><fqty(1)><$ifull(1457)></color> pa conectarnos con<slide><br><$voicel(2,8)>la isla donde está el <$cdef(27)>Centro Pokémon</color>!"
msgstr ""

#. en: <$emotion(2,60)><$voicel(2,10)>Right around here should be perfect!
msgctxt "2931:19"
msgid "<$emotion(2,60)><$voicel(2,10)>Mira, yo creo que se podría instalar por aquí mismo."
msgstr ""

#. en: <$comeff(2,14)><$motion(2,661)><$voicel(2,5)>All right, try placin’ a <$cdef(27)><fqty(1)><$ifull(1457)></color> so it connects to the<br>island where the <$cdef(27)>Pokémon Center</color> is!<clear><br><$emotion(2,60)><$voicel(2,10)>I think right around here would be perfect!
msgctxt "2931:23"
msgid "<$comeff(2,14)><$motion(2,661)><$voicel(2,5)>Coloca la <$cdef(27)><fqty(1)><$ifull(1457)></color> pa conectarnos<br>con la isla donde está el <$cdef(27)>Centro Pokémon</color>.<clear><br><$emotion(2,60)><$voicel(2,10)>¡Aquí mismo se podría instalar perfectamente!"
msgstr ""

#. en: <$emotion(2,8)><$voicel(2,10)>Perfect! That spot oughta do the trick!
msgctxt "2931:27"
msgid "<$emotion(2,8)><$voicel(2,10)>¡Ole! ¡Niquelao!"
msgstr "<$emotion(2,8)><$voicel(2,10)>¡Bravo! ¡Perfecto!"

#. en: <$comeff(2,14)><$motion(2,824)><$voicel(2,7)>Now we’ve got a <$cdef(27)>lift</color> runnin’ between here and the<br><$cdef(27)>Pokémon Center </color>island!
msgctxt "2931:31"
msgid "<$comeff(2,14)><$motion(2,824)><$voicel(2,7)>¡Ahora ya nos podemos ir en <$cdef(27)>teleférico</color> hasta el<br><$cdef(27)>Centro Pokémon</color>!"
msgstr ""

#. en: <$voicel(2,5)>Y’know, I’d love to check out the town you’re buildin’.<clear><br><$comeff(2,10)><$motion(2,664)><$voicel(2,9)>Why don’t ya escort me to the <$cdef(27)>Pokémon Center</color>?
msgctxt "2931:32"
msgid "<$voicel(2,5)>Estoy loc<gen;-3(o,a)> por ver cómo marcha ese vecindario tuyo.<br><$comeff(2,10)><$motion(2,664)><$voicel(2,9)>¡Llévame al <$cdef(27)>Centro Pokémon</color>, va!"
msgstr "<$voicel(2,5)>Estoy loc<gen;-3(o,a)> por ver cómo marcha ese vecindario tuyo.<br><$comeff(2,10)><$motion(2,664)><$voicel(2,9)>¡Llévame al <$cdef(27)>Centro Pokémon</color>, vamos!"

#. en: <$comeff(2,10)><$motion(2,664)><$voicel(2,9)>Lead the way to the <$cdef(27)>Pokémon Center</color>!
msgctxt "2931:37"
msgid "<$comeff(2,10)><$motion(2,664)><$voicel(2,9)>¡Llévame al <$cdef(27)>Centro Pokémon</color>!"
msgstr ""

#. en: <$emotion(2,60)><$voicel(2,8)>We made it! Awesome!
msgctxt "2931:41"
msgid "<$emotion(2,60)><$voicel(2,8)>¡Ya hemos llegao!"
msgstr "<$emotion(2,60)><$voicel(2,8)>¡Ya llegamos!"

#. en: <oneline><$emotion(1,14)><$voicel(1,5)>Hoho! So you’re the great builder <$cdef(27)>Tinkaton</color>?<clear><br><$emotion(1,8)><$voicel(1,7)>I hope you’ll continue helping out our<br>friend <$cdef(27)><pname;0></color>!
msgctxt "2931:42"
msgid "<oneline><$emotion(1,14)><$voicel(1,5)>¡Jo, jo, jo! Corrígeme si me equivoco: tú eres <$cdef(27)>Tinkaton</color>,<br>la experta en construcción, ¿verdad?<clear><br><$emotion(1,8)><$voicel(1,7)>¡Seguro que a <$cdef(27)><pname;0> </color>le vendrá<br>de maravilla<slide><br>contar con tu ayuda!"
msgstr ""

#. en: <$emotion(2,8)><$voicel(2,7)>Sure thing! Just say the word, and I’ll help build up this<br>town any way I can!
msgctxt "2931:43"
msgid "<$emotion(2,8)><$voicel(2,7)>¡Pa eso estamos, pa echar un cable! ¡Estoy deseando<br>darle una puesta a punto a este vecindario!"
msgstr "<$emotion(2,8)><$voicel(2,7)>¡Pa eso estamos, pa echar una mano! ¡Estoy deseando<br>darle una puesta a punto a este vecindario!"

#. en: <$comeff(2,10)><$facial(2,4)><$motion(2,806)><$voicel(2,9)>Now, let me see if there’s anything I can get started on...
msgctxt "2931:44"
msgid "<$comeff(2,10)><$facial(2,4)><$motion(2,806)><$voicel(2,9)>A ver, a ver... ¿Por dónde debería empezar?"
msgstr ""

#. en: If you make <$cdef(27)>lifts</color>, you can have Pokémon follow you even<br>to far-off places.<clear><br>If you don’t have enough <$cdef(27)><fqty(2)><$ifull(119)> </color>to craft with, give<br><$cdef(27)>Tinkaton</color> <$cdef(27)><fqty(2)><$ifull(115)> </color>and have them make some!
msgctxt "2931:45"
msgid "Si construyes <$cdef(27)>teleféricos</color>, los Pokémon te acompañarán<br>también a lugares lejanos.<clear><br>En caso de que te falten <$cdef(27)><fqty(2)><$ifull(119)> </color>para construirlos,<br>entrégale algún<$cdef(27)> <fqty(1)><$ifull(115)> </color>a la <$cdef(27)>Tinkaton Manitas</color><slide><br>para que te los fabrique."
msgstr ""
