#. en: <$comeff(2,6)><$motion(2,805)><$facial(2,2)><$kfacial(2)><$voicel(2,6)>Who do you wanna know about?
msgctxt "3552:0"
msgid "<$comeff(2,6)><$motion(2,805)><$facial(2,2)><$kfacial(2)><$voicel(2,6)>¿Sobre quién me quieres preguntar?"
msgstr ""

#. en: <$comeff(2,14)><$motion(2,827)><$facial(2,1)><$voicel(2,4)>That Pokémon LOVES coral, so I usually saw them in places<br>with lotsa different kinds of coral.
msgctxt "3552:6"
msgid "<$comeff(2,14)><$motion(2,827)><$facial(2,1)><$voicel(2,4)>¡Ah, a ese Pokémon le gustan muchísimo los corales! Solía<br>verse en sitios donde hay muuuchos corales de todo tipo."
msgstr "<$comeff(2,14)><$motion(2,827)><$facial(2,1)><$voicel(2,4)>¡Ah, a ese Pokémon le gustan muchísimo los corales! Solía<br>verse en lugares donde hay muuuchos corales de todo tipo."

#. en: <$voicel(2,8)>Maybe try looking for ’em over that way!
msgctxt "3552:7"
msgid "<$voicel(2,8)>¡Creo que podrías ir a buscar por allí!"
msgstr "<$voicel(2,8)>¡Creo que podrías ir a buscar por allá!"

#. en: <$facial(2,5)><$motion(2,838)><$comeff(2,21)><$voicel(2,9)>Oooh, you met <$cdef(27)><$cname(567)></color>? YAY! If they need anything, make<br>sure to help ’em out!
msgctxt "3552:13"
msgid "<$facial(2,5)><$motion(2,838)><$comeff(2,21)><$voicel(2,9)>¡Qué bien que hayas conocido a <$cdef(27)><$cname(567)></color>! Si necesita algo,<br>ayúdala con lo que sea, ¿valeee?"
msgstr "<$facial(2,5)><$motion(2,838)><$comeff(2,21)><$voicel(2,9)>¡Qué bien que hayas conocido a <$cdef(27)><$cname(567)></color>! Si necesita algo,<br>ayúdala con lo que sea, ¿síii?"

#. en: <$facial(2,5)><$motion(2,838)><$comeff(2,13)><$voicel(2,10)>Aw, you helped <$cdef(27)><$cname(567)></color> out with their request? Thanks!<clear><br><$voicel(2,8)><$motion(2,655)><$facial(2,4)><$comeff(2,10)>If they’ve got any other problems, please help ’em out!
msgctxt "3552:19"
msgid "<oneline><$facial(2,5)><$motion(2,838)><$comeff(2,13)><$voicel(2,10)>¡Muchas gracias por ayudar a <$cdef(27)><$cname(567)></color>,<br><$cdef(27)><pname;0></color>!<slide><br><wait(0.5)><$voicel(2,8)><$motion(2,655)><$facial(2,4)><$comeff(2,10)>Si tiene cualquier otro<slide><br>problema, échale una mano."
msgstr ""
