#. en: <$comeff(1,4)><$motion(1,663)><$voicel(1,3)>*huff huff* My... *huff* That was...quite the walk.<br><$comeff(1,6)><$motion(1,803)><$voicel(1,6)>Now...what do you suppose we’ll find around here?
msgctxt "2895:0"
msgid "<$comeff(1,4)><$motion(1,663)><$voicel(1,3)>Arf... Arf... Yo no estoy ya para estos trotes...<br><$comeff(1,6)><$motion(1,803)><$voicel(1,6)>¿Qué crees que nos deparará esta nueva zona?..."
msgstr ""

#. en: <$comeff(1,3)><$motion(1,661)><$voicel(1,7)>We might get a good view from over there. Let’s try<br>heading that way first.
msgctxt "2895:1"
msgid "<$comeff(1,3)><$motion(1,661)><$voicel(1,7)>Parece que desde allí podremos tener una panorámica<br>privilegiada del lugar... ¡Vayamos a echar un vistazo!"
msgstr "<$comeff(1,3)><$motion(1,661)><$voicel(1,7)>Parece que desde allá podremos tener una panorámica<br>privilegiada del lugar... ¡Vayamos a echar un vistazo!"

#. en: <$comeff(1,4)><$motion(1,663)><$voicel(1,3)>*huff huff* My... *huff* That was...quite the walk.<br><$comeff(1,6)><$motion(1,803)><$voicel(1,6)>Now...what do you suppose we’ll find around here?
msgctxt "2895:4"
msgid "<$comeff(1,4)><$motion(1,663)><$voicel(1,3)>Arf... Arf... Yo no estoy ya para estos trotes...<br><$comeff(1,6)><$motion(1,803)><$voicel(1,6)>¿Qué crees que nos deparará esta nueva zona?..."
msgstr ""

#. en: <$comeff(1,3)><$motion(1,661)><$voicel(1,7)>We might get a good view from over there. Let’s try<br>heading that way first.
msgctxt "2895:5"
msgid "<$comeff(1,3)><$motion(1,661)><$voicel(1,7)>Parece que desde allí podremos tener una panorámica<br>privilegiada del lugar... ¡Vayamos a echar un vistazo!"
msgstr "<$comeff(1,3)><$motion(1,661)><$voicel(1,7)>Parece que desde allá podremos tener una panorámica<br>privilegiada del lugar... ¡Vayamos a echar un vistazo!"

#. en: <$comeff(1,10)><$facial(1,4)><$motionoff(1,804)><$voicel(1,8)>Come along now—this way!
msgctxt "2895:8"
msgid "<$comeff(1,10)><$facial(1,4)><$motionoff(1,804)><$voicel(1,8)>¡Por aquí!"
msgstr ""

#. en: <$comeff(1,5)><$motion(1,665)><$voicel(1,7)>Gadzooks! Have we actually climbed all the way above<br>the clouds?! <$comeff(1,4)><$motion(1,807)><$voicel(1,4)>Small wonder it was so exhausting...
msgctxt "2895:12"
msgid "<$comeff(1,5)><$motion(1,665)><$voicel(1,7)>¡Mira! Parecería que estamos por encima de las nubes.<br>¿Tan alto hemos subido? <$comeff(1,4)><$motion(1,807)><$voicel(1,4)>Con razón estoy tan cansad<gen;-3(o,a)>..."
msgstr "<$comeff(1,5)><$motion(1,665)><$voicel(1,7)>¡Mira! Parecería que estamos por encima de las nubes.<br>¿Tan alto subimos? <$comeff(1,4)><$motion(1,807)><$voicel(1,4)>Con razón estoy tan cansad<gen;-3(o,a)>..."

#. en: <$comeff(1,3)><$motion(1,661)><$voicel(1,7)>It looks as though the land in this area is held above<br>the clouds by those bluish-white rocks, <$comeff(1,10)><$motion(1,664)><$voicel(1,10)>giving the<slide><br>appearance of islands floating in the sky!<clear><br><$comeff(1,7)><$motion(1,666)><$voicel(1,5)>First thing’s first—we’ll have to come up with a way to get<br>to that island over there.
msgctxt "2895:13"
msgid "<$comeff(1,3)><$motion(1,661)><$voicel(1,7)>Este terreno parece haber sido aupado hasta las nubes<br>por esas rocas de tono blanco azulado.<clear><br><$comeff(1,10)><$motion(1,664)><$voicel(1,10)>¡Es como si nos encontrásemos en un archipiélago que<br>flota en el mismísimo cielo!<clear><br><$comeff(1,7)><$motion(1,666)><$voicel(1,5)>Bien... En primer lugar, debemos averiguar cómo llegar<br>hasta aquella isla de allí."
msgstr "<$comeff(1,3)><$motion(1,661)><$voicel(1,7)>Este terreno parece haber sido elevado hasta las nubes<br>por esas rocas de tono blanco azulado.<clear><br><$comeff(1,10)><$motion(1,664)><$voicel(1,10)>¡Es como si nos encontráramos en un archipiélago que<br>flota en el mismísimo cielo!<clear><br><$comeff(1,7)><$motion(1,666)><$voicel(1,5)>Bien... En primer lugar, debemos averiguar cómo llegar<br>hasta aquella isla de allá."

#. en: <$comeff(1,6)><$motion(1,803)><$voicel(1,5)>Wait a moment... What’s that strange-looking tower? <$comeff(1,3)><$motion(1,661)><$voicel(1,8)>Let’s<br>go take a gander and find out.
msgctxt "2895:14"
msgid "<$comeff(1,6)><$motion(1,803)><$voicel(1,5)>¿Oh? ¿Qué es esa torre tan extraña que se ve ahí?<br><$comeff(1,3)><$motion(1,661)><$voicel(1,8)>Vayamos a inspeccionarla de cerca."
msgstr ""

#. en: <$comeff(1,5)><$motion(1,665)><$voicel(1,7)>Gadzooks! Have we actually climbed all the way above<br>the clouds?! <$comeff(1,4)><$motion(1,807)><$voicel(1,4)>Small wonder it was so exhausting...
msgctxt "2895:18"
msgid "<$comeff(1,5)><$motion(1,665)><$voicel(1,7)>¡Mira! Parecería que estamos por encima de las nubes.<br>¿Tan alto hemos subido? <$comeff(1,4)><$motion(1,807)><$voicel(1,4)>Con razón estoy tan cansad<gen;-3(o,a)>..."
msgstr "<$comeff(1,5)><$motion(1,665)><$voicel(1,7)>¡Mira! Parecería que estamos por encima de las nubes.<br>¿Tan alto subimos? <$comeff(1,4)><$motion(1,807)><$voicel(1,4)>Con razón estoy tan cansad<gen;-3(o,a)>..."

#. en: <$comeff(1,3)><$motion(1,661)><$voicel(1,7)>It looks as though the land in this area is held above<br>the clouds by those bluish-white rocks, <$comeff(1,10)><$motion(1,664)><$voicel(1,10)>giving the<slide><br>appearance of islands floating in the sky!<clear><br><$comeff(1,7)><$motion(1,666)><$voicel(1,5)>First thing’s first—we’ll have to come up with a way to get<br>to that island over there.
msgctxt "2895:19"
msgid "<$comeff(1,3)><$motion(1,661)><$voicel(1,7)>Este terreno parece haber sido aupado hasta las nubes<br>por esas rocas de tono blanco azulado.<clear><br><$comeff(1,10)><$motion(1,664)><$voicel(1,10)>¡Es como si nos encontrásemos en un archipiélago que<br>flota en el mismísimo cielo!<clear><br><$comeff(1,7)><$motion(1,666)><$voicel(1,5)>Bien... En primer lugar, debemos averiguar cómo llegar<br>hasta aquella isla de allí."
msgstr "<$comeff(1,3)><$motion(1,661)><$voicel(1,7)>Este terreno parece haber sido elevado hasta las nubes<br>por esas rocas de tono blanco azulado.<clear><br><$comeff(1,10)><$motion(1,664)><$voicel(1,10)>¡Es como si nos encontráramos en un archipiélago que<br>flota en el mismísimo cielo!<clear><br><$comeff(1,7)><$motion(1,666)><$voicel(1,5)>Bien... En primer lugar, debemos averiguar cómo llegar<br>hasta aquella isla de allá."

#. en: <$comeff(1,6)><$motion(1,803)><$voicel(1,5)>Wait a moment... What’s that strange-looking tower? <$comeff(1,3)><$motion(1,661)><$voicel(1,8)>Let’s<br>go take a gander and find out.
msgctxt "2895:20"
msgid "<$comeff(1,6)><$motion(1,803)><$voicel(1,5)>¿Oh? ¿Qué es esa torre tan extraña que se ve ahí?<br><$comeff(1,3)><$motion(1,661)><$voicel(1,8)>Vayamos a inspeccionarla de cerca."
msgstr ""

#. en: <$comeff(1,6)><$motion(1,806)><$voicel(1,6)>What in the world could this be?<clear><br><$comeff(1,3)><$motion(1,661)><$voicel(1,5)>In all my long years, I’ve never seen a tower quite as odd<br>as this one. <$comeff(1,6)><$motion(1,668)><$voicel(1,8)>Would a human really have made this?
msgctxt "2895:24"
msgid "<$comeff(1,6)><$motion(1,806)><$voicel(1,6)>Qué intriga... ¿Para qué servirá?<clear><br><$comeff(1,3)><$motion(1,661)><$voicel(1,5)>A pesar de mi longeva edad, nunca había visto nada<br>remotamente parecido... <$comeff(1,6)><$motion(1,668)><$voicel(1,8)>¿Será una creación humana?"
msgstr ""

#. en: <$comeff(1,10)><$motion(1,803)><$voicel(1,7)>You know, it’s possible there’s another Pokémon<br>somewhere nearby—<$comeff(1,5)><$motion(1,661)><$voicel(1,8)>one that’s good at building things,<slide><br>like you!<$motion(1,652)>
msgctxt "2895:25"
msgid "<$comeff(1,10)><$motion(1,803)><$voicel(1,7)>¡O quizá haya por aquí otro Pokémon que, como tú,<br><$comeff(1,5)><$motion(1,661)><$voicel(1,8)>sea muy ducho en fabricar cosas!<$motion(1,652)>"
msgstr "<$comeff(1,10)><$motion(1,803)><$voicel(1,7)>¡O quizás haya por aquí otro Pokémon que, como tú,<br><$comeff(1,5)><$motion(1,661)><$voicel(1,8)>sea muy ducho en fabricar cosas!<$motion(1,652)>"

#. en: <$comeff(1,3)><$motion(1,801)><$voicel(1,5)>Now this machine here DOES look human-made.
msgctxt "2895:26"
msgid "<$comeff(1,3)><$motion(1,801)><$voicel(1,5)>Aunque yo diría que esto sí es obra de los humanos."
msgstr ""

#. en: <oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>But I haven’t a clue how to use it.<clear><br><$comeff(1,3)><$motion(1,661)><$voicel(1,7)>Hmmm... It does appear you can ride on that platform.<br>Why don’t you hop on and see what happens,<slide><br><$cdef(27)><pname;0></color>?
msgctxt "2895:27"
msgid "<oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>¿Cómo se usará esta máquina?<clear><br><$comeff(1,3)><$motion(1,661)><$voicel(1,7)>¿Por qué no pruebas a montarte sobre la plataforma,<br><$cdef(27)><pname;0></color>?<slide><br>A lo mejor ocurre algo."
msgstr "<oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>¿Cómo se usará esta máquina?<clear><br><$comeff(1,3)><$motion(1,661)><$voicel(1,7)>¿Por qué no intentas subirte a la plataforma,<br><$cdef(27)><pname;0></color>?<slide><br>A lo mejor ocurre algo."

#. en: <$comeff(1,6)><$motion(1,806)><$voicel(1,6)>What in the world could this be?<clear><br><$comeff(1,3)><$motion(1,661)><$voicel(1,5)>In all my long years, I’ve never seen a tower quite as odd<br>as this one. <$comeff(1,6)><$motion(1,668)><$voicel(1,8)>Would a human really have made this?
msgctxt "2895:35"
msgid "<$comeff(1,6)><$motion(1,806)><$voicel(1,6)>Qué intriga... ¿Para qué servirá?<clear><br><$comeff(1,3)><$motion(1,661)><$voicel(1,5)>A pesar de mi longeva edad, nunca había visto nada<br>remotamente parecido... <$comeff(1,6)><$motion(1,668)><$voicel(1,8)>¿Será una creación humana?"
msgstr ""

#. en: <$comeff(1,10)><$motion(1,803)><$voicel(1,7)>You know, it’s possible there’s another Pokémon<br>somewhere nearby—<$comeff(1,5)><$motion(1,661)><$voicel(1,8)>one that’s good at building things,<slide><br>like you!<$motion(1,652)>
msgctxt "2895:36"
msgid "<$comeff(1,10)><$motion(1,803)><$voicel(1,7)>¡O quizá haya por aquí otro Pokémon que, como tú,<br><$comeff(1,5)><$motion(1,661)><$voicel(1,8)>sea muy ducho en fabricar cosas!<$motion(1,652)>"
msgstr "<$comeff(1,10)><$motion(1,803)><$voicel(1,7)>¡O quizás haya por aquí otro Pokémon que, como tú,<br><$comeff(1,5)><$motion(1,661)><$voicel(1,8)>sea muy ducho en fabricar cosas!<$motion(1,652)>"

#. en: <$comeff(1,3)><$motion(1,801)><$voicel(1,5)>Now this machine here DOES look human-made.
msgctxt "2895:37"
msgid "<$comeff(1,3)><$motion(1,801)><$voicel(1,5)>Aunque yo diría que esto sí es obra de los humanos."
msgstr ""

#. en: <oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>But I haven’t a clue how to use it.<clear><br><$comeff(1,3)><$motion(1,661)><$voicel(1,7)>Hmmm... It does appear you can stand on that platform.<br>Why don’t you hop on and see what happens,<slide><br><$cdef(27)><pname;0></color>?
msgctxt "2895:38"
msgid "<oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>¿Cómo se usará esta máquina?<clear><br><$comeff(1,3)><$motion(1,661)><$voicel(1,7)>¿Por qué no pruebas a montarte sobre la plataforma,<br><$cdef(27)><pname;0></color>?<slide><br>A lo mejor ocurre algo."
msgstr "<oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>¿Cómo se usará esta máquina?<clear><br><$comeff(1,3)><$motion(1,661)><$voicel(1,7)>¿Por qué no intentas subirte a la plataforma,<br><$cdef(27)><pname;0></color>?<slide><br>A lo mejor ocurre algo."

#. en: <oneline><$comeff(1,3)><$motion(1,661)><$voicel(1,7)>This machine here... It looks like you can stand on that<br>platform. Care to hop on and see what happens,<slide><br><$cdef(27)><pname;0></color>?
msgctxt "2895:46"
msgid "<oneline><$comeff(1,3)><$motion(1,661)><$voicel(1,7)>Tal vez si te subes sobre esa plataforma consigamos<br>activar la máquina. ¿Por qué no pruebas,<slide><br><$cdef(27)><pname;0></color>?"
msgstr ""

#. en: It looks like you’ve left <$cdef(27)><$cname(341)></color> behind!<br>Go back and talk to them first.
msgctxt "2895:50"
msgid "¡El pobre <$cdef(27)><$cname(341)> </color>se ha quedado atrás!<br>Da media vuelta y habla con él."
msgstr "¡El pobre <$cdef(27)><$cname(341)> </color>se quedó atrás!<br>Da media vuelta y habla con él."
