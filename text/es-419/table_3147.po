#. en: <$comeff(1,3)><$motion(1,805)><$voicel(1,7)>Bzt! ♪ The open sky. The fresh air. The Pokémon. <$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,10)>It has<br>been a time since I saw them all.
msgctxt "3147:0"
msgid "<$comeff(1,3)><$motion(1,805)><$voicel(1,7)>♪¡Mite!♪ Cielo azul, aire puro e incluso Pokémon...<br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,10)>Ha transcurrido tiempo. Mucho desde la última vez..."
msgstr ""

#. en: <$emotion(1,29)><$voicel(1,7)>Hello. Hello. Will you be a friend of mine? <$emotion(1,38)><$voicel(1,10)>Let us<br>talk together.
msgctxt "3147:1"
msgid "<$emotion(1,29)><$voicel(1,7)>Saludos. Es un placer. ¿Quieres que seamos amigos?<br><$emotion(1,38)><$voicel(1,10)>Entablemos conversación."
msgstr ""

#. en: <$comeff(1,6)><$motion(1,805)><$voicel(1,5)>Hello. Hello. There was a big building above here. Why is<br>it gone?
msgctxt "3147:7"
msgid "<$motion(1,805)><$voicel(1,5)>Disculpa. La gran estructura que se hallaba aquí...<br><$comeff(1,6)>¿Sabes qué le sucedió?"
msgstr ""

#. en: <$comeff(1,5)><$facial(1,13)><$motion(1,803)><$voicel(1,10)>It flew to the sky? It is difficult to believe.
msgctxt "3147:8"
msgid "<$comeff(1,5)><$facial(1,13)><$motion(1,803)><$voicel(1,10)>¡¿Salió volando?!"
msgstr ""

#. en: <$comeff(1,14)><$facial(1,1)><$motion(1,827)><$voicel(1,5)>Incredible. Those humans were making a thing of<br>amazement. <$voicel(1,8)>I now understand.
msgctxt "3147:9"
msgid "<$comeff(1,14)><$facial(1,1)><$motion(1,827)><$voicel(1,5)>Oh... Algo se traían entre manos aquellos humanos...<br><$voicel(1,8)>¿Por qué construirían algo así?"
msgstr ""

#. en: <$emotion(1,14)><$voicel(1,5)>There were many humans. They looked “sketchy.” They<br>did things around the building.
msgctxt "3147:10"
msgid "<$emotion(1,14)><$voicel(1,5)>Merodeaban alrededor de la estructura. Unos individuos<br>de mala apariencia."
msgstr ""

#. en: <$comeff(1,14)><$motion(1,805)><$voicel(1,3)>One day, they disappeared. I went inside to investigate.<br><$emotion(1,37)><$voicel(1,8)>But I was unable to exit.
msgctxt "3147:11"
msgid "<$comeff(1,14)><$motion(1,805)><$voicel(1,3)>Desaparecieron. De un día para otro. Así que aproveché<br>para entrar. <$emotion(1,37)><$voicel(1,8)>Pero me quedé encerrad<gen;-3(o,a)>."
msgstr ""

#. en: <$comeff(1,6)><$motion(1,666)><$voicel(1,5)>I could not exit and had no things to do, so I slept. How<br>long did I sleep? I do not know. <$facial(1,9)><$motion(1,807)><$voicel(1,4)>When I woke, I was here.
msgctxt "3147:12"
msgid "<$motion(1,666)><$voicel(1,5)>No fui capaz de salir. Así que decidí dormir para ahorrar<br>recursos. <$comeff(1,6)>Me pregunto cuánto tiempo pasé durmiendo...<clear><br><$facial(1,9)><$motion(1,807)><$voicel(1,4)>Cuando desperté, estaba aquí."
msgstr ""

#. en: <$emotion(1,37)><$voicel(1,7)>When the building flew, maybe I fell out.
msgctxt "3147:13"
msgid "<$emotion(1,37)><$voicel(1,7)>A lo mejor caí. Cuando la estructura salió volando."
msgstr ""

#. en: <$emotion(1,51)><$voicel(1,4)>The building was a comfortable space for sleeping.<br>It would have been a good home. <$emotion(1,31)><$voicel(1,2)>This is unfortunate.
msgctxt "3147:14"
msgid "<$emotion(1,51)><$voicel(1,4)>Aquel edificio no estaba tan mal. Era buena residencia.<br><$emotion(1,31)><$voicel(1,2)>Me apena su desaparición..."
msgstr ""

#. en: <$emotion(1,29)><$voicel(1,7)>You can make a home that is like the building. Is it<br>a possibility?
msgctxt "3147:15"
msgid "<$emotion(1,29)><$voicel(1,7)>¿Cómo dices? ¿Quizá puedas crear un lugar parecido?<br>¿Para mí?"
msgstr "<$emotion(1,29)><$voicel(1,7)>¿Cómo dices? ¿Quizás puedas crear un lugar parecido?<br>¿Para mí?"

#. en: <$emotion(1,38)><$voicel(1,9)>If so, I would like that a large amount. Something like this.<br>Please make it.
msgctxt "3147:16"
msgid "<$emotion(1,38)><$voicel(1,9)>Te lo agradezco. De veras. Querría vivir en un sitio así."
msgstr "<$emotion(1,38)><$voicel(1,9)>Te lo agradezco. De veras. Querría vivir en un lugar así."

#. en: <$emotion(1,50)><$voicel(1,8)>I count on you.
msgctxt "3147:17"
msgid "<$emotion(1,50)><$voicel(1,8)>¡Te ruego que me hagas el favor!"
msgstr ""

#. en: <$emotion(1,37)><$voicel(1,9)>I wish for you to make my home.
msgctxt "3147:27"
msgid "<$emotion(1,37)><$voicel(1,9)>Quiero que me prepares una residencia."
msgstr ""

#. en: <$emotion(1,8)><$voicel(1,9)>You did it. You made my home. I thank you.
msgctxt "3147:33"
msgid "<$emotion(1,8)><$voicel(1,9)>¡Me has conseguido una residencia! Te estoy agradecid<gen;-3(o,a)>."
msgstr "<$emotion(1,8)><$voicel(1,9)>¡Me conseguiste una residencia! Te estoy agradecid<gen;-3(o,a)>."

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>I wish to repay you. What can I do. I must think.
msgctxt "3147:34"
msgid "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Quiero entregarte algo. Sí, mereces una recompensa.<br>He de procesar qué sería apropiado..."
msgstr ""

#. en: <oneline><$comeff(1,20)><$motion(1,803)><$voicel(1,9)>Oh. <$cdef(27)><pname;0></color>. I have an idea. Do you<br>have<slide><br>interest<slide><br>in<slide><br><$cdef(27)><$sklfull(13)></color>?
msgctxt "3147:35"
msgid "<$comeff(1,20)><$motion(1,803)><$voicel(1,9)>He tenido una idea. ¿Quizá te interese usar <$cdef(27)><$sklfull(13)></color>?"
msgstr "<$comeff(1,20)><$motion(1,803)><$voicel(1,9)>Tuve una idea. ¿Quizás te interese usar <$cdef(27)><$sklfull(13)></color>?"

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>It will let you float around. This is very fun. You must try.
msgctxt "3147:36"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>Es para flotar por el aire. Resulta divertido. Pruébalo."
msgstr ""

#. en: <$emotion(1,37)><$voicel(1,9)>Wow. <$cdef(27)><pname;0></color>. Your floating is skillful.
msgctxt "3147:43"
msgid "<$emotion(1,37)><$voicel(1,9)>Impresionante. ¡Se te da bien flotar! Mis felicitaciones."
msgstr "<$emotion(1,37)><$voicel(1,9)>Impresionante. ¡Flotas muy bien! Mis felicitaciones."

#. en: <$emotion(1,8)><$voicel(1,7)>You must continue to practice. You will master<br><$cdef(27)><$sklfull(13)></color>.
msgctxt "3147:44"
msgid "<$emotion(1,8)><$voicel(1,7)>Sigue practicando el uso de <$cdef(27)><$sklfull(13)></color>. Terminarás<br>flotando como quien respira."
msgstr ""
