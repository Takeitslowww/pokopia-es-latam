msgctxt "4389:3"
msgid "¡Hala, qué sitio tan chachi! ¡Lo quierooo!"
msgstr "¡Guau, qué lugar tan genial! ¡Lo quierooo!"

#. en: I wanna eat that SO BAD!
msgctxt "4389:4"
msgid "¡Qué antojo tengooo!"
msgstr ""

#. en: I tried to go that way but I couldn’t...
msgctxt "4389:9"
msgid "¡He intentado ir, pero es que me canso muchooo!"
msgstr "¡Intenté ir, pero es que me canso muchooo!"

#. en: I LOVE this!
msgctxt "4389:17"
msgid "¡Me encantaaa!"
msgstr ""

#. en: I wanna meet up with them!
msgctxt "4389:18"
msgid "¿Cómo será?"
msgstr ""

#. en: I wanna see a picture of you and me together!
msgctxt "4389:19"
msgid "¡Quiero una foto en la que salgamos tú y yo!"
msgstr ""

