"X-Ldtool-English-Record: 2864\n"

#. en: <$emotion(8,14)><$voicel(8,5)>Sounds like your friends are callin’ ya from down below,<br>bud. Go on, get outta here.
msgctxt "2868:0"
msgid "<$emotion(8,14)><$voicel(8,5)>Venga, ve tirando ya, que te llaman los Pokémon de abajo."
msgstr "<$emotion(8,14)><$voicel(8,5)>Vamos, ve yendo ya, que te llaman los Pokémon de abajo."

#. en: It seems like there’s still more for you to do<br>in <$cdef(27)><$stgname;0(3)></color>.
msgctxt "2868:6"
msgid "<oneline>Aún te quedan cosas por hacer en<br><dart;0()><$cdef(27)><$stgname;0(3)></color>."
msgstr ""

#. en: <oneline><$emotion(1,14)><$voicel(1,5)>Oho, <$cdef(27)><pname;0></color>! What can you tell us<br>about<slide><br>that<slide><br>Pokémon?
msgctxt "2868:12"
msgid "<$emotion(1,14)><$voicel(1,5)>¡<$cdef(27)><pname;0></color>! ¿Quién lianas era ese?"
msgstr ""

#. en: <$comeff(1,5)><$facial(1,13)><$motionoff(1,804)><$voicel(1,9)>What’s that? That was the Mythical Pokémon <$cdef(27)>Volcanion</color>?!<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,807)><$voicel(1,5)>Truly incredible Pokémon do seem to appear when<br>you’re around...
msgctxt "2868:13"
msgid "<$comeff(1,5)><$facial(1,13)><$motionoff(1,804)><$voicel(1,9)>¡No me digas que se trataba de <$cdef(27)>Volcanion</color>, el Pokémon<br>singular!<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,807)><$voicel(1,5)>Desde que te conocí, no hemos parado de encontrarnos<br>con Pokémon a cuál más impresionante..."
msgstr ""

#. en: <$emotion(1,14)><$voicel(1,7)>So I take it <$cdef(27)>Volcanion </color>won’t be coming to our party?<br><$comeff(1,6)><$voicel(1,6)><$lookat(1,0,8)>What are they planning to do over there?
msgctxt "2868:14"
msgid "<$cdef(27)><$emotion(1,14)></color><$voicel(1,7)>Ahora que lo pienso, ¿no va a unirse a la fiesta?<br><$comeff(1,6)><$voicel(1,6)><$lookat(1,0,8)>Me pregunto qué se traerá entre manos ahí arriba..."
msgstr ""

#. en: <$voicel(8,9)><$motion(8,801)><$facial(8,4)>Thanks for givin’ me a glimpse of that fun party of yours!<br>Here’s a li’l present from me in return!
msgctxt "2868:15"
msgid "<$voicel(8,9)><$motion(8,801)><$facial(8,4)>Gracias por animar el cotarro con tremenda fiestaca.<br>Tomad, un regalo de mi parte."
msgstr "<$voicel(8,9)><$motion(8,801)><$facial(8,4)>Gracias por alegrar el lugar con tremenda fiestota.<br>Tomen, un regalo de mi parte."

#. en: <$voicel(2,10)>Oh, how gorgeous!
msgctxt "2868:22"
msgid "<$voicel(2,10)>¡Oy, qué preciosidad!"
msgstr ""

#. en: <$voicel(1,10)>Oho! If I’m not mistaken, those are...fireworks?
msgctxt "2868:23"
msgid "<$voicel(1,10)>¡Oh! ¿Fuegos artificiales?"
msgstr ""

#. en: <$voicel(3,10)>Yooo!!! Fireworks! Look at ’em go!
msgctxt "2868:24"
msgid "<$voicel(3,10)>¡Fuegos artificiales! ¡Qué locurón!"
msgstr "<$voicel(3,10)>¡Fuegos artificiales! ¡Qué locura!"

#. en: <$emotion(4,8)><$voicel(4,10)>I’ve never seen fireworks before!
msgctxt "2868:25"
msgid "<$emotion(4,8)><$voicel(4,10)>¡No había visto nunca algo así!"
msgstr ""

#. en: <$comeff(6,21)><$facial(6,4)><$motion(6,801)><$voicel(6,9)>Those are fireworks, huh? How breathtakingly beautiful...<br>Just like me!
msgctxt "2868:26"
msgid "<$comeff(6,21)><$facial(6,4)><$motion(6,801)><$voicel(6,9)>Estos fuegos artificiales están guapísimos...<br>Molan casi tanto como yo."
msgstr "<$comeff(6,21)><$facial(6,4)><$motion(6,801)><$voicel(6,9)>Estos fuegos artificiales son preciosos...<br>Casi tanto como yo."

#. en: <$emotion(5,38)><$voicel(5,10)>Dang, I can feel those booms in my biceps!
msgctxt "2868:27"
msgid "<$emotion(5,38)><$voicel(5,10)>¡Noto la vibración hasta en los abdominales!"
msgstr ""

#. en: <$emotion(3,14)><$voicel(3,7)>All right, everybody! Now it’s time to REALLY get this<br>party started!<clear><br><$emotion(3,8)><$voicel(3,9)>It’s gonna be a BLAST—like those fireworks!
msgctxt "2868:28"
msgid "<$emotion(3,14)><$voicel(3,7)>¡Chavales, ahora empieza lo bueno!<clear><br><$emotion(3,8)><$voicel(3,9)>¡Toca hacer más ruido que los fuegos artificiales!<br>Let's partyyy!"
msgstr "<$emotion(3,14)><$voicel(3,7)>¡Chicos, ahora empieza lo bueno!<clear><br><$emotion(3,8)><$voicel(3,9)>¡A hacer más ruido que los fuegos artificiales!<br>Let's partyyy!"

#. en: <$comeff(2,9)><$facial(2,4)><$motion(2,801)><$voicel(2,9)>We’ve still got plenty of <$cdef(27)>curry</color>, too, everyone! Please go<br>ahead and eat your fill!
msgctxt "2868:29"
msgid "<$comeff(2,9)><$facial(2,4)><$motion(2,801)><$voicel(2,9)>Todavía queda <$cdef(27)>curri </color>para todos... ¡A comer sin remilgos!"
msgstr "<$comeff(2,9)><$facial(2,4)><$motion(2,801)><$voicel(2,9)>Todavía queda <$cdef(27)>curry </color>para todos... ¡A comer sin remilgos!"

#. en: <$emotion(1,38)><$voicel(1,10)><$emotion(3,38)><$voicel(3,10)><$emotion(4,38)><$voicel(4,10)><$emotion(6,38)><$voicel(6,10)><$emotion(5,38)><$voicel(5,10)>Yaaay!
msgctxt "2868:30"
msgid "<$emotion(1,38)><$voicel(1,10)><$emotion(3,38)><$voicel(3,10)><$emotion(4,38)><$voicel(4,10)><$emotion(6,38)><$voicel(6,10)><$emotion(5,38)><$voicel(5,10)>¡Bieeen!"
msgstr ""

#. en: And so the Pokémon party continued, even long after<br><$cdef(27)>Volcanion </color>left...
msgctxt "2868:31"
msgid "Y así, tras despedirse de <$cdef(27)>Volcanion</color>, los demás Pokémon<br>siguieron de fiesta..."
msgstr "Y así, luego de despedirse de <$cdef(27)>Volcanion</color>, los demás<br>Pokémon siguieron de fiesta..."

#. en: <$comeff(1,17)><$facial(1,4)><$motion(1,806)><$voicel(1,9)>Phew! I may have overdone it on the food...but it’s been<br>ages since I really let loose and made merry like that!
msgctxt "2868:38"
msgid "<$comeff(1,17)><$facial(1,4)><$motion(1,806)><$voicel(1,9)>Hacía muchísimo tiempo que no me quedaba de marcha<br>hasta tan tarde... Por no hablar de todo lo que he comido."
msgstr "<$comeff(1,17)><$facial(1,4)><$motion(1,806)><$voicel(1,9)>Hacía muchísimo tiempo que no me quedaba de fiesta<br>hasta tan tarde... Por no hablar de todo lo que comí."

#. en: <$emotion(1,38)><$voicel(1,7)>And <$cdef(27)>Volcanion</color>’s fireworks were truly a sight to behold!<br><$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>I wonder if we’ll ever get another chance to see them...
msgctxt "2868:39"
msgid "<$emotion(1,38)><$voicel(1,7)>Los fuegos artificiales de <$cdef(27)>Volcanion</color> han sido, sin duda,<br>el punto álgido de la fiesta.<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>Espero que volvamos a tener la oportunidad de ver tal<br>espectáculo algún día."
msgstr "<$emotion(1,38)><$voicel(1,7)>Los fuegos artificiales de <$cdef(27)>Volcanion</color> fueron, sin duda,<br>el punto álgido de la fiesta.<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>Espero que volvamos a tener la oportunidad de ver tal<br>espectáculo algún día."

#. en: ... ... ...
msgctxt "2868:40"
msgid "..."
msgstr ""

#. en: You came up with <$cdef(27)>recipes</color> for a <$cdef(27)><fqty(1)><$ifull(1850)></color> and <$cdef(27)>fireworks</color>!
msgctxt "2868:41"
msgid "¡Se te ha ocurrido cómo fabricar <$cdef(27)><fqty(2)><$ifull(1850)><br></color>y <$cdef(27)>bolas de pirotecnia</color>!"
msgstr "¡Se te ocurrió cómo fabricar <$cdef(27)><fqty(2)><$ifull(1850)><br></color>y <$cdef(27)>bolas de pirotecnia</color>!"

#. en: <$emotion(1,14)><$voicel(1,5)>Wait a moment... Are you telling me that you’ve even<br>come up with a way to make fireworks?<clear><br><$emotion(1,38)><$voicel(1,10)>You are quite the prodigy!
msgctxt "2868:42"
msgid "<$emotion(1,14)><$voicel(1,5)>¿De veras te ves capaz de fabricar fuegos artificiales?<br><$emotion(1,38)><$voicel(1,10)>¡Lianas! ¡Eres de lo que no hay!"
msgstr "<$emotion(1,14)><$voicel(1,5)>¿De veras te ves capaz de fabricar fuegos artificiales?<br><$emotion(1,38)><$voicel(1,10)>¡Lianas! ¡Eres increíble!"

#. en: <$comeff(1,14)><$motion(1,824)><$voicel(1,7)>I hope you’ll launch some for us the next time we hold<br>a party like this!
msgctxt "2868:43"
msgid "<$comeff(1,14)><$motion(1,824)><$voicel(1,7)>No dudes en usarlos en la próxima fiesta."
msgstr ""

#. en: <$voicel(1,5)>Sadly, the humans didn’t join us this time, but it was clear<br>to me everyone here had a tremendous time.<clear><br><$voicel(1,7)>And if this town continues to be so happy and lively,<br>perhaps one day the humans will take note.
msgctxt "2868:44"
msgid "<$voicel(1,5)>No parece que los humanos estén listos aún para volver,<br>pero todo el mundo aquí se lo ha pasado en grande hoy...<clear><br><$voicel(1,7)>Un vecindario tan animado seguro que capta la atención<br>de los humanos tarde o temprano."
msgstr "<$voicel(1,5)>No parece que los humanos estén listos aún para volver,<br>pero todo el mundo aquí se la pasó en grande hoy...<clear><br><$voicel(1,7)>Un vecindario tan animado seguro que capta la atención<br>de los humanos tarde o temprano."

#. en: <$emotion(1,8)><$voicel(1,9)>And once again, from the very roots of these old vines,<br>thank you, <$cdef(27)><pname;0></color>.
msgctxt "2868:45"
msgid "<$emotion(1,8)><$voicel(1,9)>Te agradezco de nuevo todo lo que haces por nosotros,<br><$cdef(27)><pname;0></color>."
msgstr ""

#. en: <$emotion(1,8)><$voicel(1,7)>This town has grown quite lively thanks to your efforts!<br><$voicel(1,9)>And you put on a splendid party!
msgctxt "2868:56"
msgid "<$emotion(1,8)><$voicel(1,7)>Gracias a ti, este vecindario está mucho más animado,<br><$voicel(1,9)>¡y hasta hemos podido celebrar una fiesta!"
msgstr ""

#. en: <$comeff(1,14)><$motion(1,824)><$voicel(1,5)>If you’re itching to move on and explore unknown lands,<br>I recommend returning to the previous town first.<clear><br><$voicel(1,7)>Then you can head to the other gate that leads from there.
msgctxt "2868:57"
msgid "<$comeff(1,14)><$motion(1,824)><$voicel(1,5)>Si quieres explorar áreas aún por descubrir, lo mejor será<br>que <$voicel(1,7)>regreses al vecindario anterior y cruces el otro pasaje."
msgstr ""

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,664)><$voicel(1,9)>And whenever you do, you can be sure I’m coming<br>with you!
msgctxt "2868:58"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,664)><$voicel(1,9)>Y no te preocupes, ¡que yo seguiré a tu lado vayas<br>adonde vayas!"
msgstr ""

#. en: <$comeff(1,6)><$motion(1,661)><$voicel(1,5)>Oh, and remember that <$cdef(27)>sand-covered building</color> we found<br>on the beach in the <$cdef(27)><$stgname;0(1)></color>?<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,6)>Something about that keeps tugging at my mind as well.
msgctxt "2868:59"
msgid "<$comeff(1,6)><$motion(1,661)><$voicel(1,5)>Oh, ¿recuerdas el <$cdef(27)>edificio cubierto de arena </color>que había<br>en la playa <esde;0()><$cdef(27)><$stgname;0(1)></color>?<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,6)>Lo cierto es que no puedo sacármelo de la cabeza..."
msgstr ""

#. en: <$comeff(1,3)><$motion(1,801)><$voicel(1,7)>I’d appreciate it if you could check on it every now<br>and then.
msgctxt "2868:60"
msgid "<$comeff(1,3)><$motion(1,801)><$voicel(1,7)>Me harías un favor enorme si te pasaras a verlo de vez<br>en cuando y me informaras de cualquier progreso."
msgstr ""

#. en: <oneline><$emotion(1,14)><$voicel(1,7)>Say, <$cdef(27)><pname;0></color>, there seems to be another<br>gate<slide><br>in<slide><br>this<slide><br>town<slide><br>apart<slide><br>from<slide><br>the<slide><br>one<slide><br>we<slide><br>came<slide><br>in through.
msgctxt "2868:64"
msgid "<$emotion(1,14)><$voicel(1,7)>A propósito, además del que usamos para venir aquí,<br>en este vecindario parece haber otro pasaje de acceso."
msgstr ""

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Now that you’ve registered <$cdef(27)>Volcanion </color>in your Pokédex,<br>you may be able to pass though there!
msgctxt "2868:65"
msgid "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Ahora que ya has registrado a <$cdef(27)>Volcanion </color>en tu Pokédex,<br>es posible que puedas atravesarlo."
msgstr ""

#. en: <$emotion(1,8)><$voicel(1,7)>I think you should go check it out when you’re ready.<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,664)><$voicel(1,9)>And of course, I’ll be coming with you!
msgctxt "2868:66"
msgid "<$emotion(1,8)><$voicel(1,7)>Me gustaría que fuésemos a echar un vistazo cuando te<br>hayas preparado... <$comeff(1,10)><$facial(1,4)><$motion(1,664)><$voicel(1,9)>¡y sí, me apunto como de costumbre!"
msgstr ""

#. en: <$comeff(3,5)><$facial(3,13)><$motion(3,665)><$voicel(3,9)>Say whaaat?! You and <$cdef(27)>Volcanion </color>are best buds now? Yo,<br><$emotion(3,38)><$voicel(3,8)>you are a VIBE, <$cdef(27)><pname;0></color>!
msgctxt "2868:93"
msgid "<$comeff(3,5)><$facial(3,13)><$motion(3,665)><$voicel(3,9)>¡¿Cóoomo?! ¡¿Que te has hecho colega de <$cdef(27)>Volcanion</color>?!<br><$emotion(3,38)><$voicel(3,8)>¡Estoy living, loco!"
msgstr "<$comeff(3,5)><$facial(3,13)><$motion(3,665)><$voicel(3,9)>¡¿Cóoomo?! ¡¿Que <$cdef(27)>Volcanion</color> y tú ahora son amigos?!<br><$emotion(3,38)><$voicel(3,8)>¡Estoy living, loco!"

#. en: <$comeff(2,17)><$motion(2,807)><$voicel(2,5)>I was really hoping that sweetie <$cdef(27)>Volcanion </color>would try some<br>of my <$cdef(27)>curry</color>.
msgctxt "2868:101"
msgid "<$comeff(2,17)><$motion(2,807)><$voicel(2,5)>¡Ojalá <$cdef(27)>Volcanion</color> hubiese probado mi <$cdef(27)>curri</color>!"
msgstr "<$comeff(2,17)><$motion(2,807)><$voicel(2,5)>¡Ojalá <$cdef(27)>Volcanion</color> hubiese probado mi <$cdef(27)>curry</color>!"

#. en: <$comeff(2,10)><$motion(2,664)><$voicel(2,9)>Ah, well. For now, I’ll work on my cooking skills to prepare<br>for the next time they show up!
msgctxt "2868:102"
msgid "<$comeff(2,10)><$motion(2,664)><$voicel(2,9)>Bueno, pos la próxima vez que se digne a visitarnos,<br>¡le haré uno de toma pan y moja!"
msgstr "<$comeff(2,10)><$motion(2,664)><$voicel(2,9)>Bueno, pos la próxima vez que se digne a visitarnos,<br>¡le haré uno de chuparse los dedos!"
