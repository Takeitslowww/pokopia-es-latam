#. en: <$comeff(1,6)><$motion(1,666)><$voicel(1,5)>Hm? Who might you be? Bit of a blank expression on yer<br>face there... <$emotion(1,38)><$voicel(1,8)>Well, I s’pose we can be friends if ya like!
msgctxt "2004:3"
msgid "<$comeff(1,6)><$motion(1,666)><$voicel(1,5)>¿Uy? ¿Tú quién eres, mozalbet<gen;-2(e,a)>? ¿Y a qué viene esa<br>cara de pasmarote?<clear><br><$emotion(1,38)><$voicel(1,8)>¡En fin, mucho gusto!"
msgstr "<$comeff(1,6)><$motion(1,666)><$voicel(1,5)>¿Uy? ¿Tú quién eres, mozalbet<gen;-2(e,a)>? ¿Y a qué viene esa<br>cara de asombro?<clear><br><$emotion(1,38)><$voicel(1,8)>¡En fin, mucho gusto!"

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,6)>Hm? Not sure I’ve seen the likes of you round here...<br><$emotion(1,29)><$voicel(1,7)>Are ya friends with <$cdef(27)><nowner;0></color>?<clear><br><$voicel(1,6)>That’d be somethin’ we have in common, anyhow.<clear><br><$emotion(1,38)><$voicel(1,10)>Maybe we could be friends too!
msgctxt "2004:4"
msgid "<oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,6)>Recórcholis, tu cara no me suena...<clear><br><$emotion(1,29)><$voicel(1,7)>Hmm... ¿No serás amiguit<gen;-2(o,a)> de <$cdef(27)><nowner;0><br></color>por un casual<slide><br>de los casuales?<clear><br><$voicel(1,6)>Pues mira tú qué cosa, ya tenemos algo en común tú y yo.<br><$emotion(1,38)><$voicel(1,10)>¡Encantad<gen;-3(o,a)> de conocerte, mocit<gen;-2(o,a)>!"
msgstr "<oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,6)>Recórcholis, tu cara no me suena...<clear><br><$emotion(1,29)><$voicel(1,7)>Hmm... ¿No serás amiguit<gen;-2(o,a)> de <$cdef(27)><nowner;0><br></color>por casualidad<slide><br>de las casualidades?<clear><br><$voicel(1,6)>Pues mira tú qué cosa, ya tenemos algo en común tú y yo.<br><$emotion(1,38)><$voicel(1,10)>¡Encantad<gen;-3(o,a)> de conocerte, mocit<gen;-2(o,a)>!"

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,6)>Hm? Not sure I’ve seen the likes of you ’round here...<clear><br><$emotion(1,29)><$voicel(1,7)>Are ya friends with <$cdef(27)><acqpname;0></color>?<clear><br><$voicel(1,6)>That’d be somethin’ we have in common, anyhow.<clear><br><$emotion(1,38)><$voicel(1,10)>Maybe we could be friends too!
msgctxt "2004:5"
msgid "<oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,6)>Recórcholis, tu cara no me suena...<clear><br><$emotion(1,29)><$voicel(1,7)>Hmm... ¿No serás amiguit<gen;-2(o,a)> de <$cdef(27)><acqpname;0></color><br>por un casual<slide><br>de los casuales?<clear><br><$voicel(1,6)>Pues mira tú qué cosa, ya tenemos algo en común tú y yo.<br><$emotion(1,38)><$voicel(1,10)>¡Encantad<gen;-3(o,a)> de conocerte, mocit<gen;-2(o,a)>!"
msgstr "<oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,6)>Recórcholis, tu cara no me suena...<clear><br><$emotion(1,29)><$voicel(1,7)>Hmm... ¿No serás amiguit<gen;-2(o,a)> de <$cdef(27)><acqpname;0></color><br>por casualidad<slide><br>de las casualidades?<clear><br><$voicel(1,6)>Pues mira tú qué cosa, ya tenemos algo en común tú y yo.<br><$emotion(1,38)><$voicel(1,10)>¡Encantad<gen;-3(o,a)> de conocerte, mocit<gen;-2(o,a)>!"

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,6)>Hm? Not sure I’ve seen the likes of you ’round here...<clear><br><$emotion(1,29)><$voicel(1,8)>Are ya friends with that Pokémon over there?<clear><br><$voicel(1,6)>That’d be somethin’ we have in common, anyhow.<clear><br><$emotion(1,38)><$voicel(1,10)>Maybe we could be friends too!
msgctxt "2004:6"
msgid "<oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,6)>Recórcholis, tu cara no me suena...<clear><br><$emotion(1,29)><$voicel(1,8)>Hmm... ¿No serás amiguit<gen;-2(o,a)> de... otro Ditto, por un casual<br>de los casuales?<clear><br><$voicel(1,6)>Pues mira tú qué cosa, ya tenemos algo en común tú y yo.<br><$emotion(1,38)><$voicel(1,10)>¡Encantad<gen;-3(o,a)> de conocerte, mocit<gen;-2(o,a)>!"
msgstr "<oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,6)>Recórcholis, tu cara no me suena...<clear><br><$emotion(1,29)><$voicel(1,8)>Hmm... ¿No serás amiguit<gen;-2(o,a)> de... otro Ditto, por casualidad<br>de las casualidades?<clear><br><$voicel(1,6)>Pues mira tú qué cosa, ya tenemos algo en común tú y yo.<br><$emotion(1,38)><$voicel(1,10)>¡Encantad<gen;-3(o,a)> de conocerte, mocit<gen;-2(o,a)>!"

#. en: <$emotion(1,37)><$voicel(1,9)>That is a mighty fine aroma, if I do say so myself! So good<br>I couldn’t help but come right on back!
msgctxt "2004:8"
msgid "<$emotion(1,37)><$voicel(1,9)>¡Aquí huele que alimenta! ¡No he podido resistirme a<br>este olor exquisito!"
msgstr "<$emotion(1,37)><$voicel(1,9)>¡Aquí huele que alimenta! ¡No pude resistirme a<br>este olor exquisito!"

#. en: <oneline><$comeff(1,10)><$facial(1,4)><$voicel(1,9)><$motion(1,801)>Well, if it ain’t <$cdef(27)><pname;0></color>! How’s it going,<br>li’l buddy?
msgctxt "2004:9"
msgid "<oneline><$comeff(1,10)><$facial(1,4)><$voicel(1,9)><$motion(1,801)>¡Hombreee, pero si es <$cdef(27)><pname;0></color>!<br>¿Qué tal andamos, mocit<gen;-2(o,a)>?"
msgstr "<oneline><$comeff(1,10)><$facial(1,4)><$voicel(1,9)><$motion(1,801)>¡Vayaaa, pero si es <$cdef(27)><pname;0></color>!<br>¿Qué tal andamos, mocit<gen;-2(o,a)>?"

#. en: <$emotion(1,29)><$voicel(1,7)>Eh? And who might you be?<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Hmmm... I’ll wager you came here to have some fun, am I<br>right? Sure is a nice place for it.
msgctxt "2004:10"
msgid "<$emotion(1,29)><$voicel(1,7)>¡Caray, una cara nueva! ¿Y tú quién eres, mozalbet<gen;-2(e,a)>?<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Supongo que estarás por aquí de visita. Pues que sepas<br>que has venido al sitio apropiado."
msgstr "<$emotion(1,29)><$voicel(1,7)>¡Caray, una cara nueva! ¿Y tú quién eres, mozalbet<gen;-2(e,a)>?<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Supongo que estarás por aquí de visita. Pues que sepas<br>que viniste al lugar apropiado."

#. en: <$comeff(1,3)><$motion(1,661)><$voicel(1,5)>Hm... You ain’t from ’round these parts, are ya?<clear><br><$comeff(1,6)><$motion(1,666)><$voicel(1,7)>If ya know someone who knows this area front to back,<br>could I trouble ya to introduce me to ’em?
msgctxt "2004:11"
msgid "<$comeff(1,3)><$motion(1,661)><$voicel(1,5)>Vaya, vaya... O mucho me equivoco o tienes toda la pinta<br>de venir de muy lejos, jovencit<gen;-2(o,a)>.<clear><br><$comeff(1,6)><$motion(1,666)><$voicel(1,7)>Si sabes de alguien que conozca estos lares como la<br>palma de su mano, ¿serías tan amable de presentármelo?"
msgstr "<$comeff(1,3)><$motion(1,661)><$voicel(1,5)>Vaya, vaya... O mucho me equivoco o tienes toda la cara<br>de venir de muy lejos, jovencit<gen;-2(o,a)>.<clear><br><$comeff(1,6)><$motion(1,666)><$voicel(1,7)>Si sabes de alguien que conozca estos lares como la<br>palma de su mano, ¿serías tan amable de presentármelo?"

#. en: <$comeff(1,5)><$motion(1,803)><$voicel(1,7)>Well, howdy! You’re not from ’round these parts, are ya?<br>Hope gettin’ here wasn’t too rough on ya!<clear><br><$comeff(1,6)><$motion(1,666)><$voicel(1,5)>Say, you know anyone who knows the lay o’ the land here?<br>If so, I wouldn’t say no to a proper introduction!
msgctxt "2004:12"
msgid "<$comeff(1,5)><$motion(1,803)><$voicel(1,7)>¡Repámpanos, aquí tenemos a alguien venid<gen;-2(o,a)> de lejanas<br>tierras! Permíteme que te dé la bienvenida.<clear><br><$comeff(1,6)><$motion(1,666)><$voicel(1,5)>Y oye, ¿no conocerás por un casual de los casuales a<br>alguien que se mueva por aquí como Pedro por su casa?<clear><br>Si es así, ¡sería todo un detalle por tu parte que me lo<br>presentaras!"
msgstr "<$comeff(1,5)><$motion(1,803)><$voicel(1,7)>¡Repámpanos, aquí tenemos a alguien venid<gen;-2(o,a)> de lejanas<br>tierras! Permíteme que te dé la bienvenida.<clear><br><$comeff(1,6)><$motion(1,666)><$voicel(1,5)>Y oye, ¿no conocerás por casualidad de las casualidades a<br>alguien que se mueva por aquí como Pedro por su casa?<clear><br>Si es así, ¡sería todo un detalle por tu parte que me lo<br>presentaras!"

#. en: <$emotion(1,55)><$voicel(1,5)>Other Pokémon are always sniffin’ a whole bunch when<br>I’m around...<clear><br><$comeff(1,9)><$motion(1,806)><$facial(1,4)><$voicel(1,8)>They seem to like how I smell, though, so I don’t mind<br>one bit!
msgctxt "2004:46"
msgid "<$emotion(1,55)><$voicel(1,5)>Cuando se me acercan otros Pokémon, siempre los veo<br>olisqueando aquí y allá...<clear><br><$comeff(1,9)><$motion(1,806)><$facial(1,4)><$voicel(1,8)>Pero bueno, como veo tan felices a las criaturitas,<br>tampoco me lo tomo a mal."
msgstr ""

#. en: <$emotion(1,8)><$voicel(1,7)>I like my food a li’l on the harder side. Has a nicer, more<br>satisfyin’ crunch, y’know?
msgctxt "2004:47"
msgid "<$emotion(1,8)><$voicel(1,7)>Prefiero los alimentos más bien duros y poco maduros,<br>¡que ofrezcan algo de resistencia al hincarles el diente!"
msgstr ""

#. en: <oneline><$emotion(1,197)><$voicel(1,7)>Howdy, <$cdef(27)><pname;0></color>! Moseyin’ around the<br>water, huh?<clear><br><$emotion(1,973)><$voicel(1,8)>Hope ya find somethin’ interestin’!
msgctxt "2004:50"
msgid "<$emotion(1,197)><$voicel(1,7)>Anda, si es <gen;-2(el bueno,la buena)> de <$cdef(27)><pname;0></color>.<clear><br><$emotion(1,973)><$voicel(1,8)>¿Qué, deambulando por el agua? ¡A ver si encuentras<br>algo interesante!"
msgstr "<$emotion(1,197)><$voicel(1,7)>Vaya, si es <gen;-2(el bueno,la buena)> de <$cdef(27)><pname;0></color>.<clear><br><$emotion(1,973)><$voicel(1,8)>¿Qué, deambulando por el agua? ¡A ver si encuentras<br>algo interesante!"

#. en: <oneline><$emotion(1,8)><$voicel(1,7)>The <$cdef(27)><fqty(1)><class><usingp;0></color>’s<br>finished!<slide><br>Sure<slide><br>was<slide><br>a<slide><br>relief<slide><br>to<slide><br>see<slide><br>it<slide><br>all<slide><br>come<slide><br>together,<slide><br>I<slide><br>tell<slide><br>ya what.
msgctxt "2004:53"
msgid "<oneline><$emotion(1,8)><$voicel(1,7)>Qué gusto da terminar un trabajo bien hecho.<br><fcap><dart;0()><$cdef(27)><fqty(1)><usingp;0></color> <qty;0(ha,han)> quedado<slide><br>que dej<qty;0(a,an)><slide><br>a cualquiera<slide><br>sin palabras."
msgstr ""

#. en: <oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,7)>That <$cdef(27)><fqty(1)><class><usingp;0> </color>is<br>real nice!<clear><br><$emotion(1,37)><$voicel(1,10)>Sure would like to learn me a thing or two from whoever<br>built it!
msgctxt "2004:54"
msgid "<oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,7)>Una obra excelente,<br><dart;0()><$cdef(27)><fqty(1)><usingp;0></color>,<slide><br>sin duda.<slide><br><$emotion(1,37)><$voicel(1,10)>¡Ya me gustaría a mí saber hacer eso!"
msgstr "<oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,7)>Una obra excelente,<br><dart;0()><$cdef(27)><fqty(1)><usingp;0></color>,<slide><br>sin duda.<slide><br><$emotion(1,37)><$voicel(1,10)>¡Ya quisiera yo saber hacer eso!"

#. en: <$comeff(1,3)><$facial(1,1)><$motion(1,806)><$voicel(1,7)>I always try to stay sharp—literally! So jus’ lemme know if<br>ya ever need logs cut, ya hear?
msgctxt "2004:55"
msgid "<$comeff(1,3)><$facial(1,1)><$motion(1,806)><$voicel(1,7)>Aún me mantengo en buena forma, y si quieres que te lo<br>demuestre, trae unos troncos, que los parto en un suspiro."
msgstr ""

#. en: <$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,5)>If ya ever find yerself in the mood fer a li’l treasure hunt,<br>jus’ lemme know!
msgctxt "2004:56"
msgid "<$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,5)>Cuando te dispongas a buscar algún tesoro, no dudes<br>en hacérmelo saber, que yo te acompaño."
msgstr ""

#. en: <$comeff(1,10)><$facial(1,1)><$motion(1,806)><$voicel(1,8)>If there’s one thing I’m surely good at, it’s bein’ strong!<br>Lemme know if ya need any berries crushed, ya hear?
msgctxt "2004:57"
msgid "<$comeff(1,10)><$facial(1,1)><$motion(1,806)><$voicel(1,8)>Estoy más san<gen;-3(o,a)> que un roble, así que puedo pulverizar<br>bayas como si nada. ¡Avísame si te hago falta, moz<gen;-2(o,a)>!"
msgstr "<$comeff(1,10)><$facial(1,1)><$motion(1,806)><$voicel(1,8)>Estoy más san<gen;-3(o,a)> que un roble, así que puedo pulverizar<br>bayas como si nada. ¡Avísame si te hago falta, chic<gen;-2(o,a)>!"

#. en: <$comeff(1,3)><$facial(1,1)><$motion(1,806)><$voicel(1,8)>Lemme know if ya need somethin’ <$cdef(27)><$spwfull(33)>d</color> real good!<br>I’ll make it so ya forget anything was ever there!
msgctxt "2004:59"
msgid "<$comeff(1,3)><$facial(1,1)><$motion(1,806)><$voicel(1,8)>Si necesitas <$cdef(27)><$spwfull(33)></color> algo, no dudes en pedírmelo,<br>que no dejaré rastro o huella de lo que hubiera antes."
msgstr ""

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,9)>Faraway places are no big deal fer me! I can getcha<br>anywhere in no time!<clear><br><$comeff(1,10)><$facial(1,1)><$motion(1,661)><$voicel(1,7)>Lemme know if you’re ever searchin’ fer a specific<br>Pokémon!
msgctxt "2004:60"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,9)>Puedo llevarte en un visto y no visto adonde quieras.<br><$comeff(1,10)><$facial(1,1)><$motion(1,661)><$voicel(1,7)>¡Ideal en caso de que necesites buscar a un Pokémon!"
msgstr "<$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,9)>Puedo llevarte en un parpadeo adonde quieras.<br><$comeff(1,10)><$facial(1,1)><$motion(1,661)><$voicel(1,7)>¡Ideal en caso de que necesites buscar a un Pokémon!"

#. en: <$emotion(1,8)><$voicel(1,9)>Howdy, <$cdef(27)><pname;0></color>! So starts another day!
msgctxt "2004:101"
msgid "<$emotion(1,8)><$voicel(1,9)>¡Buenos días por la mañana, <$cdef(27)><pname;0></color>!<br>¡Comienza una nueva jornada!"
msgstr ""

#. en: <oneline><$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,7)><$cdef(27)><pname;0></color>! You’re sure fulla energy fer so<br>early<slide><br>in<slide><br>the mornin’!
msgctxt "2004:102"
msgid "<$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>¡Caray, te veo rebosante de energía ya de buena mañana,<br><$cdef(27)><pname;0></color>!"
msgstr "<$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>¡Caray, te veo rebosante de energía tan tempranito,<br><$cdef(27)><pname;0></color>!"

#. en: <$comeff(1,16)><$motion(1,807)><$voicel(1,3)>*yaaawn*<br>I sure do get sleepy ’round this time...
msgctxt "2004:103"
msgid "<$comeff(1,16)><$motion(1,807)><$voicel(1,3)>Uaaah... A mí a estas horas lo que me pide el cuerpo es<br>una buena cabezada reparadora."
msgstr "<$comeff(1,16)><$motion(1,807)><$voicel(1,3)>Uaaah... A mí a estas horas lo que me pide el cuerpo es<br>una buena siesta reparadora."

#. en: <oneline><$emotion(1,29)><$voicel(1,7)>Well, howdy, <$cdef(27)><pname;0></color>! Have ya had<br>lunch yet?
msgctxt "2004:104"
msgid "<oneline><$emotion(1,29)><$voicel(1,7)>¿Cómo andamos, <$cdef(27)><pname;0></color>?<br>Qué hambrecilla, ¿no?"
msgstr "<oneline><$emotion(1,29)><$voicel(1,7)>¿Cómo andamos, <$cdef(27)><pname;0></color>?<br>Qué hambrecita, ¿no?"

#. en: <$comeff(1,6)><$motion(1,666)><$voicel(1,5)>Not quite afternoon or evenin’... What do ya s’pose most<br>folks get up to at this hour?
msgctxt "2004:105"
msgid "<$comeff(1,6)><$motion(1,666)><$voicel(1,5)>Y digo yo, ¿a qué se dedica la gente a estas horas tontas<br>de la tarde, antes de que caiga la noche?"
msgstr ""

#. en: <$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>I sure do get a little wistful in the evenin’. I figure it’s a li’l<br>bit of loneliness creepin’ in—or somethin’ like that!
msgctxt "2004:106"
msgid "<$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Durante los atardeceres me pongo un poco sentimental...<br>Será que me invade una leve melancolía, ¡vete tú a saber!"
msgstr "<$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Durante los atardeceres me pongo un poco sentimental...<br>Será que me invade una leve melancolía, ¡quién sabe!"

#. en: <$emotion(1,38)><$voicel(1,7)>Sure is quiet at night... Too quiet. Kinda makes ya wanna<br>cause a ruckus, don’t it?!
msgctxt "2004:107"
msgid "<$emotion(1,38)><$voicel(1,7)>Qué tranquilo se queda todo a estas horas de la noche...<br>¡Tanto que me dan ganas de armar un poco de alboroto!"
msgstr ""

#. en: <$emotion(1,29)><$voicel(1,5)>Well, I declare! Are you one o’ them nocturnal Pokémon?
msgctxt "2004:108"
msgid "<$emotion(1,29)><$voicel(1,5)>¡Vaya, no me digas que tú eres más bien de costumbres<br>nocturnas!"
msgstr ""

#. en: <oneline><$emotion(1,8)><$voicel(1,9)>Well, howdy, <$cdef(27)><pname;0></color>! Sure am glad ya<br>came<slide><br>to<slide><br>see<slide><br>li’l<slide><br>ol’<slide><br>me today!
msgctxt "2004:109"
msgid "<$emotion(1,8)><$voicel(1,9)>Bueno, bueno, bueno... ¡pero mira a quién tenemos por<br>aquí hoy! ¡Nada menos que a <$cdef(27)><pname;0></color>!"
msgstr ""

#. en: <$emotion(1,14)><$voicel(1,7)>Oh! You need somethin’? I’ll help out any way I can!
msgctxt "2004:110"
msgid "<$emotion(1,14)><$voicel(1,7)>¿Qué se te ofrece, jovenzuel<gen;-2(o,a)>? ¿O acaso quieres que sea<br>yo quien te ofrezca mi ayuda? Si es así, ¡aquí me tienes!"
msgstr ""

#. en: <$emotion(1,38)><$voicel(1,9)>A little eatin’, a little sleepin’, a little runnin’ around—and<br>before ya know it, the day’s over!
msgctxt "2004:111"
msgid "<$emotion(1,38)><$voicel(1,9)>Entre que almuerzas, te echas la siesta y das un garbeo,<br>¡se te pasa el día volando!"
msgstr "<$emotion(1,38)><$voicel(1,9)>Entre que almuerzas, te echas la siesta y das una vuelta,<br>¡se te pasa el día volando!"

#. en: <$comeff(1,14)><$motion(1,807)><$voicel(1,5)>Think I might take me a li’l break ’round here someplace.
msgctxt "2004:112"
msgid "<$comeff(1,14)><$motion(1,807)><$voicel(1,5)>Me parece a mí que voy a reposar un poquito por aquí."
msgstr ""

#. en: <oneline><$emotion(1,60)><$voicel(1,9)>Oh, howdy, <$cdef(27)><pname;0></color>! Lemme know if<br>there’s<slide><br>anything<slide><br>I can<slide><br>do<slide><br>fer ya!
msgctxt "2004:113"
msgid "<$cdef(27)><$emotion(1,60)></color><$voicel(1,9)>¿Qué tal? ¿Vamos tirando? Si tienes algún favorcillo<br>que pedirme, ¡hazlo sin remilgos!"
msgstr "<$cdef(27)><$emotion(1,60)></color><$voicel(1,9)>¿Qué tal? ¿Cómo va todo? Si tienes algún favorcito<br>que pedirme, ¡hazlo sin remilgos!"

#. en: <oneline><$emotion(1,8)><$voicel(1,9)>Howdy, <$cdef(27)><pname;0></color>! Great timin’! I was jus’<br>startin’<slide><br>to<slide><br>get bored!
msgctxt "2004:114"
msgid "<oneline><$emotion(1,8)><$voicel(1,9)>¡Me alegro de verte, <$cdef(27)><pname;0></color>!<br>Justo andaba yo<slide><br>pensando<slide><br>en lo aburrid<gen;-3(o,a)> que estaba."
msgstr ""

#. en: <$emotion(1,50)><$voicel(1,7)>I dunno why, but I get real excited when I see me a<br>strong-lookin’ Pokémon!
msgctxt "2004:115"
msgid "<$emotion(1,50)><$voicel(1,7)>Ver Pokémon con pinta de fuertotes es algo que me llena<br>de ilusión. ¡Me recuerdan a mí en mis tiempos mozos!"
msgstr "<$emotion(1,50)><$voicel(1,7)>Ver Pokémon con pinta de fuertotes me emociona<br>muchísimo. ¡Me recuerdan a mí en mis tiempos mozos!"

#. en: <$emotion(1,51)><$voicel(1,5)>When I’m feelin’ lazy, I can go the whole dang day without<br>gettin’ anything done...
msgctxt "2004:116"
msgid "<$emotion(1,51)><$voicel(1,5)>Cuando me siento holgaz<gen;-3(án,ana)>, se me acaba el día sin<br>haber dado un palo al agua."
msgstr "<$emotion(1,51)><$voicel(1,5)>Cuando me siento holgaz<gen;-3(án,ana)>, se me acaba el día sin<br>haber movido un dedo."

#. en: <$emotion(1,60)><$voicel(1,9)>You’re always so busy! Don’t forget to eat, ya hear?
msgctxt "2004:117"
msgid "<$emotion(1,60)><$voicel(1,9)>Te veo siempre muy ataread<gen;-2(o,a)>, mocit<gen;-2(o,a)>. ¡Que no me entere<br>yo de que te estás saltando un almuerzo como es debido!"
msgstr ""

#. en: <$emotion(1,8)><$voicel(1,9)>I’m really enjoyin’ goin’ for walks lately! And I can check<br>out new places while I’m out ’n’ about!
msgctxt "2004:118"
msgid "<$emotion(1,8)><$voicel(1,9)>¿Sabes a qué me dedico últimamente? ¡A dar paseos!<br>Así aprovecho para enterarme de qué se cuece por ahí."
msgstr "<$emotion(1,8)><$voicel(1,9)>¿Sabes a qué me dedico últimamente? ¡A dar paseos!<br>Así aprovecho para enterarme de qué pasa por ahí."

#. en: <oneline><$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>You makin’ stuff again today, <$cdef(27)><pname;0></color>?<br>You’re<slide><br>always<slide><br>workin’<slide><br>so hard!
msgctxt "2004:119"
msgid "<$cdef(27)><$comeff(1,1)></color><$facial(1,4)><$motion(1,803)><$voicel(1,9)>¿Hoy también tienes pensado fabricar alguna cosa?<br>Tú siempre tan afanad<gen;-2(o,a)>."
msgstr "<$cdef(27)><$comeff(1,1)></color><$facial(1,4)><$motion(1,803)><$voicel(1,9)>¿Hoy también tienes pensado fabricar alguna cosa?<br>Tú siempre tan dedicad<gen;-2(o,a)>."

#. en: <$emotion(1,63)><$voicel(1,9)>This sure is a pleasant place to be—and it’s all thanks to<br>you, if I do say so myself!
msgctxt "2004:120"
msgid "<$emotion(1,63)><$voicel(1,9)>En esta zona se vive de maravilla, ¡y todo gracias a ti!"
msgstr ""

#. en: <$comeff(1,16)><$facial(1,14)><$voicel(1,3)>Zzzzzz... ZzzZZZzzz... <wait(0.4)><$comeff(1,6)><$facial(1,1)>Zz—?<clear><br><$motion(1,807)>Oh, howdy, <$cdef(27)><pname;0></color>... *yawn*
msgctxt "2004:121"
msgid "<oneline><$comeff(1,16)><$facial(1,14)><$voicel(1,3)>Roooooonc... Fiuuu...<wait(0.4)><$comeff(1,6)><$facial(1,1)> ¿Mñrm? <wait(0.4)><$motion(1,807)>Ah, eres tú,<br><$cdef(27)><pname;0></color>...<slide><br>Uaaah..."
msgstr ""

#. en: <$comeff(1,16)><$motion(1,807)><$voicel(1,3)>Hnnngh... What in tarnation, <$cdef(27)><pname;0></color>?
msgctxt "2004:122"
msgid "<oneline><$comeff(1,16)><$motion(1,807)><$voicel(1,3)>Mñrm... ¿Qué tripa se te ha roto,<br><$cdef(27)><pname;0></color>?"
msgstr "<oneline><$comeff(1,16)><$motion(1,807)><$voicel(1,3)>Mñrm... ¿Y ahora qué pasa,<br><$cdef(27)><pname;0></color>?"

#. en: <$comeff(1,10)><$motion(1,803)><$voicel(1,7)>Everything ’round here is new to me. I sure won’t get<br>bored any time soon, I tell you what.
msgctxt "2004:123"
msgid "<$comeff(1,10)><$motion(1,803)><$voicel(1,7)>En este lugar hay tanto por descubrir que voy a estar bien<br>entretenid<gen;-3(o,a)> por un tiempo."
msgstr ""

#. en: <$comeff(1,10)><$motion(1,824)><$voicel(1,7)>I ain’t so knowledgeable about this place. I’m gonna hafta<br>rely on you a bit, ya hear? Thank ya kindly!
msgctxt "2004:124"
msgid "<$comeff(1,10)><$motion(1,824)><$voicel(1,7)>No estoy todavía muy familiarizad<gen;-3(o,a)> con el vecindario<br>que digamos, así que quizá tenga que darte la tabarra."
msgstr "<$comeff(1,10)><$motion(1,824)><$voicel(1,7)>No estoy todavía muy familiarizad<gen;-3(o,a)> con el vecindario<br>que digamos, así que tal vez tenga que pedirte ayuda."

#. en: <$comeff(1,10)><$motion(1,806)><$voicel(1,7)>Now this looks like a nice spot fer a leisurely li’l walk.
msgctxt "2004:125"
msgid "<$comeff(1,10)><$motion(1,806)><$voicel(1,7)>Dar un paseíto por la zona para bajar un poco la comida<br>me parece una idea estupenda."
msgstr ""

#. en: <$comeff(1,6)><$motion(1,827)><$voicel(1,5)>What’re they makin’, I wonder? I’ll hafta come back and<br>see it later.
msgctxt "2004:126"
msgid "<$comeff(1,6)><$motion(1,827)><$voicel(1,5)>Córcholis, ¿se puede saber qué están construyendo?<br>Tendré que echar un ojo más tarde para ver el percal."
msgstr "<$comeff(1,6)><$motion(1,827)><$voicel(1,5)>Córcholis, ¿se puede saber qué están construyendo?<br>Tendré que echar un ojo más tarde para ver qué es."

#. en: <$emotion(1,8)><$voicel(1,9)>Ready to <$cdef(27)><$spwfull(1)> </color>away whenever! Jus’ say the word.<br>I’m itchin’ to get started!
msgctxt "2004:127"
msgid "<$emotion(1,8)><$voicel(1,9)>Oye, yo me pongo a <$cdef(27)><$spwfull(1)> </color>cuando tú mandes,<br>¿eh? ¡Uf, no veo la hora de empezar!"
msgstr ""

#. en: <$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>This place is jus’ hustlin’ and bustlin’ with Pokémon these<br>days, ain’t it?!
msgctxt "2004:128"
msgid "<$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Bueno, bueno, bueno... ¡Está muy animada la cosa con<br>semejante cantidad de Pokémon que pululan por aquí!"
msgstr ""

#. en: <$comeff(1,14)><$facial(1,9)><$motion(1,827)><$voicel(1,3)>My home’s not bad or anything, but it could do with a li’l<br>touchin’ up...
msgctxt "2004:129"
msgid "<$comeff(1,14)><$facial(1,9)><$motion(1,827)><$voicel(1,3)>Mi hogar estar, lo que es estar, no está mal..."
msgstr ""

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>My home’s feelin’ nicer lately!
msgctxt "2004:130"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>¡Últimamente mi hogar está más acogedor!"
msgstr ""

#. en: <$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>My home’s downright pleasant these days, I do declare!<br>Thank ya kindly, <$cdef(27)><pname;0></color>!
msgctxt "2004:131"
msgid "<$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Mi hogar actual es todo un palacete, ¡y el mérito es todo<br>tuyo, mocit<gen;-2(o,a)>!"
msgstr ""

#. en: <oneline><$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>Well, howdy, <$cdef(27)><pname;0></color>! Sure is nice to<br>see ya!
msgctxt "2004:132"
msgid "<$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>¡Cuánto me alegro de verte, <$cdef(27)><pname;0></color>!"
msgstr ""

#. en: <oneline><$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Goodness gracious! You’ve done so much for me,<br><$cdef(27)><pname;0></color>!<slide><br>I’m<slide><br>truly grateful!
msgctxt "2004:133"
msgid "<$cdef(27)><$comeff(1,13)></color><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Ayyy, ¿qué haría yo sin ti, jovenzuel<gen;-2(o,a)>? ¡Muchas gracias<br>de todo corazón!"
msgstr ""

#. en: <$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Takin’ a li’l trip every now and then is kinda nice! Hope<br>you’ll invite me again sometime!
msgctxt "2004:134"
msgid "<$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Una excursioncilla no viene nada mal de vez en cuando.<br>La próxima vez que vayas por ahí, ¡no dudes en invitarme!"
msgstr "<$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Una excursioncita no viene nada mal de vez en cuando.<br>La próxima vez que vayas por ahí, ¡no dudes en invitarme!"

#. en: <oneline><$comeff(1,3)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>Howdy, <$cdef(27)><pname;0></color>! Did ya take a trip<br>someplace?<slide><br>You’re<slide><br>always<slide><br>so busy!
msgctxt "2004:135"
msgid "<$comeff(1,3)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>¡Oooh, no me digas que has ido a darte un buen garbeo!<br>¡Tú siempre tan ocupad<gen;-2(o,a)>, <$cdef(27)><pname;0></color>!"
msgstr "<$comeff(1,3)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>¡Oooh, no me digas que fuiste a dar un buen paseo!<br>¡Tú siempre tan ocupad<gen;-2(o,a)>, <$cdef(27)><pname;0></color>!"

#. en: <oneline><$comeff(1,14)><$voicel(1,5)>Looks like ya went out mighty far today, huh<br><$cdef(27)><pname;0></color>?<slide><br><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,8)>Glad<slide><br>to<slide><br>see<slide><br>ya<slide><br>full<slide><br>o’ energy!
msgctxt "2004:136"
msgid "<$comeff(1,14)><$voicel(1,5)>Caray, por lo visto esta vez has estado en las quimbambas,<br>¿eh, <$cdef(27)><pname;0></color>?<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,8)>Pero bueno, se te ve fresc<gen;-2(o,a)> como una rosa, ¡y eso es<br>lo que cuenta!"
msgstr "<$comeff(1,14)><$voicel(1,5)>Caray, por lo visto esta vez te fuiste lejísimos,<br>¿eh, <$cdef(27)><pname;0></color>?<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,8)>Pero bueno, se te ve fresc<gen;-2(o,a)> como una rosa, ¡y eso es<br>lo que cuenta!"

#. en: <$emotion(1,14)><$voicel(1,7)>If I find anythin’ interestin’ out there, I’ll toss it into the ol’<br><$cdef(27)><fqty(1)><$ifull(1460)></color>! <$emotion(1,8)><$voicel(1,10)>Think of it like a present from yours<slide><br>truly to you, truly!
msgctxt "2004:137"
msgid "<$emotion(1,14)><$voicel(1,7)>Si encuentro algo útil, ¡a una <$cdef(27)><fqty(1)><$ifull(1460)> </color>que va!<br><$emotion(1,8)><$voicel(1,10)>Considéralo como un regalito para ti de <gen;-3(un servidor,una servidora)>."
msgstr ""

#. en: <$emotion(1,13)><$voicel(1,6)>Bang bang, clang clang, zrrr-zrrr-zrrr...<clear><br><$emotion(1,37)><$voicel(1,7)>Oh howdy! Jus’ doin’ some visualization trainin’ fer the<br>next time I <$cdef(27)><$spwfull(1)> </color>somethin’!
msgctxt "2004:138"
msgid "<$emotion(1,13)><$voicel(1,6)>Pam, pam, clang, clang, brrrt, brrrt...<clear><br><$emotion(1,37)><$voicel(1,7)>Aquí ando, dedicándome a <$cdef(27)><$spwfull(1)></color> con la mente.<br>Por eso de \"la práctica pensante es práctica y edificante\"."
msgstr ""

#. en: <$emotion(1,60)><$voicel(1,9)>You need some heat? One extra-hot flame, comin’<br>right up!
msgctxt "2004:139"
msgid "<$emotion(1,60)><$voicel(1,9)>¿Necesitas una buena llama de las mías? ¡Pues marchando<br>una de fuego requetecaliente!"
msgstr "<$emotion(1,60)><$voicel(1,9)>¿Necesitas una buena llama de las mías? ¡Pues sale<br>una de fuego requetecaliente!"

#. en: <$emotion(1,8)><$voicel(1,9)>You need somethin’ watered? Piece o’ cake! I’ll get the job<br>done right away—anytime, anywhere!
msgctxt "2004:140"
msgid "<$emotion(1,8)><$voicel(1,9)>¿Te ayudo a regar? ¡Será un juego de niños para mí!<br>Con uno de mis chorros humedeceré lo que sea."
msgstr ""

#. en: <$comeff(1,10)><$motion(1,803)><$voicel(1,7)>When a machine ain’t workin’, you jus’ gotta give it a good<br>smack! And if that don’t work, a bit o’ electricity!<clear><br><$emotion(1,8)><$voicel(1,10)>Anyway, I’m good with machines, so jus’ leave ’em to me!
msgctxt "2004:141"
msgid "<$comeff(1,10)><$motion(1,803)><$voicel(1,7)>Cuando un cachivache no furula, ¡te digo yo que un buen<br>coscorrón lo pone a andar! Y si no, ya sabes qué se dice:<slide><br>si te falla el porrazo, prueba un calambrazo.<clear><br><$emotion(1,8)><$voicel(1,10)>Déjalo en mis manos, que yo para los cacharros y demás<br>soy <gen;-3(un,una)> manitas."
msgstr "<$comeff(1,10)><$motion(1,803)><$voicel(1,7)>Cuando un cachivache no funciona, ¡te digo yo que un buen<br>coscorrón lo pone a andar! Y si no, ya sabes qué se dice:<slide><br>si te falla el porrazo, prueba un calambrazo.<clear><br><$emotion(1,8)><$voicel(1,10)>Déjalo en mis manos, que yo para los cacharros y demás<br>soy <gen;-3(un,una)> especialista."

#. en: <oneline><$emotion(1,60)><$voicel(1,7)>You need any <$cdef(27)><fqty(2)><class><pdcitem;0></color>?<br>Feel<slide><br>free<slide><br>to<slide><br>take<slide><br>any<slide><br>ya<slide><br>find<slide><br>lyin’<slide><br>around, y’hear?
msgctxt "2004:143"
msgid "<oneline><$emotion(1,60)><$voicel(1,7)>¿No te har<qty;0(á,án)> falta <genqty;0(algún,alguna,algunos,algunas)><br><$cdef(27)><fqty(1)><class><pdcitem;0></color>?<slide><br>Si <genqty;0(lo,la,los,las)> necesitas,<slide><br>tú sírvete sin remilgos."
msgstr ""

#. en: <$emotion(1,1)><$voicel(1,9)>The <$cdef(27)><fqty(1)><$ifull(1325)> </color>sure is a convenient machine, ain’t it?<br>Can’t wait for the next time I get to do some <$cdef(27)><$spwfull(12)>s</color>!
msgctxt "2004:144"
msgid "<$emotion(1,1)><$voicel(1,9)>Mira que es práctica la <$cdef(27)><fqty(1)><$ifull(1325)></color>. Ya estoy<br>con el gusanillo de ponerme a <$cdef(27)><$spwfull(12)> </color>de nuevo."
msgstr "<$emotion(1,1)><$voicel(1,9)>Mira que es práctica la <$cdef(27)><fqty(1)><$ifull(1325)></color>. Ya estoy<br>con ganas de ponerme a <$cdef(27)><$spwfull(12)> </color>de nuevo."

#. en: <oneline><$emotion(1,37)><$voicel(1,7)>I reckon this here home suits <$cdef(27)><wndhmownerpk;0><br></color>to a T!
msgctxt "2004:148"
msgid "<$emotion(1,37)><$voicel(1,7)>Hm... Se mire por donde se mire, este hogar tiene la seña<br>de identidad <esde;0()><$cdef(27)><wndhmownerpk;0></color>."
msgstr ""

#. en: <$comeff(1,9)><$motion(1,806)><$voicel(1,7)>I dunno why, but takin’ in the sights ’round here sure does<br>gimme the warm ’n’ fuzzies.
msgctxt "2004:149"
msgid "<$comeff(1,9)><$motion(1,806)><$voicel(1,7)>Por alguna extraña razón, es contemplar este paisaje y<br>sentir en mi interior una profunda paz."
msgstr ""

#. en: <oneline><$emotion(1,38)><$voicel(1,9)>This here <$cdef(27)><fqty(1)><class><usingp;0><br></color>sure<slide><br>is<slide><br>interestin’!<slide><br>Gahaha!
msgctxt "2004:150"
msgid "<$emotion(1,38)><$voicel(1,9)>¡Bua, ja, ja! ¡Me estoy partiendo de risa con <genqty;0(este,esta,estos,estas)><br><$cdef(27)><fqty(1)><class><usingp;0></color>!"
msgstr "<$emotion(1,38)><$voicel(1,9)>¡Bua, ja, ja! ¡Me estoy muriendo de risa con <genqty;0(este,esta,estos,estas)><br><$cdef(27)><fqty(1)><class><usingp;0></color>!"

#. en: <$comeff(1,6)><$motion(1,666)><$voicel(1,5)>Huh... Now what on earth is this?
msgctxt "2004:151"
msgid "<$comeff(1,6)><$motion(1,666)><$voicel(1,5)>¿Eh?... ¿Y esto qué viene siendo?"
msgstr ""

#. en: <oneline><$emotion(1,6)><$voicel(1,7)>This here <$cdef(27)><fqty(1)><class><usingp;0></color>...<br>Somethin’<slide><br>about<slide><br>it<slide><br>is<slide><br>jus’<slide><br>downright<slide><br>adorable!
msgctxt "2004:152"
msgid "<oneline><$emotion(1,6)><$voicel(1,7)>¡Repámpanos! Es ver <genqty;0(este,esta,estos,estas)><br><$cdef(27)><fqty(1)><class><usingp;0><slide><br></color>y quedarme<slide><br>prendad<gen;-3(o,a)>."
msgstr "<oneline><$emotion(1,6)><$voicel(1,7)>¡Cielos! Es ver <genqty;0(este,esta,estos,estas)><br><$cdef(27)><fqty(1)><class><usingp;0><slide><br></color>y quedarme<slide><br>prendad<gen;-3(o,a)>."

#. en: <oneline><$emotion(1,14)><$voicel(1,5)>This here <$cdef(27)><fqty(1)><class><usingp;0></color>?<br>I was<slide><br>jus’<slide><br>ganderin’<slide><br>at it...
msgctxt "2004:153"
msgid "<oneline><$emotion(1,14)><$voicel(1,5)>No me preguntes por qué, pero te digo que no logro<br>apartar la vista de <genqty;0(este,esta,estos,estas)><slide><br><$cdef(27)><fqty(1)><class><usingp;0></color>."
msgstr ""

#. en: <oneline><$emotion(1,8)><$voicel(1,9)><fcap><iart;0()><$cdef(27)><fqty(1)><class><usingp;0></color>, huh?<br>I like<slide><br>it!<slide><br>I sure do!
msgctxt "2004:155"
msgid "<oneline><$emotion(1,8)><$voicel(1,9)>¡Así que aquí tenemos<br><iart;0()><fqty(1)><$cdef(27)><class><usingp;0></color>!<slide><br>¡Pues <qty;0(está,están)> muuuy<slide><br>pero que muy bien!"
msgstr "<oneline><$emotion(1,8)><$voicel(1,9)>¡Así que aquí tenemos<br><iart;0()><fqty(1)><$cdef(27)><class><usingp;0></color>!<slide><br>¡Pues <qty;0(está,están)> muuuy<slide><br>pero muy bien!"

#. en: <$emotion(1,55)><$voicel(1,5)>Hmmm... Sure does look like me. Naw, on second thought,<br>I’m a far sight more handsome!
msgctxt "2004:156"
msgid "<$emotion(1,55)><$voicel(1,5)>Hmm, parecerse lo que es parecerse a mí, se parece...<br>Aunque le faltan mi encanto y carisma, dónde va a parar."
msgstr "<$emotion(1,55)><$voicel(1,5)>Hmm, parecerse lo que es parecerse a mí, se parece...<br>Aunque le faltan mi encanto y carisma, claro está."

#. en: <oneline><$emotion(1,38)><$voicel(1,9)><qty;0(This,These)> here <$cdef(27)><fqty(1)><noweating;0> </color><qty;0(is,are)> tasty!<br>Yum-yum!
msgctxt "2004:157"
msgid "<oneline><$emotion(1,38)><$voicel(1,9)>¡<fcap><dart;0()><$cdef(27)><fqty(1)><noweating;0> </color><genqty;0(este,esta,estos,estas)><$cdef(27)> </color>est<qty;0(á,án)> de<br>rechupete!"
msgstr "<oneline><$emotion(1,38)><$voicel(1,9)>¡<fcap><dart;0()><$cdef(27)><fqty(1)><noweating;0> </color><genqty;0(este,esta,estos,estas)><$cdef(27)> </color>est<qty;0(á,án)> para<br>chuparse los dedos!"

#. en: <$comeff(1,7)><$motion(1,807)><$voicel(1,5)>Well, now, that’s not my favorite flavor in the world...but<br>food’s food, I s’pose!
msgctxt "2004:158"
msgid "<$comeff(1,7)><$motion(1,807)><$voicel(1,5)>Gustar, esto no me gusta ni pizca, las cosas como son.<br>Pero engullir y rascar, todo es empezar..."
msgstr ""

#. en: <oneline><$emotion(1,38)><$voicel(1,9)>Way to go, <$cdef(27)><pname;0></color>! Piece o’ cake for<br>you,<slide><br>I’m sure!
msgctxt "2004:159"
msgid "<oneline><$emotion(1,38)><$voicel(1,9)>¡Caramba, <$cdef(27)><pname;0></color>! Se ve que esto es<br>lo tuyo."
msgstr ""

#. en: <$emotion(1,14)><$voicel(1,7)>Wowee! Didn’t know <$cdef(27)><blsspwkpk;0></color> could do that!
msgctxt "2004:160"
msgid "<oneline><$emotion(1,14)><$voicel(1,7)>¡Cáspita! No sabía que <dart;0()><$cdef(27)><blsspwkpk;0> </color>fuese capaz<br>de algo así."
msgstr "<oneline><$emotion(1,14)><$voicel(1,7)>¡Cáspita! No sabía que <dart;0()><$cdef(27)><blsspwkpk;0> </color>fuera capaz<br>de algo así."

#. en: <$emotion(1,38)><$voicel(1,9)>Haha! Betcha didn’t know I’m actually a real good runner!
msgctxt "2004:161"
msgid "<$emotion(1,38)><$voicel(1,9)>¡Bua, ja, ja! No pensabas que se me fuera a dar tan bien<br>el pillapilla, ¿eh? ¡<gen;-2(El,La)> que se ha quedado pillad<gen;-2(o,a)> eres tú!"
msgstr "<$emotion(1,38)><$voicel(1,9)>¡Bua, ja, ja! No pensabas que se me fueran a dar tan bien<br>las atrapadas, ¿eh? ¡<gen;-2(El,La)> que quedó atrapad<gen;-2(o,a)> eres tú!"

#. en: <oneline><$emotion(1,8)><$voicel(1,9)><$pkcry;0(1,2)>! ♪ I do believe<br><$cdef(27)><nnowpairpk;1></color><slide><br>is<slide><br>a<slide><br>promisin’<slide><br>individual!
msgctxt "2004:162"
msgid "<oneline><$emotion(1,8)><$voicel(1,9)>¡Le auguro un gran porvenir<br><esa;1()><$cdef(27)><nnowpairpk;1></color>!<slide><br>♪¡<$pkcry;0(1,2)>!♪"
msgstr ""

#. en: <$comeff(1,16)><$motion(1,807)><$voicel(1,3)>I’m startin’ to get sleepy... Be sure to rest when ya need<br>it, <$cdef(27)><pname;0></color>.
msgctxt "2004:163"
msgid "<$comeff(1,16)><$motion(1,807)><$voicel(1,3)>Ya no tengo edad para trasnochar. Procura tú también<br>descansar como es debido, <$cdef(27)><pname;0></color>."
msgstr ""

#. en: <$voicel(1,7)>*yaaawn* <wait(0.4)><$comeff(1,5)><$motion(1,805)>Hngh?! PTOOEY!!! Somethin’ done flew into<br>my mouth!
msgctxt "2004:164"
msgid "<$voicel(1,7)>Uaaah... <wait(0.4)><$comeff(1,5)><$motion(1,805)>¡Eh! ¡Puaj! ¡Se me ha metido algo en la boca!"
msgstr "<$voicel(1,7)>Uaaah... <wait(0.4)><$comeff(1,5)><$motion(1,805)>¡Eh! ¡Puaj! ¡Se me metió algo en la boca!"

#. en: <$comeff(1,16)><$motion(1,807)><$voicel(1,3)>Well, I’ll be. Mornin’ comes before ya know it. Guess it’s<br>about time for me to sleep...
msgctxt "2004:165"
msgid "<$comeff(1,16)><$motion(1,807)><$voicel(1,3)>En cuanto quieres darte cuenta ya ha amanecido, así que<br>será mejor que me vaya yendo a la piltra."
msgstr "<$comeff(1,16)><$motion(1,807)><$voicel(1,3)>Cuando menos te das cuenta, ya amaneció, así que<br>será mejor que me vaya yendo a la cama."

#. en: <$comeff(1,16)><$motion(1,803)><$voicel(1,3)>It’s about time for me to get some shut-eye. Don’t forget<br>to rest a bit yourself, <$cdef(27)><pname;1></color>!
msgctxt "2004:166"
msgid "<$cdef(27)><$comeff(1,16)></color><$motion(1,803)><$voicel(1,3)>Bueeeno, va siendo hora de irse al catre... ¡Y que no me<br>entere yo de que no descansas como es debido, mocit<gen;-2(o,a)>!"
msgstr "<$cdef(27)><$comeff(1,16)></color><$motion(1,803)><$voicel(1,3)>Bueeeno, va siendo hora de irse a dormir... ¡Y que no me<br>entere yo de que no descansas como es debido, mocit<gen;-2(o,a)>!"

#. en: <$emotion(1,38)><$voicel(1,7)>Lemme tell ya somethin’ about flyin’—you can’t force it!<br>The trick is how well you can let the wind carry you!
msgctxt "2004:167"
msgid "<$emotion(1,38)><$voicel(1,7)>Volar tiene su intríngulis, jovenzuel<gen;-2(o,a)>. No se trata de usar<br>la fuerza bruta, sino de cabalgar el viento con criterio."
msgstr ""

#. en: <$emotion(1,8)><$voicel(1,7)>When the moonlight hits me jus’ right, that’s when I truly<br>shine—literally! I sparkle like you wouldn’t believe!
msgctxt "2004:168"
msgid "<$emotion(1,8)><$voicel(1,7)>Cuando la luz de la luna se refleja en este cuerpo serrano,<br>¡estoy aún más arrebatad<gen;-3(or,ora)> de lo normal!"
msgstr "<$emotion(1,8)><$voicel(1,7)>Cuando la luz de la luna se refleja en este cuerpazo,<br>¡estoy aún más arrebatad<gen;-3(or,ora)> de lo normal!"

#. en: <oneline><$comeff(1,14)><$motion(1,805)><$voicel(1,5)>I see ya runnin’ about all willy-nilly,<br><$cdef(27)><pname;0></color>.<slide><br>But<slide><br>ya<slide><br>better<slide><br>watch yerself!<clear><br><$emotion(1,37)><$voicel(1,9)>It’d really hurt if ya ran smack into a Pokémon like myself!
msgctxt "2004:171"
msgid "<$comeff(1,14)><$motion(1,805)><$voicel(1,5)>Te veo corriendo a lo loco de acá para allá, pero... ¡más<br>te vale andar con ojo, <$cdef(27)><pname;0></color>!<clear><br><$emotion(1,37)><$voicel(1,9)>Como te des de bruces contra alguien como yo,<br>¡del coscorrón que te llevas, seguro que ves las estrellas!"
msgstr "<$comeff(1,14)><$motion(1,805)><$voicel(1,5)>Te veo corriendo a lo loco de acá para allá, pero... ¡más<br>te vale andar con ojo, <$cdef(27)><pname;0></color>!<clear><br><$emotion(1,37)><$voicel(1,9)>Si te das de bruces contra alguien como yo,<br>¡del coscorrón que te llevas, seguro que ves las estrellas!"

#. en: <$emotion(1,1)><$voicel(1,7)>I may be small, but I’m jus’ as strong as any big Pokémon,<br>I tell you what!
msgctxt "2004:172"
msgid "<$emotion(1,1)><$voicel(1,7)>Por muy tapón que sea, mi fuerza no le va a la zaga de<br>otros más grandotes, ¿eh? ¡Soy pequeñ<gen;-3(o,a)> pero mat<gen;-3(ón,ona)>!"
msgstr "<$emotion(1,1)><$voicel(1,7)>Aunque mida poco, mi fuerza no le va a la zaga de<br>otros más grandotes, ¿eh? ¡Soy pequeñ<gen;-3(o,a)> pero mat<gen;-3(ón,ona)>!"

#. en: <$emotion(1,17)><$voicel(1,3)>Sometimes I worry I’m gonna get in the way if I lay down<br>somewhere—what with me bein’ a big Pokémon ’n’ all!
msgctxt "2004:173"
msgid "<$emotion(1,17)><$voicel(1,3)>Soy tan grandot<gen;-3(e,a)> que, aunque no te lo creas, me pienso<br>dos veces hasta dónde posarme."
msgstr "<$emotion(1,17)><$voicel(1,3)>Soy tan grandot<gen;-3(e,a)> que, aunque no lo creas, pienso<br>dos veces dónde posarme."

#. en: <$emotion(1,37)><$voicel(1,9)>My flames are always burnin’, so I gotta eat a bunch to<br>fuel ’em!
msgctxt "2004:174"
msgid "<$emotion(1,37)><$voicel(1,9)>El fuego de mi cuerpo no se mantiene solo, ¡así que<br>tengo que ponerme como el Quico para avivarlo!"
msgstr "<$emotion(1,37)><$voicel(1,9)>El fuego de mi cuerpo no se mantiene solo, ¡así que<br>tengo que comer un montón para avivarlo!"

#. en: <$emotion(1,8)><$voicel(1,7)>I almost feel bad swimmin’ on clear days ’cause you can<br>see the sun or the moon reflectin’ on the water, and my<slide><br>splashin’ messes that reflection right up!
msgctxt "2004:175"
msgid "<$emotion(1,8)><$voicel(1,7)>En los días despejados, el sol y la luna flotan en el espejo<br>del mar. Caaasi da pena chapotear y arruinar ese reflejo."
msgstr ""

#. en: <$emotion(1,14)><$voicel(1,7)>You might get a li’l shock if ya touch me... But I’m sure a<br>LITTLE shock won’t hurt ya, will it?
msgctxt "2004:177"
msgid "<$emotion(1,14)><$voicel(1,7)>Si me tocas, igual te llevas algún que otro calambrazo...<br>Pero bueno, por un poquillo tampoco te dará un patatús."
msgstr "<$emotion(1,14)><$voicel(1,7)>Si me tocas, tal vez te lleves algún que otro calambrazo...<br>Pero bueno, por un poquito tampoco te dará un patatús."

#. en: <$comeff(1,10)><$motionoff(1,804)><$voicel(1,9)><$voicel(1,10)>BOO!!!<clear><br><$emotion(1,18)><$voicel(1,4)>...I was kinda hopin’ you’d look more scared...
msgctxt "2004:180"
msgid "<$comeff(1,10)><$motionoff(1,804)><$voicel(1,9)><$voicel(1,10)>¡¡Buh!!<clear><br><$emotion(1,18)><$voicel(1,4)>... <wait(0.9)>Caramba, te has quedado tan campante."
msgstr "<$comeff(1,10)><$motionoff(1,804)><$voicel(1,9)><$voicel(1,10)>¡¡Buh!!<clear><br><$emotion(1,18)><$voicel(1,4)>... <wait(0.9)>Caramba, te quedaste tan campante."

#. en: <$comeff(1,10)><$motion(1,803)><$voicel(1,9)>Howdy! Have ya heard the news? Seems we have a new<br>friend ’round here named <$cdef(27)><lastfrpk;1></color>!
msgctxt "2004:181"
msgid "<oneline><$comeff(1,10)><$motion(1,803)><$voicel(1,9)>¿Has oído, <$cdef(27)><pname;0></color>?<br>¡También anda<slide><br>por aquí<slide><br><gen;1(un,una)> <$cdef(27)><lastfrpk;1></color>!"
msgstr "<oneline><$comeff(1,10)><$motion(1,803)><$voicel(1,9)>¿Ya oíste, <$cdef(27)><pname;0></color>?<br>¡También anda<slide><br>por aquí<slide><br><gen;1(un,una)> <$cdef(27)><lastfrpk;1></color>!"

#. en: <oneline><$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Well, howdy, <$cdef(27)><pname;0></color>! Good to see ya<br>doin’ well!
msgctxt "2004:182"
msgid "<oneline><$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>¡Caray! ¡Te veo estupendamente,<br><$cdef(27)><pname;0></color>!"
msgstr ""

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,824)><$voicel(1,9)><$pkcry;0(1,2)>! GOOD MORNIN’! Sure is nice and<br>refreshin’ to let out a holler bright and early!
msgctxt "2004:183"
msgid "<oneline><$comeff(1,10)><$facial(1,4)><$motion(1,824)><$voicel(1,9)>¡<$pkcry;0(1,2)>! Nada como un buen grito para empezar<br>el día.<slide><br>Si despeja de mañana, despega las legañas."
msgstr ""

#. en: <oneline><$comeff(1,3)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>Howdy, <$cdef(27)><pname;0></color>! Sky’s clear and blue<br>today,<slide><br>sure is!
msgctxt "2004:184"
msgid "<oneline><$comeff(1,3)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>¡Hola, <$cdef(27)><pname;0></color>! Qué cielo tan magnífico<br>tenemos hoy,<slide><br>¿no?"
msgstr ""

#. en: <oneline><$comeff(1,3)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Evenin’, <$cdef(27)><pname;0></color>. The moon sure is<br>pretty<slide><br>tonight,<slide><br>don’t<slide><br>ya think?
msgctxt "2004:185"
msgid "<oneline><$comeff(1,3)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>¡Pero si es <gen;-2(el buenazo,la buenaza)> de <$cdef(27)><pname;0></color>!<br>¿Has visto qué hermosa<slide><br>está la luna esta noche?"
msgstr "<oneline><$comeff(1,3)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>¡Pero si es <gen;-2(el buenazo,la buenaza)> de <$cdef(27)><pname;0></color>!<br>¿Ya viste qué hermosa<slide><br>está la luna esta noche?"

#. en: <$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>It’s rainin’! Thank goodness. I sure do love me some rain!
msgctxt "2004:186"
msgid "<$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>¡Bendita lluvia! Cómo se agradece..."
msgstr ""

#. en: <$emotion(1,31)><$voicel(1,3)>Oh no, it’s rainin’! Ain’t this a fine how-do-ya-do...<br>Well, I’m sure it’ll let up soon!
msgctxt "2004:187"
msgid "<$emotion(1,31)><$voicel(1,3)>Ayyy, qué lluvia más inoportuna... Pero bueno, ya sabes...<br>¡Nunca llovió que no escampase!"
msgstr "<$emotion(1,31)><$voicel(1,3)>Ayyy, qué lluvia tan inoportuna... Pero bueno, ya sabes...<br>¡Nunca llovió que no escampara!"

#. en: <oneline><$comeff(1,3)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Howdy, <$cdef(27)><pname;0></color>! Sunny days are nice,<br>but<slide><br>goin’<slide><br>for a<slide><br>walk<slide><br>on a<slide><br>cloudy<slide><br>day<slide><br>ain’t<slide><br>half<slide><br>bad either.
msgctxt "2004:188"
msgid "<$cdef(27)><$comeff(1,3)></color><$facial(1,4)><$motion(1,803)><$voicel(1,7)>¡Hola, jovenzuel<gen;-2(o,a)>! Un cielo nublado no es excusa para no<br>salir a desentumecer un poco las articulaciones."
msgstr ""

#. en: <$comeff(1,14)><$voicel(1,5)>I sure would like to have me a nice chat with <$cdef(27)>Professor<br>Tangrowth</color> someday. <$emotion(1,8)><$voicel(1,10)>Bet we’d get along jus’ dandy!
msgctxt "2004:189"
msgid "<$comeff(1,14)><$voicel(1,5)>Me gustaría hablar largo y tendido algún día con el bueno<br>del <$cdef(27)>Profesor Tangrowth</color>.<clear><br><$emotion(1,8)><$voicel(1,10)>¡Me parece a mí que congeniaríamos enseguida!"
msgstr ""

#. en: <$emotion(1,8)><$voicel(1,9)>Need a li’l demolition, do ya? You jus’ leave that to me!<br>Don’tcha worry one bit!
msgctxt "2004:190"
msgid "<$emotion(1,8)><$voicel(1,9)>¿Una demolición? ¡Déjamelo a mí, que te la hago<br>en un periquete!"
msgstr "<$emotion(1,8)><$voicel(1,9)>¿Una demolición? ¡Déjamelo a mí, que te la hago<br>en un segundo!"

#. en: <$emotion(1,37)><$voicel(1,9)>Ya know what ingredient is most important when cookin’?!<br>It’s love, y’hear? Love!
msgctxt "2004:191"
msgid "<$emotion(1,37)><$voicel(1,9)>¿Sabes cuál es el ingrediente más importante al cocinar?<br>¡El amor, dónde va a parar!"
msgstr "<$emotion(1,37)><$voicel(1,9)>¿Sabes cuál es el ingrediente más importante al cocinar?<br>¡El amor, por supuesto!"

#. en: <oneline><$emotion(1,8)><$voicel(1,9)>Sure is nice runnin’ around with ya like this,<br><$cdef(27)><pname;0></color>.<slide><br>Makes<slide><br>me<slide><br>real happy!
msgctxt "2004:192"
msgid "<$emotion(1,8)><$voicel(1,9)>Irme de excursión contigo es algo que llena de felicidad<br>este viejo corazón, <$cdef(27)><pname;0></color>."
msgstr ""

#. en: <oneline><$emotion(1,29)><$voicel(1,7)>You ain’t gettin’ tired, are ya, <$cdef(27)><pname;0></color>?<br>It’s<slide><br>always<slide><br>OK<slide><br>to<slide><br>take<slide><br>a<slide><br>break<slide><br>if<slide><br>ya<slide><br>need one!
msgctxt "2004:193"
msgid "<$emotion(1,29)><$voicel(1,7)>¿No estás extenuad<gen;-2(o,a)> de tanto trote? ¡No te extralimites,<br>que tenemos una desgracia, <$cdef(27)><pname;0></color>!"
msgstr ""

#. en: <$comeff(1,9)><$motion(1,806)><$voicel(1,7)>I see so many fun ’n’ excitin’ things when I’m out explorin’<br>with you, <$cdef(27)><pname;0></color>!
msgctxt "2004:194"
msgid "<$comeff(1,9)><$motion(1,806)><$voicel(1,7)>Acompañarte en tus peripecias es tan estimulante como<br>ameno, <$cdef(27)><pname;0></color>."
msgstr ""

#. en: <oneline><$emotion(1,38)><$voicel(1,9)>Gwahaha! I’m really enjoyin’ livin’ with ya,<br><$cdef(27)><pname;0></color>!
msgctxt "2004:195"
msgid "<$emotion(1,38)><$voicel(1,9)>¡Bua, ja, ja! ¡No sabes tú bien qué feliz me hace compartir<br>hogar contigo, <$cdef(27)><pname;0></color>!"
msgstr ""

#. en: <$emotion(1,14)><$voicel(1,5)>Have ya heard ’bout them feathers we sometimes find lyin’<br>about? <$comeff(1,14)><$voicel(1,8)>I ain’t seen nothin’ like ’em before.<clear><br><$comeff(1,6)><$motion(1,666)><$voicel(1,6)>I wonder who they belong to...
msgctxt "2004:196"
msgid "<$emotion(1,14)><$voicel(1,5)>¿Has visto alguna de esas plumas peculiares tirada por<br>ahí, mocit<gen;-2(o,a)>? <$comeff(1,14)><$voicel(1,8)>Nunca había visto cosa igual...<clear><br><$comeff(1,6)><$motion(1,666)><$voicel(1,6)>¿Se habrá quedado alguien sin plumas y cacareando?<br>¡Bua, ja, ja!"
msgstr ""

#. en: <oneline><$emotion(1,38)><$voicel(1,9)>Feast yer eyes on my well-trained muscles,<br><$cdef(27)><pname;0></color>!<slide><br><$comeff(1,21)><$facial(1,1)><$motion(1,803)><$voicel(1,8)>What<slide><br>do ya<slide><br>think?!<slide><br>Ya<slide><br>like ’em,<slide><br>don’tcha?!
msgctxt "2004:198"
msgid "<$emotion(1,38)><$voicel(1,9)>¿Qué te parecen estos músculos de tomo y lomo que he<br>forjado a base de entrenar, <$cdef(27)><pname;0></color>?<clear><br><$comeff(1,21)><$facial(1,1)><$motion(1,803)><$voicel(1,8)>¡No me negarás que despiertan fascinación ajena!"
msgstr ""

#. en: <$emotion(1,31)><$voicel(1,5)>Urrgh... Another Pokémon hightailed it as soon as they<br>saw me... <$emotion(1,51)><$voicel(1,4)>They jus’ don’t understand how cool bein’<slide><br>scary is, I tell ya what!
msgctxt "2004:199"
msgid "<$emotion(1,31)><$voicel(1,5)>Ufff... Hoy me ha vuelto a pasar eso de que un Pokémon<br>ponga pies en polvorosa nada más cruzarse conmigo...<clear><br><$emotion(1,51)><$voicel(1,4)>¿Será posible que no logren apreciar mi encanto canalla?"
msgstr "<$emotion(1,31)><$voicel(1,5)>Ufff... Hoy me volvió a pasar eso de que un Pokémon<br>ponga pies en polvorosa en cuanto se cruza conmigo...<clear><br><$emotion(1,51)><$voicel(1,4)>¿Será posible que no logren apreciar mi encanto canalla?"

#. en: <$emotion(1,8)><$voicel(1,9)>Gwahahahaaaa... I’m havin’ a grand ol’ time!<clear><br><$emotion(1,29)><$voicel(1,6)>What’s that, now? I don’t look like it? <wait(0.8)><$emotion(1,38)><$voicel(1,10)>Gwahaha! Guess this<br>fearsome face o’ mine ain’t easy to read, huh!
msgctxt "2004:200"
msgid "<$emotion(1,8)><$voicel(1,9)>Jo, jo, jo... ¡Me estoy divirtiendo de lo lindo!<clear><br><$emotion(1,29)><$voicel(1,6)>¿Cómo dices? ¿Que no lo parece?<wait(0.8)><clear><br><$emotion(1,38)><$voicel(1,10)>¡Bua, ja, ja! ¡Tampoco me extraña, con esta cara de pocos<br>amigos que me gasto!"
msgstr ""

#. en: <oneline><$emotion(1,14)><$voicel(1,7)>Would ya mind bringin’ me <$cdef(27)><nquestinum;1></color><br><$cdef(27)><class><nquestitem;0></color>?
msgctxt "2004:201"
msgid "<oneline><$emotion(1,14)><$voicel(1,7)>Necesito que me consigas <$cdef(27)><nquestinum;1></color><br><class><$cdef(27)><nquestitem;0></color>,<slide><br>jovenzuel<gen;-2(o,a)>."
msgstr ""

#. en: <$emotion(1,8)><$voicel(1,9)>Ohhh! That sure is helpful! Thank ya kindly!
msgctxt "2004:202"
msgid "<$emotion(1,8)><$voicel(1,9)>¡Qué alegría! ¡Que Arceus te lo pague!"
msgstr ""

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>I’m interested in a place that’s sorta like this...
msgctxt "2004:203"
msgid "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Tengo bastante interés por ver un sitio tal que así...<br>A ver si tú me puedes ayudar, mocit<gen;-2(o,a)>."
msgstr "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Tengo bastante interés por ver un lugar como este...<br>A ver si tú me puedes ayudar, mocit<gen;-2(o,a)>."

#. en: <$emotion(1,60)><$voicel(1,9)>Ohhh! Ya made it jus’ like I asked! Now I owe ya one!
msgctxt "2004:204"
msgid "<$emotion(1,60)><$voicel(1,9)>¡Tal y como te había pedido! ¡Te debo una, moz<gen;-2(o,a)>!"
msgstr "<$emotion(1,60)><$voicel(1,9)>¡Tal y como te había pedido! ¡Te debo una, muchach<gen;-2(o,a)>!"

#. en: <$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,7)>I’d be mighty grateful if ya could clean up that there<br>road fer me!
msgctxt "2004:205"
msgid "<$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,7)>¡Hay un camino que quiero que despejes!"
msgstr ""

#. en: <oneline><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>I made it! And I say it’s all thanks to you,<br><$cdef(27)><pname;0></color>!
msgctxt "2004:206"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Aquí estoy! Todo gracias a ti, <$cdef(27)><pname;0></color>."
msgstr ""

#. en: <$emotion(1,29)><$voicel(1,7)>Oooh! You’ve already got what I need?! Would ya mind<br>sharin’ with li’l ol’ me?
msgctxt "2004:209"
msgid "<$emotion(1,29)><$voicel(1,7)>¡Canastos! ¿Ya estás bien provist<gen;-2(o,a)>? ¿Serías tan amable de<br>repartir, entonces?"
msgstr "<$emotion(1,29)><$voicel(1,7)>¡Vaya! ¿Ya estás bien provist<gen;-2(o,a)>? ¿Serías tan amable de<br>repartir, entonces?"

#. en: <$comeff(1,3)><$motion(1,806)><$voicel(1,7)>Oh, yeah? All righty, then... But I’ll be waitin’ if ya change<br>yer mind!
msgctxt "2004:210"
msgid "<$comeff(1,3)><$motion(1,806)><$voicel(1,7)>Vale, entendido. Pero si cambias de opinión, por mí<br>encantad<gen;-3(o,a)>."
msgstr "<$comeff(1,3)><$motion(1,806)><$voicel(1,7)>Bueno, entendido. Pero si cambias de opinión, por mí<br>encantad<gen;-3(o,a)>."

#. en: <$emotion(1,29)><$voicel(1,5)>Could ya take me over to see <$cdef(27)><nquestappk;1></color>?
msgctxt "2004:212"
msgid "<$emotion(1,29)><$voicel(1,5)>¿Podrías conducirme adonde esté <dart;1()><$cdef(27)><nquestappk;1></color>?"
msgstr "<$emotion(1,29)><$voicel(1,5)>¿Podrías llevarme adonde esté <dart;1()><$cdef(27)><nquestappk;1></color>?"

#. en: <$emotion(1,8)><$voicel(1,9)>Sure is nice bein’ able to meet up with a friend! Thanks a<br>bushel and a peck, <$cdef(27)><pname;0></color>!
msgctxt "2004:213"
msgid "<$emotion(1,8)><$voicel(1,9)>¡Ay, qué bien que nos hemos encontrado!<br>¡Y todo gracias a ti, moz<gen;-2(o,a)>!"
msgstr "<$emotion(1,8)><$voicel(1,9)>¡Ay, qué bien que nos encontramos!<br>¡Y todo gracias a ti, muchach<gen;-2(o,a)>!"

#. en: <$emotion(1,29)><$voicel(1,7)>How ya feel ’bout takin’ a picture with me?
msgctxt "2004:214"
msgid "<$emotion(1,29)><$voicel(1,7)>Hazme el favor y saca una foto donde salgamos tú y yo,<br>picaruel<gen;-2(o,a)>."
msgstr "<$emotion(1,29)><$voicel(1,7)>Hazme el favor y toma una foto donde salgamos tú y yo,<br>picaruel<gen;-2(o,a)>."

#. en: <$emotion(1,14)><$voicel(1,7)>Oh! That there’s the picture you took of us, huh? That’s<br>real nice, <$cdef(27)><pname;0></color>. <$emotion(1,38)><$voicel(1,10)>You’re a pro at this!
msgctxt "2004:215"
msgid "<$emotion(1,14)><$voicel(1,7)>¡Caray, menuda foto! No me esperaba menos de ti.<br><$emotion(1,38)><$voicel(1,10)>¡Ha quedado fantástica!"
msgstr "<$emotion(1,14)><$voicel(1,7)>¡Caray, qué foto! No me esperaba menos de ti.<br><$emotion(1,38)><$voicel(1,10)>¡Quedó fantástica!"

#. en: <$comeff(1,5)><$motion(1,803)><$voicel(1,7)>Wait a sec... They’re already nearby!
msgctxt "2004:217"
msgid "<$comeff(1,5)><$motion(1,803)><$voicel(1,7)>¡Pero si estaba aquí al lado! Seré miope..."
msgstr ""

#. en: <$emotion(1,29)><$voicel(1,5)>Howdy! I’ve got somethin’ I could use a li’l help with. You<br>up fer lendin’ me a hand, <$cdef(27)><pname;0></color>?
msgctxt "2004:224"
msgid "<$emotion(1,29)><$voicel(1,5)>Tengo un pequeño favor que pedirte. ¿Puedes atenderme<br>un momentito, <$cdef(27)><pname;0></color>?"
msgstr ""

#. en: <$emotion(1,14)><$voicel(1,7)>Gotcha. I’ll ask ya fer help later, then!
msgctxt "2004:225"
msgid "<$emotion(1,14)><$voicel(1,7)>De acuerdo, pues ya te lo pediré en otro momento más<br>oportuno."
msgstr ""

#. en: <oneline><$emotion(1,29)><$voicel(1,7)><fcap><iart;0()><$cdef(27)><fqty(1)><class><nquestitem;0> </color>sure<br>would<slide><br>be nice...<clear><br>Would ya mind puttin’ one in my livin’ space?
msgctxt "2004:226"
msgid "<oneline><$emotion(1,29)><$voicel(1,7)>Lo que daría yo por tener<br><iart;0()><$cdef(27)><fqty(1)><class><nquestitem;0></color><slide><br>en mi hogar.<slide><br>¿Serías tan amable?"
msgstr ""

#. en: <$emotion(1,60)><$voicel(1,9)>Ya got me what I asked fer?! I’m in yer debt!
msgctxt "2004:227"
msgid "<$emotion(1,60)><$voicel(1,9)>¡Recórcholis! Si es que esta juventud de hoy en día da<br>gusto. Te lo agradeceré eternamente, mocit<gen;-2(o,a)>."
msgstr ""

#. en: <$comeff(1,5)><$motion(1,803)><$voicel(1,9)>Huh?! You’ve already made what I was lookin’ for?!
msgctxt "2004:232"
msgid "<$comeff(1,5)><$motion(1,803)><$voicel(1,9)>¡Sapristi, qué diligencia!"
msgstr "<$comeff(1,5)><$motion(1,803)><$voicel(1,9)>¡Cáspita, qué diligencia!"

#. en: <$comeff(1,5)><$motion(1,803)><$voicel(1,9)>Now then... Huh?! Ya already brought what I asked fer ’n’<br>set it up fer me?!
msgctxt "2004:233"
msgid "<$comeff(1,5)><$motion(1,803)><$voicel(1,9)>¡Repámpanos! ¡¿Ya te has encargado de su colocación?!"
msgstr "<$comeff(1,5)><$motion(1,803)><$voicel(1,9)>¡Santo cielo! ¡¿Ya te encargaste de su colocación?!"

#. en: <$comeff(1,5)><$motion(1,803)><$voicel(1,9)>Hm? What’s that, now? You’ve already done what I jus’<br>asked ya to do?!
msgctxt "2004:234"
msgid "<$comeff(1,5)><$motion(1,803)><$voicel(1,9)>¡Caramba! ¡¿Será posible que ya hayas terminado lo que<br>te pedí?!"
msgstr ""

#. en: <oneline><$emotion(1,14)><$voicel(1,7)>Well howdy, <$cdef(27)><pname;0></color>! Mightcha have<br>time<slide><br>to<slide><br>help<slide><br>me<slide><br>out<slide><br>a li’l?<clear><br><$comeff(1,14)><$voicel(1,5)>I’ve already asked some others to help, but I was wonderin’<br><$emotion(1,29)><$voicel(1,7)>if you wouldn’t mind joinin’ in too!
msgctxt "2004:235"
msgid "<$emotion(1,14)><$voicel(1,7)>¡A las buenas, jovenzuel<gen;-2(o,a)>! Mira, oye, una cosa...<br>¿Tú crees que podrías hacerme un pequeño favorcín?<clear><br><$comeff(1,14)><$voicel(1,5)>En realidad ya se lo he pedido hasta al Tato, pero me dije<br>para mis adentros: <$emotion(1,29)><$voicel(1,7)>\"¿Y si también quiere arrimar<slide><br>el hombro <gen;-2(el bueno,la buena)> de <$cdef(27)><pname;0></color>?\"."
msgstr "<$emotion(1,14)><$voicel(1,7)>¡Buenas, jovenzuel<gen;-2(o,a)>! Mira, oye, una cosa...<br>¿Tú crees que podrías hacerme un pequeño favorcito?<clear><br><$comeff(1,14)><$voicel(1,5)>En realidad ya se lo pedí a medio mundo, pero me dije<br>para mis adentros: <$emotion(1,29)><$voicel(1,7)>\"¿Y si también quiere arrimar<slide><br>el hombro <gen;-2(el bueno,la buena)> de <$cdef(27)><pname;0></color>?\"."

#. en: <$comeff(1,14)><$voicel(1,5)>Y’know that thing I was havin’ everybody help me with?<br><$emotion(1,8)><$voicel(1,10)>Well, it’s jus’ finished up—I’m all good now!<clear><br><$emotion(1,37)><$voicel(1,8)>I’m sure I’ll have more stuff for you to help me with<br>sometime soon!
msgctxt "2004:236"
msgid "<$comeff(1,14)><$voicel(1,5)>Oye, ¿te acuerdas de ese favor que había pedido a cada<br>hijo de vecino?... <$emotion(1,8)><$voicel(1,10)>¡Pues acaba de solucionarse el asunto!<clear><br><$emotion(1,37)><$voicel(1,8)>¡Gracias, ya te pediré ayuda en alguna otra ocasión!"
msgstr ""

#. en: <$emotion(1,37)><$facial(1,4)><$voicel(1,7)>I sure would like to make this place a li’l livelier. Ya think<br>we could build a new house for the town?<clear><br><$facial(1,4)><$motionoff(1,804)><$comeff(1,9)><$voicel(1,10)>I’d be willin’ to help out if ya need a hand!
msgctxt "2004:237"
msgid "<$emotion(1,37)><$facial(1,4)><$voicel(1,7)>¿Sabes lo que le falta a este vecindario, mozalbet<gen;-2(e,a)>?<br>¡Alguna casa humana nueva, que dan mucha alegría!<clear><br><$facial(1,4)><$motionoff(1,804)><$comeff(1,9)><$voicel(1,10)>Avísame si necesitas que te eche una mano."
msgstr ""

#. en: <oneline><$comeff(1,9)><$motion(1,801)><$voicel(1,9)><$pkcry;0(1,2)>! ♪ Ya built a house, huh? Thank ya<br>kindly,<slide><br><$cdef(27)><pname;1></color>!
msgctxt "2004:238"
msgid "<oneline><$comeff(1,9)><$motion(1,801)><$voicel(1,9)>♪¡<fcap><$pkcry;0(1,2)>, has hecho una casa humana!♪<br>¡Si es que<slide><br>da gusto poder contar con jóvenes como tú!"
msgstr "<oneline><$comeff(1,9)><$motion(1,801)><$voicel(1,9)>♪¡<fcap><$pkcry;0(1,2)>, hiciste una casa humana!♪<br>¡Si es que<slide><br>da gusto poder contar con jóvenes como tú!"

#. en: <oneline><$comeff(1,6)><$motion(1,661)><$voicel(1,5)>I sure do got a hankerin’ fer<br><iart;0()><$cdef(27)><fqty(1)><class><nquestitem;0></color><slide><$cdef(27)><br></color>right<slide><br>about now...<clear><br>You wouldn’t happen to have any extra lyin’ around, would<br>ya, <$cdef(27)><pname;1></color>?
msgctxt "2004:239"
msgid "<$motion(1,661)><$voicel(1,5)>De buena gana me metería ahora entre pecho y espalda<br><iart;0()><$cdef(27)><fqty(1)><class><nquestitem;0></color>.<clear><br><$comeff(1,6)>¿No te sobraría algo para mí, <$cdef(27)><pname;1></color>?<br>Quien guarda siempre tiene... ¡y reparte cuando quiere!"
msgstr ""

#. en: <oneline><$comeff(1,10)><$facial(1,4)><$motion(1,661)><$voicel(1,7)>Well, ain’t you generous, <$cdef(27)><pname;0></color>!
msgctxt "2004:240"
msgid "<oneline><$comeff(1,10)><$facial(1,4)><$motion(1,661)><$voicel(1,7)>¡Tú siempre tan desprendid<gen;-2(o,a)>, <$cdef(27)><pname;0><br></color>de mis entretelas!"
msgstr "<oneline><$comeff(1,10)><$facial(1,4)><$motion(1,661)><$voicel(1,7)>¡Tú siempre tan desprendid<gen;-2(o,a)>, <$cdef(27)><pname;0><br></color>de mi corazón!"

#. en: <oneline><$comeff(1,9)><$motion(1,801)><$voicel(1,9)><$pkcry;0(1,1)>! We got that cleared up in no time flat!<br>How nice!
msgctxt "2004:241"
msgid "<$comeff(1,9)><$motion(1,801)><$voicel(1,9)>¡Qué alegría y qué alborozo, se ha resuelto la cuestión en<br>un santiamén! ¡<fcap><$pkcry;0(1,1)>!"
msgstr "<$comeff(1,9)><$motion(1,801)><$voicel(1,9)>¡Qué alegría y qué alborozo, se resolvió la cuestión en<br>un santiamén! ¡<fcap><$pkcry;0(1,1)>!"

#. en: <$comeff(1,9)><$motion(1,801)><$voicel(1,9)>Well then, thanks a bushel! I knew I could count on<br>you, <$cdef(27)><pname;0></color>!
msgctxt "2004:242"
msgid "<$comeff(1,9)><$motion(1,801)><$voicel(1,9)>Bueno, bueno, bueno... ¡tremendo favor que me haces,<br><$cdef(27)><pname;0></color>! ¡Tú siempre tan cumplido<gen;-2(r,ra)>!"
msgstr ""

#. en: <$comeff(1,3)><$facial(1,1)><$motion(1,803)><$voicel(1,8)>Well, I’ll be! Already got what I need, do ya? I’d be mighty<br>grateful if ya shared with li’l ol’ me!
msgctxt "2004:243"
msgid "<$comeff(1,3)><$facial(1,1)><$motion(1,803)><$voicel(1,8)>¡No me digas que ya has cocinado el plato en cuestión!<br>Pues si encima lo compartes, ¡miel sobre hojuelas!"
msgstr "<$comeff(1,3)><$facial(1,1)><$motion(1,803)><$voicel(1,8)>¡No me digas que ya cocinaste el platillo en cuestión!<br>Pues si encima lo compartes, ¡miel sobre hojuelas!"

#. en: <oneline><$comeff(1,10)><$facial(1,4)><$motion(1,661)><$voicel(1,7)>Well, ain’t you generous, <$cdef(27)><pname;0></color>!
msgctxt "2004:244"
msgid "<oneline><$comeff(1,10)><$facial(1,4)><$motion(1,661)><$voicel(1,7)>¿Habrá <gen;-2(un,una)> chicuel<gen;-2(o,a)> más generos<gen;-2(o,a)> que tú,<br><$cdef(27)><pname;0></color>?"
msgstr ""

#. en: <$cdef(27)><oneline><$voicel(1,7)><$motion(1,801)><$comeff(1,3)><pname;0></color>! I sure would like ya to<br>have this!<clear><br><$voicel(1,5)><$motion(1,803)><$facial(1,5)>I feel indebted to you fer all ya do fer me. <$voicel(1,10)><$motion(1,805)><$comeff(1,9)>This is my way<br>of showin’ thanks!
msgctxt "2004:301"
msgid "<$cdef(27)><$voicel(1,7)><$motion(1,801)><$comeff(1,3)><pname;0></color>, toma esto, anda.<clear><br><$voicel(1,5)><$motion(1,803)><$facial(1,5)>Con lo bien que te portas conmigo, tendría delito no<br>ofrecerte un detalle. <$voicel(1,10)><$motion(1,805)><$comeff(1,9)>Acéptalo, ¿eh? No me hagas el feo."
msgstr "<$cdef(27)><$voicel(1,7)><$motion(1,801)><$comeff(1,3)><pname;0></color>, toma esto, vamos.<clear><br><$voicel(1,5)><$motion(1,803)><$facial(1,5)>Con lo bien que te portas conmigo, sería un crimen no<br>ofrecerte un detalle. <$voicel(1,10)><$motion(1,805)><$comeff(1,9)>Acéptalo, ¿eh? No lo rechaces."

#. en: <$comeff(1,7)><$motion(1,802)><$voicel(1,3)>Y’already got a bunch o’ Pokémon with ya. Tryin’ to fit me<br>in too seems like more trouble’n it’s worth...<clear><br><$comeff(1,3)><$motion(1,803)><$voicel(1,6)>Maybe some other time!
msgctxt "2004:302"
msgid "<$comeff(1,7)><$motion(1,802)><$voicel(1,3)>Hm, con toda esta tropa que tienes siguiéndote, moverse<br>será seguramente un lío de padre y muy señor mío.<clear><br><$comeff(1,3)><$motion(1,803)><$voicel(1,6)>¡Me quedo aquí esta vez! No me vaya a partir la crisma,<br>que ya tengo una edad."
msgstr "<$comeff(1,7)><$motion(1,802)><$voicel(1,3)>Hm, con toda esta tropa que tienes siguiéndote, moverse<br>será seguramente un lío tremendo.<clear><br><$comeff(1,3)><$motion(1,803)><$voicel(1,6)>¡Me quedo aquí esta vez! No me vaya a romper un hueso,<br>que ya tengo una edad."

#. en: <$comeff(1,4)><$motion(1,802)><$voicel(1,3)>I’m awful sorry ’bout this, but could ya maybe ask me<br>again some other time?
msgctxt "2004:303"
msgid "<$comeff(1,4)><$motion(1,802)><$voicel(1,3)>Perdona, moz<gen;-2(o,a)>, pero te agradecería que me lo pidieses<br>en otro momento más oportuno."
msgstr "<$comeff(1,4)><$motion(1,802)><$voicel(1,3)>Perdona, chic<gen;-2(o,a)>, pero te agradecería que me lo<br>pidieras en otro momento más oportuno."

#. en: <$voicel(1,9)><$motion(1,839)><$facial(1,5)><$comeff(1,1)>Things are goin’ great with the <$cdef(27)><flow><$spwfull(1)>in’</color>! Hahaha!
msgctxt "2004:304"
msgid "<$voicel(1,9)><$motion(1,839)><$facial(1,5)><$comeff(1,1)>¡La <$cdef(27)>construcción<nbs2><$spwicon(1)> </color>marcha viento en popa, bua, ja, ja!"
msgstr ""

#. en: <$emotion(1,60)><$voicel(1,8)>Off we go!
msgctxt "2004:305"
msgid "<$emotion(1,60)><$voicel(1,8)>¡Vamos que nos vamos!"
msgstr ""

#. en: <$emotion(1,37)><$voicel(1,7)>What’s that? We done fer now? I’ll be seein’ ya, then!
msgctxt "2004:306"
msgid "<$emotion(1,37)><$voicel(1,7)>¡Hasta aquí hemos llegado! Pero literalmente, por lo visto.<br>Pues nada, ¡hasta otra!"
msgstr "<$emotion(1,37)><$voicel(1,7)>¡Hasta aquí hemos llegado! Pero literalmente, por lo visto.<br>Pues nada, ¡hasta la próxima!"

#. en: <oneline><$emotion(1,51)><$voicel(1,3)>I’m awful sorry, <$cdef(27)><pname;0></color>, but I’m so<br>dang<slide><br>hungry—I<slide><br>dunno<slide><br>if I<slide><br>can<slide><br>take a single step right now.
msgctxt "2004:307"
msgid "<$emotion(1,51)><$voicel(1,3)>Me tienes que perdonar, moz<gen;-2(o,a)>, pero como reza el dicho:<br>\"si la panza está vacía, que te siga tu tía\"."
msgstr "<$emotion(1,51)><$voicel(1,3)>Me tienes que perdonar, chic<gen;-2(o,a)>, pero como reza el dicho:<br>\"si la panza está vacía, no hay alegría\"."

#. en: <$emotion(1,31)><$voicel(1,3)>I’m suddenly jus’...so dang hungry... I dunno if I can take<br>another step...
msgctxt "2004:308"
msgid "<$emotion(1,31)><$voicel(1,3)>Urg... Créeme si te digo que del apetito voraz que tengo<br>ahora mismo no puedo dar ni un paso más."
msgstr ""

#. en: <$emotion(1,51)><$voicel(1,5)>It’s rainin’... I don’t mind the occasional shower, but I sure<br>do prefer clear skies, I tell ya what.
msgctxt "2004:311"
msgid "<$emotion(1,51)><$voicel(1,5)>Ya tenía que venir a fastidiar la dichosa lluvia... Pero<br>bueno, una vez al año no hace daño..."
msgstr ""

#. en: <$comeff(1,17)><$motion(1,802)><$voicel(1,9)><$pkcry;0(1,2)>?! Goodness gracious! Watch it, will ya?
msgctxt "2004:315"
msgid "<oneline><$comeff(1,17)><$motion(1,802)><$voicel(1,9)>¡¿<$pkcry;0(1,2)>?! ¿Así, de golpe y mamporrazo?<br>Ver para creer..."
msgstr ""

#. en: <oneline><$emotion(1,38)><$voicel(1,9)>That there<br><$cdef(27)><fqty(1)><class><aireactp;0></color>...<slide><br>I<slide><br>do<slide><br>believe<slide><br>I<slide><br>like it!<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>But I’d ever so appreciate it if you could move it jus’ a<br>smidge closer to my livin’ space!
msgctxt "2004:317"
msgid "<oneline><$emotion(1,38)><$voicel(1,9)>¡<genqty;0(Este,Esta,Estos,Estas)> <$cdef(27)><fqty(1)><aireactp;0> </color>me encant<qty;0(a,an)>,<br>no creas!<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>Pero, si pudieras ponérmel<genqty;0(o,a,os,as)> en casa, sería la guinda.<br>¡Que Arceus te lo pague!"
msgstr "<oneline><$emotion(1,38)><$voicel(1,9)>¡<genqty;0(Este,Esta,Estos,Estas)> <$cdef(27)><fqty(1)><aireactp;0> </color>me encant<qty;0(a,an)>,<br>no creas!<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>Pero, si pudieras ponérmel<genqty;0(o,a,os,as)> en casa, sería<br>la cereza del pastel. ¡Que Arceus te lo pague!"

#. en: <oneline><$emotion(1,38)><$voicel(1,9)><fcap><iart;0()><$cdef(27)><fqty(1)><class><aireactp;0></color>?! Well<br>I’ll<slide><br>be!<slide><br>Thank<slide><br>ye kindly!
msgctxt "2004:318"
msgid "<oneline><$emotion(1,38)><$voicel(1,9)>¡Gracias desde lo más hondo de mi corazón por traerme<br><iart;0()><$cdef(27)><fqty(1)><class><aireactp;0></color>!"
msgstr ""

#. en: <$comeff(1,9)><$motion(1,806)><$voicel(1,9)><$pkcry;0(1,2)>! ♪ Why, that’s downright pleasant!
msgctxt "2004:319"
msgid "<$comeff(1,9)><$motion(1,806)><$voicel(1,9)>♪¡<$pkcry;0(1,2)>!♪ ¡Qué gustazo!"
msgstr ""

#. en: <oneline><$emotion(1,38)><$voicel(1,9)>Gwahaha! Cut it out, <$cdef(27)><pname;0></color>!<br>That tickles!
msgctxt "2004:320"
msgid "<$emotion(1,38)><$voicel(1,9)>¡Bua, ja, ja! ¡Para, para, que me mondo con las cosquillas<br>que me haces, <$cdef(27)><pname;0></color>!"
msgstr "<$emotion(1,38)><$voicel(1,9)>¡Bua, ja, ja! ¡Para, para, que me muero con las cosquillas<br>que me haces, <$cdef(27)><pname;0></color>!"

#. en: <oneline><$emotion(1,64)><$facial(1,9)><$voicel(1,7)>Where’d that<br><$cdef(27)><fqty(1)><class><aireactp;0></color><slide><$cdef(27)><br></color>go?<slide><br>It<slide><br>plumb<slide><br>disappeared...
msgctxt "2004:322"
msgid "<$emotion(1,64)><$facial(1,9)><$voicel(1,7)>¿Eh? Bueno, bueno... Que me aspen si no encuentro <qty;0(mi,mis)><br><$cdef(27)><fqty(1)><aireactp;0></color>..."
msgstr "<$emotion(1,64)><$facial(1,9)><$voicel(1,7)>¿Eh? Bueno, bueno... Caray, no encuentro <qty;0(mi,mis)><br><$cdef(27)><fqty(1)><aireactp;0></color>..."

#. en: <$comeff(1,9)><$motion(1,806)><$voicel(1,7)>My livin’ space has warmed up a li’l—<$emotion(1,60)><$voicel(1,10)>and it is DEE-lightful,<br>I tell you what!
msgctxt "2004:323"
msgid "<$comeff(1,9)><$motion(1,806)><$voicel(1,7)>¿Sabes? Últimamente mi hogar se ha vuelto más calentito.<br><$emotion(1,60)><$voicel(1,10)>¡Qué a gusto se está! Esto es vida."
msgstr ""

#. en: <$comeff(1,7)><$facial(1,9)><$motion(1,666)><$voicel(1,3)><$voicel(1,3)>Ugh... My livin’ space is a li’l too hot for me...
msgctxt "2004:324"
msgid "<$comeff(1,7)><$facial(1,9)><$motion(1,666)><$voicel(1,3)><$voicel(1,3)>Hmm... Mi hogar se ha vuelto un poco caluroso de más..."
msgstr ""

#. en: <$emotion(1,50)><$voicel(1,9)>Ohhh yeah! My home’s a li’l cooler now—and it sure feels<br>nice, I tell you what!
msgctxt "2004:325"
msgid "<$emotion(1,50)><$voicel(1,9)>¡Albricias y zapatetas! Ahora hace un fresquito muy pero<br>que muy agradable en mi hogar."
msgstr "<$emotion(1,50)><$voicel(1,9)>¡Albricias y zapatetas! Ahora hace un fresquito muy, pero<br>muy agradable en mi hogar."

#. en: <$comeff(1,6)><$facial(1,9)><$motion(1,666)><$voicel(1,5)>Is it jus’ me, or is my home a li’l chilly these days?<br><$emotion(1,31)><$voicel(1,4)>I’m more inclined to warmth, personally...
msgctxt "2004:326"
msgid "<$comeff(1,6)><$facial(1,9)><$motion(1,666)><$voicel(1,5)>Uf, o mucho me equivoco o en mi hogar hace un poco<br>de biruji de repente... <$emotion(1,31)><$voicel(1,4)>Ojalá fuese un pelín más cálido."
msgstr "<$comeff(1,6)><$facial(1,9)><$motion(1,666)><$voicel(1,5)>Uf, o mucho me equivoco o en mi hogar hace un poco<br>de frío de repente... <$emotion(1,31)><$voicel(1,4)>Ojalá fuera un poquito más cálido."

#. en: <$emotion(1,60)><$voicel(1,7)>My home’s recently brightened up a bit, <$emotion(1,8)><$voicel(1,10)>and it’s got me<br>feelin’ real good!
msgctxt "2004:327"
msgid "<$emotion(1,60)><$voicel(1,7)>¡Caramba, mi hogar tiene mucha más luz últimamente!<br><$emotion(1,8)><$voicel(1,10)>Así da gusto."
msgstr ""

#. en: <$comeff(1,14)><$facial(1,9)><$motion(1,666)><$voicel(1,3)>Hm... My home’s gotten a bit too bright. <$emotion(1,31)><$voicel(1,2)>Makes it real hard<br>to relax, I tell ya what.
msgctxt "2004:328"
msgid "<$comeff(1,14)><$facial(1,9)><$motion(1,666)><$voicel(1,3)>Hmm... Mi hogar se ha vuelto demasiado luminoso...<br><$emotion(1,31)><$voicel(1,2)>Así no hay quien se relaje aquí."
msgstr ""

#. en: <$emotion(1,60)><$voicel(1,9)>It’s gotten a li’l darker ’round here—and I’m lovin’ it!<br>This is how I like my home, I tell you what!
msgctxt "2004:329"
msgid "<$emotion(1,60)><$voicel(1,9)>¡Este lugar tiene ahora el toquecillo justo de oscuridad!<br>Ahora sí que es un hogar con todas las letras."
msgstr "<$emotion(1,60)><$voicel(1,9)>¡Este lugar tiene ahora el toquecito justo de oscuridad!<br>Ahora sí que es un hogar con todas las letras."

#. en: <$facial(1,9)><$motion(1,807)><$voicel(1,3)>Looks like it’s gotten a li’l too dark in my livin’ space...<br><$emotion(1,31)><$voicel(1,2)>Makes it kinda hard to relax, y’know?
msgctxt "2004:330"
msgid "<$facial(1,9)><$motion(1,807)><$voicel(1,3)>Mi hogar se ha vuelto un poco oscuro, quizá demasiado<br>para mi gusto... <$emotion(1,31)><$voicel(1,2)>Es difícil estar a tu aire si no ves ni jota."
msgstr "<$facial(1,9)><$motion(1,807)><$voicel(1,3)>Mi hogar se ha vuelto un poco oscuro, quizás demasiado<br>para mi gusto... <$emotion(1,31)><$voicel(1,2)>Es difícil estar a gusto si no ves ni jota."

#. en: <$emotion(1,38)><$voicel(1,9)>I tell ya what, the higher humidity round my home sure<br>has me feelin’ good!
msgctxt "2004:331"
msgid "<$emotion(1,38)><$voicel(1,9)>El ambiente de mi hogar tiene ahora justo el nivel<br>de humedad que me gusta."
msgstr ""

#. en: <$comeff(1,19)><$voicel(1,3)><$facial(1,9)><$motion(1,802)>Sure is humid round these parts. If I’m bein’ honest, <$voicel(1,1)>I like<br>it a bit drier myself.
msgctxt "2004:332"
msgid "<$comeff(1,19)><$voicel(1,3)><$facial(1,9)><$motion(1,802)>Mucha humedad siento yo por aquí... <$voicel(1,1)>No le pondría<br>reparos a que estuviese un poquito más seco, vamos."
msgstr "<$comeff(1,19)><$voicel(1,3)><$facial(1,9)><$motion(1,802)>Mucha humedad siento yo por aquí... <$voicel(1,1)>No le pondría<br>reparos a que estuviera un poquito más seco."

#. en: <$comeff(1,10)><$voicel(1,7)><$facial(1,4)><$motion(1,801)>The air ’round here’s gotten nice and dry recently!<br><$voicel(1,9)>Feels much better if ya ask me!
msgctxt "2004:333"
msgid "<$comeff(1,10)><$voicel(1,7)><$facial(1,4)><$motion(1,801)>¡El ambiente de este lugar se ha vuelto más seco!<br><$voicel(1,9)>¡No veas qué gustirrinín!"
msgstr "<$comeff(1,10)><$voicel(1,7)><$facial(1,4)><$motion(1,801)>¡El ambiente de este lugar se ha vuelto más seco!<br><$voicel(1,9)>¡No sabes qué gusto me da!"

#. en: <$comeff(1,19)><$voicel(1,1)><$facial(1,9)><$motion(1,802)>Don’t ya think it’s a bit dry round here? I reckon a touch<br>more humidity oughta suit me jus’ fine.
msgctxt "2004:334"
msgid "<$comeff(1,19)><$voicel(1,1)><$facial(1,9)><$motion(1,802)>No digo ninguna locura si afirmo que el ambiente está un<br>poco seco. Un toque de humedad no le vendría nada mal."
msgstr ""

#. en: <$comeff(1,7)><$facial(1,9)><$motion(1,803)><$voicel(1,3)>Dang it! I know ya set somethin’ down fer me nearby, <$emotion(1,51)><$voicel(1,2)>but<br>I can’t get over there!<clear><br><$facial(1,9)><$motion(1,803)><$voicel(1,3)>Sorry to bother ya, but could you make a path fer me to<br>get over there, <$cdef(27)><pname;1></color>?
msgctxt "2004:335"
msgid "<oneline><$comeff(1,7)><$facial(1,9)><$motion(1,803)><$voicel(1,3)>¡Arg!... Me parece a mí que no voy a poder ir a ver lo que<br>has colocado, <$cdef(27)><pname;0></color>. <wait(0.4)><$emotion(1,51)><$voicel(1,2)>Con lo cerquita<slide><br>que estaba...<clear><br><$facial(1,9)><$motion(1,803)><$voicel(1,3)>¿Serías tan amable de crearme un caminito para que<br>pueda llegar hasta ahí?"
msgstr "<oneline><$comeff(1,7)><$facial(1,9)><$motion(1,803)><$voicel(1,3)>¡Arg!... Me parece a mí que no voy a poder ir a ver lo que<br>colocaste, <$cdef(27)><pname;0></color>. <wait(0.4)><$emotion(1,51)><$voicel(1,2)>Con lo cerquita<slide><br>que estaba...<clear><br><$facial(1,9)><$motion(1,803)><$voicel(1,3)>¿Serías tan amable de crearme un caminito para que<br>pueda llegar hasta ahí?"

#. en: <$emotion(1,37)><$voicel(1,10)>All right! Jus’ leave it to me!
msgctxt "2004:336"
msgid "<$emotion(1,37)><$voicel(1,10)>¡Eso está hecho! ¡Déjalo en mis manos!"
msgstr ""

#. en: <$comeff(1,6)><$motion(1,805)><$voicel(1,5)>There’s somethin’ downright peculiar ’bout this here spot...<br>Why don’t ya check it out, <$cdef(27)><pname;0></color>?
msgctxt "2004:337"
msgid "<$comeff(1,6)><$motion(1,805)><$voicel(1,5)>Este lugar me tiene más escamad<gen;-3(o,a)> que un Magikarp.<br>¿Qué tal si investigas, <$cdef(27)><pname;0></color>?"
msgstr ""

#. en: <$emotion(1,38)><$voicel(1,9)><$pkcry;0(1,1)>! <$pkcry;1(1,2)>! Jus’ gettin’ started!
msgctxt "2004:338"
msgid "<oneline><$emotion(1,38)><$voicel(1,9)>¡<$pkcry;0(1,1)>, <flow><$pkcry;1(1,2)>! ¡Esto no ha hecho<br>más que empezar!"
msgstr ""

#. en: <$comeff(1,9)><$motion(1,806)><$voicel(1,7)>I put a lot o’ love into this here food! Sure am excited fer<br>everybody to try it, I tell ya what!
msgctxt "2004:339"
msgid "<$comeff(1,9)><$motion(1,806)><$voicel(1,7)>¡Marchando un plato hecho con mucho amor! ¡Espero que<br>les guste a todos!"
msgstr "<$comeff(1,9)><$motion(1,806)><$voicel(1,7)>¡Sale un platillo hecho con mucho amor! ¡Espero que<br>les guste a todos!"

#. en: <$emotion(1,38)><$voicel(1,10)>Gwahaha! I sure do love me a party!
msgctxt "2004:340"
msgid "<$emotion(1,38)><$voicel(1,10)>¡Bua, ja, ja! ¡Estamos de parranda! ¡Viva el jolgorio!"
msgstr ""

#. en: <$comeff(1,17)><$motion(1,806)><$voicel(1,8)>Whoo-whee... Now this here’s paradise, I tell ya what...
msgctxt "2004:341"
msgid "<$comeff(1,17)><$motion(1,806)><$voicel(1,8)>Fiuuu... Aquí estoy en la gloria..."
msgstr ""

#. en: <oneline><$comeff(1,3)><$facial(1,9)><$motion(1,803)><$voicel(1,5)>The <$cdef(27)><fqty(1)><class><aireactp;1> </color>is a li’l<br>hard<slide><br>to<slide><br>use<slide><br><$emotion(1,31)><$voicel(1,4)>where<slide><br>it<slide><br>is<slide><br>right now...<clear><br><$emotion(1,29)><$voicel(1,6)>Sorry fer the trouble, but could ya move it someplace away<br>from the water?
msgctxt "2004:343"
msgid "<oneline><$comeff(1,3)><$facial(1,9)><$motion(1,803)><$voicel(1,5)>Lo siento en el alma, moz<gen;-2(o,a)>, <$emotion(1,31)><$voicel(1,4)>pero aquí ser<qty;1(á,án)> difícilmente<br>utilizabl<qty;1(e,es)> <genqty;1(ese,esa,esos,esas)> <$cdef(27)><fqty(1)><aireactp;1></color>.<clear><br><$emotion(1,29)><$voicel(1,6)>¿No podrías colocarl<genqty;1(o,a,os,as)> en un lugar carente de agua?"
msgstr "<oneline><$comeff(1,3)><$facial(1,9)><$motion(1,803)><$voicel(1,5)>Lo siento en el alma, chic<gen;-2(o,a)>, <$emotion(1,31)><$voicel(1,4)>pero aquí ser<qty;1(á,án)> difícilmente<br>utilizabl<qty;1(e,es)> <genqty;1(ese,esa,esos,esas)> <$cdef(27)><fqty(1)><aireactp;1></color>.<clear><br><$emotion(1,29)><$voicel(1,6)>¿No podrías colocarl<genqty;1(o,a,os,as)> en un lugar carente de agua?"

#. en: <oneline><$comeff(1,9)><$motion(1,801)><$voicel(1,9)>Thanks a bushel, <$cdef(27)><pname;0></color>! Ya got the<br>place<slide><br>jus’<slide><br>the<slide><br>way<slide><br>I<slide><br>like<slide><br>it now!
msgctxt "2004:344"
msgid "<$comeff(1,9)><$motion(1,801)><$voicel(1,9)>¡Gracias a ti tengo un entorno acorde a mis apetencias!<br>¡Que Arceus te lo pague, <$cdef(27)><pname;0></color>!"
msgstr ""

#. en: <$comeff(1,21)><$motion(1,806)><$voicel(1,7)>I’m feelin’ a lot more at home recently—and it’s all thanks<br>to you, <$cdef(27)><pname;0></color>!<clear><br><$comeff(1,3)><$motion(1,803)><$voicel(1,5)>Jus’ a li’l more work, and I reckon this’ll be the perfect<br>environment fer me!
msgctxt "2004:345"
msgid "<$comeff(1,21)><$motion(1,806)><$voicel(1,7)>¡Gracias a ti me siento ahora más a gusto en mi hogar,<br><$cdef(27)><pname;0></color>!<clear><br><$comeff(1,3)><$motion(1,803)><$voicel(1,5)>Con unos cuantos retoques podré vivir en el entorno de<br>mis sueños."
msgstr ""

#. en: <oneline><$comeff(1,6)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>Howdy, <$cdef(27)><pname;0></color>! How ya feel ’bout<br>doin’<slide><br>some<slide><br>treasure huntin’?<clear><br><$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,7)>I bet ya could find some real neat stuff with a li’l help<br>from a<$cdef(27)> <fqty(1)><$ifull(2793)></color>.
msgctxt "2004:400"
msgid "<oneline><$comeff(1,6)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>Ay, <$cdef(27)><pname;0></color>, ¿me dedicarías un rato<br>para buscar tesoros?<clear><br><$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,7)>Si haces buen uso de tu <$cdef(27)><fqty(1)><$ifull(2793)></color>, estoy segur<gen;-3(o,a)> de que<br>hallaremos algún cachivache interesante."
msgstr ""

#. en: <$emotion(1,29)><$voicel(1,7)><$cdef(27)><pname;0></color>! How’s that road lookin’?
msgctxt "2004:402"
msgid "<$emotion(1,29)><$voicel(1,7)>Aquí no hay camino y no se hace camino al hablar.<br>¿Va progresando la cosa, <$cdef(27)><pname;0></color>?"
msgstr ""

#. en: <$emotion(1,38)><$voicel(1,7)>That right? Great! I’ll tag along with ya, then!
msgctxt "2004:403"
msgid "<$emotion(1,38)><$voicel(1,7)>¿Ah, sí? ¡Pues entonces vamos allá!"
msgstr "<$emotion(1,38)><$voicel(1,7)>¿Ah, sí? ¡Pues entonces, adelante!"

#. en: <$emotion(1,37)><$voicel(1,7)>Got it! I’ll be waitin’!
msgctxt "2004:404"
msgid "<$emotion(1,37)><$voicel(1,7)>¡Caray! Pues nada, seguiré esperando."
msgstr ""

#. en: <$emotion(1,31)><$voicel(1,3)><$pkcry;0(1,4)>... Looks like I still can’t get through.<clear><br><$emotion(1,29)><$voicel(1,5)>Sorry for the trouble, but do ya think you could clean the<br>path a li’l more, <$cdef(27)><pname;1></color>?<clear><br><$emotion(1,38)><$voicel(1,10)>Don’t ya worry about me one bit—I can wait!
msgctxt "2004:405"
msgid "<$emotion(1,31)><$voicel(1,3)><$pkcry;0(1,4)>... No puedo llegar...<clear><br><$emotion(1,29)><$voicel(1,5)>Si no es mucho pedir, ¿podrías adecentar un poco más<br>el camino, <$cdef(27)><pname;1></color>?<clear><br><$emotion(1,38)><$voicel(1,10)>No te preocupes, que puedo esperar todo el tiempo<br>del mundo. La paciencia es la madre de la ciencia."
msgstr ""

#. en: <$comeff(1,7)><$motion(1,807)><$voicel(1,3)>The path looks a bit too rough fer me to keep goin’...<br>Gimme a holler when everything’s all cleared up!
msgctxt "2004:408"
msgid "<$comeff(1,7)><$motion(1,807)><$voicel(1,3)>Veo peliagudo esto de seguir avanzando. Avísame si en<br>algún momento el camino se vuelve transitable."
msgstr ""

#. en: <$emotion(1,37)><$voicel(1,9)>I hear tell you’ve got a friend livin’ near here who goes by<br>the name of <$cdef(27)><wowner;0></color>!<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,7)>As a fellow friend o’ yours, I’d sure love it if you could<br>introduce us to each other!
msgctxt "2004:409"
msgid "<$emotion(1,37)><$voicel(1,9)>Tengo entendido que por aquí vive una de tus amistades.<br>Y se llama <$cdef(27)><wowner;0></color>, si no me equivoco.<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,7)>Con un poco de suerte, igual nos acabamos conociendo."
msgstr "<$emotion(1,37)><$voicel(1,9)>Tengo entendido que por aquí vive una de tus amistades.<br>Y se llama <$cdef(27)><wowner;0></color>, si no me equivoco.<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,7)>Con un poco de suerte, tal vez nos acabemos conociendo."

#. en: <$comeff(1,3)><$motion(1,803)><$voicel(1,5)>All righty. I’ll be at home waitin’ fer ya.
msgctxt "2004:410"
msgid "<$comeff(1,3)><$motion(1,803)><$voicel(1,5)>De acuerdo. A buen entendedor, pocas palabras bastan.<br>Ya sabes dónde encontrarme. En mi hogar, para más señas."
msgstr ""

#. en: <$emotion(1,29)><$voicel(1,8)>Hm? Now what’s that ya got there?
msgctxt "2004:411"
msgid "<$emotion(1,29)><$voicel(1,8)>¿Uy? ¿Se puede saber qué llevas ahí?"
msgstr ""

#. en: <$motion(1,807)><$voicel(1,4)>I figured as much!
msgctxt "2004:412"
msgid "<$motion(1,807)><$voicel(1,4)>Bueno, pues qué remedio."
msgstr ""

#. en: <$emotion(1,8)><$voicel(1,9)>Well I’ll be darned. Really? Thank ya kindly!
msgctxt "2004:413"
msgid "<$emotion(1,8)><$voicel(1,9)>¡Córcholis! ¿De veras? En ese caso, acepto el regalo.<br>Gracias, mocit<gen;-2(o,a)>."
msgstr ""

#. en: <oneline><$emotion(1,14)><$voicel(1,9)>That’s a nice-lookin’<br><$cdef(27)><fqty(1)><class><refmateid;0></color><slide><br>ya<slide><br>got there.
msgctxt "2004:414"
msgid "<oneline><$emotion(1,14)><$voicel(1,9)>Qué interesant<qty;0(e,es)> es<genqty;0(e,a,os,as)><br><$cdef(27)><class><fqty(1)><refmateid;0></color><slide><br>que llevas..."
msgstr ""

#. en: <$emotion(1,37)><$voicel(1,7)>Lookin’ to hunt for treasure, are ya? In that case, I think I<br>can be of service!
msgctxt "2004:415"
msgid "<$emotion(1,37)><$voicel(1,7)>¿Vas a buscar tesoros? ¡Entonces permíteme que te<br>eche una mano, mozalbet<gen;-2(e,a)>!"
msgstr ""

#. en: <oneline><$emotion(1,60)><$voicel(1,7)>Ya always do so much fer me, <$cdef(27)><pname;0></color>.<br>I don’t<slide><br>even<slide><br>know<slide><br>how<slide><br>to<slide><br>properly<slide><br>thank ya!<clear><br><$emotion(1,8)><$voicel(1,10)>Fer now, I want ya to have this! Hope it conveys my<br>gratitude ’n’ all—at least a li’l bit!
msgctxt "2004:416"
msgid "<$emotion(1,60)><$voicel(1,7)>Te portas tan bien siempre conmigo que darte solo las<br>gracias me sabe a poco, <$cdef(27)><pname;0></color>.<clear><br><$emotion(1,8)><$voicel(1,10)>¡Qué menos que darte un regalito!"
msgstr "<$emotion(1,60)><$voicel(1,7)>Te portas tan bien siempre conmigo que darte solo las<br>gracias me sabe a poco, <$cdef(27)><pname;0></color>.<clear><br><$emotion(1,8)><$voicel(1,10)>¡Lo menos que puedo hacer es darte un regalito!"

#. en: <$emotion(1,8)><$voicel(1,9)>Thanks fer bein’ such a great friend! Hope we can keep<br>our friendship goin’ fer a good long while!
msgctxt "2004:417"
msgid "<$emotion(1,8)><$voicel(1,9)>¡No sabes cuánto agradezco la amistad que nos une!<br>¡Espero que la sigamos cultivando!"
msgstr ""

#. en: <$emotion(1,37)><$voicel(1,9)>Wow! That’s a nice find, tell ya what!<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,7)>Huntin’ for treasure sure is worth it, huh? Can’t wait to see<br>what we can scrounge up next time!
msgctxt "2004:418"
msgid "<$emotion(1,37)><$voicel(1,9)>¡Oh, eso no es moco de pavo!<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,7)>Si es que buscar tesoros es la mar de entretenido.<br>A ver qué encontramos la próxima vez."
msgstr "<$emotion(1,37)><$voicel(1,9)>¡Oh, eso no es moco de pavo!<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,7)>Si es que buscar tesoros es de lo más entretenido.<br>A ver qué encontramos la próxima vez."

#. en: <oneline><$emotion(1,38)><$voicel(1,9)><$pkcry;0(1,2)>! This here’s one o’ my favorite things! <$emotion(1,50)><$voicel(1,8)>I’m<br>plumb<slide><br>tickled pink!
msgctxt "2004:419"
msgid "<$emotion(1,38)><$voicel(1,9)>¡<$pkcry;0(1,2)>, caray! ¡No hay nada que me guste más<br>en el mundo! <$emotion(1,50)><$voicel(1,8)>¡Qué alegría me has dado!"
msgstr "<$emotion(1,38)><$voicel(1,9)>¡<$pkcry;0(1,2)>, caray! ¡No hay nada que me guste más<br>en el mundo! <$emotion(1,50)><$voicel(1,8)>¡Qué alegría me diste!"

#. en: <$comeff(1,14)><$facial(1,1)><$motion(1,805)><$voicel(1,6)>There’s someplace over yonder I’d like to go to.
msgctxt "2004:420"
msgid "<$comeff(1,14)><$facial(1,1)><$motion(1,805)><$voicel(1,6)>Estoy deseando ir a un lugar que hay por esos lares..."
msgstr "<$comeff(1,14)><$facial(1,1)><$motion(1,805)><$voicel(1,6)>Ya quiero ir a un lugar que hay por esos lares..."

#. en: <oneline><$comeff(1,6)><$motion(1,805)><$voicel(1,5)>Hm? You’re headed someplace far away,<br><$cdef(27)><pname;0></color>?<slide><br>I think<slide><br>I’ll<slide><br>stick<slide><br>around<slide><br>here,<slide><br>but<slide><br>you<slide><br>have<slide><br>fun, OK?
msgctxt "2004:421"
msgid "<$comeff(1,6)><$motion(1,805)><$voicel(1,5)>¡Canastos! ¿Acaso quieres llegar hasta las quimbambas,<br><$cdef(27)><pname;0></color>? Pues yo me quedo aquí, ea."
msgstr "<$comeff(1,6)><$motion(1,805)><$voicel(1,5)>¡Cielos! ¿Acaso quieres llegar hasta el fin del mundo,<br><$cdef(27)><pname;0></color>? Pues yo me quedo aquí, ¿eh?"

#. en: <$comeff(1,7)><$facial(1,9)><$motionoff(1,804)><$voicel(1,1)>But the road leadin’ that way is a bit rough, and I ain’t<br>rightly sure I can make the trek!
msgctxt "2004:422"
msgid "<$comeff(1,7)><$facial(1,9)><$motionoff(1,804)><$voicel(1,1)>Pero no sabes qué cansancio me entra, mocit<gen;-2(o,a)>. Me pesa<br>hasta el alma yendo por ahí. ¡Está hecho una pena!"
msgstr ""

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Hmmm... This here home’s a bit too small fer me, don’tcha<br>think? <$emotion(1,37)><$voicel(1,8)>I’d like me a slightly bigger one, if possible!
msgctxt "2004:426"
msgid "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>¡Caramba! No sé si voy a caber en esta casa...<br><$emotion(1,37)><$voicel(1,8)>¡Búscame una un poco más grande, por favor!"
msgstr ""

#. en: <$comeff(1,21)><$facial(1,4)><$motion(1,803)><$voicel(1,10)>This here home’s real well made, I tell ya what!
msgctxt "2004:427"
msgid "<$comeff(1,21)><$facial(1,4)><$motion(1,803)><$voicel(1,10)>Esta casa humana... ¡parece todo un hogar!"
msgstr ""

#. en: <$emotion(1,8)><$voicel(1,9)>Oh, really?! Thank ya kindly! I’m real excited!
msgctxt "2004:428"
msgid "<$emotion(1,8)><$voicel(1,9)>¡Muchas gracias, jovenzuel<gen;-2(o,a)>! ¡Tengo muchas ganas de<br>mudarme cuanto antes!"
msgstr ""

#. en: <$emotion(1,38)><$voicel(1,9)>Yeah, you sure did a good job! It’s a mighty fine home.
msgctxt "2004:429"
msgid "<$emotion(1,38)><$voicel(1,9)>¡Sin duda! ¡Es una casa magnífica, sí, señ<gen;-2(or,ora)>!"
msgstr ""

#. en: <$emotion(1,29)><$voicel(1,9)>Oh yeah? It’s really all right fer me to move into this<br>here home?!
msgctxt "2004:430"
msgid "<$emotion(1,29)><$voicel(1,9)>¡Recórcholis! ¿De verdad me puedo quedar a vivir aquí?"
msgstr ""

#. en: <$emotion(1,8)><$voicel(1,9)>I dunno if I’ve ever been so thankful for somethin’ in all<br>my days! I’m sure I’ll have a good time livin’ here!
msgctxt "2004:431"
msgid "<$emotion(1,8)><$voicel(1,9)>¡Te estaré eternamente agradecid<gen;-3(o,a)>! Presiento que voy a<br>ser muy feliz en mi nuevo y dulce hogar."
msgstr ""

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Awww... I was jus’ startin’ to get my hopes up...
msgctxt "2004:432"
msgid "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>¡No me digas eso, picaruel<gen;-2(o,a)>! Yo que me había hecho<br>ilusiones..."
msgstr ""

#. en: <$emotion(1,14)><$voicel(1,5)>Hm... Looks like this here home’s already a full house!<br>I’d hate to make things too cramped...<$motion(1,807)><$voicel(1,4)>so I think I might<slide><br>pass on movin’ in here.
msgctxt "2004:433"
msgid "<$emotion(1,14)><$voicel(1,5)>¡Caray! ¡Pero si aquí ya hay Pokémon viviendo!<br>¡Otra cosa, no sé, pero inquilinos no faltan!<clear><br><$motion(1,807)><$voicel(1,4)>Prefiero no incordiar."
msgstr "<$emotion(1,14)><$voicel(1,5)>¡Caray! ¡Pero si aquí ya hay Pokémon viviendo!<br>¡Otra cosa, no sé, pero inquilinos no faltan!<clear><br><$motion(1,807)><$voicel(1,4)>Prefiero no molestar."

#. en: <$comeff(1,5)><$motion(1,803)><$voicel(1,9)>Oooh! Looks like ya hit the jackpot!<clear><br><$emotion(1,38)><$voicel(1,7)>You’re even a pro at treasure hunting, huh... Ya really are<br>somethin’ else, <$cdef(27)><pname;0></color>!
msgctxt "2004:434"
msgid "<$comeff(1,5)><$motion(1,803)><$voicel(1,9)>¡Por Arceus! ¡Parece que te ha tocado el premio gordo!<clear><br><$emotion(1,38)><$voicel(1,7)>Se ve que tienes un don para encontrar tesoros también.<br>¡Si es que se te da bien todo, moz<gen;-2(o,a)>!"
msgstr "<$comeff(1,5)><$motion(1,803)><$voicel(1,9)>¡Por Arceus! ¡Parece que te tocó el premio gordo!<clear><br><$emotion(1,38)><$voicel(1,7)>Se ve que tienes un don para encontrar tesoros también.<br>¡Si es que se te da bien todo, muchach<gen;-2(o,a)>!"

#. en: <$emotion(1,29)><$voicel(1,5)>Hm?! What’s that shiny doodad you’ve got there,<br><$cdef(27)><pname;0></color>?
msgctxt "2004:435"
msgid "<oneline><$emotion(1,29)><$voicel(1,5)>¿Eh? ¿Qué es ese trasto tan brillante que llevas ahí,<br><$cdef(27)><pname;0></color>?"
msgstr ""

#. en: <$emotion(1,37)><$voicel(1,9)>That right? Fer me?! Haha! Thank ya kindly! <$emotion(1,8)><$voicel(1,8)>Guess I’ve<br>gotta give you somethin’ in return, then!
msgctxt "2004:436"
msgid "<$emotion(1,37)><$voicel(1,9)>¿Cómo? ¿Para mí? ¡Bua, ja, ja! Desde luego, ¡qué mocit<gen;-2(o,a)><br>tan generos<gen;-2(o,a)> que eres! ¡Muchas gracias!<clear><br><$emotion(1,8)><$voicel(1,8)>Pues permíteme que te corresponda como te mereces."
msgstr ""

#. en: <$emotion(1,37)><$voicel(1,7)>I’m afraid a nice gift like that’d be wasted on li’l ol’ me!<br><$emotion(1,8)><$voicel(1,10)>Thanks fer thinkin’ of me, though!
msgctxt "2004:437"
msgid "<$emotion(1,37)><$voicel(1,7)>Uy, quita, quita. Darme a mí un regalo de ese calibre<br>sería un desperdicio.<clear><br><$emotion(1,8)><$voicel(1,10)>Pero se agradece el detalle, jovenzuel<gen;-2(o,a)>."
msgstr "<$emotion(1,37)><$voicel(1,7)>Uy, no, no. Darme a mí un regalo de ese calibre<br>sería un desperdicio.<clear><br><$emotion(1,8)><$voicel(1,10)>Pero se agradece el detalle, jovenzuel<gen;-2(o,a)>."

#. en: <oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Hmmm... Y’know, <$cdef(27)><pname;0></color>, I’m not quite<br>sure<slide><br><$comeff(1,7)><$facial(1,9)><$motion(1,802)><$voicel(1,4)>I<slide><br>know<slide><br>what<slide><br>to<slide><br>do<slide><br>with that...<clear><br><$emotion(1,37)><$voicel(1,6)>Sorry, but I’m thinkin’ it’d be wasted on me right now!
msgctxt "2004:438"
msgid "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Hmm... Y qué podría hacer yo con eso...<br><$comeff(1,7)><$facial(1,9)><$motion(1,802)><$voicel(1,4)>¡Es que no se me ocurre ni qué uso darle!<clear><br><$emotion(1,37)><$voicel(1,6)>Lo siento en el alma, pero no puedo aceptar tu regalo."
msgstr ""

#. en: <oneline><$emotion(1,60)><$voicel(1,9)>Gwahaha! You’re a real jokester, aren’tcha,<br><$cdef(27)><pname;0></color>?<slide><br>I<slide><br>already<slide><br>live<slide><br>here,<slide><br>ya know!
msgctxt "2004:439"
msgid "<$emotion(1,60)><$voicel(1,9)>¡Bua, ja, ja! ¡Serás picaruel<gen;-2(o,a)>, <$cdef(27)><pname;0></color>!<br>¡Si este ya es mi hogar!"
msgstr "<$emotion(1,60)><$voicel(1,9)>¡Bua, ja, ja! ¡Ay, picaruel<gen;-2(o,a)>, <$cdef(27)><pname;0></color>!<br>¡Si este ya es mi hogar!"

#. en: <$comeff(1,10)><$facial(1,1)><$motion(1,806)><$voicel(1,7)>I sure would be thankful if ya could clear the way fer me!
msgctxt "2004:442"
msgid "<$comeff(1,10)><$facial(1,1)><$motion(1,806)><$voicel(1,7)>Te estaría la mar de agradecid<gen;-3(o,a)> si te ocuparas de<br>adecentarlo un poco, para que se pueda pasear..."
msgstr "<$comeff(1,10)><$facial(1,1)><$motion(1,806)><$voicel(1,7)>Te estaría muy agradecid<gen;-3(o,a)> si te ocuparas de<br>adecentarlo un poco, para que se pueda pasear..."

#. en: <$emotion(1,14)><$voicel(1,7)>Time’s up! That’s game over, <$cdef(27)><pname;0></color>!
msgctxt "2004:443"
msgid "<$emotion(1,14)><$voicel(1,7)>¡Se te ha acabado el tiempo!"
msgstr "<$emotion(1,14)><$voicel(1,7)>¡Se te acabó el tiempo!"

#. en: <oneline><$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,7)>W-well I’ll be darned... And here I thought we had us an<br>unbeatable team...<clear><br><$emotion(1,8)><$voicel(1,9)>You really are somethin’ else, <$cdef(27)><pname;0></color>!<br>Here—a<slide><br>prize<slide><br>fer<slide><br>a<slide><br>game<slide><br>well played!
msgctxt "2004:444"
msgid "<$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,7)>¿Có-cómo es posible? Hemos hecho cuanto estaba en<br>nuestras manos...<clear><br><$emotion(1,8)><$voicel(1,9)>¡Lo reconozco, eres dur<gen;-2(o,a)> de roer! ¡Aquí tienes tu<br>recompensa!"
msgstr "<$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,7)>¿Có-cómo es posible? Hicimos cuanto estaba en<br>nuestras manos...<clear><br><$emotion(1,8)><$voicel(1,9)>¡Lo reconozco, eres dur<gen;-2(o,a)> de roer! ¡Aquí tienes tu<br>recompensa!"

#. en: <$emotion(1,29)><$voicel(1,7)>How ya feel about playin’ another round? If you’re up fer<br>it, that is!
msgctxt "2004:445"
msgid "<$emotion(1,29)><$voicel(1,7)>¿Te apetece otra ronda? ¿Qué me dices, mocit<gen;-2(o,a)>?"
msgstr "<$emotion(1,29)><$voicel(1,7)>¿Quieres otra ronda? ¿Qué me dices, mocit<gen;-2(o,a)>?"

#. en: <$emotion(1,38)><$voicel(1,9)>Heck yeah! That’s the spirit! I’m gonna win, though!
msgctxt "2004:446"
msgid "<$emotion(1,38)><$voicel(1,9)>¡No podría ser de otra manera! ¡No pienso perder, ya verás!"
msgstr ""

#. en: <$motion(1,806)><$voicel(1,5)>All righty, then. Guess we can play again some other time!
msgctxt "2004:447"
msgid "<$motion(1,806)><$voicel(1,5)>Bueeeno, qué se le va a hacer. Otra vez será."
msgstr ""

#. en: <$comeff(1,14)><$facial(1,9)><$motion(1,666)><$voicel(1,5)>Hmmm... This place feels a li’l empty... I think I’d get sad if<br>I lived here.<clear><br><$emotion(1,41)><$voicel(1,3)>Sorry to turn down the offer, but I’m gonna have to pass<br>on movin’ here, <$cdef(27)><pname;0></color>...
msgctxt "2004:449"
msgid "<$comeff(1,14)><$facial(1,9)><$motion(1,666)><$voicel(1,5)>Hmm, esto debe de ser lo que llaman una decoración<br>minimalista, pero a mí me parece más bien \"deprimista\".<clear><br><$emotion(1,41)><$voicel(1,3)>Discúlpame, moz<gen;-2(o,a)>, pero qué quieres que te diga... Bueno,<br>te digo que aquí, lo que es mudar, no me voy a mudar."
msgstr "<$comeff(1,14)><$facial(1,9)><$motion(1,666)><$voicel(1,5)>Hmm, esto debe de ser lo que llaman una decoración<br>minimalista, pero a mí me parece más bien \"deprimista\".<clear><br><$emotion(1,41)><$voicel(1,3)>Discúlpame, chic<gen;-2(o,a)>, pero qué quieres que te diga... Bueno,<br>te digo que aquí, lo que es mudar, no me voy a mudar."

#. en: <$emotion(1,60)><$voicel(1,10)>All righty! Jus’ leave it to me!<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,807)><$voicel(1,5)>Might take a bit o’ time, though... Come back a li’l later, if<br>you’d be so kind.
msgctxt "2004:452"
msgid "<$emotion(1,60)><$voicel(1,10)>¡Yo me encargo, mozalbet<gen;-2(e,a)>!<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,807)><$voicel(1,5)>Pero bueno, ya sabes, las cosas de palacio van despacio.<br>Vuelve más tarde."
msgstr ""

#. en: <$emotion(1,14)><$voicel(1,7)>Still workin’ on it! Sorry! Gimme just a li’l more time!
msgctxt "2004:453"
msgid "<$emotion(1,14)><$voicel(1,7)>¡Perdona, moz<gen;-2(o,a)>! ¡Tendrás que esperar un poco más!"
msgstr "<$emotion(1,14)><$voicel(1,7)>¡Perdón, chic<gen;-2(o,a)>! ¡Tendrás que esperar un poco más!"

#. en: <oneline><$voicel(1,7)><$emotion(1,14)><$cdef(27)><pname;0></color>! Here’s the<br><$cdef(27)><class><reftarid;1></color><slide><br>you<slide><br>asked<slide><br>me fer!
msgctxt "2004:454"
msgid "<$cdef(27)><oneline><$voicel(1,7)><$emotion(1,14)></color>¡A ti te quería yo ver! Mira, tengo<br><dart;1()><$cdef(27)><class><reftarid;1></color><slide><br>que me pediste."
msgstr ""

#. en: <$emotion(1,31)><$voicel(1,3)>Oof. Sorry, I’m a li’l preoccupied right this minute...
msgctxt "2004:455"
msgid "<$emotion(1,31)><$voicel(1,3)>Ya lo siento, mozalbet<gen;-2(e,a)>, pero ahora no está el horno<br>para bollos..."
msgstr "<$emotion(1,31)><$voicel(1,3)>Lo siento, mozalbet<gen;-2(e,a)>, pero ahora no está el horno<br>para bollos..."

#. en: <$comeff(1,6)><$facial(1,9)><$motion(1,827)><$voicel(1,3)>Hmmm. My memory might be a li’l fuzzy, but I thought fer<br>sure my home was ’round here somewhere...
msgctxt "2004:459"
msgid "<$comeff(1,6)><$facial(1,9)><$motion(1,827)><$voicel(1,3)>¿Eh? Ay, ay, ay... Que me lleve Drifblim si no estaba<br>mi hogar aquí antes..."
msgstr ""

#. en: <$comeff(1,11)><$motion(1,803)><$voicel(1,8)><$facial(1,13)>Well, this ain’t good! My home is gone! <$facial(1,9)><$voicel(1,9)><$comeff(1,19)>What in tarnation?!
msgctxt "2004:460"
msgid "<$comeff(1,11)><$motion(1,803)><$voicel(1,8)><$facial(1,13)>¡Repámpanos! ¡¿Qué ha sido de mi casita querida?!<br><$facial(1,9)><$voicel(1,9)><$comeff(1,19)>Estoy ya muy mayor para estos sustos...<clear><br>Ayyy, Drifblim, llévame pronto..."
msgstr "<$comeff(1,11)><$motion(1,803)><$voicel(1,8)><$facial(1,13)>¡Santo cielo! ¡¿Qué fue de mi casita querida?!<br><$facial(1,9)><$voicel(1,9)><$comeff(1,19)>Estoy ya muy mayor para estos sustos...<clear><br>Ayyy, Drifblim, llévame pronto..."

#. en: <$comeff(1,14)><$voicel(1,5)><$motion(1,803)>Well, I s’pose there ain’t no use cryin’ over spilt milk.<clear><br><$voicel(1,8)><$comeff(1,10)><$motion(1,801)><$facial(1,4)>Guess I’ll jus’ take my time huntin’ fer a new home.
msgctxt "2004:461"
msgid "<$comeff(1,14)><$voicel(1,5)><$motion(1,803)>Bueno, a lo hecho... sintecho. <$voicel(1,8)><$comeff(1,10)><$motion(1,801)><$facial(1,4)>¡Habrá que ponerse<br>a buscar otro hogar!"
msgstr ""

#. en: <oneline><$comeff(1,5)><$motion(1,803)><$voicel(1,8)>Hot dang! This sure does look like a nice place to live!<clear><br><$voicel(1,7)><$comeff(1,10)><$facial(1,4)>You made this, <$cdef(27)><pname;0></color>? Did a mighty<br>fine<slide><br>job,<slide><br>if<slide><br>I<slide><br>do<slide><br>say<slide><br>so myself!<clear><br><$voicel(1,9)><$comeff(1,21)><$motion(1,801)>I do believe I can make myself right at home here! <$voicel(1,10)>Thank<br>ya kindly!
msgctxt "2004:462"
msgid "<$comeff(1,5)><$motion(1,803)><$voicel(1,8)>¡Oh! ¡Créeme si te digo que no le haría ascos a vivir aquí!<br><$voicel(1,7)><$comeff(1,10)><$facial(1,4)>¿Lo has preparado tú, <$cdef(27)><pname;0></color>?<clear><br>Visto lo visto, ¡se nota que tienes maña para esto!<clear><br><$voicel(1,9)><$comeff(1,21)><$motion(1,801)>Pues como dicen que no dejes para mañana lo que puedas<br>habitar hoy... ¡me voy a mudar ahora mismo!<slide><br><$voicel(1,10)>¡Que Arceus te lo pague!"
msgstr "<$comeff(1,5)><$motion(1,803)><$voicel(1,8)>¡Oh! ¡Créeme si te digo que me encantaría vivir aquí!<br><$voicel(1,7)><$comeff(1,10)><$facial(1,4)>¿Lo preparaste tú, <$cdef(27)><pname;0></color>?<clear><br>Visto lo visto, ¡se nota que tienes maña para esto!<clear><br><$voicel(1,9)><$comeff(1,21)><$motion(1,801)>Pues como dicen que no dejes para mañana lo que puedas<br>habitar hoy... ¡me voy a mudar ahora mismo!<slide><br><$voicel(1,10)>¡Que Arceus te lo pague!"

#. en: <oneline><$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>You say ya got me<br><iart;0()><$cdef(27)><fqty(1)><class><stfrevp;0></color>?<clear><br><$comeff(1,21)><$voicel(1,10)><$motion(1,801)>Thank ya kindly! I’ll take me a look!
msgctxt "2004:463"
msgid "<oneline><$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>¡Oooh! ¿Dices que me has conseguido<br><iart;0()><fqty(1)><class><$cdef(27)><stfrevp;0></color>?<clear><br><$comeff(1,21)><$voicel(1,10)><$motion(1,801)>¡Se agradece, jovenzuel<gen;-2(o,a)>! En nada iré a echar un vistazo."
msgstr "<oneline><$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>¡Oooh! ¿Dices que me conseguiste<br><iart;0()><fqty(1)><class><$cdef(27)><stfrevp;0></color>?<clear><br><$comeff(1,21)><$voicel(1,10)><$motion(1,801)>¡Se agradece, jovenzuel<gen;-2(o,a)>! Enseguida iré a echar un vistazo."

#. en: <oneline><$comeff(1,13)><$facial(1,4)><$motion(1,805)><$voicel(1,10)><$pkcry;0(1,2)>! ♪ Thanks fer the mighty-fine livin’<br>arrangements, <$cdef(27)><pname;1></color>!
msgctxt "2004:464"
msgid "<$comeff(1,13)><$facial(1,4)><$motion(1,805)><$voicel(1,10)>¡Madre del amor hermoso! ¡Gracias por esta señora casa,<br><$cdef(27)><pname;1></color>! ♪<fcap><$pkcry;0(1,2)>.♪"
msgstr "<$comeff(1,13)><$facial(1,4)><$motion(1,805)><$voicel(1,10)>¡Santo cielo! ¡Gracias por esta señora casa,<br><$cdef(27)><pname;1></color>! ♪<fcap><$pkcry;0(1,2)>.♪"

#. en: <$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,6)>Could ya give this to <$cdef(27)><refpname;0> </color>fer me?<clear><br><$comeff(1,10)><$voicel(1,8)>Just tell ’em it’s what they asked for. They’ll understand,<br>I reckon!
msgctxt "2004:465"
msgid "<oneline><$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,6)>¿Podrías darle esto a <$cdef(27)><refpname;0></color>, moz<gen;-2(o,a)>?<br><$comeff(1,10)><$voicel(1,8)>Si le dices<slide><br>que es lo que me pidió, ¡sabrá de qué se trata!"
msgstr "<oneline><$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,6)>¿Podrías darle esto a <$cdef(27)><refpname;0></color>, chic<gen;-2(o,a)>?<br><$comeff(1,10)><$voicel(1,8)>Si le dices<slide><br>que es lo que me pidió, ¡sabrá de qué se trata!"

#. en: <oneline><$voicel(1,7)><$motion(1,803)><$comeff(1,3)>Howdy, <$cdef(27)><pname;0></color>! I thought up a quiz!<br><$voicel(1,8)><$facial(1,1)><$comeff(1,6)>How<slide><br>ya<slide><br>feel<slide><br>about<slide><br>givin’<slide><br>it a go?
msgctxt "2004:466"
msgid "<oneline><$voicel(1,7)><$motion(1,803)><$comeff(1,3)>Oye, <$cdef(27)><pname;0></color>, he discurrido<br>un jueguecito<slide><br>de los míos.<clear><br><$voicel(1,8)><$facial(1,1)><$comeff(1,6)>¿Qué me dices? ¿Te apetece probar fortuna?"
msgstr "<oneline><$voicel(1,7)><$motion(1,803)><$comeff(1,3)>Oye, <$cdef(27)><pname;0></color>, inventé<br>un jueguito<slide><br>de los míos.<clear><br><$voicel(1,8)><$facial(1,1)><$comeff(1,6)>¿Qué me dices? ¿Quieres probar fortuna?"

#. en: <$voicel(1,8)><$motion(1,803)><$comeff(1,1)><$facial(1,4)>That’s the spirit! Here we go!<clear><br><$voicel(1,5)><$emotion(1,33)>Who d’ya think is taller? Me or <$cdef(27)><sizecmppk;1></color>?
msgctxt "2004:467"
msgid "<oneline><$voicel(1,8)><$motion(1,803)><$comeff(1,1)><$facial(1,4)>¡Así me gusta! Pues ojo que voy...<clear><br><$voicel(1,5)><$emotion(1,33)>¿Quién gana en altura, <dart;1()><$cdef(27)><sizecmppk;1></color><br>o u<gen;-3(n,na)> servido<gen;-3(r,ra)>?"
msgstr ""

#. en: <$voicel(1,5)><$motion(1,824)><$comeff(1,3)>That so? Well, I hope you’ll give it a shot some other time!
msgctxt "2004:468"
msgid "<$voicel(1,5)><$motion(1,824)><$comeff(1,3)>Vaya, qué lástima... ¡A ver si la próxima vez te pillo<br>más predispuest<gen;-2(o,a)>!"
msgstr "<$voicel(1,5)><$motion(1,824)><$comeff(1,3)>Vaya, qué lástima... ¡A ver si la próxima vez<br>te encuentro más predispuest<gen;-2(o,a)>!"

#. en: <oneline>Hm...<wait(0.4)><$voicel(1,9)><$emotion(1,22)><$comeff(1,20)> Yes indeedy! That is correct! Well done,<br><$cdef(27)><pname;0></color>!<clear><br><$voicel(1,7)><$facial(1,5)><$comeff(1,21)>You’re awful observant when it comes to Pokémon,<br>aren’t ya?
msgctxt "2004:469"
msgid "... <wait(0.4)><$cdef(27)><$voicel(1,9)></color><$emotion(1,22)><$comeff(1,20)>¡Efectivamente! Eres más list<gen;-2(o,a)> que el hambre, ¿eh?<clear><br><$voicel(1,7)><$facial(1,5)><$comeff(1,21)>¡Se nota que eres muy <gen;-2(observador,observadora)> en lo que respecta<br>a los Pokémon!"
msgstr "... <wait(0.4)><$cdef(27)><$voicel(1,9)></color><$emotion(1,22)><$comeff(1,20)>¡Efectivamente! Eres de lo más list<gen;-2(o,a)>, ¿eh?<clear><br><$voicel(1,7)><$facial(1,5)><$comeff(1,21)>¡Se nota que eres muy <gen;-2(observador,observadora)> en lo que respecta<br>a los Pokémon!"

#. en: Hm... <wait(0.4)><$voicel(1,3)><$motion(1,807)><$comeff(1,10)><$facial(1,13)>Nope! That ain’t right! Mighty clever question I came<br>up with though, eh?<clear><br><$voicel(1,10)><$motion(1,803)><$comeff(1,9)><$facial(1,4)>Hope you’ll come try my quiz again sometime!
msgctxt "2004:470"
msgid "... <wait(0.4)><$voicel(1,3)><$motion(1,807)><$comeff(1,10)><$facial(1,13)>Pues no has acertado, ¡se siente! Es que la preguntita<br>también se las traía, ¿eh? ¡Buen<gen;-3(o,a)> soy yo!<clear><br><$voicel(1,10)><$motion(1,803)><$comeff(1,9)><$facial(1,4)>¡Espero que esto no te desanime y lo vuelvas a intentar!"
msgstr "... <wait(0.4)><$voicel(1,3)><$motion(1,807)><$comeff(1,10)><$facial(1,13)>Pues no acertaste, ¡mala suerte! Es que la preguntita<br>también se las traía, ¿eh? ¡Buen<gen;-3(o,a)> soy yo!<clear><br><$voicel(1,10)><$motion(1,803)><$comeff(1,9)><$facial(1,4)>¡Espero que esto no te desanime y lo vuelvas a intentar!"

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>Oh? You made this home?<clear><br><$comeff(1,21)><$voicel(1,10)><$motion(1,801)>Well then, I s’pose it’d be rude of me NOT to live here!
msgctxt "2004:471"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>¡Lo veo y no lo creo! ¿Me has preparado este rinconcito<br>para que viva aquí?<clear><br><$comeff(1,21)><$voicel(1,10)><$motion(1,801)>¡A vivienda regalada, quien no la pilla es tontolaba!"
msgstr "<$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>¡Lo veo y no lo creo! ¿Me preparaste este rinconcito<br>para que viva aquí?<clear><br><$comeff(1,21)><$voicel(1,10)><$motion(1,801)>¡A casa regalada, no se le mira la fachada!"

#. en: <oneline><$voicel(1,7)><$emotion(1,15)>Well, I’ll be darned! You’re <$cdef(27)><pname;1></color>,<br>aren’t ya?<clear><br>That is one mighty fine <$cdef(27)><$spwfull(36)></color><$cdef(27)>ation</color>!
msgctxt "2004:472"
msgid "<$voicel(1,7)><$emotion(1,15)>¡Recórcholis! ¿Eres tú, <$cdef(27)><pname;1></color>?<clear><br>¡Eso sí que es una señora <$cdef(27)>transformación</color><nbs2><$spwicon(36)> y lo demás<br>son paparruchas!"
msgstr ""

#. en: <oneline><$comeff(1,14)><$facial(1,9)><$motion(1,805)><$voicel(1,3)>Well... It sure did SEEM like a fun idea, but I reckon we<br>don’t got enough space to play!<clear><br><$emotion(1,29)><$voicel(1,6)>Could ya maybe help clear some space fer us,<br><$cdef(27)><pname;0></color>?
msgctxt "2004:476"
msgid "<oneline><$comeff(1,14)><$facial(1,9)><$motion(1,805)><$voicel(1,3)>Mi alborozo en un pozo... Con tanta estrechez por aquí,<br>a ver quién es <gen;-3(el,la)> guap<gen;-3(o,a)> que se esconde.<clear><br><$emotion(1,29)><$voicel(1,6)>¿No podrías hacer algo más de espacio,<br><$cdef(27)><pname;0></color>?"
msgstr "<oneline><$comeff(1,14)><$facial(1,9)><$motion(1,805)><$voicel(1,3)>Mi alborozo en un pozo... Con tanta estrechez por aquí,<br>a ver quién es <gen;-3(el,la)> atrevid<gen;-3(o,a)> que se esconde.<clear><br><$emotion(1,29)><$voicel(1,6)>¿No podrías hacer algo más de espacio,<br><$cdef(27)><pname;0></color>?"

#. en: <$emotion(1,31)><$voicel(1,3)>I sure am sorry, but that don’t seem like a suitable place<br>fer me to live...
msgctxt "2004:477"
msgid "<$emotion(1,31)><$voicel(1,3)>Me tienes que perdonar, jovenzuel<gen;-2(o,a)>, pero este lugar no<br>parece el más idóneo para alguien con mis achaques..."
msgstr ""

#. en: <oneline><$voicel(1,3)><$emotion(1,3)><$comeff(1,17)>Hope you’ll forgive me, <$cdef(27)><pname;0></color>! I’m<br>stuffed<slide><br>to<slide><br>the<slide><br>brim<slide><br>right<slide><br>now!<slide><br><$voicel(1,8)><$motion(1,803)><$comeff(1,9)><$facial(1,4)>But I<slide><br>’preciate<slide><br>the offer!
msgctxt "2004:478"
msgid "<oneline><$voicel(1,3)><$emotion(1,3)><$comeff(1,17)>Uy, perdona, <$cdef(27)><pname;0></color>, pero ahora<br>mismo no tengo<slide><br>hambre ninguna.<slide><br><$voicel(1,8)><$motion(1,803)><$comeff(1,9)><$facial(1,4)>¡Aun así, gracias por el detalle!"
msgstr "<oneline><$voicel(1,3)><$emotion(1,3)><$comeff(1,17)>Uy, perdona, <$cdef(27)><pname;0></color>, pero ahora<br>mismo no tengo<slide><br>nada de hambre.<slide><br><$voicel(1,8)><$motion(1,803)><$comeff(1,9)><$facial(1,4)>¡Aun así, gracias por el detalle!"

#. en: <$emotion(1,29)><$voicel(1,6)>Where we talkin’ about havin’ me live?
msgctxt "2004:481"
msgid "<$emotion(1,29)><$voicel(1,6)>¿Dónde puedo dejar mis bártulos?"
msgstr ""

#. en: <$emotion(1,37)><$voicel(1,7)>All righty! So that’s gonna be my new home, huh?
msgctxt "2004:482"
msgid "<$emotion(1,37)><$voicel(1,7)>¡Jo, jo! ¿Me encuentro ante mi nuevo hogar?"
msgstr ""

#. en: <$voicel(1,8)><$motion(1,803)><$comeff(1,9)>That’s the spirit! Here we go!<clear><br><$voicel(1,5)><$emotion(1,33)>Who d’ya think is heavier? Me or <$cdef(27)><weightcmppk;1></color>?
msgctxt "2004:484"
msgid "<$voicel(1,8)><$motion(1,803)><$comeff(1,9)>¡Así se habla! ¡Pues vamos allá!<clear><br><$voicel(1,5)><$emotion(1,33)>¿Quién pesa más, <dart;1()><$cdef(27)><weightcmppk;1> </color>o yo?"
msgstr "<$voicel(1,8)><$motion(1,803)><$comeff(1,9)>¡Así se habla! ¡Pues adelante!<clear><br><$voicel(1,5)><$emotion(1,33)>¿Quién pesa más, <dart;1()><$cdef(27)><weightcmppk;1> </color>o yo?"

#. en: <$comeff(1,6)><$motion(1,827)><$voicel(1,8)>Yeah, <$cdef(27)><pname;0></color>? That strike yer fancy?
msgctxt "2004:489"
msgid "<$comeff(1,6)><$motion(1,827)><$voicel(1,8)>Vaya, veo que este artículo te ha entrado por los ojos,<br>¿no es así, <$cdef(27)><pname;0></color>?"
msgstr "<$comeff(1,6)><$motion(1,827)><$voicel(1,8)>Vaya, veo que este artículo te entró por los ojos,<br>¿no es así, <$cdef(27)><pname;0></color>?"

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>That so? Well then, what do ya wanna trade fer it?
msgctxt "2004:490"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Faltaría más. ¿Qué me ofreces a cambio, mocit<gen;-2(o,a)>?"
msgstr "<$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Claro que sí. ¿Qué me ofreces a cambio, mocit<gen;-2(o,a)>?"

#. en: <$facial(1,4)><$comeff(1,1)><$motion(1,803)><$voicel(1,7)>Hahaha! Well, don’t come cryin’ to me if it’s gone later<br>and ya end up wantin’ it!
msgctxt "2004:491"
msgid "<$facial(1,4)><$comeff(1,1)><$motion(1,803)><$voicel(1,7)>Pues si luego se agota no me vengas llorando, ¿eh?<br>¡Bua, ja, ja!"
msgstr ""

#. en: <$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Hahaaa! I reckon we made us a good trade!
msgctxt "2004:492"
msgid "<$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Bua, ja, ja! ¡Diría que aquí se ha hecho buen negocio!<br>Bien está lo que bien acaba."
msgstr "<$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Bua, ja, ja! ¡Diría que aquí se hizo buen negocio!<br>Bien está lo que bien acaba."

#. en: <$comeff(1,6)><$voicel(1,7)><$facial(1,1)>Hmmm? Not gonna make a trade after all? Well, jus’<br>gimme a holler if ya change yer mind!
msgctxt "2004:493"
msgid "<$comeff(1,6)><$voicel(1,7)><$facial(1,1)>¿Te lo has pensado mejor? No pasa nada. Si cambias<br>de idea, por aquí estaremos."
msgstr "<$comeff(1,6)><$voicel(1,7)><$facial(1,1)>¿Lo pensaste mejor? No pasa nada. Si cambias<br>de idea, por aquí estaremos."

#. en: <$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Hahaaa! I reckon we made us a good trade!<clear><br><$comeff(1,10)><$voicel(1,7)><$motion(1,803)>And now I’m plumb outta things to trade! But don’t you<br>worry, I’ll git some new things in shortly!
msgctxt "2004:494"
msgid "<$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Bua, ja, ja! ¡Todo el mundo sale ganando! Esta mercancía<br>es tan buena que me la quitan de las manos.<clear><br><$comeff(1,10)><$voicel(1,7)><$motion(1,803)>Y lo digo literalmente, mocit<gen;-2(o,a)>, porque no me queda más.<br>¡Pero ya me aprovisionaré para la próxima, descuida!"
msgstr ""

#. en: <oneline><$comeff(1,1)><$motion(1,803)><$voicel(1,7)>Well, hey there, <$cdef(27)><pname;0></color>. I was jus’<br>about<slide><br>to<slide><br>mosey<slide><br>on<slide><br>over<slide><br>to the<slide><br><$cdef(27)><$voicel(1,8)><fqty(1)><$ifull(1325)></color>.<clear><br><$comeff(1,13)><$voicel(1,9)><$motion(1,801)><$facial(1,5)>How ’bout you come with me? I might jus’ have somethin’<br>real nice fer ya!
msgctxt "2004:495"
msgid "<oneline><$comeff(1,1)><$motion(1,803)><$voicel(1,7)>¿Cómo andamos, <$cdef(27)><pname;0></color>? ¿Tirando?<br>Yo sí que voy tirando...<slide><br><$voicel(1,8)>hacia la <$cdef(27)><fqty(1)><$ifull(1325)></color>.<clear><br><$comeff(1,13)><$voicel(1,9)><$motion(1,801)><$facial(1,5)>¿Qué te parece si te acercas conmigo? ¡No vaya a ser<br>que tenga alguna bicoca que te pueda interesar!"
msgstr "<oneline><$comeff(1,1)><$motion(1,803)><$voicel(1,7)>¿Cómo andamos, <$cdef(27)><pname;0></color>? ¿Bien?<br>Yo voy andando...<slide><br><$voicel(1,8)>hacia la <$cdef(27)><fqty(1)><$ifull(1325)></color>.<clear><br><$comeff(1,13)><$voicel(1,9)><$motion(1,801)><$facial(1,5)>¿Qué te parece si te acercas conmigo? ¡No vaya a ser<br>que tenga alguna ganga que te pueda interesar!"

#. en: <oneline><$comeff(1,1)><$motion(1,803)><$voicel(1,7)>Well, I’m sorry, <$cdef(27)><pname;0></color>, but I’ve<br>already<slide><br>closed<slide><br>down<slide><br>for<slide><br>the<slide><br>day!<slide><br><$voicel(1,5)><$facial(1,4)><$comeff(1,9)>Come again some other time!
msgctxt "2004:496"
msgid "<oneline><$comeff(1,1)><$motion(1,803)><$voicel(1,7)>Lo siento en el alma, <$cdef(27)><pname;0></color>,<br>pero se acabó lo que<slide><br>se negociaba.<slide><br><$voicel(1,5)><$facial(1,4)><$comeff(1,9)>¡Hasta la próxima vez!"
msgstr ""

#. en: <$comeff(1,14)><$voicel(1,5)>Oooh. Now that’s a mighty fine item...
msgctxt "2004:497"
msgid "<$comeff(1,14)><$voicel(1,5)>¡Madre del amor hermoso, qué artículos venden por ahí!<br>Cosas veredes..."
msgstr "<$comeff(1,14)><$voicel(1,5)>¡Santo cielo, qué artículos venden por ahí!<br>Cosas veredes..."

#. en: <$emotion(1,8)><$voicel(1,9)>Oh?! Well, now ain’t this just wonderful! I was jus’ startin’<br>to get a li’l hungry.
msgctxt "2004:500"
msgid "<$emotion(1,8)><$voicel(1,9)>¡Oh! Pues con lo que me estaban rugiendo las tripas,<br>¡esto me viene estupendamente!"
msgstr ""

#. en: <oneline><$comeff(1,3)><$voicel(1,7)>Howdy, <$cdef(27)><pname;0></color>! That look on yer face...<br>You<slide><br>had<slide><br>a<slide><br>good<slide><br>night’s<slide><br>sleep, huh!<clear><br><$emotion(1,60)><$voicel(1,9)>On second thought...I reckon you’d have that same smile<br>on yer face even if ya didn’t sleep well!
msgctxt "2004:501"
msgid "<oneline><$comeff(1,3)><$voicel(1,7)>Tienes cara de haber dormido como un bebé,<br><$cdef(27)><pname;0></color>.<clear><br><$emotion(1,60)><$voicel(1,9)>Aunque, caray, yo diría que sin dormir también tendrías<br>esa cara risueña y carente de preocupaciones."
msgstr ""

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,6)>The sun sure is way high up in the sky...<clear><br><$emotion(1,37)><$voicel(1,7)>It never says to itself, “Maybe I oughta go down closer to<br>the ground today,” y’know? I can’t help but respect that<slide><br>kinda uncompromisin’ discipline.
msgctxt "2004:502"
msgid "<$comeff(1,14)><$motion(1,666)><$voicel(1,6)>El sol está allá en lo alto bien quietecito. Como dicen:<br>\"Se queda siempre el Lorenzo donde estaba al comienzo\".<clear><br><$emotion(1,37)><$voicel(1,7)>No es tan caprichoso como para bajar cuando le venga<br>en gana a darse un garbeo... Se merece mi admiración."
msgstr "<$comeff(1,14)><$motion(1,666)><$voicel(1,6)>El sol está allá en lo alto bien quietecito. Como dicen:<br>\"Arriba se queda el sol, quieto como un farol\".<clear><br><$emotion(1,37)><$voicel(1,7)>No es tan caprichoso como para bajar cuando le venga<br>en gana a dar un paseo... Se merece mi admiración."

#. en: <$comeff(1,9)><$motion(1,806)><$voicel(1,8)>I sure do love this time o’ day...<clear><br><$comeff(1,14)><$voicel(1,5)>There’s always a nice gentle breeze, and everybody’s faces<br>are <$emotion(1,38)><$voicel(1,9)>lit up nicely by the settin’ sun.
msgctxt "2004:503"
msgid "<$comeff(1,9)><$motion(1,806)><$voicel(1,8)>Esta hora del día es mi favorita...<clear><br><$comeff(1,14)><$voicel(1,5)>Esa brisa tan apacible que te da la vida... <wait(0.4)><$emotion(1,38)><$voicel(1,9)>y las caras de<br>los demás que brillan bañadas por la luz del atardecer."
msgstr ""

#. en: <oneline><$emotion(1,14)><$voicel(1,7)>Howdy, <$cdef(27)><pname;0></color>. The night sky has a bit<br>of<slide><br>a<slide><br>mysterious<slide><br>charm<slide><br>to it...<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Lookin’ up at it, I can’t help but be reminded of days long<br>gone by.
msgctxt "2004:504"
msgid "<$emotion(1,14)><$voicel(1,7)>Hola, mozalbet<gen;-2(e,a)>. Escúchame una cosa: ¿no te parece<br>que el cielo nocturno es bien misterioso?<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Cuando alzo la vista y lo contemplo, me vienen a la<br>memoria un sinfín de recuerdos de mis años mozos."
msgstr ""

#. en: <$comeff(1,14)><$motion(1,805)><$voicel(1,3)>I tell ya what, this place sure is different now than when<br>humans were still around...<clear><br><$comeff(1,6)><$motion(1,827)><$voicel(1,5)>Where’d all my friends run off to? <$voicel(1,8)>I sure hope they’re all<br>happy ’n’ healthy, wherever they are.<clear><br><$emotion(1,60)><$voicel(1,10)>Ah well! I’m sure we’ll meet again someday!
msgctxt "2004:507"
msgid "<$comeff(1,14)><$motion(1,805)><$voicel(1,3)>La zona está muy cambiada en comparación con la época<br>en la que pululaban los humanos...<clear><br><$comeff(1,6)><$motion(1,827)><$voicel(1,5)>¿Qué será de mis amigos?... <$voicel(1,8)>Bueno, mientras tengan<br>buena salud...<clear><br><$emotion(1,60)><$voicel(1,10)>¡Ya nos reencontraremos algún día!"
msgstr ""

#. en: <$emotion(1,49)><$voicel(1,5)>I was a rambunctious li’l scamp in my younger days.<clear><br><$comeff(1,9)><$facial(1,1)><$motion(1,806)><$voicel(1,9)>I’d get new bruises and scratches every day from runnin’ all<br>over, but I was havin’ too much fun to pay ’em any mind!
msgctxt "2004:508"
msgid "<$emotion(1,49)><$voicel(1,5)>De chaval<gen;-3(ín,ina)>, yo era una buena pieza, no creas.<clear><br><$comeff(1,9)><$facial(1,1)><$motion(1,806)><$voicel(1,9)>Me pasaba todos los días correteando por ahí a lo loco<br>y reunía una señora colección de rasguños y cardenales.<slide><br>¡Pero como lo pasaba pipa, yo tan campante!"
msgstr "<$emotion(1,49)><$voicel(1,5)>De chiquit<gen;-3(ín,ina)>, yo era una buena pieza, no creas.<clear><br><$comeff(1,9)><$facial(1,1)><$motion(1,806)><$voicel(1,9)>Me pasaba todos los días correteando por ahí a lo loco<br>y reunía una señora colección de rasguños y moretones.<slide><br>¡Pero como la pasaba genial, yo tan campante!"

#. en: <$emotion(1,37)><$voicel(1,9)>You can do just about anything on yer own, can’t ya!<br><$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>It really is somethin’ else!<clear><br><$comeff(1,3)><$motion(1,803)><$facial(1,1)><$voicel(1,5)>But I can’t just rely on you for every li’l thing. Nope!<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,9)>I’ll keep honin’ my skills so I can be of use to you<br>as well!<clear><br><$emotion(1,37)><$voicel(1,7)>Might take me a minute, but...I’ll do it! <$pkcry;5(1,2)>!
msgctxt "2004:509"
msgid "<oneline><$emotion(1,37)><$voicel(1,9)>¡Si es que te vales tú sol<gen;-2(o,a)> para todo! <$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>¡No dejas de<br>sorprenderme, jovenzuel<gen;-2(o,a)>!<clear><br><$comeff(1,3)><$motion(1,803)><$facial(1,1)><$voicel(1,5)>Pero tampoco puedo estar todo el día como un<br>pasmarote esperando a que me ayudes.<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,9)>¡Voy a aplicarme a fondo para echarte una mano<br>en lo que pueda! <$emotion(1,37)><$voicel(1,7)>Aunque puede que tarde lo mío.<slide><br>Ya sabes, Chatot viejo no aprende a hablar.<slide><br>¡<$pkcry;5(1,2)>!"
msgstr "<oneline><$emotion(1,37)><$voicel(1,9)>¡Si es que te vales tú sol<gen;-2(o,a)> para todo! <$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>¡No dejas de<br>sorprenderme, jovenzuel<gen;-2(o,a)>!<clear><br><$comeff(1,3)><$motion(1,803)><$facial(1,1)><$voicel(1,5)>Pero tampoco puedo estar todo el día como un<br>poste esperando a que me ayudes.<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,9)>¡Voy a aplicarme a fondo para echarte una mano<br>en lo que pueda! <$emotion(1,37)><$voicel(1,7)>Aunque puede que tarde lo mío.<slide><br>Ya sabes, Chatot viejo no aprende a hablar.<slide><br>¡<$pkcry;5(1,2)>!"

#. en: <$emotion(1,14)><$voicel(1,6)>What’s that now? No more <$cdef(27)><$spwfull(12)>s </color>today? All righty.<clear><br><$emotion(1,8)><$voicel(1,9)>I’ll surely do ’em again sometime, though. Come back and<br>see me when I do, y’hear?
msgctxt "2004:516"
msgid "<$emotion(1,14)><$voicel(1,6)>Vale. Pues entonces se acabó esto de <$cdef(27)><$spwfull(12)><br></color>por hoy.<clear><br><$emotion(1,8)><$voicel(1,9)>Pero estaré de vuelta en menos que canta un Torchic.<br>Ya vendrás a verme cuando vuelva."
msgstr "<$emotion(1,14)><$voicel(1,6)>Bueno. Pues entonces se acabó esto de <$cdef(27)><$spwfull(12)><br></color>por hoy.<clear><br><$emotion(1,8)><$voicel(1,9)>Pero estaré de vuelta en menos que canta un Torchic.<br>Ya vendrás a verme cuando vuelva."

#. en: <oneline><$emotion(1,29)><$voicel(1,7)><$cdef(27)><pname;0></color>! How ’bout doin’ a <$cdef(27)><$spwfull(12)><br></color>with me?
msgctxt "2004:517"
msgid "<$emotion(1,29)><$voicel(1,7)>Oye, picaruel<gen;-2(o,a)>, ¿te apetece <$cdef(27)><$spwfull(12)></color> conmigo?"
msgstr "<$emotion(1,29)><$voicel(1,7)>Oye, picaruel<gen;-2(o,a)>, ¿quieres <$cdef(27)><$spwfull(12)></color> conmigo?"

#. en: <oneline><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>I hear <$cdef(27)><shoppk;0></color>’s got some fancy goods over<br>at<slide><br>the<slide><br><$cdef(27)><fqty(1)><$ifull(1325)></color>!
msgctxt "2004:518"
msgid "<oneline><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,9)><fcap><dart;0()><$cdef(27)><shoppk;0> </color>tiene hoy en la <$cdef(27)><fqty(1)><$ifull(1325)></color><br>un surtido<slide><br>bien curiosote."
msgstr ""

#. en: <$emotion(1,59)><$voicel(1,7)>On real sunny days, I can sometimes get a li’l hot even<br>underwater.<clear><br><$comeff(1,9)><$facial(1,4)><$voicel(1,5)>Fortunately, I can jus’ dive a bit deeper whenever I’m<br>feelin’ that way ’n’ cool right down!
msgctxt "2004:520"
msgid "<$emotion(1,59)><$voicel(1,7)>¡Hay que ver! Los días en los que el sol brilla con fuerza<br>hace bochorno incluso bajo el agua.<clear><br><$comeff(1,9)><$facial(1,4)><$voicel(1,5)>Al final no queda otra que sumergirse bien profundo<br>en busca de una fosa fresquita."
msgstr ""

#. en: <oneline><$emotion(1,14)><$voicel(1,9)>Howdy, <$cdef(27)><pname;0></color>! I hear you’ve been<br>workin’<slide><br>hard<slide><br>waterin’<slide><br>plants<slide><br>’n’<slide><br>what<slide><br>have<slide><br>you!<clear><br><$motion(1,806)><$voicel(1,8)>Why, that’s mighty upstandin’ work you’re doin’!<clear><br><$emotion(1,38)><$voicel(1,9)>Lemme know if ya ever need help from yers truly!
msgctxt "2004:521"
msgid "<$emotion(1,14)><$voicel(1,9)>Me ha dicho un pajarito que últimamente te has estado<br>afanando en esto de regar, <$cdef(27)><pname;0></color>.<clear><br><$motion(1,806)><$voicel(1,8)>Qué jovenzuel<gen;-2(o,a)> tan aplicad<gen;-2(o,a)> nos has salido...<clear><br><$emotion(1,38)><$voicel(1,9)>Pues si alguna vez necesitas que te eche una mano, ¡aquí<br>tendrás a servido<gen;-3(r,ra)> para lo que mandes!"
msgstr "<$emotion(1,14)><$voicel(1,9)>Me dijo un pajarito que últimamente te has estado<br>esmerando en esto de regar, <$cdef(27)><pname;0></color>.<clear><br><$motion(1,806)><$voicel(1,8)>Qué jovenzuel<gen;-2(o,a)> tan aplicad<gen;-2(o,a)> nos saliste...<clear><br><$emotion(1,38)><$voicel(1,9)>Pues si alguna vez necesitas que te eche una mano, ¡aquí<br>tendrás a servido<gen;-3(r,ra)> para lo que mandes!"

#. en: <oneline><$emotion(1,14)><$voicel(1,7)>Howdy, <$cdef(27)><pname;0></color>! Look at this here thing<br>I found!
msgctxt "2004:522"
msgid "<$emotion(1,14)><$voicel(1,7)>He encontrado esto por ahí tirado y he pensado: \"voy a<br>dárselo a <$cdef(27)><pname;0></color>, ea\"."
msgstr "<$emotion(1,14)><$voicel(1,7)>Encontré esto por ahí tirado y pensé: \"voy a<br>dárselo a <$cdef(27)><pname;0></color>\"."

#. en: <oneline><$emotion(1,29)><$voicel(1,5)>Howdy, <$cdef(27)><pname;0></color>! I’ll have you know that<br><$cdef(27)><nlpairpk;1></color><slide><br>is<slide><br>quite<slide><br>the<slide><br>talker!<slide><br><$emotion(1,38)><$voicel(1,10)>They’ve<slide><br>got<slide><br>all<slide><br>sortsa<slide><br>interestin’<slide><br>stories<slide><br>to tell!
msgctxt "2004:523"
msgid "<oneline><$emotion(1,29)><$voicel(1,5)><$cdef(27)><pname;0></color>, ¿sabes qué?<br><wait(0.4)><$emotion(1,38)><$voicel(1,10)><fcap><dart;1()><$cdef(27)><nlpairpk;1> </color>cuenta<slide><br>unas batallitas<slide><br>la mar de interesantes."
msgstr "<oneline><$emotion(1,29)><$voicel(1,5)><$cdef(27)><pname;0></color>, ¿sabes qué?<br><wait(0.4)><$emotion(1,38)><$voicel(1,10)><fcap><dart;1()><$cdef(27)><nlpairpk;1> </color>cuenta<slide><br>unas batallitas<slide><br>de lo más interesantes."

#. en: <oneline><$emotion(1,1)><$voicel(1,7)><qty;0(That,Those)> <$cdef(27)><fqty(1)><class><nlqueitem;0></color> ya<br>gave<slide><br>me<slide><br>sure<slide><br><qty;0(is,are)> appreciated!<clear><br><$comeff(1,9)><$facial(1,1)><$motion(1,806)><$voicel(1,9)>Jus’ perfect fer me, I tell ya what! I’ll be sure to take real<br>good care of <qty;0(it,’em)>!
msgctxt "2004:524"
msgid "<oneline><$emotion(1,1)><$voicel(1,7)>¡Muchas gracias por<br><dart;0()><$cdef(27)><fqty(1)><class><nlqueitem;0></color><slide><br>que me diste,<slide><br>mozuel<gen;-2(o,a)> de mis entretelas!<clear><br><$comeff(1,9)><$facial(1,1)><$motion(1,806)><$voicel(1,9)>Me vien<qty;0(e,en)> estupendamente. Y descuida, que l<genqty;0(o,a,os,as)> guardaré<br>como oro en paño."
msgstr "<oneline><$emotion(1,1)><$voicel(1,7)>¡Muchas gracias por<br><dart;0()><$cdef(27)><fqty(1)><class><nlqueitem;0></color><slide><br>que me diste,<slide><br>chicuel<gen;-2(o,a)> de mi corazón!<clear><br><$comeff(1,9)><$facial(1,1)><$motion(1,806)><$voicel(1,9)>Me vien<qty;0(e,en)> estupendamente. Y descuida, que l<genqty;0(o,a,os,as)> guardaré<br>como oro en paño."

#. en: <$comeff(1,9)><$motion(1,806)><$voicel(1,7)>I’ve got a humble li’l dream, <$cdef(27)><pname;0></color>...<clear><br><$comeff(1,21)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>To live in one o’ them fancy houses ya make!<$emotion(1,38)><$voicel(1,8)><br>...Gwahaha! Jus’ thinkin’ out loud, is all!
msgctxt "2004:525"
msgid "<$comeff(1,9)><$motion(1,806)><$voicel(1,7)>¿Puedo confesarte algo, mocit<gen;-2(o,a)>? Verás, yo... resulta que<br>tengo una especie de sueño...<clear><br><$comeff(1,21)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>¿Y cuál, dirás tú? Pues... ¡tener un hogar tan estupendo<br>como esos que construyes!<clear><br><$emotion(1,38)><$voicel(1,8)>¡Bua, ja, ja! Anda que no me gustaría... pero los sueños,<br>sueños son."
msgstr "<$comeff(1,9)><$motion(1,806)><$voicel(1,7)>¿Puedo confesarte algo, mocit<gen;-2(o,a)>? Verás, yo... resulta que<br>tengo una especie de sueño...<clear><br><$comeff(1,21)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>¿Y cuál, dirás tú? Pues... ¡tener un hogar tan estupendo<br>como esos que construyes!<clear><br><$emotion(1,38)><$voicel(1,8)>¡Bua, ja, ja! Cómo me gustaría... pero los sueños,<br>sueños son."

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>I’m always tryin’ to come up with plans fer the morrow<br>before I go to sleep...<clear><br><$emotion(1,37)><$voicel(1,7)>but I tend to nod off before I can come up with<br>anythin’ good!<clear><br><$emotion(1,8)><$voicel(1,9)>Guess I can’t complain, though. That extra sleep’s<br>probably why I always wake up feelin’ so refreshed!
msgctxt "2004:526"
msgid "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Antes de irme a la piltra, me pongo a pensar en lo que<br>voy a hacer el día siguiente...<clear><br><$emotion(1,37)><$voicel(1,7)>Y fíjate tú que antes de que se me ocurra algo, siempre<br>me quedo dormid<gen;-3(o,a)> como un tronco.<clear><br><$emotion(1,8)><$voicel(1,9)>Pero bueno, no hay queja. ¡Gracias a eso me levanto más<br>fresc<gen;-3(o,a)> que una rosa!"
msgstr "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Antes de irme a la cama, me pongo a pensar en lo que<br>voy a hacer el día siguiente...<clear><br><$emotion(1,37)><$voicel(1,7)>Y fíjate tú que antes de que se me ocurra algo, siempre<br>me quedo dormid<gen;-3(o,a)> como un tronco.<clear><br><$emotion(1,8)><$voicel(1,9)>Pero bueno, no hay queja. ¡Gracias a eso me levanto más<br>fresc<gen;-3(o,a)> que una rosa!"

#. en: <oneline><$comeff(1,16)><$motion(1,803)><$voicel(1,3)>*yaaawn*<br>I’m always plumb tuckered out ’round this time of day...<clear><br><$comeff(1,14)><$voicel(1,5)>I’d love to stay up a bit more and do stuff with ya,<br><$cdef(27)><pname;0></color>...<clear><br><$comcan(1)><$motion(1,806)><$voicel(1,4)>but I think it’s about time fer me to hit the hay!
msgctxt "2004:527"
msgid "<oneline><$comeff(1,16)><$motion(1,803)><$voicel(1,3)>Uaaah... A estas horas del día tengo un amodorramiento<br>encima de padre y muy señor mío.<clear><br><$comeff(1,14)><$voicel(1,5)>Créeme si te digo que me encantaría seguir despiert<gen;-3(o,a)> un<br>rato más para estar contigo, <$cdef(27)><pname;0></color>,<slide><br><$comcan(1)><$motion(1,806)><$voicel(1,4)>pero creo que<slide><br>es hora de irme a la piltra."
msgstr "<oneline><$comeff(1,16)><$motion(1,803)><$voicel(1,3)>Uaaah... A estas horas del día tengo un amodorramiento<br>tremendo.<clear><br><$comeff(1,14)><$voicel(1,5)>Créeme si te digo que me encantaría seguir despiert<gen;-3(o,a)> un<br>rato más para estar contigo, <$cdef(27)><pname;0></color>,<slide><br><$comcan(1)><$motion(1,806)><$voicel(1,4)>pero creo que<slide><br>es hora de irme a la cama."

#. en: <$motion(1,806)><$voicel(1,7)>I’m real good at hidin’ during hide-and-seek. I jus’ fly up<br>into the sky where nobody can find me! <$emotion(1,8)><$voicel(1,10)>Not many folks<slide><br>think to look up, y’see?<clear><br><$emotion(1,37)><$voicel(1,7)>But sometimes it takes so long fer me to get found that it<br>jus’ ain’t no fun, so I decided to stop usin’ that tactic!
msgctxt "2004:528"
msgid "<$motion(1,806)><$voicel(1,7)>No tengo rival cuando juego al escondite, porque alzo<br>el vuelo... ¡y a ver quién es <gen;-2(el guapo,la guapa)> que me encuentra!<clear><br><$emotion(1,8)><$voicel(1,10)>A los demás eso de mirar hacia arriba parece que<br>no les entra en la cabecita.<clear><br><$emotion(1,37)><$voicel(1,7)>Al final un<gen;-3(o,a)> se aburre de ganar de calle, así que ahora<br>procuro quedarme en tierra firme."
msgstr "<$motion(1,806)><$voicel(1,7)>No tengo rival cuando juego al escondite, porque alzo<br>el vuelo... ¡y a ver quién es <gen;-2(el guapo,la guapa)> que me encuentra!<clear><br><$emotion(1,8)><$voicel(1,10)>A los demás eso de mirar hacia arriba parece que<br>no les entra en la cabecita.<clear><br><$emotion(1,37)><$voicel(1,7)>Al final un<gen;-3(o,a)> se aburre de ganar tan fácil, así que ahora<br>procuro quedarme en tierra firme."

#. en: <$comeff(1,14)><$voicel(1,5)>I’ve found that if I wipe myself down with leaves or some<br>such after it rains, <$emotion(1,60)><$voicel(1,10)>my body gets all polished ’n’ shiny!<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,8)>It’s a refreshin’ experience—feels jus’ fantastic!
msgctxt "2004:529"
msgid "<$comeff(1,14)><$voicel(1,5)>Después de la lluvia, cuando me froto con unas hojas<br>para secarme... ¿sabes qué pasa?<clear><br><$emotion(1,60)><$voicel(1,10)>¡Que me queda el cuerpo más reluciente que una patena!<br><$comeff(1,9)><$motion(1,806)><$voicel(1,8)>¡Es tan reconfortante como gustoso!"
msgstr ""

#. en: <$emotion(1,14)><$voicel(1,5)>You got a squishy li’l body there, don’t ya. <$comeff(1,14)><$motion(1,666)><$voicel(1,4)>Ya don’t get<br>anythin’ stuck in yer feet as you’re walkin’ around?
msgctxt "2004:532"
msgid "<$emotion(1,14)><$voicel(1,5)>Tienes un cuerpo como muy blandurrio, ¿no, joven?<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,4)>Y digo yo: ¿no se te quedan pegados trozos de basurilla<br>en los pies al andar?"
msgstr "<$emotion(1,14)><$voicel(1,5)>Tienes un cuerpo como muy blandito, ¿no, joven?<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,4)>Y digo yo: ¿no se te quedan pegados pedazos de basurita<br>en los pies al andar?"

#. en: <oneline><$emotion(1,14)><$voicel(1,5)>I’m so little—why, I bet I could fit in yer bag,<br><$cdef(27)><pname;1></color>!<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,3)>But...what if I got stuck and couldn’t get out? I’d be in a<br>real pickle. Maybe I shouldn’t try my luck...
msgctxt "2004:533"
msgid "<$emotion(1,14)><$voicel(1,5)>Alguien tan chiquit<gen;-3(ín,ina)> como yo cabría perfectamente<br>en tu Bolsa, así a ojo de buen cubero.<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,3)>¡Pero ay de mí si luego no pudiese salir! Nada, nada...<br>Los experimentos, mejor con agua fresca."
msgstr "<$emotion(1,14)><$voicel(1,5)>Alguien tan chiquit<gen;-3(ín,ina)> como yo cabría perfectamente<br>en tu Bolsa, así a ojo de buen cubero.<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,3)>¡Pero ay de mí si luego no pudiera salir! Nada, nada...<br>Los experimentos, mejor con agua fresca."

#. en: <$emotion(1,38)><$voicel(1,9)>When you’re big like me, you can see over the tops o’<br>everybody’s heads! Mighty swell, don’tcha think?!<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,803)><$voicel(1,7)>It IS harder fer me to fit through tight spaces, though...<br>Mebbe bein’ li’l like you is better?<clear><br><$comeff(1,6)><$motion(1,666)><$voicel(1,6)>Hmmm...
msgctxt "2004:534"
msgid "<$emotion(1,38)><$voicel(1,9)>Si tienes un corpachón como el mío, ¡puedes ver por<br>encima del resto sin problema! Qué bárbaro, ¿no?<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,803)><$voicel(1,7)>Aunque siendo grandot<gen;-3(e,a)>, me cuesta más moverme por<br>sitios estrechos... Igual ser canij<gen;-2(o,a)> como tú es mejor...<slide><br><$comeff(1,6)><$motion(1,666)><$voicel(1,6)>Hmm..."
msgstr "<$emotion(1,38)><$voicel(1,9)>Si tienes un corpachón como el mío, ¡puedes ver por<br>encima del resto sin problema! Qué bárbaro, ¿no?<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,803)><$voicel(1,7)>Aunque siendo grandot<gen;-3(e,a)>, me cuesta más moverme por<br>lugares estrechos... Quizás ser chic<gen;-2(o,a)> como tú es mejor...<slide><br><$comeff(1,6)><$motion(1,666)><$voicel(1,6)>Hmm..."

#. en: <oneline><$emotion(1,14)><$voicel(1,7)>Now listen up, <$cdef(27)><pname;0></color>. It’s important to<br>be<slide><br>smart<slide><br>about<slide><br>where<slide><br>ya<slide><br>sleep.<slide><br>Think<slide><br>safety first!<clear><br><$comeff(1,14)><$voicel(1,5)>Why, one time I was outside snorin’ up a storm, when all<br>of a sudden <$emotion(1,37)><$voicel(1,10)>an honest-to-goodness rainstorm blew in<slide><br>right on top o’ me!<clear><br><$comeff(1,17)><$motion(1,807)><$voicel(1,8)>I tell ya, that gave me a right good scare!
msgctxt "2004:535"
msgid "<$emotion(1,14)><$voicel(1,7)>Elegir un sitio idóneo para dormir es muy importante.<br>Y, valga el pareado, ¡la seguridad va por delante!<clear><br><$comeff(1,14)><$voicel(1,5)>Te lo digo por lo que me sucedió una vez cuando estaba<br>durmiendo y roncando plácidamente a la intemperie...<slide><br><$emotion(1,37)><$voicel(1,10)>¡y en esto que empiezan a caer chuzos de punta!<clear><br><$comeff(1,17)><$motion(1,807)><$voicel(1,8)>Bueno, bueno, bueno... No te puedes ni imaginar qué<br>disgusto me dio el aguacero ese."
msgstr "<$emotion(1,14)><$voicel(1,7)>Elegir un lugar idóneo para dormir es muy importante.<br>Y, valga el pareado, ¡la seguridad va por delante!<clear><br><$comeff(1,14)><$voicel(1,5)>Te lo digo por lo que me sucedió una vez cuando estaba<br>durmiendo y roncando plácidamente a la intemperie...<slide><br><$emotion(1,37)><$voicel(1,10)>¡y de repente empieza a llover a cántaros!<clear><br><$comeff(1,17)><$motion(1,807)><$voicel(1,8)>Bueno, bueno, bueno... No te puedes ni imaginar qué<br>disgusto me dio el aguacero ese."

#. en: <$emotion(1,14)><$voicel(1,9)>I take pains to keep myself lookin’ nice!<clear><br><$emotion(1,8)><$voicel(1,7)>I check my reflection in the water daily, and if anythin’<br>looks off, I fix it right away!<clear><br><$comeff(1,10)><$facial(1,1)><$motionoff(1,804)><$voicel(1,9)>Also, I can practice my cool poses, y’see!
msgctxt "2004:536"
msgid "<$emotion(1,14)><$voicel(1,9)>Llámame vanidos<gen;-3(o,a)>, pero yo soy de l<gen;-3(o,a)>s que se cuidan<br>muy mucho de ir siempre bien acicalad<gen;-3(o,a)>s.<clear><br><$emotion(1,8)><$voicel(1,7)>No falta el día en el que mire mi reflejo en el agua para<br>comprobar que todo está en perfecto estado de revista.<clear><br><$comeff(1,10)><$facial(1,1)><$motionoff(1,804)><$voicel(1,9)>¡Y también derrocho estilo con mis poses! Si es que estoy<br>hech<gen;-3(o,a)> un figurín."
msgstr "<$emotion(1,14)><$voicel(1,9)>Llámame vanidos<gen;-3(o,a)>, pero yo soy de l<gen;-3(o,a)>s que se cuidan<br>muchísimo de ir siempre bien acicalad<gen;-3(o,a)>s.<clear><br><$emotion(1,8)><$voicel(1,7)>No falta el día en el que mire mi reflejo en el agua para<br>comprobar que todo está en perfecto estado de revista.<clear><br><$comeff(1,10)><$facial(1,1)><$motionoff(1,804)><$voicel(1,9)>¡Y también derrocho estilo con mis poses! Si es que estoy<br>hech<gen;-3(o,a)> un figurín."

#. en: <$motion(1,806)><$voicel(1,7)>The other day, I had a nice dream where I let loose the<br>greatest shock of all time—I mean, real great!<clear><br><$emotion(1,37)><$voicel(1,9)>But when I woke up, I realized I actually shocked everyone<br>around me!<clear><br><$emotion(1,41)><$voicel(1,3)>I feel kinda bad fer all the Pokémon I zapped without<br>meanin’ to...
msgctxt "2004:538"
msgid "<$motion(1,806)><$voicel(1,7)>El otro día tuve un sueño en el que me ponía a descargar<br>una de electricidad que ríete tú de Electabuzz.<clear><br><$emotion(1,37)><$voicel(1,9)>Y cuando me desperté... ¡pues había estado descargando<br>lo que no está escrito!<clear><br><$emotion(1,41)><$voicel(1,3)>Menuda faena para los pobres Pokémon que estaban a mi<br>alrededor, que se llevaron unos señores calambrazos."
msgstr "<$motion(1,806)><$voicel(1,7)>El otro día tuve un sueño en el que me ponía a descargar<br>tanta electricidad que ni Electabuzz me ganaba.<clear><br><$emotion(1,37)><$voicel(1,9)>Y cuando me desperté... ¡pues había estado descargando<br>lo que no está escrito!<clear><br><$emotion(1,41)><$voicel(1,3)>Qué mal rato para los pobres Pokémon que estaban a mi<br>alrededor, que se llevaron unos señores calambrazos."

#. en: <$emotion(1,8)><$voicel(1,9)>They say I’m scary, but NOTHIN’ scares ME! Nope!<clear><br><$comeff(1,14)><$facial(1,1)><$voicel(1,5)>Well, that’s not exactly true... Eatin’ somethin’ I’ve never<br>had before <$emotion(1,31)><$voicel(1,4)>does scare me a li’l bit...
msgctxt "2004:541"
msgid "<$emotion(1,8)><$voicel(1,9)>La gente me dice que doy miedo, ¡pero eso del miedo<br>es una palabra que no está en mi vocabulario!<clear><br><$comeff(1,14)><$facial(1,1)><$voicel(1,5)>Bueno, o eso me gustaría afirmar rotundamente, pero la<br>verdad es que cuando como algo que nunca he probado...<slide><br><$emotion(1,31)><$voicel(1,4)>un poco de congoja sí siento, no nos vamos a engañar."
msgstr ""

#. en: <$emotion(1,29)><$voicel(1,7)>What do ya suppose the difference is between plain ol’<br>walkin’ and “goin’ for a walk”?<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Maybe goin’ fer a walk means enjoyin’ the scenery and<br>such...or somethin’ along those lines?
msgctxt "2004:542"
msgid "<$emotion(1,29)><$voicel(1,7)>Oye, ¿qué diferencia crees tú que hay entre caminar<br>sin más y dar un paseo?<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Tal vez sea que cuando vas de paseo también disfrutas<br>del paisaje que te rodea, ¿no?"
msgstr ""

#. en: <$comeff(1,3)><$voicel(1,5)>Got a li’l random question fer ya—what’s yer favorite thing<br><$emotion(1,29)><$voicel(1,8)>you’ve picked up on yer adventures?<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Was it somethin’ small ’n’ cute? Or somethin’ big ’n’ cool?
msgctxt "2004:543"
msgid "<$comeff(1,3)><$voicel(1,5)>Te voy a hacer una pregunta así, por darte conversación.<br>De todo lo que has recogido hasta ahora...<slide><br><$emotion(1,29)><$voicel(1,8)>¿qué es lo que más te gusta?<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>¿Algo pequeñito y mono? ¿O algo bien grandote?"
msgstr "<$comeff(1,3)><$voicel(1,5)>Te voy a hacer una pregunta así, por darte conversación.<br>De todo lo que has recogido hasta ahora...<slide><br><$emotion(1,29)><$voicel(1,8)>¿qué es lo que más te gusta?<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>¿Algo pequeñito y lindo? ¿O algo bien grandote?"

#. en: <$comeff(1,14)><$voicel(1,5)>I’ve talked to my fair share of Pokémon—from the most<br>relaxed folks you could imagine to those who jus’ can’t<slide><br><$emotion(1,60)><$voicel(1,10)>seem to slow down. The big mix of personalities makes<slide><br>things super interestin’!<clear><br><$comeff(1,9)><$facial(1,1)><$motion(1,806)><$voicel(1,7)>Hope I can get to know more and more about you<br>too, <$cdef(27)><pname;0></color>! ♪
msgctxt "2004:544"
msgid "<$comeff(1,14)><$voicel(1,5)>He estado hablando con todo tipo de Pokémon por aquí,<br>desde el más tranquilo hasta el más vivaracho.<clear><br><$emotion(1,60)><$voicel(1,10)>¡La cuestión es que no hay dos iguales! ¡Tienen unas<br>personalidades tan dispares que resulta muy interesante!<clear><br><$comeff(1,9)><$facial(1,1)><$motion(1,806)><$voicel(1,7)>♪A ver si tú y yo nos vamos conociendo también mejor<br>con el tiempo, <$cdef(27)><pname;0></color>.♪"
msgstr ""

#. en: <$comeff(1,6)><$motion(1,666)><$voicel(1,5)>I’m feelin’ like I didn’t do a dang ol’ thing yesterday...<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,7)>Well, a li’l wasted time here and there can be a good<br>thing, I reckon!
msgctxt "2004:545"
msgid "<$comeff(1,6)><$motion(1,666)><$voicel(1,5)>Hmm, ¿hice ayer algo de provecho?...<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,7)>Bueeeno, de vez en cuando tampoco está mal pasarse<br>el día tumbad<gen;-3(o,a)> a la bartola, ¿verdad, mocit<gen;-2(o,a)>?"
msgstr "<$comeff(1,6)><$motion(1,666)><$voicel(1,5)>Hmm, ¿hice ayer algo de provecho?...<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,7)>Bueeeno, de vez en cuando tampoco está mal pasarse<br>el día tirad<gen;-3(o,a)> sin hacer nada, ¿verdad, mocit<gen;-2(o,a)>?"

#. en: <$emotion(1,60)><$voicel(1,7)>I love talkin’ to folks who smile and seem to enjoy what I’m<br>talkin’ about. <$emotion(1,8)><$voicel(1,10)>Like <$cdef(27)><nlpairpk;0></color>, fer instance!<clear><br><$comeff(1,6)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>Wait...you don’t s’pose that was a fake smile jus’ to flatter<br>me, do ya?
msgctxt "2004:546"
msgid "<oneline><$emotion(1,60)><$voicel(1,7)>Hablar con <dart;0()><$cdef(27)><nlpairpk;0></color> es divertido a más<br>no poder.<slide><br><$emotion(1,8)><$voicel(1,10)>¡Da gusto verl<gen;0(o,a)> escuchar sonriente mis batallitas!<clear><br><$comeff(1,6)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>Hm, ahora que lo pienso... ¿no lo estará haciendo solo<br>por no hacerme un feo?"
msgstr "<oneline><$emotion(1,60)><$voicel(1,7)>Hablar con <dart;0()><$cdef(27)><nlpairpk;0></color> es divertido a más<br>no poder.<slide><br><$emotion(1,8)><$voicel(1,10)>¡Da gusto verl<gen;0(o,a)> escuchar sonriente mis batallitas!<clear><br><$comeff(1,6)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>Hm, ahora que lo pienso... ¿no lo estará haciendo solo<br>por no hacerme un desaire?"

#. en: <oneline><$emotion(1,14)><$voicel(1,5)>You remember <qty;1(that,those)><br><$cdef(27)><fqty(1)><class><nlqueitem;1></color><slide><br>ya<slide><br>gave<slide><br>me?<clear><br><$emotion(1,38)><$voicel(1,9)>I tell ya what, that was one o’ the best things I ever had!
msgctxt "2004:547"
msgid "<oneline><$emotion(1,14)><$voicel(1,5)>¿Recuerdas<br><dart;1()><$cdef(27)><fqty(1)><nlqueitem;1><slide><br></color>que me diste?<clear><br><$emotion(1,38)><$voicel(1,9)>¡Pues estab<qty;1(a,an)> de rechupete! L<genqty;1(o,a,os,as)> engullí en un santiamén,<br>con eso te lo digo todo."
msgstr "<oneline><$emotion(1,14)><$voicel(1,5)>¿Recuerdas<br><dart;1()><$cdef(27)><fqty(1)><nlqueitem;1><slide><br></color>que me diste?<clear><br><$emotion(1,38)><$voicel(1,9)>¡Pues estab<qty;1(a,an)> para chuparse los dedos!<br>L<genqty;1(o,a,os,as)> engullí en un santiamén, con eso te lo digo todo."

#. en: <oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,7)>D’you remember that Pokémon named<br><$cdef(27)><crstlktar;0></color>?<clear><br><$emotion(1,29)><$voicel(1,5)>Where’d they live again? Sure would be nice ’n’ easy to<br>chat with ’em <$motion(1,807)><$voicel(1,4)>if their home was close to mine!
msgctxt "2004:548"
msgid "<oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,7)>Me ha venido a la mente <gen;0(el bueno,la buena)><br><esde;0()><$cdef(27)><crstlktar;0></color>,<slide><br><$emotion(1,29)><$voicel(1,5)>pero no recuerdo<slide><br>dónde vivía...<clear><br><$motion(1,807)><$voicel(1,4)>Si fuese mi vecin<gen;0(o,a)>... anda que no estaríamos ya<br>contándonos la vida."
msgstr "<oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,7)>Me vino a la mente <gen;0(el bueno,la buena)><br><esde;0()><$cdef(27)><crstlktar;0></color>,<slide><br><$emotion(1,29)><$voicel(1,5)>pero no recuerdo<slide><br>dónde vivía...<clear><br><$motion(1,807)><$voicel(1,4)>Si fuera mi vecin<gen;0(o,a)>... seguro que ya estaríamos<br>contándonos la vida."

#. en: <$emotion(1,29)><$voicel(1,5)>Are you acquainted with <$cdef(27)><crstlktar;1></color>?<clear><br><$emotion(1,38)><$voicel(1,9)>We live real far away from each other, so it’s kinda hard to<br>get together. Wish we could meet up fer a chat...<slide><br><$comeff(1,9)><$facial(1,1)><$motion(1,806)><$voicel(1,8)>That sure does sound nice, yep!
msgctxt "2004:549"
msgid "<oneline><$emotion(1,29)><$voicel(1,5)>Por cierto, <$cdef(27)><pname;0></color>, ¿tú conoces<br><esa;1()><$cdef(27)><crstlktar;1></color>?<clear><br><$emotion(1,38)><$voicel(1,9)>Vive tan lejos que no nos vemos nunca, pero quién sabe.<br>Si me <gen;1(lo,la)> encuentro algún día, igual me animo a entablar<slide><br>conversación.<$comeff(1,9)><$facial(1,1)><$motion(1,806)><$voicel(1,8)> ¡Sería estupendo!"
msgstr "<oneline><$emotion(1,29)><$voicel(1,5)>Por cierto, <$cdef(27)><pname;0></color>, ¿tú conoces<br><esa;1()><$cdef(27)><crstlktar;1></color>?<clear><br><$emotion(1,38)><$voicel(1,9)>Vive tan lejos que no nos vemos nunca, pero quién sabe.<br>Si me <gen;1(lo,la)> encuentro algún día, quizás me anime a entablar<slide><br>conversación.<$comeff(1,9)><$facial(1,1)><$motion(1,806)><$voicel(1,8)> ¡Sería estupendo!"

#. en: <$voicel(1,7)><$motion(1,824)><$comeff(1,1)><$facial(1,4)>Here’s a little somethin’ fer bein’ so generous with yer<br>time. <$voicel(1,10)><$motion(1,801)><$comeff(1,9)><$facial(1,5)>Please, I insist!
msgctxt "2004:550"
msgid "<$voicel(1,7)><$motion(1,824)><$comeff(1,1)><$facial(1,4)>De bien nacidos es ser agradecidos, así que aquí tienes<br>un obsequio por compartir tu tiempo conmigo.<clear><br><$voicel(1,10)><$motion(1,801)><$comeff(1,9)><$facial(1,5)>¡Acéptalo sin remilgos!"
msgstr ""

#. en: <$emotion(1,60)><$voicel(1,7)>I tell you what, everything about this here home is simply<br>the best!<clear><br><$emotion(1,8)><$voicel(1,10)>I’m lovin’ it, <$cdef(27)><pname;0></color>!
msgctxt "2004:551"
msgid "<$emotion(1,60)><$voicel(1,7)>¡Ayyy, si es que mi hogar no tiene ni un fallo,<br>es una gozada! <$emotion(1,8)><$voicel(1,10)>¡Qué maravilla, <$cdef(27)><pname;0></color>!"
msgstr "<$emotion(1,60)><$voicel(1,7)>¡Ayyy, si es que mi hogar no tiene ni un fallo,<br>es una delicia! <$emotion(1,8)><$voicel(1,10)>¡Qué maravilla, <$cdef(27)><pname;0></color>!"

#. en: <$emotion(1,38)><$voicel(1,9)>Here goes, then! Take yer best guess!<clear><br><$emotion(1,29)><$voicel(1,7)>What do ya think <$cdef(27)><qtargetpk;0></color>’s favorite flavor is?
msgctxt "2004:552"
msgid "<oneline><$emotion(1,38)><$voicel(1,9)>Pues venga, ¡a ver si aciertas esta pregunta!<clear><br><$emotion(1,29)><$voicel(1,7)>¿Cuál crees que es el sabor favorito<br><esde;0()><$cdef(27)><qtargetpk;0></color>?"
msgstr "<oneline><$emotion(1,38)><$voicel(1,9)>Pues vamos, ¡a ver si aciertas esta pregunta!<clear><br><$emotion(1,29)><$voicel(1,7)>¿Cuál crees que es el sabor favorito<br><esde;0()><$cdef(27)><qtargetpk;0></color>?"

#. en: That’s...<wait(0.4)><$comeff(1,20)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>correct! Nicely done, <$cdef(27)><pname;0></color>!
msgctxt "2004:554"
msgid "...<wait(0.4)><$comeff(1,20)><$facial(1,4)><$motion(1,801)><$voicel(1,9)> ¡Fabuloso! ¡Has acertado, <$cdef(27)><pname;0></color>!"
msgstr "...<wait(0.4)><$comeff(1,20)><$facial(1,4)><$motion(1,801)><$voicel(1,9)> ¡Fabuloso! ¡Acertaste, <$cdef(27)><pname;0></color>!"

#. en: That’s...<wait(0.4)><$emotion(1,38)><$voicel(1,10)>incorrect!<clear><br><$facial(1,1)><$motion(1,803)><$voicel(1,8)>The correct answer is <$cdef(27)><ltasteq;0></color>!<clear><br><$emotion(1,8)><$voicel(1,9)>Gwahaha! I hope you’ll try takin’ one o’ my quizzes<br>again sometime!
msgctxt "2004:555"
msgid "...<wait(0.4)><$emotion(1,38)><$voicel(1,10)> ¡Respuesta incorrecta!<clear><br><$facial(1,1)><$motion(1,803)><$voicel(1,8)>El <$cdef(27)><ltasteq;0> </color>es el que más le gusta.<br>¡Bua, ja, ja! <$emotion(1,8)><$voicel(1,9)>A ver si a la próxima te resarces."
msgstr ""

#. en: <oneline><$emotion(1,38)><$voicel(1,9)>Here goes, then! Take yer best guess!<clear><br><$emotion(1,29)><$voicel(1,7)>What do ya s’pose <$cdef(27)><qtargetpk;0></color>’s LEAST favorite<br>flavor is?
msgctxt "2004:557"
msgid "<$emotion(1,38)><$voicel(1,9)>¡Estupendo! Atent<gen;-2(o,a)> a esta pregunta pues.<clear><br><$emotion(1,29)><$voicel(1,7)>¿Cuál crees tú que es el sabor que menos le gusta<br><esa;0()><$cdef(27)><qtargetpk;0></color>?"
msgstr ""

#. en: That’s...<wait(0.4)><$comeff(1,20)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>correct! Nicely done, <$cdef(27)><pname;0></color>!
msgctxt "2004:559"
msgid "...<wait(0.4)><$comeff(1,20)><$facial(1,4)><$motion(1,801)><$voicel(1,9)> ¡Correcto! ¡Eres un hacha, <$cdef(27)><pname;0></color>!"
msgstr "...<wait(0.4)><$comeff(1,20)><$facial(1,4)><$motion(1,801)><$voicel(1,9)> ¡Correcto! ¡Eres un as, <$cdef(27)><pname;0></color>!"

#. en: That’s...<wait(0.4)><$emotion(1,38)><$voicel(1,10)>incorrect!<clear><br><$facial(1,1)><$motion(1,803)><$voicel(1,8)>The correct answer is <$cdef(27)><htasteq;0></color>!<clear><br><$emotion(1,8)><$voicel(1,9)>Gwahaha! I hope you’ll try takin’ one o’ my quizzes<br>again sometime!
msgctxt "2004:560"
msgid "<oneline>...<wait(0.4)><$emotion(1,38)><$voicel(1,10)> ¡Respuesta incorrecta!<clear><br><$facial(1,1)><$motion(1,803)><$voicel(1,8)><fcap><dart;0()><$cdef(27)><htasteq;0> </color><genqty;0(es el,es la,son los,son las)> que menos le gust<qty;0(a,an)>.<br><$emotion(1,8)><$voicel(1,9)>Pero no te aflijas,<slide><br>¡que verás que la próxima te la sabes!"
msgstr ""

#. en: <$emotion(1,38)><$voicel(1,9)>Here goes, then! Take yer best guess!<clear><br><$emotion(1,29)><$voicel(1,7)>What do ya s’pose <$cdef(27)><qtargetpk;0></color>’s favorite thing is?
msgctxt "2004:562"
msgid "<$emotion(1,38)><$voicel(1,9)>Pues a ver si aciertas esta pregunta...<clear><br><$emotion(1,29)><$voicel(1,7)>¿Qué es lo que más le gusta <esa;0()><$cdef(27)><qtargetpk;0></color>?"
msgstr ""

#. en: That’s...<wait(0.4)><$comeff(1,20)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>correct! Nicely done, <$cdef(27)><pname;0></color>!
msgctxt "2004:564"
msgid "...<wait(0.4)><$comeff(1,20)><$facial(1,4)><$motion(1,801)><$voicel(1,9)> ¡Albricias! ¡Una respuesta acertadísima!"
msgstr ""

#. en: That’s...<wait(0.4)><$emotion(1,38)><$voicel(1,10)>incorrect!<clear><br><$facial(1,1)><$motion(1,803)><$voicel(1,8)>The correct answer is <$cdef(27)><likemtag;0></color>!<clear><br><$emotion(1,8)><$voicel(1,9)>Gwahaha! I hope you’ll try takin’ one o’ my quizzes<br>again sometime!
msgctxt "2004:565"
msgid "...<wait(0.4)><$emotion(1,38)><$voicel(1,10)> ¡Aquí te has columpiado, mozalbet<gen;-2(e,a)>!<clear><br><$facial(1,1)><$motion(1,803)><$voicel(1,8)>La respuesta era <dart;0()><$cdef(27)><likemtag;0></color>.<clear><br><$emotion(1,8)><$voicel(1,9)>¡Bua, ja, ja! ¡De todo se aprende!"
msgstr "...<wait(0.4)><$emotion(1,38)><$voicel(1,10)> ¡Aquí te equivocaste, mozalbet<gen;-2(e,a)>!<clear><br><$facial(1,1)><$motion(1,803)><$voicel(1,8)>La respuesta era <dart;0()><$cdef(27)><likemtag;0></color>.<clear><br><$emotion(1,8)><$voicel(1,9)>¡Bua, ja, ja! ¡De todo se aprende!"

#. en: <$voicel(1,8)><$emotion(1,1)>Hope we can do it again sometime!
msgctxt "2004:566"
msgid "<$voicel(1,8)><$emotion(1,1)>¡Hasta la próxima, y a cuidarse!"
msgstr ""

#. en: <oneline><$emotion(1,29)><$voicel(1,7)>Say, <$cdef(27)><pname;0></color>... Seems you’ve got some<br><$cdef(27)><fqty(2)><class><refmateid;1></color><slide><br>on<slide><br>ya, yeah?<clear><br><$emotion(1,38)><$voicel(1,9)>If you lemme take a look at ’em, I bet I could turn ’em into<br><$cdef(27)><fqty(2)><class><reftarid;3> </color>for ya!
msgctxt "2004:569"
msgid "<oneline><$emotion(1,29)><$voicel(1,7)>Por cierto, ¿llevas encima<br><$cdef(27)><fqty(2)><class><refmateid;1><slide><br></color>por un casual de los casuales?<clear><br><$emotion(1,38)><$voicel(1,9)>¡Si quieres, yo con eso te hago<br><$cdef(27)><fqty(2)><class><reftarid;3></color>!"
msgstr "<oneline><$emotion(1,29)><$voicel(1,7)>Por cierto, ¿llevas encima<br><$cdef(27)><fqty(2)><class><refmateid;1><slide><br></color>por pura casualidad?<clear><br><$emotion(1,38)><$voicel(1,9)>¡Si quieres, yo con eso te hago<br><$cdef(27)><fqty(2)><class><reftarid;3></color>!"

#. en: <oneline><$emotion(1,37)><$voicel(1,7)>I gotta tell ya...I dunno the first thing about<br><$cdef(27)><fqty(2)><class><referrmate;0></color>!<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,6)>I reckon <$cdef(27)><referrpk;1> </color>might be a good one to ask!
msgctxt "2004:570"
msgid "<$emotion(1,37)><$voicel(1,7)>¡No tengo ni repajolera idea de qué hacer con<br><iart;0()><$cdef(27)><fqty(1)><class><referrmate;0></color>!<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,6)>¿Pero sabes quién sí es tod<gen;1(o,a)> <gen;1(un,una)> entendid<gen;1(o,a)> del tema?<br>¡<fcap><dart;1()><$cdef(27)><referrpk;1></color>!"
msgstr "<$emotion(1,37)><$voicel(1,7)>¡No tengo ni la menor idea de qué hacer con<br><iart;0()><$cdef(27)><fqty(1)><class><referrmate;0></color>!<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,6)>¿Pero sabes quién sí es tod<gen;1(o,a)> <gen;1(un,una)> entendid<gen;1(o,a)> del tema?<br>¡<fcap><dart;1()><$cdef(27)><referrpk;1></color>!"

#. en: <oneline><$emotion(1,37)><$voicel(1,7)>I gotta tell ya...I dunno the first thing about<br><$cdef(27)><fqty(2)><class><referrmate;0></color>!<clear><br><$emotion(1,31)><$voicel(1,4)>Not sure who would either...
msgctxt "2004:571"
msgid "<$emotion(1,37)><$voicel(1,7)>¡No tengo ni repajolera idea de qué hacer con<br><iart;0()><$cdef(27)><fqty(1)><class><referrmate;0></color>!<clear><br><$emotion(1,31)><$voicel(1,4)>Y llevo un rato dándole al coco, pero no sé quién<br>te podría ayudar, mozalbet<gen;-2(e,a)>..."
msgstr "<$emotion(1,37)><$voicel(1,7)>¡No tengo ni la menor idea de qué hacer con<br><iart;0()><$cdef(27)><fqty(1)><class><referrmate;0></color>!<clear><br><$emotion(1,31)><$voicel(1,4)>Y llevo un rato pensándolo, pero no sé quién<br>te podría ayudar, mozalbet<gen;-2(e,a)>..."

#. en: <oneline><$emotion(1,37)><$voicel(1,7)>I gotta tell ya...I dunno the first thing about<br><$cdef(27)><fqty(2)><class><referrmate;0></color>!<clear><br><$comeff(1,14)><$motion(1,827)><$voicel(1,5)>Tell ya what, though... I could turn any<br><$cdef(27)><fqty(2)><class><refmateid;2></color><slide><br>you’ve<slide><br>got<slide><br>into<slide><br><$voicel(1,8)><$cdef(27)><fqty(2)><class><reftarid;3></color><slide><br>if<slide><br>ya like!<clear><br><$comeff(1,6)><$motion(1,803)><$voicel(1,6)>How ’bout it?
msgctxt "2004:572"
msgid "<oneline><$emotion(1,37)><$voicel(1,7)>¡No tengo ni repajolera idea de qué hacer con<br>es<genqty;0(e,a,os,as)> <$cdef(27)><fqty(1)><class><referrmate;0></color>!<clear><br><$comeff(1,14)><$motion(1,827)><$voicel(1,5)>Pero veo que tienes<br>alg<genqty;2(ún,una,unos,unas)> <$cdef(27)><fqty(1)><class><refmateid;2></color>.<slide><br><$voicel(1,8)>Te puedo hacer<slide><br><$cdef(27)><fqty(2)><class><reftarid;3></color><slide><br>con <genqty;2(él,ella,ellos,ellas)>.<slide><br><$comeff(1,6)><$motion(1,803)><$voicel(1,6)>¿Qué me dices, moz<gen;-2(o,a)>?"
msgstr "<oneline><$emotion(1,37)><$voicel(1,7)>¡No tengo ni la menor idea de qué hacer con<br>es<genqty;0(e,a,os,as)> <$cdef(27)><fqty(1)><class><referrmate;0></color>!<clear><br><$comeff(1,14)><$motion(1,827)><$voicel(1,5)>Pero veo que tienes<br>alg<genqty;2(ún,una,unos,unas)> <$cdef(27)><fqty(1)><class><refmateid;2></color>.<slide><br><$voicel(1,8)>Te puedo hacer<slide><br><$cdef(27)><fqty(2)><class><reftarid;3></color><slide><br>con <genqty;2(él,ella,ellos,ellas)>.<slide><br><$comeff(1,6)><$motion(1,803)><$voicel(1,6)>¿Qué me dices, chic<gen;-2(o,a)>?"

#. en: <oneline><$comeff(1,6)><$motion(1,666)><$voicel(1,5)>Need some<br><$cdef(27)><fqty(2)><class><reftarid;0></color>,<slide><br>do ya?<clear><br><$comeff(1,10)><$motion(1,803)><$voicel(1,7)>Jus’ put some<br><$cdef(27)><fqty(2)><class><refmateid;2></color><slide><br>in<slide><br>the<slide><br><$cdef(27)><fqty(1)><reftable;1></color>, then!<clear><br><$emotion(1,8)><$voicel(1,10)>I’ll process ’em soon as I can!
msgctxt "2004:573"
msgid "<oneline><$comeff(1,6)><$motion(1,666)><$voicel(1,5)>¿Quieres<br><fqty(2)><$cdef(27)><class><reftarid;0></color>?<clear><br><$comeff(1,10)><$motion(1,803)><$voicel(1,7)>Pues deja<br><dart;2()><$cdef(27)><fqty(1)><class><refmateid;2></color><slide><br>en <dart;1()><$cdef(27)><fqty(1)><class><reftable;1></color>.<slide><br><$emotion(1,8)><$voicel(1,10)>¡Luego l<genqty;2(o,a,os,as)> proceso!"
msgstr ""

#. en: <oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Hm... Well, if I’m gonna make some<br><$cdef(27)><fqty(2)><class><reftarid;0></color>,<slide><br>I’m<slide><br>gonna<slide><br>need<slide><br><iart;1()><$cdef(27)><fqty(1)><reftable;1></color>!<clear><br><$emotion(1,29)><$voicel(1,8)>Would ya mind settin’ me up with<br><iart;2()><$cdef(27)><fqty(1)><reftable;2> </color>first?
msgctxt "2004:574"
msgid "<oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Para hacer<br><fqty(2)><$cdef(27)><class><reftarid;0></color><slide><br>hac<qty;1(e,en)> falta<slide><br><iart;1()><$cdef(27)><fqty(1)><class><reftable;1></color>.<slide><br><$emotion(1,29)><$voicel(1,8)>¿No tendrás a mano <genqty;1(uno,una,unos,unas)>?"
msgstr ""

#. en: <$emotion(1,8)><$voicel(1,9)>And I think I might be on a roll today, ’cause I made<br>somethin’ really amazin’ too! <$emotion(1,37)><$voicel(1,8)><$facial(1,4)>Hope ya like it!
msgctxt "2004:575"
msgid "<$emotion(1,8)><$voicel(1,9)>¡Bua, ja, ja! ¡Hoy es tu día de suerte! Me he esmerado<br>que no veas y me ha salido esto también.<clear><br><$emotion(1,37)><$voicel(1,8)><$facial(1,4)>¡Toma, mocet<gen;-2(e,a)>!"
msgstr "<$emotion(1,8)><$voicel(1,9)>¡Bua, ja, ja! ¡Hoy es tu día de suerte! Me esmeré<br>muchísimo y me salió esto también.<clear><br><$emotion(1,37)><$voicel(1,8)><$facial(1,4)>¡Toma, mozalbet<gen;-2(e,a)>!"

#. en: <$emotion(1,14)><$voicel(1,5)>Oh yeah! How’d ya like to take this off my hands? <$emotion(1,8)><$voicel(1,8)>Picked<br>it up on my way over here to see ya!
msgctxt "2004:576"
msgid "<$emotion(1,14)><$voicel(1,5)>Ah, esto es para ti. ¡Regalito al canto! <$emotion(1,8)><$voicel(1,8)>Lo recogí de<br>camino."
msgstr ""

#. en: <oneline><$emotion(1,14)><$voicel(1,8)>I’ve been waitin’ for ya, <$cdef(27)><pname;0></color>!<clear><br><$emotion(1,8)><$voicel(1,9)>The <$cdef(27)><cdirbname;1></color>’s finally<br>finished!<slide><br><$emotion(1,60)><$voicel(1,8)>Give<slide><br>it<slide><br>a<slide><br>good<slide><br>look<slide><br>if<slide><br>ya like!
msgctxt "2004:585"
msgid "<$emotion(1,14)><$voicel(1,8)>¡A ti te quería yo ver, <$cdef(27)><pname;0></color>!<clear><br><$emotion(1,8)><$voicel(1,9)>¿Sabes por qué? Pues porque ya est<qty;1(á,án)> list<genqty;1(o,a,os,as)> por fin<br><dart;1()><$cdef(27)><cdirbname;1></color>.<clear><br><$emotion(1,60)><$voicel(1,8)>¡Échal<qty;1(e,es)> un vistazo, venga!"
msgstr "<$emotion(1,14)><$voicel(1,8)>¡A ti te quería yo ver, <$cdef(27)><pname;0></color>!<clear><br><$emotion(1,8)><$voicel(1,9)>¿Sabes por qué? Pues porque ya est<qty;1(á,án)> list<genqty;1(o,a,os,as)> por fin<br><dart;1()><$cdef(27)><cdirbname;1></color>.<clear><br><$emotion(1,60)><$voicel(1,8)>¡Échal<qty;1(e,es)> un vistazo, vamos!"

#. en: <$emotion(1,37)><$voicel(1,9)>’Bout time for the grand reveal! Here we go!
msgctxt "2004:586"
msgid "<$emotion(1,37)><$voicel(1,9)>¡Ha llegado el momento de la gran inauguración!"
msgstr "<$emotion(1,37)><$voicel(1,9)>¡Llegó el momento de la gran inauguración!"

#. en: <$emotion(1,38)><$voicel(1,9)>Gwahaha! Not half bad, I reckon!<clear><br><$emotion(1,50)><$voicel(1,7)>Just lemme know next time you wanna <$cdef(27)><$spwfull(1)> </color>somethin’!<br>I’d be glad to give ya a hand!
msgctxt "2004:587"
msgid "<$emotion(1,38)><$voicel(1,9)>¡Bua, ja, ja! No está nada mal, ¿verdad?<clear><br><$emotion(1,50)><$voicel(1,7)>Pues ya sabes, cuando haya que <$cdef(27)><$spwfull(1)> </color>algo otra<br>vez, ¡aquí estará <gen;-3(un,una)> servido<gen;-3(r,ra)> para echarte una mano!"
msgstr ""

#. en: <$emotion(1,29)><$voicel(1,7)>I know this is kinda sudden, but do ya wanna play a li’l<br>game o’ “look that way” with me?
msgctxt "2004:593"
msgid "<$emotion(1,29)><$voicel(1,7)>Disculpa si te pilla de sopetón, mozalbet<gen;-2(e,a)>, pero... ¿te<br>animarías a jugar una partidilla de \"esquiva la baya\"?"
msgstr "<$emotion(1,29)><$voicel(1,7)>Disculpa si te agarra de sopetón, mozalbet<gen;-2(e,a)>, pero... ¿te<br>animarías a jugar una partidita de \"esquiva la baya\"?"

#. en: <$emotion(1,8)><$voicel(1,9)>Thank ya kindly! Let’s get to it, then!
msgctxt "2004:594"
msgid "<$emotion(1,8)><$voicel(1,9)>¡Se agradece! ¡Pues vamos que nos vamos!"
msgstr ""

#. en: <$comeff(1,3)><$motion(1,806)><$voicel(1,7)>Well, that’s all right. Let’s have us a game some other<br>time, then!
msgctxt "2004:595"
msgid "<$comeff(1,3)><$motion(1,806)><$voicel(1,7)>Oído cocina. Si te apetece en otra ocasión, servido<gen;-2(r,ra)><br>siempre estará dispuest<gen;-2(o,a)>."
msgstr "<$comeff(1,3)><$motion(1,806)><$voicel(1,7)>Entendido. Si te animas en otra ocasión, servido<gen;-2(r,ra)><br>siempre estará dispuest<gen;-2(o,a)>."

#. en: <oneline><$emotion(1,52)><$voicel(1,7)>Well, I’ll be darned! I lost?! Well played,<br><$cdef(27)><pname;0></color>!<clear><br><$emotion(1,38)><$voicel(1,9)>We gotta play again sometime! I’ll definitely beat ya!
msgctxt "2004:596"
msgid "<$emotion(1,52)><$voicel(1,7)>¡Mecachis en la mar! ¡He perdido! ¡Pero menuda maña te<br>das, <$cdef(27)><pname;0></color>!<clear><br><$emotion(1,38)><$voicel(1,9)>¡La próxima ganaré yo, por estas! Ya jugaremos de nuevo<br>cuando se tercie."
msgstr "<$emotion(1,52)><$voicel(1,7)>¡Rayos y centellas! ¡Perdí! ¡Pero qué maña te<br>das, <$cdef(27)><pname;0></color>!<clear><br><$emotion(1,38)><$voicel(1,9)>¡La próxima ganaré yo, te lo aseguro! Ya jugaremos<br>de nuevo cuando se pueda."

#. en: <$emotion(1,38)><$voicel(1,9)>Yep! A game well played by yers truly, if I do say so<br>myself!<clear><br><$comeff(1,9)><$facial(1,1)><$motion(1,806)><$voicel(1,7)>If you’re itchin’ to try ’n’ beat me, we can play again<br>anytime!
msgctxt "2004:597"
msgid "<$emotion(1,38)><$voicel(1,9)>¡Sí, señor! ¡Ha ganado <gen;-3(un servidor,una servidora)>!<clear><br><$comeff(1,9)><$facial(1,1)><$motion(1,806)><$voicel(1,7)>Si te apetece echarme la revancha, ¡puedes hacérmelo<br>saber cuando quieras y repetimos!"
msgstr "<$emotion(1,38)><$voicel(1,9)>¡Sí, señor! ¡Ganó <gen;-3(un servidor,una servidora)>!<clear><br><$comeff(1,9)><$facial(1,1)><$motion(1,806)><$voicel(1,7)>Si buscas la revancha, ¡puedes hacérmelo<br>saber cuando quieras y repetimos!"

#. en: <oneline><$emotion(1,29)><$voicel(1,5)>Wanna play a game, <$cdef(27)><pname;0></color>? I’m<br>lookin’<slide><br>fer<slide><br>Pokémon<slide><br>to<slide><br>play<slide><br>hide-and-sneak<slide><br>with me!<clear><br><$emotion(1,38)><$voicel(1,10)>You can go hide if ya like—I’ll be the one tryin’ to find ya!
msgctxt "2004:610"
msgid "<$emotion(1,29)><$voicel(1,5)>Oye, mozalbet<gen;-2(e,a)>, tú tienes ganas de jugar al escondite<br>camuflado, que lo sé yo, ¿verdad?<clear><br><$emotion(1,38)><$voicel(1,10)>¡Venga, vete a esconderte!"
msgstr "<$emotion(1,29)><$voicel(1,5)>Oye, mozalbet<gen;-2(e,a)>, tú tienes ganas de jugar al escondite<br>camuflado, que lo sé yo, ¿verdad?<clear><br><$emotion(1,38)><$voicel(1,10)>¡Vamos, ve a esconderte!"

#. en: <$emotion(1,60)><$voicel(1,9)>Heck yeah! Let’s do it, then! I won’t let ya beat me!
msgctxt "2004:611"
msgid "<$emotion(1,60)><$voicel(1,9)>¡Bua, ja, ja! ¡Verás lo que vale la experiencia, jovenzuel<gen;-2(o,a)>!"
msgstr ""

#. en: <$comeff(1,3)><$motion(1,806)><$voicel(1,7)>Well, that’s all right. Let’s have us a game some other<br>time, then!
msgctxt "2004:612"
msgid "<$comeff(1,3)><$motion(1,806)><$voicel(1,7)>Oído cocina. Si te apetece en otra ocasión, servido<gen;-2(r,ra)><br>siempre estará dispuest<gen;-2(o,a)>."
msgstr "<$comeff(1,3)><$motion(1,806)><$voicel(1,7)>Entendido. Si te animas en otra ocasión, servido<gen;-2(r,ra)><br>siempre estará dispuest<gen;-2(o,a)>."

#. en: <$comeff(1,14)><$facial(1,9)><$motion(1,666)><$voicel(1,4)>Hm... I guess ya done beat me!
msgctxt "2004:617"
msgid "<$comeff(1,14)><$facial(1,9)><$motion(1,666)><$voicel(1,4)>Recórcholis, he perdido..."
msgstr "<$comeff(1,14)><$facial(1,9)><$motion(1,666)><$voicel(1,4)>Recórcholis, perdí..."

#. en: <$comeff(1,4)><$motion(1,807)><$voicel(1,7)>W-well, y’know...I wasn’t really tryin’ this time!<clear><br><$emotion(1,8)><$voicel(1,9)>Still, I s’pose ya did beat me fair ’n’ square. Here ya go,<br><$cdef(27)><pname;1></color>! A prize fer winnin’!
msgctxt "2004:618"
msgid "<$comeff(1,4)><$motion(1,807)><$voicel(1,7)>¡Caray! Se ve que la experiencia no lo es todo.<clear><br><$emotion(1,8)><$voicel(1,9)>Pero una victoria es una victoria. ¡Aquí tienes tu premio!"
msgstr ""

#. en: <oneline><$emotion(1,38)><$voicel(1,9)><$pkcry;0(1,2)>! That sure was fun, tell ya what! Maybe<br>I’ll<slide><br>actually<slide><br>try<slide><br>next time!
msgctxt "2004:619"
msgid "<$emotion(1,38)><$voicel(1,9)>¡<$pkcry;0(1,2)>, me lo he pasado como <gen;-3(un niño chico,una niña chica)>!<br>¡La próxima vez no me pienso dejar ganar!"
msgstr "<$emotion(1,38)><$voicel(1,9)>¡<$pkcry;0(1,2)>, me la pasé como <gen;-3(un niño chico,una niña chica)>!<br>¡La próxima vez no me pienso dejar ganar!"

#. en: <$emotion(1,60)><$voicel(1,10)>Gwahaha! Did I surprise ya?<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,7)>Jus’ felt a li’l weird fer me to keep callin’ ya “<$cdef(27)>Ditto</color>.”<clear><br><$emotion(1,8)><$voicel(1,9)>So, I think I’ll address ya by yer nickname from now on!<br>Hope that’s all right!
msgctxt "2004:620"
msgid "<$emotion(1,60)><$voicel(1,10)>¡Bua, ja, ja! Te has llevado una sorpresa de agárrate y no<br>te menees, ¿eh?<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,7)>Es que esto de llamarte constantemente <$cdef(27)>Ditto </color>me estaba<br>empezando a dejar mal cuerpo.<clear><br><$emotion(1,8)><$voicel(1,9)>A partir de ahora usaré tu mote, si lo tienes a bien."
msgstr "<$emotion(1,60)><$voicel(1,10)>¡Bua, ja, ja! Te llevaste una sorpresa de las buenas,<br>¿eh?<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,7)>Es que esto de llamarte constantemente <$cdef(27)>Ditto </color>me estaba<br>empezando a incomodar.<clear><br><$emotion(1,8)><$voicel(1,9)>A partir de ahora usaré tu apodo, si lo tienes a bien."

#. en: <$emotion(1,38)><$voicel(1,9)>Gwahaha! Would goin’ easy on ya have been the more<br>mature thing to do?
msgctxt "2004:622"
msgid "<$emotion(1,38)><$voicel(1,9)>¡Bua, ja, ja! No te iba a dejar ganar, ¡que de las derrotas<br>también se aprende!"
msgstr ""

#. en: <$emotion(1,38)><$voicel(1,9)>That’s what I like to hear, I tell ya what! I’m gonna win this<br>here game!
msgctxt "2004:623"
msgid "<$emotion(1,38)><$voicel(1,9)>¡Así se habla, mocit<gen;-2(o,a)>! Pero que conste: ¡no voy a andarme<br>con chiquitas, pienso llevarme la victoria!"
msgstr ""

#. en: <$comeff(1,3)><$motion(1,806)><$voicel(1,7)>Well, that’s all right. Let’s have us a game some other<br>time, then!
msgctxt "2004:624"
msgid "<$comeff(1,3)><$motion(1,806)><$voicel(1,7)>Oído cocina. Si te apetece en otra ocasión, dame un<br>silbidito."
msgstr "<$comeff(1,3)><$motion(1,806)><$voicel(1,7)>Entendido. Si te animas en otra ocasión, dame un<br>silbidito."

#. en: <$comeff(1,5)><$motion(1,803)><$voicel(1,9)>Hm?! The <$cdef(27)><fqty(1)><$ifull(1325)></color>’s not workin’!<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,3)>I can’t make any <$cdef(27)><$spwfull(12)>s</color> like this. Hm... Don’t suppose<br>givin’ it a good thwack would fix it, do ya?
msgctxt "2004:667"
msgid "<$comeff(1,5)><$motion(1,803)><$voicel(1,9)>¡¿Eh?! No te lo pierdas... ¡Que la <$cdef(27)><fqty(1)><$ifull(1325)><br></color>ha dejado de funcionar! Toma del chasco, carrasco.<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,3)>Pues estamos aviados si queremos <$cdef(27)><$spwfull(12)></color> un poco.<br>¿Tú crees que se puede arreglar con un buen coscorrón?"
msgstr "<$comeff(1,5)><$motion(1,803)><$voicel(1,9)>¡¿Eh?! No te lo pierdas... ¡Que la <$cdef(27)><fqty(1)><$ifull(1325)><br></color>dejó de funcionar! ¡Vaya chasco!<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,3)>Pues estamos fritos si queremos <$cdef(27)><$spwfull(12)></color> un poco.<br>¿Tú crees que se puede arreglar con un buen coscorrón?"

#. en: <oneline><$emotion(1,8)><$voicel(1,9)>Here’s the<br><$cdef(27)><fqty(2)><class><reftarid;0></color><slide><br>I’ve<slide><br>finished<slide><br>so<slide><br>far!<slide><br><$emotion(1,37)><$voicel(1,8)>You’ll<slide><br>have<slide><br>to<slide><br>wait<slide><br>a<slide><br>bit<slide><br>for<slide><br>the rest!
msgctxt "2004:670"
msgid "<$emotion(1,8)><$voicel(1,9)>Todavía ando en plena tarea, moz<gen;-2(o,a)>, ¡pero ya est<qty;0(á,án)> list<genqty;0(o,a,os,as)><br><genqty;0(un,una,algunos,algunas)> <$cdef(27)><class><reftarid;0></color>!<clear><br><$emotion(1,37)><$voicel(1,8)>Para el resto tendrás que tener un poco más de paciencia."
msgstr "<$emotion(1,8)><$voicel(1,9)>Todavía ando en plena tarea, chic<gen;-2(o,a)>, ¡pero ya est<qty;0(á,án)> list<genqty;0(o,a,os,as)><br><genqty;0(un,una,algunos,algunas)> <$cdef(27)><class><reftarid;0></color>!<clear><br><$emotion(1,37)><$voicel(1,8)>Para el resto tendrás que tener un poco más de paciencia."

#. en: <oneline><$emotion(1,1)><$voicel(1,7)>Yeah, I know where <$cdef(27)><pksrchtar;0></color> is!<br>Should<slide><br>be<slide><br>over thataway!<clear><br><$emotion(1,29)><$voicel(1,6)>Want me to fly ya over to ’em?
msgctxt "2004:680"
msgid "<$cdef(27)><oneline></color><$emotion(1,1)><$voicel(1,7)>¡Ah, pues juraría que sé dónde está, fíjate tú!<br><$emotion(1,29)><$voicel(1,6)>Te puedo llevar allí en volandas, literalmente."
msgstr "<$cdef(27)><oneline></color><$emotion(1,1)><$voicel(1,7)>¡Ah, pues juraría que sé dónde está, fíjate tú!<br><$emotion(1,29)><$voicel(1,6)>Te puedo llevar allá en volandas, literalmente."

#. en: <oneline><$emotion(1,14)><$voicel(1,8)>Yeah, I believe <$cdef(27)><pksrchtar;0></color>’s at home<br>right now!<clear><br><$comeff(1,6)><$motion(1,666)><$voicel(1,6)>Want me to fly ya over to ’em?
msgctxt "2004:681"
msgid "<oneline><$cdef(27)><$emotion(1,14)></color><$voicel(1,8)>¡Ah! Pues debería estar en casa, si no me equivoco...<br><$motion(1,666)><$voicel(1,6)>Te llevo volando, ¡que no me cuesta nada! <$comeff(1,6)>¿Quieres?"
msgstr ""

#. en: <oneline><$comeff(1,14)><$motion(1,805)><$voicel(1,5)>Hmmm... Sorry, can’t say I’ve seen<br><$cdef(27)><pksrchtar;0></color> today!<clear><br><$emotion(1,29)><$voicel(1,7)>I can take ya to their home if ya like, though! Whaddya<br>say? Wanna fly over there?
msgctxt "2004:682"
msgid "<$comeff(1,14)><$motion(1,805)><$voicel(1,5)>Pues lo siento, jovencit<gen;-2(o,a)>, pero hoy no he visto<br><esa;0()><$cdef(27)><pksrchtar;0></color>.<clear><br>¡Eso sí, puedo llevarte hasta su casa! <$emotion(1,29)><$voicel(1,7)>¿Qué te parece?<br>¿Quieres surcar los cielos?"
msgstr ""

#. en: <oneline><$comeff(1,3)><$motion(1,805)><$voicel(1,7)>Can’t say I’ve seen <$cdef(27)><pksrchtar;0></color> round<br>these parts!<clear><br><$voicel(1,5)><$comeff(1,14)>Maybe they live far away from here?
msgctxt "2004:683"
msgid "<oneline><$comeff(1,3)><$motion(1,805)><$voicel(1,7)>¡Por aquí no hay ni rastro<br><esde;0()><$cdef(27)><pksrchtar;0></color>!<slide><br><$voicel(1,5)><$comeff(1,14)>Quizá viva muy lejos."
msgstr "<oneline><$comeff(1,3)><$motion(1,805)><$voicel(1,7)>¡Por aquí no hay ni rastro<br><esde;0()><$cdef(27)><pksrchtar;0></color>!<slide><br><$voicel(1,5)><$comeff(1,14)>Quizás viva muy lejos."

#. en: <$emotion(1,37)><$voicel(1,7)>All righty! Let’s get goin’, then!
msgctxt "2004:684"
msgid "<$emotion(1,37)><$voicel(1,7)>¡Muy bien! ¡Pues volando vamos!"
msgstr ""

#. en: <$emotion(1,8)><$voicel(1,9)>Phew! Here we are! I’d be happy to fly ya someplace again<br>anytime!
msgctxt "2004:685"
msgid "<$emotion(1,8)><$voicel(1,9)>¡Ale, hemos llegado! Si quieres volar de nuevo conmigo,<br>¡solo tienes que pedírmelo por esa boquita!"
msgstr "<$emotion(1,8)><$voicel(1,9)>¡Listo, llegamos! Si quieres volar de nuevo conmigo,<br>¡solo tienes que pedírmelo por esa boquita!"

#. en: <oneline><$comeff(1,14)><$facial(1,9)><$motion(1,805)><$voicel(1,3)>Hmmm... Looks like <$cdef(27)><pksrchtar;0></color>’s not<br>here<slide><br>right<slide><br>this minute...
msgctxt "2004:686"
msgid "<oneline><$comeff(1,14)><$facial(1,9)><$motion(1,805)><$voicel(1,3)><fcap><dart;0()><$cdef(27)><pksrchtar;0> </color>no está, pues vaya<br>faena..."
msgstr "<oneline><$comeff(1,14)><$facial(1,9)><$motion(1,805)><$voicel(1,3)><fcap><dart;0()><$cdef(27)><pksrchtar;0> </color>no está, pues qué<br>lástima..."

#. en: <$emotion(1,37)><$voicel(1,7)>All righty! I’m happy to help anytime ya need! Just lemme<br>know, OK?
msgctxt "2004:687"
msgid "<$emotion(1,37)><$voicel(1,7)>¡De acuerdo! Será un placer ayudarte en otra ocasión, si<br>se tercia, mi querid<gen;-2(o,a)> <$cdef(27)><pname;0></color>."
msgstr "<$emotion(1,37)><$voicel(1,7)>¡De acuerdo! Será un placer ayudarte en otra ocasión, si<br>hace falta, mi querid<gen;-2(o,a)> <$cdef(27)><pname;0></color>."

#. en: <oneline><$emotion(1,1)><$voicel(1,7)>Yeah, I know where <$cdef(27)><pksrchtar;0></color> is!<br>Should<slide><br>be<slide><br>over thataway!<clear><br><$emotion(1,29)><$voicel(1,5)>Want me to <$cdef(27)><$spwfull(35)> </color>ya over to ’em?
msgctxt "2004:688"
msgid "<$emotion(1,1)><$cdef(27)><$voicel(1,7)></color>¡Ajá! Has preguntado <gen;-3(al,a la)> Pokémon indicad<gen;-3(o,a)>, pues creo<br>saber dónde está.<clear><br><$emotion(1,29)><$voicel(1,5)>¿Nos <$cdef(27)>teletransportamos<nbs2><$spwicon(35)></color> para ir a su vera?"
msgstr "<$emotion(1,1)><$cdef(27)><$voicel(1,7)></color>¡Ajá! Le preguntaste <gen;-3(al,a la)> Pokémon indicad<gen;-3(o,a)>, pues creo<br>saber dónde está.<clear><br><$emotion(1,29)><$voicel(1,5)>¿Nos <$cdef(27)>teletransportamos<nbs2><$spwicon(35)></color> para ir a su vera?"

#. en: <oneline><$emotion(1,37)><$voicel(1,7)>Yeah, I believe <$cdef(27)><pksrchtar;0></color>’s at home<br>right now!<clear><br><$comeff(1,6)><$motion(1,666)><$voicel(1,6)>Want me to <$cdef(27)><$spwfull(35)></color><$cdef(27)> </color>ya over to ’em?
msgctxt "2004:689"
msgid "<$cdef(27)><$emotion(1,37)></color><$voicel(1,7)>¡Se supone que debería de estar en su casa!<clear><br><$comeff(1,6)><$motion(1,666)><$voicel(1,6)>¿Quieres que nos <$cdef(27)>teletransportemos<nbs2><$spwicon(35)> </color>allí para hacerle<br>una visitilla?"
msgstr "<$cdef(27)><$emotion(1,37)></color><$voicel(1,7)>¡Se supone que debería de estar en su casa!<clear><br><$comeff(1,6)><$motion(1,666)><$voicel(1,6)>¿Quieres que nos <$cdef(27)>teletransportemos<nbs2><$spwicon(35)> </color>allá para hacerle<br>una visitita?"

#. en: <oneline><$motion(1,807)><$voicel(1,3)><$facial(1,9)>Hmmm... Sorry, can’t say I’ve seen<br><$cdef(27)><pksrchtar;0></color> today!<clear><br><$emotion(1,29)><$voicel(1,7)><$facial(1,4)>I can take ya to their home if ya like, though! Whaddya<br>say? Wanna <$cdef(27)><$spwfull(35)> </color>over there?
msgctxt "2004:690"
msgid "<oneline><$motion(1,807)><$voicel(1,3)><$facial(1,9)>Lo siento, jovenzuel<gen;-2(o,a)>. Hoy, lo que es hoy, no he visto<br><esa;0()><$cdef(27)><pksrchtar;0></color>.<slide><br>¡Pero sí puedo llevarte hasta su casa!<clear><br><$emotion(1,29)><$voicel(1,7)><$facial(1,4)>¿Qué te parece? ¿Quieres que te <$cdef(27)>teletransporte<nbs2><$spwicon(35)></color> a su<br>casa a ver si suena la flauta?"
msgstr "<oneline><$motion(1,807)><$voicel(1,3)><$facial(1,9)>Lo siento, jovenzuel<gen;-2(o,a)>. Hoy, lo que es hoy, no he visto<br><esa;0()><$cdef(27)><pksrchtar;0></color>.<slide><br>¡Pero sí puedo llevarte hasta su casa!<clear><br><$emotion(1,29)><$voicel(1,7)><$facial(1,4)>¿Qué te parece? ¿Quieres que te <$cdef(27)>teletransporte<nbs2><$spwicon(35)></color> a su<br>casa a ver si hay suerte?"

#. en: <oneline><$comeff(1,14)><$motion(1,805)><$voicel(1,7)>Can’t say I’ve seen <$cdef(27)><pksrchtar;0></color> round<br>these parts!<clear><br><$voicel(1,6)><$emotion(1,48)>Maybe they live far away from here?
msgctxt "2004:691"
msgid "<oneline><oneline><$comeff(1,14)><$motion(1,805)><$voicel(1,7)>¡<fcap><dart;0()><$cdef(27)><pksrchtar;0> </color>no anda por esta zona,<br>eso desde luego!<slide><br><$voicel(1,6)><$emotion(1,48)>Debe de vivir en las quimbambas."
msgstr "<oneline><oneline><$comeff(1,14)><$motion(1,805)><$voicel(1,7)>¡<fcap><dart;0()><$cdef(27)><pksrchtar;0> </color>no anda por esta zona,<br>eso desde luego!<slide><br><$voicel(1,6)><$emotion(1,48)>Debe de vivir lejísimos."

#. en: <$emotion(1,37)><$voicel(1,7)>All righty! Let’s get goin’, then!
msgctxt "2004:692"
msgid "<$emotion(1,37)><$voicel(1,7)>¡Muy bien, pues vamos allá!"
msgstr "<$emotion(1,37)><$voicel(1,7)>¡Muy bien, pues adelante!"

#. en: <$emotion(1,8)><$voicel(1,9)>Here we are! I’d be happy to<$cdef(27)> <$spwfull(35)> </color>ya someplace<br>again anytime!
msgctxt "2004:693"
msgid "<$emotion(1,8)><$voicel(1,9)>¡Hemos llegado! ¡Será un placer <$cdef(27)>teletransportarte<nbs2><$spwicon(35)></color> de<br>nuevo siempre que lo necesites!"
msgstr "<$emotion(1,8)><$voicel(1,9)>¡Llegamos! ¡Será un placer <$cdef(27)>teletransportarte<nbs2><$spwicon(35)></color> de<br>nuevo siempre que lo necesites!"

#. en: <oneline><$comeff(1,14)><$facial(1,9)><$motion(1,805)><$voicel(1,3)>Hmmm... Looks like <$cdef(27)><pksrchtar;0></color>’s not<br>here<slide><br>right<slide><br>this minute...
msgctxt "2004:694"
msgid "<oneline><$comeff(1,14)><$facial(1,9)><$motion(1,805)><$voicel(1,3)><fcap><dart;0()><$cdef(27)><pksrchtar;0></color> no está. Pues vaya<br>chasco, carrasco..."
msgstr "<oneline><$comeff(1,14)><$facial(1,9)><$motion(1,805)><$voicel(1,3)><fcap><dart;0()><$cdef(27)><pksrchtar;0></color> no está. Pues qué<br>chasco..."

#. en: <$emotion(1,37)><$voicel(1,7)>All righty! I’m happy to help anytime ya need! Just lemme<br>know, OK?
msgctxt "2004:695"
msgid "<$emotion(1,37)><$voicel(1,7)>¡De acuerdo! Será un placer ayudarte en otra ocasión, si<br>se tercia, <$cdef(27)><pname;0></color>."
msgstr "<$emotion(1,37)><$voicel(1,7)>¡De acuerdo! Será un placer ayudarte en otra ocasión, si<br>hace falta, <$cdef(27)><pname;0></color>."

#. en: <$emotion(1,37)><$voicel(1,7)><$cdef(27)><pksrchtar;0></color>’s probably over thataway!
msgctxt "2004:696"
msgid "<$emotion(1,37)><$voicel(1,7)>¡Ah, <dart;0()><$cdef(27)><pksrchtar;0> </color>estará por allí!"
msgstr "<$emotion(1,37)><$voicel(1,7)>¡Ah, <dart;0()><$cdef(27)><pksrchtar;0> </color>estará por allá!"

#. en: <oneline><$emotion(1,37)><$voicel(1,7)><$cdef(27)><pksrchtar;0></color>’s likely at home right now,<br>I reckon!
msgctxt "2004:697"
msgid "<$cdef(27)><$emotion(1,37)></color><$voicel(1,7)>¡Digo yo que estará en su hogar!"
msgstr ""

#. en: <oneline><$comeff(1,14)><$facial(1,9)><$motion(1,666)><$voicel(1,3)>Hmmm... I’m afraid I haven’t seen<br><$cdef(27)><pksrchtar;0></color> today...
msgctxt "2004:698"
msgid "<$comeff(1,14)><$facial(1,9)><$motion(1,666)><$voicel(1,3)>Hmm, pues hoy no nos hemos cruzado, a saber."
msgstr "<$comeff(1,14)><$facial(1,9)><$motion(1,666)><$voicel(1,3)>Hmm, pues hoy no nos hemos cruzado, quién sabe."

#. en: <oneline><$comeff(1,3)><$motion(1,805)><$voicel(1,7)>Can’t say I’ve seen <$cdef(27)><pksrchtar;0></color> around<br>these parts!<clear><br><$voicel(1,6)><$comeff(1,14)>Maybe they live far away from here?
msgctxt "2004:699"
msgid "<$comeff(1,3)><$motion(1,805)><$voicel(1,7)>¡Por esta zona no anda, eso desde luego! <$voicel(1,6)><$comeff(1,14)>Debe de vivir<br>en las quimbambas."
msgstr "<$comeff(1,3)><$motion(1,805)><$voicel(1,7)>¡Por esta zona no anda, eso desde luego! <$voicel(1,6)><$comeff(1,14)>Debe de vivir<br>muy, muy lejos."

#. en: <oneline><$emotion(1,29)><$voicel(1,5)>Hm? What’s up, <$cdef(27)><pname;0></color>? Ya lookin’ fer<br>somebody<slide><br>in particular?
msgctxt "2004:700"
msgid "<oneline><$emotion(1,29)><$voicel(1,5)>¿Qué, <$cdef(27)><pname;0></color>? ¿Cómo te trata<br>la vida?<slide><br>¿Andas buscando<slide><br>a alguien?"
msgstr ""

#. en: <$emotion(1,14)><$voicel(1,7)>Oh! Well, all righty, then! Sorry fer jumpin’ to conclusions!
msgctxt "2004:701"
msgid "<$emotion(1,14)><$voicel(1,7)>¡Ah, vale! Perdona, me ha fallado la intuición. Serán cosas<br>de la edad..."
msgstr "<$emotion(1,14)><$voicel(1,7)>¡Ah, bueno! Perdona, me falló la intuición. Serán cosas<br>de la edad..."

#. en: <oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Hmmm... Y’know, I ain’t rightly sure where<br><$cdef(27)><pksrchtar;0></color><slide><br>is<slide><br>right now.
msgctxt "2004:702"
msgid "<$cdef(27)><$comeff(1,14)></color><$motion(1,666)><$voicel(1,5)>Hmm, pues no sé. ¿Por dónde andará?"
msgstr ""

#. en: <$comeff(1,7)><$facial(1,9)><$motion(1,666)><$voicel(1,1)>Ya wanna know how comfortable I am? Hm... Right now,<br>I’d say I’m feelin’ <$cdef(27)><flow><$stflevel;0(1)></color>.
msgctxt "2004:750"
msgid "<oneline><$comeff(1,7)><$facial(1,9)><$motion(1,666)><$voicel(1,1)>Pues mira, mozuel<gen;-2(o,a)>, te lo digo: <wait(1.0)>ahora mismo es<br><$cdef(27)><$stflevel;0(1)></color>."
msgstr "<oneline><$comeff(1,7)><$facial(1,9)><$motion(1,666)><$voicel(1,1)>Pues mira, chicuel<gen;-2(o,a)>, te lo digo: <wait(1.0)>ahora mismo es<br><$cdef(27)><$stflevel;0(1)></color>."

#. en: <$comeff(1,3)><$motion(1,666)><$voicel(1,3)>Ya wanna know how comfortable I am? Hm... Right now,<br>I’d say I’m feelin’ <$cdef(27)><flow><$stflevel;0(2)></color>.
msgctxt "2004:751"
msgid "<$comeff(1,3)><$motion(1,666)><$voicel(1,3)>De momento es <$cdef(27)><$stflevel;0(2)></color>, picaruel<gen;-2(o,a)>."
msgstr ""

#. en: <$comeff(1,9)><$motion(1,803)><$voicel(1,5)>Ya wanna know how comfortable I am? I’d say I’m feelin’<br>pretty <$cdef(27)><flow><$stflevel;0(3)> </color>right about now!
msgctxt "2004:752"
msgid "<$comeff(1,9)><$motion(1,803)><$voicel(1,5)>Ayyy, siempre tan considerad<gen;-2(o,a)>. Pues mira tú por dónde,<br>¡es <$cdef(27)><$stflevel;0(3)></color>!"
msgstr ""

#. en: <$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Ya wanna know how comfortable I am? Well...I’m feelin’<br>mighty <$cdef(27)><flow><$stflevel;0(4)></color> these days!
msgctxt "2004:753"
msgid "<$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>No te voy a engañar... <wait(1.0)>¡Es <$cdef(27)><$stflevel;0(4)></color>, moz<gen;-2(o,a)>!"
msgstr "<$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>No te voy a engañar... <wait(1.0)>¡Es <$cdef(27)><$stflevel;0(4)></color>, chic<gen;-2(o,a)>!"

#. en: <$comeff(1,8)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Ya wanna know how comfortable I am? Why, I’m feelin’<br>downright <$cdef(27)><flow><$stflevel;0(5)></color>! <$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>I never could’ve imagined<slide><br>livin’ in such luxury!
msgctxt "2004:754"
msgid "<oneline><$comeff(1,8)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Ay, ¡es <$cdef(27)><$stflevel;0(5)></color>! <$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>¡Quién me iba a decir a mí que<br>llegaría<slide><br>a vivir tan a gusto!"
msgstr ""

#. en: <$emotion(1,37)><$voicel(1,8)>Things’re comfier than before for sure!
msgctxt "2004:756"
msgid "<$emotion(1,37)><$voicel(1,8)>¡Ha mejorado y eso no hay quien lo niegue!"
msgstr "<$emotion(1,37)><$voicel(1,8)>¡Mejoró y eso no hay quien lo niegue!"

#. en: <$emotion(1,8)><$voicel(1,9)>Things’re a lot comfier now! Thanks for everything ya do<br>fer me, <$cdef(27)><pname;0></color>!
msgctxt "2004:757"
msgid "<oneline><$emotion(1,8)><$voicel(1,9)>¡Caray, si es que ha mejorado enteros! Muchas gracias,<br><$cdef(27)><pname;0></color>."
msgstr "<oneline><$emotion(1,8)><$voicel(1,9)>¡Caray, si es que mejoró muchísimo! Muchas gracias,<br><$cdef(27)><pname;0></color>."

#. en: <oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,3)>This here <$cdef(27)><fqty(1)><class><aireactp;0><br></color>is a<slide><br>li’l<slide><br>too<slide><br>small<slide><br>fer me...<clear><br><$comcan(1)><$motion(1,803)><$voicel(1,6)>Sure would like somethin’ a li’l bigger!
msgctxt "2004:758"
msgid "<oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,3)>Hmm... <genqty;0(Este,Esta,Estos,Estas)> <$cdef(27)><fqty(1)><aireactp;0> </color><qty;0(es,son)><br>un tanto pequeñ<genqty;0(o,a,os,as)><slide><br>para mi gusto.<clear><br><$comcan(1)><$motion(1,803)><$voicel(1,6)>Si tuvieses otra cosa que fuese un poco más de mi talla,<br>te estaría inmensamente agradecid<gen;-3(o,a)>."
msgstr "<oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,3)>Hmm... <genqty;0(Este,Esta,Estos,Estas)> <$cdef(27)><fqty(1)><aireactp;0> </color><qty;0(es,son)><br>un tanto pequeñ<genqty;0(o,a,os,as)><slide><br>para mi gusto.<clear><br><$comcan(1)><$motion(1,803)><$voicel(1,6)>Si tuvieras otra cosa que fuera un poco más de mi talla,<br>te estaría inmensamente agradecid<gen;-3(o,a)>."

#. en: <oneline><$emotion(1,50)><$voicel(1,9)>Thanks a bushel fer the<br><$cdef(27)><fqty(1)><class><aireactp;0></color>!
msgctxt "2004:761"
msgid "<oneline><$emotion(1,50)><$voicel(1,9)>¡Me has hecho un gran favor con<br><dart;0()><$cdef(27)><fqty(1)><aireactp;0></color>, moz<gen;-2(o,a)>!"
msgstr "<oneline><$emotion(1,50)><$voicel(1,9)>¡Me hiciste un gran favor con<br><dart;0()><$cdef(27)><fqty(1)><aireactp;0></color>, chic<gen;-2(o,a)>!"

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Hmmm... Can’t say fer sure how comfy I am when I ain’t<br>back home...<clear><br><$comeff(1,7)><$motion(1,802)><$voicel(1,4)>But I’d say I’m feelin’ <$cdef(27)><flow><$stflevel;0(1)></color>...
msgctxt "2004:762"
msgid "<oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Hmm... Te lo podría decir en un periquete si volviese a<br>mi hogar... <wait(1.0)><$comeff(1,7)><$motion(1,802)><$voicel(1,4)>Pero así, a bote pronto, diría que es<slide><br><$cdef(27)><$stflevel;0(1)></color>..."
msgstr "<oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Hmm... Te lo podría decir en un segundo si volviera a<br>mi hogar... <wait(1.0)><$comeff(1,7)><$motion(1,802)><$voicel(1,4)>Pero así, de entrada, diría que es<slide><br><$cdef(27)><$stflevel;0(1)></color>..."

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Hmmm... Can’t say fer sure how comfy I am when I ain’t<br>back home...<clear><br><$comeff(1,3)><$motion(1,803)><$voicel(1,6)>But I reckon I’m feelin’ <$cdef(27)><flow><$stflevel;0(2)></color>, maybe?
msgctxt "2004:763"
msgid "<oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Si estuviese en mi hogar, te respondía raud<gen;-3(o,a)>...<br><wait(1.0)><$comeff(1,3)><$motion(1,803)><$voicel(1,6)>A ojo de buen cubero, diría que es...<slide><br>¿<$cdef(27)><$stflevel;0(2)></color>?"
msgstr "<oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Si estuviera en mi hogar, te respondía raud<gen;-3(o,a)>...<br><wait(1.0)><$comeff(1,3)><$motion(1,803)><$voicel(1,6)>A ojo de buen cubero, diría que es...<slide><br>¿<$cdef(27)><$stflevel;0(2)></color>?"

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Hmmm... Can’t say fer sure how comfy I am when I ain’t<br>back home...<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,8)>But I might’ve felt <$cdef(27)><flow><$stflevel;0(3)></color>.
msgctxt "2004:764"
msgid "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Estando lejos de mi hogar, tengo que hacer memoria...<wait(1.0)><br><$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,8)>¡Diría que es <$cdef(27)><$stflevel;0(3)></color>!"
msgstr ""

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Hmmm... Can’t say fer sure how comfy I am when I ain’t<br>back home...<clear><br><$comeff(1,21)><$motion(1,801)><$voicel(1,10)>But I do believe I was feelin’ <$cdef(27)><flow><$stflevel;0(4)></color>!
msgctxt "2004:765"
msgid "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>¿Eso quieres saber, muchachit<gen;-2(o,a)>? Ay, y yo fuera de casa...<wait(1.0)><br><$comeff(1,21)><$motion(1,801)><$voicel(1,10)>Pues mira, ¡es <$cdef(27)><$stflevel;0(4)></color>!"
msgstr ""

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Hmmm... Can’t say fer sure how comfy I am when I ain’t<br>back home...<clear><br><$comeff(1,8)><$motion(1,801)><$voicel(1,9)>No, wait—I remember! I do believe I felt downright<br><$cdef(27)><flow><$stflevel;0(5)></color>! You’ve outdone yourself, my friend!
msgctxt "2004:766"
msgid "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Ay, mocit<gen;-2(o,a)>, y yo por ahí de paseo, a ver mi memoria...<br><wait(1.0)><$comeff(1,8)><$motion(1,801)><$voicel(1,9)>¡Mira, muy fácil! ¡Es indudablemente <$cdef(27)><$stflevel;0(5)></color>!"
msgstr ""

#. en: <$emotion(1,50)><$voicel(1,7)>I reckon things are better’n before!
msgctxt "2004:767"
msgid "<$emotion(1,50)><$voicel(1,7)>¡La cosa ha mejorado!"
msgstr "<$emotion(1,50)><$voicel(1,7)>¡La cosa mejoró!"

#. en: <$emotion(1,8)><$voicel(1,9)>I reckon things are a lot better’n before! Thank ya kindly<br>fer all your hard work, <$cdef(27)><pname;0></color>!
msgctxt "2004:768"
msgid "<$emotion(1,8)><$voicel(1,9)>¡La cosa ha mejorado con creces! ¡Muchas gracias por<br>la parte que te toca, <$cdef(27)><pname;0></color>!"
msgstr "<$emotion(1,8)><$voicel(1,9)>¡La cosa mejoró con creces! ¡Muchas gracias por<br>la parte que te toca, <$cdef(27)><pname;0></color>!"

#. en: <$emotion(1,37)><$voicel(1,9)>My home’s thisaway! Let’s go!
msgctxt "2004:769"
msgid "<$emotion(1,37)><$voicel(1,9)>¡Mi hogar está por aquí! ¡Arreando!"
msgstr "<$emotion(1,37)><$voicel(1,9)>¡Mi hogar está por aquí! ¡Andando!"

#. en: <$emotion(1,37)><$voicel(1,8)>My homes thataway!<clear><br><$emotion(1,41)><$voicel(1,3)>I’d love to take ya there, but my hands are tied at the<br>moment. Sorry, friend!
msgctxt "2004:770"
msgid "<$emotion(1,37)><$voicel(1,8)>¡Mi casa está allí!<clear><br><$emotion(1,41)><$voicel(1,3)>Me encantaría acompañarte, pero me pillas un poco<br>ajetread<gen;-3(o,a)>, disculpa."
msgstr "<$emotion(1,37)><$voicel(1,8)>¡Mi casa está allá!<clear><br><$emotion(1,41)><$voicel(1,3)>Me encantaría acompañarte, pero me agarras un poco<br>ajetread<gen;-3(o,a)>, disculpa."

#. en: <$emotion(1,14)><$voicel(1,7)>Oooh! Got me somethin’ nice, did ya? Thanks a bushel!
msgctxt "2004:771"
msgid "<$emotion(1,14)><$voicel(1,7)>¡Recórcholis, has tenido la iniciativa de dejarme eso en mi<br>hogar! ¡Que Arceus te lo pague!"
msgstr "<$emotion(1,14)><$voicel(1,7)>¡Recórcholis, tuviste la iniciativa de dejarme eso en mi<br>hogar! ¡Que Arceus te lo pague!"

#. en: <oneline><$emotion(1,60)><$voicel(1,9)>Oh! Got me<br><iart;0()><$cdef(27)><fqty(1)><class><stfrevp;0></color>,<slide><br>did<slide><br>ya?<slide><br>Thank<slide><br>ya kindly!
msgctxt "2004:772"
msgid "<oneline><$emotion(1,60)><$voicel(1,9)>¡Caray,<br><iart;0()><$cdef(27)><fqty(1)><class><stfrevp;0></color>!<slide><br>¡Me vien<qty;0(e,en)> estupendamente!"
msgstr ""

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>My comfort level? I ain’t sure yet, to tell you the truth...<br><$comeff(1,5)><$motion(1,806)><$voicel(1,10)>Jus’ moved in, after all!<clear><br><$comeff(1,3)><$motion(1,803)><$voicel(1,8)>Come back and ask me again later, if you’d be so kind!
msgctxt "2004:773"
msgid "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Pues ya somos dos preguntándonos lo mismo, porque ni<br>yo mism<gen;-3(o,a)> lo tengo claro clarinete.<clear><br><$comeff(1,5)><$motion(1,806)><$voicel(1,10)>¡Y no me extraña, porque estoy recién mudad<gen;-3(o,a)>!<clear><br><$comeff(1,3)><$motion(1,803)><$voicel(1,8)>¡Espero poder responderte como está mandado la próxima<br>vez que me preguntes!"
msgstr "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Pues ya somos dos preguntándonos lo mismo, porque ni<br>yo mism<gen;-3(o,a)> lo tengo muy claro.<clear><br><$comeff(1,5)><$motion(1,806)><$voicel(1,10)>¡Y no me extraña, porque estoy recién mudad<gen;-3(o,a)>!<clear><br><$comeff(1,3)><$motion(1,803)><$voicel(1,8)>¡Espero poder responderte como se debe la próxima<br>vez que me preguntes!"

#. en: <oneline><$emotion(1,14)><$voicel(1,5)>Hmmm... Hate to have to tell ya this, but things like that<br><$cdef(27)><fqty(1)><class><stfrevp;0></color> <$emotion(1,41)><$voicel(1,4)>don’t really<slide><br>strike<slide><br>my fancy.<clear><br><$comeff(1,6)><$facial(1,1)><$motion(1,666)><$voicel(1,6)>Think ya could swap it out fer somethin’ else?
msgctxt "2004:774"
msgid "<oneline><$emotion(1,14)><$voicel(1,5)>Hmm... Me vas a tener que perdonar, <$emotion(1,41)><$voicel(1,4)>pero no me v<qty;0(a,an)><br>mucho <dart;0()><fqty(2)><$cdef(27)><class><stfrevp;0></color>.<clear><br><$comeff(1,6)><$facial(1,1)><$motion(1,666)><$voicel(1,6)>¿No sería posible recibir otra cosa en su lugar?"
msgstr "<oneline><$emotion(1,14)><$voicel(1,5)>Hmm... Me vas a tener que perdonar, <$emotion(1,41)><$voicel(1,4)>pero no me<br>gust<qty;0(a,an)> mucho <dart;0()><fqty(2)><$cdef(27)><class><stfrevp;0></color>.<clear><br><$comeff(1,6)><$facial(1,1)><$motion(1,666)><$voicel(1,6)>¿No sería posible recibir otra cosa en su lugar?"

#. en: <oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,3)>That there <$cdef(27)><fqty(1)><class><stfrevp;0><br></color>is a<slide><br>li’l<slide><br>too<slide><br>small<slide><br>fer me...<clear><br><$comcan(1)><$motion(1,803)><$voicel(1,6)>Sure would like somethin’ a li’l bigger!
msgctxt "2004:775"
msgid "<oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,3)>Uf, qué quieres que te diga... Así a ojo, se me hac<qty;0(e,en)> algo<br>chiquit<genqty;0(ín,ina,ines,inas)><slide><br><iart;0()><fqty(1)><class><$cdef(27)><stfrevp;0></color>...<clear><br><$comcan(1)><$motion(1,803)><$voicel(1,6)>Si pudieses traerme algo más grande, te lo agradecería<br>en el alma."
msgstr "<oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,3)>Uf, qué quieres que te diga... Así a ojo, se me hac<qty;0(e,en)> algo<br>chiquit<genqty;0(ín,ina,ines,inas)><slide><br><iart;0()><fqty(1)><class><$cdef(27)><stfrevp;0></color>...<clear><br><$comcan(1)><$motion(1,803)><$voicel(1,6)>Si pudieras traerme algo más grande, te lo agradecería<br>en el alma."

#. en: <$comeff(1,14)><$voicel(1,5)>You’re always pickin’ up rocks, branches, and whatnot and<br>turnin’ ’em into other stuff, <$cdef(27)><pname;0></color>.<clear><br><$emotion(1,38)><$voicel(1,9)>You’re transformin’ the world around us right before<br>our eyes! <$comeff(1,21)><$facial(1,4)><$motion(1,803)><$voicel(1,8)>It’s really amazin’, I tell ya what.
msgctxt "2004:801"
msgid "<$comeff(1,14)><$voicel(1,5)>Tú te dedicas a recoger piedras y ramas para después<br>fabricar objetos varios, ¿no, <$cdef(27)><pname;0></color>?<clear><br><$emotion(1,38)><$voicel(1,9)>En cuanto algo pasa por tus manos... ¡zas! Luego se parece<br>a su forma original como un huevo a una baya zanama.<slide><br><$comeff(1,21)><$facial(1,4)><$motion(1,803)><$voicel(1,8)>Eres de lo que no hay, jovenzuel<gen;-2(o,a)>."
msgstr "<$comeff(1,14)><$voicel(1,5)>Tú te dedicas a recoger piedras y ramas para después<br>fabricar objetos varios, ¿no, <$cdef(27)><pname;0></color>?<clear><br><$emotion(1,38)><$voicel(1,9)>En cuanto algo pasa por tus manos... ¡zas! Luego se parece<br>a su forma original como el día a la noche.<slide><br><$comeff(1,21)><$facial(1,4)><$motion(1,803)><$voicel(1,8)>Eres de lo que no hay, jovenzuel<gen;-2(o,a)>."

#. en: <$emotion(1,14)><$voicel(1,7)>Well, howdy! I feel like I’m seein’ a lot of you around<br>here lately...<clear><br><$emotion(1,8)><$voicel(1,9)>It’s kinda nice! Anyway, I hope we both have a pleasant<br>day out here!
msgctxt "2004:802"
msgid "<$emotion(1,14)><$voicel(1,7)>Últimamente sueles prodigarte mucho por aquí, mocit<gen;-2(o,a)>.<clear><br><$emotion(1,8)><$voicel(1,9)>¡Pues mejor que mejor! ¡Espero que tú y yo tengamos un<br>día estupendo por delante!"
msgstr ""

#. en: <$emotion(1,60)><$voicel(1,7)>Ahem! I do declare that I am quite proud of that there<br><$cdef(27)><asnbname;0></color>!<clear><br><$emotion(1,8)><$voicel(1,9)>Why, you ask? ’Cause we all worked hard to build it—we<br>put our hearts ’n’ souls in it!
msgctxt "2004:803"
msgid "<$emotion(1,60)><$voicel(1,7)>Ejem, no es por nada, pero me enorgullece ver cómo <qty;0(ha,han)><br>quedado <dart;0()><$cdef(27)><asnbname;0></color>.<clear><br><$emotion(1,8)><$voicel(1,9)>Más que nada por la dedicación y el cariño que hemos<br>puesto entre todos para construirl<genqty;0(o,a,os,as)>."
msgstr ""

#. en: <$comeff(1,14)><$voicel(1,5)>See that new <$cdef(27)><rctbname;0></color>?<br>They built it so fast, it practically appeared overnight...<clear><br><$emotion(1,8)><$voicel(1,8)>But it’s mighty well built, I tell ya what!<clear><br><$emotion(1,60)><$voicel(1,9)>Almost makes me jealous... Next time there’s somethin’ to<br><$cdef(27)><$spwfull(1)></color>, I’ll be right there helpin’ out—count on it!
msgctxt "2004:804"
msgid "<oneline><$comeff(1,14)><$voicel(1,5)>Se distrae <gen;-3(uno,una)> y mira,<br><iart;0()><$cdef(27)><rctbname;0></color>...<slide><br><$emotion(1,8)><$voicel(1,8)>Eso sí: ¡est<qty;0(á,án)> hech<genqty;0(o,a,os,as)> como Arceus manda!<clear><br><$emotion(1,60)><$voicel(1,9)>¡Pues no pienso ser menos! Tendré que ponerme las pilas<br>con la siguiente <$cdef(27)>construcción</color><nbs2><$spwicon(1)> para estar a la altura."
msgstr ""

#. en: <oneline><$emotion(1,29)><$voicel(1,8)>Say, d’you know if <$cdef(27)><acqpname;0></color> is doin’<br>all right?<clear><br><$emotion(1,38)><$voicel(1,9)>As I recall, I had lots of fun last time I played with them.<br>Hope I can see their smilin’ face again sometime!
msgctxt "2004:805"
msgid "<$emotion(1,29)><$voicel(1,8)>Oye, una cosa: ¿qué tal anda <$cdef(27)><acqpname;0></color>?<clear><br><$emotion(1,38)><$voicel(1,9)>Lo pasé como <gen;-3(un,una)> enan<gen;-3(o,a)> la otra vez y me encantaría verl<gen;0(o,a)><br>de nuevo, que es muy pizpiret<gen;0(o,a)>."
msgstr "<$emotion(1,29)><$voicel(1,8)>Oye, una cosa: ¿qué tal anda <$cdef(27)><acqpname;0></color>?<clear><br><$emotion(1,38)><$voicel(1,9)>La pasé como <gen;-3(un,una)> niñ<gen;-3(o,a)> la otra vez y me encantaría verl<gen;0(o,a)><br>de nuevo, que es muy pizpiret<gen;0(o,a)>."

#. en: <oneline><$emotion(1,14)><$voicel(1,8)>Howdy, uh...<$cdef(27)><pname;0></color>! Oh wow!<clear><br><$emotion(1,38)><$voicel(1,9)>Changin’ things up, huh? ♪ Looks real good on ya!<clear><br><$comeff(1,14)><$facial(1,1)><$voicel(1,5)><$textsize(0)>I didn’t recognize <$cdef(27)><pname;1></color> at first. Hope they<br>didn’t notice...</textsize>
msgctxt "2004:806"
msgid "<$emotion(1,14)><$voicel(1,8)>¿Hm?... <wait(0.4)>¡Ah! ¡Dichosos los ojos, <$cdef(27)><pname;0></color>!<clear><br><$emotion(1,38)><$voicel(1,9)>Quién te ha visto y quién te ve, ¿no? Menudo cambio<br>de imagen. ¡Te queda fenomenal!<clear><br><$comeff(1,14)><$facial(1,1)><$voicel(1,5)><$cdef(9)>(Espero que no se haya dado cuenta de que no l<gen;-2(o,a)> he<br>reconocido al principio).</color>"
msgstr "<$emotion(1,14)><$voicel(1,8)>¿Hm?... <wait(0.4)>¡Ah! ¡Dichosos los ojos, <$cdef(27)><pname;0></color>!<clear><br><$emotion(1,38)><$voicel(1,9)>Quién te ha visto y quién te ve, ¿no? Qué cambio<br>de imagen. ¡Te queda fenomenal!<clear><br><$comeff(1,14)><$facial(1,1)><$voicel(1,5)><$cdef(9)>(Espero que no se haya dado cuenta de que no l<gen;-2(o,a)><br>reconocí al principio).</color>"

#. en: <$emotion(1,29)><$voicel(1,5)>Hm? Somethin’ about ya seems a li’l different than before,<br><$cdef(27)><pname;0></color>... <$comeff(1,14)><$motion(1,666)><$facial(1,9)><$voicel(1,8)>Hm...hmmm?!<clear><br><$comeff(1,20)><$motion(1,803)><$facial(1,1)><$voicel(1,9)>Aha! I know! You’re doin’ a different transformation right<br>now, ain’tcha?!<clear><br><$emotion(1,8)><$voicel(1,7)>Heh. I’m pretty good at noticin’ those sorts o’ things.
msgctxt "2004:807"
msgid "<oneline><$emotion(1,29)><$voicel(1,5)>Anda, <$cdef(27)><pname;0></color>, te noto algo distint<gen;-2(o,a)>.<br><$comeff(1,14)><$motion(1,666)><$facial(1,9)><$voicel(1,8)>Hmm...<clear><br><$comeff(1,20)><$motion(1,803)><$facial(1,1)><$voicel(1,9)>¡Ah! Te has puesto algo nuevo, ¿no? ¡Vaya que sí!<clear><br><$emotion(1,8)><$voicel(1,7)>Si es que yo tengo muy buen ojo para estas cosas,<br>mozalbet<gen;-2(e,a)>."
msgstr "<oneline><$emotion(1,29)><$voicel(1,5)>Mira, <$cdef(27)><pname;0></color>, te noto algo distint<gen;-2(o,a)>.<br><$comeff(1,14)><$motion(1,666)><$facial(1,9)><$voicel(1,8)>Hmm...<clear><br><$comeff(1,20)><$motion(1,803)><$facial(1,1)><$voicel(1,9)>¡Ah! Te pusiste algo nuevo, ¿no? ¡Vaya que sí!<clear><br><$emotion(1,8)><$voicel(1,7)>Si es que yo tengo muy buen ojo para estas cosas,<br>mozalbet<gen;-2(e,a)>."

#. en: <$comeff(1,9)><$motion(1,806)><$voicel(1,9)>I do declare, every day is boatloads o’ fun when I’m with<br>you, <$cdef(27)><pname;0></color>!<clear><br><$emotion(1,38)><$voicel(1,7)>What sortsa mischief are you gonna get into next?!<br>Ya really keep me on my toes—and I love it!
msgctxt "2004:808"
msgid "<oneline><$comeff(1,9)><$motion(1,806)><$voicel(1,9)>¡Siempre lo paso chachi piruli cuando estoy contigo,<br><$cdef(27)><pname;0></color>!<clear><br><$emotion(1,38)><$voicel(1,7)>¿Qué nos reservará el futuro? ¡Estoy ya impaciente por<br>descubrirlo!"
msgstr "<oneline><$comeff(1,9)><$motion(1,806)><$voicel(1,9)>¡Siempre la paso genial cuando estoy contigo,<br><$cdef(27)><pname;0></color>!<clear><br><$emotion(1,38)><$voicel(1,7)>¿Qué nos reservará el futuro? ¡Estoy ya impaciente por<br>descubrirlo!"

#. en: <$emotion(1,14)><$voicel(1,5)><$cdef(27)>Professor Tangrowth</color>’s got some real smarts, but they’re a<br>li’l clumsy, y’know?<clear><br><$comeff(1,14)><$voicel(1,7)>Why, I saw ’em tryin’ to get a berry off the top of a tree<br>once, <$comeff(1,17)><$facial(1,1)><$motion(1,807)><$voicel(1,4)>but their long arms got all tangled up with each<slide><br>other...AND the tree!
msgctxt "2004:809"
msgid "<$emotion(1,14)><$voicel(1,5)>El <$cdef(27)>Profesor Tangrowth </color>anda sobrado de materia gris,<br>pero el pobre es un poco torpón...<clear><br><$comeff(1,14)><$voicel(1,7)>El otro día lo vi intentando pescar una baya que estaba<br>en lo alto de un árbol...<clear><br><$comeff(1,17)><$facial(1,1)><$motion(1,807)><$voicel(1,4)>Con tan mala suerte de que el pobre se enmarañó con las<br>ramas de mala manera. Claro, con esos brazos tan largos..."
msgstr ""

#. en: <oneline><$emotion(1,29)><$voicel(1,7)>How do ya feel ’bout us livin’ together,<br><$cdef(27)><pname;0></color>?<slide><br>Hope<slide><br>it’s<slide><br>fun<slide><br>times<slide><br>all around!<clear><br><$emotion(1,38)><$voicel(1,9)>If there’s anythin’ I should work on to make livin’ with me<br>easier, you jus’ lemme know pronto!
msgctxt "2004:810"
msgid "<$emotion(1,29)><$voicel(1,7)>¿Cómo andamos, mocit<gen;-2(o,a)>? Qué chollo compartir hogar con<br>la alegría de la huerta, ¿no? ¡No habrá queja!<clear><br><$emotion(1,38)><$voicel(1,9)>Pero si la hay, o crees que debería corregir alguna que<br>otra cosilla, ¡dímelo sin tapujos!"
msgstr "<$emotion(1,29)><$voicel(1,7)>¿Cómo andamos, mocit<gen;-2(o,a)>? Qué suerte compartir hogar con<br>el alma de la fiesta, ¿no? ¡No habrá queja!<clear><br><$emotion(1,38)><$voicel(1,9)>Pero si la hay, o crees que debería corregir alguna que<br>otra cosita, ¡dímelo sin tapujos!"

#. en: <oneline><$emotion(1,37)><$voicel(1,7)>How do ya feel ’bout strength trainin’,<br><$cdef(27)><pname;0></color>?<slide><br>I’m a<slide><br>big<slide><br>fan myself!<clear><br><$emotion(1,8)><$voicel(1,9)>Well-trained muscles are helpful in a pinch, y’know!
msgctxt "2004:812"
msgid "<$emotion(1,37)><$voicel(1,7)>¡A ti también te vendría bien entrenar ese cuerpo serrano,<br><$cdef(27)><pname;0></color>! Total, no pierdes nada.<clear><br><$emotion(1,8)><$voicel(1,9)>Una musculatura como Arceus manda te saca las castañas<br>del fuego cuando estás en un brete. ¡Palabra de servido<gen;-3(r,ra)>!"
msgstr "<$emotion(1,37)><$voicel(1,7)>¡A ti también te vendría bien entrenar ese cuerpo tuyo,<br><$cdef(27)><pname;0></color>! Total, no pierdes nada.<clear><br><$emotion(1,8)><$voicel(1,9)>Una musculatura como Arceus manda te saca las castañas<br>del fuego cuando estás en un brete. ¡Palabra de servido<gen;-3(r,ra)>!"

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>There’re a lotta Pokémon who worry ’bout lookin’ a li’l<br>scary...<$emotion(1,37)><$voicel(1,8)>but I ain’t one of ’em!<clear><br><$emotion(1,8)><$voicel(1,9)>In fact, I kinda like it if I’m bein’ honest! Givin’ off a scary,<br>dangerous vibe? Why, that’s right up my alley!
msgctxt "2004:813"
msgid "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Por lo visto abundan los Pokémon a los que reconcome<br>esa guisa algo intimidante que la vida les ha dado...<clear><br><$emotion(1,37)><$voicel(1,8)>¡Paparruchas! ¡A mí me pasa justo al contrario!<clear><br><$emotion(1,8)><$voicel(1,9)>No es que no me importe, ¡es que más bien me gusta!<br>Donde esté mi lado malandrín, que se quite lo demás."
msgstr ""

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Folks tell me all the time that I’ve got this “air o’ dignity”<br>about me, but to tell ya the truth, I jus’ don’t see it...<clear><br><$emotion(1,29)><$voicel(1,3)>Maybe it’s a mix o’ me lookin’ the way I look and talkin’<br>the way I talk?
msgctxt "2004:814"
msgid "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Me suelen decir que tengo un aire imponente, pero si te<br>digo la verdad, no acabo de ver a qué se debe.<clear><br><$emotion(1,29)><$voicel(1,3)>¿Será por mi rostro y mi forma de hablar? ¡Vete tú a saber!"
msgstr "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Me suelen decir que tengo un aire imponente, pero si te<br>digo la verdad, no acabo de ver a qué se debe.<clear><br><$emotion(1,29)><$voicel(1,3)>¿Será por mi rostro y mi forma de hablar? ¡Quién sabe!"

#. en: <oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Y’know, <$cdef(27)><$tonepk;0(1)></color> reminds me o’<br>myself<slide><br>from<slide><br>way<slide><br>back<slide><br>in<slide><br>the day...<clear><br><$emotion(1,14)><$voicel(1,8)>Gwahaha! Bet that comes as a surprise, huh?<clear><br><$emotion(1,38)><$voicel(1,9)>I was actually real cute ’n’ quiet like that in my youth, I’m<br>tellin’ ya!
msgctxt "2004:818"
msgid "<oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Es ver <esa;0()><$cdef(27)><$tonepk;0(1)> </color>y retrotraerme<br>a mis años<slide><br>mozos.<clear><br><$emotion(1,14)><$voicel(1,8)>¡Ja, ja! Resulta difícil de imaginar, ¿no?<clear><br><$emotion(1,38)><$voicel(1,9)>Pues sí, hubo una época donde yo también era así de<br>modosit<gen;-3(o,a)>, fíjate tú."
msgstr ""

#. en: <oneline><$emotion(1,8)><$voicel(1,7)><$cdef(27)><$tonepk;0(10)> </color>is a bit shy at first, but once<br>ya<slide><br>get<slide><br>’em<slide><br>talkin’,<slide><br>they’re<slide><br>actually<slide><br>pretty<slide><br>interestin’!<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>If ya ask me, they’d have an easier time makin’ friends if<br>they jus’ opened up a li’l more...<clear><br><$emotion(1,37)><$voicel(1,10)>But nope! Nope! I can’t go forcin’ my own ways on others!
msgctxt "2004:827"
msgid "<oneline><$emotion(1,8)><$voicel(1,7)><fcap><dart;0()><$cdef(27)><$tonepk;0(10)> </color>será reservad<gen;0(o,a)> y todo lo<br>que quieras,<slide><br>pero, si le hablas, ¡es que te tronchas!<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>Tendría más amiguetes si se expresase así con la gente ya<br>de buenas a primeras...<clear><br><$emotion(1,37)><$voicel(1,10)>¡Qué se le va a hacer! Bueno, algo sí puedo hacer: estar<br>pendiente de <gen;0(él,ella)>."
msgstr "<oneline><$emotion(1,8)><$voicel(1,7)><fcap><dart;0()><$cdef(27)><$tonepk;0(10)> </color>será reservad<gen;0(o,a)> y todo lo<br>que quieras,<slide><br>pero, si le hablas, ¡te mueres de risa!<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>Tendría más amigos si se expresara así con la gente ya<br>de buenas a primeras...<clear><br><$emotion(1,37)><$voicel(1,10)>¡Qué se le va a hacer! Bueno, algo sí puedo hacer: estar<br>pendiente de <gen;0(él,ella)>."

#. en: <$emotion(1,14)><$voicel(1,5)>Folks’re always noticin’ I’ve arrived before I can even<br>say hello...<clear><br><$comeff(1,9)><$facial(1,4)><$voicel(1,7)>But when ya smell as good as I do, I s’pose they jus’ can’t<br>help noticin’! <wait(0.5)><$emotion(1,38)><$voicel(1,9)>Gwahaha!
msgctxt "2004:837"
msgid "<$emotion(1,14)><$voicel(1,5)>No hace falta que diga ni haga nada: en cuanto me<br>acerco, todo el mundo se percata de mi presencia.<clear><br><$comeff(1,9)><$facial(1,4)><$voicel(1,7)>¡Pero eso es lo que tiene oler así de bien! <wait(0.5)><$emotion(1,38)><$voicel(1,9)>¡Bua, ja, ja!"
msgstr ""

#. en: <$motionoff(1,804)><$comeff(1,10)><$facial(1,4)><$voicel(1,7)>When ya got a big ol’ mouth like me, you can eat a ton o’<br>berries in one sittin’! Ain’t that great?<clear><br><$emotion(1,59)><$voicel(1,3)>But sometimes I eat a few too many ’n’ feel like I’m ’bout<br>to choke... <wait(0.5)><$emotion(1,14)><$voicel(1,6)>Gotta remember to chew my food properly!
msgctxt "2004:838"
msgid "<$motionoff(1,804)><$comeff(1,10)><$facial(1,4)><$voicel(1,7)>¿Sabes lo mejor de tener unas mandíbulas bien grandes?<br>¡Que te puedes comer las bayas de tres en tres, bua, ja, ja!<clear><br><$emotion(1,59)><$voicel(1,3)>Aunque hay que ir con ojo, porque a veces con las ansias<br>me pongo a toser sin parar, y no veas qué mal rato paso...<clear><br><$emotion(1,14)><$voicel(1,6)>En fin, que te sirva de lección, muchachit<gen;-2(o,a)>: ¡no seas como<br>yo y mastica bien la comida!"
msgstr "<$motionoff(1,804)><$comeff(1,10)><$facial(1,4)><$voicel(1,7)>¿Sabes lo mejor de tener unas mandíbulas bien grandes?<br>¡Que te puedes comer las bayas de tres en tres, bua, ja, ja!<clear><br><$emotion(1,59)><$voicel(1,3)>Aunque hay que ir con ojo, porque a veces con las ansias<br>me pongo a toser sin parar, y no sabes qué mal rato paso...<clear><br><$emotion(1,14)><$voicel(1,6)>En fin, que te sirva de lección, muchachit<gen;-2(o,a)>: ¡no seas como<br>yo y mastica bien la comida!"

#. en: <$comeff(1,6)><$motion(1,666)><$voicel(1,5)>Ya think <$cdef(27)><gevcmainpk;0></color>’s<$cdef(27)> </color>plannin’ somethin’ fun? They seem<br>mighty excited lately—more than anyone, I’d say!<slide><br><$emotion(1,37)><$voicel(1,8)>Oooh! I really wanna know what they’re up to!
msgctxt "2004:851"
msgid "<oneline><$comeff(1,6)><$motion(1,666)><$voicel(1,5)><fcap><esa;0()><$cdef(27)><gevcmainpk;0> </color>no le falta motivación, ¿no?<br>En especial,<slide><br>últimamente...<clear><br><$emotion(1,37)><$voicel(1,8)>No te lo voy a negar, ¡me pica un poco la curiosidad<br>de por qué!"
msgstr ""

#. en: <$emotion(1,38)><$voicel(1,10)>...Gwahaha!<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,805)><$voicel(1,7)>How’d I do? I was tryin’ to sound like one of the other<br>Pokémon ’round here. <$emotion(1,29)><$voicel(1,10)>Can ya guess who it was?
msgctxt "2004:853"
msgid "...<clear><br><$emotion(1,38)><$voicel(1,10)>¡Bua, ja, ja!<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,805)><$voicel(1,7)>¿Qué te ha parecido, mozalbet<gen;-2(e,a)>? Estaba hablando como<br>si fuese otro Pokémon, pero <$emotion(1,29)><$voicel(1,10)>¿a quién imitaba?"
msgstr "...<clear><br><$emotion(1,38)><$voicel(1,10)>¡Bua, ja, ja!<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,805)><$voicel(1,7)>¿Qué te pareció, mozalbet<gen;-2(e,a)>? Estaba hablando como<br>si fuera otro Pokémon, pero <$emotion(1,29)><$voicel(1,10)>¿a quién imitaba?"

#. en: <$comeff(1,20)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>That’s correct! Glad ya could tell!
msgctxt "2004:854"
msgid "<$comeff(1,20)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Has dado en el blanco! ¡Qué alegría me das!"
msgstr "<$comeff(1,20)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Diste en el blanco! ¡Qué alegría me das!"

#. en: <oneline><$emotion(1,38)><$voicel(1,9)>Nope! I’m afraid the correct answer<br>was <$cdef(27)><apfquizpk;0(0)></color>!<clear><br><$comeff(1,6)><$facial(1,1)><$motion(1,666)><$voicel(1,6)>Maybe I made it a li’l too difficult?
msgctxt "2004:855"
msgid "<oneline><$emotion(1,38)><$voicel(1,9)>¡Has fallado! Ay, moz<gen;-2(o,a)>, pero si era<br><dart;0()><$cdef(27)><apfquizpk;0(0)></color>.<slide><br>Mecachis,<slide><br><$comeff(1,6)><$facial(1,1)><$motion(1,666)><$voicel(1,6)>¿te lo he puesto<slide><br>demasiado difícil?"
msgstr "<oneline><$emotion(1,38)><$voicel(1,9)>¡Fallaste! Ay, chic<gen;-2(o,a)>, pero si era<br><dart;0()><$cdef(27)><apfquizpk;0(0)></color>.<slide><br>Caramba,<slide><br><$comeff(1,6)><$facial(1,1)><$motion(1,666)><$voicel(1,6)>¿te lo puse<slide><br>demasiado difícil?"

#. en: <$cdef(27)><$voicel(1,3)><$motion(1,666)><$facial(1,2)><$comeff(1,6)></color>What’s that, now? Ya want me to hold on to that there<br><$cdef(27)><fqty(1)><$ifull(432)> </color>fer ya? <$emotion(1,60)><$voicel(1,6)>I reckon I can do that!
msgctxt "2004:859"
msgid "<$cdef(27)><$voicel(1,3)></color><$motion(1,666)><$facial(1,2)><$comeff(1,6)>¿Y eso, <gen;-2(mozo,moza)>? ¿Este <$cdef(27)><fqty(1)><$ifull(432)></color> es para mí?<br><wait(1.0)><$emotion(1,60)><$voicel(1,6)>Caray, muy amable por tu parte."
msgstr "<$cdef(27)><$voicel(1,3)></color><$motion(1,666)><$facial(1,2)><$comeff(1,6)>¿Y eso, <gen;-2(mozo,moza)>? ¿Este <$cdef(27)><fqty(1)><$ifull(432)></color> es para mí?<br><wait(1.0)><$emotion(1,60)><$voicel(1,6)>Caray, muy amable de tu parte."

#. en: <$emotion(1,27)><$voicel(1,9)>Well I declare! This here’s a special <$cdef(27)><fqty(1)><$ifull(432)></color>, is it?<clear><br><$voicel(1,5)><$facial(1,4)><$comeff(1,10)>In that case, I s’pose you might wanna hold on to it<br>instead, <$cdef(27)><pname;0></color>.
msgctxt "2004:860"
msgid "<$emotion(1,27)><$voicel(1,9)>¡Cáspita! Este <$cdef(27)><fqty(1)><$ifull(432)></color> debe de ser un<br>objeto un tanto especial.<$cdef(27)> </color><$voicel(1,5)><$facial(1,4)><$comeff(1,10)>Será mejor que lo atesores tú."
msgstr ""

#. en: <$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>Well I’ll be! Didn’t expect ya to jus’ pop out like<br>that, <$cdef(27)><pname;0></color>!<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,8)>Here ya go! A li’l <$cdef(27)><fqty(1)><$ifull(532)> </color>fer ya.
msgctxt "2004:862"
msgid "<$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>¡Cáscaras, vaya sobresalto! Estás <gen;-2(hecho todo un,hecha toda una)> <gen;-2(pillo,pilla)>,<br><$cdef(27)><pname;0></color>.<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,8)>Anda, toma esta <$cdef(27)><fqty(1)><$ifull(532)></color>."
msgstr "<$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>¡Caramba, qué sobresalto! Estás <gen;-2(hecho todo un,hecha toda una)> <gen;-2(pillo,pilla)>,<br><$cdef(27)><pname;0></color>.<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,8)>Mira, toma esta <$cdef(27)><fqty(1)><$ifull(532)></color>."

#. en: <$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>Well I’ll be! Didn’t expect ya to jus’ pop out like<br>that, <$cdef(27)><pname;0></color>!<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,8)>Here ya go! A li’l <$cdef(27)><fqty(1)><$ifull(532)> </color>fer ya.
msgctxt "2004:863"
msgid "<$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>¡Cáscaras, vaya sobresalto! Estás <gen;-2(hecho todo un,hecha toda una)> <gen;-2(pillo,pilla)>,<br><$cdef(27)><pname;0></color>.<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,8)>Anda, toma estas <$cdef(27)><fqty(2)><$ifull(532)></color>."
msgstr "<$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>¡Caramba, qué sobresalto! Estás <gen;-2(hecho todo un,hecha toda una)> <gen;-2(pillo,pilla)>,<br><$cdef(27)><pname;0></color>.<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,8)>Mira, toma estas <$cdef(27)><fqty(2)><$ifull(532)></color>."

#. en: <$emotion(1,8)><$voicel(1,10)>That sure does sound nice!<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>But I figure there are a whole buncha other Pokémon<br>who’d like to go too...<clear><br><$emotion(1,37)><$voicel(1,9)>Why don’t ya invite me again some other time? I reckon I<br>can wait until things have calmed down a bit!
msgctxt "2004:902"
msgid "<$emotion(1,8)><$voicel(1,10)>¡Caramba, me parece una idea estupenda!<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>Aunque creo que ya hay por ahí muchos otros Pokémon<br>que también están deseando ir...<clear><br><$emotion(1,37)><$voicel(1,9)>¿Qué te parece si dejamos la visita para más adelante?<br>¡Ya me invitarás cuando haya menos trajín!"
msgstr "<$emotion(1,8)><$voicel(1,10)>¡Caramba, me parece una idea estupenda!<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>Aunque creo que ya hay por ahí muchos otros Pokémon<br>que también tienen ganas de ir...<clear><br><$emotion(1,37)><$voicel(1,9)>¿Qué te parece si dejamos la visita para más adelante?<br>¡Ya me invitarás cuando haya menos trajín!"

#. en: <$emotion(1,14)><$voicel(1,5)>I reckon it’s ’bout time fer me to head on home. If you’d<br>like to invite me over again, <$emotion(1,8)><$voicel(1,8)>I’d be happy to come!
msgctxt "2004:903"
msgid "<$emotion(1,14)><$voicel(1,5)>Bueeeno, pues creo que ya va siendo hora de levantar<br>el campamento.<clear><br><$emotion(1,8)><$voicel(1,8)>Si me invitas de nuevo, volveré encantad<gen;-3(o,a)>."
msgstr ""

#. en: <$emotion(1,14)><$voicel(1,10)>Oh! That sounds like a real nice time!<clear><br><$emotion(1,8)><$voicel(1,7)>Don’t s’pose I can turn down such a generous invitation.<br>I’ll make my way on over in a bit!
msgctxt "2004:904"
msgid "<$emotion(1,14)><$voicel(1,10)>¡Recórcholis, eso es música para mis viejos oídos!<clear><br><$emotion(1,8)><$voicel(1,7)>Pues acepto de buen grado tu generosa oferta.<br>Nos vemos dentro de un rato."
msgstr ""

#. en: <oneline><$emotion(1,29)><$voicel(1,7)>Hmmm? You headin’ off someplace,<br><$cdef(27)><pname;0></color>?<slide><br>Mind<slide><br>if<slide><br>I<slide><br>tag<slide><br>along<slide><br>with ya?
msgctxt "2004:905"
msgid "<oneline><$emotion(1,29)><$voicel(1,7)>¡Hombre, <$cdef(27)><pname;0></color>! ¿Vas a alguna parte?<br>¿Te importaría si me uno a tu expedición?"
msgstr "<oneline><$emotion(1,29)><$voicel(1,7)>¡Vaya, <$cdef(27)><pname;0></color>! ¿Vas a alguna parte?<br>¿Te importaría si me uno a tu expedición?"

#. en: <$emotion(1,37)><$voicel(1,7)>Gotcha! Not a problem. Be safe out there, ya hear!
msgctxt "2004:906"
msgid "<$emotion(1,37)><$voicel(1,7)>¡Lo entiendo perfectamente! ¡Pues a cuidarse!"
msgstr ""

#. en: <$emotion(1,8)><$voicel(1,9)>Now that sure was a good time we just had, wasn’t it!<br>Thanks a bushel, <$cdef(27)><pname;0></color>!
msgctxt "2004:907"
msgid "<$emotion(1,8)><$voicel(1,9)>¡Anda que no lo he pasado pipa ni nada! ¡Muchas gracias<br>por la parte que te toca, <$cdef(27)><pname;0></color>!"
msgstr "<$emotion(1,8)><$voicel(1,9)>¡Pero qué bien la pasé! ¡Muchas gracias<br>por la parte que te toca, <$cdef(27)><pname;0></color>!"

#. en: <$emotion(1,14)><$voicel(1,9)>Howdy, <$cdef(27)><pname;0></color>! I made it!<clear><br><$voicel(1,3)><$comeff(1,6)><$motion(1,666)>Remember me? I’m <$cdef(27)><nowner;2></color>’s friend!<clear><br><$comeff(1,14)><$voicel(1,7)>Sure is a nice place ya got here! <$emotion(1,8)><$voicel(1,10)>Very relaxin’!
msgctxt "2004:921"
msgid "<oneline><$emotion(1,14)><$voicel(1,9)>¿Cómo andamos, <$cdef(27)><pname;0></color>?<br>¡Aquí me tienes!<clear><br><$voicel(1,3)><$motion(1,666)>Por si no te acuerdas de mí, te refresco la memoria:<br>soy amig<gen;-3(o,a)> <gen;2(del bueno,de la buena)> de <$cdef(27)><nowner;2></color>.<clear><br><$comeff(1,14)><$voicel(1,7)>Qué rinconcito tan tranquilo y agradable te has buscado,<br><$comeff(1,6)>¿eh, picaruel<gen;-2(o,a)>? <$emotion(1,8)><$voicel(1,10)>¡Está muy pero que muy bien!"
msgstr "<oneline><$emotion(1,14)><$voicel(1,9)>¿Cómo andamos, <$cdef(27)><pname;0></color>?<br>¡Aquí me tienes!<clear><br><$voicel(1,3)><$motion(1,666)>Por si no te acuerdas de mí, te refresco la memoria:<br>soy amig<gen;-3(o,a)> <gen;2(del bueno,de la buena)> de <$cdef(27)><nowner;2></color>.<clear><br><$comeff(1,14)><$voicel(1,7)>Qué rinconcito tan tranquilo y agradable te buscaste,<br><$comeff(1,6)>¿eh, picaruel<gen;-2(o,a)>? <$emotion(1,8)><$voicel(1,10)>¡Está muy, pero muy bien!"
