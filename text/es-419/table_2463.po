#. en: <$voicel(3,7)><$emotion(3,14)><$facial(3,4)>Hey, guess what! I thought up a way you could raise the<br>humidity!
msgctxt "2463:0"
msgid "<$voicel(3,7)><$emotion(3,14)><$facial(3,4)>¡Holiii! ¿Sabes qué? ¡Se me ha ocurrido una manera para<br>que haya más humedad!"
msgstr "<$voicel(3,7)><$emotion(3,14)><$facial(3,4)>¡Holiii! ¿Sabes qué? ¡Se me ocurrió una manera para<br>que haya más humedad!"

#. en: <$voicel(3,5)>When I was really little, I used to play in a big field<br>of flowers. <$voicel(3,10)><$emotion(3,8)>It always felt SOOO nice!
msgctxt "2463:1"
msgid "<$voicel(3,5)>Cuando era más pequeñit<gen;-3(o,a)>, muchas veces me iba a jugar<br>a un campo muy grande lleno de flores. <$voicel(3,10)><$emotion(3,8)>¡Era superguay!"
msgstr "<$voicel(3,5)>Cuando era más pequeñit<gen;-3(o,a)>, muchas veces me iba a jugar<br>a un campo muy grande lleno de flores. <$voicel(3,10)><$emotion(3,8)>¡Era superbonito!"

#. en: <$voicel(3,6)><$motion(3,805)><$comeff(3,14)>It looked kinda like this...
msgctxt "2463:2"
msgid "<$voicel(3,6)><$motion(3,805)><$comeff(3,14)>Era algo parecido a esto..."
msgstr ""

#. en: <$voicel(3,9)><$motion(3,801)><$facial(3,5)><$comeff(3,21)>I think if we had a really big flower field like that here, the<br>air would get more humid too!
msgctxt "2463:3"
msgid "<$voicel(3,9)><$motion(3,801)><$facial(3,5)><$comeff(3,21)>Seguro que si tuviéramos algún campo de flores tan<br>grande como ese habría más humedad. ¿A que sí?"
msgstr "<$voicel(3,9)><$motion(3,801)><$facial(3,5)><$comeff(3,21)>Seguro que si tuviéramos algún campo de flores tan<br>grande como ese habría más humedad. ¿Verdad?"

#. en: <$voicel(3,5)><$motion(3,807)>Flower seeds normally take a li’l while to grow after you<br>plant them...<clear><br><$voicel(3,7)><$motion(3,803)><$facial(3,4)><$comeff(3,9)>But if you bring me along, I can make ’em<br>grow INSTANTLY!
msgctxt "2463:4"
msgid "<$voicel(3,5)><$motion(3,807)>Lo malo es que las flores tardan mucho en crecer desde<br>que las plantas.<clear><br><$voicel(3,7)><$motion(3,803)><$facial(3,4)><$comeff(3,9)>¡Pero, si voy yo, puedo hacer que crezcan enseguida!"
msgstr ""

#. en: By the way, flower seeds are sold at the <$cdef(27)>PC shop</color>!
msgctxt "2463:5"
msgid "Puedes comprar semillas de flores en la <$cdef(27)>tienda </color>del <$cdef(27)>PC</color>."
msgstr ""

#. en: <$voicel(3,6)><$motion(3,805)><$comeff(3,6)>Do you think you can make a really big flower field?
msgctxt "2463:6"
msgid "<$voicel(3,6)><$motion(3,805)><$comeff(3,6)>¿Crees que podrías plantar un campo de flores bieeen<br>grande?"
msgstr ""

#. en: <$voicel(3,7)><$motion(3,803)><$comeff(3,9)><$facial(3,4)>If you take me to where you planted the seeds, I can make<br>’em grow SUPER fast!
msgctxt "2463:7"
msgid "<$voicel(3,7)><$motion(3,803)><$comeff(3,9)><$facial(3,4)>Si me llevas adonde están plantadas las semillas,<br>¡yo puedo hacer que crezcan enseguida!"
msgstr ""

#. en: You may know this already, but flower seeds are sold at<br>the <$cdef(27)>PC shop</color>!
msgctxt "2463:8"
msgid "Recuerda que puedes comprar semillas de flores<br>en la <$cdef(27)>tienda </color>del <$cdef(27)>PC</color>."
msgstr ""

#. en: <$voicel(3,9)><$emotion(3,7)>Oh, WOWWW!!! It’s just like the flower fields I used<br>to play in when I was little!
msgctxt "2463:9"
msgid "<$voicel(3,9)><$emotion(3,7)>¡Haaala, qué chuliii! ¡Es igualito al sitio en el que jugaba<br>cuando era más peque!"
msgstr "<$voicel(3,9)><$emotion(3,7)>¡Guaaau, qué lindooo! ¡Es igualito al lugar en el que jugaba<br>cuando era más peque!"

#. en: <$voicel(3,8)>Thank you, <$cdef(27)><pname;0></color>!<clear><br><$voicel(3,5)><$comeff(3,9)>I think it’ll get even more humid around here, the more<br>healthy plants and trees there are!
msgctxt "2463:10"
msgid "<$voicel(3,8)>¡Gracias, <$cdef(27)><pname;0></color>!<clear><br><$voicel(3,5)><$comeff(3,9)>Si seguimos plantando más flores y árboles, seguro que<br>habrá más humedad."
msgstr ""

#. en: <oneline><$voicel(3,7)><$emotion(3,14)><$facial(3,4)>Hey! Hey, <$cdef(27)><pname;0></color>! Guess what!<br><$voicel(3,10)><$motion(3,801)><$comeff(3,10)>I thought<slide><br>of<slide><br>ANOTHER<slide><br>way<slide><br>to<slide><br>make<slide><br>this<slide><br>place<slide><br>more humid!
msgctxt "2463:11"
msgid "<oneline><$voicel(3,7)><$emotion(3,14)><$facial(3,4)>¡Oye, oye, <$cdef(27)><pname;0></color>! ¿Sabes qué?<clear><br>Tengo una idea para que haya más humedad por aquí.<br><$voicel(3,10)><$motion(3,801)><$comeff(3,10)>¡Seguro que funciona!"
msgstr ""

#. en: <$voicel(3,7)><$motion(3,805)><$comeff(3,14)>So, um, you know how I was talking about the place where<br>I lived before? There was a really big, really pretty forest<slide><br>near there, <$voicel(3,6)><$motion(3,807)>and that area was always SUPER humid!
msgctxt "2463:12"
msgid "<$voicel(3,7)><$motion(3,805)><$comeff(3,14)>Donde yo vivía antes había cerca un bosque muy grande<br>y muy bonito.<clear><br><$voicel(3,6)><$motion(3,807)>¡Con tanta sombra, siempre había muuucha humedad!"
msgstr ""

#. en: <$voicel(3,7)><$comeff(3,9)><$motion(3,806)><$facial(3,4)>So I was hoping you could water the dried-up trees around<br>here and make ’em all healthy again!<clear><br><$voicel(3,10)><$comeff(3,21)><$motion(3,801)><$facial(3,5)>I bet that’d make the place even more humid!
msgctxt "2463:13"
msgid "<$voicel(3,7)><$comeff(3,9)><$motion(3,806)><$facial(3,4)>Por eso habría que darles agua a los árboles chuchurríos<br>que hay aquí, para que vuelvan a estar verdes y felices,<slide><br><$voicel(3,10)><$comeff(3,21)><$motion(3,801)><$facial(3,5)>¡y así habrá todavía más humedad!"
msgstr "<$voicel(3,7)><$comeff(3,9)><$motion(3,806)><$facial(3,4)>Por eso habría que darles agua a los árboles marchitos<br>que hay aquí, para que vuelvan a estar verdes y felices,<slide><br><$voicel(3,10)><$comeff(3,21)><$motion(3,801)><$facial(3,5)>¡y así habrá todavía más humedad!"

#. en: <$voicel(3,7)><$motionoff(3,804)><$facial(3,4)><$comeff(3,10)>If you see any dried-up trees, could you please<br>water them?<clear><br><$voicel(3,10)><$motion(3,803)><$facial(3,1)><$comeff(3,20)>Oh, wait a second! I just remembered something!
msgctxt "2463:15"
msgid "<$voicel(3,7)><$motionoff(3,804)><$facial(3,4)><$comeff(3,10)>Si ves por ahí algún árbol chuchurrío, échale agua, porfi.<br><wait(0.4)><$voicel(3,10)><$motion(3,803)><$facial(3,1)><$comeff(3,20)>¡Ah! Por cierto..."
msgstr "<$voicel(3,7)><$motionoff(3,804)><$facial(3,4)><$comeff(3,10)>Si ves por ahí algún árbol marchito, échale agua, porfa.<br><wait(0.4)><$voicel(3,10)><$motion(3,803)><$facial(3,1)><$comeff(3,20)>¡Ah! Por cierto..."

#. en: <$voicel(3,7)>There were lots and lots of dried-up trees on the beach<br>over that way!
msgctxt "2463:16"
msgid "<$voicel(3,7)>Si vas por allí a la playa, hay un montón de árboles secos<br>pidiendo ayuda a gritos."
msgstr "<$voicel(3,7)>Si vas por allá a la playa, hay un montón de árboles secos<br>pidiendo ayuda a gritos."

#. en: <$voicel(3,7)><$emotion(3,14)>Oooh, the trees around here look so much healthier now!<br>Did YOU do that? <$voicel(3,10)><$emotion(3,6)>Thank you!
msgctxt "2463:17"
msgid "<$voicel(3,7)><$emotion(3,14)>¡Los árboles están mucho más sanos! Has sido tú, ¿no?<br><$voicel(3,10)><$emotion(3,6)>¡Graciaaas!"
msgstr "<$voicel(3,7)><$emotion(3,14)>¡Los árboles están mucho más sanos! Fuiste tú, ¿no?<br><$voicel(3,10)><$emotion(3,6)>¡Graciaaas!"

#. en: <$voicel(3,5)><$motion(3,666)>By the way, didja know that you can also plant new trees<br>from seeds? <$voicel(3,8)><$facial(3,4)><$comeff(3,9)>Here—try it out!
msgctxt "2463:18"
msgid "<$voicel(3,5)><$motion(3,666)>También puedes plantar semillas para que salgan árboles.<br><$voicel(3,8)><$facial(3,4)><$comeff(3,9)>¡Toma unas cuantas!"
msgstr ""

#. en: You got some <$cdef(27)><fqty(2)><$ifull(1822)></color>!
msgctxt "2463:19"
msgid "¡Has recibido unas cuantas <$cdef(27)><fqty(2)><$ifull(1822)></color>!"
msgstr "¡Recibiste unas cuantas <$cdef(27)><fqty(2)><$ifull(1822)></color>!"

#. en: <$voicel(3,5)><$motion(3,805)><$comeff(3,14)>The seeds can really take a long time to grow after you<br>plant them, though.<clear><br><$voicel(3,7)><$motion(3,801)><$facial(3,4)><$comeff(3,10)>But I can help—um, just a little—when you’re growing trees<br>’n’ flowers ’n’ stuff!
msgctxt "2463:20"
msgid "<$voicel(3,5)><$motion(3,805)><$comeff(3,14)>Lo malo es que los árboles tardan mucho en crecer desde<br>que plantas la semilla.<clear><br><$voicel(3,7)><$motion(3,801)><$facial(3,4)><$comeff(3,10)>¡Pero yo puedo ayudarte a hacer que crezcan rapidísimo<br>los árboles, las flores o cualquier planta!"
msgstr ""

#. en: <$voicel(1,5)><$emotion(1,14)>I see a lot more healthy trees around here than before.
msgctxt "2463:21"
msgid "<$voicel(1,5)><$emotion(1,14)>Veo muchos más árboles lozanos que antes por la zona."
msgstr ""

#. en: <$voicel(1,8)><$emotion(1,8)>Thanks to them, the air feels a bit more humid too!
msgctxt "2463:22"
msgid "<$voicel(1,8)><$emotion(1,8)>¡Gracias a lo cual ha aumentado el nivel de humedad<br>ambiente!"
msgstr ""

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>It seems that having more healthy flowers around increases<br>the humidity as well!
msgctxt "2463:23"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Al parecer, la presencia de un mayor número de flores<br>contribuye también al aumento del nivel de humedad."
msgstr ""

#. en: <$voicel(1,5)><$motion(1,661)><$comeff(1,14)>Growing various other plants might be a good idea too.
msgctxt "2463:24"
msgid "<$voicel(1,5)><$motion(1,661)><$comeff(1,14)>Seguramente sea buena idea hacer que crezcan también<br>una mayor variedad de plantas."
msgstr ""

#. en: <$voicel(3,9)><$motion(3,803)><$facial(3,4)><$comeff(3,21)>If there are any plants you want to grow faster, then come<br>and get me!
msgctxt "2463:25"
msgid "<$voicel(3,9)><$motion(3,803)><$facial(3,4)><$comeff(3,21)>Tú llévame a donde quieras que algo crezca veloz y ya<br>verás. Ji, ji."
msgstr ""

#. en: <$voicel(3,8)><$motion(3,805)><$comeff(3,10)>I wonder how <$cdef(27)>Slowpoke</color>’s doing with that yawn!
msgctxt "2463:26"
msgid "<$voicel(3,8)><$motion(3,805)><$comeff(3,10)>¡A ver si ahora <$cdef(27)>Slowpoke</color> bosteza mejor!"
msgstr ""

#. en: <$voicel(2,8)>Hey, <$motion(2,803)><$comeff(2,3)><$cdef(27)><pname;0></color>! I’ve got an idea!
msgctxt "2463:32"
msgid "<oneline><$voicel(2,8)>Oye, <$motion(2,803)><$comeff(2,3)><$cdef(27)><pname;0></color>, ¡se me ha ocurrido<br>una idea!"
msgstr "<oneline><$voicel(2,8)>Oye, <$motion(2,803)><$comeff(2,3)><$cdef(27)><pname;0></color>, ¡se me ocurrió<br>una idea!"

#. en: <$voicel(2,9)><$motion(2,801)><$comeff(2,8)>I bet if there was a spot around here with some tall grass<br>near water, it’d be nice and <$cdef(27)>humid</color>—just the way I like it!
msgctxt "2463:33"
msgid "<$voicel(2,9)><$motion(2,801)><$comeff(2,8)>Si ponemos unas matitas de hierba alta al lado del agua,<br>seguro que aumenta la <$cdef(27)>humedad </color>y se está más a gusto."
msgstr ""

#. en: <$voicel(2,8)><$comeff(2,6)>I was thinking... Maybe you could make an area like that?
msgctxt "2463:34"
msgid "<$voicel(2,8)><$comeff(2,6)>¿Podrías preparar algo como esto?"
msgstr ""

#. en: <$voicel(2,8)><$motion(2,803)><$comeff(2,8)>Do you think you could grow some grass near the water<br>around here? I bet it’d be nice and <$cdef(27)>humid</color>!
msgctxt "2463:40"
msgid "<$voicel(2,8)><$motion(2,803)><$comeff(2,8)>¡Haz que crezca algo de hierba alta junto al agua!<br>Así lograremos que suba la <$cdef(27)>humedad </color>y se estará mejor."
msgstr ""

#. en: <oneline><$voicel(2,9)><$motion(2,801)><$comeff(2,9)>You made a <flow><$cdef(27)><$hatname(31)></color> habitat? Thanks so much,<br><$cdef(27)><pname;0></color>!
msgctxt "2463:46"
msgid "<oneline><$voicel(2,9)><$motion(2,801)><$comeff(2,9)>¡Un <$cdef(27)><$hatname(31)></color>! Jo, tú sí que sabes,<br><$cdef(27)><pname;0></color>."
msgstr "<oneline><$voicel(2,9)><$motion(2,801)><$comeff(2,9)>¡Un <$cdef(27)><$hatname(31)></color>! Vaya, tú sí que sabes,<br><$cdef(27)><pname;0></color>."
