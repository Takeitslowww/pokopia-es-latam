"Language: es_419\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"
"X-Generator: ldtool 0.1.0\n"
"X-Ldtool-Record: 1995\n"
"X-Ldtool-English-Record: 1991\n"

#. en: <$voicel(1,5)><$emotion(1,14)>Um, hi! N-nice to meet you! Sorry, I get a bit nervous<br>when I meet someone for the first time...<clear><br><$voicel(1,7)><$emotion(1,39)>You seem really nice, though... I hope we can be friends!
msgctxt "1995:3"
msgid "<$voicel(1,5)><$emotion(1,14)>¡Ho-hola, encantad<gen;-3(o,a)>! Je... Perdona, es que me pongo<br>muy nervios<gen;-3(o,a)> hablando con gente nueva...<clear><br><$voicel(1,7)><$emotion(1,39)>¡P-pero pareces muy maj<gen;-2(o,a)>! Me encantaría ser tu amig<gen;-3(o,a)>..."
msgstr "<$voicel(1,5)><$emotion(1,14)>¡Ho-hola, encantad<gen;-3(o,a)>! Je... Perdona, es que me pongo<br>muy nervios<gen;-3(o,a)> hablando con gente nueva...<clear><br><$voicel(1,7)><$emotion(1,39)>¡P-pero pareces simpátic<gen;-2(o,a)>! Me gustaría ser tu amig<gen;-3(o,a)>..."

#. en: <oneline><$voicel(1,3)><$emotion(1,14)>Ack! Who’re you!?<clear><br><$voicel(1,7)><$motion(1,805)><$comeff(1,14)>Me...? I’m <$cdef(27)><nowner;2></color>’s friend... <$voicel(1,6)><$comeff(1,6)>Oh, do you<br>know<slide><br>them too?<clear><br><$voicel(1,8)><$emotion(1,8)>In that case, I hope you’ll be my friend as well...
msgctxt "1995:4"
msgid "<$voicel(1,3)><$emotion(1,14)>¡Ah! Erm... ¿Q-quién eres?<clear><br><$voicel(1,7)><$motion(1,805)><$comeff(1,14)>Yo soy <gen;-3(un,una)> amig<gen;-3(o,a)> de <$cdef(27)><nowner;2></color>...<br><$voicel(1,6)><$comeff(1,6)>¿Tú también?<clear><br><$voicel(1,8)><$emotion(1,8)>E-entonces, seguro que nos llevamos bien..."
msgstr ""

#. en: <oneline><$voicel(1,3)><$emotion(1,14)>Ack! Who’re you!?<clear><br><$voicel(1,7)><$motion(1,805)><$comeff(1,14)>Me...? I’m <$cdef(27)><acqpname;2></color>’s friend... <$voicel(1,6)><$comeff(1,6)>Oh, you’re<br>friends<slide><br>with<slide><br>them too?<clear><br><$voicel(1,8)><$emotion(1,8)>In that case, I hope you’ll be my friend as well...
msgctxt "1995:5"
msgid "<$voicel(1,3)><$emotion(1,14)>¡Ah! Erm... ¿Q-quién eres?<clear><br><$voicel(1,7)><$motion(1,805)><$comeff(1,14)>Yo soy <gen;-3(un,una)> amig<gen;-3(o,a)> de <$cdef(27)><acqpname;2></color>...<br><$voicel(1,6)><$comeff(1,6)>¿Tú también?<clear><br><$voicel(1,8)><$emotion(1,8)>E-entonces, seguro que nos llevamos bien..."
msgstr ""

#. en: <$voicel(1,3)><$emotion(1,14)>Ack! Who’re you!?<clear><br><$voicel(1,5)><$motion(1,805)><$comeff(1,6)>Me? I’m that other Ditto’s friend. Oh...you’re friends<br>with them too?<clear><br><$voicel(1,8)><$emotion(1,8)>In that case, I hope you’ll be my friend as well...
msgctxt "1995:6"
msgid "<$voicel(1,3)><$emotion(1,14)>¡Ah! Erm... ¿Q-quién eres?<clear><br>Yo soy <gen;-3(un,una)> amig<gen;-3(o,a)> del Ditto que vive aquí...<br><$voicel(1,5)><$motion(1,805)><$comeff(1,6)>¿Tú también?<clear><br><$voicel(1,8)><$emotion(1,8)>E-entonces, seguro que nos llevamos bien..."
msgstr ""

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)><$pkcry;0(1,2)>! Such a good smell... I just had to come<br>back and check it out.
msgctxt "1995:8"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)><$pkcry;0(1,2)>... Iba siguiendo ese olor tan rico y...<br>¡he vuelto aquí sin darme cuenta!"
msgstr "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)><$pkcry;0(1,2)>... Iba siguiendo ese olor tan rico y...<br>¡volví aquí sin darme cuenta!"

#. en: <oneline><$voicel(1,7)><$motion(1,803)><$comeff(1,9)><$facial(1,5)>Oh, hi, <$cdef(27)><pname;0></color>.<br>It’s<slide><br>great<slide><br>to<slide><br>see<slide><br>you again!
msgctxt "1995:9"
msgid "<$voicel(1,7)><$motion(1,803)><$comeff(1,9)><$facial(1,5)>Hola, <$cdef(27)><pname;0></color>... ¡Q-qué alegría verte!"
msgstr ""

#. en: <$voicel(1,3)><$motion(1,805)><$comeff(1,6)>Ack! Wh-who are you?<clear><br><$voicel(1,5)><$emotion(1,14)>Uh...well, I was checking this place out since it seemed<br>really nice and...I was thinking I might live here...<clear><br><$voicel(1,8)><$emotion(1,8)>Maybe we’ll bump into each other again? If we do, I hope<br>you say hi...
msgctxt "1995:10"
msgid "<$voicel(1,3)><$motion(1,805)><$comeff(1,6)>Um... Eh... P-perdona... ¿Quién eres?<clear><br><$voicel(1,5)><$emotion(1,14)>M-me gusta mucho este sitio. No sé si mudarme aquí...<br><$voicel(1,8)><$emotion(1,8)>Bueno, si volvemos a cruzarnos, salúdame, ¿vale?"
msgstr "<$voicel(1,3)><$motion(1,805)><$comeff(1,6)>Um... Eh... P-perdona... ¿Quién eres?<clear><br><$voicel(1,5)><$emotion(1,14)>M-me gusta mucho este lugar. No sé si mudarme aquí...<br><$voicel(1,8)><$emotion(1,8)>Bueno, si volvemos a cruzarnos, salúdame, ¿sí?"

#. en: <$comeff(1,14)><$motion(1,666)><$facial(1,9)><$voicel(1,3)>When you have a big jaw, it’s hard to find a good position<br>to sleep in...
msgctxt "1995:47"
msgid "<$comeff(1,14)><$motion(1,666)><$facial(1,9)><$voicel(1,3)>Pfff... No sabes lo que cuesta encontrar una buena<br>postura para dormir con una mandíbula así de grande..."
msgstr ""

#. en: <$comeff(1,17)><$facial(1,14)><$voicel(1,3)>I could spend all day just looking at bubbles...
msgctxt "1995:50"
msgid "<$comeff(1,17)><$facial(1,14)><$voicel(1,3)>Aish... Podría pasarme el día entero observando el vaivén<br>de las burbujas..."
msgstr ""

#. en: <$emotion(1,14)><$voicel(1,5)>I hope we can still be friends and talk like this even after<br><$comeff(1,9)><$motion(1,806)><$voicel(1,8)>I get all big and grown up...
msgctxt "1995:52"
msgid "<$emotion(1,14)><$voicel(1,5)>Hay algo que me gustaría decirte... Aunque yo me haga<br>mayor y cambie, espero que nuestra relación no lo haga,<slide><br><$comeff(1,9)><$motion(1,806)><$voicel(1,8)>y que podamos seguir hablando como hasta ahora."
msgstr "<$emotion(1,14)><$voicel(1,5)>Hay algo que me gustaría decirte... Aunque yo crezca<br>y cambie, espero que nuestra relación no lo haga,<slide><br><$comeff(1,9)><$motion(1,806)><$voicel(1,8)>y que podamos seguir hablando como hasta ahora."

#. en: <oneline><$voicel(1,7)><$emotion(1,39)>Looking at this<br><$cdef(27)><fqty(1)><class><usingp;0></color><slide><br>really<slide><br>makes<slide><br>me<slide><br>appreciate<slide><br>all<slide><br>our<slide><br>hard work...
msgctxt "1995:53"
msgid "<oneline><$voicel(1,7)><$emotion(1,39)>Qué bien h<qty;0(a,an)> quedado<br><dart;0()><$cdef(27)><fqty(1)><usingp;0></color>...<clear><br>Me alegro de haberme esforzado tanto."
msgstr ""

#. en: <oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>That <$cdef(27)><fqty(1)><class><usingp;0></color> is so<br>impressive...<slide><br>I<slide><br>hope<slide><br>I<slide><br>can<slide><br>work<slide><br>on<slide><br>something<slide><br>like<slide><br>that<slide><br>next time...
msgctxt "1995:54"
msgid "<oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)><fcap><dart;0()><$cdef(27)><fqty(1)><usingp;0></color> h<qty;0(a,an)> quedado muy<br>chul<genqty;0(o,a,os,as)>.<clear><br>Yo también quiero construir algo así..."
msgstr "<oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)><fcap><dart;0()><$cdef(27)><fqty(1)><usingp;0></color> h<qty;0(a,an)> quedado muy<br>bonit<genqty;0(o,a,os,as)>.<clear><br>Yo también quiero construir algo así..."

#. en: <$comeff(1,21)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>Treasure hunts are so fun... I usually get really invested.
msgctxt "1995:56"
msgid "<$comeff(1,21)><$facial(1,1)><$motion(1,666)><$voicel(1,5)><$cdef(9)>(Es tan divertido salir a buscar tesoros...).<br></color>Ay, estaba pensando en voz alta, perdona."
msgstr ""

#. en: <$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,6)>When you crush berries, they make really pretty colors.<br>I wonder if you could use that for something.
msgctxt "1995:57"
msgid "<$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,6)>La pasta que sale al pulverizar las bayas tiene un color<br>muy chulo. Me pregunto si servirá para algo..."
msgstr "<$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,6)>La pasta que sale al pulverizar las bayas tiene un color<br>muy bonito. Me pregunto si servirá para algo..."

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,661)><$voicel(1,7)>I really like to <$cdef(27)><$spwfull(33)></color> buildings... I feel so much<br>lighter once the demolition is done.
msgctxt "1995:59"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,661)><$voicel(1,7)>Cuenta conmigo si hace falta destruir alguna estructura.<br>Me gusta <$cdef(27)>demolerlas<nbs2><$spwicon(33)></color> y dejarlo todo bien despejado..."
msgstr ""

#. en: <$comeff(1,3)><$facial(1,1)><$motion(1,803)><$voicel(1,5)>Let me know when you’re looking for a Pokémon. I’ll help<br>as much as I can...
msgctxt "1995:60"
msgid "<$comeff(1,3)><$facial(1,1)><$motion(1,803)><$voicel(1,5)>Avísame si necesitas buscar a un Pokémon. Te ayudaré...<br>en lo que pueda."
msgstr ""

#. en: <oneline><$voicel(1,5)><$emotion(1,15)>Uagh! Oh... It’s just you, <$cdef(27)><pname;0></color>. You<br>really<slide><br>surprised<slide><br>me!
msgctxt "1995:101"
msgid "<$voicel(1,5)><$emotion(1,15)>¡Ay! Ah, hola, <$cdef(27)><pname;0></color>... Qué susto..."
msgstr ""

#. en: <$voicel(1,5)><$emotion(1,14)>Hey, good morning. You sure have a lot of energy this<br>early in the morning, <$cdef(27)><pname;0></color>...
msgctxt "1995:102"
msgid "<$cdef(27)><$voicel(1,5)></color><$emotion(1,14)>B-buenos días... Empiezas fuerte por la mañana..."
msgstr ""

#. en: <oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,1)>Hi there, <$cdef(27)><pname;0></color>... Thanks for coming<br>to<slide><br>talk to me.
msgctxt "1995:103"
msgid "<oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,1)>Hola, <$cdef(27)><pname;0></color>... Me hace ilusión que<br>vengas a hablar<slide><br>conmigo."
msgstr "<oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,1)>Hola, <$cdef(27)><pname;0></color>... Me alegra que<br>vengas a hablar<slide><br>conmigo."

#. en: <oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>You always seem like you’re having<br>fun, <$cdef(27)><pname;0></color>...
msgctxt "1995:104"
msgid "<$cdef(27)><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)></color>Je... Parece que siempre te diviertes mucho..."
msgstr ""

#. en: <$voicel(1,7)><$motion(1,805)><$facial(1,4)><$comeff(1,9)>It’s already evening... I actually really like this time of day.
msgctxt "1995:105"
msgid "<$voicel(1,7)><$motion(1,805)><$facial(1,4)><$comeff(1,9)>El atardecer... Me gusta este momento del día..."
msgstr ""

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>I like it when the sky gets dark. It makes me feel secure,<br>for whatever reason...
msgctxt "1995:106"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Es curioso, pero cuanto más se oscurece el cielo, más me<br>tranquilizo..."
msgstr ""

#. en: <oneline><$voicel(1,5)><$motion(1,803)><$comeff(1,6)>Good evening... You’re still awake<br>huh, <$cdef(27)><pname;0></color>?
msgctxt "1995:107"
msgid "<$cdef(27)><$voicel(1,5)></color><$motion(1,803)>Hola... <$comeff(1,6)>¿Todavía estás despiert<gen;-2(o,a)>?"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,39)>I really like the night... It’s like the whole world is giving<br>me a hug.
msgctxt "1995:108"
msgid "<$voicel(1,7)><$emotion(1,39)>Me gusta la noche. Me hace sentir... arropad<gen;-3(o,a)>."
msgstr ""

#. en: <oneline><$voicel(1,5)><$emotion(1,14)>Hi there, <$cdef(27)><pname;0></color>. Just the one I wanted<br>to<slide><br>talk to.
msgctxt "1995:109"
msgid "<oneline><$voicel(1,5)><$emotion(1,14)>Hola, <$cdef(27)><pname;0></color>... Justo quería hablar<br>contigo..."
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,8)>You’re really good at making things, aren’t you?
msgctxt "1995:110"
msgid "<$cdef(27)><$voicel(1,7)><$emotion(1,8)></color>¡Qué habilidad! Si es que sabes hacer de todo..."
msgstr ""

#. en: <$voicel(1,5)><$motion(1,805)><$comeff(1,14)>I wonder... Do you ever transform into...me?
msgctxt "1995:111"
msgid "<$voicel(1,5)><$motion(1,805)><$comeff(1,14)>¿T-te vas a transformar en mí alguna vez?"
msgstr ""

#. en: <$voicel(1,5)><$emotion(1,64)>Is there anything I can do to help out? Just tell me if there<br>is, OK...?
msgctxt "1995:112"
msgid "<$voicel(1,5)><$emotion(1,64)>¿T-te puedo ayudar en algo? Que no te dé vergüenza..."
msgstr ""

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>I wonder who I’ll run into today. I’m a bit excited.
msgctxt "1995:113"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>A ver a quién conozco hoy. Qué emoción..."
msgstr ""

#. en: <oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,3)>You’re not tired, are you, <$cdef(27)><pname;0></color>?<br>It’s<slide><br>important<slide><br>to<slide><br>take<slide><br>breaks<slide><br>now<slide><br>and then...
msgctxt "1995:114"
msgid "<$cdef(27)><$voicel(1,5)><$motion(1,805)><$comeff(1,3)></color>Tienes pinta de estar cansad<gen;-2(o,a)>. Deberías tomarte un<br>respiro de vez en cuando..."
msgstr "<$cdef(27)><$voicel(1,5)><$motion(1,805)><$comeff(1,3)></color>Pareces cansad<gen;-2(o,a)>. Deberías tomarte un<br>respiro de vez en cuando..."

#. en: <oneline><$voicel(1,5)><$motion(1,803)><$facial(1,4)><$comeff(1,1)>What’s your favorite berry, <$cdef(27)><pname;0></color>?<br>Wouldn’t<slide><br>it<slide><br>be<slide><br>cool<slide><br>if<slide><br>we<slide><br>had<slide><br>the<slide><br>same favorite?
msgctxt "1995:115"
msgid "<$cdef(27)><$voicel(1,5)><$motion(1,803)><$facial(1,4)><$comeff(1,1)></color>¿A ti qué bayas te gustan más? Espero que las mismas que<br>a mí... Je..."
msgstr ""

#. en: <$voicel(1,5)><$motion(1,805)><$comeff(1,6)>Y’know, I can talk to you without feeling nervous...<br>I wonder why that is.
msgctxt "1995:116"
msgid "<$cdef(27)><$voicel(1,5)><$motion(1,805)></color>Contigo puedo hablar sin ponerme nervios<gen;-3(o,a)> casi nunca...<br><$comeff(1,6)>¿Por qué será?"
msgstr ""

#. en: <oneline><$voicel(1,7)><$emotion(1,39)>There’s always so much happening around you,<br><$cdef(27)><pname;0></color>...<slide><br>It’s<slide><br>a<slide><br>lot<slide><br>of fun!
msgctxt "1995:117"
msgid "<$cdef(27)><$voicel(1,7)><$emotion(1,39)></color>¡Siempre pasan cosas interesantes a tu alrededor!"
msgstr ""

#. en: <$voicel(1,5)><$motion(1,805)><$comeff(1,6)>I wonder if other <$cdef(27)>Ditto</color> can transform into a human like<br>you do...
msgctxt "1995:118"
msgid "<$voicel(1,5)><$motion(1,805)><$comeff(1,6)>¿Los demás <$cdef(27)>Ditto</color> también saben transformarse en<br>humanos?"
msgstr ""

#. en: <$voicel(1,5)><$motion(1,803)><$facial(1,4)><$comeff(1,1)>I know I probably don’t seem very dependable, but...<br>I really wanna help you out, <$cdef(27)><pname;1></color>.
msgctxt "1995:119"
msgid "<$cdef(27)><$voicel(1,5)></color><$motion(1,803)><$facial(1,4)><$comeff(1,1)>Puede que no sea <gen;-3(el,la)> más indicad<gen;-3(o,a)>, pero quiero ayudarte<br>en la medida de lo posible..."
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,8)>Watching you makes me wanna try my best at everything<br>I do too, y’know?
msgctxt "1995:120"
msgid "<$cdef(27)><$voicel(1,7)><$emotion(1,8)></color>Cuando te veo, me dan ganas de esforzarme como tú..."
msgstr ""

#. en: <oneline><$voicel(1,3)><$motion(1,803)><$facial(1,14)><$comeff(1,16)>*grumble* *yawn*... Oh, hey, <$cdef(27)><pname;0></color>...<br>Good<slide><br>morning...
msgctxt "1995:121"
msgid "<$voicel(1,3)><$motion(1,803)><$facial(1,14)><$comeff(1,16)>Qué sueñitooo... Uy, hola, <$cdef(27)><pname;0></color>..."
msgstr ""

#. en: <$voicel(1,5)><$emotion(1,15)>Gah! I must’ve fallen asleep just now... I hope I didn’t make<br>any weird faces while I was sleeping...
msgctxt "1995:122"
msgid "<$voicel(1,5)><$emotion(1,15)>¡Ay, me había quedado dormid<gen;-3(o,a)>! ¿He puesto caras raras?"
msgstr "<$voicel(1,5)><$emotion(1,15)>¡Ay, me había quedado dormid<gen;-3(o,a)>! ¿Puse caras raras?"

#. en: <$comeff(1,4)><$facial(1,9)><$motion(1,802)><$voicel(1,3)>It makes me nervous when I think about living with<br>unfamiliar Pokémon on unfamiliar land...<slide><br><$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,8)>I’ll try to adjust, though...
msgctxt "1995:123"
msgid "<$comeff(1,4)><$facial(1,9)><$motion(1,802)><$voicel(1,3)>Esto de vivir en un lugar nuevo con tanta gente nueva...<br>N-no sé, me pone un poco nervios<gen;-3(o,a)>...<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,8)>Ánimo, yo."
msgstr ""

#. en: <$comeff(1,14)><$motion(1,827)><$voicel(1,5)>I need to look for a place where I can find some<br>tasty berries...
msgctxt "1995:124"
msgid "<$comeff(1,14)><$motion(1,827)><$voicel(1,5)>Tengo que localizar algún árbol que dé bayas ricas..."
msgstr ""

#. en: <$comeff(1,6)><$motion(1,803)><$voicel(1,7)>C-can I come talk to you if I run into any issues...?
msgctxt "1995:125"
msgid "<$motion(1,803)><$voicel(1,7)>Si necesito ayuda con algo... <$comeff(1,6)>¿t-te puedo preguntar a ti?"
msgstr ""

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Everyone’s working so hard... I-I’ve gotta go cheer them<br>all on too!
msgctxt "1995:126"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Jo, están todos trabajando duro... Ánimo, esto... equipo..."
msgstr "<$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Ay, están todos trabajando duro... Ánimo, esto... equipo..."

#. en: <$voicel(1,7)><$emotion(1,50)>I’m ready when you are. I can’t wait to <$cdef(27)><$spwfull(1)></color>!
msgctxt "1995:127"
msgid "<$voicel(1,7)><$emotion(1,50)>¡Y-ya sabes que siempre puedes contar conmigo!<br>¡Hora de <$cdef(27)><$spwfull(1)></color>!"
msgstr ""

#. en: <$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>There are so many new Pokémon around here... It’s all<br>thanks to your hard work, <$cdef(27)><pname;0></color>.
msgctxt "1995:128"
msgid "<$cdef(27)><$comeff(1,1)></color><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Hay muchos más Pokémon que antes por aquí, ¿no?<br>Se nota lo mucho que te esfuerzas..."
msgstr ""

#. en: <$comeff(1,14)><$facial(1,9)><$motion(1,827)><$voicel(1,3)>There’s something bothering me about my current home...
msgctxt "1995:129"
msgid "<$comeff(1,14)><$facial(1,9)><$motion(1,827)><$voicel(1,3)>Hay... hay... algunas c-cosas que mejorar en mi casa..."
msgstr ""

#. en: <$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>I-I really like how my home’s turning out...
msgctxt "1995:130"
msgid "<$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Mi casa... está algo mejor que antes... Je, je..."
msgstr ""

#. en: <oneline><$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>My home’s so comfy... Thank you so much,<br><$cdef(27)><pname;1></color>!
msgctxt "1995:131"
msgid "<oneline><$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Mi casa ha quedado estupenda. ¡M-muchas gracias,<br><$cdef(27)><pname;0></color>!"
msgstr "<oneline><$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Mi casa quedó estupenda. ¡M-muchas gracias,<br><$cdef(27)><pname;0></color>!"

#. en: <oneline><$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Oh hey, <$cdef(27)><pname;0></color>... Thanks for coming to<br>talk<slide><br>to me.
msgctxt "1995:132"
msgid "<oneline><$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Ay, <$cdef(27)><pname;0></color>... Q-qué ilusión que hayas<br>venido a hablar<slide><br>conmigo..."
msgstr "<oneline><$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Ay, <$cdef(27)><pname;0></color>... Q-qué alegría que hayas<br>venido a hablar<slide><br>conmigo..."

#. en: <$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Every day is so much fun, and it’s all thanks to you,<br><$cdef(27)><pname;0></color>. Thanks for being my friend!
msgctxt "1995:133"
msgid "<$cdef(27)><$comeff(1,13)></color><$facial(1,4)><$motion(1,801)><$voicel(1,9)>G-gracias a ti, todos los días me lo paso muy bien...<br>Espero poder seguir quedando contigo..."
msgstr "<$cdef(27)><$comeff(1,13)></color><$facial(1,4)><$motion(1,801)><$voicel(1,9)>G-gracias a ti, todos los días me la paso muy bien...<br>Espero poder seguir pasando tiempo contigo..."

#. en: <$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>I was nervous going so far away from home, but...I had fun!
msgctxt "1995:134"
msgid "<$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Me he puesto un poco nervios<gen;-3(o,a)> saliendo de mi zona de<br>confort y yendo tan lejos, pero me lo he pasado genial..."
msgstr "<$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Me puse un poco nervios<gen;-3(o,a)> saliendo de mi zona de<br>confort y yendo tan lejos, pero me la pasé genial..."

#. en: <oneline><$comeff(1,3)><$motion(1,803)><$voicel(1,7)>Oh, hey there, <$cdef(27)><pname;0></color>... Did you find<br>anything<slide><br>interesting today?
msgctxt "1995:135"
msgid "<oneline><$comeff(1,3)><$motion(1,803)><$voicel(1,7)>Hola, <$cdef(27)><pname;0></color>... ¿Has encontrado algo<br>interesante<slide><br>en tus viajes?"
msgstr "<oneline><$comeff(1,3)><$motion(1,803)><$voicel(1,7)>Hola, <$cdef(27)><pname;0></color>... ¿Encontraste algo<br>interesante<slide><br>en tus viajes?"

#. en: <$comeff(1,3)><$motion(1,803)><$voicel(1,5)>You were off exploring pretty far away, weren’t you.<br>Welcome back!
msgctxt "1995:136"
msgid "<oneline><$comeff(1,3)><$motion(1,803)><$voicel(1,5)>Ay, por fin estás de vuelta, <$cdef(27)><pname;0></color>...<br>Te habías ido<slide><br>de excursión<slide><br>bien lejos de aquí, ¿no?<clear><br>Bueno, pues q-que descanses mucho..."
msgstr ""

#. en: <$voicel(1,5)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>I’ll put some gifts for you in the <$cdef(27)><fqty(1)><$ifull(1460)> </color>from<br>time to time, OK?
msgctxt "1995:137"
msgid "<$voicel(1,5)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Te iré dejando regalos en alguna <$cdef(27)><fqty(1)><$ifull(1460)></color> de vez<br>en cuando, a-a ver si te gustan..."
msgstr ""

#. en: <$comeff(1,21)><$facial(1,1)><$motion(1,805)><$voicel(1,7)>It makes me happy when new buildings go up. Please call<br>me when you want to <$cdef(27)><$spwfull(1)> </color>something!
msgctxt "1995:138"
msgid "<$comeff(1,21)><$facial(1,1)><$motion(1,805)><$voicel(1,7)>Me alegra crear nuevas estructuras... Si alguna vez<br>necesitas <$cdef(27)><$spwfull(1)> </color>una, avísame si eso..."
msgstr "<$comeff(1,21)><$facial(1,1)><$motion(1,805)><$voicel(1,7)>Me alegra crear nuevas estructuras... Si alguna vez<br>necesitas <$cdef(27)><$spwfull(1)> </color>una, avísame, por favor..."

#. en: <$voicel(1,5)><$emotion(1,50)>If you ever want to light something on fire...you know<br>where to find me.
msgctxt "1995:139"
msgid "<$voicel(1,5)><$emotion(1,50)>Si quieres prenderle fuego a algo, yo te ayudo..."
msgstr ""

#. en: <$voicel(1,5)><$motion(1,666)><$comeff(1,6)>Do you need anything watered? I can help with that if<br>you need me to...
msgctxt "1995:140"
msgid "<$voicel(1,5)><$motion(1,666)><$comeff(1,6)>¿Tienes suficiente agua? Si te falta en algún sitio, dime..."
msgstr "<$voicel(1,5)><$motion(1,666)><$comeff(1,6)>¿Tienes suficiente agua? Si te falta en algún lugar, dime..."

#. en: <$voicel(1,5)><$emotion(1,14)>If there’s any machine you need to get up and running,<br>take me to it. I think I can help...
msgctxt "1995:141"
msgid "<$voicel(1,5)><$emotion(1,14)>Si quieres hacer funcionar una máquina, llévame contigo.<br>T-tal vez pueda ayudarte..."
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,50)>Let me help with growing flowers and veggies, OK?
msgctxt "1995:142"
msgid "<$voicel(1,7)><$emotion(1,50)>Si necesitas ayuda con las flores o verduras de tu huerto,<br>me ofrezco encantad<gen;-3(o,a)>..."
msgstr ""

#. en: <oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,6)>Y-you wouldn’t happen to need any<br><fqty(2)><$cdef(27)><class><pdcitem;0></color>,<slide><br>would you?<clear><br>I’ll leave some out where you can find them, just in case...
msgctxt "1995:143"
msgid "<oneline><$voicel(1,5)><$motion(1,805)>O-oye, <$comeff(1,6)>¿no necesitarás por casualidad<br><$cdef(27)><fqty(2)><class><pdcitem;0></color>?<clear><br>Bueno, por si acaso, te iré dejando <genqty;0(alguno,alguna,algunos,algunas)> de vez<br>en cuando, donde se ve<qty;0(a,an)> bien, ¿vale?"
msgstr "<oneline><$voicel(1,5)><$motion(1,805)>O-oye, <$comeff(1,6)>¿no necesitarás por casualidad<br><$cdef(27)><fqty(2)><class><pdcitem;0></color>?<clear><br>Bueno, por si acaso, te iré dejando <genqty;0(alguno,alguna,algunos,algunas)> de vez<br>en cuando, donde se ve<qty;0(a,an)> bien, ¿sí?"

#. en: <$voicel(1,7)><$emotion(1,8)>I like to <$cdef(27)><$spwfull(12)></color> at the <$cdef(27)><fqty(1)><$ifull(1325)></color>... That’s why I<br>keep a nice stockpile of odds and ends.
msgctxt "1995:144"
msgid "<$voicel(1,7)><$emotion(1,8)>Me encanta <$cdef(27)><$spwfull(12)></color> en la <$cdef(27)><fqty(1)><$ifull(1325)></color>,<br>por eso estoy reuniendo artículos varios..."
msgstr ""

#. en: <$comeff(1,6)><$motion(1,803)><$voicel(1,7)>I’m not the only one who feels like <$comeff(1,14)><$motion(1,805)><$voicel(1,5)>this home just screams<br><$cdef(27)><wndhmownerpk;0></color>, right?
msgctxt "1995:148"
msgid "<oneline><$comeff(1,14)><$motion(1,805)><$voicel(1,5)>Este sitio grita \"<$cdef(27)><wndhmownerpk;0></color>\" por todos<br>lados...<slide><br><$comeff(1,6)><$motion(1,803)><$voicel(1,7)>¿O es solo cosa mía?"
msgstr "<oneline><$comeff(1,14)><$motion(1,805)><$voicel(1,5)>Este lugar grita \"<$cdef(27)><wndhmownerpk;0></color>\" por todos<br>lados...<slide><br><$comeff(1,6)><$motion(1,803)><$voicel(1,7)>¿O es solo cosa mía?"

#. en: <oneline><$emotion(1,14)><$voicel(1,7)>Oh, uh...hi, <$cdef(27)><pname;0></color>... What’re you<br>doing here?
msgctxt "1995:149"
msgid "<oneline><$emotion(1,14)><$voicel(1,7)>Ah... Ho-hola, <$cdef(27)><pname;0></color>. ¿Qué haces<br>aquí?"
msgstr ""

#. en: <oneline><$voicel(1,7)><$emotion(1,1)>Huh... This <$cdef(27)><fqty(1)><class><usingp;0></color> is<br>kinda fun...
msgctxt "1995:150"
msgid "<oneline><$voicel(1,7)><$emotion(1,1)>Me diviert<qty;0(e,en)> mucho est<genqty;0(e,a,os,as)><br><$cdef(27)><fqty(1)><class><usingp;0></color>..."
msgstr ""

#. en: <$voicel(1,3)><$motion(1,803)><$comeff(1,6)><$facial(1,9)>What could this be...? I hope it doesn’t suddenly start<br>moving or something...
msgctxt "1995:151"
msgid "<$voicel(1,3)><$motion(1,803)><$comeff(1,6)><$facial(1,9)>¿Y esto qué es? Espero que no empiece a moverse de<br>repente o algo..."
msgstr ""

#. en: <oneline><$voicel(1,7)><$emotion(1,6)>Oh wow... This<br><$cdef(27)><fqty(1)><class><usingp;0></color><slide><br>is<slide><br>so cute!
msgctxt "1995:152"
msgid "<oneline><$voicel(1,7)><$emotion(1,6)>Qué monada de<br><$cdef(27)><fqty(1)><class><usingp;0></color>..."
msgstr "<oneline><$voicel(1,7)><$emotion(1,6)>Qué ternura de<br><$cdef(27)><fqty(1)><class><usingp;0></color>..."

#. en: <oneline><$voicel(1,5)><$emotion(1,55)><fcap><iart;0()><$cdef(27)><fqty(1)><class><usingp;0></color>, huh...<br>There’s<slide><br>something<slide><br>about <qty;0(it,them)>...
msgctxt "1995:153"
msgid "<oneline><$voicel(1,5)><$emotion(1,55)>¿<fcap><iart;0()><$cdef(27)><fqty(1)><class><usingp;0></color>?<br>Interesante..."
msgstr ""

#. en: <oneline><$voicel(1,7)><$emotion(1,8)>This <$cdef(27)><fqty(1)><class><usingp;0></color> is<br>really<slide><br>nice!<slide><br>I<slide><br>like<slide><br>to<slide><br>have<slide><br>it<slide><br>on hand...
msgctxt "1995:155"
msgid "<oneline><$voicel(1,7)><$emotion(1,8)>¡Menudo invento<br><dart;0()><$cdef(27)><fqty(1)><class><usingp;0></color>!<slide><br><qty;0(Es,Son)> justo lo que<slide><br>hacía falta aquí..."
msgstr "<oneline><$voicel(1,7)><$emotion(1,8)>¡Qué gran invento<br><dart;0()><$cdef(27)><fqty(1)><class><usingp;0></color>!<slide><br><qty;0(Es,Son)> justo lo que<slide><br>hacía falta aquí..."

#. en: <$voicel(1,5)><$emotion(1,64)>S-sorry if I’m wrong, but isn’t this pretty much me...?
msgctxt "1995:156"
msgid "<$voicel(1,5)><$emotion(1,64)>T-tal vez me equivoque, pero... se parece mucho a mí,<br>¿no?"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,6)>Mmm... <qty;0(This,These)> <$cdef(27)><fqty(1)><noweating;0> </color><qty;0(is,are)> so tasty...
msgctxt "1995:157"
msgid "<oneline><$voicel(1,7)><$emotion(1,6)>Mmm... Est<genqty;0(e,a,os,as)><br><$cdef(27)><fqty(1)><noweating;0><slide><br></color>est<qty;0(á,án)><slide><br>delicios<genqty;0(o,a,os,as)>..."
msgstr ""

#. en: <oneline><$voicel(1,3)><$emotion(1,41)>Urk... I’m still not a big fan of <qty;0(this,these)><br><$cdef(27)><fqty(1)><noweating;0></color>...
msgctxt "1995:158"
msgid "<oneline><$voicel(1,3)><$emotion(1,41)>Hmm, <dart;0()><$cdef(27)><fqty(1)><noweating;0> </color>est<genqty;0(e,a,os,as)>...<br>Digamos que<slide><br>no me entusiasm<qty;0(a,an)><slide><br>demasiado..."
msgstr ""

#. en: <oneline><$voicel(1,9)><$emotion(1,39)>Oh wow... You really are amazing,<br><$cdef(27)><pname;0></color>!
msgctxt "1995:159"
msgid "<$voicel(1,9)><$emotion(1,39)>¡Guau! <$cdef(27)><pname;0></color>, eres asombros<gen;-2(o,a)>..."
msgstr ""

#. en: <oneline><$voicel(1,7)><$emotion(1,8)>Wow, <$cdef(27)><blsspwkpk;0></color> is really something else! I wonder<br>if<slide><br>I<slide><br>can<slide><br>do<slide><br>the same...?
msgctxt "1995:160"
msgid "<oneline><$voicel(1,7)><$emotion(1,8)>¡<fcap><dart;0()><$cdef(27)><blsspwkpk;0> </color>es increíble! Me pregunto si yo<br>también podría<slide><br>hacer eso..."
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,50)>I honestly didn’t expect...playing tag...to be so much fun!
msgctxt "1995:161"
msgid "<$voicel(1,7)><$emotion(1,50)>El pillapilla... es tan divertido..."
msgstr "<$voicel(1,7)><$emotion(1,50)>Jugar a atraparnos... es tan divertido..."

#. en: <oneline><$voicel(1,7)><$emotion(1,1)><$cdef(27)><nnowpairpk;0> </color>is so nice... I’m glad I was<br>able<slide><br>to<slide><br>talk<slide><br>with<slide><br>them<slide><br>so much!
msgctxt "1995:162"
msgid "<oneline><$voicel(1,7)><$emotion(1,1)><fcap><dart;0()><$cdef(27)><nnowpairpk;0> </color>es tan amable...<br>Hoy hemos hablado<slide><br>un montón..."
msgstr "<oneline><$voicel(1,7)><$emotion(1,1)><fcap><dart;0()><$cdef(27)><nnowpairpk;0> </color>es tan amable...<br>Hoy hablamos<slide><br>un montón..."

#. en: <$comeff(1,16)><$facial(1,14)><$motion(1,807)><$voicel(1,3)>I should go to sleep soon... Make sure you get enough rest<br>as well, <$cdef(27)><pname;0></color>.
msgctxt "1995:163"
msgid "<$comeff(1,16)><$facial(1,14)><$motion(1,807)><$voicel(1,3)>Creo que va siendo hora de dormir, ¿no?... Será mejor<br>que tú tampoco trasnoches y aproveches para descansar."
msgstr ""

#. en: <$comeff(1,16)><$facial(1,14)><$motion(1,805)><$voicel(1,3)>*yaaawn*<clear><br><$comeff(1,4)><$facial(1,1)><$motion(1,803)><$voicel(1,6)>Oh, d-did you see that, <$cdef(27)><pname;0></color>?<br>How embarrassing...
msgctxt "1995:164"
msgid "<$comeff(1,16)><$facial(1,14)><$motion(1,805)><$voicel(1,3)>Uaaah... Qué sueño...<clear><br><$comeff(1,4)><$facial(1,1)><$motion(1,803)><$voicel(1,6)>Uy, ¿me has visto bostezar? Q-qué corte..."
msgstr "<$comeff(1,16)><$facial(1,14)><$motion(1,805)><$voicel(1,3)>Uaaah... Qué sueño...<clear><br><$comeff(1,4)><$facial(1,1)><$motion(1,803)><$voicel(1,6)>Uy, ¿me viste bostezar? Q-qué vergüenza..."

#. en: <$voicel(1,3)><$emotion(1,14)>Morning already, huh? I should probably go to bed...
msgctxt "1995:165"
msgid "<$voicel(1,3)><$emotion(1,14)>Uy, si ya es de día... Hora de dormir..."
msgstr ""

#. en: <oneline><$voicel(1,5)><$motion(1,805)><$facial(1,14)><$comeff(1,16)>Did you just wake up, <$cdef(27)><pname;0></color>...? It’s<br>bedtime<slide><br>for me...
msgctxt "1995:166"
msgid "<$voicel(1,5)><$cdef(27)><$motion(1,805)><$facial(1,14)><$comeff(1,16)></color>¿Te acabas de despertar? Yo me voy a la cama ahora..."
msgstr ""

#. en: <$voicel(1,7)><$motion(1,661)><$facial(1,4)><$comeff(1,21)>These days, it’s more fun hanging out here with everyone<br>than it is flying up in the sky...
msgctxt "1995:167"
msgid "<$voicel(1,7)><$motion(1,661)><$facial(1,4)><$comeff(1,21)>Últimamente me lo paso mejor en tierra con todos mis<br>amigos que volando..."
msgstr "<$voicel(1,7)><$motion(1,661)><$facial(1,4)><$comeff(1,21)>Últimamente me la paso mejor en tierra con todos mis<br>amigos que volando..."

#. en: <$voicel(1,3)><$emotion(1,51)>I really wanna go play in the ocean, but... I’d probably get<br>all rusty, huh?
msgctxt "1995:168"
msgid "<$voicel(1,3)><$emotion(1,51)>Quiero bañarme en el mar, pero igual me oxido tod<gen;-3(o,a)>..."
msgstr "<$voicel(1,3)><$emotion(1,51)>Quiero nadar en el mar, pero tal vez me oxide tod<gen;-3(o,a)>..."

#. en: <$voicel(1,5)><$emotion(1,65)>I need to be careful not to spew poison all around<br>this place...
msgctxt "1995:169"
msgid "<$voicel(1,5)><$emotion(1,65)>Voy a procurar no esparcir veneno por aquí..."
msgstr ""

#. en: <$voicel(1,3)><$emotion(1,46)>My body’s so hard... How can I get <$voicel(1,5)><$emotion(1,64)>nice and squishy like<br>you, <$cdef(27)><pname;1></color>?
msgctxt "1995:171"
msgid "<$voicel(1,3)><$emotion(1,46)>Mi cuerpo es tan duro... <wait(0.9)><$voicel(1,5)><$cdef(27)><$emotion(1,64)></color>¿Qué tengo que hacer para<br>tener uno tan blandito como el tuyo?"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,8)>Your home feels extra big if you’ve got a small body!
msgctxt "1995:172"
msgid "<$voicel(1,7)><$emotion(1,8)>Lo bueno de ser pequeñ<gen;-3(o,a)> es que hasta las casas con<br>poco espacio parecen más grandes..."
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,1)>A big body means you can fit more food in you...
msgctxt "1995:173"
msgid "<$voicel(1,7)><$emotion(1,1)>Lo bueno de ser tan grande es que puedes comer mucho<br>más sin llenarte..."
msgstr ""

#. en: <$voicel(1,5)><$motion(1,661)><$comeff(1,4)>Be careful when you’re around me... I don’t want you to<br>get burned...
msgctxt "1995:174"
msgid "<$voicel(1,5)><$motion(1,661)><$comeff(1,4)>Cuidado si te acercas, no te vayas a quemar..."
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,39)>I like being around grass and trees... They’re both precious<br>friends to me.
msgctxt "1995:176"
msgid "<$voicel(1,7)><$emotion(1,39)>Me gusta tener hierba y árboles cerca... porque son mis<br>mejores amigos..."
msgstr "<$voicel(1,7)><$emotion(1,39)>Me gusta tener pasto y árboles cerca... porque son mis<br>mejores amigos..."

#. en: <$voicel(1,5)><$motion(1,803)><$comeff(1,4)>Careful... I don’t want you to get zapped from being too<br>close to me...
msgctxt "1995:177"
msgid "<$voicel(1,5)><$motion(1,803)><$comeff(1,4)>No te acerques demasiado, no te vayas a electrocutar..."
msgstr ""

#. en: <$comeff(1,21)><$facial(1,14)><$motion(1,803)><$voicel(1,10)>Whenever something’s troubling you, just close your eyes<br>and focus... It always helps me clear my mind.<clear><br><$comeff(1,3)><$facial(1,4)><$motion(1,801)><$voicel(1,8)>Give it a try sometime. M-maybe it’ll work for you too!
msgctxt "1995:178"
msgid "<$comeff(1,21)><$facial(1,14)><$motion(1,803)><$voicel(1,10)>Cuando tengo dudas o miedos, intento cerrar los ojos<br>y vaciar la mente. Así consigo calmarme enseguida...<clear><br><$comeff(1,3)><$facial(1,4)><$motion(1,801)><$voicel(1,8)>Puedes probar tú también, si quieres, claro..."
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,8)>Berries get a little bit more special if you freeze them<br>before you eat them...
msgctxt "1995:179"
msgid "<$voicel(1,7)><$emotion(1,8)>Si congelas las bayas antes de comértelas, toman un<br>sabor único y están buenísimas..."
msgstr ""

#. en: <oneline><$voicel(1,7)><$emotion(1,14)>You aren’t really scared of me, are you,<br><$cdef(27)><pname;0></color>...?<clear><br><$voicel(1,6)><$emotion(1,66)>I don’t know whether to be happy or to take that as a<br>challenge...
msgctxt "1995:180"
msgid "<$cdef(27)><$voicel(1,7)><$emotion(1,14)></color>No pareces tenerme miedo... <$voicel(1,6)><$emotion(1,66)>No sé si me hace ilusión<br>o me da pena..."
msgstr "<$cdef(27)><$voicel(1,7)><$emotion(1,14)></color>No pareces tenerme miedo... <$voicel(1,6)><$emotion(1,66)>No sé si me alegra<br>o me da pena..."

#. en: <$comeff(1,14)><$motion(1,827)><$voicel(1,5)>There are a lot more Pokémon around here now... I hope<br>we can all be friends...
msgctxt "1995:181"
msgid "<$comeff(1,14)><$motion(1,827)><$voicel(1,5)>Cada vez hay más gente en la zona... E-espero poder<br>llevarme bien con todos..."
msgstr ""

#. en: <oneline><$voicel(1,5)>Oh, uh... <$cdef(27)><pname;0></color>, right?<wait(0.4)> <$comeff(1,1)><$facial(1,4)><$motion(1,803)>It-it’s good to<br>see<slide><br>you again!
msgctxt "1995:182"
msgid "<$voicel(1,5)>Ah, sí, eeeh... ¡<$cdef(27)><pname;0></color>! ¿Me equivoco?<wait(0.4)><br><$comeff(1,1)><$facial(1,4)><$motion(1,803)>Qué casualidad cruzarnos de nuevo."
msgstr ""

#. en: <oneline><$comeff(1,3)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Good morning, <$cdef(27)><pname;0></color>. It’s a really<br>nice<slide><br>morning,<slide><br>isn’t it?
msgctxt "1995:183"
msgid "<oneline><$comeff(1,3)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Buenos días, <$cdef(27)><pname;0></color>... Qué mañana<br>tan...<slide><br>agradable."
msgstr ""

#. en: <oneline><$comeff(1,3)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Hey there, <$cdef(27)><pname;0></color>. Great weather,<br>right?<slide><br>The<slide><br>perfect<slide><br>weather<slide><br>for a<slide><br>nap, actually...
msgctxt "1995:184"
msgid "<oneline><$comeff(1,3)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Hola, <$cdef(27)><pname;0></color>... ¿No hace un tiempo<br>perfecto para<slide><br>una siesta?"
msgstr ""

#. en: <oneline><$comeff(1,3)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Hey, good evening, <$cdef(27)><pname;0></color>. A nice,<br>quiet<slide><br>night,<slide><br>isn’t it?
msgctxt "1995:185"
msgid "<oneline><$comeff(1,3)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Hola, <$cdef(27)><pname;0></color>... Qué noche tan<br>tranquila,<slide><br>¿no te parece?..."
msgstr ""

#. en: <$voicel(1,7)><$motion(1,803)><$comeff(1,21)><$facial(1,4)>I love the sound of falling rain... So calming...
msgctxt "1995:186"
msgid "<$voicel(1,7)><$motion(1,803)><$comeff(1,21)><$facial(1,4)>Me encanta el sonido de la lluvia... Me calma mucho..."
msgstr ""

#. en: <$voicel(1,3)><$emotion(1,58)>Oh no, rain... What should I do...?
msgctxt "1995:187"
msgid "<$voicel(1,3)><$emotion(1,58)>Oh no, está lloviendo... ¿Y ahora qué hago?..."
msgstr ""

#. en: <$comeff(1,14)><$motion(1,827)><$voicel(1,5)>Such a gloomy day today... I think I’ll just take it easy.
msgctxt "1995:188"
msgid "<$comeff(1,14)><$motion(1,827)><$voicel(1,5)>Con lo triste y feo que está el tiempo, no me dan ganas<br>de hacer nada..."
msgstr ""

#. en: <$voicel(1,3)><$motion(1,661)><$facial(1,9)><$comeff(1,4)><$cdef(27)>Professor Tangrowth</color> is so imposing... I get a little nervous<br>whenever I’m talking to them...
msgctxt "1995:189"
msgid "<$voicel(1,3)><$motion(1,661)><$facial(1,9)><$comeff(1,4)>El <$cdef(27)>Profesor Tangrowth</color> con su presencia impone bastante...<br>Cuando hablo con él, me pongo un poco nervios<gen;-3(o,a)>..."
msgstr ""

#. en: <$voicel(1,7)><$motion(1,803)><$comeff(1,10)>I’ll do my best and try not to get in anyone’s way...
msgctxt "1995:190"
msgid "<$voicel(1,7)><$motion(1,803)><$comeff(1,10)>H-haré lo que pueda por no estorbar a los demás...<br>¡Cuenta conmigo!"
msgstr ""

#. en: <$voicel(1,7)><$motion(1,805)><$facial(1,4)><$comeff(1,14)>I really hope I can do this right... I’m so nervous...
msgctxt "1995:191"
msgid "<$voicel(1,7)><$motion(1,805)><$facial(1,4)><$comeff(1,14)>Ojalá salga todo muy rico... Qué nervios."
msgstr ""

#. en: <$emotion(1,8)><$voicel(1,9)>When I’m with you, even just walking around is so<br>much fun!
msgctxt "1995:192"
msgid "<$emotion(1,8)><$voicel(1,9)>Cuando estoy contigo, hasta las cosas más simples, como<br>dar un paseo, me parecen divertidas."
msgstr ""

#. en: <$emotion(1,50)><$voicel(1,7)>I’m really enjoying this weather... I’m glad I came along<br>with you!
msgctxt "1995:193"
msgid "<$emotion(1,50)><$voicel(1,7)>Este tiempo está muy bien para pasear, ¿no te parece?<br>Me alegro de haber venido contigo."
msgstr ""

#. en: <$comeff(1,5)><$motion(1,803)><$voicel(1,7)>...Hm? Oh! I-I’m sorry, I was distracted...
msgctxt "1995:194"
msgid "<$comeff(1,5)><$motion(1,803)><$voicel(1,7)>Ay, perdona... Me he distraído."
msgstr "<$comeff(1,5)><$motion(1,803)><$voicel(1,7)>Ay, perdona... Me distraje."

#. en: <oneline><$emotion(1,14)><$voicel(1,7)>Heh heh... <$emotion(1,8)><$voicel(1,10)>It’s so nice living with you,<br><$cdef(27)><pname;0></color>...
msgctxt "1995:195"
msgid "<oneline><$emotion(1,14)><$voicel(1,7)>Je... Me hace mucha ilusión compartir casa contigo,<br><$cdef(27)><pname;0></color>.<clear><br><$emotion(1,8)><$voicel(1,10)>Es más divertido que vivir sol<gen;-3(o,a)>."
msgstr "<oneline><$emotion(1,14)><$voicel(1,7)>Je... Me hace muy feliz compartir casa contigo,<br><$cdef(27)><pname;0></color>.<clear><br><$emotion(1,8)><$voicel(1,10)>Es más divertido que vivir sol<gen;-3(o,a)>."

#. en: <$comeff(1,14)><$motion(1,805)><$voicel(1,5)>So, um... H-have you seen that big Pokémon who flies<br>around here sometimes? I don’t recognize them...<slide><br><$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,8)>But they’re HUGE! I was so surprised when I first saw them.
msgctxt "1995:196"
msgid "<$comeff(1,14)><$motion(1,805)><$voicel(1,5)>A veces puedes ver a unos Pokémon muy inusuales<br>sobrevolando esta zona...<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,8)>Son tan grandes que la primera vez que los vi me llevé<br>un susto tremendo."
msgstr ""

#. en: <$emotion(1,31)><$voicel(1,5)>I get treated like some kind of bad Pokémon because of<br>the way I look...<clear><br><$emotion(1,51)><$voicel(1,4)>As if I’m bold enough to ever do anything bad...
msgctxt "1995:199"
msgid "<$emotion(1,31)><$voicel(1,5)>La gente siempre se piensa que voy a hacerles alguna<br>jugarreta por las pintas que tengo...<clear><br><$emotion(1,51)><$voicel(1,4)>Pero lo cierto es que no tengo el valor para algo así..."
msgstr "<$emotion(1,31)><$voicel(1,5)>La gente siempre piensa que voy a hacerles alguna<br>jugarreta por mi aspecto...<clear><br><$emotion(1,51)><$voicel(1,4)>Pero lo cierto es que no tengo el valor para algo así..."

#. en: <oneline><$voicel(1,5)><$emotion(1,14)>Hey, um... Could you get me <$cdef(27)><nquestinum;1></color><br><$cdef(27)><class><nquestitem;0></color>...?
msgctxt "1995:201"
msgid "<oneline><$voicel(1,5)><$emotion(1,14)>Pueees... quería <$cdef(27)><nquestinum;1></color><br><$cdef(27)><class><nquestitem;0></color>.<slide><br>¿Podrías traérmel<genqty;0(o,a,os,as)>?"
msgstr ""

#. en: <$voicel(1,8)><$emotion(1,8)>Thanks, <$cdef(27)><pname;0></color>...
msgctxt "1995:202"
msgid "<$voicel(1,8)><$emotion(1,8)>¡Gracias, <$cdef(27)><pname;0></color>!"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,14)>I’d...I’d really love to see a place like this...
msgctxt "1995:203"
msgid "<$voicel(1,7)><$emotion(1,14)>Esto... Me gustaría ver un lugar así..."
msgstr ""

#. en: <oneline><$voicel(1,7)><$emotion(1,8)>Oh... You made the habitat for me? Thanks,<br><$cdef(27)><pname;0></color>!
msgctxt "1995:204"
msgid "<oneline><$voicel(1,7)><$emotion(1,8)>¡Si ya lo has terminado!...<br>¡Gracias, <$cdef(27)><pname;0></color>!"
msgstr "<oneline><$voicel(1,7)><$emotion(1,8)>¡Si ya lo terminaste!...<br>¡Gracias, <$cdef(27)><pname;0></color>!"

#. en: <$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,8)>I-I’d really appreciate it if you could make a path that’s<br>easy for me to walk on...
msgctxt "1995:205"
msgid "<$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,8)>Me gustaría que hubiera un camino por el que se pueda<br>ir bien..."
msgstr ""

#. en: <$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>I made it... And all because you helped me! Thank you<br>so much!
msgctxt "1995:206"
msgid "<$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Muchísimas gracias por arreglar el camino... Sin tu ayuda,<br>no habría conseguido llegar nunca."
msgstr ""

#. en: <$comeff(1,6)><$motion(1,666)><$voicel(1,5)>Oh, uh, you have what I was asking for, huh? I don’t...<br>I don’t suppose I could, like...maybe have it?
msgctxt "1995:209"
msgid "<$motion(1,666)><$voicel(1,5)>Ah, si ya llevabas encima eso. <$comeff(1,6)>¿Te importa si me lo quedo<br>pues?..."
msgstr ""

#. en: <$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>Yeah, I understand... Sorry if I seemed selfish...
msgctxt "1995:210"
msgid "<$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>Lo entiendo, no pasa nada... Perdona, no quería ponerte<br>en un compromiso..."
msgstr ""

#. en: <oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,14)>I want to meet up with <$cdef(27)><nquestappk;0></color>, but I’m worried<br>I<slide><br>might<slide><br>get lost...<clear><br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,1)>C-could you take me to them? Please?
msgctxt "1995:212"
msgid "<oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,14)>Quiero ir a hablar con <dart;0()><$cdef(27)><nquestappk;0></color>, pero capaz<br>soy<slide><br>de perderme<slide><br>de camino...<clear><br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,1)>Erm... ¿T-te importaría llevarme hasta <gen;0(él,ella)>?"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,39)>Oh thank goodness—I made it here safely... Thank you so<br>much for your help, <$cdef(27)><pname;0></color>!
msgctxt "1995:213"
msgid "<$voicel(1,7)><$emotion(1,39)>Menos mal que no ha habido ningún percance...<br>¡Gracias por acercarme, <$cdef(27)><pname;0></color>!"
msgstr "<$voicel(1,7)><$emotion(1,39)>Menos mal que no hubo ningún percance...<br>¡Gracias por acercarme, <$cdef(27)><pname;0></color>!"

#. en: <oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>Uh, hey, <$cdef(27)><pname;0></color>... I-if you don’t mind,<br>I’d<slide><br>really<slide><br>love<slide><br>to<slide><br>take<slide><br>a<slide><br>photo<slide><br>with you...
msgctxt "1995:214"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>Eh... S-si no te importa... ¿nos hacemos una foto?"
msgstr "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>Eh... S-si no te importa... ¿nos tomamos una foto?"

#. en: <oneline><$voicel(1,9)><$emotion(1,8)>Oh, that’s the photo, right? <$pkcry;0(1,2)>! ♪ It looks<br>great!<slide><br>Thanks<slide><br>for<slide><br>showing me.
msgctxt "1995:215"
msgid "<$voicel(1,9)><$emotion(1,8)>¡Qué fotaza! <$pkcry;0(1,2)>... G-gracias por<br>sacarte una conmigo."
msgstr "<$voicel(1,9)><$emotion(1,8)>¡Qué fotaza! <$pkcry;0(1,2)>... G-gracias por<br>tomarte una conmigo."

#. en: <$comeff(1,14)><$motion(1,803)><$voicel(1,5)>Huh? Oh... <$cdef(27)><nquestappk;0></color>’s right there, aren’t they?
msgctxt "1995:217"
msgid "<$comeff(1,14)><$motion(1,803)><$voicel(1,5)>Uy... Acabo de darme cuenta de que ya está por aquí<br><dart;0()><$cdef(27)><nquestappk;0></color>..."
msgstr ""

#. en: <oneline><$voicel(1,5)><$motion(1,803)><$comeff(1,14)>Hey, <$cdef(27)><pname;0></color>... There’s something I<br>wanted<slide><br>to<slide><br>ask you...<clear><br><$voicel(1,8)><$motion(1,805)><$comeff(1,6)>Do you think you could help me out?
msgctxt "1995:224"
msgid "<oneline><$voicel(1,5)><$motion(1,803)><$comeff(1,14)>Ah, <$cdef(27)><pname;0></color>, hay algo que quería<br>pedirte...<clear><br><$voicel(1,8)><$motion(1,805)><$comeff(1,6)>¿No tendrás un momento?"
msgstr ""

#. en: <$voicel(1,3)><$motion(1,807)><$comeff(1,4)>Oh, um, OK... I understand. I’ll ask another time, maybe...
msgctxt "1995:225"
msgid "<$voicel(1,3)><$motion(1,807)><$comeff(1,4)>Ah, v-vale, no te preocupes... Cuando te venga bien."
msgstr "<$voicel(1,3)><$motion(1,807)><$comeff(1,4)>Ah, b-bueno, no te preocupes... Cuando puedas."

#. en: <oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,14)>My home could really use<br><iart;0()><$cdef(27)><fqty(1)><class><nquestitem;0></color>...
msgctxt "1995:226"
msgid "<oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,14)>Me gustaría tener<br><iart;0()><$cdef(27)><fqty(1)><class><nquestitem;0></color><slide><br>en mi casa y tal..."
msgstr "<oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,14)>Me gustaría tener<br><iart;0()><$cdef(27)><fqty(1)><class><nquestitem;0></color><slide><br>en mi casa..."

#. en: <$voicel(1,7)><$emotion(1,8)>Y-you set that up for me...? Oh, thank you so much!
msgctxt "1995:227"
msgid "<$voicel(1,7)><$emotion(1,8)>Ostras, n-no esperaba que fueras a hacerlo... Pues<br>gracias..."
msgstr "<$voicel(1,7)><$emotion(1,8)>Vaya, n-no esperaba que fueras a hacerlo... Pues<br>gracias..."

#. en: <$emotion(1,29)><$voicel(1,5)>Wait... Did you already make that place for me?
msgctxt "1995:232"
msgid "<$emotion(1,29)><$voicel(1,5)>Oh... No me digas que ya lo habías hecho..."
msgstr ""

#. en: <$voicel(1,5)><$motion(1,805)><$comeff(1,6)>Wait, hold on... Did you already set up what I wanted?
msgctxt "1995:233"
msgid "<$voicel(1,5)><$motion(1,805)><$comeff(1,6)>¿Eh? ¿Es que ya lo has hecho?"
msgstr "<$voicel(1,5)><$motion(1,805)><$comeff(1,6)>¿Eh? ¿Es que ya lo hiciste?"

#. en: <$voicel(1,5)><$motion(1,805)><$comeff(1,6)>Um...sorry if I’m wrong, but...did you already do that thing<br>for me?
msgctxt "1995:234"
msgid "<$voicel(1,5)><$motion(1,805)><$comeff(1,6)>¿Eh? ¿Soy yo o ya has completado lo que te he pedido?"
msgstr "<$voicel(1,5)><$motion(1,805)><$comeff(1,6)>¿Eh? ¿Soy yo o ya completaste lo que te pedí?"

#. en: <$voicel(1,5)><$emotion(1,14)>So um... I wanted to bring up something...<clear><br><$voicel(1,7)><$comeff(1,10)>I’ve been asking around to get some help with something,<br>and <$voicel(1,6)><$motion(1,805)><$comeff(1,6)>I was wondering if maybe you could give me a hand<slide><br>as well...?
msgctxt "1995:235"
msgid "<$voicel(1,5)><$emotion(1,14)>E-esto... Me sabe mal molestarte, pero...<clear><br><$voicel(1,7)><$comeff(1,10)>Ya les he pedido ayuda a los demás con un asuntillo,<br>pero me preguntaba si... tal vez...<clear><br><$voicel(1,6)><$motion(1,805)><$comeff(1,6)>¿Tal vez tú también podrías echarme una mano?"
msgstr "<$voicel(1,5)><$emotion(1,14)>E-esto... Me da pena molestarte, pero...<clear><br><$voicel(1,7)><$comeff(1,10)>Ya les pedí ayuda a los demás con un asuntito,<br>pero me preguntaba si... tal vez...<clear><br><$voicel(1,6)><$motion(1,805)><$comeff(1,6)>¿Tal vez tú también podrías echarme una mano?"

#. en: <$voicel(1,5)><$motion(1,805)><$comeff(1,14)>So um... That thing I was asking for help with...<$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,9)> Everyone<br>really came together and sorted it out for me!<clear><br><$voicel(1,6)><$emotion(1,39)>I’m glad I worked up the courage to actually ask...
msgctxt "1995:236"
msgid "<$voicel(1,5)><$motion(1,805)><$comeff(1,14)>Ah, por cierto, acerca del favor que te pedí antes...<br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>Ya me han ayudado a resolverlo.<clear><br><$voicel(1,6)><$emotion(1,39)>M-me alegro de haber sido capaz de pedir ayuda."
msgstr "<$voicel(1,5)><$motion(1,805)><$comeff(1,14)>Ah, por cierto, acerca del favor que te pedí antes...<br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>Ya me ayudaron a resolverlo.<clear><br><$voicel(1,6)><$emotion(1,39)>M-me alegro de haber sido capaz de pedir ayuda."

#. en: <$emotion(1,65)><$voicel(1,5)>C-could you build a new house around here, please? I bet<br>it would make everyone happy...<clear><br><$comeff(1,10)><$facial(1,4)><$motionoff(1,804)><$voicel(1,7)>Oh, and if you need any help building it, I’ll do my best!
msgctxt "1995:237"
msgid "<$emotion(1,65)><$voicel(1,5)>C-creo que a todos nos haría ilusión que construyeses<br>alguna casa humana... Si te va bien, claro.<clear><br><$comeff(1,10)><$facial(1,4)><$motionoff(1,804)><$voicel(1,7)>Yo te ayudo si hace falta, ¿vale?"
msgstr "<$emotion(1,65)><$voicel(1,5)>C-creo que a todos nos encantaría que construyeras<br>alguna casa humana... Si puedes, claro.<clear><br><$comeff(1,10)><$facial(1,4)><$motionoff(1,804)><$voicel(1,7)>Yo te ayudo si hace falta, ¿sí?"

#. en: <oneline><$comeff(1,9)><$motion(1,801)><$voicel(1,9)>Y-you made a house? Thank you so much,<br><$cdef(27)><pname;0></color>!
msgctxt "1995:238"
msgid "<oneline><$comeff(1,9)><$motion(1,801)><$voicel(1,9)>Has construido una casa humana... Jo, gracias,<br><$cdef(27)><pname;0></color>..."
msgstr "<oneline><$comeff(1,9)><$motion(1,801)><$voicel(1,9)>Construiste una casa humana... Ay, gracias,<br><$cdef(27)><pname;0></color>..."

#. en: <oneline><$comeff(1,6)><$motion(1,666)><$voicel(1,5)>I’d really like<br><iart;0()><$cdef(27)><fqty(1)><nquestitem;0></color>...<slide><br>Um...<slide><br>Y-you<slide><br>don’t<slide><br>have<slide><br>any,<slide><br>do you?
msgctxt "1995:239"
msgid "<oneline><$motion(1,666)><$voicel(1,5)>Me apetece<br><iart;0()><fqty(1)><$cdef(27)><class><nquestitem;0></color>...<slide><br><$comeff(1,6)>¿Tienes?"
msgstr "<oneline><$motion(1,666)><$voicel(1,5)>Me gustaría<br><iart;0()><fqty(1)><$cdef(27)><class><nquestitem;0></color>...<slide><br><$comeff(1,6)>¿Tienes?"

#. en: <oneline><$comeff(1,9)><$facial(1,4)><$motion(1,661)><$voicel(1,9)><$pkcry;0(1,2)>! ♪ Thanks so much,<br><$cdef(27)><pname;1></color>!
msgctxt "1995:240"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,661)><$voicel(1,9)>¡<fcap><$pkcry;0(1,2)>! ¡Gracias, <$cdef(27)><pname;1></color>!..."
msgstr ""

#. en: <$comeff(1,4)><$motion(1,807)><$voicel(1,7)>S-sorry, I guess...I should pay more attention to things, huh?<br>I’ll ask again if anything else comes up, OK?
msgctxt "1995:241"
msgid "<$comeff(1,4)><$motion(1,807)><$voicel(1,7)>P-perdona, tendría que haber mirado antes de pedirte<br>nada... Si necesito otra cosa, ¿me ayudarás?..."
msgstr ""

#. en: <$comeff(1,9)><$motion(1,801)><$voicel(1,9)>Th-thanks. This is a huge help!
msgctxt "1995:242"
msgid "<$comeff(1,9)><$motion(1,801)><$voicel(1,9)>¡Gracias! Me has hecho un favorazo..."
msgstr "<$comeff(1,9)><$motion(1,801)><$voicel(1,9)>¡Gracias! Me hiciste un favorazo..."

#. en: <$comeff(1,6)><$facial(1,1)><$motion(1,803)><$voicel(1,6)>Oh, um... H-have you made some already? I’d really<br>appreciate it if I could have some!
msgctxt "1995:243"
msgid "<$comeff(1,6)><$facial(1,1)><$motion(1,803)><$voicel(1,6)>¿Eh?... ¿Te has adelantado a mi petición? Entonces...<br>¿tienes para darme?"
msgstr "<$comeff(1,6)><$facial(1,1)><$motion(1,803)><$voicel(1,6)>¿Eh?... ¿Te adelantaste a mi petición? Entonces...<br>¿tienes para darme?"

#. en: <oneline><$comeff(1,9)><$facial(1,4)><$motion(1,661)><$voicel(1,9)><$pkcry;0(1,2)>! ♪ Thanks so much,<br><$cdef(27)><pname;1></color>!
msgctxt "1995:244"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,661)><$voicel(1,9)>¡<fcap><$pkcry;0(1,2)>! Gracias, <$cdef(27)><pname;1></color>."
msgstr ""

#. en: <$voicel(1,7)><$motion(1,803)><$comeff(1,21)><$facial(1,4)>You’re really helping make things more pleasant around<br>here, <$cdef(27)><pname;0></color>.<slide><br><$voicel(1,10)><$emotion(1,8)>Here, you can have this—as thanks!
msgctxt "1995:301"
msgid "<$cdef(27)><$voicel(1,7)></color><$motion(1,803)><$comeff(1,21)><$facial(1,4)>Me da la impresión de que, gracias a ti, aquí se vive<br>mucho mejor que antes... <$voicel(1,10)><$emotion(1,8)>T-toma, te lo has ganado..."
msgstr "<$cdef(27)><$voicel(1,7)></color><$motion(1,803)><$comeff(1,21)><$facial(1,4)>Me da la impresión de que, gracias a ti, aquí se vive<br>mucho mejor que antes... <$voicel(1,10)><$emotion(1,8)>T-toma, te lo ganaste..."

#. en: <$comeff(1,14)><$facial(1,1)><$motion(1,805)><$voicel(1,4)>Ack... There are a lot of Pokémon with you, huh?<br><$comeff(1,4)><$facial(1,1)><$motion(1,807)><$voicel(1,3)>S-sorry—it’s making me kinda nervous... Maybe I’ll join you<slide><br>some other time...
msgctxt "1995:302"
msgid "<$comeff(1,14)><$facial(1,1)><$motion(1,805)><$voicel(1,4)>Uf, hay muchos Pokémon contigo... <$comeff(1,4)><$facial(1,1)><$motion(1,807)><$voicel(1,3)>Me estoy poniendo<br>nervios<gen;-3(o,a)>, así que ven a buscarme más tarde..."
msgstr ""

#. en: <$comeff(1,7)><$motion(1,802)><$voicel(1,3)>Um... A-actually right now’s not really a good time...<br>Appreciate the invite, though, really!
msgctxt "1995:303"
msgid "<$comeff(1,7)><$motion(1,802)><$voicel(1,3)>Erm, es que... ahora me viene un poco mal... ¡P-pero te<br>agradezco mucho la invitación! Perdona, eh..."
msgstr "<$comeff(1,7)><$motion(1,802)><$voicel(1,3)>Erm, es que... ahora no es buen momento... ¡P-pero te<br>agradezco mucho la invitación! Perdona, eh..."

#. en: <$voicel(1,5)><$comeff(1,17)>Whew...<wait(0.8)><$motion(1,801)><$facial(1,4)><$comeff(1,21)><$cdef(27)><fcap><$spwfull(1)>ing</color> is more fun than I thought!
msgctxt "1995:304"
msgid "<$voicel(1,5)><$comeff(1,17)>Uf... Estoy hech<gen;-3(o,a)> polvo...<wait(0.8)> <$motion(1,801)><$facial(1,4)><$comeff(1,21)>Aunque lo de <$cdef(27)><$spwfull(1)></color><br>tiene su encanto..."
msgstr "<$voicel(1,5)><$comeff(1,17)>Uf... Estoy agotad<gen;-3(o,a)>...<wait(0.8)> <$motion(1,801)><$facial(1,4)><$comeff(1,21)>Aunque lo de <$cdef(27)><$spwfull(1)></color><br>tiene su encanto..."

#. en: <$emotion(1,50)><$voicel(1,6)>OK, I’ll follow you!
msgctxt "1995:305"
msgid "<$emotion(1,50)><$voicel(1,6)>¡V-venga, yo te sigo!"
msgstr "<$emotion(1,50)><$voicel(1,6)>¡V-vamos, yo te sigo!"

#. en: <$voicel(1,5)><$emotion(1,14)>Is this it? Well, OK... I guess... I guess I’ll see you around.
msgctxt "1995:306"
msgid "<$voicel(1,5)><$emotion(1,14)>¿Se acabó? Vale... nos vemos..."
msgstr "<$voicel(1,5)><$emotion(1,14)>¿Se acabó? Bueno... nos vemos..."

#. en: <$voicel(1,1)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>I’m really sorry... I’d love to tag along, but I’m just<br>so hungry...
msgctxt "1995:307"
msgid "<$voicel(1,1)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>Jo, lo siento, me encantaría ir, pero es que me muero<br>de hambre..."
msgstr "<$voicel(1,1)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>Ay, lo siento, me encantaría ir, pero es que me muero<br>de hambre..."

#. en: <$voicel(1,1)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>Too hungry... Can’t go any further... S-sorry...
msgctxt "1995:308"
msgid "<$voicel(1,1)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>Me sabe fatal, ¿eh? Pero, jo, es que no puedo dar un paso<br>más... Tengo demasiada hambre... Lo siento..."
msgstr "<$voicel(1,1)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>Me siento mal, ¿eh? Pero, ay, es que no puedo dar un paso<br>más... Tengo demasiada hambre... Lo siento..."

#. en: <$voicel(1,1)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>I really don’t wanna get soaked... Maybe I should<br>head home...
msgctxt "1995:311"
msgid "<$voicel(1,1)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>Jo, la lluvia no me gusta nada... Creo que me voy a volver<br>a casa."
msgstr "<$voicel(1,1)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>Ay, la lluvia no me gusta nada... Creo que me voy a volver<br>a casa."

#. en: <$voicel(1,3)><$motion(1,803)><$comeff(1,5)><$facial(1,13)><$pkcry;0(1,2)>?! Y-you surprised me...
msgctxt "1995:315"
msgid "<$voicel(1,3)><$motion(1,803)><$comeff(1,5)><$facial(1,13)>¡¿<$pkcry;0(1,2)>?! M-menudo susto..."
msgstr "<$voicel(1,3)><$motion(1,803)><$comeff(1,5)><$facial(1,13)>¡¿<$pkcry;0(1,2)>?! Q-qué susto..."

#. en: <oneline><$voicel(1,7)><$emotion(1,8)>I really like this<br><$cdef(27)><fqty(1)><class><aireactp;0></color>!<clear><br><$voicel(1,5)><$motion(1,803)><$facial(1,1)><$comeff(1,14)>Just...do you think you could maybe bring it a bit closer<br>to my home...?<$voicel(1,8)><$motion(1,805)> I’d be really grateful...
msgctxt "1995:317"
msgid "<oneline><$voicel(1,7)><$emotion(1,8)><oneline>Est<genqty;0(e,a,os,as)> <$cdef(27)><fqty(1)><aireactp;0> </color><qty;0(es,son)> genia<qty;0(l,les)>,<br>la verdad, pero...<clear><br><$voicel(1,5)><$motion(1,803)><$facial(1,1)><$comeff(1,14)>Me vendría mejor si pudieses colocarl<genqty;0(o,a,os,as)> en mi casa...<br><$voicel(1,8)><$motion(1,805)>Bueno, solo si puedes..."
msgstr "<oneline><$voicel(1,7)><$emotion(1,8)><oneline>Est<genqty;0(e,a,os,as)> <$cdef(27)><fqty(1)><aireactp;0> </color><qty;0(es,son)> genia<qty;0(l,les)>,<br>la verdad, pero...<clear><br><$voicel(1,5)><$motion(1,803)><$facial(1,1)><$comeff(1,14)>Me vendría mejor si pudieras colocarl<genqty;0(o,a,os,as)> en mi casa...<br><$voicel(1,8)><$motion(1,805)>Bueno, solo si puedes..."

#. en: <oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Wow... <fcap><iart;0()><$cdef(27)><fqty(1)><class><aireactp;0></color>!<br>Thanks<slide><br>so<slide><br>much<slide><br>for<slide><br>bringing<slide><br>that here...
msgctxt "1995:318"
msgid "<oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Halaaa... M-muchas gracias por colocarme<br><iart;0()><$cdef(27)><fqty(1)><class><aireactp;0></color>."
msgstr "<oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Guaaau... M-muchas gracias por colocarme<br><iart;0()><$cdef(27)><fqty(1)><class><aireactp;0></color>."

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)><$pkcry;0(1,2)>... ♪ This is so soothing...
msgctxt "1995:319"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>♪<$pkcry;0(1,2)>.♪ Qué bien sienta..."
msgstr ""

#. en: <$voicel(1,5)><$motion(1,805)><$comeff(1,6)><$pkcry;0(1,3)>? Uuuh... What was that all about...?
msgctxt "1995:320"
msgid "<$voicel(1,5)><$motion(1,805)><$comeff(1,6)>¿<$pkcry;0(1,3)>? ¿P-pero y eso?"
msgstr ""

#. en: <oneline><$voicel(1,3)><$motion(1,803)><$facial(1,9)><$comeff(1,7)><$pkcry;0(1,4)>...<clear><br>My <$cdef(27)><fqty(1)><class><aireactp;1></color>... It’s<br>gone...
msgctxt "1995:322"
msgid "<oneline><$voicel(1,3)><$motion(1,803)><$facial(1,9)><$comeff(1,7)><oneline><$pkcry;0(1,4)>... Qué raro, ¿dónde estar<qty;1(á,án)> <qty;1(mi,mis)><br><$cdef(27)><fqty(1)><aireactp;1></color>?"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,39)>My home’s nice and warm now. This is just how I like it...
msgctxt "1995:323"
msgid "<$voicel(1,7)><$emotion(1,39)>Qué calorcito... Creo que ahora se está mucho mejor aquí."
msgstr ""

#. en: <$voicel(1,3)><$motion(1,807)><$comeff(1,4)>My home’s so hot... I hope things cool down soon...
msgctxt "1995:324"
msgid "<$voicel(1,3)><$motion(1,807)><$comeff(1,4)>Me parece que hace un poco de calor en casa...<br>Espero que refresque pronto..."
msgstr ""

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Whew... My home’s nice and cool. It’s really refreshing...
msgctxt "1995:325"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Fiu... Ahora que hace más fresquito aquí en casa,<br>se está de maravilla, ¿no?"
msgstr ""

#. en: <$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,23)>It’s gotten s-s-so c-c-c-c-cold around my home...<br>G-g-gotta think warm thoughts... Brrr...
msgctxt "1995:326"
msgid "<$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,23)>T-tengo la sensación de que ahora hace más f-f-frío<br>en casa, y... ¡Brrr! M-me está costando adaptarme..."
msgstr ""

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>My home’s got some nice light! It helps me feel relaxed...
msgctxt "1995:327"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>Ahora que hay más luz en casa, me resulta más fácil<br>relajarme..."
msgstr ""

#. en: <$voicel(1,3)><$motion(1,805)><$facial(1,9)><$comeff(1,7)>Uuugh... It’s so bright in my home now...<$voicel(1,1)><$motion(1,807)><$comeff(1,17)> It’s a bit too<br>much for me...
msgctxt "1995:328"
msgid "<$voicel(1,3)><$motion(1,805)><$facial(1,9)><$comeff(1,7)>Oh, no... Hay mucha luz en casa, casi que demasiada...<br><wait(0.4)><$voicel(1,1)><$motion(1,807)><$comeff(1,17)>C-creo que no lo llevo demasiado bien..."
msgstr ""

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>My home’s gotten darker, but... If I’m being honest,<br>I prefer this to it being too bright...
msgctxt "1995:329"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>He notado que mi casa está algo más oscura ahora...<br>Diría que lo prefiero a que haya demasiada luz."
msgstr ""

#. en: <$voicel(1,3)><$motion(1,805)><$comeff(1,7)>It’s so dark in my home... Are...are you OK with it being<br>so gloomy...?
msgctxt "1995:330"
msgid "<$voicel(1,3)><$motion(1,805)><$comeff(1,7)>¿No crees que hay muy poca luz? ¿A ti no te molesta?"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,8)>It’s nice and moist in my home... It makes me happy!<br><$pkcry;1(1,2)>! ♪
msgctxt "1995:331"
msgid "<$voicel(1,7)><$emotion(1,8)>Mi casa tiene ahora el grado de humedad perfecto.<br>♪<$pkcry;1(1,2)>.♪"
msgstr ""

#. en: <$comeff(1,19)><$voicel(1,3)><$motion(1,802)><$facial(1,9)>Is it me, or is it kinda muggy around here? I wish it was a<br>bit drier.
msgctxt "1995:332"
msgid "<$comeff(1,19)><$voicel(1,3)><$motion(1,802)><$facial(1,9)>¿Es mi imaginación o hay demasiada humedad por aquí?<br>Ay, a ver si mejora un poco..."
msgstr ""

#. en: <$voicel(1,7)><$motion(1,803)><$comeff(1,14)>The mugginess is gone! It’s definitely more<br>refreshing now.<clear><br><$comeff(1,13)><$voicel(1,9)><$facial(1,4)><$motion(1,801)>Just feel that breeze!
msgctxt "1995:333"
msgid "<$voicel(1,7)><$motion(1,803)><$comeff(1,14)>Ahora que ha bajado la humedad, hay un ambiente<br>mucho más agradable... <$comeff(1,13)><$voicel(1,9)><$facial(1,4)><$motion(1,801)>Se respira mejor... Je..."
msgstr ""

#. en: <$comeff(1,19)><$voicel(1,3)><$motion(1,802)><$facial(1,9)><$pkcry;0(1,4)>! It’s so dry here... I think the air needs a<br>bit more moisture.
msgctxt "1995:334"
msgid "<$comeff(1,19)><$voicel(1,3)><$motion(1,802)><$facial(1,9)>Noto el aire un poco seco por aquí, <flow><$pkcry;0(1,4)>...<clear><br>Creo que no hay suficiente humedad. Aunque tal vez<br>me equivoque..."
msgstr ""

#. en: <oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,14)>The thing you placed for me is just ahead, but <$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,17)>I don’t think<br>I can get through here...<clear><br><$voicel(1,5)><$motion(1,803)><$facial(1,1)><$comeff(1,3)>I’m really sorry, <$cdef(27)><pname;2></color>, but do you<br>think<slide><br>you<slide><br>could<slide><br>clear<slide><br>out<slide><br>the<slide><br>path<slide><br>for me...?
msgctxt "1995:335"
msgid "<$voicel(1,5)><$motion(1,805)><$comeff(1,14)>Jolín, con lo cerca que está lo que me has traído y...<br><wait(0.4)><$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,17)>no tengo forma de ir...<clear><br><$voicel(1,5)><$motion(1,803)><$facial(1,1)><$comeff(1,3)>¿Quizá podrías despejar el camino para que pueda llegar?<br>Porfa, <$cdef(27)><pname;2></color>..."
msgstr "<$voicel(1,5)><$motion(1,805)><$comeff(1,14)>Ay, con lo cerca que está lo que me trajiste y...<br><wait(0.4)><$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,17)>no tengo forma de ir...<clear><br><$voicel(1,5)><$motion(1,803)><$facial(1,1)><$comeff(1,3)>¿Tal vez podrías despejar el camino para que pueda llegar?<br>Porfa, <$cdef(27)><pname;2></color>..."

#. en: <$voicel(1,8)><$motion(1,803)><$comeff(1,10)>I-I’ll do my best!
msgctxt "1995:336"
msgid "<$voicel(1,8)><$motion(1,803)><$comeff(1,10)>Bueno... ¡A ver qué tal se me da!"
msgstr ""

#. en: <$voicel(1,5)><$motion(1,805)><$comeff(1,6)>I feel like something’s different about this spot... Why<br>don’t you have a look, <$cdef(27)><pname;0></color>?
msgctxt "1995:337"
msgid "<$voicel(1,5)><$motion(1,805)><$comeff(1,6)>¿No te parece que aquí hay algo? ¿Quizá podrías mirar<br>a ver?"
msgstr "<$voicel(1,5)><$motion(1,805)><$comeff(1,6)>¿No te parece que aquí hay algo? ¿Quizás podrías<br>revisar?"

#. en: <$voicel(1,5)><$emotion(1,14)>This is getting demolished really quickly, isn’t it? Almost<br>in the blink of an eye, it feels like...
msgctxt "1995:338"
msgid "<$voicel(1,5)><$emotion(1,14)>Yo creo que la demolición avanza a buen ritmo...<br>Seguramente terminaremos pronto."
msgstr ""

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)><$pkcry;0(1,2)>! ♪This smells amazing! I can’t wait...
msgctxt "1995:339"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)><$pkcry;0(1,2)>... Qué bien huele... Y qué hambre me<br>está entrando."
msgstr ""

#. en: <$voicel(1,8)><$emotion(1,8)>Wow, it sure is lively here...
msgctxt "1995:340"
msgid "<$voicel(1,8)><$emotion(1,8)>Uf, si hay un montón de gente..."
msgstr ""

#. en: <$voicel(1,8)><$motion(1,805)><$facial(1,14)><$comeff(1,16)>It’s so nice and warm... It’s making me sleepy...
msgctxt "1995:341"
msgid "<$voicel(1,8)><$motion(1,805)><$facial(1,14)><$comeff(1,16)>Jo, estoy tan a gustito que me voy a quedar sopa..."
msgstr "<$voicel(1,8)><$motion(1,805)><$facial(1,14)><$comeff(1,16)>Ay, estoy tan a gustito que me voy a dormir..."

#. en: <oneline><$comeff(1,14)><$facial(1,9)><$motion(1,666)><$voicel(1,5)>So I was thinking... M-maybe the<br><fqty(1)><class><$cdef(27)><aireactp;0></color><slide><br>would<slide><br>be<slide><br>easier<slide><br>to<slide><br>use<slide><br>in<slide><br>a<slide><br>place<slide><br>where<slide><br>there’s<slide><br>no water...<clear><br><$emotion(1,58)><$voicel(1,3)>I guess...what I’m asking is, d’you think you could move it<br>for me? I’d be really grateful...
msgctxt "1995:343"
msgid "<oneline><$comeff(1,14)><$facial(1,9)><$motion(1,666)><$voicel(1,5)>O-oye, <dart;0()><$cdef(27)><fqty(1)><aireactp;0></color> sería más<br>fácil usar<genqty;0(lo,la,los,las)><slide><br>en un sitio<slide><br>con menos agua, ¿no?<clear><br><$emotion(1,58)><$voicel(1,3)>Entonces... estooo... si no te importa, ¿puedes mover<genqty;0(lo,la,los,las)><br>a otra parte?"
msgstr "<oneline><$comeff(1,14)><$facial(1,9)><$motion(1,666)><$voicel(1,5)>O-oye, <dart;0()><$cdef(27)><fqty(1)><aireactp;0></color> sería más<br>fácil usar<genqty;0(lo,la,los,las)><slide><br>en un lugar<slide><br>con menos agua, ¿no?<clear><br><$emotion(1,58)><$voicel(1,3)>Entonces... estooo... si no te importa, ¿puedes mover<genqty;0(lo,la,los,las)><br>a otra parte?"

#. en: <$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Thanks for tidying things up! My home’s so<br>comfortable now...
msgctxt "1995:344"
msgid "<$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Gracias por encargarte... Ahora estoy más a gusto."
msgstr ""

#. en: <$comeff(1,3)><$facial(1,1)><$motion(1,805)><$voicel(1,7)>The area around my home is really improving... D-do<br>you think you can keep going?
msgctxt "1995:345"
msgid "<$comeff(1,3)><$facial(1,1)><$motion(1,805)><$voicel(1,7)>La zona de mi casa ha mejorado mucho... Si pudieras<br>seguir mejorándola como hasta ahora, estaría genial..."
msgstr "<$comeff(1,3)><$facial(1,1)><$motion(1,805)><$voicel(1,7)>La zona de mi casa mejoró mucho... Si pudieras<br>seguir mejorándola como hasta ahora, estaría genial..."

#. en: <$comeff(1,6)><$facial(1,1)><$motion(1,661)><$voicel(1,5)>Um, hi... D-do you maybe wanna go on a treasure hunt<br>with me?<clear><br><$comeff(1,14)><$facial(1,14)><$motion(1,666)><$voicel(1,7)>I just thought...it’d be kinda fun to play with the<br><$cdef(27)><fqty(1)><$ifull(2793)></color>, you know?
msgctxt "1995:400"
msgid "<$facial(1,1)><$motion(1,661)><$voicel(1,5)>P-perdona, <$comeff(1,6)>¿querrías ir a buscar tesoros conmigo?...<br>Solo si te apetece...<clear><br><$comeff(1,14)><$facial(1,14)><$motion(1,666)><$voicel(1,7)>Es que estaba pensando que sería divertido buscarlos<br>con el <$cdef(27)><fqty(1)><$ifull(2793)></color>, y pasar el rato tú y yo..."
msgstr "<$facial(1,1)><$motion(1,661)><$voicel(1,5)>P-perdona, <$comeff(1,6)>¿querrías ir a buscar tesoros conmigo?...<br>Solo si quieres...<clear><br><$comeff(1,14)><$facial(1,14)><$motion(1,666)><$voicel(1,7)>Es que estaba pensando que sería divertido buscarlos<br>con el <$cdef(27)><fqty(1)><$ifull(2793)></color>, y pasar el rato tú y yo..."

#. en: <oneline><$voicel(1,5)><$emotion(1,14)>Oh, hi there, <$cdef(27)><pname;0></color>. Do you think<br>the<slide><br>path’s<slide><br>ready<slide><br>for<slide><br>me<slide><br>to<slide><br>go through...?
msgctxt "1995:402"
msgid "<$voicel(1,5)><$emotion(1,14)>¿Ya se puede pasar, <$cdef(27)><pname;0></color>?"
msgstr ""

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,1)>Yes! Then, um, do you mind coming with me...?
msgctxt "1995:403"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,1)>¡Muchas gracias! ¿Podrías venir conmigo por si acaso?"
msgstr ""

#. en: <$voicel(1,5)><$emotion(1,14)>Oh, OK... Just let me know when it’s ready!
msgctxt "1995:404"
msgid "<$voicel(1,5)><$emotion(1,14)>A-ah, v-vale... Avísame cuando esté."
msgstr "<$voicel(1,5)><$emotion(1,14)>A-ah, b-bueno... Avísame cuando esté."

#. en: <$voicel(1,3)><$motion(1,805)><$comeff(1,14)><$pkcry;0(1,4)>... I still don’t think I can make it through.<clear><br><$voicel(1,5)><$motion(1,803)><$comeff(1,6)>The path still needs to be a bit more tidy... C-could you<br>do that for me...?
msgctxt "1995:405"
msgid "<$voicel(1,3)><$motion(1,805)><$comeff(1,14)><$pkcry;0(1,4)>... Yo creo que todavía no puedo pasar...<clear><br><$voicel(1,5)><$motion(1,803)><$comeff(1,6)>¿Te importaría arreglar un poco más el camino, porfa?"
msgstr ""

#. en: <oneline><$comeff(1,7)><$motion(1,805)><$voicel(1,3)>I can’t keep going... Do you think you can fix this,<br><$cdef(27)><pname;0></color>?
msgctxt "1995:408"
msgid "<oneline><$comeff(1,7)><$motion(1,805)><$voicel(1,3)>No puedo pasar... <$cdef(27)><pname;0></color>, ¿te importa<br>encargarte de esto?"
msgstr ""

#. en: <oneline><$voicel(1,5)><$emotion(1,14)>Your friend <$cdef(27)><wowner;0> </color>lives around<br>here, right?<clear><br><$voicel(1,7)><$motion(1,805)><$facial(1,4)><$comeff(1,14)>Do you think I’ll run into them if I hang around?<br>I’d like to be friends with them too...
msgctxt "1995:409"
msgid "<$voicel(1,5)><$emotion(1,14)>Tu amig<gen;0(o,a)> <$cdef(27)><wowner;0></color> vivía por aquí, ¿no?<clear><br><$voicel(1,7)><$motion(1,805)><$facial(1,4)><$comeff(1,14)>¿C-crees que se pasará a saludar? Me gustaría<br>presentarme..."
msgstr ""

#. en: <$comeff(1,3)><$motion(1,803)><$voicel(1,5)>OK... In that case, I guess I’ll head home for now...
msgctxt "1995:410"
msgid "<$comeff(1,3)><$motion(1,803)><$voicel(1,5)>Vaya... Pues tendré que dar media vuelta e irme a casa..."
msgstr ""

#. en: <$voicel(1,6)><$motion(1,805)><$comeff(1,6)>Hey, what do you have there...?
msgctxt "1995:411"
msgid "<$voicel(1,6)><$motion(1,805)><$comeff(1,6)>¿Qué es eso que llevas?"
msgstr ""

#. en: <$voicel(1,4)><$motion(1,807)><$facial(1,9)><$comeff(1,17)>Oh, right, yeah... That figures...
msgctxt "1995:412"
msgid "<$voicel(1,4)><$motion(1,807)><$facial(1,9)><$comeff(1,17)>Ah, bueno..."
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,39)>Wait...really? Wow, thank you!
msgctxt "1995:413"
msgid "<$voicel(1,7)><$emotion(1,39)>¡¿Eh?! Ay, ¡qué alegría! ¡G-gracias!"
msgstr ""

#. en: <oneline><$comeff(1,5)><$facial(1,1)><$motion(1,661)><$voicel(1,8)>Oh, hey, that’s...that’s<br><iart;0()><$cdef(27)><fqty(1)><class><refmateid;0></color>...
msgctxt "1995:414"
msgid "<oneline><$comeff(1,5)><$facial(1,1)><$motion(1,661)><$voicel(1,8)>Ah,<br><iart;0()><$cdef(27)><fqty(1)><class><refmateid;0></color>..."
msgstr ""

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>So...we’re going treasure hunting...? I-I’ll do my best!
msgctxt "1995:415"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>Me voy a esforzar un montón en encontrar muchos<br>tesoros, ya verás..."
msgstr ""

#. en: <$voicel(1,7)><$motion(1,803)><$comeff(1,3)><$facial(1,4)>So, um... Well... I-I just wanted to say thank you for, like...<br>always being nice to me...<clear><br><$voicel(1,10)><$emotion(1,39)>H-here, this is for you. You can have it.
msgctxt "1995:416"
msgid "<$voicel(1,7)><$motion(1,803)><$comeff(1,3)><$facial(1,4)>Esto... Verás... Quería darte las gracias por estar siempre<br>ahí pendiente de mí.<clear><br><$voicel(1,10)><$emotion(1,39)>T-toma, para ti."
msgstr ""

#. en: <$voicel(1,9)><$emotion(1,7)>I’m so glad we get to be friends... I hope we can stay great<br>friends from now on!
msgctxt "1995:417"
msgid "<$voicel(1,9)><$emotion(1,7)>Jo, no sabes lo feliz que me hace poder ser amig<gen;-3(o,a)> tuy<gen;-3(o,a)>.<br>¡Espero que podamos seguir llevándonos tan bien!"
msgstr "<$voicel(1,9)><$emotion(1,7)>Ay, no sabes lo feliz que me hace poder ser amig<gen;-3(o,a)> tuy<gen;-3(o,a)>.<br>¡Espero que podamos seguir llevándonos tan bien!"

#. en: <$voicel(1,10)><$emotion(1,8)>Wow...we did it!<clear><br><$voicel(1,7)><$motion(1,803)><$comeff(1,21)>I’m glad I was able to help! Let’s do this again sometime!
msgctxt "1995:418"
msgid "<$voicel(1,10)><$emotion(1,8)>¡Qué suerte!<clear><br><$voicel(1,7)><$motion(1,803)><$comeff(1,21)>Me alegro de que la búsqueda de tesoros haya ido bien.<br>A-avísame para la próxima, si quieres y eso."
msgstr "<$voicel(1,10)><$emotion(1,8)>¡Qué suerte!<clear><br><$voicel(1,7)><$motion(1,803)><$comeff(1,21)>Me alegro de que la búsqueda de tesoros haya ido bien.<br>A-avísame para la próxima, si quieres."

#. en: <$voicel(1,7)><$emotion(1,6)>Oh wow... This is one of my favorite things! Thank you<br>so much, <$cdef(27)><pname;1></color>!
msgctxt "1995:419"
msgid "<$voicel(1,7)><$emotion(1,6)>Jo, me encanta. Gracias, <$cdef(27)><pname;1></color>..."
msgstr "<$voicel(1,7)><$emotion(1,6)>Ay, me encanta. Gracias, <$cdef(27)><pname;1></color>..."

#. en: <$comeff(1,14)><$facial(1,1)><$motion(1,805)><$voicel(1,5)>There’s a place I want to visit over that way, but...
msgctxt "1995:420"
msgid "<$comeff(1,14)><$facial(1,1)><$motion(1,805)><$voicel(1,5)>Hay un lugar... al que querría ir, en esa dirección..."
msgstr ""

#. en: <oneline><$voicel(1,3)><$motion(1,805)><$comeff(1,14)>Oh... I’m sorry, <$cdef(27)><pname;0></color>... I kinda want<br>to<slide><br>hang<slide><br>out<slide><br>here<slide><br>a<slide><br>little longer...<clear><br><$voicel(1,6)><$emotion(1,14)>I guess...I’ll see you later?
msgctxt "1995:421"
msgid "<oneline><$voicel(1,3)><$motion(1,805)><$comeff(1,14)>Lo siento, <$cdef(27)><pname;0></color>, pero creo que<br>prefiero quedarme<slide><br>por aquí...<clear><br><$voicel(1,6)><$emotion(1,14)>¿Te importa si nos vemos luego, mejor?"
msgstr ""

#. en: <$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,3)>The path there is so hard to get through...
msgctxt "1995:422"
msgid "<$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,3)>Pero es que... el camino que va hacia allí está un poco<br>mal ahora mismo y... cuesta pasar."
msgstr "<$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,3)>Pero es que... el camino que va hacia allá está un poco<br>mal ahora mismo y... cuesta pasar."

#. en: <$voicel(1,3)><$motion(1,807)><$comeff(1,4)>Uhhh... I think this house is too small for me... If you could<br>make it a bit bigger, I’d really appreciate it.
msgctxt "1995:426"
msgid "<$voicel(1,3)><$motion(1,807)><$comeff(1,4)>C-creo que esta casa me viene un poco pequeña...<br>¿M-me podrías preparar una más grande?"
msgstr "<$voicel(1,3)><$motion(1,807)><$comeff(1,4)>C-creo que esta casa me queda un poco pequeña...<br>¿M-me podrías preparar una más grande?"

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Wow... That’s a really impressive house!
msgctxt "1995:427"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Halaaa... Esta casa humana es increíble..."
msgstr "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Guaaau... Esta casa humana es increíble..."

#. en: <$voicel(1,9)><$emotion(1,8)>R-really? Are you sure...? Wow, thank you!
msgctxt "1995:428"
msgid "<$voicel(1,9)><$emotion(1,8)>¿Eh? ¿L-lo dices en serio? G-gracias..."
msgstr ""

#. en: <oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Yeah, it’s amazing! You really are something else,<br><$cdef(27)><pname;0></color>...<slide><br>I<slide><br>wish<slide><br>I<slide><br>could<slide><br>be<slide><br>more<slide><br>like you...
msgctxt "1995:429"
msgid "<oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>¡Sí! Te ha quedado genial, <$cdef(27)><pname;0></color>.<br>Eres increíble..."
msgstr "<oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>¡Sí! Te quedó genial, <$cdef(27)><pname;0></color>.<br>Eres increíble..."

#. en: <$voicel(1,7)><$motion(1,805)><$facial(1,4)><$comeff(1,6)>Wait, really?! Can I really move into this house...?
msgctxt "1995:430"
msgid "<$voicel(1,7)><$motion(1,805)><$facial(1,4)><$comeff(1,6)>¿Eh? ¿S-seguro que no te importa que me mude aquí?..."
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,8)>Wow, that’s amazing... I can’t wait to live here!
msgctxt "1995:431"
msgid "<$voicel(1,7)><$emotion(1,8)>Gracias... Qué ganas tengo de instalarme."
msgstr ""

#. en: <$voicel(1,5)><$motion(1,805)><$comeff(1,6)>Sure, OK. So, where d’you wanna go next...?
msgctxt "1995:432"
msgid "<$voicel(1,5)><$motion(1,805)>Ah, vale, lo entiendo. Esto... <$comeff(1,6)>¿Ahora adónde vamos?"
msgstr "<$voicel(1,5)><$motion(1,805)>Ah, bueno, lo entiendo. Esto... <$comeff(1,6)>¿Ahora adónde vamos?"

#. en: <$voicel(1,5)><$emotion(1,14)>So um... I th-think this place is already maxed out...<br><$voicel(1,4)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>Pretty sure it won’t fit another Pokémon...<clear><br><$voicel(1,6)><$motion(1,805)><$comeff(1,6)><$facial(1,1)>M-maybe you could show me another house?
msgctxt "1995:433"
msgid "<$voicel(1,5)><$emotion(1,14)>E-es que... viendo el espacio que hay aquí... <$voicel(1,4)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>yo diría que<br>ya no cabe nadie más...<clear><br><$voicel(1,6)><$motion(1,805)><$comeff(1,6)><$facial(1,1)>¿Te importa enseñarme algún otro lugar?"
msgstr ""

#. en: <oneline><$voicel(1,9)><$emotion(1,8)><$pkcry;0(1,2)>! ♪ Yay, we found some treasure!<clear><br><$voicel(1,7)><$motion(1,803)><$comeff(1,10)>You’re really good at this, aren’t you,<br><$cdef(27)><pname;1></color>?<slide><br>Let’s<slide><br>go<slide><br>treasure<slide><br>hunting<slide><br>together<slide><br>again<slide><br>sometime!
msgctxt "1995:434"
msgid "<oneline><$voicel(1,9)><$emotion(1,8)>¡<$pkcry;0(1,2)>! La búsqueda ha ido genial.<clear><br><$voicel(1,7)><$motion(1,803)><$comeff(1,10)>S-seguro que es porque ibas tú conmigo,<br><$cdef(27)><pname;1></color>.<clear><br>M-me encantaría volver a buscar tesoros algún otro día."
msgstr "<oneline><$voicel(1,9)><$emotion(1,8)>¡<$pkcry;0(1,2)>! La búsqueda salió genial.<clear><br><$voicel(1,7)><$motion(1,803)><$comeff(1,10)>S-seguro que es porque ibas tú conmigo,<br><$cdef(27)><pname;1></color>.<clear><br>M-me encantaría volver a buscar tesoros algún otro día."

#. en: <oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,6)>Hey, what’s that you have, <$cdef(27)><pname;0></color>...?<br>It’s<slide><br>so<slide><br>shiny...<slide><br>I<slide><br>think<slide><br>it’s pretty.
msgctxt "1995:435"
msgid "<oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,6)>Anda, ¿llevas algo ahí, <$cdef(27)><pname;0></color>?<br>Cómo brilla... Parece muy bonito."
msgstr "<oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,6)>Vaya, ¿llevas algo ahí, <$cdef(27)><pname;0></color>?<br>Cómo brilla... Parece muy bonito."

#. en: <$voicel(1,9)><$emotion(1,39)>Huh? Is this for me...? Oh wow, thank you!<clear><br><$voicel(1,8)><$motion(1,803)><$comeff(1,9)>Um, here... You can have this! You know, as a thank you...
msgctxt "1995:436"
msgid "<$voicel(1,9)><$emotion(1,39)>¡¿E-eh?! ¿Para mí? ¿E-en serio?<clear><br><$voicel(1,8)><$motion(1,803)><$comeff(1,9)>Ay, jo, muchas gracias... Toma, aquí tienes esto a cambio."
msgstr "<$voicel(1,9)><$emotion(1,39)>¡¿E-eh?! ¿Para mí? ¿E-en serio?<clear><br><$voicel(1,8)><$motion(1,803)><$comeff(1,9)>Ay, muchas gracias... Toma, aquí tienes esto a cambio."

#. en: <$voicel(1,5)><$motion(1,807)><$comeff(1,3)>Oh, no no, I don’t need it! Honestly!<clear><br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>I’m sure there’s another Pokémon out there who wants it<br>way more than I do.
msgctxt "1995:437"
msgid "<$voicel(1,5)><$motion(1,807)><$comeff(1,3)>Ay, mejor no lo malgastes conmigo...<clear><br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Habrá alguien a quien le haga mucha más ilusión, ¿no?"
msgstr "<$voicel(1,5)><$motion(1,807)><$comeff(1,3)>Ay, mejor no lo malgastes conmigo...<clear><br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Habrá alguien que lo quiera mucho más, ¿no?"

#. en: <oneline><$voicel(1,3)><$motion(1,805)><$comeff(1,14)>Oh, um... I’m good for now, I guess. Sorry,<br><$cdef(27)><pname;0></color>...<clear><br><$voicel(1,5)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>I appreciate you thinking about me, I really do, but I don’t<br>think I can put it to good use right now...
msgctxt "1995:438"
msgid "<oneline><$voicel(1,3)><$motion(1,805)><$comeff(1,14)>Ay, gracias, <$cdef(27)><pname;0></color>,<br>pero quizá es mejor<slide><br>que te lo quedes.<clear><br><$voicel(1,5)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>Es que creo que ahora no le daría mucho uso..."
msgstr "<oneline><$voicel(1,3)><$motion(1,805)><$comeff(1,14)>Ay, gracias, <$cdef(27)><pname;0></color>,<br>pero quizás es mejor<slide><br>que te lo quedes.<clear><br><$voicel(1,5)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>Es que creo que ahora no le daría mucho uso..."

#. en: <$voicel(1,5)><$motion(1,807)><$comeff(1,4)>Um... This is where I already live. Is-is there another<br>house you could show me?
msgctxt "1995:439"
msgid "<$voicel(1,5)><$motion(1,807)><$comeff(1,4)>P-pero... si yo ya vivo aquí... Como no me enseñes otra<br>casa..."
msgstr "<$voicel(1,5)><$motion(1,807)><$comeff(1,4)>P-pero... si yo ya vivo aquí... Si no me enseñas otra<br>casa..."

#. en: <$comeff(1,5)><$facial(1,1)><$motion(1,806)><$voicel(1,6)>I was wondering... Maybe you could help me out,<br><$cdef(27)><pname;0></color>? ...Please?
msgctxt "1995:442"
msgid "<$comeff(1,5)><$facial(1,1)><$motion(1,806)><$voicel(1,6)>Y he pensado que, a lo mejor, tú podrías hacer algo para<br>despejarlo... Si no te importa, <$cdef(27)><pname;0></color>..."
msgstr "<$comeff(1,5)><$facial(1,1)><$motion(1,806)><$voicel(1,6)>Y pensé que, a lo mejor, tú podrías hacer algo para<br>despejarlo... Si no te importa, <$cdef(27)><pname;0></color>..."

#. en: <$voicel(1,6)><$emotion(1,14)>Oh, time’s up, <$cdef(27)><pname;0></color>!
msgctxt "1995:443"
msgid "<$voicel(1,6)><$emotion(1,14)>Se acabó el tiempo, <$cdef(27)><pname;0></color>..."
msgstr ""

#. en: <oneline><$voicel(1,3)><$motion(1,805)><$comeff(1,14)>I-I can’t believe we lost... I did my best, and my team was<br>really strong too... <$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>You’re just too good at this,<slide><br><$cdef(27)><pname;1></color>!<clear><br><$voicel(1,10)><$emotion(1,8)>Here—something really special to celebrate your victory!
msgctxt "1995:444"
msgid "<oneline><$voicel(1,3)><$motion(1,805)><$comeff(1,14)>Me he esforzado un montón y éramos un equipo muy<br>bueno...<clear><br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¡P-pero es que no hay quien te gane,<br><$cdef(27)><pname;1></color>!<clear><br><$voicel(1,10)><$emotion(1,8)>Te mereces un regalo tan increíble como tú. Aquí tienes."
msgstr "<oneline><$voicel(1,3)><$motion(1,805)><$comeff(1,14)>Me esforcé un montón y éramos un equipo muy<br>bueno...<clear><br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¡P-pero es que no hay quien te gane,<br><$cdef(27)><pname;1></color>!<clear><br><$voicel(1,10)><$emotion(1,8)>Te mereces un regalo tan increíble como tú. Aquí tienes."

#. en: <$voicel(1,8)><$motion(1,805)><$facial(1,4)><$comeff(1,6)>So...do you want to have another go at hide-and-sneak?
msgctxt "1995:445"
msgid "<$voicel(1,8)><$motion(1,805)><$facial(1,4)><$comeff(1,6)>¿Te apetece jugar otra vez?"
msgstr "<$voicel(1,8)><$motion(1,805)><$facial(1,4)><$comeff(1,6)>¿Quieres jugar otra vez?"

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)><$pkcry;0(1,2)>! ♪ I-I won’t hold back!
msgctxt "1995:446"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>¡<$pkcry;0(1,2)>! B-buena suerte..."
msgstr ""

#. en: <$voicel(1,5)><$emotion(1,14)>Oh, OK! Maybe we can play together another time, then.
msgctxt "1995:447"
msgid "<$voicel(1,5)><$emotion(1,14)>Vale, no pasa nada... Si otro día te apetece, dímelo..."
msgstr "<$voicel(1,5)><$emotion(1,14)>Bueno, no pasa nada... Si otro día quieres, dímelo..."

#. en: <$comeff(1,14)><$facial(1,9)><$motion(1,666)><$voicel(1,5)>Um... Th-this isn’t really what I’m looking for...<br>Something’s missing.<clear><br><$emotion(1,41)><$voicel(1,3)>I don’t think I wanna move here... S-sorry...
msgctxt "1995:449"
msgid "<$comeff(1,14)><$facial(1,9)><$motion(1,666)><$voicel(1,5)>Vaya... es como si le faltara algo... <$emotion(1,41)><$voicel(1,3)>L-lo siento, pero no<br>termino de ver lo de mudarme aquí..."
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,8)>O-OK! Sure, I can do this! <$voicel(1,6)><$emotion(1,14)>Come check back in a<br>little while.
msgctxt "1995:452"
msgid "<$voicel(1,7)><$emotion(1,8)>¡Va-vale! ¡Yo me encargo!<clear><br><$voicel(1,6)><$emotion(1,14)>Tardaré un poco, así que... ven a verme en un rato."
msgstr "<$voicel(1,7)><$emotion(1,8)>¡De-de acuerdo! ¡Yo me encargo!<clear><br><$voicel(1,6)><$emotion(1,14)>Tardaré un poco, así que... ven a verme en un rato."

#. en: <$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>Oh, um... I’m not done yet, sorry... Could you wait just a<br>bit longer?
msgctxt "1995:453"
msgid "<$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>P-perdona... Todavía no he acabado. ¿Te importa volver<br>en un rato?"
msgstr "<$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>P-perdona... Todavía no termino. ¿Te importa volver<br>en un rato?"

#. en: <oneline><$voicel(1,5)><$motion(1,803)><$comeff(1,1)>Here... It’s the <$cdef(27)><class><reftarid;1><br></color>you wanted.
msgctxt "1995:454"
msgid "<oneline><$voicel(1,5)><$motion(1,803)><$comeff(1,1)>Aquí tienes... <genqty;1(Es aquel,Es aquella,Son aquellos,Son aquellas)><br><$cdef(27)><class><reftarid;1></color><slide><br>que me pediste..."
msgstr ""

#. en: <$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>There’s something else I’ve really gotta do right<br>now... Sorry...
msgctxt "1995:455"
msgid "<$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>E-es que ahora estoy un poco liad<gen;-3(o,a)>... P-perdona..."
msgstr "<$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>E-es que ahora estoy un poco ocupad<gen;-3(o,a)>... P-perdona..."

#. en: <$comeff(1,6)><$voicel(1,3)><$motion(1,827)><$facial(1,9)>Huh? What happened to my home?
msgctxt "1995:459"
msgid "<$comeff(1,6)><$voicel(1,3)><$motion(1,827)><$facial(1,9)>Ay... No encuentro mi casa..."
msgstr ""

#. en: <$comeff(1,14)><$voicel(1,1)><$motion(1,802)><$facial(1,9)>Oh no... What’ll I do now?
msgctxt "1995:460"
msgid "<$comeff(1,14)><$voicel(1,1)><$motion(1,802)><$facial(1,9)>Pero... pero... ¿y ahora qué hago?"
msgstr ""

#. en: <$comeff(1,19)><$facial(1,9)><$motion(1,802)><$voicel(1,3)>Well, I guess I don’t have a choice... I just need to look for<br>a new place to stay.<$facial(1,1)><$comeff(1,1)><$motion(1,803)><$voicel(1,8)> I bet I’ll find one in no time.
msgctxt "1995:461"
msgid "<$comeff(1,19)><$facial(1,9)><$motion(1,802)><$voicel(1,3)>Jooo, ¿por qué siempre me pasan estas cosas a mí?<br>Tendré que buscarme una nueva casa... <$facial(1,1)><$comeff(1,1)><$motion(1,803)><$voicel(1,8)>Debo ser fuerte."
msgstr "<$comeff(1,19)><$facial(1,9)><$motion(1,802)><$voicel(1,3)>Ayyy, ¿por qué siempre me pasan estas cosas a mí?<br>Tendré que buscarme una nueva casa... <$facial(1,1)><$comeff(1,1)><$motion(1,803)><$voicel(1,8)>Debo ser fuerte."

#. en: <$comeff(1,6)><$motion(1,803)><$voicel(1,5)>Oh, this looks like a nice place to live. You made it,<br>right, <$cdef(27)><pname;0></color>?<clear><br><$voicel(1,8)><$comeff(1,13)>I think I’ll live here. <$voicel(1,7)><$motion(1,801)><$facial(1,5)><$comeff(1,21)>Thank you so much!
msgctxt "1995:462"
msgid "<oneline><$motion(1,803)><$voicel(1,5)>Uy... Este sitio es estupendo... <$cdef(27)><pname;0></color>,<br>has sido tú,<slide><br><$comeff(1,6)>¿a que sí?<clear><br><$voicel(1,8)><$comeff(1,13)>Pues a partir de hoy voy a vivir aquí. <$voicel(1,7)><$motion(1,801)><$facial(1,5)><$comeff(1,21)>M-muchas gracias,<br>de verdad."
msgstr "<oneline><$motion(1,803)><$voicel(1,5)>Uy... Este lugar es estupendo... <$cdef(27)><pname;0></color>,<br>fuiste tú,<slide><br><$comeff(1,6)>¿verdad?<clear><br><$voicel(1,8)><$comeff(1,13)>Pues a partir de hoy voy a vivir aquí. <$voicel(1,7)><$motion(1,801)><$facial(1,5)><$comeff(1,21)>M-muchas gracias,<br>de verdad."

#. en: <oneline><$comeff(1,6)><$motion(1,803)><$voicel(1,5)>Huh...? You got me<br><iart;0()><$cdef(27)><fqty(1)><class><stfrevp;0></color>?<clear><br><$voicel(1,7)><$facial(1,5)><$comeff(1,21)>Wow, thanks! I should check it out and see how it looks.
msgctxt "1995:463"
msgid "<oneline><$comeff(1,6)><$motion(1,803)><$voicel(1,5)>¿Eh? ¿Me has conseguido<br><iart;0()><fqty(1)><class><$cdef(27)><stfrevp;0></color>?<slide><br><$voicel(1,7)><$facial(1,5)><$comeff(1,21)>G-gracias, voy a ver cómo <genqty;0(ha,ha,han,han)> quedado..."
msgstr "<oneline><$comeff(1,6)><$motion(1,803)><$voicel(1,5)>¿Eh? ¿Me conseguiste<br><iart;0()><fqty(1)><class><$cdef(27)><stfrevp;0></color>?<slide><br><$voicel(1,7)><$facial(1,5)><$comeff(1,21)>G-gracias, voy a ver cómo <genqty;0(ha,ha,han,han)> quedado..."

#. en: <$comeff(1,21)><$facial(1,4)><$motion(1,805)><$voicel(1,7)>I feel safe here... I’m glad this is where I moved to.
msgctxt "1995:464"
msgid "<$comeff(1,21)><$facial(1,4)><$motion(1,805)><$voicel(1,7)>Me relaja mucho estar aquí... Me alegro de haberme<br>mudado a esta casa."
msgstr ""

#. en: <oneline><$comeff(1,6)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>C-could you give this to <$cdef(27)><refpname;0></color>?<br>They<slide><br>said<slide><br>they<slide><br>needed it...
msgctxt "1995:465"
msgid "<$comeff(1,6)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>¿Te importa darle esto a <$cdef(27)><refpname;0></color>?<br>Le hacía falta, por lo visto..."
msgstr ""

#. en: <oneline><$voicel(1,6)><$motion(1,803)><$comeff(1,3)>Hey, <$cdef(27)><pname;0></color>... I came up with a little<br>quiz<slide><br>for<slide><br>you.<slide><br><$voicel(1,8)><$emotion(1,33)>Want<slide><br>to<slide><br>give<slide><br>it<slide><br>a shot?
msgctxt "1995:466"
msgid "<oneline><$voicel(1,6)><$motion(1,803)><$comeff(1,3)>Oye, <$cdef(27)><pname;0></color>... Verás, es que se me<br>ha ocurrido<slide><br>una pregunta y...<clear><br><$voicel(1,8)><$emotion(1,33)>Bueno, si quieres intentar responderla..."
msgstr "<oneline><$voicel(1,6)><$motion(1,803)><$comeff(1,3)>Oye, <$cdef(27)><pname;0></color>... Verás, es que se me<br>ocurrió<slide><br>una pregunta y...<clear><br><$voicel(1,8)><$emotion(1,33)>Bueno, si quieres intentar responderla..."

#. en: <$voicel(1,7)><$emotion(1,1)>Great! Then let’s get right to it.<clear><br><$voicel(1,5)><$motion(1,827)><$comeff(1,6)><$facial(1,1)>Which of us is taller, me or <$cdef(27)><sizecmppk;1></color>?
msgctxt "1995:467"
msgid "<oneline><$voicel(1,7)><$emotion(1,1)>¡G-gracias! Vale, pues esta es...<clear><br><$voicel(1,5)><$motion(1,827)><$comeff(1,6)><$facial(1,1)>Entre <dart;1()><$cdef(27)><sizecmppk;1></color> y yo, ¿quién crees que mide<br>más?"
msgstr "<oneline><$voicel(1,7)><$emotion(1,1)>¡G-gracias! Bueno, pues esta es...<clear><br><$voicel(1,5)><$motion(1,827)><$comeff(1,6)><$facial(1,1)>Entre <dart;1()><$cdef(27)><sizecmppk;1></color> y yo, ¿quién crees que mide<br>más?"

#. en: <$voicel(1,3)><$comeff(1,3)>Oh, OK...<$motion(1,803)> Maybe next time, then.
msgctxt "1995:468"
msgid "<$voicel(1,3)><$comeff(1,3)>V-vale... <wait(0.9)><$motion(1,803)>Otro día si quieres..."
msgstr "<$voicel(1,3)><$comeff(1,3)>B-bueno... <wait(0.9)><$motion(1,803)>Otro día si quieres..."

#. en: ...<wait(0.4)><$voicel(1,9)><$motion(1,803)><$comeff(1,20)><$facial(1,5)>Correct! You’re good at this, <$cdef(27)><pname;0></color>!
msgctxt "1995:469"
msgid "<oneline>...<wait(0.4)><$voicel(1,9)><$motion(1,803)><$comeff(1,20)><$facial(1,5)> ¡Correcto! Guau, eres <gen;-2(el,la)> mejor,<br><$cdef(27)><pname;0></color>..."
msgstr ""

#. en: ...<wait(0.4)><$voicel(1,1)><$emotion(1,3)><$comeff(1,4)>Incorrect! Too bad—that’s the wrong answer.<clear><br><$voicel(1,5)><$emotion(1,33)>Maybe the question was a bit too hard, huh? Still, thanks<br>for humoring me!<$voicel(1,8)><$motion(1,803)><$comeff(1,1)><$facial(1,4)> Let’s hang out again soon, OK?
msgctxt "1995:470"
msgid "...<wait(0.4)><$voicel(1,1)><$emotion(1,3)><$comeff(1,4)> Qué pena, no has acertado...<clear><br><$voicel(1,5)><$emotion(1,33)>Ay, ¿a-a lo mejor la pregunta era demasiado difícil?<br>Pero gracias por intentarlo. <$voicel(1,8)><$motion(1,803)><$comeff(1,1)><$facial(1,4)>Otro día más y mejor..."
msgstr "...<wait(0.4)><$voicel(1,1)><$emotion(1,3)><$comeff(1,4)> Qué pena, no acertaste...<clear><br><$voicel(1,5)><$emotion(1,33)>Ay, ¿a-a lo mejor la pregunta era demasiado difícil?<br>Pero gracias por intentarlo. <$voicel(1,8)><$motion(1,803)><$comeff(1,1)><$facial(1,4)>Otro día más y mejor..."

#. en: <$voicel(1,5)><$comeff(1,1)>Yeah, I think I’ll move here.<clear><br><$motion(1,803)><$voicel(1,7)><$facial(1,4)><$comeff(1,13)>Don’t get me wrong, I liked my old place too, but this new<br>place is so refreshing!
msgctxt "1995:471"
msgid "<$voicel(1,5)><$comeff(1,1)>Hmm... Vale, me quedo aquí.<clear><br><$motion(1,803)><$voicel(1,7)><$facial(1,4)><$comeff(1,13)>El sitio de antes no estaba nada mal, pero estrenar casa<br>de vez en cuando también tiene su encanto..."
msgstr "<$voicel(1,5)><$comeff(1,1)>Hmm... Bueno, me quedo aquí.<clear><br><$motion(1,803)><$voicel(1,7)><$facial(1,4)><$comeff(1,13)>El lugar de antes no estaba nada mal, pero estrenar casa<br>de vez en cuando también tiene su encanto..."

#. en: <$voicel(1,3)>Huh?<wait(0.5)><$emotion(1,27)> Wait a minute... Are you <$cdef(27)><pname;1></color>?<br><$voicel(1,8)><$motion(1,801)><$comeff(1,21)><$facial(1,4)>Wow... It took me a moment to figure out who you were!
msgctxt "1995:472"
msgid "<$voicel(1,3)>Tú... <wait(0.5)><$emotion(1,27)>¿No serás <$cdef(27)><pname;1></color>, por casualidad?<br><$voicel(1,8)><$motion(1,801)><$comeff(1,21)><$facial(1,4)>¡Qué hábil eres! Me ha costado darme cuenta..."
msgstr "<$voicel(1,3)>Tú... <wait(0.5)><$emotion(1,27)>¿No serás <$cdef(27)><pname;1></color>, por casualidad?<br><$voicel(1,8)><$motion(1,801)><$comeff(1,21)><$facial(1,4)>¡Qué hábil eres! Me costó darme cuenta..."

#. en: <$voicel(1,5)><$emotion(1,14)>Oh, but, um... I don’t think we have enough space to play<br>right now...<clear><br><$motion(1,805)><$comeff(1,6)><$voicel(1,4)>Do you think you could clear out more space for<br>us, <$cdef(27)><pname;0></color>?
msgctxt "1995:476"
msgid "<oneline><$voicel(1,5)><$emotion(1,14)>No quiero ser <gen;-3(un,una)> aguafiestas, pero creo que aquí no hay<br>mucho espacio para jugar...<clear><br><$motion(1,805)><$comeff(1,6)><$voicel(1,4)>¿No podrías despejar la zona un poco,<br><$cdef(27)><pname;0></color>?"
msgstr ""

#. en: <$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>I’m really sorry but...I—I don’t think I can live here...
msgctxt "1995:477"
msgid "<$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>L-lo siento de veras, pero creo que no me veo viviendo<br>aquí..."
msgstr ""

#. en: <$cdef(27)><$voicel(1,10)><$motion(1,803)><$comeff(1,8)><$facial(1,4)></color>Thanks, <$cdef(27)><pname;0></color>.<clear><br><$voicel(1,3)><$emotion(1,47)>But to be honest, I’m not feeling very hungry right now.<br><$voicel(1,8)><$emotion(1,1)>I appreciate the thought, though!
msgctxt "1995:478"
msgid "<oneline><$cdef(27)><$voicel(1,10)></color><$motion(1,803)><$comeff(1,8)><$facial(1,4)>Gracias... <$voicel(1,3)><$emotion(1,47)>La cosa es que ahora mismo n-no tengo hambre,<br><$voicel(1,8)><$emotion(1,1)>pero me alegra que pensaras en mí,<slide><br><$cdef(27)><pname;0></color>..."
msgstr ""

#. en: <$emotion(1,29)><$voicel(1,6)>So, um... Where should I live?
msgctxt "1995:481"
msgid "<$emotion(1,29)><$voicel(1,6)>¿Y adónde voy?..."
msgstr ""

#. en: <$comeff(1,6)><$motion(1,666)><$voicel(1,5)>Wow... So this is my new home!<clear><br>...It is, right?
msgctxt "1995:482"
msgid "<$comeff(1,6)><$motion(1,666)><$voicel(1,5)>Estooo... ¿Entonces, esta es mi nueva casa?"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,1)>Great! Then let’s get right to it...<clear><br><$voicel(1,5)><$motion(1,827)><$comeff(1,6)><$facial(1,1)>Which of us is heavier, me or <$cdef(27)><weightcmppk;1></color>?
msgctxt "1995:484"
msgid "<$voicel(1,7)><$emotion(1,1)>¡G-gracias! Es la siguiente...<clear><br><$voicel(1,5)><$motion(1,827)><$comeff(1,6)><$facial(1,1)>Entre <$cdef(27)><weightcmppk;1></color> y yo, ¿quién crees que pesa más?"
msgstr ""

#. en: <$comeff(1,6)><$motion(1,827)><$voicel(1,7)>Oh yeah, that. Pretty neat, right?
msgctxt "1995:489"
msgid "<$comeff(1,6)><$motion(1,827)><$voicel(1,7)>Ay, ¿a que está muy bien?"
msgstr "<$comeff(1,6)><$motion(1,827)><$voicel(1,7)>Ay, está muy bien, ¿no?"

#. en: <$comeff(1,1)><$motion(1,803)><$voicel(1,7)>Thanks. In that case, do you wanna trade something for it?
msgctxt "1995:490"
msgid "<$comeff(1,1)><$motion(1,803)><$voicel(1,7)>G-gracias... ¿Y tú qué me darías a cambio?"
msgstr ""

#. en: <$comeff(1,14)><$motion(1,803)><$voicel(1,3)><$facial(1,9)>Maybe not so much, huh...
msgctxt "1995:491"
msgid "<$comeff(1,14)><$motion(1,803)><$voicel(1,3)><$facial(1,9)>Ah... Eeeh... Vale."
msgstr "<$comeff(1,14)><$motion(1,803)><$voicel(1,3)><$facial(1,9)>Ah... Eeeh... Bueno."

#. en: <$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Thanks for the trade!
msgctxt "1995:492"
msgid "<$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡G-gracias!"
msgstr ""

#. en: <$comeff(1,6)><$motion(1,802)><$voicel(1,5)>Oh... Have you changed your mind?
msgctxt "1995:493"
msgid "<$comeff(1,6)><$motion(1,802)><$voicel(1,5)>Ay... ¿Has cambiado de idea?"
msgstr "<$comeff(1,6)><$motion(1,802)><$voicel(1,5)>Ay... ¿Cambiaste de idea?"

#. en: <$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Thanks for the <$cdef(27)><$spwfull(12)></color>! <clear><br><$comeff(1,13)><$motion(1,803)><$voicel(1,7)>I’ve traded everything I brought for today... Come back<br>another time!
msgctxt "1995:494"
msgid "<$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Pues muchas gracias!<clear><br><$comeff(1,13)><$motion(1,803)><$voicel(1,7)>Y eso era todo lo que tenía, así que... Hasta otra."
msgstr "<$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Pues muchas gracias!<clear><br><$comeff(1,13)><$motion(1,803)><$voicel(1,7)>Y eso era todo lo que tenía, así que... Nos vemos."

#. en: <$voicel(1,6)><$comeff(1,1)>Oh, hey there, <$cdef(27)><pname;0></color>.<clear><br>I’m on my way to the <$cdef(27)><$voicel(1,5)><fqty(1)><$ifull(1325)></color>. <$facial(1,4)><$voicel(1,7)><$motion(1,801)><$comeff(1,13)>If you’re in the<br>mood for a <$cdef(27)><$spwfull(12)></color>, that’s where to find me.
msgctxt "1995:495"
msgid "<$voicel(1,6)><$comeff(1,1)>Ay, <$cdef(27)><pname;0></color>... Si quieres <$cdef(27)><$spwfull(12)></color>,<br><$voicel(1,5)>estaré en la <$cdef(27)><fqty(1)><$ifull(1325)></color>... <$facial(1,4)><$voicel(1,7)><$motion(1,801)><$comeff(1,13)>Por si te interesa..."
msgstr ""

#. en: <$comeff(1,13)><$voicel(1,7)><$facial(1,4)>Oh, sorry, I’m closing up for the day. Come back again<br>some other time, OK?
msgctxt "1995:496"
msgid "<$comeff(1,13)><$voicel(1,7)><$facial(1,4)>Lo siento, hoy ya está todo agotado... Pásate otro día..."
msgstr ""

#. en: <$comeff(1,6)><$motion(1,827)><$voicel(1,8)>What could this be?
msgctxt "1995:497"
msgid "<$comeff(1,6)><$motion(1,827)><$voicel(1,8)>Ay, ¿esto qué será?"
msgstr ""

#. en: <$voicel(1,9)><$emotion(1,8)>Oh, you made me food...? Th-thanks—I really appreciate it!
msgctxt "1995:500"
msgid "<$voicel(1,9)><$emotion(1,8)>¿Me has traído algo? Caray, n-no sé cómo agradecértelo."
msgstr "<$voicel(1,9)><$emotion(1,8)>¿Me trajiste algo? Caray, n-no sé cómo agradecértelo."

#. en: <$voicel(1,7)><$motion(1,805)><$comeff(1,14)>...Is it me, or is the sun extra bright in the morning?<$voicel(1,3)><$motion(1,807)><$comeff(1,4)> I feel<br>like I’m gonna melt...
msgctxt "1995:501"
msgid "<$voicel(1,7)><$motion(1,805)><$comeff(1,14)>Uf, hoy el sol brilla más fuerte de lo normal...<wait(1.0)><br><$voicel(1,3)><$motion(1,807)><$comeff(1,4)>¡M-me voy a achicharrar!"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,8)>I think the weather’s supposed to stay pretty good today.<clear><br><$voicel(1,5)><$motion(1,803)><$facial(1,1)><$comeff(1,10)>Y’know, since the weather’s so good, <$voicel(1,8)><$motion(1,805)><$comeff(1,6)>m-maybe I should be<br>brave and go exploring a bit farther than I usually do...?
msgctxt "1995:502"
msgid "<$voicel(1,7)><$emotion(1,8)>Erm... Parece que hoy va a hacer buen tiempo todo el día.<clear><br><$voicel(1,5)><$motion(1,803)><$facial(1,1)><$comeff(1,10)>¿Debería aprovechar para irme a jugar un poco más<br>lejos que de costumbre, <$voicel(1,8)><$motion(1,805)><$comeff(1,6)>a-aunque me dé miedo?..."
msgstr ""

#. en: <$voicel(1,5)><$emotion(1,14)>Ahhh, evening time... Sometimes the sunset’s so pretty,<br>it just <$voicel(1,8)><$motion(1,807)><$facial(1,4)><$comeff(1,14)>makes you want to cry, doesn’t it?
msgctxt "1995:503"
msgid "<$voicel(1,5)><$emotion(1,14)>Ya está anocheciendo. La puesta de sol es tan bonita...<br><$voicel(1,8)><$motion(1,807)><$facial(1,4)><$comeff(1,14)>Me da hasta ganas de llorar... ¿A ti no te pasa?"
msgstr ""

#. en: <$voicel(1,9)><$emotion(1,6)>I like the night... It’s so dark and quiet and peaceful...<clear><br><$voicel(1,8)><$motion(1,803)><$facial(1,1)><$comeff(1,10)>It’s a bit of a shame I have to sleep...
msgctxt "1995:504"
msgid "<$voicel(1,9)><$emotion(1,6)>Por la noche, está todo tan oscuro y tan tranquilo<br>que me siento mucho más relajad<gen;-3(o,a)>... Es genial...<clear><br><$voicel(1,8)><$motion(1,803)><$facial(1,1)><$comeff(1,10)>Ojalá no tuviera que irme a dormir..."
msgstr ""

#. en: <$voicel(1,5)><$emotion(1,14)>I love the sound of leaves rustling in the breeze... <$voicel(1,8)><$emotion(1,39)>It’s like<br>the trees are telling us we can kick back and relax.
msgctxt "1995:507"
msgid "<$voicel(1,5)><$emotion(1,14)>El susurro de las hojas suena como si los árboles me<br>dijeran: \"Tranquil<gen;-3(o,a)>, vive a tu ritmo\"...<clear><br><$voicel(1,8)><$emotion(1,39)>Por eso me encanta escucharlo..."
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,6)>I just saw a cute, fluffy little flower!<clear><br><$voicel(1,5)><$facial(1,1)><$motion(1,805)><$comeff(1,14)>I thought about picking it and bringing it back with me,<br>but...all the flowers looked so cute blooming together...<clear><br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>I ended up just leaving them be!
msgctxt "1995:508"
msgid "<$voicel(1,7)><$emotion(1,6)>¿Sabes? Antes he visto una flor que era... um... preciosa<br>y muy suave...<clear><br><$voicel(1,5)><$facial(1,1)><$motion(1,805)><$comeff(1,14)>Quería llevármela a casa, pero como estaba tan bonita<br>floreciendo junto al resto...<clear><br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Al final me ha dado penilla y la he dejado donde estaba."
msgstr "<$voicel(1,7)><$emotion(1,6)>¿Sabes? Hace rato vi una flor que era... um... preciosa<br>y muy suave...<clear><br><$voicel(1,5)><$facial(1,1)><$motion(1,805)><$comeff(1,14)>Quería llevármela a casa, pero como estaba tan bonita<br>floreciendo junto al resto...<clear><br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Al final me dio penita y la dejé donde estaba."

#. en: <oneline><$voicel(1,7)><$motion(1,805)><$comeff(1,14)>This place is pretty different from where I used to live,<br>but...I feel really calm and relaxed living here.<clear><br><$voicel(1,10)><$emotion(1,39)>I think it’s ’cause you’re here, <$cdef(27)><pname;0></color>!
msgctxt "1995:509"
msgid "<$voicel(1,7)><$motion(1,805)><$comeff(1,14)>Verás, yo antes... vivía en otro sitio, pero... a-aquí<br>me siento más a gusto.<clear><br><$voicel(1,10)><$emotion(1,39)>Tiene que ser porque estás tú, <$cdef(27)><pname;0></color>."
msgstr "<$voicel(1,7)><$motion(1,805)><$comeff(1,14)>Verás, yo antes... vivía en otro lugar, pero... a-aquí<br>me siento más a gusto.<clear><br><$voicel(1,10)><$emotion(1,39)>Tiene que ser porque estás tú, <$cdef(27)><pname;0></color>."

#. en: <$voicel(1,5)><$emotion(1,14)>Oh! Uh...sure, I guess that’s it for today. Come find me<br>next time too, OK?
msgctxt "1995:516"
msgid "<$voicel(1,5)><$emotion(1,14)>Ah... Sí, claro. Lo dejo por hoy. Ven a verme otro día<br>si quieres, ¿vale?"
msgstr "<$voicel(1,5)><$emotion(1,14)>Ah... Sí, claro. Lo dejo por hoy. Ven a verme otro día<br>si quieres, ¿sí?"

#. en: <oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,6)>Hey, <$cdef(27)><pname;0></color>... Would...would you be<br>willing<slide><br>to<slide><br><$cdef(27)><$spwfull(12)></color><slide><br>with me...?
msgctxt "1995:517"
msgid "<oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,6)>O-oye, <$cdef(27)><pname;0></color>... ¿No te apetecerá<br><$cdef(27)><$spwfull(12)><slide><br></color>conmigo?"
msgstr "<oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,6)>O-oye, <$cdef(27)><pname;0></color>... ¿No te gustaría<br><$cdef(27)><$spwfull(12)><slide><br></color>conmigo?"

#. en: <$comeff(1,14)><$motion(1,827)><$voicel(1,5)>I heard <$cdef(27)><shoppk;0></color> is at the <$cdef(27)><fqty(1)><$ifull(1325)></color> today.<br>I might go check it out later...
msgctxt "1995:518"
msgid "<oneline><$comeff(1,14)><$motion(1,827)><$voicel(1,5)>Dicen que está <dart;0()><$cdef(27)><shoppk;0> </color>en<br>la <$cdef(27)><fqty(1)><$ifull(1325)></color>...<slide><br>Igual me paso luego..."
msgstr "<oneline><$comeff(1,14)><$motion(1,827)><$voicel(1,5)>Dicen que está <dart;0()><$cdef(27)><shoppk;0> </color>en<br>la <$cdef(27)><fqty(1)><$ifull(1325)></color>...<slide><br>A lo mejor me paso luego..."

#. en: <$comeff(1,9)><$facial(1,4)><$voicel(1,7)>I like places where the waves are calm.<clear><br><$comeff(1,23)><$motion(1,807)><$facial(1,9)><$voicel(1,3)>When the current changes suddenly, I get nervous thinking<br>someone’s coming...
msgctxt "1995:520"
msgid "<$comeff(1,9)><$facial(1,4)><$voicel(1,7)>Hmm... Me gustan las zonas donde el oleaje es tranquilo.<clear><br><$comeff(1,23)><$motion(1,807)><$facial(1,9)><$voicel(1,3)>Si siento un cambio muy brusco en la corriente, me da<br>la sensación de que se me está acercando alguien y me<slide><br>entra un canguelo..."
msgstr "<$comeff(1,9)><$facial(1,4)><$voicel(1,7)>Hmm... Me gustan las zonas donde el oleaje es tranquilo.<clear><br><$comeff(1,23)><$motion(1,807)><$facial(1,9)><$voicel(1,3)>Si siento un cambio muy brusco en la corriente, me da<br>la sensación de que se me está acercando alguien y me<slide><br>entra un miedo..."

#. en: <oneline><$comeff(1,3)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Wow, you’ve watered so many things,<br><$cdef(27)><pname;0></color>...<clear><br><$emotion(1,8)><$voicel(1,10)>The grass and flowers all seem so happy!
msgctxt "1995:521"
msgid "<oneline><$comeff(1,3)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Ah, <$cdef(27)><pname;0></color>... Veo que has estado<br>regando<slide><br>un montón.<clear><br><$emotion(1,8)><$voicel(1,10)>La hierba y las flores parecen muy contentas."
msgstr "<oneline><$comeff(1,3)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Ah, <$cdef(27)><pname;0></color>... Veo que has estado<br>regando<slide><br>un montón.<clear><br><$emotion(1,8)><$voicel(1,10)>El pasto y las flores parecen muy contentos."

#. en: <oneline><$emotion(1,14)><$voicel(1,7)>Oh, by the way, <$cdef(27)><pname;0></color>... You can<br>have this...
msgctxt "1995:522"
msgid "<$emotion(1,14)><$voicel(1,7)>Ay, sí, quería darte una cosilla."
msgstr "<$emotion(1,14)><$voicel(1,7)>Ay, sí, quería darte una cosita."

#. en: <oneline><$voicel(1,7)><$emotion(1,14)>You know, <$cdef(27)><nlpairpk;1></color> invited me out to <$voicel(1,6)><$facial(1,4)><$comeff(1,10)>play with<br>them!<slide><br><$voicel(1,10)><$emotion(1,8)>It<slide><br>really<slide><br>made<slide><br>me happy...
msgctxt "1995:523"
msgid "<oneline><$voicel(1,7)><$emotion(1,14)>¿Sabes, <$cdef(27)><pname;0></color>? <fcap><dart;1()><$cdef(27)><nlpairpk;1></color><br>ha venido<slide><br>y me ha dicho<slide><br>q-que...<slide><br><$voicel(1,6)><$facial(1,4)><$comeff(1,10)>¡que me invitaba a jugar!<clear><br><$voicel(1,10)><$emotion(1,8)>¡Qué ilusión me ha hecho!"
msgstr "<oneline><$voicel(1,7)><$emotion(1,14)>¿Sabes, <$cdef(27)><pname;0></color>? <fcap><dart;1()><$cdef(27)><nlpairpk;1></color><br>vino<slide><br>y me dijo<slide><br>q-que...<slide><br><$voicel(1,6)><$facial(1,4)><$comeff(1,10)>¡que me invitaba a jugar!<clear><br><$voicel(1,10)><$emotion(1,8)>¡Qué alegría me dio!"

#. en: <oneline><$voicel(1,5)><$emotion(1,14)>You know <qty;1(that,those)><br><$cdef(27)><fqty(1)><class><nlqueitem;1></color><slide><br>you<slide><br>gave<slide><br>me before?<clear><br><$voicel(1,7)><$facial(1,4)><$comeff(1,9)>I just wanted to say I really like <qty;1(it,them)>, and...and I’m really<br>happy you gave <qty;1(it,them)> to me...<clear><br><$voicel(1,10)><$emotion(1,39)>I promise I’ll treasure <qty;1(it,them)> forever!
msgctxt "1995:524"
msgid "<oneline><$voicel(1,5)><$emotion(1,14)>Oye, ¿te acuerdas de cuando me regalaste es<genqty;1(e,a,os,as)><br><fqty(1)><class><$cdef(27)><nlqueitem;1></color>,<slide><br><$cdef(27)><pname;0></color>?<clear><br><$voicel(1,7)><$facial(1,4)><$comeff(1,9)>Pues... me gust<qty;1(a,an)> un montón. Gracias por dármel<genqty;1(o,a,os,as)>.<br><$voicel(1,10)><$emotion(1,39)>L<genqty;1(o,a,os,as)> guardaré como un tesoro."
msgstr ""

#. en: <$voicel(1,5)><$motion(1,803)><$comeff(1,3)>I don’t mind living in my home, but those human houses<br><$voicel(1,8)><$emotion(1,39)>seem really nice too...<clear><br><$voicel(1,5)><$motion(1,805)><$comeff(1,14)>If I ever get to live in one, there are so many things I want<br>to try out...
msgctxt "1995:525"
msgid "<$voicel(1,5)><$motion(1,803)><$comeff(1,3)>Mi casa no está mal, me parece, pero siempre me he<br>preguntado cómo sería vivir en una de esas <$voicel(1,8)><$emotion(1,39)>tan chulas<slide><br>que construían los humanos...<clear><br><$voicel(1,5)><$motion(1,805)><$comeff(1,14)>Ojalá algún día tener la oportunidad de vivir en una...<br>Hay tantas cosas que podría hacer..."
msgstr "<$voicel(1,5)><$motion(1,803)><$comeff(1,3)>Mi casa no está mal, me parece, pero siempre me he<br>preguntado cómo sería vivir en una de esas <$voicel(1,8)><$emotion(1,39)>tan bonitas<slide><br>que construían los humanos...<clear><br><$voicel(1,5)><$motion(1,805)><$comeff(1,14)>Ojalá algún día tener la oportunidad de vivir en una...<br>Hay tantas cosas que podría hacer..."

#. en: <$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,6)>At night before I go to sleep, I always seem to remember<br>scary stories...<clear><br><$comeff(1,23)><$facial(1,9)><$motion(1,807)><$voicel(1,1)>I wish I could stop, because I can’t sleep... I’m worried I’ll<br>have scary dreams...
msgctxt "1995:526"
msgid "<$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,6)>Por las noches, cuando estoy intentando dormir, no puedo<br>evitar pensar en historias de miedo...<clear><br><$comeff(1,23)><$facial(1,9)><$motion(1,807)><$voicel(1,1)>Al final tengo pesadillas y me despierto más cansad<gen;-3(o,a)> aún.<br>Uf, ojalá pudiera hacer algo para quitarme esa manía..."
msgstr ""

#. en: <oneline><$voicel(1,5)><$motion(1,803)><$comeff(1,6)>Does the sunlight wake you up,<br><$cdef(27)><pname;0></color>?<clear><br><$voicel(1,3)><$motion(1,805)><$comeff(1,14)>It’s the opposite for me... The more the sun shines on me...<br><$voicel(1,2)><$motion(1,807)><$facial(1,14)><$comeff(1,16)>*yawn* ...the sleepier I get...
msgctxt "1995:527"
msgid "<oneline><$voicel(1,5)><$motion(1,803)><$comeff(1,6)>Oye, <$cdef(27)><pname;0></color>, ¿tú te despiertas cuando<br>sale el sol?...<clear><br><$voicel(1,3)><$motion(1,805)><$comeff(1,14)>Yo al revés... Cuanto más sol hace... <$voicel(1,2)><$motion(1,807)><$facial(1,14)><$comeff(1,16)>más sueño me entra...<br>Uaaah..."
msgstr ""

#. en: <$voicel(1,5)><$motion(1,805)><$comeff(1,14)>I know I’m pretty shy, but...I don’t hide myself with my<br>wings while I fly. <$voicel(1,4)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>I’d fall right out of the sky! <$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>I guess flying<slide><br>is the one time I really can’t be shy!
msgctxt "1995:528"
msgid "<$voicel(1,5)><$motion(1,805)><$comeff(1,14)>Yo... soy bastante vergonzos<gen;-3(o,a)>... y dudo de mí mism<gen;-3(o,a)>.<br>Es que dudo hasta cuando estoy volando...<clear><br><$voicel(1,4)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>Y de tanto dudar, a veces me acabo estrellando...<br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Tengo que practicar para volar con decisión... creo."
msgstr ""

#. en: <$voicel(1,7)><$motion(1,805)><$comeff(1,14)>You know how my body’s all shiny and draws a lot<br>of attention...?<clear><br><$voicel(1,5)><$motion(1,807)><$comeff(1,4)>I’m a bit embarrassed to stand out so much, but I’m<br>actually pretty proud of how sparkly I am...<clear><br><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>I even polish myself every day, even though I know it’ll just<br>make me stand out even more.
msgctxt "1995:529"
msgid "<$voicel(1,7)><$motion(1,805)><$comeff(1,14)>Como mi cuerpo refleja la luz, destaco allá donde voy...<br>¿a que sí?...<clear><br><$voicel(1,5)><$motion(1,807)><$comeff(1,4)>Me da vergüenza que los demás me miren, p-pero...<br>¡aun así, estoy orgullos<gen;-3(o,a)> de relucir así!<clear><br><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Quizá te parezca un poco contradictorio si te digo...<br>que me saco brillo todos los días para relucir más."
msgstr "<$voicel(1,7)><$motion(1,805)><$comeff(1,14)>Como mi cuerpo refleja la luz, destaco allá donde voy...<br>¿verdad?...<clear><br><$voicel(1,5)><$motion(1,807)><$comeff(1,4)>Me da vergüenza que los demás me miren, p-pero...<br>¡aun así, estoy orgullos<gen;-3(o,a)> de relucir así!<clear><br><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Quizás te parezca un poco contradictorio si te digo...<br>que me saco brillo todos los días para relucir más."

#. en: <$voicel(1,3)><$motion(1,803)><$comeff(1,3)>I’ve always been terrible at making friends, you know...<clear><br><$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>I was afraid the poison in my body would hurt others or<br>something, and I really don’t want that...<clear><br><$voicel(1,9)><$emotion(1,39)>So I’m super happy we’re able to be such good<br>friends, <$cdef(27)><pname;1></color>!
msgctxt "1995:530"
msgid "<$voicel(1,3)><$motion(1,803)><$comeff(1,3)>A mí siempre se me ha dado fatal hacer amigos...<clear><br><$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>Al ser venenos<gen;-3(o,a)>, me da miedo hacer daño a los demás,<br>así sin querer...<clear><br><$voicel(1,9)><$emotion(1,39)>¡P-por eso aprecio tanto que te hayas hecho amig<gen;-2(o mío,a mía)>,<br><$cdef(27)><pname;1></color>!"
msgstr "<$voicel(1,3)><$motion(1,803)><$comeff(1,3)>A mí siempre me ha costado muchísimo hacer amigos...<clear><br><$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>Al ser venenos<gen;-3(o,a)>, me da miedo hacer daño a los demás,<br>así sin querer...<clear><br><$voicel(1,9)><$emotion(1,39)>¡P-por eso aprecio tanto que te hayas hecho amig<gen;-2(o mío,a mía)>,<br><$cdef(27)><pname;1></color>!"

#. en: <$voicel(1,3)><$emotion(1,14)>So um...I just wanna clarify something...<$voicel(1,6)><$motion(1,805)><$comeff(1,14)> I was born with<br>this super-solid body, OK?<clear><br><$voicel(1,3)><$motion(1,807)>I don’t want you to think my body got this hard ’cause <$voicel(1,8)><$motion(1,803)><$comeff(1,10)><br>I’m always frozen in panic or anything!
msgctxt "1995:532"
msgid "<$voicel(1,3)><$emotion(1,14)>Igual ya lo sabías, pero, por si acaso, te lo cuento...<br>Te has fijado en que mi cuerpo es duro al tacto, ¿no?<slide><br><$voicel(1,6)><$motion(1,805)><$comeff(1,14)>Pues es así de nacimiento...<clear><br><$voicel(1,3)><$motion(1,807)>Quizá pensabas que es porque siempre estoy muy tens<gen;-3(o,a)><br>por los nervios y me he agarrotado, o algo así. <$voicel(1,8)><$motion(1,803)><$comeff(1,10)>¡Pero no!"
msgstr "<$voicel(1,3)><$emotion(1,14)>Tal vez ya lo sabías, pero por si acaso te lo cuento...<br>Te has fijado en que mi cuerpo es duro al tacto, ¿no?<slide><br><$voicel(1,6)><$motion(1,805)><$comeff(1,14)>Pues es así de nacimiento...<clear><br><$voicel(1,3)><$motion(1,807)>Quizás pensabas que es porque siempre estoy muy tens<gen;-3(o,a)><br>por los nervios y me he agarrotado, o algo así. <$voicel(1,8)><$motion(1,803)><$comeff(1,10)>¡Pero no!"

#. en: <$voicel(1,5)><$motion(1,805)><$comeff(1,14)>I’m small, so there are plenty of places I can hide.<clear><br><$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>...I could always just hide away if I was in a tough situation,<br>but...I guess that’s not always a good idea...<clear><br><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>From now on, I’m gonna try and actually talk to others<br>instead of hiding.
msgctxt "1995:533"
msgid "<$voicel(1,5)><$motion(1,805)><$comeff(1,14)>Como soy tan chiquit<gen;-3(ín,ina)>, me puedo esconder en<br>cualquier huequillo...<clear><br><$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>Tiendo a esconderme enseguida cuando me pongo<br>nervios<gen;-3(o,a)>, p-pero... ¡no puedo seguir así!<clear><br><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>A partir de hoy, ya no voy a esconderme. Voy a hablar<br>con todo el mundo, aunque no los conozca.<clear><br>¡V-voy a ser valiente, como tú!"
msgstr "<$voicel(1,5)><$motion(1,805)><$comeff(1,14)>Como soy tan chiquit<gen;-3(ín,ina)>, me puedo esconder en<br>cualquier huequito...<clear><br><$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>Tiendo a esconderme enseguida cuando me pongo<br>nervios<gen;-3(o,a)>, p-pero... ¡no puedo seguir así!<clear><br><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>A partir de hoy, ya no voy a esconderme. Voy a hablar<br>con todo el mundo, aunque no los conozca.<clear><br>¡V-voy a ser valiente, como tú!"

#. en: <$voicel(1,3)><$motion(1,805)><$comeff(1,7)><$facial(1,9)>I really don’t like being the center of attention, but<br>apparently I stand out even from far away...<clear><br><$voicel(1,5)><$motion(1,803)><$facial(1,1)><$comeff(1,14)>Just the other day, I fell over pretty hard and... Well, a<br>bunch of Pokémon from all over came to help me...<clear><br><$voicel(1,8)><$motion(1,807)><$comeff(1,4)>It was really nice of them, but... How embarrassing...
msgctxt "1995:534"
msgid "<$voicel(1,3)><$motion(1,805)><$comeff(1,7)><$facial(1,9)>Me encantaría pasar desapercibid<gen;-3(o,a)>, pero no puedo...<br>Se me ve desde bien lejos...<clear><br><$voicel(1,5)><$motion(1,803)><$facial(1,1)><$comeff(1,14)>El otro día me caí de bruces y lo vio todo el mundo,<br>y encima vinieron corriendo a ayudarme...<clear><br><$voicel(1,8)><$motion(1,807)><$comeff(1,4)>Fueron todos muy majos, pero... ¡qué vergüenza!"
msgstr "<$voicel(1,3)><$motion(1,805)><$comeff(1,7)><$facial(1,9)>Me encantaría pasar desapercibid<gen;-3(o,a)>, pero no puedo...<br>Se me ve desde bien lejos...<clear><br><$voicel(1,5)><$motion(1,803)><$facial(1,1)><$comeff(1,14)>El otro día me caí de bruces y lo vio todo el mundo,<br>y encima vinieron corriendo a ayudarme...<clear><br><$voicel(1,8)><$motion(1,807)><$comeff(1,4)>Fueron todos muy amables, pero... ¡qué vergüenza!"

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,8)>I just love <$cdef(27)><fqty(1)><$ifull(1280)>s</color>... <$voicel(1,6)><$motion(1,805)><$facial(1,1)>The way the flame waves back<br>and forth—it’s like it’s trying to give me a hug...<$voicel(1,10)><$emotion(1,39)> It makes<slide><br>me feel all warm inside too...
msgctxt "1995:535"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,8)>No hay nada como una buena <$cdef(27)><fqty(1)><$ifull(1280)></color>...<br>Me encanta mirar el vaivén de las llamas...<clear><br><$voicel(1,6)><$motion(1,805)><$facial(1,1)>Siento como... no sé, como si su calidez me arropara...<br><$voicel(1,10)><$emotion(1,39)>y eso me reconforta enter<gen;-3(o,a)> por dentro."
msgstr ""

#. en: <$voicel(1,9)><$emotion(1,7)>I absolutely love flowers! They’re pretty, they smell good...<clear><br><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>Plus, watching them do their best to grow tall and<br>beautiful gives me courage too...
msgctxt "1995:537"
msgid "<$voicel(1,9)><$emotion(1,7)>Cómo me gustan las flores... Son tan chulas... y huelen<br>siempre tan bien...<clear><br><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>Cuando veo lo mucho que te esfuerzas para que crezcan,<br>me entran ganas de darlo todo yo también..."
msgstr "<$voicel(1,9)><$emotion(1,7)>Cómo me gustan las flores... Son tan bonitas... y huelen<br>siempre tan bien...<clear><br><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>Cuando veo lo mucho que te esfuerzas para que crezcan,<br>me entran ganas de darlo todo yo también..."

#. en: <$voicel(1,5)><$emotion(1,14)>I-I have this habit of sending off little sparks when I<br>get nervous...<clear><br><$voicel(1,3)><$motion(1,805)><$comeff(1,14)>It’s, um, shocking to other Pokémon, so I wish I could stop...<br>But...<$voicel(1,2)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>I think that’ll be a while...
msgctxt "1995:538"
msgid "<$voicel(1,5)><$emotion(1,14)>Cuando me entran los nervios, se me sube la electricidad<br>y s-suelto chispazos sin querer...<clear><br><$voicel(1,3)><$motion(1,805)><$comeff(1,14)>A veces doy calambre a quien esté cerca, así que tengo<br>que buscar una forma de remediarlo...<clear><br><$voicel(1,2)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>Pero es que no se me ocurre qué puedo hacer..."
msgstr "<$voicel(1,5)><$emotion(1,14)>Cuando me entran los nervios, se me sube la electricidad<br>y s-suelto chispazos sin querer...<clear><br><$voicel(1,3)><$motion(1,805)><$comeff(1,14)>A veces le doy descargas a quien esté cerca, así que tengo<br>que buscar una forma de remediarlo...<clear><br><$voicel(1,2)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>Pero es que no se me ocurre qué puedo hacer..."

#. en: <$comeff(1,3)><$motion(1,803)><$voicel(1,5)>If I try really hard, I can see the future just a little bit. But,<br>like...<$comeff(1,23)><$motion(1,802)><$voicel(1,4)>seeing the future’s really scary.<clear><br><$comeff(1,14)><$motion(1,805)><$voicel(1,2)>I’m always afraid I’ll see myself with no friends, alone...<clear><br><$comeff(1,5)><$motion(1,801)><$voicel(1,7)>But now that I think about it, maybe I don’t need to worry.<br>I’ve got you, right, <$cdef(27)><pname;1></color>?
msgctxt "1995:539"
msgid "<$comeff(1,3)><$motion(1,803)><$voicel(1,5)>Si me concentro, soy capaz de ver las cosas que van<br>a pasar dentro de poco...<clear><br><$comeff(1,23)><$motion(1,802)><$voicel(1,4)>Aunque a veces da un poco de miedo saber qué es lo<br>que va a suceder...<$comeff(1,14)><$motion(1,805)><$voicel(1,2)> ¿Y si viera que me quedo sin amigos?<clear><br><$comeff(1,5)><$motion(1,801)><$voicel(1,7)>Aunque bueno, s-sé que siempre te tendría a ti..."
msgstr ""

#. en: <$voicel(1,5)><$motion(1,803)><$comeff(1,10)>I hope someday we get some snow here...<clear><br><$voicel(1,7)><$emotion(1,39)>It’s really calming, you know? The air gets this wonderful<br>chill, and everything gets so quiet...
msgctxt "1995:540"
msgid "<$voicel(1,5)><$motion(1,803)><$comeff(1,10)>Ojalá nieve aquí también algún día...<clear><br><$voicel(1,7)><$emotion(1,39)>Respirar aire frío me hace sentir tanta paz..."
msgstr ""

#. en: <$voicel(1,3)><$emotion(1,14)>I-I’m honestly not very good at scaring other Pokémon...<clear><br><$voicel(1,1)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>Nobody ever talks about how brave you have to be to<br>actually try and scare someone...
msgctxt "1995:541"
msgid "<$voicel(1,3)><$emotion(1,14)>Te confieso que... n-no se me da bien dar sustos...<clear><br><$voicel(1,1)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>Para asustar a los demás, también hace falta valor."
msgstr ""

#. en: <$voicel(1,5)><$emotion(1,14)>So, you know those humans who’re supposed to have<br>lived around here?<clear><br><$voicel(1,3)><$motion(1,805)><$comeff(1,14)><$facial(1,9)>Well...I was thinking... M-maybe they’re all kinda shy and<br>introverted like me.<$voicel(1,2)><$facial(1,1)> Maybe they’re just hiding ’cause<slide><br>something made them all real anxious?<clear><br><$voicel(1,4)><$motion(1,807)><$comeff(1,10)>No... I guess that’s a bit too far-fetched...
msgctxt "1995:542"
msgid "<$voicel(1,5)><$emotion(1,14)>Hay una cosa que no paro de preguntarme.<br>Es acerca de los humanos que vivían aquí antes...<clear><br><$voicel(1,3)><$motion(1,805)><$comeff(1,14)><$facial(1,9)>¿Y si resulta que... que son tan tímidos como yo?<br><$voicel(1,2)><$facial(1,1)>¿Y en realidad están escondidos en alguna parte?...<clear><br><$voicel(1,4)><$motion(1,807)><$comeff(1,10)>N-no, qué tonterías digo..."
msgstr ""

#. en: <oneline><$voicel(1,5)><$emotion(1,14)>You’re so kind to everyone, <$cdef(27)><pname;0></color>...<br>It’s<slide><br>no<slide><br>wonder<slide><br>everybody<slide><br>looks<slide><br>up<slide><br>to you...<clear><br><$voicel(1,10)><$emotion(1,39)>I really wish I could be like you... <$voicel(1,7)><$motion(1,805)><$comeff(1,6)><$facial(1,1)>M-maybe you could be<br>like...my spiritual sensei?
msgctxt "1995:543"
msgid "<oneline><$voicel(1,5)><$emotion(1,14)><$cdef(27)><pname;0></color>, eres tan amable y ayudas<br>tanto<slide><br>a los demás<slide><br>Pokémon...<slide><br><$voicel(1,10)><$emotion(1,39)>Te admiro un montón.<clear><br><$voicel(1,7)><$motion(1,805)><$comeff(1,6)><$facial(1,1)>Oye... ¿Te importaría que te cuente mis preocupaciones?<br>Es que... seguro que das buenos consejos..."
msgstr ""

#. en: <$voicel(1,5)><$motion(1,805)><$comeff(1,14)>If I could transform like you...<clear><br><$voicel(1,7)><$comeff(1,21)><$facial(1,4)>I could help everyone out and make lots and lots of<br>friends...<$voicel(1,10)><$emotion(1,8)> Then, maybe everyone would look up to me!<clear><br><$voicel(1,5)><$motion(1,803)><$comeff(1,6)><$facial(1,1)>It’s...it’s OK if I think about this kind of stuff as I go to<br>sleep, right? So I can have good dreams?
msgctxt "1995:544"
msgid "<oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,14)>Ojalá pudiera transformarme como haces tú,<br><$cdef(27)><pname;1></color>...<clear><br><$voicel(1,7)><$comeff(1,21)><$facial(1,4)>Podría aprender un montón de movimientos distintos,<br>me haría amig<gen;-3(o,a)> de todos los demás Pokémon...<slide><br><$voicel(1,10)><$emotion(1,8)>y confiarían en mí para ayudarles con sus problemas...<clear><br><$voicel(1,5)><$motion(1,803)><$comeff(1,6)><$facial(1,1)>¿E-está mal que me imagine estas cosas antes de dormir?"
msgstr "<oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,14)>Ojalá pudiera transformarme como haces tú,<br><$cdef(27)><pname;1></color>...<clear><br><$voicel(1,7)><$comeff(1,21)><$facial(1,4)>Podría aprender un montón de movimientos distintos,<br>me haría amig<gen;-3(o,a)> de todos los demás Pokémon...<slide><br><$voicel(1,10)><$emotion(1,8)>y confiarían en mí para ayudarlos con sus problemas...<clear><br><$voicel(1,5)><$motion(1,803)><$comeff(1,6)><$facial(1,1)>¿E-está mal que me imagine estas cosas antes de dormir?"

#. en: <$voicel(1,3)><$motion(1,805)><$comeff(1,7)>Whenever I do anything embarrassing, <$voicel(1,6)><$motion(1,803)><$comeff(1,10)>I just run at top<br>speed going “AAAAAAAAAHHHHHH.”<clear><br><$voicel(1,7)><$comeff(1,14)>I mean, obviously I only do it when nobody’s around but...<br>If you do ever spot me doing that, just...<$voicel(1,4)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>just pretend you<slide><br>didn’t see anything, OK?
msgctxt "1995:545"
msgid "<$voicel(1,3)><$motion(1,805)><$comeff(1,7)>Cuando meto la pata, a veces me da mucha vergüenza<br>y no puedo evitar echarme a llorar <$voicel(1,6)><$motion(1,803)><$comeff(1,10)>y salir corriendo...<clear><br><$voicel(1,7)><$comeff(1,14)>Intento esconderme donde no haya nadie, p-pero...<br>si alguna vez me ves en plena crisis...<slide><br><$voicel(1,4)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>haz como que no me has visto, ¿vale?"
msgstr "<$voicel(1,3)><$motion(1,805)><$comeff(1,7)>Cuando meto la pata, a veces me da mucha vergüenza<br>y no puedo evitar echarme a llorar <$voicel(1,6)><$motion(1,803)><$comeff(1,10)>y salir corriendo...<clear><br><$voicel(1,7)><$comeff(1,14)>Intento esconderme donde no haya nadie, p-pero...<br>si alguna vez me ves en plena crisis...<slide><br><$voicel(1,4)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>haz como que no me viste, ¿sí?"

#. en: <oneline><$voicel(1,5)><$emotion(1,14)>Oh, hi there, <$cdef(27)><pname;0></color>! I was just playing<br>with<slide><br><$cdef(27)><nlpairpk;1></color>.<clear><br><$voicel(1,7)><$emotion(1,8)>For some reason, I can play with them without getting<br>all nervous!
msgctxt "1995:546"
msgid "<$cdef(27)><oneline></color><$voicel(1,5)><$emotion(1,14)>Ah, hola, <$cdef(27)><pname;0></color>. He estado antes<br>jugando<slide><br>con <dart;1()><$cdef(27)><nlpairpk;1></color>...<clear><br><$voicel(1,7)><$emotion(1,8)>¡Y no me he p-puesto nervios<gen;-3(o,a)>! Creo que estoy muy<br>a gusto con <gen;1(él,ella)>."
msgstr "<$cdef(27)><oneline></color><$voicel(1,5)><$emotion(1,14)>Ah, hola, <$cdef(27)><pname;0></color>. Hace rato estuve<br>jugando<slide><br>con <dart;1()><$cdef(27)><nlpairpk;1></color>...<clear><br><$voicel(1,7)><$emotion(1,8)>¡Y no me p-puse nervios<gen;-3(o,a)>! Creo que estoy muy<br>a gusto con <gen;1(él,ella)>."

#. en: <oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Hey, <$cdef(27)><pname;0></color>... You know <qty;1(that,those)><br><$cdef(27)><fqty(1)><class><nlqueitem;1></color><slide><br>you<slide><br>gave me?<clear><br><qty;1(It was,They were)> really delicious!<$voicel(1,9)><$emotion(1,7)> There’s something special<br>about a snack from a friend, isn’t there?
msgctxt "1995:547"
msgid "<oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Oye, <$cdef(27)><pname;0></color>...<br><fcap><dart;1()><$cdef(27)><fqty(1)><nlqueitem;1></color><slide><br>que me diste<slide><br>estab<qty;1(a,an)> bien ric<genqty;1(o,a,os,as)>.<clear><br><$voicel(1,9)><$emotion(1,7)>¡C-creo que me <qty;1(gustó,gustaron)> aún más por ser un regalo<br>de <gen;-2(un amigo,una amiga)> tan buen<gen;-2(o,a)> como tú!"
msgstr ""

#. en: <oneline><$voicel(1,5)><$emotion(1,14)>I’ve always wanted to chat with<br><$cdef(27)><crstlktar;0></color>,<slide><br>you know?<clear><br><$voicel(1,8)><$emotion(1,39)>Maybe one of these days I’ll work up the courage to pay<br>them a visit.<clear><br><$voicel(1,5)><$motion(1,805)><$comeff(1,14)><$facial(1,1)>...Once they live a little closer. Yeah...that’s when I’ll<br>do it.
msgctxt "1995:548"
msgid "<oneline><$voicel(1,5)><$emotion(1,14)>Hace mucho que quiero charlar con<br><dart;0()><$cdef(27)><crstlktar;0></color>...<slide><br><$voicel(1,8)><$emotion(1,39)>Ojalá algún día tenga el valor de ir a presentarme.<clear><br><$voicel(1,5)><$motion(1,805)><$comeff(1,14)><$facial(1,1)>Si viviéramos más cerca, me sería más fácil dar el paso..."
msgstr ""

#. en: <oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,14)>I sure do wish I could be friends with<br><$cdef(27)><crstlktar;0></color>...<clear><br><$voicel(1,3)><$motion(1,807)><$comeff(1,7)>But I guess I won’t have much luck running into them<br>around here... Maybe I could <$voicel(1,8)><$motion(1,803)><$comeff(1,10)>move closer to where<slide><br>they live...
msgctxt "1995:549"
msgid "<$cdef(27)><oneline></color><$voicel(1,5)><$motion(1,805)><$comeff(1,14)>Ojalá pudiera hacerme amig<gen;-3(o,a)><br><esde;0()><$cdef(27)><crstlktar;0></color>,<slide><br><$voicel(1,3)><$motion(1,807)><$comeff(1,7)>pero nunca me<slide><br><gen;0(lo,la)> encuentro por aquí...<clear><br><$voicel(1,8)><$motion(1,803)><$comeff(1,10)>No sé, a lo mejor debería mudarme para vivir más cerca<br>de <gen;0(él,ella)>..."
msgstr ""

#. en: <$voicel(1,10)><$motion(1,803)><$comeff(1,9)><$facial(1,5)>Thanks for hanging out with me. Here, this is for you.
msgctxt "1995:550"
msgid "<$voicel(1,10)><$motion(1,803)><$comeff(1,9)><$facial(1,5)>Gracias por participar... A-acepta este pequeño<br>obsequio..."
msgstr ""

#. en: <$voicel(1,9)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>This house is really great! I can relax and have time to be<br>by myself...<clear><br><$voicel(1,7)><$motion(1,805)><$facial(1,1)><$comeff(1,14)>I still can’t believe that I get to live in a lovely house like<br>this... <$voicel(1,10)><$emotion(1,7)>Thanks so much, <$cdef(27)><pname;0></color>!
msgctxt "1995:551"
msgid "<$voicel(1,9)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>¡E-esta casa es una pasada! Me encanta pasarme aquí<br>las horas descansando y a mi bola...<clear><br><$voicel(1,7)><$motion(1,805)><$facial(1,1)><$comeff(1,14)>Todavía no me creo la suerte que tengo de vivir en una<br>casa así de chula...<clear><br><$voicel(1,10)><$emotion(1,7)>Muchas gracias, <$cdef(27)><pname;0></color>."
msgstr "<$voicel(1,9)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>¡E-esta casa es increíble! Me encanta pasarme aquí<br>las horas descansando a mi ritmo...<clear><br><$voicel(1,7)><$motion(1,805)><$facial(1,1)><$comeff(1,14)>Todavía no me creo la suerte que tengo de vivir en una<br>casa así de bonita...<clear><br><$voicel(1,10)><$emotion(1,7)>Muchas gracias, <$cdef(27)><pname;0></color>."

#. en: <$voicel(1,8)><$emotion(1,14)><$facial(1,4)>Give me your best guess, OK?<clear><br><$voicel(1,5)><$motion(1,805)><$comeff(1,6)><$facial(1,1)>What’s <$cdef(27)><qtargetpk;0></color>’s favorite flavor?
msgctxt "1995:552"
msgid "<$voicel(1,8)><$emotion(1,14)><$facial(1,4)>Va, a ver si consigues acertar...<clear><br><$voicel(1,5)><$motion(1,805)><$comeff(1,6)><$facial(1,1)>¿Cuál es el sabor favorito <esde;0()><$cdef(27)><qtargetpk;0></color>?"
msgstr "<$voicel(1,8)><$emotion(1,14)><$facial(1,4)>Bueno, a ver si consigues acertar...<clear><br><$voicel(1,5)><$motion(1,805)><$comeff(1,6)><$facial(1,1)>¿Cuál es el sabor favorito <esde;0()><$cdef(27)><qtargetpk;0></color>?"

#. en: <oneline><$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,20)>Correct! Wow, that’s pretty impressive,<br><$cdef(27)><pname;0></color>!
msgctxt "1995:554"
msgid "...<wait(0.4)><$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,20)> ¡Correcto! Tú sí que sabes, <$cdef(27)><pname;0></color>."
msgstr ""

#. en: <oneline><$voicel(1,4)><$motion(1,807)><$comeff(1,4)>Aww, too bad—that’s incorrect... <$voicel(1,6)><$motion(1,803)><$comeff(1,10)>The answer is<br><$cdef(27)><ltasteq;0></color>.<clear><br><$voicel(1,7)><$emotion(1,8)>B-but I hope we can play again! I’ll try and come up with<br>more questions too...
msgctxt "1995:555"
msgid "... <wait(0.4)><$voicel(1,4)><$motion(1,807)><$comeff(1,4)>Ay, no, qué pena...<clear><br><$voicel(1,6)><$motion(1,803)><$comeff(1,10)>La respuesta correcta era el <$cdef(27)><ltasteq;0></color>.<clear><br><$voicel(1,7)><$emotion(1,8)>Pero que eso no te desanime, seguro que la próxima vez<br>aciertas. Voy a ir pensando otra pregunta..."
msgstr ""

#. en: <$voicel(1,8)><$emotion(1,14)><$facial(1,4)>Give me your best guess, OK?<clear><br><$voicel(1,5)><$motion(1,805)><$comeff(1,6)><$facial(1,1)>What’s <$cdef(27)><qtargetpk;0></color>’s least favorite flavor?
msgctxt "1995:557"
msgid "<oneline><$voicel(1,8)><$emotion(1,14)><$facial(1,4)>Veamos si consigues acertar...<clear><br><$voicel(1,5)><$motion(1,805)><$comeff(1,6)><$facial(1,1)>¿Qué sabor no le gusta nada de nada<br><esa;0()><$cdef(27)><qtargetpk;0></color>?"
msgstr ""

#. en: <oneline><$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,20)>Correct! Wow, that’s pretty impressive,<br><$cdef(27)><pname;0></color>!
msgctxt "1995:559"
msgid "<oneline>...<wait(0.4)><$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,20)> ¡Correcto! ¿Cómo sabes tanto,<br><$cdef(27)><pname;0></color>?"
msgstr ""

#. en: <oneline><$voicel(1,4)><$motion(1,807)><$comeff(1,4)>Aww, too bad—that’s incorrect... <$voicel(1,6)><$motion(1,803)><$comeff(1,10)>The answer is<br><$cdef(27)><htasteq;0></color>.<clear><br><$voicel(1,7)><$emotion(1,39)>B-but I hope we can play again! I’ll try and come up with<br>more questions too...
msgctxt "1995:560"
msgid "... <wait(0.4)><$voicel(1,4)><$motion(1,807)><$comeff(1,4)>Pues va a ser que no...<clear><br><$voicel(1,6)><$motion(1,803)><$comeff(1,10)>La respuesta correcta era <dart;0()><$cdef(27)><htasteq;0></color>.<clear><br><$voicel(1,7)><$emotion(1,39)>Bueno, yo voy a ir pensando en otra pregunta por si te<br>ape otro día..."
msgstr "... <wait(0.4)><$voicel(1,4)><$motion(1,807)><$comeff(1,4)>Pues parece que no...<clear><br><$voicel(1,6)><$motion(1,803)><$comeff(1,10)>La respuesta correcta era <dart;0()><$cdef(27)><htasteq;0></color>.<clear><br><$voicel(1,7)><$emotion(1,39)>Bueno, yo voy a ir pensando en otra pregunta por si<br>quieres jugar otro día..."

#. en: <$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>All right, gimme your best guess...<clear><br><$voicel(1,5)><$motion(1,805)><$comeff(1,6)><$facial(1,1)>What kind of thing does <$cdef(27)><qtargetpk;0></color> like?
msgctxt "1995:562"
msgid "<$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>A ver si la aciertas...<clear><br><$voicel(1,5)><$motion(1,805)><$comeff(1,6)><$facial(1,1)>¿Qué le gusta <esa;0()><$cdef(27)><qtargetpk;0></color>?"
msgstr ""

#. en: <oneline><$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,20)>That’s correct! You’re good at this,<br><$cdef(27)><pname;0></color>!
msgctxt "1995:564"
msgid "<oneline>Pues... <wait(0.4)><$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,20)>¡has acertado! ¡Qué list<gen;-2(o,a)> eres,<br><$cdef(27)><pname;0></color>!"
msgstr "<oneline>Pues... <wait(0.4)><$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,20)>¡acertaste! ¡Qué list<gen;-2(o,a)> eres,<br><$cdef(27)><pname;0></color>!"

#. en: <$voicel(1,4)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>Aww, close, but that’s incorrect!<clear><br><$voicel(1,6)><$motion(1,803)><$facial(1,1)><$comeff(1,10)>The correct answer is <fqty(2)><$cdef(27)><likemtag;0></color>!<clear><br><$voicel(1,7)><$emotion(1,8)>D-don’t be afraid to try again though, OK? I’ll come up<br>with new questions too...
msgctxt "1995:565"
msgid "Pues... <wait(0.4)><$voicel(1,4)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>¡Casi! Pero no...<clear><br><$voicel(1,6)><$motion(1,803)><$facial(1,1)><$comeff(1,10)>La respuesta correcta era <dart;0()><$cdef(27)><likemtag;0></color>.<clear><br><$voicel(1,7)><$emotion(1,8)>No te desanimes... Por mí jugamos otro día. Cuando<br>se me ocurran más preguntas, claro..."
msgstr ""

#. en: <$voicel(1,10)><$emotion(1,1)>Let’s hang out again soon, OK?
msgctxt "1995:566"
msgid "<$voicel(1,10)><$emotion(1,1)>Hasta la próxima... ¿vale?"
msgstr "<$voicel(1,10)><$emotion(1,1)>Hasta la próxima... ¿sí?"

#. en: <oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,14)>Hey, <$cdef(27)><pname;0></color>... You have some<br><fqty(2)><$cdef(27)><class><refmateid;1></color><slide><br>with<slide><br>you, right?<clear><br><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>If you want, I can turn them into<br><fqty(2)><$cdef(27)><class><reftarid;3></color>...
msgctxt "1995:569"
msgid "<oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,14)>Ah, hola, <$cdef(27)><pname;0></color>... Llevas <genqty;1(algún,alguna,algunos,algunas)><br><$cdef(27)><fqty(1)><class><refmateid;1></color><slide><br>encima, ¿verdad?<clear><br><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Si me <genqty;1(lo,la,los,las)> das, podría procesar<genqty;1(lo,la,los,las)> para darte<br><$cdef(27)><fqty(2)><class><reftarid;3></color>."
msgstr ""

#. en: <oneline><$voicel(1,3)><$motion(1,805)><$comeff(1,14)>Oh, um... I don’t know much about<br><fqty(2)><$cdef(27)><class><referrmate;0></color>...<clear><br><$voicel(1,6)><$emotion(1,14)>B-but maybe <$cdef(27)><referrpk;1></color> can help you?
msgctxt "1995:570"
msgid "<oneline><$voicel(1,3)><$motion(1,805)><$comeff(1,14)>L-lo siento... No tengo ni idea de cómo se proces<qty;0(a,an)><br><dart;0()><$cdef(27)><fqty(2)><class><referrmate;0></color>...<clear><br><$voicel(1,6)><$emotion(1,14)>Pero a lo mejor <dart;1()><$cdef(27)><referrpk;1> </color>te puede ayudar..."
msgstr ""

#. en: <oneline><$voicel(1,3)><$motion(1,805)><$comeff(1,14)>Oh, um... I don’t know much about<br><fqty(2)><$cdef(27)><class><referrmate;0></color>...<clear><br><$voicel(1,2)><$motion(1,807)><$comeff(1,7)><$facial(1,9)>I can’t think of anyone who might be able to help either...
msgctxt "1995:571"
msgid "<oneline><$voicel(1,3)><$motion(1,805)><$comeff(1,14)>L-lo siento... No tengo ni idea de cómo se proces<qty;0(a,an)><br><dart;0()><$cdef(27)><fqty(2)><class><referrmate;0></color>...<clear><br><$voicel(1,2)><$motion(1,807)><$comeff(1,7)><$facial(1,9)>Y ahora mismo no se me ocurre quién te podría ayudar<br>tampoco..."
msgstr ""

#. en: <oneline><$voicel(1,3)><$motion(1,807)><$comeff(1,7)>Oh, um... I don’t know much about<br><fqty(2)><$cdef(27)><class><referrmate;0></color>...<clear><br><$voicel(1,5)><$emotion(1,14)>Oh! B-but I can turn any<br><fqty(2)><$cdef(27)><class><refmateid;2></color><slide><br>you’ve<slide><br>got<slide><br>into<slide><br><$voicel(1,8)><$comeff(1,14)><fqty(2)><$cdef(27)><class><reftarid;3></color><slide><br>if<slide><br>you’d like...<clear><br><$voicel(1,6)><$motion(1,805)><$comeff(1,6)>What d’you say...?
msgctxt "1995:572"
msgid "<oneline><$voicel(1,3)><$motion(1,807)><$comeff(1,7)>L-lo siento... No tengo ni idea de cómo se proces<qty;0(a,an)><br><dart;0()><$cdef(27)><fqty(2)><class><referrmate;0></color>...<clear><br><$voicel(1,5)><$emotion(1,14)>Pero veo que llevas <genqty;2(algún,alguna,algunos,algunas)><br><fqty(1)><class><$cdef(27)><refmateid;2></color>.<clear><br><$voicel(1,8)><$comeff(1,14)>Si me <genqty;2(lo,la,los,las)> das, podría procesar<genqty;2(lo,la,los,las)> para darte<br><$cdef(27)><fqty(2)><class><reftarid;3></color>.<clear><br><$voicel(1,6)><$motion(1,805)><$comeff(1,6)>¿Qué me dices?..."
msgstr ""

#. en: <oneline><$voicel(1,6)><$motion(1,805)><$comeff(1,14)><fcap><fqty(2)><$cdef(27)><class><reftarid;0></color>,<br>huh...?<clear><br><$voicel(1,7)><$emotion(1,14)>If you could leave some<br><fqty(2)><$cdef(27)><class><refmateid;2></color><slide><br>in<slide><br>the<slide><br><$cdef(27)><fqty(1)><reftable;1></color>,<slide><br><$voicel(1,6)><$motionoff(1,804)><$comeff(1,10)>I’ll<slide><br>get<slide><br>to<slide><br>work<slide><br>on<slide><br>it later...
msgctxt "1995:573"
msgid "<oneline><$voicel(1,6)><$motion(1,805)><$comeff(1,14)>Ah... ¿Necesitas<br><fqty(2)><$cdef(27)><class><reftarid;0></color>?<clear><br><$voicel(1,7)><$emotion(1,14)>Déjame<br><dart;2()><fqty(1)><class><$cdef(27)><refmateid;2><slide><br></color>en <dart;1()><$cdef(27)><fqty(1)><class><reftable;1></color>.<slide><br><$voicel(1,6)><$motionoff(1,804)><$comeff(1,10)>Ahora me pongo<slide><br>a procesar<genqty;2(lo,la,los,las)>..."
msgstr ""

#. en: <oneline><$voicel(1,3)><$motion(1,807)><$comeff(1,14)>I need<br><iart;1()><$cdef(27)><fqty(1)><reftable;1></color><slide><br>to<slide><br>make<slide><br><fqty(2)><$cdef(27)><class><reftarid;0></color>...<clear><br><$voicel(1,5)><$motion(1,805)><$comeff(1,6)>D-do you mind getting<br><iart;2()><$cdef(27)><fqty(1)><reftable;2></color><slide><br>for<slide><br>me first?
msgctxt "1995:574"
msgid "<oneline><$voicel(1,3)><$motion(1,807)><$comeff(1,14)>P-para obtener<br><$cdef(27)><fqty(2)><class><reftarid;0></color>,<slide><br>necesito<slide><br><iart;1()><$cdef(27)><fqty(1)><class><reftable;1></color>.<clear><br><$voicel(1,5)><$motion(1,805)><$comeff(1,6)>¿Me puedes conseguir <genqty;1(uno,una,unos,unas)>?"
msgstr ""

#. en: <$voicel(1,9)><$emotion(1,39)>Oh, I also made something else... It’s pretty amazing!<br><$voicel(1,8)><$motion(1,803)><$comeff(1,9)>Here, take this!
msgctxt "1995:575"
msgid "<$voicel(1,9)><$emotion(1,39)>Ah, y mira... También me ha salido algo muy chulo.<br>No me lo esperaba para nada, ¿eh? <wait(0.5)><$voicel(1,8)><$motion(1,803)><$comeff(1,9)>Toma, para ti..."
msgstr "<$voicel(1,9)><$emotion(1,39)>Ah, y mira... También me salió algo muy bonito.<br>No me lo esperaba para nada, ¿eh? <wait(0.5)><$voicel(1,8)><$motion(1,803)><$comeff(1,9)>Toma, para ti..."

#. en: <$voicel(1,5)><$emotion(1,14)>Oh, hey... Do you want this? I found it on my way here.
msgctxt "1995:576"
msgid "<$voicel(1,5)><$emotion(1,14)>A-ah, sí... Me he encontrado esto de camino hacia aquí<br>y quería dártelo."
msgstr "<$voicel(1,5)><$emotion(1,14)>A-ah, sí... Me encontré esto de camino hacia aquí<br>y quería dártelo."

#. en: <oneline><$comeff(1,3)><$motion(1,803)><$voicel(1,8)>Oh, <$cdef(27)><pname;0></color>!<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>The <$cdef(27)><cdirbname;1></color>’s done, if<br>you<slide><br>wanna<slide><br>come<slide><br>have<slide><br>a look!
msgctxt "1995:585"
msgid "<oneline><$comeff(1,3)><$motion(1,803)><$voicel(1,8)>¡Ah, <$cdef(27)><pname;0></color>!...<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,806)><$voicel(1,7)>¡Ya est<qty;1(á,án)> terminad<genqty;1(o,a,os,as)><br><dart;1()><$cdef(27)><cdirbname;1></color>!<slide><br>Échale un vistazo, si quieres..."
msgstr ""

#. en: <$voicel(1,8)>OK, time for the big reveal...<wait(0.4)><br><$comeff(1,5)><$motion(1,801)><$voicel(1,10)>Ta-da!
msgctxt "1995:586"
msgid "<$voicel(1,8)>Hora de ver cómo ha quedado...<wait(0.4)> <$comeff(1,5)><$motion(1,801)><$voicel(1,10)>¡Atención!"
msgstr "<$voicel(1,8)>Hora de ver cómo quedó...<wait(0.4)> <$comeff(1,5)><$motion(1,801)><$voicel(1,10)>¡Atención!"

#. en: <$comeff(1,6)><$motion(1,805)><$voicel(1,5)>S-so what d’you think? I think it turned out pretty<br>good, myself...<clear><br><$comeff(1,3)><$motion(1,806)><$voicel(1,7)>So, um... Just let me know if you’re ever gonna <$cdef(27)><$spwfull(1)></color><br>something again, OK?
msgctxt "1995:587"
msgid "<$comeff(1,6)><$motion(1,805)><$voicel(1,5)>¿Qué opinas? Yo creo que ha salido bien...<clear><br><$comeff(1,3)><$motion(1,806)><$voicel(1,7)>Si vuelves a necesitar ayuda para <$cdef(27)><$spwfull(1)></color> alguna otra<br>cosa, me haría ilusión que me la pidieras a mí..."
msgstr "<$comeff(1,6)><$motion(1,805)><$voicel(1,5)>¿Qué opinas? Yo creo que salió bien...<clear><br><$comeff(1,3)><$motion(1,806)><$voicel(1,7)>Si vuelves a necesitar ayuda para <$cdef(27)><$spwfull(1)></color> alguna otra<br>cosa, me encantaría que me la pidieras a mí..."

#. en: <$voicel(1,7)><$motion(1,805)><$comeff(1,6)>Hey, so, um...I was wondering... Do you wanna play “look<br>that way” with me?
msgctxt "1995:593"
msgid "<$voicel(1,7)><$motion(1,805)><$comeff(1,6)>Oye... ¿Te apetece jugar a \"esquiva la baya\" conmigo?"
msgstr "<$voicel(1,7)><$motion(1,805)><$comeff(1,6)>Oye... ¿Quieres jugar a \"esquiva la baya\" conmigo?"

#. en: <$voicel(1,7)><$emotion(1,8)>R-really? We can play? Yay! Thank you!
msgctxt "1995:594"
msgid "<$voicel(1,7)><$emotion(1,8)>¿En serio? Jo, qué bien. Vale, ¡verás qué divertido!"
msgstr "<$voicel(1,7)><$emotion(1,8)>¿En serio? Ay, qué bien. ¡Verás qué divertido!"

#. en: <$voicel(1,5)><$emotion(1,14)>Oh, OK... Maybe we can play another time...
msgctxt "1995:595"
msgid "<$voicel(1,5)><$emotion(1,14)>Ah, bueno, vale, no pasa nada. Si te apetece otro rato..."
msgstr "<$voicel(1,5)><$emotion(1,14)>Ah, bueno, no pasa nada. Si quieres otro rato..."

#. en: <oneline><$voicel(1,10)><$emotion(1,8)>Hey, you won, <$cdef(27)><pname;0></color>!<br>Congratulations!<clear><br><$voicel(1,7)><$motion(1,803)><$comeff(1,10)>I’m gonna try even harder next time, so...so I hope there is<br>a next time!
msgctxt "1995:596"
msgid "<oneline><$voicel(1,10)><$emotion(1,8)>Jo, lo has hecho genial, <$cdef(27)><pname;0></color>.<br>¡Enhorabuena!<clear><br><$voicel(1,7)><$motion(1,803)><$comeff(1,10)>A ver si se me da mejor la próxima vez que juguemos..."
msgstr "<oneline><$voicel(1,10)><$emotion(1,8)>Ay, lo hiciste genial, <$cdef(27)><pname;0></color>.<br>¡Felicidades!<clear><br><$voicel(1,7)><$motion(1,803)><$comeff(1,10)>A ver si se me da mejor la próxima vez que juguemos..."

#. en: <oneline><$voicel(1,7)><$emotion(1,14)>...Wait, I won? Oh wow... That makes me happy!<clear><br><$voicel(1,9)><$emotion(1,8)>Thanks for playing with me, <$cdef(27)><pname;1></color>.<br>I<slide><br>hope<slide><br>we<slide><br>can<slide><br>play<slide><br>together<slide><br>again<slide><br>sometime...
msgctxt "1995:597"
msgid "<$voicel(1,7)><$emotion(1,14)>¿Cómo? ¿En serio he ganado yo? No me lo puedo creer...<br>Ay, qué ilusión.<clear><br><$voicel(1,9)><$emotion(1,8)>Jo, muchas gracias por jugar conmigo. ¡Espero que<br>repitamos pronto!"
msgstr "<$voicel(1,7)><$emotion(1,14)>¿Cómo? ¿En serio gané yo? No me lo puedo creer...<br>Ay, qué alegría.<clear><br><$voicel(1,9)><$emotion(1,8)>Muchas gracias por jugar conmigo. ¡Espero que<br>repitamos pronto!"

#. en: <$voicel(1,7)><$motion(1,805)><$comeff(1,6)>So um... D-do you wanna play hide-and-sneak together?<br>I’ll be “it,” so <$voicel(1,5)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>you...you can go hide...
msgctxt "1995:610"
msgid "<$voicel(1,7)><$motion(1,805)><$comeff(1,6)>Erm... O-oye... ¿Quieres jugar al escondite camuflado?<br>Yo te busco, ¿vale?<clear><br><$voicel(1,5)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Y tú te escondes... Si te apetece jugar, claro..."
msgstr "<$voicel(1,7)><$motion(1,805)><$comeff(1,6)>Erm... O-oye... ¿Quieres jugar al escondite camuflado?<br>Yo te busco, ¿sí?<clear><br><$voicel(1,5)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Y tú te escondes... Si quieres jugar, claro..."

#. en: <$voicel(1,7)><$emotion(1,8)>Really?! Great! I’ll do my best!
msgctxt "1995:611"
msgid "<$voicel(1,7)><$emotion(1,8)>¿De verdad? ¡Genial! Entonces... ¡vamos a jugar!"
msgstr ""

#. en: <$voicel(1,5)><$emotion(1,14)>Oh, OK... Maybe we can play another time...
msgctxt "1995:612"
msgid "<$voicel(1,5)><$emotion(1,14)>Ah... Bueno... Cuando te apetezca, no te preocupes."
msgstr "<$voicel(1,5)><$emotion(1,14)>Ah... Bueno... Cuando quieras, no te preocupes."

#. en: <$voicel(1,7)><$emotion(1,39)>You won, <$cdef(27)><pname;0></color>! I’m impressed...
msgctxt "1995:617"
msgid "<oneline><$voicel(1,7)><$emotion(1,39)>Me has ganado, <$cdef(27)><pname;0></color>.<br>Qué bien juegas..."
msgstr "<oneline><$voicel(1,7)><$emotion(1,39)>Me ganaste, <$cdef(27)><pname;0></color>.<br>Qué bien juegas..."

#. en: <$voicel(1,5)><$motion(1,807)><$comeff(1,4)>Aw man, I did my best...but I guess a loss is a loss! You’re<br>really good at this, <$cdef(27)><pname;0></color>.<clear><br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Well, I’ve got a special prize for our special winner!
msgctxt "1995:618"
msgid "<oneline><$voicel(1,5)><$motion(1,807)><$comeff(1,4)>Por mucho que me empeñe, no hay quien te gane...<clear><br>Eres demasiado buen<gen;-2(o,a)> jugando a esto,<br><$cdef(27)><pname;0></color>.<slide><br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Así que... tengo un premio para ti..."
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,8)>Thanks for playing with me today. I’ll—I’ll do better<br>next time!
msgctxt "1995:619"
msgid "<$voicel(1,7)><$emotion(1,8)>G-gracias por jugar al escondite camuflado.<br>La próxima vez intentaré que me vaya mejor..."
msgstr ""

#. en: <$voicel(1,5)><$motion(1,805)><$comeff(1,3)>Hey! I was thinking...maybe from now on, I could call<br>you <$cdef(27)><pname;1></color>...?<clear><br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>’Cause...’cause I feel like we sound more like friends<br>that way!<clear><br><$voicel(1,10)><$emotion(1,8)>I hope that’s OK... And th-thank you for being my friend!
msgctxt "1995:620"
msgid "<$voicel(1,5)><$motion(1,805)><$comeff(1,3)>O-oye, te quería preguntar... ¿Te importa que te llame por<br>tu mote a partir de ahora?<clear><br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Es lo que hacen los amigos de verdad, ¿no?<clear><br><$voicel(1,10)><$emotion(1,8)><$cdef(27)><pname;1></color>... ¡Qué bien sienta decirlo!"
msgstr "<$voicel(1,5)><$motion(1,805)><$comeff(1,3)>O-oye, te quería preguntar... ¿Te importa que te llame por<br>tu apodo a partir de ahora?<clear><br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Es lo que hacen los amigos de verdad, ¿no?<clear><br><$voicel(1,10)><$emotion(1,8)><$cdef(27)><pname;1></color>... ¡Qué bien sienta decirlo!"

#. en: <oneline><$voicel(1,7)><$emotion(1,6)>It’s always great to play with you,<br><$cdef(27)><pname;0></color>.<slide><br>I<slide><br>had<slide><br>a blast!
msgctxt "1995:622"
msgid "<oneline><$voicel(1,7)><$emotion(1,6)>Ay, es que me encanta jugar contigo,<br><$cdef(27)><pname;0></color>...<slide><br>Me lo he pasado genial."
msgstr "<oneline><$voicel(1,7)><$emotion(1,6)>Ay, es que me encanta jugar contigo,<br><$cdef(27)><pname;0></color>...<slide><br>Me la pasé genial."

#. en: <$emotion(1,8)><$voicel(1,9)>Really...? Oh, great! I’ll do my best!
msgctxt "1995:623"
msgid "<$emotion(1,8)><$voicel(1,9)>¿De verdad? ¡Qué ilusión! Buena suerte..."
msgstr "<$emotion(1,8)><$voicel(1,9)>¿De verdad? ¡Qué alegría! Buena suerte..."

#. en: <$emotion(1,14)><$voicel(1,5)>Oh, OK... W-well, if you’re ever in the mood, I’d be<br>happy to play...
msgctxt "1995:624"
msgid "<$emotion(1,14)><$voicel(1,5)>Bueno, si te animas, avísame..."
msgstr ""

#. en: <$voicel(1,5)><$emotion(1,14)><$facial(1,13)>Huh? The <$cdef(27)><fqty(1)><$ifull(1325)></color>’s not working...<clear><br><$voicel(1,3)><$motion(1,805)><$facial(1,9)><$comeff(1,4)>D-did I break it? H-how am I supposed to fix it...?
msgctxt "1995:667"
msgid "<$voicel(1,5)><$emotion(1,14)><$facial(1,13)>¿Q-qué ha pasado? La <$cdef(27)><fqty(1)><$ifull(1325)></color> no funciona...<clear><br><$voicel(1,3)><$motion(1,805)><$facial(1,9)><$comeff(1,4)>No la habré roto yo, ¿no? ¿Y cómo la arreglo yo ahora?"
msgstr "<$voicel(1,5)><$emotion(1,14)><$facial(1,13)>¿Q-qué pasó? La <$cdef(27)><fqty(1)><$ifull(1325)></color> no funciona...<clear><br><$voicel(1,3)><$motion(1,805)><$facial(1,9)><$comeff(1,4)>No la habré roto yo, ¿no? ¿Y cómo la arreglo yo ahora?"

#. en: <oneline><$voicel(1,3)><$motion(1,805)><$comeff(1,14)>Oh, here you go... The<br><$cdef(27)><fqty(2)><class><reftarid;0></color><slide><br>I was<slide><br>working on...<clear><br>I’m still not done with the whole batch, though, so...<$voicel(1,6)><$motion(1,803)><$comeff(1,10)>come<br>back later to pick the rest up, OK?
msgctxt "1995:670"
msgid "<oneline><$voicel(1,3)><$motion(1,805)><$comeff(1,14)>A-ah... Aquí tienes parte de<br>tus <$cdef(27)><fqty(2)><class><reftarid;0></color>.<clear><br><$voicel(1,6)><$motion(1,803)><$comeff(1,10)>Perdona que no haya terminado todavía... ¿Te importa<br>volver luego a por el resto?"
msgstr "<oneline><$voicel(1,3)><$motion(1,805)><$comeff(1,14)>A-ah... Aquí tienes parte de<br>tus <$cdef(27)><fqty(2)><class><reftarid;0></color>.<clear><br><$voicel(1,6)><$motion(1,803)><$comeff(1,10)>Perdona que no haya terminado todavía... ¿Te importa<br>volver luego por el resto?"

#. en: <oneline><$voicel(1,5)><$emotion(1,14)>Oh yeah... I think <$cdef(27)><pksrchtar;0></color>’s over that<br>way.<slide><br>I<slide><br>can<slide><br>take<slide><br>you<slide><br>there,<slide><br>if<slide><br>you want...<clear><br><$comeff(1,6)><$motion(1,805)><$voicel(1,7)>Do you, uh...want me to fly you there?
msgctxt "1995:680"
msgid "<oneline><$cdef(27)><$emotion(1,14)></color><$voicel(1,5)>Ah... Creo que sé dónde está, aunque no estoy segur<gen;-3(o,a)>.<br><$motion(1,805)><$voicel(1,7)>Si quieres, te puedo llevar hasta allí... <$comeff(1,6)>¿Vamos volando?"
msgstr "<oneline><$cdef(27)><$emotion(1,14)></color><$voicel(1,5)>Ah... Creo que sé dónde está, aunque no estoy segur<gen;-3(o,a)>.<br><$motion(1,805)><$voicel(1,7)>Si quieres, te puedo llevar hasta allá... <$comeff(1,6)>¿Vamos volando?"

#. en: <oneline><$voicel(1,5)><$emotion(1,14)>Oh yeah... I think <$cdef(27)><pksrchtar;0></color>’s at home.<br>I<slide><br>can<slide><br>take<slide><br>you<slide><br>there,<slide><br>if<slide><br>you want...<clear><br><$voicel(1,7)><$motion(1,805)><$comeff(1,6)>Do you, uh...want me to fly you there?
msgctxt "1995:681"
msgid "<$cdef(27)><$voicel(1,5)></color><$emotion(1,14)>Pues... sí, creo que estaba en casa. Si quieres, te puedo<br>llevar hasta allí... <$voicel(1,7)><$motion(1,805)><$comeff(1,6)>¿Vamos volando?"
msgstr "<$cdef(27)><$voicel(1,5)></color><$emotion(1,14)>Pues... sí, creo que estaba en casa. Si quieres, te puedo<br>llevar hasta allá... <$voicel(1,7)><$motion(1,805)><$comeff(1,6)>¿Vamos volando?"

#. en: <oneline><$voicel(1,5)><$comeff(1,14)><$motion(1,803)>Uh, no, I don’t think I’ve seen<br><$cdef(27)><pksrchtar;0></color><slide><br>today...<clear><br><$voicel(1,8)><$motion(1,805)><$comeff(1,6)>B-but I could fly you to their home, if you’d like?
msgctxt "1995:682"
msgid "<$cdef(27)><$voicel(1,5)></color><$motion(1,805)><$comeff(1,14)>Hoy no sé dónde está, la verdad... Pero podría llevarte<br>volando hasta su casa a echar un vistazo... <$voicel(1,8)><$motion(1,803)><$comeff(1,6)>¿Q-quieres?"
msgstr ""

#. en: <oneline><$comeff(1,6)><$motion(1,805)><$voicel(1,3)>I haven’t seen <$cdef(27)><pksrchtar;0></color> around<br>here, no...<clear><br><$comeff(1,14)><$motion(1,803)><$voicel(1,4)>I think they might live somewhere else...
msgctxt "1995:683"
msgid "<$cdef(27)><$motion(1,805)></color><$voicel(1,3)>Por aquí no me suena que esté... <$comeff(1,6)>¿No vive en otra zona?<br><$comeff(1,14)><$motion(1,803)><$voicel(1,4)>O igual me lo estoy inventando, no sé..."
msgstr "<$cdef(27)><$motion(1,805)></color><$voicel(1,3)>Por aquí no me suena que esté... <$comeff(1,6)>¿No vive en otra zona?<br><$comeff(1,14)><$motion(1,803)><$voicel(1,4)>O a lo mejor me lo estoy inventando, no sé..."

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>D-don’t worry, OK? I’ll get us there safely...
msgctxt "1995:684"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>¡C-claro! Gracias por confiar en mí. Llegarás san<gen;-2(o,a)> y salv<gen;-2(o,a)>."
msgstr ""

#. en: <oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>OK, we’re here, <$cdef(27)><pname;0></color>! If you ever<br>need<slide><br>my<slide><br>help<slide><br>again,<slide><br>just<slide><br>let<slide><br>me know.
msgctxt "1995:685"
msgid "<oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Ya hemos llegado, <$cdef(27)><pname;0></color>. Avísame si<br>necesitas<slide><br>algo más."
msgstr "<oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Ya llegamos, <$cdef(27)><pname;0></color>. Avísame si<br>necesitas<slide><br>algo más."

#. en: <oneline><$comeff(1,6)><$motion(1,805)><$voicel(1,3)>I don’t think <$cdef(27)><pksrchtar;0></color> is here... Where<br>could<slide><br>they be?
msgctxt "1995:686"
msgid "<$cdef(27)><$comeff(1,6)></color><$motion(1,805)><$voicel(1,3)>Ah, vaya, parece que no está... ¿Por dónde andará?"
msgstr ""

#. en: <$voicel(1,5)><$emotion(1,14)>Oh, OK... W-well, I’m happy to help if you ever need me.
msgctxt "1995:687"
msgid "<$voicel(1,5)><$emotion(1,14)>Oh, vale. Pero si necesitas ayuda en otro momento,<br>te puedo echar una mano, si quieres."
msgstr "<$voicel(1,5)><$emotion(1,14)>Oh, bueno. Pero si necesitas ayuda en otro momento,<br>te puedo echar una mano, si quieres."

#. en: <oneline><$voicel(1,5)><$emotion(1,14)>Oh yeah... I think <$cdef(27)><pksrchtar;0></color> is over<br>that<slide><br>way.<slide><br>I<slide><br>can<slide><br>take<slide><br>you<slide><br>there,<slide><br>if<slide><br>you want...<clear><br><$comeff(1,6)><$motion(1,805)><$voicel(1,7)>Do you, uh...want me to <$cdef(27)><$spwfull(35)></color> you there?
msgctxt "1995:688"
msgid "<$emotion(1,14)><$voicel(1,5)>Ah... Quizá sepa dónde está... Si quieres, te puedo llevar.<br><$cdef(27)><$comeff(1,6)></color><$motion(1,805)><$voicel(1,7)>¿Te <$cdef(27)>teletransporto</color><nbs2><$spwicon(35)> en un momento?"
msgstr "<$emotion(1,14)><$voicel(1,5)>Ah... Quizás sepa dónde está... Si quieres, te llevo.<br><$cdef(27)><$comeff(1,6)></color><$motion(1,805)><$voicel(1,7)>¿Te <$cdef(27)>teletransporto</color><nbs2><$spwicon(35)> en un momento?"

#. en: <oneline><$voicel(1,5)><$emotion(1,14)>Oh yeah... I think <$cdef(27)><pksrchtar;0></color> is at<br>home.<slide><br>I<slide><br>can<slide><br>take<slide><br>you<slide><br>there,<slide><br>if<slide><br>you want...<clear><br><$voicel(1,7)><$motion(1,805)><$comeff(1,6)>Do you, uh...want me to <$cdef(27)><$spwfull(35)></color> you there?
msgctxt "1995:689"
msgid "<oneline><$voicel(1,5)><$cdef(27)><$emotion(1,14)></color>Pues... sí, creo que estaba en casa. Si quieres, te puedo<br>llevar hasta allí... <$voicel(1,7)><$motion(1,805)><$comeff(1,6)>¿Te <$cdef(27)>teletransporto<nbs2><$spwicon(35)></color> rápidamente?"
msgstr "<oneline><$voicel(1,5)><$cdef(27)><$emotion(1,14)></color>Pues... sí, creo que estaba en casa. Si quieres, te puedo<br>llevar hasta allá... <$voicel(1,7)><$motion(1,805)><$comeff(1,6)>¿Te <$cdef(27)>teletransporto<nbs2><$spwicon(35)></color> rápidamente?"

#. en: <oneline><$voicel(1,5)><$comeff(1,14)><$motion(1,803)>Uh, no, I don’t think I’ve seen<br><$cdef(27)><pksrchtar;0></color><slide><br>today...<clear><br><$voicel(1,7)><$motion(1,805)><$comeff(1,6)>B-but I could <$cdef(27)><$spwfull(35)></color> you to their home, if you’d like?
msgctxt "1995:690"
msgid "<$voicel(1,5)><$comeff(1,14)><$motion(1,803)>Hoy no sé dónde está, la verdad... Pero podría<br><$cdef(27)>teletransportarte<nbs2><$spwicon(35)> </color>hasta su casa. <$voicel(1,7)><$motion(1,805)><$cdef(27)><$comeff(1,6)></color>¿Q-quieres?"
msgstr ""

#. en: <oneline><$comeff(1,6)><$motion(1,805)><$voicel(1,3)>I haven’t seen <$cdef(27)><pksrchtar;0></color> around<br>here, no...<clear><br><$comeff(1,14)><$motion(1,803)><$voicel(1,4)>I think they might live somewhere else...
msgctxt "1995:691"
msgid "<$motion(1,805)><$voicel(1,3)>No me suena vernos por aquí... <$cdef(27)><$comeff(1,6)></color>¿No vive en otra zona?<br><$comeff(1,14)><$motion(1,803)><$voicel(1,4)>O igual me lo estoy inventando, no sé..."
msgstr "<$motion(1,805)><$voicel(1,3)>No me suena vernos por aquí... <$cdef(27)><$comeff(1,6)></color>¿No vive en otra zona?<br><$comeff(1,14)><$motion(1,803)><$voicel(1,4)>O a lo mejor me lo estoy inventando, no sé..."

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>D-don’t worry, OK? I’ll get us there safely...
msgctxt "1995:692"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>¡V-vale! Gracias por confiar en mí. Llegarás san<gen;-2(o,a)> y salv<gen;-2(o,a)>."
msgstr "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>¡D-de acuerdo! Gracias por confiar en mí. Llegarás san<gen;-2(o,a)> y salv<gen;-2(o,a)>."

#. en: <oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>OK, we’re here, <$cdef(27)><pname;0></color>! If you ever<br>need<slide><br>my<slide><br>help<slide><br>again,<slide><br>just<slide><br>let<slide><br>me know.
msgctxt "1995:693"
msgid "<oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Ya hemos llegado, <$cdef(27)><pname;0></color>. Avísame si<br>necesitas<slide><br>algo más."
msgstr "<oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Ya llegamos, <$cdef(27)><pname;0></color>. Avísame si<br>necesitas<slide><br>algo más."

#. en: <oneline><$comeff(1,6)><$motion(1,805)><$voicel(1,3)>I don’t think <$cdef(27)><pksrchtar;0></color>’s here... Where<br>could<slide><br>they be?
msgctxt "1995:694"
msgid "<$motion(1,805)><$voicel(1,3)>Ah, vaya, parece que no está... <$cdef(27)><$comeff(1,6)></color>¿Por dónde andará?"
msgstr ""

#. en: <$voicel(1,5)><$emotion(1,14)>Oh, OK... W-well, I’m happy to help if you ever need me.
msgctxt "1995:695"
msgid "<$voicel(1,5)><$emotion(1,14)>Oh, vale. Pero si necesitas ayuda en otro momento,<br>te puedo echar una mano, si quieres."
msgstr "<$voicel(1,5)><$emotion(1,14)>Oh, bueno. Pero si necesitas ayuda en otro momento,<br>te puedo echar una mano, si quieres."

#. en: <oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Oh, <$cdef(27)><pksrchtar;0></color>’s over that way...<br>I think...
msgctxt "1995:696"
msgid "<$cdef(27)><$comeff(1,14)></color><$motion(1,666)><$voicel(1,5)>Juraría que está por allí... Creo, vaya..."
msgstr "<$cdef(27)><$comeff(1,14)></color><$motion(1,666)><$voicel(1,5)>Juraría que está por allá... Bueno, creo..."

#. en: <oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>I’m...pretty sure <$cdef(27)><pksrchtar;0></color>’s at<br>their home...
msgctxt "1995:697"
msgid "<$cdef(27)><$comeff(1,14)></color><$motion(1,666)><$voicel(1,5)>Me parece que estaba en su casa, pero no me hagas<br>mucho caso..."
msgstr ""

#. en: <oneline><$comeff(1,3)><$motion(1,807)><$voicel(1,3)>Oh... I, uh, haven’t seen <$cdef(27)><pksrchtar;0><br></color>today, sorry...
msgctxt "1995:698"
msgid "<$cdef(27)><$comeff(1,3)></color><$motion(1,807)><$voicel(1,3)>Lo siento, no tengo ni idea de dónde está hoy..."
msgstr ""

#. en: <oneline><$comeff(1,6)><$motion(1,805)><$voicel(1,3)>I haven’t seen <$cdef(27)><pksrchtar;0></color> around<br>here, no...<clear><br><$comeff(1,14)><$motion(1,803)><$voicel(1,4)>I think they might live somewhere else...
msgctxt "1995:699"
msgid "<$cdef(27)><$comeff(1,14)></color><$motion(1,805)><$voicel(1,3)>No me suena que se pase nunca por aquí...<clear><br><$comeff(1,6)><$motion(1,803)><$voicel(1,4)>¿No vive en otra zona? Bueno, tampoco me hagas mucho<br>caso..."
msgstr ""

#. en: <oneline><$comeff(1,6)><$facial(1,1)><$motion(1,805)><$voicel(1,5)>Are...are you looking for someone,<br><$cdef(27)><pname;0></color>?<slide><br>S-sorry<slide><br>if<slide><br>I<slide><br>misunderstood something...
msgctxt "1995:700"
msgid "<$comeff(1,6)><$facial(1,1)><$motion(1,805)><$voicel(1,5)><$cdef(27)><pname;0></color>... ¿estás buscando a alguien?<br>Aunque igual son imaginaciones mías, no sé..."
msgstr "<$comeff(1,6)><$facial(1,1)><$motion(1,805)><$voicel(1,5)><$cdef(27)><pname;0></color>... ¿estás buscando a alguien?<br>Aunque a lo mejor son imaginaciones mías..."

#. en: <$voicel(1,3)><$motion(1,807)><$comeff(1,4)>Oh, yeah, right... Sorry, weird thing for me to say...
msgctxt "1995:701"
msgid "<$voicel(1,3)><$motion(1,807)><$comeff(1,4)>Ah, perdón, es que me lo ha parecido... Disculpa si te<br>ha sentado mal..."
msgstr "<$voicel(1,3)><$motion(1,807)><$comeff(1,4)>Ah, perdón, es que me lo pareció... Disculpa si te<br>molestó..."

#. en: <oneline><$emotion(1,41)><$voicel(1,3)>No, I don’t know where <$cdef(27)><pksrchtar;0></color> is...<br>S-sorry...
msgctxt "1995:702"
msgid "<$emotion(1,41)><$voicel(1,3)>Pues no tengo ni idea de dónde está... Siento no poder<br>ayudarte..."
msgstr ""

#. en: <$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>M-my comfort level...? Uh, <flow><$cdef(27)><$stflevel;0(1)></color>, I guess...
msgctxt "1995:750"
msgid "<$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>Erm... Pues... <wait(1.0)>supongo que es <$cdef(27)><$stflevel;0(1)></color>..."
msgstr ""

#. en: <$emotion(1,14)><$voicel(1,7)>M-my comfort level? Uh, <$cdef(27)><flow><$stflevel;0(2)></color>, I guess...
msgctxt "1995:751"
msgid "<$emotion(1,14)><$voicel(1,7)>Eh... Yo diría que... <wait(1.0)>es <$cdef(27)><$stflevel;0(2)></color>."
msgstr ""

#. en: <$voicel(1,5)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>M-my comfort level? It’s <$cdef(27)><flow><$stflevel;0(3)></color>.
msgctxt "1995:752"
msgid "<oneline><$voicel(1,5)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>Pueees... <wait(1.0)>es <$cdef(27)><$stflevel;0(3)></color>, la verdad."
msgstr ""

#. en: <$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,21)>My comfort level’s <$cdef(27)><flow><$stflevel;0(4)></color>!
msgctxt "1995:753"
msgid "<$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,21)>Oh, pues...<wait(1.0)> ¡diría que es <$cdef(27)><$stflevel;0(4)></color>!"
msgstr ""

#. en: <$voicel(1,9)><$motion(1,801)><$facial(1,5)><$comeff(1,8)>My comfort level’s <$cdef(27)><flow><$stflevel;0(5)></color>! <$voicel(1,8)><$motion(1,803)><$comeff(1,9)>I’m having so much fun<br>every day, I can’t believe it...
msgctxt "1995:754"
msgid "<$voicel(1,9)><$motion(1,801)><$facial(1,5)><$comeff(1,8)>Ay... ¡es <$cdef(27)><$stflevel;0(5)></color>! Me cuesta creerlo.<br><$voicel(1,8)><$motion(1,803)><$comeff(1,9)>Todos los días me lo paso genial."
msgstr "<$voicel(1,9)><$motion(1,801)><$facial(1,5)><$comeff(1,8)>Ay... ¡es <$cdef(27)><$stflevel;0(5)></color>! Me cuesta creerlo.<br><$voicel(1,8)><$motion(1,803)><$comeff(1,9)>Todos los días me la paso genial."

#. en: <$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>It—it’s gotten better than before!
msgctxt "1995:756"
msgid "<$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¡E-estoy más cómod<gen;-3(o,a)> que antes!..."
msgstr ""

#. en: <oneline><$voicel(1,9)><$emotion(1,39)>It’s gotten so much better! Thanks for everything,<br><$cdef(27)><pname;0></color>.
msgctxt "1995:757"
msgid "<oneline><$voicel(1,9)><$emotion(1,39)>Estoy mucho más cómod<gen;-3(o,a)> que antes. ¡G-gracias,<br><$cdef(27)><pname;0></color>!"
msgstr ""

#. en: <oneline><$voicel(1,3)><$motion(1,807)><$comeff(1,4)><$facial(1,9)>Hey, I-I’m sorry but...this<br><$cdef(27)><fqty(1)><class><aireactp;0></color><slide><br>is<slide><br>too<slide><br>small<slide><br>for me...<clear><br><$voicel(1,6)><$emotion(1,14)><$facial(1,1)>I’d really appreciate something a little bigger...
msgctxt "1995:758"
msgid "<oneline><$voicel(1,3)><$motion(1,807)><$comeff(1,4)><$facial(1,9)>Oye, perdona que te moleste con esto, pero creo que<br>est<genqty;0(e,a,os,as)> <$cdef(27)><fqty(1)><aireactp;0></color><slide><br><qty;0(es,son)> un poco<slide><br>pequeñ<genqty;0(o,a,os,as)>...<clear><br><$voicel(1,6)><$emotion(1,14)><$facial(1,1)>¿No tendrías algo más grande?"
msgstr ""

#. en: <oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>That <$cdef(27)><fqty(1)><class><aireactp;0></color> is a<br>huge<slide><br>help.<slide><br>I<slide><br>really<slide><br>appreciate it.
msgctxt "1995:761"
msgid "<oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>M-me has traído lo que te pedí... Qué ilusión...<clear><br>¡Muchas gracias por<br><dart;0()><$cdef(27)><fqty(1)><aireactp;0></color>!"
msgstr "<oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>M-me trajiste lo que te pedí... Qué alegría...<clear><br>¡Muchas gracias por<br><dart;0()><$cdef(27)><fqty(1)><aireactp;0></color>!"

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>My comfort level...? Well, I’m not at home so I’m not<br>totally sure, but...<clear><br><$comeff(1,7)><$motion(1,802)><$voicel(1,4)>I’d say maybe it’s <$cdef(27)><flow><$stflevel;0(1)></color>...
msgctxt "1995:762"
msgid "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Pueees... Podría decírtelo mejor si estuviese en casa,<br>pero ahora mismo diría que es... <wait(1.0)><$comeff(1,7)><$motion(1,802)><$voicel(1,4)>¿<$cdef(27)><$stflevel;0(1)></color>, tal vez?"
msgstr ""

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>My comfort level...? Well, I’m not at home so I’m not<br>totally sure, but...<clear><br><$comeff(1,3)><$motion(1,803)><$voicel(1,6)>I think it might’ve been <$cdef(27)><flow><$stflevel;0(2)></color>...
msgctxt "1995:763"
msgid "<oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Estando lejos de casa ya dudo... Diría que es...<br><wait(1.0)><$comeff(1,3)><$motion(1,803)><$voicel(1,6)>¿<$cdef(27)><$stflevel;0(2)></color>,<slide><br>quizá?..."
msgstr "<oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Estando lejos de casa ya dudo... Diría que es...<br><wait(1.0)><$comeff(1,3)><$motion(1,803)><$voicel(1,6)>¿<$cdef(27)><$stflevel;0(2)></color>,<slide><br>quizás?..."

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>My comfort level...? Well, I’m not at home so I’m not<br>totally sure, but...<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,8)>I think it was <$cdef(27)><flow><$stflevel;0(3)></color>...
msgctxt "1995:764"
msgid "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>A ver, me lo tengo que pensar al estar fuera de casa...<br>Es... <wait(1.0)><$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,8)>¿<$cdef(27)><$stflevel;0(3)></color>? O no, no sé..."
msgstr ""

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>My comfort level...? Well, I’m not at home so I’m not<br>totally sure, but...<clear><br><$comeff(1,21)><$motion(1,801)><$voicel(1,10)>I’m pretty confident it was <$cdef(27)><flow><$stflevel;0(4)></color>!
msgctxt "1995:765"
msgid "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Hmm... Tengo que imaginarme en mi casa... A ver...<br>Sería... <wait(1.0)><$comeff(1,21)><$motion(1,801)><$voicel(1,10)>¡<$cdef(27)><$stflevel;0(4)></color>!"
msgstr ""

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>My comfort level...? Well, I’m not at home so I’m not<br>totally sure, but...<clear><br><$comeff(1,8)><$motion(1,801)><$voicel(1,9)>Actually, no, I am sure! It’s <$cdef(27)><flow><$stflevel;0(5)></color>! It’s a really<br>relaxing place to live.
msgctxt "1995:766"
msgid "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Ah... Esta pregunta estando fuera de casa me pilla<br>un poco de sorpresa... A ver que pienseee...<clear><br><$comeff(1,8)><$motion(1,801)><$voicel(1,9)>Bueno, la verdad es que no tengo tanta duda ya,<br>¡es <$cdef(27)><$stflevel;0(5)></color>!"
msgstr "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Ah... Esta pregunta estando fuera de casa me toma<br>un poco por sorpresa... A ver que pienseee...<clear><br><$comeff(1,8)><$motion(1,801)><$voicel(1,9)>Bueno, la verdad es que no tengo tanta duda ya,<br>¡es <$cdef(27)><$stflevel;0(5)></color>!"

#. en: <$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,1)>It’s gotten better than before! ...I think.
msgctxt "1995:767"
msgid "<$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,1)>Mejor que antes, sí..."
msgstr ""

#. en: <$voicel(1,9)><$emotion(1,39)>I think it’s gotten a lot better. Thanks for always looking<br>out for me, <$cdef(27)><pname;0></color>!
msgctxt "1995:768"
msgid "<$voicel(1,9)><$emotion(1,39)>¡Mucho mejor que antes! Gracias por currártelo,<br><$cdef(27)><pname;0></color>..."
msgstr "<$voicel(1,9)><$emotion(1,39)>¡Mucho mejor que antes! Gracias por todo,<br><$cdef(27)><pname;0></color>..."

#. en: <$voicel(1,5)><$emotion(1,14)>My home’s this way. Y-you can come with me if you want...
msgctxt "1995:769"
msgid "<$voicel(1,5)><$emotion(1,14)>Ah, mi casa está por aquí. Si quieres, te puedo llevar."
msgstr ""

#. en: <$emotion(1,14)><$voicel(1,6)>Oh, um... My home’s that way...<clear><br><$emotion(1,41)><$voicel(1,3)>I’d go with you if I could, but I’m kinda busy... Sorry!
msgctxt "1995:770"
msgid "<$emotion(1,14)><$voicel(1,6)>Eh... Mi casa está por allí.<clear><br><$emotion(1,41)><$voicel(1,3)>Perdona, pero ahora no puedo acompañarte, tengo algo<br>de lío... Lo siento."
msgstr "<$emotion(1,14)><$voicel(1,6)>Eh... Mi casa está por allá.<clear><br><$emotion(1,41)><$voicel(1,3)>Perdona, pero ahora no puedo acompañarte, tengo algo<br>que hacer... Lo siento."

#. en: <oneline><$voicel(1,7)><$emotion(1,8)>Thanks for putting that<br><$cdef(27)><fqty(1)><class><stfrevp;0></color><slide><$cdef(27)><br></color>in<slide><br>my home.
msgctxt "1995:771"
msgid "<oneline><$voicel(1,7)><$emotion(1,8)>Gracias por poner<br><dart;0()><$cdef(27)><fqty(1)><class><stfrevp;0></color><slide><br>en mi casa."
msgstr ""

#. en: <oneline><$comeff(1,21)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>Wow, <iart;0()><$cdef(27)><fqty(1)><class><stfrevp;0></color>...<br>I dunno<slide><br>what<slide><br>to<slide><br>say...<slide><br>Thank<slide><br>you<slide><br>so much!
msgctxt "1995:772"
msgid "<oneline><$comeff(1,21)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>Me has puesto<br><iart;0()><$cdef(27)><fqty(1)><class><stfrevp;0></color>...<slide><br>Guau, no sé qué decir...<slide><br>Gracias."
msgstr "<oneline><$comeff(1,21)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>Me pusiste<br><iart;0()><$cdef(27)><fqty(1)><class><stfrevp;0></color>...<slide><br>Guau, no sé qué decir...<slide><br>Gracias."

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>M-my comfort level? Well... I’ve only just moved in...<$comeff(1,7)><$motion(1,807)><$voicel(1,4)> So it’s<br>kinda hard to say, to be honest.<clear><br><$comeff(1,6)><$motion(1,803)><$voicel(1,10)>Maybe ask me again some other time?
msgctxt "1995:773"
msgid "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Pues... es que... justo acabo de mudarme, así que...<wait(1.0)><br><$comeff(1,7)><$motion(1,807)><$voicel(1,4)>aún no lo sé, la verdad...<clear><br><$comeff(1,6)><$motion(1,803)><$voicel(1,10)>¿Podrías preguntármelo cuando lleve aquí un poco más<br>de tiempo?"
msgstr ""

#. en: <oneline><$emotion(1,8)><$voicel(1,8)>Thank you!<clear><br><$comeff(1,14)><$facial(1,9)><$motion(1,805)><$voicel(1,5)>But, um... I don’t actually enjoy <$emotion(1,41)><$voicel(1,4)>stuff like<br><$cdef(27)><fqty(2)><class><stfrevp;1></color>...<clear><br><$emotion(1,29)><$voicel(1,6)>Sorry... C-could you maybe give me something else?
msgctxt "1995:774"
msgid "<oneline><$emotion(1,8)><$voicel(1,8)>Gracias...<clear><br><$comeff(1,14)><$facial(1,9)><$motion(1,805)><$voicel(1,5)>A ver... no quiero que te lo tomes a mal, pero...<wait(1.0)> no soy<br><$emotion(1,41)><$voicel(1,4)>muy fan<slide><br><esde;1()><$cdef(27)><fqty(2)><class><stfrevp;1></color>...<clear><br><$emotion(1,29)><$voicel(1,6)>¿M-me l<genqty;1(o,a,os,as)> cambias por otra cosa?"
msgstr ""

#. en: <oneline><$voicel(1,3)><$motion(1,807)><$comeff(1,4)><$facial(1,9)>Hey, s-sorry but...that<br><$cdef(27)><fqty(1)><class><stfrevp;0></color><slide><br>is<slide><br>too<slide><br>small<slide><br>for me...<clear><br><$voicel(1,6)><$emotion(1,14)><$facial(1,1)>I’d really appreciate something a little bigger...
msgctxt "1995:775"
msgid "<oneline><$voicel(1,3)><$motion(1,807)><$comeff(1,4)><$facial(1,9)>Vaya... Creo que<br><dart;0()><fqty(1)><class><$cdef(27)><stfrevp;0></color><slide><br><qty;0(es,son)> algo<slide><br>pequeñ<genqty;0(o,a,os,as)> para mí...<clear><br><$voicel(1,6)><$emotion(1,14)><$facial(1,1)>Me encantaría algo un poco más grande, si puedes."
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,14)>W-watching you work so hard <$voicel(1,10)><$emotion(1,8)>makes me want to help out<br>in any way I can too, <$cdef(27)><pname;0></color>...<clear><br><$voicel(1,5)><$motion(1,805)><$facial(1,1)><$comeff(1,14)>If...if you ever are gonna make something with those sticks<br>and stones you’re gathering, let me know—<$voicel(1,8)><$motionoff(1,804)><$facial(1,4)><$comeff(1,10)>I’d love to<slide><br>help out!
msgctxt "1995:801"
msgid "<$voicel(1,7)><$emotion(1,14)>Siempre estás de aquí para allá, recogiendo lo que vas<br>encontrando por el suelo...<clear><br><$voicel(1,10)><$emotion(1,8)>Me das ganas de esforzarme con lo mío tanto como tú<br>con lo tuyo, <$cdef(27)><pname;0></color>.<clear><br><$voicel(1,5)><$motion(1,805)><$facial(1,1)><$comeff(1,14)>Así que... si alguna vez quieres fabricar algo con esas<br>ramas y piedras que recoges... <$voicel(1,8)><$motionoff(1,804)><$facial(1,4)><$comeff(1,10)>c-cuenta conmigo."
msgstr ""

#. en: <$voicel(1,4)><$emotion(1,14)>You always seem so busy...<clear><br><$voicel(1,7)><$emotion(1,8)>B-but I really appreciate you taking the time to come and<br>chat with me!
msgctxt "1995:802"
msgid "<$voicel(1,4)><$emotion(1,14)>Supongo que hoy también has estado ocupad<gen;-2(o,a)>...<br><$voicel(1,7)><$emotion(1,8)>p-pero, aun así, has sacado tiempo para venir a hablar<slide><br>conmigo... ¡Qué ilusión!"
msgstr "<$voicel(1,4)><$emotion(1,14)>Supongo que hoy también estuviste ocupad<gen;-2(o,a)>...<br><$voicel(1,7)><$emotion(1,8)>p-pero, aun así, sacaste tiempo para venir a hablar<slide><br>conmigo... ¡Qué alegría!"

#. en: <oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>I’m so glad this<br><$cdef(27)><asnbname;0></color><slide><br>turned<slide><br>out<slide><br>so nice...<clear><br><$voicel(1,9)><$emotion(1,8)>And...and I was even able to make friends with the other<br>Pokémon who worked on this! ♪
msgctxt "1995:803"
msgid "<oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Menos mal que<br><dart;0()><$cdef(27)><asnbname;0></color><$cdef(27)></color><slide><br><qty;0(ha,han)> quedado<slide><br>genial...<clear><br><$voicel(1,9)><$emotion(1,8)>Y lo mejor de todo es que... ¡he podido hacerme amig<gen;-3(o,a)><br>de los demás Pokémon que ayudaron con la construcción!"
msgstr "<oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Menos mal que<br><dart;0()><$cdef(27)><asnbname;0></color><$cdef(27)></color><slide><br><qty;0(ha,han)> quedado<slide><br>genial...<clear><br><$voicel(1,9)><$emotion(1,8)>Y lo mejor de todo es que... ¡pude hacerme amig<gen;-3(o,a)><br>de los demás Pokémon que ayudaron con la construcción!"

#. en: <oneline><$voicel(1,7)><$emotion(1,8)>That <$cdef(27)><rctbname;0></color> really<br>looks amazing!<clear><br><$voicel(1,5)><$motion(1,805)><$facial(1,1)><$comeff(1,10)>So um... I-I’d really love to build something like that<br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>together with everyone...
msgctxt "1995:804"
msgid "<oneline><$voicel(1,7)><$emotion(1,8)><fcap><dart;0()><$cdef(27)><rctbname;0></color> <qty;0(ha,han)><br>quedado genial,<slide><br>¿no te parece?<clear><br><$voicel(1,5)><$motion(1,805)><$facial(1,1)><$comeff(1,10)>Ah, quizá incluso yo podría...<clear><br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Sí, creo que me gustaría construir algo así con los demás<br>Pokémon algún día."
msgstr "<oneline><$voicel(1,7)><$emotion(1,8)><fcap><dart;0()><$cdef(27)><rctbname;0></color> <qty;0(ha,han)><br>quedado genial,<slide><br>¿no te parece?<clear><br><$voicel(1,5)><$motion(1,805)><$facial(1,1)><$comeff(1,10)>Ah, quizás incluso yo podría...<clear><br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Sí, creo que me gustaría construir algo así con los demás<br>Pokémon algún día."

#. en: <$voicel(1,5)><$motion(1,805)><$comeff(1,3)>I remember hanging out with <$cdef(27)><acqpname;0></color>...<clear><br><$voicel(1,10)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>They were so nice! <$voicel(1,7)><$emotion(1,8)>I hope I get to see them again...
msgctxt "1995:805"
msgid "<$voicel(1,5)><$motion(1,805)><$comeff(1,3)>Me estaba acordando de cuando jugamos con tu amig<gen;0(o,a)><br><$cdef(27)><acqpname;0></color>...<clear><br><$voicel(1,10)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Fue tan maj<gen;0(o,a)> conmigo... <wait(0.4)><$voicel(1,7)><$emotion(1,8)>¡O-ojalá vuelva a verl<gen;0(o,a)>!"
msgstr "<$voicel(1,5)><$motion(1,805)><$comeff(1,3)>Me estaba acordando de cuando jugamos con tu amig<gen;0(o,a)><br><$cdef(27)><acqpname;0></color>...<clear><br><$voicel(1,10)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Fue tan buen<gen;0(o,a)> conmigo... <wait(0.4)><$voicel(1,7)><$emotion(1,8)>¡O-ojalá vuelva a verl<gen;0(o,a)>!"

#. en: <$voicel(1,5)><$motion(1,803)><$comeff(1,20)>Oh! I see it! You’ve changed your transformation,<br>haven’t you? <$voicel(1,8)><$emotion(1,8)>This one’s really nice too... ♪
msgctxt "1995:806"
msgid "<$voicel(1,5)><$motion(1,803)>Te veo diferente... <wait(0.9)><$comeff(1,20)>Ah... ¡Ahora caigo!<clear><br>Menudo cambio de look, ¿no, <$cdef(27)><pname;0></color>?<br><$voicel(1,8)><$emotion(1,8)>M-me encanta cómo te queda todo."
msgstr "<$voicel(1,5)><$motion(1,803)>Te veo diferente... <wait(0.9)><$comeff(1,20)>Ah... ¡Ahora caigo!<clear><br>Qué cambio de look, ¿no, <$cdef(27)><pname;0></color>?<br><$voicel(1,8)><$emotion(1,8)>M-me encanta cómo te queda todo."

#. en: <$voicel(1,5)><$motion(1,805)><$comeff(1,6)>Huh...? Have...have you changed something about<br>yourself, <$cdef(27)><pname;0></color>?<clear><br><$voicel(1,3)><$motion(1,807)><$comeff(1,4)>Or is it my imagination? Hmmm...
msgctxt "1995:807"
msgid "<$voicel(1,5)><$motion(1,805)><$comeff(1,6)>¿Eh?... <$cdef(27)><pname;0></color>, ¿te has transformado?<clear><br><$voicel(1,3)><$motion(1,807)><$comeff(1,4)>No... ¿S-son imaginaciones mías? Pero es que... te noto<br>algo diferente..."
msgstr ""

#. en: <oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>I love being by myself...<clear><br><$voicel(1,5)><$motion(1,805)><$facial(1,1)>But now, <$voicel(1,10)><$emotion(1,7)>I love spending time with you just as much,<br><$cdef(27)><pname;1></color>.<clear><br><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Thank you for being my friend!
msgctxt "1995:808"
msgid "<oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Me encanta estar sol<gen;-3(o,a)>, tranquil<gen;-3(o,a)> y en silencio...<br><$voicel(1,5)><$motion(1,805)><$facial(1,1)>p-pero a la vez, también me encanta estar contigo...<clear><br><$voicel(1,10)><$emotion(1,7)>Eres <gen;-2(el,la)> mejor, <$cdef(27)><pname;1></color>. <wait(0.9)><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Gracias por<br>sacar tiempo<slide><br>para venir<slide><br>a verme."
msgstr ""

#. en: <$voicel(1,5)><$motion(1,805)><$comeff(1,3)>You know, when I got so nervous I was having trouble<br>speaking properly...<clear><br><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)><$cdef(27)>Professor Tangrowth</color> just smiled and waited for me to get<br>my words together...<$voicel(1,10)><$emotion(1,8)> I really appreciated that!
msgctxt "1995:809"
msgid "<$voicel(1,5)><$motion(1,805)><$comeff(1,3)>¿Sabes? Un día me puse tan nervios<gen;-3(o,a)> que no me salían<br>las palabras.<clear><br><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Pero el <$cdef(27)>Profesor Tangrowth</color> fue muy paciente conmigo<br>y esperó con una sonrisa a que me calmara...<clear><br><$voicel(1,10)><$emotion(1,8)>¡Es muy majete!"
msgstr "<$voicel(1,5)><$motion(1,805)><$comeff(1,3)>¿Sabes? Un día me puse tan nervios<gen;-3(o,a)> que no me salían<br>las palabras.<clear><br><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Pero el <$cdef(27)>Profesor Tangrowth</color> fue muy paciente conmigo<br>y esperó con una sonrisa a que me calmara...<clear><br><$voicel(1,10)><$emotion(1,8)>¡Es muy amable!"

#. en: <$emotion(1,8)><$voicel(1,9)>Thanks for living with me, <$cdef(27)><pname;0></color>...<clear><br><$comeff(1,21)><$facial(1,4)><$motion(1,806)><$voicel(1,10)>It really helps me feel safe knowing that <$voicel(1,7)>you’re always<br>close by!
msgctxt "1995:810"
msgid "<oneline><$emotion(1,8)><$voicel(1,9)>Qué feliz me hace vivir contigo,<br><$cdef(27)><pname;0></color>...<clear><br><$voicel(1,7)>Saber que estás siempre ahí a mi lado me hace sentir<br><$comeff(1,21)><$facial(1,4)><$motion(1,806)><$voicel(1,10)>muchísimo más segur<gen;-3(o,a)>."
msgstr ""

#. en: <$comeff(1,14)><$facial(1,9)><$motion(1,803)><$voicel(1,5)>So, um... You probably noticed already that I’m pretty shy<br>and introverted...<clear><br><$emotion(1,51)><$voicel(1,3)>B-but everyone seems to think I’m some kind of tough<br>Pokémon ’cause of the way I look. Sometimes I really<slide><br>don’t know what I’m supposed to do with that...
msgctxt "1995:813"
msgid "<$comeff(1,14)><$facial(1,9)><$motion(1,803)><$voicel(1,5)>S-supongo que ya te habrás dado cuenta, pero soy<br>bastante tímid<gen;-3(o,a)> e introvertid<gen;-3(o,a)>, y...<clear><br>Como te podrás imaginar, combinado con estas pintas tan<br>intimidantes, no lo tengo nada fácil... <$emotion(1,51)><$voicel(1,3)>Es un rollo..."
msgstr "<$comeff(1,14)><$facial(1,9)><$motion(1,803)><$voicel(1,5)>S-supongo que ya te habrás dado cuenta, pero soy<br>bastante tímid<gen;-3(o,a)> e introvertid<gen;-3(o,a)>, y...<clear><br>Como te podrás imaginar, combinado con este aspecto tan<br>intimidante, no lo tengo nada fácil... <$emotion(1,51)><$voicel(1,3)>Es un fastidio..."

#. en: <$emotion(1,29)><$voicel(1,7)>I wonder if my voice will get louder as I grow up.<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Maybe I should be more careful about talking to myself...
msgctxt "1995:817"
msgid "<$emotion(1,29)><$voicel(1,7)>Me pregunto si, cuando crezca, mi voz también se volverá<br>más potente...<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Igual será mejor que vaya con cuidado cuando me ponga<br>a hablar sol<gen;-3(o,a)>, no sea que alguien me oiga..."
msgstr "<$emotion(1,29)><$voicel(1,7)>Me pregunto si, cuando crezca, mi voz también se volverá<br>más potente...<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Quizás sea mejor que vaya con cuidado cuando me ponga<br>a hablar sol<gen;-3(o,a)>, no sea que alguien me oiga..."

#. en: <oneline><$comeff(1,9)><$motion(1,806)><$voicel(1,7)><$cdef(27)><$tonepk;0(4)></color> seems to have really taken<br>a<slide><br>liking<slide><br>to<slide><br>me<slide><br>for<slide><br>some reason...<clear><br><$comeff(1,14)><$voicel(1,6)>They just...show up right beside me before I even notice.<br><$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>It was startling at first, but...now it makes me really happy.
msgctxt "1995:821"
msgid "<oneline><$comeff(1,9)><$motion(1,806)><$voicel(1,7)>Creo que <dart;0()><$cdef(27)><$tonepk;0(4)></color> me ha cogido<br>mucho cariño...<slide><br><$comeff(1,14)><$voicel(1,6)>Siempre que me giro, ahí está a mi lado.<clear><br><$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>Al principio me chocaba un poco, pero creo que ya me<br>he acostumbrado a que esté ahí y la verdad es que<slide><br>aprecio su presencia."
msgstr "<oneline><$comeff(1,9)><$motion(1,806)><$voicel(1,7)>Creo que <dart;0()><$cdef(27)><$tonepk;0(4)></color> me ha tomado<br>mucho cariño...<slide><br><$comeff(1,14)><$voicel(1,6)>Siempre que me giro, ahí está a mi lado.<clear><br><$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>Al principio me chocaba un poco, pero creo que ya me<br>he acostumbrado a que esté ahí y la verdad es que<slide><br>aprecio su presencia."

#. en: <oneline><$emotion(1,14)><$voicel(1,5)>You know, <$cdef(27)><$tonepk;0(15)></color> keeps <$comeff(1,9)><$motion(1,806)><$voicel(1,7)>praising me<br>every<slide><br>time<slide><br>I<slide><br>run<slide><br>into them...<clear><br><$comeff(1,21)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>It’s not even like I’ve done anything special... They’re just<br>really nice, aren’t they?
msgctxt "1995:832"
msgid "<oneline><$emotion(1,14)><$voicel(1,5)>¿Sabes? Cada vez que me encuentro<br><esa;0()><$cdef(27)><$tonepk;0(15)></color>,<slide><br><$comeff(1,9)><$motion(1,806)><$voicel(1,7)>me hace un cumplido,<slide><br>así, sin venir a cuento...<clear><br>Y no es que yo haya hecho nada digno de elogio<br>tampoco... <$comeff(1,21)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>Da gusto tener a gente así de amable cerca."
msgstr ""

#. en: <$motion(1,805)><$comeff(1,3)><$facial(1,1)><$voicel(1,5)>When I was playing with my friend earlier, I bit them just a<br>tiny bit.<$emotion(1,59)><$voicel(1,2)> They got mad at me and said it hurt...<clear><br><$emotion(1,55)><$voicel(1,3)>I was only trying to play, but...since then, I’ve been very<br>careful <$comeff(1,3)><$facial(1,1)><$voicel(1,6)>not to go around biting too much.
msgctxt "1995:838"
msgid "<$motion(1,805)><$comeff(1,3)><$facial(1,1)><$voicel(1,5)>El otro día estaba jugando con un amigo y le pegué un<br>mordisquito de nada, así en plan juguetón... p-pero...<slide><br><$emotion(1,59)><$voicel(1,2)>me dijo que le dolió y se enfadó conmigo...<clear><br><$emotion(1,55)><$voicel(1,3)>No era mi intención hacerle daño, solo quería jugar...<br><wait(1.0)><$comeff(1,3)><$facial(1,1)><$voicel(1,6)>Desde entonces procuro tener mucho más cuidado."
msgstr "<$motion(1,805)><$comeff(1,3)><$facial(1,1)><$voicel(1,5)>El otro día estaba jugando con un amigo y le di un<br>mordisquito de nada, así en plan juguetón... p-pero...<slide><br><$emotion(1,59)><$voicel(1,2)>me dijo que le dolió y se enojó conmigo...<clear><br><$emotion(1,55)><$voicel(1,3)>No era mi intención hacerle daño, solo quería jugar...<br><wait(1.0)><$comeff(1,3)><$facial(1,1)><$voicel(1,6)>Desde entonces procuro tener mucho más cuidado."

#. en: <$emotion(1,14)><$voicel(1,7)>You know, I’ve been getting the feeling that <$cdef(27)><gevcmainpk;0></color>’s<br>really amped up about something... <$comeff(1,14)><$motion(1,666)><$voicel(1,6)>I wonder what that’s<slide><br>all about. M-maybe I should...ask them?
msgctxt "1995:851"
msgid "<oneline><$emotion(1,14)><$voicel(1,7)>Últimamente, me da la sensación de que <dart;0()><$cdef(27)><gevcmainpk;0><br></color>está<slide><br>muy motivad<gen;0(o,a)>, ¿no?... Más que de costumbre.<clear><br><$comeff(1,14)><$motion(1,666)><$voicel(1,6)>Si le preguntas, tal vez te cuente por qué..."
msgstr ""

#. en: <$comeff(1,17)><$facial(1,14)><$motion(1,803)><$voicel(1,6)>Whew... I think that’s all I can do for now.<clear><br><$comeff(1,6)><$facial(1,1)><$motion(1,805)><$voicel(1,7)>So, um... What did you think? Could you tell who I was<br>pretending to be?
msgctxt "1995:853"
msgid "...<clear><br><$comeff(1,17)><$facial(1,14)><$motion(1,803)><$voicel(1,6)>Em... Pues... ya está...<clear><br><$comeff(1,6)><$facial(1,1)><$motion(1,805)><$voicel(1,7)>Esto... ¿qué te ha parecido? ¿Sabes a quién estaba<br>imitando o...?"
msgstr "...<clear><br><$comeff(1,17)><$facial(1,14)><$motion(1,803)><$voicel(1,6)>Em... Pues... ya está...<clear><br><$comeff(1,6)><$facial(1,1)><$motion(1,805)><$voicel(1,7)>Esto... ¿qué te pareció? ¿Sabes a quién estaba<br>imitando o...?"

#. en: <$comeff(1,20)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>That’s right! I’m glad you got it...
msgctxt "1995:854"
msgid "<$comeff(1,20)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Has acertado! Tan mal no lo habré hecho entonces, je...<br>Me hace mucha ilusión que lo hayas adivinado..."
msgstr "<$comeff(1,20)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Acertaste! Tan mal no lo habré hecho entonces, je...<br>Me alegra mucho que lo hayas adivinado..."

#. en: <oneline><$emotion(1,60)><$voicel(1,9)>Oh, um, a-actually, I was pretending to be<br><$cdef(27)><apfquizpk;0(0)></color>...<clear><br>Hee hee... I guess pretending to be someone else is pretty<br>hard, isn’t it?
msgctxt "1995:855"
msgid "<oneline><$emotion(1,60)><$voicel(1,9)>Ah, pues no... En realidad estaba imitando<br><esa;0()><$cdef(27)><apfquizpk;0(0)></color>.<clear><br>Vaya... Imitar a otros Pokémon es bastante chungo..."
msgstr "<oneline><$emotion(1,60)><$voicel(1,9)>Ah, pues no... En realidad estaba imitando<br><esa;0()><$cdef(27)><apfquizpk;0(0)></color>.<clear><br>Vaya... Imitar a otros Pokémon es bastante difícil..."

#. en: <$voicel(1,3)><$facial(1,2)><$comeff(1,3)>Oh... You wanted me to hold on to that <$cdef(27)><fqty(1)><$ifull(432)></color> for<br>you? <$emotion(1,50)><$voicel(1,6)>All right!
msgctxt "1995:859"
msgid "<$cdef(27)><$voicel(1,3)></color><$facial(1,2)><$comeff(1,3)>¿Eh? ¿Que te guarde este <$cdef(27)><fqty(1)><$ifull(432)></color>?...<br><wait(1.0)><$emotion(1,50)><$voicel(1,6)>Bueno, vale..."
msgstr "<$cdef(27)><$voicel(1,3)></color><$facial(1,2)><$comeff(1,3)>¿Eh? ¿Que te guarde este <$cdef(27)><fqty(1)><$ifull(432)></color>?...<br><wait(1.0)><$emotion(1,50)><$voicel(1,6)>Bueno, está bien..."

#. en: <oneline><$voicel(1,8)><$facial(1,4)><$comeff(1,8)><$motion(1,801)>Wooow... So pretty...<clear><br><$emotion(1,37)><$voicel(1,5)>I think you should hold on to this instead,<br><$cdef(27)><pname;0></color>...
msgctxt "1995:860"
msgid "<oneline><$voicel(1,8)><$facial(1,4)><$comeff(1,8)><$motion(1,801)>Anda, qué bonito...<clear><br><$emotion(1,37)><$voicel(1,5)>Toma, <$cdef(27)><pname;0></color>. Será mejor que te<br>lo quedes tú."
msgstr "<oneline><$voicel(1,8)><$facial(1,4)><$comeff(1,8)><$motion(1,801)>Vaya, qué bonito...<clear><br><$emotion(1,37)><$voicel(1,5)>Toma, <$cdef(27)><pname;0></color>. Será mejor que te<br>lo quedes tú."

#. en: <$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>Uagh! What a shock... My heart’s still pounding.<clear><br><$comeff(1,3)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Oh, before I forget—here’s your <$cdef(27)><fqty(1)><$ifull(532)></color>.
msgctxt "1995:862"
msgid "<$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>¡AAAH! <wait(1.0)>Q-qué susto me has dado... Me va el corazón<br>a mil...<clear><br><$comeff(1,3)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Pero bueno, te lo has currado, así que toma una<br><$cdef(27)><fqty(1)><$ifull(532)></color>."
msgstr "<$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>¡AAAH! <wait(1.0)>Q-qué susto me diste... Me va el corazón<br>a mil...<clear><br><$comeff(1,3)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Pero bueno, te lo ganaste, así que toma una<br><$cdef(27)><fqty(1)><$ifull(532)></color>."

#. en: <$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>Uagh! What a shock... My heart’s still pounding.<clear><br><$comeff(1,3)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Oh, before I forget—here’s your <$cdef(27)><fqty(1)><$ifull(532)></color>.
msgctxt "1995:863"
msgid "<$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>¡AAAH! <wait(1.0)>Q-qué susto me has dado... Me va el corazón<br>a mil...<clear><br><$comeff(1,3)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Pero bueno, te lo has currado, así que toma unas cuantas<br><$cdef(27)><fqty(2)><$ifull(532)></color>."
msgstr "<$comeff(1,11)><$facial(1,13)><$motion(1,803)><$voicel(1,9)>¡AAAH! <wait(1.0)>Q-qué susto me diste... Me va el corazón<br>a mil...<clear><br><$comeff(1,3)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Pero bueno, te lo ganaste, así que toma unas cuantas<br><$cdef(27)><fqty(2)><$ifull(532)></color>."

#. en: <$voicel(1,6)><$motion(1,807)><$comeff(1,14)>I’d really like to go, but...<$voicel(1,3)><$motion(1,805)><$comeff(1,6)>there are a lot of Pokémon who<br>want to go, right...?<clear><br><$voicel(1,6)><$motion(1,803)><$comeff(1,10)>In that case, I can wait. <$voicel(1,8)><$emotion(1,39)>I’ll definitely tag along next time!
msgctxt "1995:902"
msgid "<$voicel(1,6)><$motion(1,807)><$comeff(1,14)>Ay, me encantaría ir, pero...<clear><br><$voicel(1,3)><$motion(1,805)>Hay muchos otros Pokémon que se mueren de ganas<br>también, <$comeff(1,6)>¿verdad? Me sabría fatal quitarles el sitio...<clear><br><$voicel(1,6)><$motion(1,803)><$comeff(1,10)>No me importa esperar, así que tú no te preocupes.<br><$voicel(1,8)><$emotion(1,39)>A la próxima me apunto seguro."
msgstr "<$voicel(1,6)><$motion(1,807)><$comeff(1,14)>Ay, me encantaría ir, pero...<clear><br><$voicel(1,3)><$motion(1,805)>Hay muchos otros Pokémon que se mueren de ganas<br>también, <$comeff(1,6)>¿verdad? Me sentiría mal quitarles el lugar...<clear><br><$voicel(1,6)><$motion(1,803)><$comeff(1,10)>No me importa esperar, así que tú no te preocupes.<br><$voicel(1,8)><$emotion(1,39)>A la próxima me apunto seguro."

#. en: <$voicel(1,7)><$emotion(1,14)>I guess it’s time for me to head home, but...I had a lot of<br>fun today! <$voicel(1,6)><$emotion(1,8)>I wish I could stay out longer, to be honest...
msgctxt "1995:903"
msgid "<$voicel(1,7)><$emotion(1,14)>Creo que es hora de volver a casa, p-pero eso no quita<br>que me lo haya pasado genial hoy, ¿eh? Muchas gracias.<clear><br><$voicel(1,6)><$emotion(1,8)>¡Ojalá pudiese quedarme más rato!"
msgstr "<$voicel(1,7)><$emotion(1,14)>Creo que es hora de volver a casa, p-pero eso no quita<br>que me la haya pasado genial hoy, ¿eh? Muchas gracias.<clear><br><$voicel(1,6)><$emotion(1,8)>¡Ojalá pudiese quedarme más rato!"

#. en: <$voicel(1,8)><$emotion(1,14)>R-really?! Yeah, I want to go!<clear><br><$voicel(1,9)><$emotion(1,8)>Thanks for inviting me... I’ll head over in a bit!
msgctxt "1995:904"
msgid "<$voicel(1,8)><$emotion(1,14)>¿Que quieres que vaya? ¡Qué guay!<clear><br><$voicel(1,9)><$emotion(1,8)>Jo, no sabes la ilusión que me hace. Me pasaré dentro<br>de un rato, si te parece bien."
msgstr "<$voicel(1,8)><$emotion(1,14)>¿Que quieres que vaya? ¡Qué genial!<clear><br><$voicel(1,9)><$emotion(1,8)>Ay, no sabes lo feliz que me hace. Me pasaré dentro<br>de un rato, si te parece bien."

#. en: <oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,6)>Oh, um, are you heading out, <$cdef(27)><pname;0></color>?<br>C-can<slide><br>I<slide><br>come<slide><br>along too?
msgctxt "1995:905"
msgid "<oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,6)>Oh, <$cdef(27)><pname;0></color>... ¿Vas a salir?<br>¿Te importa que vaya<slide><br>yo también?"
msgstr ""

#. en: <$voicel(1,5)><$emotion(1,14)>Awww, OK... M-maybe next time I could join you?
msgctxt "1995:906"
msgid "<$voicel(1,5)><$emotion(1,14)>Vale, no pasa nada... Quizá la próxima vez."
msgstr "<$voicel(1,5)><$emotion(1,14)>Bueno, no pasa nada... Quizás la próxima vez."

#. en: <$voicel(1,9)><$emotion(1,39)>Thanks... You know, I’d love it if I could join you next<br>time too...
msgctxt "1995:907"
msgid "<oneline><$voicel(1,9)><$emotion(1,39)>Gracias, <$cdef(27)><pname;0></color>, me lo he pasado muy<br>bien hoy.<clear><br>Me encantaría volver a ir a algún sitio contigo."
msgstr "<oneline><$voicel(1,9)><$emotion(1,39)>Gracias, <$cdef(27)><pname;0></color>, me la pasé muy<br>bien hoy.<clear><br>Me encantaría volver a ir a algún lugar contigo."

#. en: <oneline><$comeff(1,3)><$motion(1,803)><$voicel(1,10)>Oh, hi, <$cdef(27)><pname;0></color>! I’m one of<br><$cdef(27)><nowner;2></color>’s<slide><br>friends...<slide><br><$comeff(1,6)><$motion(1,805)><$voicel(1,6)>D-do<slide><br>you<slide><br>remember me...?<clear><br><$comeff(1,21)><$motion(1,801)><$voicel(1,9)>You live in a nice place too, don’t you? <$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,10)>It’s really lovely!
msgctxt "1995:921"
msgid "<oneline><$comeff(1,3)><$motion(1,803)><$voicel(1,10)>A-ah, ¡hola, <$cdef(27)><pname;0></color>! Espero no<br>molestar...<slide><br><wait(0.6)><$motion(1,805)><$voicel(1,6)>Soy amig<gen;-3(o,a)> de <$cdef(27)><nowner;2></color>,<slide><br><$comeff(1,6)>¿t-te acuerdas<slide><br>de mí?<clear><br><$comeff(1,21)><$motion(1,801)><$voicel(1,9)>Hala, este sitio está genial para vivir, ¿no? Mola...<br><$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,10)>Se está muy a gusto."
msgstr "<oneline><$comeff(1,3)><$motion(1,803)><$voicel(1,10)>A-ah, ¡hola, <$cdef(27)><pname;0></color>! Espero no<br>molestar...<slide><br><wait(0.6)><$motion(1,805)><$voicel(1,6)>Soy amig<gen;-3(o,a)> de <$cdef(27)><nowner;2></color>,<slide><br><$comeff(1,6)>¿t-te acuerdas<slide><br>de mí?<clear><br><$comeff(1,21)><$motion(1,801)><$voicel(1,9)>Guau, este lugar está genial para vivir, ¿no?<br><$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,10)>Se está muy a gusto."
