msgid "<oneline>Limpia el barro que hay cerca de donde vive<br><dart;0()><$cdef(27)><$cname;0(116)></color>."
msgstr ""

#. en: Make flowers bloom in a <$cdef(27)><fqty(1)><$iname(1410)> </color>you made!
msgctxt "5190:94"
msgid "Fabrica una <$cdef(27)><fqty(1)><$iname(1410)></color> y adórnala con flores."
msgstr ""

#. en: Place a <$cdef(27)><fqty(1)><$iname(1627)></color> for <$cdef(27)><$cname;0(118)></color> to splash around in!
msgctxt "5190:95"
msgid "<oneline>Coloca una <$cdef(27)><fqty(1)><$iname(1627)></color> para que <dart;0()><$cdef(27)><$cname;0(118)><br></color>pueda refrescarse."
msgstr ""

#. en: <oneline>Give <$cdef(27)><dgt2;1(lnum2)></color> <$cdef(27)><class><$inamewithnum;1(lnum1,lnum2)><br></color>to <$cdef(27)><$cname;2(141)></color>.
msgctxt "5190:96"
msgid "<oneline>Dale <$cdef(27)><dgt2;1(lnum2)></color> <$cdef(27)><class><$inamewithnum;0(lnum1,lnum2)></color><br><esa;2()><$cdef(27)><$cname;2(141)></color>."
msgstr ""

