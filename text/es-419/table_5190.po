msgstr "Usa <$cdef(27)><$sklname(4)></color> en el pedazo de pared de color distinto para que<br>fluya el agua."

#. en: Place a <$cdef(27)><fqty(1)><$iname(1262)></color> by a pond and start it up!
msgctxt "5190:82"
msgid "Coloca una <$cdef(27)><fqty(1)><$iname(1262)></color> en el estanque para ponerla<br>en marcha."
msgstr ""

#. en: Use <$cdef(27)><$sklname(3)></color> to revive <$cdef(27)><dgt2;0(lnum1)></color> dry <qty;0(tree,trees)>!
