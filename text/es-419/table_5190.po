msgstr ""

#. en: Go inside the ship and investigate whatever <$cdef(27)><$cname;0(130)></color> saw!
msgctxt "5190:17"
msgid "<oneline>Sube a bordo del barco e investiga lo que ha visto<br><dart;0()><$cdef(27)><$cname;0(130)></color>."
msgstr "<oneline>Sube a bordo del barco e investiga lo que vio<br><dart;0()><$cdef(27)><$cname;0(130)></color>."

#. en: <$cdef(27)><fcap><$spwname(1)> </color>a house and put <$cdef(27)>three </color>different pieces of furniture inside!
