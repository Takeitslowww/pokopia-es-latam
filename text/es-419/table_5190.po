msgid "<oneline>Entrégale <$cdef(27)><dgt2;2(lnum2)></color> <$cdef(27)><class><$inamewithnum;1(lnum1,lnum2)></color><br><esa;0()><$cdef(27)><$cname;0(251)></color>."
msgstr ""

#. en: Use <$cdef(27)><$sklname(4)></color> to break all the <$cdef(27)>cracked rocks</color> near <$cdef(27)><$cname;0(166)></color>!
