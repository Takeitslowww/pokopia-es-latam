msgid "<oneline>Crea el hábitat <$cdef(27)><$hatname;0(lnum1)> </color>para<br>que <dart;1()><$cdef(27)><$cname;1(193)></color> viva en él."
msgstr ""

#. en: <oneline>Give <$cdef(27)><dgt2;2(lnum2)></color> <$cdef(27)><class><$inamewithnum;1(lnum1,lnum2)> </color>to <$cdef(27)><$cname;0(251)></color>.
