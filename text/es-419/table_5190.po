msgid "Coloca una <$cdef(27)>escalera de mano</color> pegada al <$cdef(27)><fqty(1)><$iname(1469)><br></color>para poder repararlo."
msgstr ""

#. en: Make <$cdef(27)>one</color> <$cdef(27)><fqty(1)><$iname(1469)></color>!
msgctxt "5190:133"
msgid "Fabrica <$cdef(27)>1</color> <$cdef(27)><fqty(1)><$iname(1469)></color>."
msgstr ""

#. en: Bring <$cdef(27)><$cname(213)> </color>to the top of the <$cdef(27)>ladder</color>!
msgctxt "5190:134"
msgid "Lleva a <$cdef(27)><$cname(213)></color> hasta lo alto de la <$cdef(27)>escalera de mano</color>."
