msgid "Recoge <$cdef(27)><dgt2;0(5)></color> <$cdef(27)><fqty(2)><$ifull(1322)> </color>para dejar la zona limpia."
msgstr ""

#. en: Place <iart;1()><$cdef(27)><fqty(1)><$iname;1(1541)> </color>near <$cdef(27)><$cname;0(107)></color>’s home!
msgctxt "5190:123"
msgid "<oneline>Coloca <iart;1()><$cdef(27)><fqty(1)><class><$iname;1(1541)><br></color>junto al hogar <esde;0()><$cdef(27)><$cname;0(107)></color>."
msgstr ""

#. en: Make a <$cdef(27)>salad</color> with <$cdef(27)><$cname;0(170)></color>, then chow down!
