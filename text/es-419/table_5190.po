msgctxt "5190:129"
msgid "<oneline>Investiga el sonido misterioso que oyó<br><dart;0()><$cdef(27)><$cname;0(130)></color>."
msgstr ""

#. en: <oneline>Give <$cdef(27)><dgt2;1(lnum2)></color> <$cdef(27)><class><$inamewithnum;1(lnum1,lnum2)><br></color>to <$cdef(27)><$cname;2(225)></color>!
msgctxt "5190:130"
msgid "<oneline>Dale <$cdef(27)><dgt2;1(lnum2)></color> <$cdef(27)><class><$inamewithnum;0(lnum1,lnum2)></color><br><esa;2()><$cdef(27)><$cname;2(225)></color>."
msgstr ""

#. en: Go with <$cdef(27)><$cname;0(215)> </color>to the huge building on the center island!
msgctxt "5190:131"
msgid "<oneline>Ve al edificio enorme que hay en la isla central<br>con <dart;0()><$cdef(27)><$cname;0(215)></color>."
msgstr ""

#. en: Attach an <$cdef(27)><fqty(1)><$iname(1469)></color> to the <$cdef(27)>ladder</color> to fix the <$cdef(27)>elevator</color>!
