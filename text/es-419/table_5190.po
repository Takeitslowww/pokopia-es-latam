msgid "<oneline>Prepara una <$cdef(27)>ensalada</color> con <dart;0()><$cdef(27)><$cname;0(170)><br></color>y cómetela."
msgstr ""

#. en: Fix the broken pool and fill it with water!
msgctxt "5190:126"
msgid "Repara la piscina y llénala de agua."
