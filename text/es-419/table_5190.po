msgid "<oneline>Dale <$cdef(27)><dgt2;2(lnum2)></color> <$cdef(27)><class><$inamewithnum;1(lnum1,lnum2)></color><br><esa;0()><$cdef(27)><$cname;0(126)></color>."
msgstr ""

