msgctxt "5190:108"
msgid "Busca una manera de romper el muro para poder llevar al otro lado<br><esa;0()><$cdef(27)><$cname;0(13)></color>."
msgstr ""

#. en: Go to the top of the lighthouse with <$cdef(27)><$cname;0(130)></color>!
msgctxt "5190:110"
msgid "<oneline>Llega hasta lo más alto del faro con<br><dart;0()><$cdef(27)><$cname;0(130)></color>."
msgstr ""

#. en: Place a <$cdef(27)><fqty(1)><$iname(1290)></color> wherever you like!
msgctxt "5190:111"
msgid "Coloca una <$cdef(27)><fqty(1)><$iname(1290)></color> donde quieras."
msgstr ""

#. en: <oneline>Gather <$cdef(27)><dgt2;1(lnum2)></color> <$cdef(27)><class><$inamewithnum;0(lnum1,lnum2)> </color>and give<br><qty;1(it,them)><slide><br>to <$cdef(27)><$cname;2(24)></color>.
msgctxt "5190:112"
msgid "<oneline>Consigue <$cdef(27)><dgt2;1(lnum2)></color> <$cdef(27)><class><$inamewithnum;0(lnum1,lnum2)><br></color>y dásel<genqty;0(o,a,os,as)> <esa;2()><$cdef(27)><$cname;2(24)></color>."
msgstr ""

#. en: Make a <$cdef(27)><$hatname(197)></color> habitat in a dark area, then invite <$cdef(27)><$cname(180)> </color>to<br>live there!
