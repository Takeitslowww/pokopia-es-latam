msgid "<oneline>Crea el hábitat <$cdef(27)><$hatname;0(lnum1)><br></color>para que <$cdef(27)><$cname(213)></color> viva en él."
msgstr ""

#. en: <oneline>Make <$cdef(27)>one</color> <$cdef(27)><fqty(1)><class><$iname;0(lnum1)> </color>for<br><$cdef(27)><$cname;1(148)></color>!
msgctxt "5190:137"
msgid "<oneline>Prepara <$cdef(27)>1 <class><fqty(1)><$iname;0(lnum1)></color><br>y dásel<genqty;0(o,a,os,as)> <esa;1()><$cdef(27)><$cname;1(148)></color>."
msgstr ""

#. en: Gather <$cdef(27)>six</color> <$cdef(27)><fqty(2)><class><$iname(1010)> </color>and show them to <$cdef(27)><$cname(213)></color>!
msgctxt "5190:138"
msgid "Llévale <$cdef(27)>6</color> <$cdef(27)><fqty(2)><class><$iname(1010)></color> a <$cdef(27)><$cname(213)></color>."
msgstr ""

#. en: Go with <$cdef(27)><$cname;0(169)></color> into the cave and find out what’s in there!
msgctxt "5190:140"
msgid "<oneline>Investiga las profundidades de la cueva con<br><dart;0()><$cdef(27)><$cname;0(169)></color>."
msgstr ""

#. en: Get <$cdef(27)>one</color> <$cdef(27)><fqty(1)><$ifull(123)></color> and show it to <$cdef(27)><$cname(169)></color>!
msgctxt "5190:141"
msgid "Consigue <$cdef(27)>1</color> <$cdef(27)><fqty(1)><class><$ifull(123)> </color>y enséñaselo a <$cdef(27)><$cname(169)></color>."
