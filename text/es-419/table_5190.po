msgid "<oneline>Dale <$cdef(27)><dgt2;1(lnum2)></color> <class><$cdef(27)><$inamewithnum;0(lnum1,lnum2)><br></color><esa;2()><$cdef(27)><$cname;2(24)></color>."
msgstr ""

#. en: Use <$cdef(27)><$sklname(4)></color> on the differently colored wall to let the water flow!
