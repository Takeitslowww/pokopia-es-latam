msgctxt "5190:86"
msgid "Haz crecer hierba alta cerca del agua y crea el hábitat<br><$cdef(27)><$hatname(31)></color>."
msgstr ""

#. en: Prepare some food and <$cdef(27)><fqty(2)><$iname(1263)> </color>to make a<br><$cdef(27)><$hatname(152)></color> habitat!
msgctxt "5190:88"
msgid "Coloca comida y algunos <$cdef(27)><fqty(1)><$iname(1263)></color> para crear el hábitat<br><$cdef(27)><$hatname(152)></color>."
msgstr ""

#. en: Water the dry ground near <$cdef(27)><$cname;0(193)></color>!
msgctxt "5190:89"
msgid "Humedece la tierra seca cerca <esde;0()><$cdef(27)><$cname;0(193)></color>."
msgstr ""

#. en: <oneline>Grow <$cdef(27)><dgt2;1(lnum2)></color> <$cdef(27)><class><$inamewithnum;0(lnum1,lnum2)> </color>for <$cdef(27)><$cname;2(166)></color>!
