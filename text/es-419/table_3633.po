#. en: <oneline><$emotion(4,55)><$voicel(4,3)>Hey, <$cdef(27)><pname;0></color>! So I heard this rumor,<br>right?<slide><br><$comeff(4,6)><$motion(4,644)><$facial(4,1)><$voicel(4,6)>Do<slide><br>you<slide><br>make<slide><br>homes<slide><br>for<slide><br>Pokémon?<wait(0.8)><$motion(0,40)><wait(1.0)>
msgctxt "3633:108"
msgid "<$emotion(4,55)><$voicel(4,3)>Oyeee, que me he enterado de un rumor...<clear><br><$motion(4,644)><$facial(4,1)><$voicel(4,6)>Dicen por ahí que te mola eso de buscarle casa a la peña.<br><$comeff(4,6)>¿Es verdad?<wait(0.8)><$motion(0,40)><wait(1.0)>"
msgstr "<$emotion(4,55)><$voicel(4,3)>Oyeee, que me enteré de un rumor...<clear><br><$motion(4,644)><$facial(4,1)><$voicel(4,6)>Dicen por ahí que te encanta eso de buscarle casa a todos.<br><$comeff(4,6)>¿Es verdad?<wait(0.8)><$motion(0,40)><wait(1.0)>"

#. en: <$comeff(4,3)><$motion(4,806)><$facial(4,1)><$voicel(4,3)>If you’re up for it, could you make ME a home, too?
msgctxt "3633:109"
msgid "<$comeff(4,3)><$motion(4,806)><$facial(4,1)><$voicel(4,3)>Si te aburres, ¿podrías encontrarme una a mí también?<br>Vaaa."
msgstr "<$comeff(4,3)><$motion(4,806)><$facial(4,1)><$voicel(4,3)>Si te aburres, ¿podrías encontrarme una a mí también?<br>Porfaaa."

#. en: <$emotion(4,8)><$voicel(4,7)>YAYYY! Could you do it like this, maybe?
msgctxt "3633:110"
msgid "<$emotion(4,8)><$voicel(4,7)>¡Tomaaa! Estaría guay algo así, ¿que no?"
msgstr "<$emotion(4,8)><$voicel(4,7)>¡Siii! Estaría genial algo así, ¿no?"

#. en: <$emotion(4,8)><$voicel(4,7)>YAYYY! Could you do it like this, maybe?
msgctxt "3633:111"
msgid "<$emotion(4,8)><$voicel(4,7)>¡Tomaaa! Estaría guay algo así, ¿que no?"
msgstr "<$emotion(4,8)><$voicel(4,7)>¡Siii! Estaría genial algo así, ¿no?"

#. en: <$comeff(4,3)><$motion(4,644)><$facial(4,2)><$voicel(4,6)>Let me know when my home’s done, OK?
msgctxt "3633:112"
msgid "<$comeff(4,3)><$motion(4,644)><$facial(4,2)><$voicel(4,6)>¡Avísame cuando me pueda mudar!"
msgstr ""

#. en: <$comeff(4,6)><$motion(4,666)><$facial(4,2)><$voicel(4,5)>I was wondering—could you do my home like this, maybe?
msgctxt "3633:119"
msgid "<$comeff(4,6)><$motion(4,666)><$facial(4,2)><$voicel(4,5)>¿Podrías buscarme un sitio así, fiera? Anda que no molaría."
msgstr "<$comeff(4,6)><$motion(4,666)><$facial(4,2)><$voicel(4,5)>¿Podrías buscarme un lugar así? Sería genial."

#. en: <$emotion(4,6)><$voicel(4,7)>Thanks for doing that for me! My new home is SO cute—<br>I love it!
msgctxt "3633:123"
msgid "<$emotion(4,6)><$voicel(4,7)>¡Mola miiil! Mi nueva casa lo peta. ¡Te debo una, máquina!"
msgstr "<$emotion(4,6)><$voicel(4,7)>¡Me encantaaa! Mi nueva casa es increíble. ¡Te debo una!"

#. en: <oneline><$comeff(4,21)><$motion(4,806)><$facial(4,4)><$voicel(4,9)>The home you built me is literally the BEST,<br><$cdef(27)><pname;0></color>!
msgctxt "3633:127"
msgid "<oneline><$comeff(4,21)><$motion(4,806)><$facial(4,4)><$voicel(4,9)>¡<$cdef(27)><pname;0></color>! Por si no te lo había dicho,<br>la casa<slide><br>que me<slide><br>has buscado es brutaaal."
msgstr "<oneline><$comeff(4,21)><$motion(4,806)><$facial(4,4)><$voicel(4,9)>¡<$cdef(27)><pname;0></color>! Por si no te lo había dicho,<br>la casa<slide><br>que me<slide><br>buscaste es increíbleee."

#. en: <$emotion(4,6)><$voicel(4,8)>Thanks for the cutest home EVER!
msgctxt "3633:128"
msgid "<$emotion(4,6)><$voicel(4,8)>¡No podría estar más guapa! ¡Te debo una, máquina!"
msgstr "<$emotion(4,6)><$voicel(4,8)>¡No podría estar más bonita! ¡Te debo una!"
