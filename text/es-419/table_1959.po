#. en: <$voicel(1,8)><$emotion(1,14)>Yooo! Nice to meet you!<clear><br><$voicel(1,9)><$emotion(1,8)>It’d be super cool if we could be friends!
msgctxt "1959:3"
msgid "<$voicel(1,8)><$emotion(1,14)>¡Holis, encantad<gen;-3(o,a)>!<clear><br><$voicel(1,9)><$emotion(1,8)>A partir de hoy seremos compas. ¡Va a ser la leche!"
msgstr "<$voicel(1,8)><$emotion(1,14)>¡Holis, encantad<gen;-3(o,a)>!<clear><br><$voicel(1,9)><$emotion(1,8)>A partir de hoy seremos compas. ¡Va a ser increíble!"

#. en: <oneline><$voicel(1,5)><$motion(1,803)><$comeff(1,6)>Yo, what’s up? Who’re you?<clear><br><$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,10)>I’m <$cdef(27)><nowner;2></color>’s friend! Hope we can be<br>friends too!
msgctxt "1959:4"
msgid "<$voicel(1,5)><$motion(1,803)>¡Holiwis! <$comeff(1,6)>¿Tú quién eres?<clear><br><$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,10)>¡Yo soy amig<gen;-3(o,a)> de <$cdef(27)><nowner;2></color>! ¡Encantad<gen;-3(o,a)>!"
msgstr ""

#. en: <oneline><$voicel(1,5)><$motion(1,803)><$comeff(1,6)>Yo, what’s up? Who’re you?<clear><br><$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,10)>I’m <$cdef(27)><acqpname;2></color>’s friend! Hope we can be<br>friends too!
msgctxt "1959:5"
msgid "<$voicel(1,5)><$motion(1,803)>¡Holis! <$comeff(1,6)>¿Tú quién eres?<clear><br><$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,10)>¡Yo soy amig<gen;-3(o,a)> de <$cdef(27)><acqpname;2></color>! ¡Encantad<gen;-3(o,a)>!"
msgstr ""

#. en: <$voicel(1,3)><$comeff(1,6)><$motion(1,805)>Yo, what’s up? Who’re you?<clear><br><$voicel(1,7)><$emotion(1,49)>I’m friends with that Pokémon over there! Hope we can be<br>friends too!
msgctxt "1959:6"
msgid "<$voicel(1,3)><$motion(1,805)>¡Holiwis! <$comeff(1,6)>¿Tú quién eres?<clear><br><$voicel(1,7)><$emotion(1,49)>¡No eres el primer Ditto del que me hago amig<gen;-3(o,a)>!<br>¡Encantad<gen;-3(o,a)>!"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,7)>Yooo! What a good smell! I couldn’t help comin’ right back!
msgctxt "1959:8"
msgid "<$voicel(1,7)><$emotion(1,7)>¡Qué pasada de olor! ¡No sé qué es, pero he vuelto a casa<br>a toda leche en cuanto lo he olido!"
msgstr "<$voicel(1,7)><$emotion(1,7)>¡Qué olor tan increíble! ¡No sé qué es, pero volví a casa<br>a toda velocidad en cuanto lo olí!"

#. en: <oneline><$facial(1,4)><$voicel(1,10)><$comeff(1,1)><$motion(1,801)>Heyyy! Great to see ya again, <$cdef(27)><pname;0></color>!<br>This<slide><br>legit<slide><br>makes<slide><br>me<slide><br>so happy!
msgctxt "1959:9"
msgid "<oneline><$facial(1,4)><$voicel(1,10)><$comeff(1,1)><$motion(1,801)>¡<$cdef(27)><pname;0></color>, cuánto tiempooo!<br>¿Qué te cuentas?"
msgstr ""

#. en: <$voicel(1,3)><$comeff(1,6)><$motion(1,666)>Yo, what’s up? Who’re you?<clear><br><$voicel(1,5)><$emotion(1,14)>Are you out here for a walk or somethin’? This area’s<br>pretty cool, <$voicel(1,8)><$emotion(1,8)>so I think I might go for a walk too!
msgctxt "1959:10"
msgid "<$voicel(1,3)><$comeff(1,6)><$motion(1,666)>¿Hmm? ¿Y tú quién eres?<clear><br><$voicel(1,5)><$emotion(1,14)>¿Te pillo en mitad de un paseo? La verdad es que este<br>sitio me da buenas vibras.<clear><br><$voicel(1,8)><$emotion(1,8)>¡Igual me doy una vuelta yo también!"
msgstr "<$voicel(1,3)><$comeff(1,6)><$motion(1,666)>¿Hmm? ¿Y tú quién eres?<clear><br><$voicel(1,5)><$emotion(1,14)>¿Estás en mitad de un paseo? La verdad es que este<br>lugar me da buenas vibras.<clear><br><$voicel(1,8)><$emotion(1,8)>¡A lo mejor me doy una vuelta yo también!"

#. en: <$emotion(1,65)><$voicel(1,5)>Y’know how the world suddenly looks all different when<br>you poke your head outta the water?<clear><br><$comeff(1,3)><$facial(1,4)><$voicel(1,8)>That kinda freaks me out sometimes, yo!
msgctxt "1959:50"
msgid "<$emotion(1,65)><$voicel(1,5)>¡Cuando saco la cabeza sobre el agua, flipo muchísimo!<wait(1.0)><br><$comeff(1,3)><$facial(1,4)><$voicel(1,8)>¡Es que es literal como si hubiese pasado a otro mundo!"
msgstr "<$emotion(1,65)><$voicel(1,5)>¡Cuando saco la cabeza sobre el agua, alucino muchísimo!<wait(1.0)><br><$comeff(1,3)><$facial(1,4)><$voicel(1,8)>¡Es que es literal como si hubiese pasado a otro mundo!"

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Being able to use lots of different moves is so cool, yo.<br>I hope I grow up fast so I can use a bunch of moves soon!
msgctxt "1959:52"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>¡Poder usar distintos movimientos está guapisísimo!<br>¡A ver si pego el estirón, que ser pequeñ<gen;-3(o,a)> no renta!"
msgstr "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>¡Poder usar distintos movimientos está súper genial!<br>¡A ver si pego el estirón, que ser pequeñ<gen;-3(o,a)> no sirve!"

#. en: <oneline><$voicel(1,7)><$emotion(1,14)>This <$cdef(27)><fqty(1)><class><usingp;0> </color>is<br>pretty<slide><br>cool<slide><br>now<slide><br>that<slide><br>it’s<slide><br>finished.<slide><br><$voicel(1,10)><$emotion(1,8)>Makes<slide><br>me<slide><br>feel<slide><br>accomplished, yo!
msgctxt "1959:53"
msgid "<oneline><$voicel(1,7)><$emotion(1,14)>¡Pues h<qty;0(a,an)> quedado deluxe<br><dart;0()><$cdef(27)><fqty(1)><usingp;0></color>,<slide><br>la verdad!<slide><br><$voicel(1,10)><$emotion(1,8)>¡Ha merecido la pena el currazo que nos metimos!"
msgstr "<oneline><$voicel(1,7)><$emotion(1,14)>¡Pues h<qty;0(a,an)> quedado deluxe<br><dart;0()><$cdef(27)><fqty(1)><usingp;0></color>,<slide><br>la verdad!<slide><br><$voicel(1,10)><$emotion(1,8)>¡Valió la pena el trabajazo que hicimos!"

#. en: <oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Yooo! This <$cdef(27)><fqty(1)><class><usingp;0><br></color>is awesome!
msgctxt "1959:54"
msgid "<oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¡Qué pasada <dart;0()><$cdef(27)><fqty(1)><usingp;0><br></color>est<genqty;0(e,a,os,as)>!"
msgstr "<oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¡Qué genial <dart;0()><$cdef(27)><fqty(1)><usingp;0><br></color>est<genqty;0(e,a,os,as)>!"

#. en: <$comeff(1,3)><$facial(1,1)><$motion(1,806)><$voicel(1,7)>If you got any logs you need help cuttin’ up, just lemme<br>know, yo! I can help you out!
msgctxt "1959:55"
msgid "<$comeff(1,3)><$facial(1,1)><$motion(1,806)><$voicel(1,7)>Si necesitas a alguien superpró cortando troncos, avísame<br>y te echo un cable cuando sea."
msgstr "<$comeff(1,3)><$facial(1,1)><$motion(1,806)><$voicel(1,7)>Si necesitas a alguien superpró cortando troncos, avísame<br>y te echo una mano cuando sea."

#. en: <$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,6)>Yo, I’m really good at crushin’ up and processin’ berries,<br>y’know? If you need that done, just leave it to me!
msgctxt "1959:57"
msgid "<$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,6)>Se me da de diez lo de pulverizar bayas para procesarlas.<br>Si te hace falta, pégame un toque."
msgstr "<$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,6)>Se me da genial lo de pulverizar bayas para procesarlas.<br>Si te hace falta, avísame."

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,661)><$voicel(1,8)>It sure is fun to <$cdef(27)><$spwfull(17)></color>! If you got any garbage you<br>don’t need, I’d love to take it off your hands, yo!
msgctxt "1959:58"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,661)><$voicel(1,8)>¡<fcap><$cdef(27)><$spwfull(17)></color> basura me da la vida! Si tienes alguna cosilla<br>que no te haga falta, tráemela."
msgstr "<$comeff(1,10)><$facial(1,4)><$motion(1,661)><$voicel(1,8)>¡<fcap><$cdef(27)><$spwfull(17)></color> basura me encanta! Si tienes alguna cosita<br>que no te haga falta, tráemela."

#. en: <$comeff(1,3)><$facial(1,1)><$motion(1,806)><$voicel(1,7)>You can come to me for all your demolition needs, yo!<br>I’ll <$cdef(27)><$spwfull(33)> </color>everything real good for you!
msgctxt "1959:59"
msgid "<$comeff(1,3)><$facial(1,1)><$motion(1,806)><$voicel(1,7)>Si tienes que tirar abajo alguna estructura, yo me encargo.<br>Soy <gen;-3(un,una)> pro en lo de <$cdef(27)><$spwfull(33)></color>, je, je."
msgstr ""

#. en: <$comeff(1,3)><$facial(1,1)><$motion(1,805)><$voicel(1,5)>Just lemme know if you’re ever searchin’ for a Pokémon!<br>I can get you to where they are real fast!
msgctxt "1959:60"
msgid "<$comeff(1,3)><$facial(1,1)><$motion(1,805)><$voicel(1,5)>Te cuento un life hack: si tienes que buscar a algún<br>Pokémon, ¡vente a verme y nos plantamos allí en nada!"
msgstr "<$comeff(1,3)><$facial(1,1)><$motion(1,805)><$voicel(1,5)>Te cuento un life hack: si tienes que buscar a algún<br>Pokémon, ¡ven a verme y llegamos allá en nada!"

#. en: <$voicel(1,9)><$comeff(1,9)><$motion(1,801)><$facial(1,4)><$pkcry;0(1,1)>! G’morning! Where ya off to today?
msgctxt "1959:101"
msgid "<$voicel(1,9)><$comeff(1,9)><$motion(1,801)><$facial(1,4)>¡<$pkcry;0(1,1)>! ¡Buenos días! ¿Adónde vas hoy, <gen;-2(tío,tía)>?"
msgstr ""

#. en: <$voicel(1,7)><$comeff(1,10)><$motion(1,803)><$facial(1,4)>Yo, can I tag along with you?!
msgctxt "1959:102"
msgid "<$voicel(1,7)><$comeff(1,10)><$motion(1,803)><$facial(1,4)>¿Cómo vas? ¿Puedo acoplarme?"
msgstr "<$voicel(1,7)><$comeff(1,10)><$motion(1,803)><$facial(1,4)>¿Cómo vas? ¿Puedo ir contigo?"

#. en: <oneline><$voicel(1,5)><$comeff(1,16)><$motion(1,802)><$facial(1,2)><$pkcry;0(1,1)>. I really feel like relaxin’ today, yo. I’m<br>gonna<slide><br>have<slide><br>the<slide><br>BEST nap.
msgctxt "1959:103"
msgid "<oneline><$voicel(1,5)><$comeff(1,16)><$motion(1,802)><$facial(1,2)><$pkcry;0(1,1)>... Hoy voy a estar de chill. Va a caer<br>una siesta fijo."
msgstr "<oneline><$voicel(1,5)><$comeff(1,16)><$motion(1,802)><$facial(1,2)><$pkcry;0(1,1)>... Hoy voy a estar de chill. Va a caer<br>una siesta seguro."

#. en: <$voicel(1,9)><$comeff(1,10)><$motion(1,801)><$facial(1,4)><$pkcry;0(1,1)>! Yooo! I’m feeling so energetic today!
msgctxt "1959:104"
msgid "<$voicel(1,9)><$comeff(1,10)><$motion(1,801)><$facial(1,4)>¡<$pkcry;0(1,1)>! ¡Hoy tengo energía para parar un tren!"
msgstr ""

#. en: <$voicel(1,5)><$comeff(1,14)><$motion(1,803)><$pkcry;0(1,4)>. Sky’s turnin’ orange, yo.
msgctxt "1959:105"
msgid "<oneline><$voicel(1,5)><$comeff(1,14)><$motion(1,803)><$pkcry;0(1,4)>... Me flipa que a esta hora del día<br>el cielo<slide><br>se ponga naranja."
msgstr "<oneline><$voicel(1,5)><$comeff(1,14)><$motion(1,803)><$pkcry;0(1,4)>... Me encanta que a esta hora del día<br>el cielo<slide><br>se ponga naranja."

#. en: <$voicel(1,3)><$comeff(1,17)><$motion(1,805)><$facial(1,9)>Awww, man. It’s gettin’ dark, but I wanna keep playing!
msgctxt "1959:106"
msgid "<$voicel(1,3)><$comeff(1,17)><$motion(1,805)><$facial(1,9)>¿Has visto? Parece que enseguida va a ponerse oscuro...<br>¡Si para mí el día no había hecho más que empezar!"
msgstr "<$voicel(1,3)><$comeff(1,17)><$motion(1,805)><$facial(1,9)>¿Ya viste? Parece que enseguida va a ponerse oscuro...<br>¡Si para mí el día no había hecho más que empezar!"

#. en: <$voicel(1,7)>It’s gettin’ pretty dark. <wait(0.4)><$comeff(1,6)><$motion(1,803)>Yo, you still gonna stay up for a<br>bit, <$cdef(27)><pname;0></color>?
msgctxt "1959:107"
msgid "<$cdef(27)><$voicel(1,7)></color>Ya ha oscurecido... <wait(0.4)><$comeff(1,6)><$motion(1,803)>¿Tú no te vas a dormir?"
msgstr "<$cdef(27)><$voicel(1,7)></color>Ya oscureció... <wait(0.4)><$comeff(1,6)><$motion(1,803)>¿Tú no te vas a dormir?"

#. en: <$voicel(1,3)><$motion(1,805)><$pkcry;0(1,4)>. It sure is quiet at night, huh?
msgctxt "1959:108"
msgid "<$voicel(1,3)><$motion(1,805)><$pkcry;0(1,4)>... Qué tranquilidad por la noche..."
msgstr ""

#. en: <oneline><$voicel(1,3)><$comeff(1,10)><$motion(1,806)><$pkcry;0(1,1)>! Yo, you always look so busy,<br><$cdef(27)><pname;1></color>!
msgctxt "1959:109"
msgid "<oneline><$voicel(1,3)><$comeff(1,10)><$motion(1,806)>¡<$pkcry;0(1,1)>! ¡No paras quiet<gen;-2(o,a)> ni un momento,<br><$cdef(27)><pname;1></color>!"
msgstr ""

#. en: <oneline><$voicel(1,9)><$comeff(1,3)><$motion(1,801)><$facial(1,4)>Oh hey, <$cdef(27)><pname;0></color>! You need me<br>for anything?
msgctxt "1959:110"
msgid "<$voicel(1,9)><$comeff(1,3)><$motion(1,801)><$facial(1,4)>¡Ah, holi, <$cdef(27)><pname;0></color>! ¿Querías algo?"
msgstr ""

#. en: <oneline><$voicel(1,7)><$comeff(1,10)><$motion(1,803)><$facial(1,4)><$cdef(27)><pname;0></color>! Yo, is there anything I can<br>help<slide><br>out with?
msgctxt "1959:111"
msgid "<$cdef(27)><$voicel(1,7)></color><$comeff(1,10)><$motion(1,803)><$facial(1,4)>¿Te puedo echar un cable con algo?"
msgstr "<$cdef(27)><$voicel(1,7)></color><$comeff(1,10)><$motion(1,803)><$facial(1,4)>¿Te puedo echar una mano con algo?"

#. en: <$voicel(1,3)><$comeff(1,6)><$motion(1,805)><$facial(1,9)>Yooo—seriously, though, where’d all the humans go?
msgctxt "1959:112"
msgid "<$voicel(1,3)><$comeff(1,6)><$motion(1,805)><$facial(1,9)>Me pregunto por qué se esfumarían los humanos..."
msgstr ""

#. en: <$voicel(1,7)><$comeff(1,3)><$motion(1,801)><$facial(1,4)>Yo, where you headed today, <$cdef(27)><pname;0></color>?
msgctxt "1959:113"
msgid "<$voicel(1,7)><$comeff(1,3)><$motion(1,801)><$facial(1,4)>Ey, <$cdef(27)><pname;0></color>, ¿tienes algún plan hoy?"
msgstr ""

#. en: <oneline><$voicel(1,9)><$comeff(1,9)><$motion(1,803)><$facial(1,4)><$pkcry;0(1,1)>! How are you doin’,<br><$cdef(27)><pname;1></color>?
msgctxt "1959:114"
msgid "<$voicel(1,9)><$comeff(1,9)><$motion(1,803)><$facial(1,4)>¡<$pkcry;0(1,1)>! ¿Cómo vas, <$cdef(27)><pname;1></color>?"
msgstr ""

#. en: <oneline><$voicel(1,7)><$comeff(1,3)><$motion(1,803)><$facial(1,4)>Oh hey, <$cdef(27)><pname;0></color>! Do you need me<br>for anything?
msgctxt "1959:115"
msgid "<$voicel(1,7)><$comeff(1,3)><$motion(1,803)><$facial(1,4)>¡Holiwis, <$cdef(27)><pname;0></color>! ¿Buscas algo?"
msgstr ""

#. en: <oneline><$voicel(1,7)><$motion(1,803)>Yooo, <$cdef(27)><pname;0></color>! Your transformations are<br>always<slide><br>top tier!
msgctxt "1959:116"
msgid "<$cdef(27)><$voicel(1,7)></color><$motion(1,803)>¡Es una pasada lo bien que te transformas!"
msgstr "<$cdef(27)><$voicel(1,7)></color><$motion(1,803)>¡Es increíble lo bien que te transformas!"

#. en: <$voicel(1,5)><$comeff(1,14)><$motion(1,805)>The other day I found a MOUNTAIN of berries, but it was<br>just a dream... <$voicel(1,4)><$comeff(1,17)><$facial(1,9)>I was so sad, yo.
msgctxt "1959:117"
msgid "<$voicel(1,5)><$comeff(1,14)><$motion(1,805)>El otro día encontré una montaña de bayas, pero luego<br>resultó ser... spoiler alert... ¡un sueño!<clear><br><$voicel(1,4)><$comeff(1,17)><$facial(1,9)>Qué bajón..."
msgstr ""

#. en: <$voicel(1,7)><$comeff(1,8)><$motion(1,801)><$facial(1,4)>I feel like this area’s slowly becomin’ a better place to live!
msgctxt "1959:118"
msgid "<$voicel(1,7)><$comeff(1,8)><$motion(1,801)><$facial(1,4)>¿Sabes, <gen;-2(tío,tía)>? Me parece que cada vez se vive más a gusto<br>por aquí."
msgstr ""

#. en: <oneline><$voicel(1,9)><$comeff(1,21)><$motion(1,801)><$facial(1,5)><$cdef(27)><pname;0></color>! It’s sooo cool you can<br>make<slide><br>tools<slide><br>just<slide><br>like<slide><br>humans, yo!
msgctxt "1959:119"
msgid "<$cdef(27)><$voicel(1,9)></color><$comeff(1,21)><$motion(1,801)><$facial(1,5)>¡Es la leche que puedas fabricar cosas como los humanos!<br>¡Estás chetadísim<gen;-2(o,a)>!"
msgstr "<$cdef(27)><$voicel(1,9)></color><$comeff(1,21)><$motion(1,801)><$facial(1,5)>¡Es increíble que puedas fabricar cosas como los humanos!<br>¡Estás chetadísim<gen;-2(o,a)>!"

#. en: <$voicel(1,5)><$comeff(1,9)><$motion(1,803)><$facial(1,4)>I’m seriously thankful for your hard work cleanin’ up<br>the roads around here, <$cdef(27)><pname;0></color>!
msgctxt "1959:120"
msgid "<$cdef(27)><$voicel(1,5)></color><$comeff(1,9)><$motion(1,803)><$facial(1,4)>Se agradece un montón que te dediques a despejar<br>el camino. Mis dieces."
msgstr "<$cdef(27)><$voicel(1,5)></color><$comeff(1,9)><$motion(1,803)><$facial(1,4)>Se agradece un montón que te dediques a despejar<br>el camino. Mis respetos."

#. en: <oneline><$voicel(1,3)><$comeff(1,16)>*yaaawn*...<wait(0.4)><$voicel(1,8)><$comeff(1,3)><$motion(1,803)> Ah! Hey, <$cdef(27)><pname;0></color>.<br><wait(0.4)><$voicel(1,8)><$motion(1,802)>I’m<slide><br>not...<slide><br>I’m<slide><br>not<slide><br>sleepy<slide><br>at<slide><br>all, yo.
msgctxt "1959:121"
msgid "<oneline><$voicel(1,3)><$comeff(1,16)>Zzz... <wait(0.4)><$voicel(1,8)><$comeff(1,3)><$motion(1,803)>Uy, pero si es <$cdef(27)><pname;0></color>. <wait(0.4)><$voicel(1,8)><$motion(1,802)>Tranqui,<br>que no tengo<slide><br>sueño... Qué va..."
msgstr ""

#. en: <$voicel(1,7)><$comeff(1,16)>So many...berries... Mountain of...berries... <wait(0.4)>Can’t eat ’em all...<br><$voicel(1,8)><$comeff(1,3)><$motion(1,803)><$facial(1,13)>Oh, hey, <$cdef(27)><pname;0></color>. <wait(0.4)><$facial(1,4)>Gooood morning.
msgctxt "1959:122"
msgid "<$voicel(1,7)><$comeff(1,16)>Zzz... Una montaña... de bayas...<wait(0.4)> Qué empacho...<br>No puedo terminarlas...<clear><br><$voicel(1,8)><$comeff(1,3)><$motion(1,803)><$facial(1,13)>Ah, <$cdef(27)><pname;0></color>...<wait(0.4)> <$facial(1,4)>Buenas."
msgstr ""

#. en: <$voicel(1,7)><$comeff(1,14)><$motion(1,802)>Yo, I still don’t know this area very well.
msgctxt "1959:123"
msgid "<$voicel(1,7)><$comeff(1,14)><$motion(1,802)>Todavía no conozco bien la zona y tal..."
msgstr "<$voicel(1,7)><$comeff(1,14)><$motion(1,802)>Todavía no conozco bien la zona y eso..."

#. en: <$voicel(1,7)><$comeff(1,10)><$motion(1,801)><$facial(1,4)>Yooo, you seem to know this area really well, so I’m gonna<br>rely on you, if that’s all right.
msgctxt "1959:124"
msgid "<$voicel(1,7)><$comeff(1,10)><$motion(1,801)><$facial(1,4)>¡Siento que controlas muchísimo sobre esta zona!<br>Ya sé a quién pedirle ayuda si me pierdo o lo que sea."
msgstr "<$voicel(1,7)><$comeff(1,10)><$motion(1,801)><$facial(1,4)>¡Siento que sabes muchísimo sobre esta zona!<br>Ya sé a quién pedirle ayuda si me pierdo o lo que sea."

#. en: <$voicel(1,7)><$comeff(1,14)>I wanna go to some areas far away...<wait(0.2)><$comeff(1,17)><$motion(1,802)><$facial(1,9)>but I kinda feel<br>like I might get lost, y’know?
msgctxt "1959:125"
msgid "<$voicel(1,7)><$comeff(1,14)>Me gustaría pirarme por ahí de aventuras, bien lejos...<wait(0.2)><br><$comeff(1,17)><$motion(1,802)><$facial(1,9)>pero me perdería fijo."
msgstr "<$voicel(1,7)><$comeff(1,14)>Me gustaría irme por ahí de aventuras, bien lejos...<wait(0.2)><br><$comeff(1,17)><$motion(1,802)><$facial(1,9)>pero me perdería seguro."

#. en: <$voicel(1,5)><$comeff(1,6)><$motion(1,803)>Yooo, what’re they buildin’ here? Everybody’s workin’<br>so hard!
msgctxt "1959:126"
msgid "<$voicel(1,5)><$comeff(1,6)><$motion(1,803)>¡Hala! ¿Qué estáis construyendo? ¡Qué pasada!"
msgstr "<$voicel(1,5)><$comeff(1,6)><$motion(1,803)>¡Guau! ¿Qué están construyendo? ¡Qué increíble!"

#. en: <$voicel(1,7)><$emotion(1,8)>I’ll do my best to <$cdef(27)><$spwfull(1)> </color>stuff for you!
msgctxt "1959:127"
msgid "<$voicel(1,7)><$emotion(1,8)>¡Allá voy, a <$cdef(27)><$spwfull(1)></color> se ha dicho!"
msgstr ""

#. en: <$voicel(1,7)><$comeff(1,3)><$motion(1,805)>There’re sooo many Pokémon here now, yo! <$voicel(1,10)><$comeff(1,9)><$motion(1,801)><$facial(1,4)>It’s all thanks<br>to you, <$cdef(27)><pname;0></color>!
msgctxt "1959:128"
msgid "<$cdef(27)><$voicel(1,7)></color><$comeff(1,3)><$motion(1,805)>¡Me doy la vuelta un momento y hay más Pokémon que<br>en un meet and greet!<clear><br><$voicel(1,10)><$comeff(1,9)><$motion(1,801)><$facial(1,4)>¡Seguro que tú has tenido algo que ver!"
msgstr "<$cdef(27)><$voicel(1,7)></color><$comeff(1,3)><$motion(1,805)>¡Me doy la vuelta un momento y hay más Pokémon que<br>en un meet and greet!<clear><br><$voicel(1,10)><$comeff(1,9)><$motion(1,801)><$facial(1,4)>¡Seguro que tú tuviste algo que ver!"

#. en: <$voicel(1,7)><$motion(1,805)>I’d be super happy if my home were just a little bit cozier.
msgctxt "1959:129"
msgid "<$voicel(1,7)><$motion(1,805)>Estaría guay que mi casa fuera un poco más cómoda..."
msgstr "<$voicel(1,7)><$motion(1,805)>Estaría genial que mi casa fuera un poco más cómoda..."

#. en: <$voicel(1,7)><$comeff(1,9)><$motion(1,803)><$facial(1,4)>My home’s gettin’ cozier by the day, yo!
msgctxt "1959:130"
msgid "<$voicel(1,7)><$comeff(1,9)><$motion(1,803)><$facial(1,4)>Cada vez me gusta más mi casa, ¡qué guapada!"
msgstr "<$voicel(1,7)><$comeff(1,9)><$motion(1,803)><$facial(1,4)>Cada vez me gusta más mi casa, ¡qué maravilla!"

#. en: <$voicel(1,9)><$comeff(1,8)><$motion(1,801)><$facial(1,4)>Yooo! I LOVE my home!
msgctxt "1959:131"
msgid "<$voicel(1,9)><$comeff(1,8)><$motion(1,801)><$facial(1,4)>¡Estoy living con mi casaaa! ¡No la cambio por nada!"
msgstr ""

#. en: <oneline><$voicel(1,7)><$comeff(1,3)><$motion(1,801)><$facial(1,4)>Yo! What’s up, <$cdef(27)><pname;0></color>? I was just<br>thinkin’<slide><br>about you!
msgctxt "1959:132"
msgid "<$cdef(27)><$voicel(1,7)></color><$comeff(1,3)><$motion(1,801)><$facial(1,4)>¡Yasss! ¡Justo estaba pensando en ti!"
msgstr ""

#. en: <oneline><$voicel(1,7)><$comeff(1,9)><$motion(1,803)><$facial(1,4)><$pkcry;0(1,2)>! My day’s just not complete if I don’t<br>get<slide><br>to<slide><br>see<slide><br>you, <$cdef(27)><pname;1></color>!
msgctxt "1959:133"
msgid "<oneline><$cdef(27)><$voicel(1,7)></color><$comeff(1,9)><$motion(1,803)><$facial(1,4)>¡<$pkcry;0(1,2)>! Cómo mola verte todos los días,<br>me das muy<slide><br>buenas vibras."
msgstr "<oneline><$cdef(27)><$voicel(1,7)></color><$comeff(1,9)><$motion(1,803)><$facial(1,4)>¡<$pkcry;0(1,2)>! Qué genial verte todos los días,<br>me das muy<slide><br>buenas vibras."

#. en: <$voicel(1,9)><$comeff(1,9)><$motion(1,801)><$facial(1,4)>Yo, it’s kinda fun to go somewhere new, huh?
msgctxt "1959:134"
msgid "<$voicel(1,9)><$comeff(1,9)><$motion(1,801)><$facial(1,4)>Está guay visitar sitios nuevos, ¿no te parece?"
msgstr "<$voicel(1,9)><$comeff(1,9)><$motion(1,801)><$facial(1,4)>Está genial visitar lugares nuevos, ¿no te parece?"

#. en: <oneline><$voicel(1,5)><$comeff(1,6)><$motion(1,803)>Hey, <$cdef(27)><pname;0></color>! Yo, did you go someplace<br>fun today?
msgctxt "1959:135"
msgid "<$voicel(1,5)><$motion(1,803)>Ey, <$cdef(27)><pname;0></color>, <$comeff(1,6)>¿dónde has estado hoy?"
msgstr "<$voicel(1,5)><$motion(1,803)>Ey, <$cdef(27)><pname;0></color>, <$comeff(1,6)>¿dónde estuviste hoy?"

#. en: <$voicel(1,7)><$comeff(1,3)><$motion(1,803)>Yooo! Looks like you went to a really faraway place<br>today, <$cdef(27)><pname;0></color>!
msgctxt "1959:136"
msgid "<oneline><$voicel(1,7)><$comeff(1,3)><$motion(1,803)>Ey, <$cdef(27)><pname;0></color>, sí que te has ido lejos hoy,<br>¿no?"
msgstr "<oneline><$voicel(1,7)><$comeff(1,3)><$motion(1,803)>Ey, <$cdef(27)><pname;0></color>, sí que te fuiste lejos hoy,<br>¿no?"

#. en: <$voicel(1,7)><$motion(1,801)><$facial(1,4)>If we had a <$cdef(27)><fqty(1)><$ifull(1460)></color>, I could totally put in stuff I<br>pick up.
msgctxt "1959:137"
msgid "<$voicel(1,7)><$motion(1,801)><$facial(1,4)>Si tengo una <$cdef(27)><fqty(1)><$ifull(1460)></color> a mano, iré metiendo<br>las cosas que recojo por ahí."
msgstr ""

#. en: <oneline><$voicel(1,10)><$comeff(1,9)><$comeff(1,9)><$motion(1,803)><$facial(1,4)>Hey, <$cdef(27)><pname;0></color>! Yo, I hope you’ll call on<br>me<slide><br>when<slide><br>it’s<slide><br>time<slide><br>to<slide><br><$cdef(27)><$spwfull(1)></color><$cdef(27)> </color>somethin’!
msgctxt "1959:138"
msgid "<$voicel(1,10)><$comeff(1,9)><$comeff(1,9)><$motion(1,803)><$facial(1,4)>¡Cuando necesites una mano para <$cdef(27)><$spwfull(1)></color> lo que sea,<br>dame un toque!"
msgstr "<$voicel(1,10)><$comeff(1,9)><$comeff(1,9)><$motion(1,803)><$facial(1,4)>¡Cuando necesites una mano para <$cdef(27)><$spwfull(1)></color> lo que sea,<br>avísame!"

#. en: <$voicel(1,9)><$comeff(1,10)><$motion(1,801)><$facial(1,4)>Lemme know if you ever need some fire! I can totally<br>help, yo!
msgctxt "1959:139"
msgid "<$voicel(1,9)><$comeff(1,10)><$motion(1,801)><$facial(1,4)>¿Necesitas prender algo? ¡Pues no te rayes, que yo<br>siempre estoy on fire!"
msgstr "<$voicel(1,9)><$comeff(1,10)><$motion(1,801)><$facial(1,4)>¿Necesitas prender algo? ¡Pues no te preocupes,<br>que yo siempre estoy on fire!"

#. en: <$voicel(1,7)><$comeff(1,3)><$motion(1,801)><$facial(1,4)>Yo! Gimme a holler whenever you need some water!
msgctxt "1959:140"
msgid "<$voicel(1,7)><$comeff(1,3)><$motion(1,801)><$facial(1,4)>¡Si necesitas agua, llámame, que voy!"
msgstr ""

#. en: <$voicel(1,9)><$comeff(1,9)><$motion(1,803)><$facial(1,4)>Yo, if you need electricity to get things working, just take<br>me with you!
msgctxt "1959:141"
msgid "<$voicel(1,9)><$comeff(1,9)><$motion(1,803)><$facial(1,4)>¡Si te hace falta electricidad para hacer que algo furule,<br>llévame contigo!"
msgstr "<$voicel(1,9)><$comeff(1,9)><$motion(1,803)><$facial(1,4)>¡Si te hace falta electricidad para hacer que algo funcione,<br>llévame contigo!"

#. en: <$voicel(1,7)><$comeff(1,3)><$motion(1,801)>Yo, I hope you’ll bring me along if you have any trees or<br>flowers you want help growin’!<wait(1.0)> <$voicel(1,6)><$motion(1,803)><$facial(1,4)>Oh yeah—veggies too!
msgctxt "1959:142"
msgid "<$voicel(1,7)><$comeff(1,3)><$motion(1,801)>Si necesitas abonar algún árbol o flor, te acompaño.<clear><br><$voicel(1,6)><$motion(1,803)><$facial(1,4)>También me las apaño con los huertos, ¡si quieres!"
msgstr "<$voicel(1,7)><$comeff(1,3)><$motion(1,801)>Si necesitas abonar algún árbol o flor, te acompaño.<clear><br><$voicel(1,6)><$motion(1,803)><$facial(1,4)>También me las arreglo con los huertos, ¡si quieres!"

#. en: <oneline><$voicel(1,7)><$comeff(1,8)><$motion(1,801)><$facial(1,4)>If you find any <$cdef(27)><fqty(2)><class><pdcitem;1><br></color>around<slide><br>my<slide><br>home,<slide><br>feel<slide><br>free<slide><br>to<slide><br>use<slide><br>’em<slide><br>as<slide><br>you<slide><br>like, yo!
msgctxt "1959:143"
msgid "<oneline><$voicel(1,7)><$comeff(1,8)><$motion(1,801)><$facial(1,4)>Puedes quedarte tod<gen;1(os,as)><br><fcap><dart;1()><fqty(2)><class><$cdef(27)><pdcitem;1></color><slide><br>que pilles cerca<slide><br>de mi casa,<slide><br>cero problemas por mí."
msgstr "<oneline><$voicel(1,7)><$comeff(1,8)><$motion(1,801)><$facial(1,4)>Puedes quedarte tod<gen;1(os,as)><br><fcap><dart;1()><fqty(2)><class><$cdef(27)><pdcitem;1></color><slide><br>que encuentres cerca<slide><br>de mi casa,<slide><br>cero problemas por mí."

#. en: <$voicel(1,7)><$comeff(1,9)><$motion(1,801)><$facial(1,4)>I’ve been at the <$cdef(27)><fqty(1)><$ifull(1325)> </color>a lot recently doin’<br><$cdef(27)><$spwfull(12)>s</color>! It’s super fun, yo!
msgctxt "1959:144"
msgid "<$voicel(1,7)><$comeff(1,9)><$motion(1,801)><$facial(1,4)>¡Últimamente me ha tocado <$cdef(27)><$spwfull(12)></color> bastante en la<br><$cdef(27)><fqty(1)><$ifull(1325)></color> y es una pasada!"
msgstr "<$voicel(1,7)><$comeff(1,9)><$motion(1,801)><$facial(1,4)>¡Últimamente me ha tocado <$cdef(27)><$spwfull(12)></color> bastante en la<br><$cdef(27)><fqty(1)><$ifull(1325)></color> y es increíble!"

#. en: <$voicel(1,7)><$comeff(1,10)><$motion(1,803)>I dunno if you can tell by lookin’ at me, yo, but I can<br>actually sing and dance pretty good.
msgctxt "1959:146"
msgid "<$voicel(1,7)><$comeff(1,10)><$motion(1,803)>Igual pinta no tengo, pero el cante y el baile es lo mío."
msgstr "<$voicel(1,7)><$comeff(1,10)><$motion(1,803)>A lo mejor no lo parezco, pero cantar y bailar es lo mío."

#. en: <oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Yooo... <$cdef(27)><wndhmownerpk;0></color>’s living space is<br>really...<$cdef(27)><wndhmownerpk;1></color>-like,<slide><br>isn’t it?
msgctxt "1959:148"
msgid "<oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>La casa <esde;0()><$cdef(27)><wndhmownerpk;0></color> me da vibras<br>de...<slide><br>¡pues <esde;1()><$cdef(27)><wndhmownerpk;1></color>,<slide><br>claro!"
msgstr ""

#. en: <$voicel(1,5)><$emotion(1,14)>Every now and then, yo, I just get the urge to check out<br>the view around here, y’know?
msgctxt "1959:149"
msgid "<$voicel(1,5)><$emotion(1,14)>No sé, a veces como que me entran ganas de contemplar<br>estas vistas. Son muy top."
msgstr ""

#. en: <$voicel(1,9)><$emotion(1,38)><$pkcry;0(1,1)>! This is fun, yo!
msgctxt "1959:150"
msgid "<$voicel(1,9)><$emotion(1,38)>¡<$pkcry;0(1,1)>! ¡Qué divertido!"
msgstr ""

#. en: <$voicel(1,7)><$comeff(1,6)><$motion(1,805)>Yooo, I wonder what this is. I’m super curious.
msgctxt "1959:151"
msgid "<$voicel(1,7)><$comeff(1,6)><$motion(1,805)>¿Y esto qué es? Es que literal, ni idea."
msgstr ""

#. en: <oneline><$voicel(1,9)><$comeff(1,8)><$motion(1,801)><$facial(1,4)>Yo, this <$cdef(27)><fqty(1)><class><usingp;0></color> is<br>so<slide><br>cute!<slide><br>Like, seriously!
msgctxt "1959:152"
msgid "<oneline><$voicel(1,9)><$comeff(1,8)><$motion(1,801)><$facial(1,4)>¡Pero qué monada de <$cdef(27)><fqty(1)><usingp;0></color>!<br>¡Muy top!"
msgstr "<oneline><$voicel(1,9)><$comeff(1,8)><$motion(1,801)><$facial(1,4)>¡Pero qué lindura de <$cdef(27)><fqty(1)><usingp;0></color>!<br>¡Muy top!"

#. en: <oneline><$voicel(1,3)><$emotion(1,55)><fcap><iart;0()><$cdef(27)><fqty(1)><class><usingp;0></color>, huh...<br>I’m,<slide><br>like,<slide><br>super<slide><br>interested<slide><br>in<slide><br>this, yo!
msgctxt "1959:153"
msgid "<oneline><$voicel(1,3)><$emotion(1,55)>¿<fcap><iart;0()><$cdef(27)><fqty(1)><class><usingp;0></color>?<br>Qué cosa tan random..."
msgstr ""

#. en: <oneline><$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Yo! I love <$cdef(27)><fqty(2)><fcap><class><usingp;1></color>!
msgctxt "1959:155"
msgid "<oneline><$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Qué guapada de<br><$cdef(27)><fqty(1)><class><usingp;1></color>!"
msgstr "<oneline><$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Qué maravilla de<br><$cdef(27)><fqty(1)><class><usingp;1></color>!"

#. en: <oneline><$comeff(1,5)><$facial(1,4)><$motion(1,803)><$voicel(1,9)><$cdef(27)><pname;0></color>! Yooo! Doesn’t this remind<br>you<slide><br>of me?
msgctxt "1959:156"
msgid "<$comeff(1,5)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>Esto se parece mogollón a mí, ¿a que sí?"
msgstr "<$comeff(1,5)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>Esto se parece un montón a mí, ¿verdad?"

#. en: <oneline><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,9)><qty;0(This,These)> <$cdef(27)><noweating;0> </color>sure <qty;0(tastes,taste)> good, yo!<br>Am<slide><br>I<slide><br>right<slide><br>or<slide><br>am<slide><br>I right?!
msgctxt "1959:157"
msgid "<oneline><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡No hay nada como<br><iart;0()><$cdef(27)><fqty(1)><class><noweating;0></color>!"
msgstr ""

#. en: <$comeff(1,7)><$facial(1,9)><$motion(1,802)><$voicel(1,3)>Yo, uh... Honestly? Not a fan of this. But I’m gonna just<br>shut up and eat it anyway.
msgctxt "1959:158"
msgid "<$comeff(1,7)><$facial(1,9)><$motion(1,802)><$voicel(1,3)>Si te digo la verdad, no es mi cosa preferida ni de lejos,<br>pero se traga."
msgstr ""

#. en: <$comeff(1,13)><$facial(1,4)><$motion(1,807)><$voicel(1,10)>Yo, that’s so awesome, <$cdef(27)><pname;0></color>!
msgctxt "1959:159"
msgid "<$cdef(27)><$comeff(1,13)></color><$facial(1,4)><$motion(1,807)><$voicel(1,10)>¡No esperaba menos de ti!"
msgstr ""

#. en: <$comeff(1,13)><$facial(1,4)><$motion(1,807)><$voicel(1,7)>Yooo, <$cdef(27)><blsspwkpk;0></color> is pretty rad, huh?
msgctxt "1959:160"
msgid "<$comeff(1,13)><$facial(1,4)><$motion(1,807)><$voicel(1,7)>¡Guau, <dart;0()><$cdef(27)><blsspwkpk;0> </color>se sale!"
msgstr "<$comeff(1,13)><$facial(1,4)><$motion(1,807)><$voicel(1,7)>¡Guau, <dart;0()><$cdef(27)><blsspwkpk;0> </color>es lo máximo!"

#. en: <$voicel(1,7)><$comeff(1,9)><$motion(1,801)><$facial(1,4)>Wheee! Playin’ tag is fun, yo!
msgctxt "1959:161"
msgid "<$voicel(1,7)><$comeff(1,9)><$motion(1,801)><$facial(1,4)>Fiuuu, ¡cómo me mola el pillapilla!"
msgstr "<$voicel(1,7)><$comeff(1,9)><$motion(1,801)><$facial(1,4)>Fiuuu, ¡cómo me encantan las atrapadas!"

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,7)><$cdef(27)><nnowpairpk;1></color><$cdef(27)> </color>and I are totally best buds.
msgctxt "1959:162"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,7)><fcap><dart;1()><$cdef(27)><nnowpairpk;1> </color>me da buenas vibras."
msgstr ""

#. en: <$voicel(1,5)><$comeff(1,16)><$motion(1,805)>Phew, I’m startin’ to get kinda sleepy, yo... You still goin’<br>strong, <$cdef(27)><pname;0></color>?
msgctxt "1959:163"
msgid "<$cdef(27)><$voicel(1,5)></color><$comeff(1,16)><$motion(1,805)>Uf, me está entrando un sueño... ¿Tú todavía aguantas?"
msgstr ""

#. en: <$voicel(1,1)><$comeff(1,16)><$motion(1,807)>*yaaawn* Make sure you’re gettin’ enough sleep<br>too, <$cdef(27)><pname;0></color>!
msgctxt "1959:164"
msgid "<$cdef(27)><$voicel(1,1)></color><$comeff(1,16)><$motion(1,807)>Qué tarde es... Tú también deberías irte a planchar<br>la oreja."
msgstr "<$cdef(27)><$voicel(1,1)></color><$comeff(1,16)><$motion(1,807)>Qué tarde es... Tú también deberías irte a<br>dormir."

#. en: <$voicel(1,3)><$comeff(1,16)><$motion(1,806)>Whoooaaa. The sky sure is gettin’ bright. Guess it’s about<br>time for me to sleep, huh?
msgctxt "1959:165"
msgid "<$voicel(1,3)><$comeff(1,16)><$motion(1,806)>Buf, el sol me está cegando... Hora de dormir."
msgstr ""

#. en: <oneline><$voicel(1,7)><$comeff(1,16)><$motion(1,803)>*yawn* Yooo, <$cdef(27)><pname;0></color>. You sure have a<br>lot<slide><br>of<slide><br>energy<slide><br>for<slide><br>the<slide><br>morning.<slide><br>Respect, yo.
msgctxt "1959:166"
msgid "<$cdef(27)><$voicel(1,7)></color><$comeff(1,16)>Zzz... <$motion(1,803)>Qué energía tienes por la mañana... Respeto."
msgstr ""

#. en: <$voicel(1,9)><$comeff(1,9)><$motion(1,801)><$facial(1,4)>It feels totally rad to fly, yo. I wish everybody could<br>try it.
msgctxt "1959:167"
msgid "<$voicel(1,9)><$comeff(1,9)><$motion(1,801)><$facial(1,4)>¡Surcar los cielos está chetadísimo! ¡Ojalá todos pudierais<br>probarlo!"
msgstr "<$voicel(1,9)><$comeff(1,9)><$motion(1,801)><$facial(1,4)>¡Surcar los cielos está chetadísimo! ¡Ojalá todos pudieran<br>probarlo!"

#. en: <$voicel(1,3)><$comeff(1,14)><$motion(1,807)>I’m always a little worried after it rains ’cause I’m<br>scared I might rust, yo.
msgctxt "1959:168"
msgid "<$voicel(1,3)><$comeff(1,14)><$motion(1,807)>Cuando llueve me preocupa quedarme roños<gen;-3(o,a)>, literal.<br>Como me oxide, ya verás qué movida..."
msgstr "<$voicel(1,3)><$comeff(1,14)><$motion(1,807)>Cuando llueve me preocupa quedarme oxidad<gen;-3(o,a)>, literal.<br>Si me pasa, ya verás qué problema..."

#. en: <$voicel(1,7)><$comeff(1,10)><$motion(1,803)>I dunno if you can tell, but I’m totally doin’ my best not to<br>spread poison all over the place.
msgctxt "1959:169"
msgid "<$voicel(1,7)><$comeff(1,10)><$motion(1,803)>Que sepas que, a pesar de mis pintas, no voy esparciendo<br>veneno por ahí, a lo loco."
msgstr "<$voicel(1,7)><$comeff(1,10)><$motion(1,803)>Que sepas que, a pesar de mi aspecto, no voy esparciendo<br>veneno por ahí, a lo loco."

#. en: <oneline><$voicel(1,7)><$comeff(1,21)><$motion(1,801)><$facial(1,4)>I’m always so stiff, <$cdef(27)><pname;0></color>. <$voicel(1,4)><$motion(1,807)>I wish I was<br>as<slide><br>bendy<slide><br>as you...
msgctxt "1959:171"
msgid "<oneline><$voicel(1,7)><$comeff(1,21)><$motion(1,801)><$facial(1,4)>Me da mucha envidia tu cuerpo maleable,<br><$cdef(27)><pname;0></color>.<clear><br><$voicel(1,4)><$motion(1,807)>Yo soy más dur<gen;-3(o,a)> que una piedra."
msgstr ""

#. en: <$voicel(1,7)><$comeff(1,14)><$motion(1,803)>Yooo, I really wish I could sleep without getting stepped<br>on by big Pokémon...
msgctxt "1959:172"
msgid "<$voicel(1,7)><$comeff(1,14)><$motion(1,803)>Estoy un poco hart<gen;-3(o,a)> de que me pisen mientras duermo...<br>¡Que no soy un felpudo!"
msgstr "<$voicel(1,7)><$comeff(1,14)><$motion(1,803)>Estoy un poco hart<gen;-3(o,a)> de que me pisen mientras duermo...<br>¡Que no soy un tapete!"

#. en: <oneline><$voicel(1,7)><$comeff(1,10)><$motion(1,803)>Hey, <$cdef(27)><pname;0></color>! It’d be awesome if you<br>could<slide><br>make<slide><br>the<slide><br>roads<slide><br>here<slide><br>a little<slide><br>larger<slide><br>for me.
msgctxt "1959:173"
msgid "<$cdef(27)><$voicel(1,7)></color><$comeff(1,10)><$motion(1,803)>Cuando hagas un camino, si puede ser ancho, mejor."
msgstr ""

#. en: <$voicel(1,9)><$comeff(1,8)><$motion(1,801)><$facial(1,4)>Just bein’ near the water makes me feel great, y’know?
msgctxt "1959:175"
msgid "<$voicel(1,9)><$comeff(1,8)><$motion(1,801)><$facial(1,4)>¡Solo con estar cerca del agua estoy living!"
msgstr ""

#. en: <$voicel(1,7)><$comeff(1,23)><$motion(1,807)>I gotta be careful so bug Pokémon don’t chew on me while<br>I’m sleepin’, yo.
msgctxt "1959:176"
msgid "<$voicel(1,7)><$comeff(1,23)><$motion(1,807)>Miedo me da que algún Pokémon insecto me pegue<br>un mordisco mientras duermo..."
msgstr "<$voicel(1,7)><$comeff(1,23)><$motion(1,807)>Miedo me da que algún Pokémon insecto me dé<br>un mordisco mientras duermo..."

#. en: <$voicel(1,7)><$comeff(1,10)><$motion(1,805)>Controlling electricity requires a surprising amount of<br>finesse, y’know?
msgctxt "1959:177"
msgid "<$voicel(1,7)><$comeff(1,10)><$motion(1,805)>Hay que tener precisión para controlar la electricidad,<br>¡que lo sepas!"
msgstr ""

#. en: <$comeff(1,9)><$facial(1,4)><$voicel(1,8)>I bet today’ll be a good day, yo. <wait(0.4)><$comeff(1,3)><$facial(1,1)><$motion(1,807)><$voicel(1,6)>Oh, I’m not predicting<br>the future or anything. <$emotion(1,37)><$voicel(1,8)>I just kinda get that feelin’, y’know?
msgctxt "1959:178"
msgid "<$comeff(1,9)><$facial(1,4)><$voicel(1,8)>Hoy va a suceder algo mazo top...<wait(1.0)><$comeff(1,3)><$facial(1,1)><$motion(1,807)><$voicel(1,6)> Ah, no lo digo porque<br>haya visto el futuro, ¿eh? <$emotion(1,37)><$voicel(1,8)>No sé, es que me da esa vibra."
msgstr "<$comeff(1,9)><$facial(1,4)><$voicel(1,8)>Hoy va a suceder algo súper top...<wait(1.0)><$comeff(1,3)><$facial(1,1)><$motion(1,807)><$voicel(1,6)> Ah, no lo digo porque<br>haya visto el futuro, ¿eh? <$emotion(1,37)><$voicel(1,8)>No sé, es que me da esa vibra."

#. en: <$voicel(1,7)><$comeff(1,14)><$motion(1,803)>Hm... Wandering around here <$voicel(1,6)><$facial(1,4)>is givin’ me little flashbacks<br>of my past, yo!
msgctxt "1959:180"
msgid "<$voicel(1,7)><$comeff(1,14)><$motion(1,803)>Cuando me paseo por aquí... me vuelven flashes de hace<br>siglos. <$voicel(1,6)><$facial(1,4)>¡Qué nostalgia!"
msgstr ""

#. en: <$voicel(1,7)><$comeff(1,3)><$motion(1,803)>Yo, looks like there’ve been more Pokémon in this<br>area recently.<clear><br><$voicel(1,9)><$comeff(1,21)><$motion(1,801)><$facial(1,4)>I wonder what the newcomers are like. I’m, like, super<br>excited to find out!
msgctxt "1959:181"
msgid "<$voicel(1,7)><$comeff(1,3)><$motion(1,803)>¿Soy yo, o por aquí se ven más Pokémon que antes?<clear><br><$voicel(1,9)><$comeff(1,21)><$motion(1,801)><$facial(1,4)>Me pregunto quiénes serán, ¡qué hype!"
msgstr ""

#. en: <$voicel(1,8)><$comeff(1,3)><$motion(1,801)><$facial(1,4)>Oh, hey. What’s up, <$cdef(27)><pname;0></color>?
msgctxt "1959:182"
msgid "<$voicel(1,8)><$comeff(1,3)><$motion(1,801)><$facial(1,4)>¡Ah, si es <$cdef(27)><pname;0></color>! ¡Buenas!"
msgstr ""

#. en: <oneline><$voicel(1,9)><$comeff(1,9)><$motion(1,801)><$facial(1,4)>Gooood morning, <$cdef(27)><pname;0></color>! Yo, isn’t it<br>nice<slide><br>out<slide><br>right now?!
msgctxt "1959:183"
msgid "<$cdef(27)><$voicel(1,9)></color><$comeff(1,9)><$motion(1,801)><$facial(1,4)>¡Buenos días, <gen;-2(tío,tía)>! ¡Qué buena mañana!"
msgstr ""

#. en: <oneline><$voicel(1,7)><$comeff(1,21)><$motion(1,803)><$facial(1,4)><$cdef(27)><pname;0></color>! What’s up, yo?! Sun sure is<br>shinin’<slide><br>bright today!
msgctxt "1959:184"
msgid "<oneline><$voicel(1,7)><$comeff(1,21)><$motion(1,803)><$facial(1,4)>¡Eeey, es<gen;-2(e,a)> <$cdef(27)><pname;0></color>! ¡Qué solazo,<br>madre mía!"
msgstr "<oneline><$voicel(1,7)><$comeff(1,21)><$motion(1,803)><$facial(1,4)>¡Eeey, es<gen;-2(e,a)> <$cdef(27)><pname;0></color>! ¡Qué solazo,<br>de verdad!"

#. en: <oneline><$voicel(1,7)><$comeff(1,3)><$motion(1,801)><$facial(1,4)>Gooood evening, <$cdef(27)><pname;0></color>! Aren’t the<br>twinkling<slide><br>stars pretty?!
msgctxt "1959:185"
msgid "<$cdef(27)><$voicel(1,7)></color><$comeff(1,3)><$motion(1,801)><$facial(1,4)>¡Buenas noches! ¡Qué pasada de estrellas!"
msgstr "<$cdef(27)><$voicel(1,7)></color><$comeff(1,3)><$motion(1,801)><$facial(1,4)>¡Buenas noches! ¡Qué maravilla de estrellas!"

#. en: <$voicel(1,9)><$comeff(1,8)><$motion(1,801)><$facial(1,4)><$pkcry;0(1,2)>! Yooo! I LOVE the rain!
msgctxt "1959:186"
msgid "<$voicel(1,9)><$comeff(1,8)><$motion(1,801)><$facial(1,4)>¡<$pkcry;0(1,2)>! ¡La lluvia es lo mejor!"
msgstr ""

#. en: <oneline><$voicel(1,9)><$comeff(1,10)><$motion(1,803)>What’s up, <$cdef(27)><pname;0></color>! I don’t feel like<br>doin’<slide><br>anything today, yo!
msgctxt "1959:188"
msgid "<oneline><$voicel(1,9)><$comeff(1,10)><$motion(1,803)>¿Qué te cuentas, <$cdef(27)><pname;0></color>? ¡Hoy no me<br>apetece<slide><br>hacer nada!"
msgstr "<oneline><$voicel(1,9)><$comeff(1,10)><$motion(1,803)>¿Qué te cuentas, <$cdef(27)><pname;0></color>? ¡Hoy no<br>tengo ganas<slide><br>de hacer nada!"

#. en: <$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,10)>Yo, <$cdef(27)>Professor Tangrowth </color>always seems to be havin’ so much<br>fun when they’re with you, <$cdef(27)><pname;0></color>!
msgctxt "1959:189"
msgid "<$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,10)>¡Al <$cdef(27)>Profesor Tangrowth</color> se lo ve contento cuando estás tú!"
msgstr ""

#. en: <$voicel(1,6)><$comeff(1,10)><$motion(1,806)><$facial(1,4)>I’ll take it down real cleanly, yo.
msgctxt "1959:190"
msgid "<$voicel(1,6)><$comeff(1,10)><$motion(1,806)><$facial(1,4)>¡En un momento lo tienes desmontado!"
msgstr ""

#. en: <$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>I’m gonna cook so good, yo!
msgctxt "1959:191"
msgid "<$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>¡Va a quedar para chuparse los dedos! ¡Ni las migas<br>vais a dejar!"
msgstr "<$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>¡Va a quedar para chuparse los dedos! ¡Ni las migas<br>van a dejar!"

#. en: <$comeff(1,13)><$facial(1,4)><$motion(1,805)><$voicel(1,9)>Even places I go all the time seem new and exciting when<br>I’m with you, <$cdef(27)><pname;0></color>!
msgctxt "1959:192"
msgid "<$comeff(1,13)><$facial(1,4)><$motion(1,805)><$voicel(1,9)>Aaay, si es que hasta el paisaje es mucho más top cuando<br>estoy contigo."
msgstr ""

#. en: <$voicel(1,9)><$emotion(1,8)>Yooo, being with you makes everything even more fun<br>than usual, <$cdef(27)><pname;0></color>!
msgctxt "1959:193"
msgid "<$cdef(27)><$voicel(1,9)></color><$emotion(1,8)>¡Cuando estoy de chill contigo me lo paso genial!<br>¡Se nota que somos besties!"
msgstr "<$cdef(27)><$voicel(1,9)></color><$emotion(1,8)>¡Cuando estoy de chill contigo me la paso genial!<br>¡Se nota que somos besties!"

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Yooo, even the scenery looks more, like, scenic when I’m<br>with you, <$cdef(27)><pname;0></color>!
msgctxt "1959:194"
msgid "<$cdef(27)><$voicel(1,7)></color><$motion(1,803)><$facial(1,4)><$comeff(1,21)>¡Cuando estoy contigo, todo a mi alrededor me da<br>buenas vibras!"
msgstr ""

#. en: <oneline><$voicel(1,9)><$emotion(1,8)>Livin’ with you’s so cool, <$cdef(27)><pname;0></color>. We<br>get<slide><br>to<slide><br>have<slide><br>so<slide><br>many<slide><br>fun<slide><br>conversations, yo!
msgctxt "1959:195"
msgid "<$cdef(27)><$voicel(1,9)></color><$emotion(1,8)>¡Tenemos mil oportunidades de charlar desde que vivo<br>contigo! ¡Compartir casa es la leche!"
msgstr "<$cdef(27)><$voicel(1,9)></color><$emotion(1,8)>¡Tenemos mil oportunidades de charlar desde que vivo<br>contigo! ¡Compartir casa es lo máximo!"

#. en: <$voicel(1,7)><$emotion(1,14)>Yo, have you ever noticed a big shadow zoomin’ across<br>the sky? <$voicel(1,5)><$motion(1,805)><$comeff(1,6)>Do you think that’s a BIG Pokémon or somethin’?
msgctxt "1959:196"
msgid "<$voicel(1,7)><$emotion(1,14)>A veces veo pasar una sombra enorme por el cielo.<br><$voicel(1,5)><$motion(1,805)><$comeff(1,6)>¿Crees que se trata de un Pokémon gigantesco?"
msgstr ""

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>You might not know it by lookin’ at me, yo, but I’m pretty<br>good at singing! <$voicel(1,10)><$emotion(1,8)><$pkcry;1(1,1)>! ♪ <$pkcry;2(1,2)>! ♪
msgctxt "1959:197"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>No es postureo, ¿eh? Que sepas que cantar es lo mío.<br><$voicel(1,10)><$emotion(1,8)>♪¡<$pkcry;1(1,1)>, <flow><$pkcry;2(1,2)>!♪"
msgstr "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>No es pose, ¿eh? Que sepas que cantar es lo mío.<br><$voicel(1,10)><$emotion(1,8)>♪¡<$pkcry;1(1,1)>, <flow><$pkcry;2(1,2)>!♪"

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Check out my muscles, yo! Another day, another<br>awesome pump!
msgctxt "1959:198"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>¡Mira este body esculpido a base de entrenamiento!<br>¡Acero para barcos!"
msgstr "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>¡Mira este body esculpido a base de entrenamiento!<br>¡Puro músculo!"

#. en: <$voicel(1,3)><$motion(1,805)><$facial(1,9)><$comeff(1,7)>Yooo... Sometimes other Pokémon think I’m kinda scary,<br>y’know? <$voicel(1,6)><$motion(1,803)><$facial(1,4)><$comeff(1,6)>Maybe I should try to smile more or something?
msgctxt "1959:199"
msgid "<$voicel(1,3)><$motion(1,805)><$facial(1,9)><$comeff(1,7)>La gente se piensa que soy creepy, por mis pintas y tal...<br>Menuda bajona... <$voicel(1,6)><$motion(1,803)><$facial(1,4)><$comeff(1,6)>¿Crees que debería sonreír más?"
msgstr "<$voicel(1,3)><$motion(1,805)><$facial(1,9)><$comeff(1,7)>La gente cree que soy creepy, por mi aspecto y eso...<br>Qué bajón... <$voicel(1,6)><$motion(1,803)><$facial(1,4)><$comeff(1,6)>¿Crees que debería sonreír más?"

#. en: <oneline><$voicel(1,5)><$motion(1,803)><$comeff(1,10)>I want <$cdef(27)><nquestinum;1><br><class><nquestitem;0></color>, yo!
msgctxt "1959:201"
msgid "<oneline><$voicel(1,5)><$motion(1,803)><$comeff(1,10)>¡Me vendrí<qty;0(a,an)> genial <$cdef(27)><nquestinum;1></color><br><$cdef(27)><class><nquestitem;0></color>,<slide><br>tí<gen;-2(o,a)>! ¿Me <genqty;0(lo,la,los,las)> traes?"
msgstr "<oneline><$voicel(1,5)><$motion(1,803)><$comeff(1,10)>¡Me vendrí<qty;0(a,an)> genial <$cdef(27)><nquestinum;1></color><br><$cdef(27)><class><nquestitem;0></color>,<slide><br>amig<gen;-2(o,a)>! ¿Me <genqty;0(lo,la,los,las)> traes?"

#. en: <$voicel(1,7)><$emotion(1,8)>Thank you! Yooo, I’m so happy!
msgctxt "1959:202"
msgid "<$voicel(1,7)><$emotion(1,8)>¡Mis dieces! ¡Qué bieeen!"
msgstr "<$voicel(1,7)><$emotion(1,8)>¡Eres lo máximo! ¡Qué bieeen!"

#. en: <$voicel(1,6)><$motion(1,805)><$comeff(1,14)>I’m really interested in a place like this, yo.
msgctxt "1959:203"
msgid "<$voicel(1,6)><$motion(1,805)><$comeff(1,14)>Me llaman mil los sitios como este. ¿Has visto alguno?"
msgstr "<$voicel(1,6)><$motion(1,805)><$comeff(1,14)>Me encantan los lugares como este. ¿Has visto alguno?"

#. en: <$voicel(1,9)><$emotion(1,8)>Yooo! You made it just like I asked! Thank you!
msgctxt "1959:204"
msgid "<$voicel(1,9)><$emotion(1,8)>Lo he manifestado y ¡mira! ¡Si es que eres mi Pokémon<br>fav! ¡Gracias!"
msgstr "<$voicel(1,9)><$emotion(1,8)>Lo manifesté y ¡mira! ¡Si es que eres mi Pokémon<br>fav! ¡Gracias!"

#. en: <$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,7)>Do you think you could, like, make a path that’s easy for<br>me to walk on, yo?
msgctxt "1959:205"
msgid "<$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,7)>¿Podrías ponerme un camino top por el que se pueda<br>ir más de chill?"
msgstr ""

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,805)><$voicel(1,8)>Yooo! I made it! <$comeff(1,9)><$motion(1,801)><$voicel(1,9)>Thank you, <$cdef(27)><pname;0></color>!
msgctxt "1959:206"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,805)><$voicel(1,8)>¡He llegado hasta aquí gracias a ti! <$comeff(1,9)><$motion(1,801)><$voicel(1,9)>¡Mis dieces, tí<gen;-2(o,a)>!"
msgstr "<$comeff(1,10)><$facial(1,4)><$motion(1,805)><$voicel(1,8)>¡Llegué hasta aquí gracias a ti! <$comeff(1,9)><$motion(1,801)><$voicel(1,9)>¡Eres lo máximo, amig<gen;-2(o,a)>!"

#. en: <$voicel(1,7)><$motion(1,805)><$comeff(1,6)>Yooo! You’ve got everything I’m lookin’ for! Could I maybe<br>get the bit I asked for? If you don’t mind, that is...
msgctxt "1959:209"
msgid "<$voicel(1,7)><$motion(1,805)>¡Pero si ya tienes! <$comeff(1,6)>¿Me puedo agenciar eso? Va."
msgstr "<$voicel(1,7)><$motion(1,805)>¡Pero si ya tienes! <$comeff(1,6)>¿Me lo puedo quedar? Porfa."

#. en: <$voicel(1,3)><$emotion(1,14)>Oh, OK, yo... Well hey, just lemme know if you change<br>your mind!
msgctxt "1959:210"
msgid "<$voicel(1,3)><$emotion(1,14)>¡Pues nada, si cambias de opinión, ya sabes!"
msgstr ""

#. en: <oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,14)>I’ve been looking for <$cdef(27)><nquestappk;0></color>. Yo, do you think<br>you<slide><br>could<slide><br>arrange<slide><br>a<slide><br>meeting<slide><br>for us?
msgctxt "1959:212"
msgid "<oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,14)>Estoy buscando <esa;0()><$cdef(27)><nquestappk;0></color>... ¿Podrías<br>llevarme<slide><br>con <gen;0(él,ella)>?"
msgstr ""

#. en: <oneline><$voicel(1,9)><$emotion(1,39)>I’m so glad you helped us meet up, yo! Thanks a ton,<br><$cdef(27)><pname;0></color>!
msgctxt "1959:213"
msgid "<$voicel(1,9)><$emotion(1,39)>¡Me ha dado la vida encontrar a mi compi!<br>¡Muchas gracias, <$cdef(27)><pname;0></color>!"
msgstr "<$voicel(1,9)><$emotion(1,39)>¡Qué felicidad encontrar a mi compa!<br>¡Muchas gracias, <$cdef(27)><pname;0></color>!"

#. en: <oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)><$cdef(27)><pname;0></color>! Yo! I wanna take a picture<br>with you!
msgctxt "1959:214"
msgid "<oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¡Tenemos que sacarnos una buena fotaza!"
msgstr ""

#. en: <$voicel(1,6)><$emotion(1,14)>Yooo! That’s us!<clear><br><$voicel(1,9)><$emotion(1,8)>What a great picture! Thanks so much!
msgctxt "1959:215"
msgid "<$voicel(1,6)><$emotion(1,14)>¡Pero si es nuestra foto! Pues ni tan mal, ¿no?<br><$voicel(1,9)><$emotion(1,8)>Tú serás fotogénic<gen;-2(o,a)>, ¡pero yo no me quedo atrás!"
msgstr "<$voicel(1,6)><$emotion(1,14)>¡Pero si es nuestra foto! Pues nada mal, ¿no?<br><$voicel(1,9)><$emotion(1,8)>Tú serás fotogénic<gen;-2(o,a)>, ¡pero yo no me quedo atrás!"

#. en: <$comeff(1,3)><$motion(1,806)><$voicel(1,7)>Huh? Yooo! Guess I wasn’t lookin’ very well! They’re<br>already right nearby!
msgctxt "1959:217"
msgid "<$comeff(1,3)><$motion(1,806)><$voicel(1,7)>¡Pero si ya está aquí, qué pasada!"
msgstr "<$comeff(1,3)><$motion(1,806)><$voicel(1,7)>¡Pero si ya está aquí, qué increíble!"

#. en: <$voicel(1,5)><$motion(1,805)><$comeff(1,6)>Yo! I’m lookin’ for help with something. Do you have<br>some time?
msgctxt "1959:224"
msgid "<$voicel(1,5)><$motion(1,805)>Oye, tí<gen;-2(o,a)>, necesito pedirte un favor. <$comeff(1,6)>¿Tienes un momento?"
msgstr "<$voicel(1,5)><$motion(1,805)>Oye, amig<gen;-2(o,a)>, necesito pedirte un favor. <$comeff(1,6)>¿Tienes un momento?"

#. en: <$voicel(1,3)><$emotion(1,14)>OK, no big deal! Maybe next time!
msgctxt "1959:225"
msgid "<$voicel(1,3)><$emotion(1,14)>¡Tranqui, tranqui! Otro rato lo vemos."
msgstr ""

#. en: <oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,14)>I want <iart;0()><$cdef(27)><fqty(1)><class><nquestitem;0></color>,<br>yo...<slide><br>I’d<slide><br>love<slide><br>it<slide><br>if<slide><br>you<slide><br>could<slide><br>put<slide><br>one<slide><br>in<slide><br>my<slide><br>livin’ space!
msgctxt "1959:226"
msgid "<oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,14)>¡Estoy dos puntos obsesionad<gen;-3(o,a)> con<br><dart;0()><$cdef(27)><fqty(2)><class><nquestitem;0></color>!<slide><br>¡Ojalá tuviera en mi casa!"
msgstr "<oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,14)>¡Estoy súper obsesionad<gen;-3(o,a)> con<br><dart;0()><$cdef(27)><fqty(2)><class><nquestitem;0></color>!<slide><br>¡Ojalá tuviera en mi casa!"

#. en: <$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,10)>You got it for me?! Thanks, yo!
msgctxt "1959:227"
msgid "<$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,10)>¿Me lo dices en serio? ¡Eres lo más! ¡Gracias, bestie!"
msgstr ""

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Wait... Yooo! You already made it?!
msgctxt "1959:232"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>¡¿Que ya está?! ¡Mis dieces!"
msgstr "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>¡¿Que ya está?! ¡Mis respetos!"

#. en: <$voicel(1,5)><$motion(1,805)><$comeff(1,6)>Huh? Yooo! You already set it up for me?
msgctxt "1959:233"
msgid "<$voicel(1,5)><$motion(1,805)><$comeff(1,6)>¿Cómo? ¿Que has colocado eso ya? Qué pasada..."
msgstr "<$voicel(1,5)><$motion(1,805)><$comeff(1,6)>¿Cómo? ¿Que ya colocaste eso? Qué increíble..."

#. en: <$voicel(1,7)><$motion(1,803)><$comeff(1,5)>Wait... Yooo! You’re already done?!
msgctxt "1959:234"
msgid "<$voicel(1,7)><$motion(1,803)><$comeff(1,5)>Para el carro... ¡No me digas que ya está!"
msgstr "<$voicel(1,7)><$motion(1,803)><$comeff(1,5)>Espera, espera... ¡No me digas que ya está!"

#. en: <oneline><$comeff(1,3)><$facial(1,4)><$motion(1,803)><$voicel(1,5)>Ah! Yooo, <$cdef(27)><pname;0></color>! I’m gettin’ everyone<br>to help<slide><br><$voicel(1,10)>me out<slide><br>a little here.<clear><br><$comeff(1,9)><$motion(1,801)><$voicel(1,9)>It’d be super cool if we could get your help too!<br>Whaddya say?!
msgctxt "1959:235"
msgid "<oneline><$cdef(27)><$comeff(1,3)></color><$facial(1,4)><$motion(1,803)><$voicel(1,5)>¡Ey, <$cdef(27)><pname;0></color>! ¡Buenas! Ahora mismo<br>me están echando<slide><br><$voicel(1,10)>una mano con una cosa.<clear><br><$comeff(1,9)><$motion(1,801)><$voicel(1,9)>¡Si pudieras echarme tú un cable también ya sería<br>redondo!"
msgstr "<oneline><$cdef(27)><$comeff(1,3)></color><$facial(1,4)><$motion(1,803)><$voicel(1,5)>¡Ey, <$cdef(27)><pname;0></color>! ¡Buenas! Ahora mismo<br>me están echando<slide><br><$voicel(1,10)>una mano con una cosa.<clear><br><$comeff(1,9)><$motion(1,801)><$voicel(1,9)>¡Si pudieras ayudarme tú también ya sería<br>perfecto!"

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>Yooo! We finished the task everyone was helping with!<clear><br><$comeff(1,21)><$facial(1,5)><$motion(1,836)><$voicel(1,7)>Thanks so much for your help, <$cdef(27)><pname;0></color>!
msgctxt "1959:236"
msgid "<$cdef(27)><$comeff(1,9)></color><$facial(1,4)><$motion(1,801)><$voicel(1,10)>¡Se acabó! Ya hemos terminado el trabajo con el que<br>me estabais ayudando.<clear><br><$comeff(1,21)><$facial(1,5)><$motion(1,836)><$voicel(1,7)>¡Gracias por arrimar el hombro, <gen;-2(tío,tía)>!"
msgstr "<$cdef(27)><$comeff(1,9)></color><$facial(1,4)><$motion(1,801)><$voicel(1,10)>¡Se acabó! Ya terminamos el trabajo con el que<br>me estaban ayudando.<clear><br><$comeff(1,21)><$facial(1,5)><$motion(1,836)><$voicel(1,7)>¡Gracias por arrimar el hombro, <gen;-2(tío,tía)>!"

#. en: <$emotion(1,65)><$voicel(1,5)>I kinda like towns with pretty houses all lined up, y’know?<clear><br><$emotion(1,60)><$voicel(1,8)>Yo... Could you build a new house around here?!
msgctxt "1959:237"
msgid "<$emotion(1,65)><$voicel(1,5)>Estoy dos puntos obsesionad<gen;-3(o,a)> con tener más casas<br>humanas en el vecindario.<clear><br><$emotion(1,60)><$voicel(1,8)>¡Sería crema que construyeses alguna!"
msgstr "<$emotion(1,65)><$voicel(1,5)>Estoy súper obsesionad<gen;-3(o,a)> con tener más casas<br>humanas en el vecindario.<clear><br><$emotion(1,60)><$voicel(1,8)>¡Sería genial que construyeras alguna!"

#. en: <$comeff(1,9)><$motion(1,801)><$voicel(1,10)>You made a house?! Awesome, yo! Thank you so much!
msgctxt "1959:238"
msgid "<$comeff(1,9)><$motion(1,801)><$voicel(1,10)>¡Si has hecho una casa! ¡Locurón!"
msgstr "<$comeff(1,9)><$motion(1,801)><$voicel(1,10)>¡Si hiciste una casa! ¡Qué locura!"

#. en: <oneline><$comeff(1,14)><$motion(1,802)><$voicel(1,3)>I’ve got this crazy craving for<br><$cdef(27)><fqty(2)><class><nquestitem;0></color><slide><br>recently, yo...<clear><br><$comeff(1,6)><$motion(1,666)><$voicel(1,8)>You wouldn’t happen to have any extra on ya, would you,<br><$cdef(27)><pname;1></color>?
msgctxt "1959:239"
msgid "<oneline><$comeff(1,14)><$motion(1,802)><$voicel(1,3)>Tengo ganas de<br><iart;0()><$cdef(27)><fqty(1)><class><nquestitem;0></color>.<clear><br><$comeff(1,6)><$motion(1,666)><$voicel(1,8)>¿A mi bestie no le sobrar<qty;0(á,án)> un<genqty;0(o,a,os,as)>, por casualidad?"
msgstr ""

#. en: <oneline><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>Thanks so much, yo! You’re the best,<br><$cdef(27)><pname;0></color>!
msgctxt "1959:240"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>¡Estoy living! ¡Gracias, <$cdef(27)><pname;0></color>!"
msgstr ""

#. en: <$comeff(1,3)><$motion(1,661)><$voicel(1,7)>Well, that was easy! Guess I’m all good to go!
msgctxt "1959:241"
msgid "<$comeff(1,3)><$motion(1,661)><$voicel(1,7)>¡Lo has despachado como si nada! ¡Respeto, tí<gen;-2(o,a)>!"
msgstr "<$comeff(1,3)><$motion(1,661)><$voicel(1,7)>¡Lo despachaste como si nada! ¡Respeto, amig<gen;-2(o,a)>!"

#. en: <$comeff(1,9)><$motion(1,801)><$voicel(1,9)>That’s awesome! Thank you, <$cdef(27)><pname;0></color>!
msgctxt "1959:242"
msgid "<oneline><$comeff(1,9)><$motion(1,801)><$voicel(1,9)>¡Si es que eres muy pro, <$cdef(27)><pname;0></color>!<br>Gracias."
msgstr ""

#. en: <$comeff(1,6)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>Wait... Yooo, you already have some made?! Would you<br>mind sharin’ with me?
msgctxt "1959:243"
msgid "<$comeff(1,6)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>¿Ya está lista la comida? ¿Y hay algo para mí?..."
msgstr ""

#. en: <oneline><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>Thanks so much, yo! You’re the best,<br><$cdef(27)><pname;0></color>!
msgctxt "1959:244"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>¡Gracias, <$cdef(27)><pname;0></color>! Eres mi persona fav."
msgstr ""

#. en: <$cdef(27)><$facial(1,4)><$motion(1,803)><$comeff(1,1)><$voicel(1,7)><pname;0></color>! You’re always so good to me!<clear><br><$cdef(27)><$voicel(1,9)><$facial(1,4)><$motion(1,801)><$comeff(1,21)></color>This isn’t much, but I’d like you to have it, yo. Just my way<br>of sayin’ thanks!
msgctxt "1959:301"
msgid "<$cdef(27)><$facial(1,4)><$motion(1,803)><$comeff(1,1)><$voicel(1,7)></color>Gracias por portarte así de bien conmigo, <gen;-2(tío,tía)>.<br>Toma esto. <$cdef(27)><$voicel(1,9)><$facial(1,4)><$motion(1,801)><$comeff(1,21)></color>No es gran cosa, pero espero que te guste."
msgstr ""

#. en: <$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>Hmmm. I think the group would be a little TOO big if I<br>joined in... <$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,3)>Maybe some other time!
msgctxt "1959:302"
msgid "<$comeff(1,14)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>Uf, si voy yo también, vamos a ser demasiados. Pareces<br>u<gen;-2(n,na)> influencer, qué poder de convocatoria.<clear><br><$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,3)>Mejor lo dejamos para otra vez."
msgstr ""

#. en: <$comeff(1,4)><$motion(1,807)><$voicel(1,3)>Can you ask me again a little later? Sorry, yo!
msgctxt "1959:303"
msgid "<$comeff(1,4)><$motion(1,807)><$voicel(1,3)>¡Ahora no puedo, tí<gen;-2(o,a)>! Mejor luego."
msgstr "<$comeff(1,4)><$motion(1,807)><$voicel(1,3)>¡Ahora no puedo, amig<gen;-2(o,a)>! Mejor luego."

#. en: <$voicel(1,7)><$facial(1,4)><$comeff(1,9)><$motion(1,801)><$pkcry;0(1,1)>! Hope you’re lookin’ forward to the<br>finished product, yo!
msgctxt "1959:304"
msgid "<$voicel(1,7)><$facial(1,4)><$comeff(1,9)><$motion(1,801)>¡<$pkcry;0(1,1)>! ¡Ya verás qué bien va a quedar!"
msgstr ""

#. en: <$comeff(1,10)><$facial(1,4)><$voicel(1,10)><$motion(1,803)><$pkcry;0(1,1)>! Followin’ you!
msgctxt "1959:305"
msgid "<$comeff(1,10)><$facial(1,4)><$voicel(1,10)><$motion(1,803)>¡Tú mandas, <flow><$pkcry;0(1,1)>! ¡Te sigo!"
msgstr ""

#. en: <$voicel(1,9)>Yo, we goin’ separate ways now? <wait(0.4)><$motion(1,801)><$comeff(1,10)><$facial(1,4)>All right! Catch ya later,<br>then! <$pkcry;0(1,1)>!
msgctxt "1959:306"
msgid "<oneline><$voicel(1,9)>Pues nada, yo me despido aquí. <wait(0.4)><$motion(1,801)><$comeff(1,10)><$facial(1,4)>¡Bye, byeee!<br>¡<$pkcry;0(1,1)>!"
msgstr ""

#. en: <$voicel(1,1)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>Sorry, yo... I’m just so hungry right now. I dunno if I could<br>go out and do stuff...
msgctxt "1959:307"
msgid "<$voicel(1,1)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>Perdona, tí<gen;-2(o,a)>, pero tengo un hambre que no me puedo<br>ni mover..."
msgstr "<$voicel(1,1)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>Perdona, amig<gen;-2(o,a)>, pero tengo un hambre que no me puedo<br>ni mover..."

#. en: <$voicel(1,1)><$motion(1,802)><$facial(1,9)><$comeff(1,7)>*rumble rumble* Oh nooo... I’m suddenly super hungry, yo.<br>I dunno if I can take another step...
msgctxt "1959:308"
msgid "<$voicel(1,1)><$motion(1,802)><$facial(1,9)><$comeff(1,7)>Aargh... Qué hambre... No puedo dar ni un paso más..."
msgstr ""

#. en: <oneline><$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,17)><$pkcry;0(1,4)>... It’s rainin’, yo. Guess I’ll just escape<br>the<slide><br>rain<slide><br>and<slide><br>have<slide><br>a<slide><br>quiet day...
msgctxt "1959:311"
msgid "<oneline><$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,17)>¡<$pkcry;0(1,4)>, si está lloviendo! Pues nada, habrá que<br>quedarse<slide><br>en casa to'l día."
msgstr ""

#. en: <$motion(1,803)><$voicel(1,1)><$facial(1,7)>OW! Yooo. <wait(0.4)><$motion(1,825)><$comeff(1,22)>Could you maybe not do that?
msgctxt "1959:315"
msgid "<$motion(1,803)><$voicel(1,1)><$facial(1,7)>¡Au! <wait(0.4)><$motion(1,825)><$comeff(1,22)>No te paseees, no te pases."
msgstr "<$motion(1,803)><$voicel(1,1)><$facial(1,7)>¡Auch! <wait(0.4)><$motion(1,825)><$comeff(1,22)>No te paseees, no te pases."

#. en: <oneline><$voicel(1,7)>Yooo! <fcap><iart;0()><$cdef(27)><fqty(1)><class><aireactp;0></color>?!<br><$comeff(1,7)><$facial(1,9)><$motion(1,803)>But, hmmm...<clear><br><$comeff(1,18)><$motion(1,802)><$voicel(1,1)>This area is kinda far from my home, yo... Could you<br>maybe move it a little closer for me?
msgctxt "1959:317"
msgid "<oneline><$voicel(1,7)>¡Ey, pero si <qty;0(es,son)><br><iart;0()><$cdef(27)><fqty(1)><class><aireactp;0></color>!<wait(0.4)><slide><br><$comeff(1,7)><$facial(1,9)><$motion(1,803)>Un momento...<clear><br><$comeff(1,18)><$motion(1,802)><$voicel(1,1)><qty;0(Está,Están)> como algo lejos de mi casa. Pónme<genqty;0(lo,la,los,las)> allí, anda."
msgstr "<oneline><$voicel(1,7)>¡Ey, pero si <qty;0(es,son)><br><iart;0()><$cdef(27)><fqty(1)><class><aireactp;0></color>!<wait(0.4)><slide><br><$comeff(1,7)><$facial(1,9)><$motion(1,803)>Un momento...<clear><br><$comeff(1,18)><$motion(1,802)><$voicel(1,1)><qty;0(Está,Están)> como algo lejos de mi casa. Ponme<genqty;0(lo,la,los,las)> allá, anda."

#. en: <oneline><$comeff(1,1)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>You brought me<br><iart;0()><$cdef(27)><fqty(1)><class><aireactp;0></color>!<slide><br>Thank<slide><br>you<slide><br>so<slide><br>much, yo!
msgctxt "1959:318"
msgid "<oneline><$comeff(1,1)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Gracias por <dart;0()><$cdef(27)><fqty(1)><aireactp;0></color>!<br>¡Eres muy top!"
msgstr ""

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,5)>Yooo! I’m a fan of that move for sure!
msgctxt "1959:319"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,5)>¡Yasss! ¡Qué gustito!"
msgstr ""

#. en: <$comeff(1,6)><$facial(1,1)><$motion(1,827)><$voicel(1,4)>Yo, that kinda...tickles?
msgctxt "1959:320"
msgid "<$comeff(1,6)><$facial(1,1)><$motion(1,827)><$voicel(1,4)>Qué sensación tan... rara."
msgstr ""

#. en: <oneline><$comeff(1,19)><$facial(1,9)><$motion(1,802)><$voicel(1,4)>Huh?! The <$cdef(27)><fqty(1)><class><aireactp;0></color><br>is<slide><br>gone, yo!
msgctxt "1959:322"
msgid "<oneline><$comeff(1,19)><$facial(1,9)><$motion(1,802)><$voicel(1,4)>¡Ey! ¿Qué ha pasado con<br><dart;0()><$cdef(27)><fqty(1)><aireactp;0></color>?"
msgstr "<oneline><$comeff(1,19)><$facial(1,9)><$motion(1,802)><$voicel(1,4)>¡Ey! ¿Qué pasó con<br><dart;0()><$cdef(27)><fqty(1)><aireactp;0></color>?"

#. en: <$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Yooo, my home’s warmer now! <$comeff(1,9)><$motion(1,801)><$voicel(1,10)>I’m here for it!
msgctxt "1959:323"
msgid "<$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>¡Qué calorete más bueno hace en mi casa! <$comeff(1,9)><$motion(1,801)><$voicel(1,10)>¡Es la leche!"
msgstr "<$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>¡Qué calorcito tan rico hace en mi casa! <$comeff(1,9)><$motion(1,801)><$voicel(1,10)>¡Es lo máximo!"

#. en: <$comeff(1,6)><$facial(1,9)><$motion(1,827)><$voicel(1,3)>Yo, is it just me, or did my home get hotter recently? <$comeff(1,19)><$motion(1,802)><$voicel(1,2)>I feel<br>like I might get a bit dizzy from the heat...
msgctxt "1959:324"
msgid "<$comeff(1,6)><$facial(1,9)><$motion(1,827)><$voicel(1,3)>Uf, qué calorazo hace en mi casa, ¿no? <$comeff(1,19)><$motion(1,802)><$voicel(1,2)>Me va a dar<br>un parrús..."
msgstr "<$comeff(1,6)><$facial(1,9)><$motion(1,827)><$voicel(1,3)>Uf, qué calorazo hace en mi casa, ¿no? <$comeff(1,19)><$motion(1,802)><$voicel(1,2)>Me va a dar<br>un golpe de calor..."

#. en: <$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>I think my home’s cooler now. <$comeff(1,9)><$motion(1,801)><$voicel(1,10)>Yo, this is great!
msgctxt "1959:325"
msgid "<$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>¡No cambio mi casa fresquita por nada! <$comeff(1,9)><$motion(1,801)><$voicel(1,10)>¡A gustísimo, oye!"
msgstr ""

#. en: <$comeff(1,7)><$facial(1,9)><$motion(1,827)><$voicel(1,3)>Yooo, I think my home got colder or somethin’. <$comeff(1,23)><$motion(1,802)><$voicel(1,2)>Brrr...
msgctxt "1959:326"
msgid "<$comeff(1,7)><$facial(1,9)><$motion(1,827)><$voicel(1,3)>Ay, qué frío hace en mi casa, ¿no? <$comeff(1,23)><$motion(1,802)><$voicel(1,2)>Brrr..."
msgstr ""

#. en: <$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>My home’s brighter now, yo! <$comeff(1,9)><$motion(1,801)><$voicel(1,10)>Nice!
msgctxt "1959:327"
msgid "<$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>¡No veas la luz que tiene mi casa, <gen;-2(tío,tía)>! <$comeff(1,9)><$motion(1,801)><$voicel(1,10)>¡Es la caña!"
msgstr "<$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>¡Mira la luz que tiene mi casa, <gen;-2(tío,tía)>! <$comeff(1,9)><$motion(1,801)><$voicel(1,10)>¡Es lo máximo!"

#. en: <$comeff(1,6)><$facial(1,9)><$motion(1,827)><$voicel(1,3)>Yo, did my home get brighter or somethin’? <$comeff(1,19)><$motion(1,802)><$voicel(1,2)>I wish it<br>was darker, to be honest...
msgctxt "1959:328"
msgid "<$comeff(1,6)><$facial(1,9)><$motion(1,827)><$voicel(1,3)>¿Qué es esta luz cegadora en casa? <$comeff(1,19)><$motion(1,802)><$voicel(1,2)>A mí me va más que<br>esté más oscurito."
msgstr "<$comeff(1,6)><$facial(1,9)><$motion(1,827)><$voicel(1,3)>¿Qué es esta luz cegadora en casa? <$comeff(1,19)><$motion(1,802)><$voicel(1,2)>Yo prefiero que<br>esté más oscurito."

#. en: <$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Yooo, it’s darker around my home now, huh? <$comeff(1,9)><$motion(1,801)><$voicel(1,10)>I’m here<br>for it!
msgctxt "1959:329"
msgid "<$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>¡Me gusta este ambiente más oscuro! <$comeff(1,9)><$motion(1,801)><$voicel(1,10)>¡Mola!"
msgstr "<$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>¡Me gusta este ambiente más oscuro! <$comeff(1,9)><$motion(1,801)><$voicel(1,10)>¡Me encanta!"

#. en: <$comeff(1,7)><$facial(1,9)><$motion(1,827)><$voicel(1,3)>I think it’s a little too dark around my home. <$comeff(1,19)><$motion(1,802)><$voicel(1,2)>Honestly, I<br>wish it was brighter, yo...
msgctxt "1959:330"
msgid "<$comeff(1,7)><$facial(1,9)><$motion(1,827)><$voicel(1,3)>Mi casa está como que demasiado oscura. <$comeff(1,19)><$motion(1,802)><$voicel(1,2)>Le vendría bien<br>algo más de luz..."
msgstr ""

#. en: <$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Yooo, my home’s gettin’ nice and humid! <$comeff(1,9)><$motion(1,801)><$voicel(1,10)>Feels great!
msgctxt "1959:331"
msgid "<$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>¡Ha subido la humedad en mi casa! ¡Se nota que no veas!<$comeff(1,9)><$motion(1,801)><$voicel(1,10)><br>¡Así da gusto!"
msgstr "<$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>¡Subió la humedad en mi casa! ¡Se nota un montón!<$comeff(1,9)><$motion(1,801)><$voicel(1,10)><br>¡Así da gusto!"

#. en: <$motion(1,802)><$facial(1,9)><$voicel(1,1)><$comeff(1,18)>Is it humid around here lately, or is it just me, yo?<clear><br><$voicel(1,3)><$comeff(1,1)><$facial(1,1)>I’m personally a fan of things bein’ a bit drier...
msgctxt "1959:332"
msgid "<$motion(1,802)><$facial(1,9)><$voicel(1,1)><$comeff(1,18)>¿Soy yo, o últimamente hay mucha humedad aquí?<br><$voicel(1,3)><$comeff(1,1)><$facial(1,1)>Es un poco heavy para mí, la verdad."
msgstr ""

#. en: <$facial(0,4)><$comeff(1,13)><$voicel(1,7)><$motion(1,801)>Hey, I can definitely tell it’s gettin’ less humid around here,<br>and I am all for it!
msgctxt "1959:333"
msgid "<$facial(0,4)><$comeff(1,13)><$voicel(1,7)><$motion(1,801)>Noto algo... Parece como que ha bajado la humedad...<br>¡Qué alivio!"
msgstr "<$facial(0,4)><$comeff(1,13)><$voicel(1,7)><$motion(1,801)>Noto algo... Parece como que bajó la humedad...<br>¡Qué alivio!"

#. en: <$motion(1,802)><$facial(1,9)><$voicel(1,3)><$comeff(1,4)>Don’t you think it’s sorta too dry around here, yo? Sure<br>would be nice to have a bit more humidity in the air...
msgctxt "1959:334"
msgid "<$motion(1,802)><$facial(1,9)><$voicel(1,3)><$comeff(1,4)>¡Qué seco está el aire aquí! Lo que daría por un poco<br>más de humedad..."
msgstr ""

#. en: <oneline><$comeff(1,14)><$motion(1,827)><$voicel(1,5)>Yooo, <$cdef(27)><pname;0></color>. I wanna go see the thing<br>you<slide><br>got<slide><br>for<slide><br>me,<slide><br><$comcan(1)><$motion(1,802)><$facial(1,9)><$voicel(1,4)>but<slide><br>there’s<slide><br>no<slide><br>path<slide><br>for<slide><br>me<slide><br>to<slide><br>get there...<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>It’d be great if you could make a path that I can use, yo!
msgctxt "1959:335"
msgid "<$cdef(27)><$comeff(1,14)></color><$motion(1,827)><$voicel(1,5)>Quiero ir a ver lo que has puesto...<clear><br><$comcan(1)><$motion(1,802)><$facial(1,9)><$voicel(1,4)>Pero me parece que no puedo llegar hasta allí...<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>¡Sería una pasada si pudieras abrirme un camino!"
msgstr "<$cdef(27)><$comeff(1,14)></color><$motion(1,827)><$voicel(1,5)>Quiero ir a ver lo que pusiste...<clear><br><$comcan(1)><$motion(1,802)><$facial(1,9)><$voicel(1,4)>Pero me parece que no puedo llegar hasta allá...<clear><br><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>¡Sería increíble si pudieras abrirme un camino!"

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>Leave it to me, yo!
msgctxt "1959:336"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>¡Yo me encargo, <gen;-2(tío,tía)>!"
msgstr ""

#. en: <$voicel(1,5)><$motion(1,805)><$comeff(1,6)>Yooo... Something’s kinda weird about this spot. Might be<br>worth checkin’ out?
msgctxt "1959:337"
msgid "<$voicel(1,5)><$motion(1,805)><$comeff(1,6)>Este lugar me da unas vibras muy raras. Si echas un ojo,<br>igual encuentras algo."
msgstr "<$voicel(1,5)><$motion(1,805)><$comeff(1,6)>Este lugar me da unas vibras muy raras. Si echas un ojo,<br>a lo mejor encuentras algo."

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Doin’ some demolishin’! This is kinda fun, yo!
msgctxt "1959:338"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¡Hola! ¡Me pillas en mi era demoledora, tí<gen;-2(o,a)>!"
msgstr "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¡Hola! ¡Me encuentras en mi era demoledora, amig<gen;-2(o,a)>!"

#. en: <$voicel(1,7)><$emotion(1,8)>It’s startin’ to smell really good! I’m excited, yo!
msgctxt "1959:339"
msgid "<$voicel(1,7)><$emotion(1,8)>¡Huele que alimenta! ¡Menudo hype!"
msgstr "<$voicel(1,7)><$emotion(1,8)>¡Huele riquísimo! ¡Qué hype!"

#. en: <$voicel(1,9)><$emotion(1,8)><$pkcry;0(1,2)>! Parties are super fun, yo!
msgctxt "1959:340"
msgid "<$voicel(1,9)><$emotion(1,8)>¡<$pkcry;0(1,2)>, qué pasada de fiesta!"
msgstr "<$voicel(1,9)><$emotion(1,8)>¡<$pkcry;0(1,2)>, qué fiesta tan increíble!"

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)><$pkcry;0(1,2)>... Yooo... This is paradise...yo.
msgctxt "1959:341"
msgid "<oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)><$pkcry;0(1,2)>... Qué relax... Desconexión absoluta."
msgstr ""

#. en: <oneline><$comeff(1,14)><$facial(1,9)><$motion(1,805)><$voicel(1,5)>It’s kinda wet over here, yo... I dunno if I can do much with<br>the <$cdef(27)><fqty(1)><class><aireactp;0></color><slide><br><$emotion(1,31)><$voicel(1,4)>like this.<clear><br><$emotion(1,29)><$voicel(1,6)>Do you think you could move it somewhere a little drier<br>for me? That’d be awesome!
msgctxt "1959:343"
msgid "<oneline><$comeff(1,14)><$facial(1,9)><$motion(1,805)><$voicel(1,5)>¡Si este sitio está to calao! No es por ser hater, <$emotion(1,31)><$voicel(1,4)>pero no<br>creo que pueda usar<slide><br><dart;0()><$cdef(27)><fqty(1)><aireactp;0></color>.<clear><br><$emotion(1,29)><$voicel(1,6)>¿Y si <genqty;0(lo,la,los,las)> pones en otro lugar?"
msgstr "<oneline><$comeff(1,14)><$facial(1,9)><$motion(1,805)><$voicel(1,5)>¡Si este lugar está empapado! No es por ser hater, <$emotion(1,31)><$voicel(1,4)>pero no<br>creo que pueda usar<slide><br><dart;0()><$cdef(27)><fqty(1)><aireactp;0></color>.<clear><br><$emotion(1,29)><$voicel(1,6)>¿Y si <genqty;0(lo,la,los,las)> pones en otro lugar?"

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>My home’s just how I like it now! Thanks so much!
msgctxt "1959:344"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Ahora tengo la casa a mi gusto, qué maravilla!"
msgstr ""

#. en: <$comeff(1,10)><$facial(1,1)><$motion(1,805)><$voicel(1,6)>My living space is gettin’ pretty nice now thanks to<br>you, <$cdef(27)><pname;0></color>!<clear><br><$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,7)>But it’d be REALLY nice if I could get just a little bit more<br>help from you, yo. Pretty please!
msgctxt "1959:345"
msgid "<$cdef(27)><$comeff(1,10)><$facial(1,1)><$motion(1,805)><$voicel(1,6)></color>¡Gracias a ti, mi casa está mejor que nunca! <$comeff(1,3)><$facial(1,1)><$motion(1,661)><$voicel(1,7)>Si me<br>pudieras ayudar un poco más, te lo agradecería."
msgstr ""

#. en: <$comeff(1,10)><$facial(1,1)><$motion(1,805)><$voicel(1,7)>I’m kinda in the mood for a treasure hunt, y’know?<clear><br><$comeff(1,3)><$facial(1,4)><$motion(1,661)><$voicel(1,8)>I bet we could find some super cool stuff if we looked<br>around with a<$cdef(27)> <fqty(1)><$ifull(2793)></color>!
msgctxt "1959:400"
msgid "<$comeff(1,10)><$facial(1,1)><$motion(1,805)><$voicel(1,7)>Hace mil que no salimos a buscar tesoros, ¿no?<br>¡Y no me digas que no!<clear><br><$comeff(1,3)><$facial(1,4)><$motion(1,661)><$voicel(1,8)>¡Si usas el <$cdef(27)><fqty(1)><$ifull(2793)></color>, igual nos sale algo!"
msgstr "<$comeff(1,10)><$facial(1,1)><$motion(1,805)><$voicel(1,7)>Hace mucho que no salimos a buscar tesoros, ¿no?<br>¡Y no me digas que no!<clear><br><$comeff(1,3)><$facial(1,4)><$motion(1,661)><$voicel(1,8)>¡Si usas el <$cdef(27)><fqty(1)><$ifull(2793)></color>, a lo mejor nos sale algo!"

#. en: <$comeff(1,1)><$motion(1,803)><$voicel(1,7)><$cdef(27)><pname;0></color>! Yooo, did you fix up the road?
msgctxt "1959:402"
msgid "<$comeff(1,1)><$motion(1,803)><$voicel(1,7)>¿Ya está listo el camino, <$cdef(27)><pname;0></color>?"
msgstr ""

#. en: <$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Thanks so much, yo! I’ll go check it out. Feel free to come<br>with me!
msgctxt "1959:403"
msgid "<$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Yasss! ¡Vamos a ver tu fantasía de camino ya mismo!"
msgstr "<$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Yasss! ¡Vamos a ver tu maravilla de camino ya mismo!"

#. en: <$comeff(1,10)><$facial(1,4)><$voicel(1,5)>Oh, OK! I’ll keep waitin’, yo!
msgctxt "1959:404"
msgid "<$comeff(1,10)><$facial(1,4)><$voicel(1,5)>Vale, tranqui, me espero un poco."
msgstr "<$comeff(1,10)><$facial(1,4)><$voicel(1,5)>Bueno, tranqui, me espero un poco."

#. en: <$comeff(1,4)><$facial(1,9)><$motion(1,802)><$voicel(1,1)>Ooof... This road’s a bit too much, yo. <$comeff(1,7)><$voicel(1,3)>It’d be nice if it<br>were just a little bit clearer...<clear><br><$voicel(1,5)><$facial(1,4)>I’d love to try again once the road’s been cleaned up.<$comeff(1,10)><$motion(1,801)><$voicel(1,8)><br>Just lemme know!
msgctxt "1959:405"
msgid "<$comeff(1,4)><$facial(1,9)><$motion(1,802)><$voicel(1,1)>Uf... Este camino así no me renta, ¿eh? <$comeff(1,7)><$voicel(1,3)>Un arreglillo no le<br>vendría mal.<clear><br><$voicel(1,5)><$facial(1,4)>En cuanto dé buenas vibras lo intento de nuevo a full.<br><$comeff(1,10)><$motion(1,801)><$voicel(1,8)>Tú dame un toque, ¿vale?"
msgstr "<$comeff(1,4)><$facial(1,9)><$motion(1,802)><$voicel(1,1)>Uf... Este camino así no me sirve, ¿eh? <$comeff(1,7)><$voicel(1,3)>Un arreglito no le<br>vendría mal.<clear><br><$voicel(1,5)><$facial(1,4)>En cuanto dé buenas vibras lo intento de nuevo a full.<br><$comeff(1,10)><$motion(1,801)><$voicel(1,8)>Tú avísame, ¿sí?"

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,3)><$pkcry;0(1,4)>... Looks like I still can’t get by, yo...<clear><br><$comeff(1,3)><$motion(1,803)><$voicel(1,5)>Lemme know when you get the path a little more clear!
msgctxt "1959:408"
msgid "<$comeff(1,14)><$motion(1,666)><$voicel(1,3)><fcap><$pkcry;0(1,4)>, aún no puedo pasar... <$comeff(1,3)><$motion(1,803)><$voicel(1,5)>¡Avísame cuando<br>esté el camino listo!"
msgstr ""

#. en: <$comeff(1,6)><$motion(1,827)><$voicel(1,5)>Yooo, so you have a friend livin’ around here with a name<br>like <$cdef(27)><wowner;0></color>?<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>I’d love to meet ’em!
msgctxt "1959:409"
msgid "<oneline><$cdef(27)><$comeff(1,6)></color><$motion(1,827)><$voicel(1,5)>Oye, estoy buscando a <$cdef(27)><wowner;0></color>.<br>¿Te suena dónde vive?<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Me gustaría que se pasara por aquí."
msgstr ""

#. en: <$comeff(1,3)><$motion(1,803)><$voicel(1,7)>All right! I’ll head on back to my home for now.
msgctxt "1959:410"
msgid "<$comeff(1,3)><$motion(1,803)><$voicel(1,7)>¡Recibido, tí<gen;-2(o,a)>! Me voy pa casa."
msgstr "<$comeff(1,3)><$motion(1,803)><$voicel(1,7)>¡Recibido, amig<gen;-2(o,a)>! Me voy pa casa."

#. en: <$voicel(1,6)><$motion(1,803)><$comeff(1,6)>Oh hey. What’s that you’re holdin’, yo?
msgctxt "1959:411"
msgid "<$voicel(1,6)><$motion(1,803)><$comeff(1,6)>¡Uoh! ¿Qué llevas ahí?"
msgstr ""

#. en: <$voicel(1,4)><$emotion(1,14)>Oh... OK...
msgctxt "1959:412"
msgid "<$voicel(1,4)><$emotion(1,14)>No me trolees..."
msgstr ""

#. en: <$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,10)>Yooo! I can have it? Seriously?! Thanks!
msgctxt "1959:413"
msgid "<$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,10)>¿Me lo das, de verdad? ¡Yasss! ¡Gracias!"
msgstr ""

#. en: <oneline><$comeff(1,6)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>Yo, what’re you gonna do with that<br><$cdef(27)><fqty(1)><class><refmateid;0></color>?
msgctxt "1959:414"
msgid "<oneline><$comeff(1,6)><$facial(1,1)><$motion(1,666)><$voicel(1,5)>¿Qué vas a hacer con es<genqty;0(e,a,os,as)><br><$cdef(27)><fqty(1)><class><refmateid;0></color>?"
msgstr ""

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>You wanna hunt for treasure?! I can help with that, yo!
msgctxt "1959:415"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Ey, ¿te vas a buscar tesoros? ¡Te echo una mano, va!"
msgstr "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Ey, ¿te vas a buscar tesoros? ¡Yo te echo una mano!"

#. en: <$voicel(1,9)><$emotion(1,39)>Thanks for everything you do for me, yo! <$voicel(1,8)><$motion(1,803)><$comeff(1,10)>I got a little<br>present for you in return!
msgctxt "1959:416"
msgid "<$voicel(1,9)><$emotion(1,39)>¡Gracias por ser mi bestie, tí<gen;-2(o,a)>! <$voicel(1,8)><$motion(1,803)><$comeff(1,10)>¡Toma este regalo!"
msgstr "<$voicel(1,9)><$emotion(1,39)>¡Gracias por ser mi bestie, amig<gen;-2(o,a)>! <$voicel(1,8)><$motion(1,803)><$comeff(1,10)>¡Toma este regalo!"

#. en: <oneline><$voicel(1,9)><$emotion(1,8)>Every day is super awesome when I’m with you,<br><$cdef(27)><pname;0></color>!<slide><br>Let’s<slide><br>be<slide><br>friends<slide><br>forever!
msgctxt "1959:417"
msgid "<$cdef(27)><$voicel(1,9)></color><$emotion(1,8)>¡Me divierto a tope contigo todos los días! ¡Eres la caña!"
msgstr "<$cdef(27)><$voicel(1,9)></color><$emotion(1,8)>¡Me divierto un montón contigo todos los días! ¡Eres lo máximo!"

#. en: <$voicel(1,9)><$motion(1,801)><$facial(1,4)><$comeff(1,10)>Yooo! This is a good find!<clear><br><$voicel(1,8)><$motion(1,803)><$comeff(1,21)>The hunt was worth it, huh?! Hope you’ll invite me<br>next time too!
msgctxt "1959:418"
msgid "<$voicel(1,9)><$motion(1,801)><$facial(1,4)><$comeff(1,10)>¡Al final hemos encontrado algo! ¡Qué guapada!<clear><br><$voicel(1,8)><$motion(1,803)><$comeff(1,21)>Ha rentado venir, ¿eh? ¡Otro día seguimos!"
msgstr "<$voicel(1,9)><$motion(1,801)><$facial(1,4)><$comeff(1,10)>¡Al final encontramos algo! ¡Qué maravilla!<clear><br><$voicel(1,8)><$motion(1,803)><$comeff(1,21)>Valió la pena venir, ¿eh? ¡Otro día seguimos!"

#. en: <$voicel(1,9)><$emotion(1,7)><$pkcry;0(1,2)>! Yooo! I love this!<clear><br><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>Thanks so much,<$cdef(27)> <pname;2></color>!
msgctxt "1959:419"
msgid "<oneline><$voicel(1,9)><$emotion(1,7)>¡<$pkcry;0(1,2)>! ¡Me encantaaa!<br><wait(0.4)><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>Gracias, <$cdef(27)><pname;2></color>,<slide><br>¡te sales!"
msgstr "<oneline><$voicel(1,9)><$emotion(1,7)>¡<$pkcry;0(1,2)>! ¡Me encantaaa!<br><wait(0.4)><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>Gracias, <$cdef(27)><pname;2></color>,<slide><br>¡eres lo máximo!"

#. en: <$comeff(1,14)><$facial(1,1)><$motion(1,805)><$voicel(1,5)>There’s this place over that way that I wanna get to...
msgctxt "1959:420"
msgid "<$comeff(1,14)><$facial(1,1)><$motion(1,805)><$voicel(1,5)>Quería pasarme por un sitio que está trending, pero..."
msgstr "<$comeff(1,14)><$facial(1,1)><$motion(1,805)><$voicel(1,5)>Quería pasarme por un lugar que está trending, pero..."

#. en: <$voicel(1,5)><$motion(1,805)><$comeff(1,6)>Whoooaaa... You’re goin’ pretty far away, huh? <$voicel(1,8)><$emotion(1,14)>In that<br>case, I think I’m gonna turn back here!
msgctxt "1959:421"
msgid "<$voicel(1,5)><$motion(1,805)><$comeff(1,6)>Eeeh... ¿Hola? Eso está un poco en el quinto pino, ¿no?<br><$voicel(1,8)><$emotion(1,14)>Yo me quedo aquí mejor."
msgstr "<$voicel(1,5)><$motion(1,805)><$comeff(1,6)>Eeeh... ¿Hola? Eso queda bastante lejos, ¿no?<br><$voicel(1,8)><$emotion(1,14)>Yo me quedo aquí mejor."

#. en: <$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,3)>But the way over there’s lookin’ kinda rough. I dunno if I<br>can make it, yo!
msgctxt "1959:422"
msgid "<$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,3)>Está el camino en plan que te hernias como pretendas ir<br>hasta allí, ¿sabes? Es muy heavy."
msgstr "<$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,3)>El camino está tan feo que te lastimas si intentas ir<br>hasta allá, ¿sabes? Es muy heavy."

#. en: <$voicel(1,3)><$motion(1,805)><$comeff(1,7)>This might be a little too small for me to live in...<clear><br><$voicel(1,6)><$motion(1,803)><$comeff(1,10)>I think I’d be happier with a home that’s a little bit bigger.
msgctxt "1959:426"
msgid "<$voicel(1,3)><$motion(1,805)><$comeff(1,7)>A ver... Por mucho que lo intente, yo ahí no voy a caber...<clear><br><$voicel(1,6)><$motion(1,803)><$comeff(1,10)>Si me buscas una casa humana más grande, sería brutal."
msgstr "<$voicel(1,3)><$motion(1,805)><$comeff(1,7)>A ver... Por mucho que lo intente, yo ahí no voy a caber...<clear><br><$voicel(1,6)><$motion(1,803)><$comeff(1,10)>Si me buscas una casa humana más grande, sería genial."

#. en: <$voicel(1,6)><$motion(1,803)><$comeff(1,10)>Yooo... This home is awesome!
msgctxt "1959:427"
msgid "<$voicel(1,6)><$motion(1,803)><$comeff(1,10)>¡Guau! ¡Esta casa humana es icónica!"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,8)>Seriously?! Yooo! Thank you!
msgctxt "1959:428"
msgid "<$voicel(1,7)><$emotion(1,8)>¿De verdad? ¡Gracias! ¡Mis haters se morirán de envidia!"
msgstr ""

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>You’ve got great taste, as always! <$voicel(1,10)><$emotion(1,39)>I really admire you<br>for that, yo!
msgctxt "1959:429"
msgid "<$cdef(27)><$voicel(1,7)></color><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¡Qué fantasía de diseño! ¡Tienes madera de influencer!<br><$voicel(1,10)><$emotion(1,39)>¡Respeto!"
msgstr "<$cdef(27)><$voicel(1,7)></color><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¡Qué maravilla de diseño! ¡Tienes madera de influencer!<br><$voicel(1,10)><$emotion(1,39)>¡Respeto!"

#. en: <$voicel(1,5)><$comeff(1,6)><$motion(1,805)>Yooo! I can live here?!
msgctxt "1959:430"
msgid "<$voicel(1,5)><$comeff(1,6)><$motion(1,805)>¿De verdad puedo quedarme a vivir aquí?"
msgstr ""

#. en: <oneline><$voicel(1,7)><$emotion(1,8)><$pkcry;0(1,2)>!!! Yooo! Thanks,<br><$cdef(27)><pname;1></color>!
msgctxt "1959:431"
msgid "<$voicel(1,7)><$emotion(1,8)>¡¡<$pkcry;0(1,2)>!! ¡Gracias, <$cdef(27)><pname;1></color>!"
msgstr ""

#. en: <oneline><$voicel(1,5)><$motion(1,805)><$facial(1,9)><$comeff(1,6)>You weren’t bein’ serious, <$cdef(27)><pname;0></color>?! Not<br>cool, yo...
msgctxt "1959:432"
msgid "<$voicel(1,5)><$motion(1,805)><$facial(1,9)><$comeff(1,6)>¡Vaya trol estás hech<gen;-2(o,a)>, <$cdef(27)><pname;0></color>!"
msgstr ""

#. en: <$voicel(1,5)><$motion(1,805)><$comeff(1,14)>But wait... If I move in here, <$voicel(1,4)><$motion(1,807)><$comeff(1,10)>it might be too many<br>Pokémon for the space, yo! Guess I’ll pass!
msgctxt "1959:433"
msgid "<$voicel(1,5)><$motion(1,805)><$comeff(1,14)>Ah, pero si aquí ya no cabe nadie más...<clear><br><$voicel(1,4)><$motion(1,807)><$comeff(1,10)>Paso de estar apretujad<gen;-3(o,a)> en mi propia casa...<br>¡Mejor búscame otro sitio, va!"
msgstr "<$voicel(1,5)><$motion(1,805)><$comeff(1,14)>Ah, pero si aquí ya no cabe nadie más...<clear><br><$voicel(1,4)><$motion(1,807)><$comeff(1,10)>No quiero estar apretujad<gen;-3(o,a)> en mi propia casa...<br>¡Mejor búscame otro lugar, porfa!"

#. en: <oneline><$voicel(1,9)><$emotion(1,39)>Yooo! We hit the jackpot!<clear><br><$voicel(1,7)><$motion(1,803)><$comeff(1,10)>You’re a natural, <$cdef(27)><pname;0></color>! Let’s do this<br>again sometime!
msgctxt "1959:434"
msgid "<$cdef(27)><$voicel(1,9)></color><$emotion(1,39)>¡La búsqueda de tesoros ha sido un éxito!<clear><br><$voicel(1,7)><$motion(1,803)><$comeff(1,10)>Se te da de miedo. ¡Repitamos otro día!"
msgstr "<$cdef(27)><$voicel(1,9)></color><$emotion(1,39)>¡La búsqueda de tesoros fue un éxito!<clear><br><$voicel(1,7)><$motion(1,803)><$comeff(1,10)>Se te da genial. ¡Repitamos otro día!"

#. en: <$comeff(1,6)><$motion(1,827)><$voicel(1,5)>Yooo! What’s that shiny thing, <$cdef(27)><pname;0></color>?
msgctxt "1959:435"
msgid "<oneline><$comeff(1,6)><$motion(1,827)><$voicel(1,5)>¡<$cdef(27)><pname;0></color>! ¿Qué es eso con brillibrilli<br>que llevas ahí?"
msgstr ""

#. en: <$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>Seriously? For me?! Yoooooo!<clear><br><$voicel(1,7)>I gotta give you something in return! <$comeff(1,13)><$motion(1,801)><$voicel(1,10)>Here ya go!
msgctxt "1959:436"
msgid "<$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,9)>¿Para mí? ¡Muchas gracias! <$voicel(1,7)>Pues ya que estamos... <wait(0.9)><$comeff(1,13)><$motion(1,801)><$voicel(1,10)>Toma."
msgstr ""

#. en: <$comeff(1,10)><$facial(1,4)><$voicel(1,7)>Ahhh, I dunno if I can accept that, yo.<clear><br><$voicel(1,5)>I bet there’s someone else out there who wants it, though!
msgctxt "1959:437"
msgid "<$comeff(1,10)><$facial(1,4)><$voicel(1,7)>Uf, quita, quita, que yo no sabría qué hacer con eso.<br><$voicel(1,5)>Mejor dáselo a alguien a quien de verdad le mole."
msgstr "<$comeff(1,10)><$facial(1,4)><$voicel(1,7)>Uf, no, no, que yo no sabría qué hacer con eso.<br><$voicel(1,5)>Mejor dáselo a alguien a quien de verdad le guste."

#. en: <$comeff(1,14)><$motion(1,827)><$voicel(1,5)>Hmmm... I’m not sure I know what to do with that, yo. <$comcan(1)><$facial(1,9)><$motion(1,803)><$voicel(1,8)><br>So, like...sorry, but I gotta pass.<clear><br><$comeff(1,1)><$facial(1,4)><$motion(1,801)><$voicel(1,8)>Thanks for thinkin’ of me, though!
msgctxt "1959:438"
msgid "<$comeff(1,14)><$motion(1,827)><$voicel(1,5)>Pueees, qué random este regalo, ¿no?<clear><br><$comcan(1)><$facial(1,9)><$motion(1,803)><$voicel(1,8)>Ya lo siento... No tengo ni idea de para qué sirve eso.<clear><br><$comeff(1,1)><$facial(1,4)><$motion(1,801)><$voicel(1,8)>Mejor dáselo a otro, pero gracias por pensar en mí."
msgstr "<$comeff(1,14)><$motion(1,827)><$voicel(1,5)>Pueees, qué random este regalo, ¿no?<clear><br><$comcan(1)><$facial(1,9)><$motion(1,803)><$voicel(1,8)>Lo siento... No tengo ni idea de para qué sirve eso.<clear><br><$comeff(1,1)><$facial(1,4)><$motion(1,801)><$voicel(1,8)>Mejor dáselo a otro, pero gracias por pensar en mí."

#. en: <$voicel(1,3)><$motion(1,807)><$comeff(1,4)>Uh... I already live here, yo!
msgctxt "1959:439"
msgid "<$voicel(1,3)><$motion(1,807)><$comeff(1,4)>¡Pero si yo ya vivo aquí! Eres <gen;-2(un,una)> empanad<gen;-2(o,a)> de la vida."
msgstr "<$voicel(1,3)><$motion(1,807)><$comeff(1,4)>¡Pero si yo ya vivo aquí! Eres <gen;-2(un,una)> despistad<gen;-2(o,a)> total."

#. en: <oneline><$comeff(1,6)><$facial(1,1)><$motion(1,806)><$voicel(1,8)>Do you think you could gimme a hand here,<br><$cdef(27)><pname;0></color>?
msgctxt "1959:442"
msgid "<oneline><$comeff(1,6)><$facial(1,1)><$motion(1,806)><$voicel(1,8)>¿No lo podrías arreglar, <$cdef(27)><pname;0></color>?<br>Tú que eres<slide><br>tan pro para<slide><br>estas movidas."
msgstr "<oneline><$comeff(1,6)><$facial(1,1)><$motion(1,806)><$voicel(1,8)>¿No lo podrías arreglar, <$cdef(27)><pname;0></color>?<br>Tú que eres<slide><br>tan pro para<slide><br>estas cosas."

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Yo, <$cdef(27)><pname;0></color>! Time’s up!
msgctxt "1959:443"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¡<$cdef(27)><pname;0></color>, te has quedado sin tiempo!"
msgstr "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¡<$cdef(27)><pname;0></color>, te quedaste sin tiempo!"

#. en: <$voicel(1,5)><$emotion(1,14)><$facial(1,13)>Yooo! I NEVER thought we’d lose with this group. You’re<br>TOO awesome, <$cdef(27)><pname;0></color>!<clear><br><$voicel(1,7)><$emotion(1,39)>Your awesomeness deserves an awesome prize!
msgctxt "1959:444"
msgid "<$voicel(1,5)><$emotion(1,14)><$facial(1,13)>¡No puede seeer! ¡Si teníamos un equipazo chetadísimo!<br>¡<$cdef(27)><pname;0></color>, eres <gen;-2(el,la)> mejor!<clear><br><$voicel(1,7)><$emotion(1,39)>Tengo un buen regalo para ti. ¡Merecidísimo, tí<gen;-2(o,a)>!"
msgstr "<$voicel(1,5)><$emotion(1,14)><$facial(1,13)>¡No puede seeer! ¡Si teníamos un equipazo chetadísimo!<br>¡<$cdef(27)><pname;0></color>, eres <gen;-2(el,la)> mejor!<clear><br><$voicel(1,7)><$emotion(1,39)>Tengo un buen regalo para ti. ¡Merecidísimo, amig<gen;-2(o,a)>!"

#. en: <$voicel(1,6)><$motion(1,805)><$comeff(1,6)>We could play again if you want. How about it?
msgctxt "1959:445"
msgid "<$voicel(1,6)><$motion(1,805)><$comeff(1,6)>¿Echamos otra?"
msgstr ""

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>OK, awesome! I’ll go get ready, yo!
msgctxt "1959:446"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¡Vale, pues voy a prepararme!"
msgstr "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¡Está bien, voy a prepararme!"

#. en: <$voicel(1,5)><$motion(1,803)><$comeff(1,10)>OK! I hope we can play again some other time, yo!
msgctxt "1959:447"
msgid "<$voicel(1,5)><$motion(1,803)><$comeff(1,10)>¡Vale, pues otro día jugamos!"
msgstr "<$voicel(1,5)><$motion(1,803)><$comeff(1,10)>¡Bueno, pues otro día jugamos!"

#. en: <$comeff(1,14)><$facial(1,9)><$motion(1,666)><$voicel(1,5)>Yooo, this house seems like it’s kinda missin’ somethin’,<br>don’tcha think?<clear><br><$emotion(1,37)><$voicel(1,7)>I hate to turn down such a cool offer but, uh...I think I<br>might pass on this one!
msgctxt "1959:449"
msgid "<$comeff(1,14)><$facial(1,9)><$motion(1,666)><$voicel(1,5)>No sé, es un poco básica la casa... No me sirve ni para<br>hacer postureo.<clear><br><$emotion(1,37)><$voicel(1,7)>Gracias por la oferta, pero voy a pasar."
msgstr "<$comeff(1,14)><$facial(1,9)><$motion(1,666)><$voicel(1,5)>No sé, es un poco básica la casa... No me sirve ni para<br>presumir.<clear><br><$emotion(1,37)><$voicel(1,7)>Gracias por la oferta, pero voy a pasar."

#. en: <$voicel(1,8)><$motionoff(1,801)><$comeff(1,9)>Leave it to me!<clear><br><$voicel(1,5)><$motion(1,803)><$comeff(1,10)>It’ll take a sec, though, so just come back and see me<br>about it later, OK?
msgctxt "1959:452"
msgid "<$voicel(1,8)><$motionoff(1,801)><$comeff(1,9)>¡Yo me encargo de todo! <$voicel(1,5)><$motion(1,803)><$comeff(1,10)>¡Tengo pa rato, así que vuelve<br>luego!"
msgstr ""

#. en: <$voicel(1,3)><$motion(1,807)><$comeff(1,4)><$pkcry;0(1,2)>! Gonna take just a bit longer, yo!
msgctxt "1959:453"
msgid "<$voicel(1,3)><$motion(1,807)><$comeff(1,4)>¡<$pkcry;0(1,2)>! ¡Literal que ya casi está!"
msgstr ""

#. en: <oneline><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>Yo! Sorry for the wait! Here’s<br>the<slide><br><$cdef(27)><class><reftarid;0></color>!
msgctxt "1959:454"
msgid "<oneline><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>¡Ya <genqty;0(está,está,están,están)>! Aquí tienes <genqty;0(tu,tu,tus,tus)><br><$cdef(27)><class><reftarid;0></color>."
msgstr ""

#. en: <$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>Sorry, yo... I’m a little too busy right now.
msgctxt "1959:455"
msgid "<$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>Perdona... Ahora no puedo, que ando algo liadill<gen;-3(o,a)>..."
msgstr "<$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>Perdona... Ahora no puedo, que ando algo ocupadit<gen;-3(o,a)>..."

#. en: <$voicel(1,8)><$comeff(1,11)><$facial(1,13)><$pkcry;0(1,4)>! Yooo, where’d my home go?!
msgctxt "1959:459"
msgid "<$voicel(1,8)><$comeff(1,11)><$facial(1,13)>¡<$pkcry;0(1,4)>! ¡¡¡Pero si mi casa no está!!!"
msgstr ""

#. en: <$emotion(1,13)><$voicel(1,1)><$facial(1,9)><$motion(1,802)>This isn’t good. Guess I’m gonna have to go find a new<br>place to live.
msgctxt "1959:460"
msgid "<$emotion(1,13)><$voicel(1,1)><$facial(1,9)><$motion(1,802)>Buah, pues menudo marrón. A este paso voy a tener que<br>encontrar otro sitio para vivir..."
msgstr "<$emotion(1,13)><$voicel(1,1)><$facial(1,9)><$motion(1,802)>Uf, pues qué problema. A este paso voy a tener que<br>encontrar otro lugar para vivir..."

#. en: <oneline><$comeff(1,1)><$voicel(1,7)>Well, I bet findin’ a home’ll be a cinch!<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>That’s the kinda positive vibe I’m gettin’ from<br>ya, <$cdef(27)><pname;0></color>.
msgctxt "1959:461"
msgid "<oneline><$comeff(1,1)><$voicel(1,7)>Bueno, seguro que encuentro algo decente por ahí.<br><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Tu cara me ha inspirado confianza,<slide><br><$cdef(27)><pname;0></color>."
msgstr "<oneline><$comeff(1,1)><$voicel(1,7)>Bueno, seguro que encuentro algo decente por ahí.<br><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Tu cara me inspira confianza,<slide><br><$cdef(27)><pname;0></color>."

#. en: <oneline><$comeff(1,5)><$voicel(1,10)><$motion(1,803)>This looks awesome, yo! You made this, didn’t<br>you, <$cdef(27)><pname;0></color>?<clear><br><$comeff(1,21)><$voicel(1,9)><$facial(1,5)><$motion(1,801)>I think I’m gonna make this my new home! <$voicel(1,8)>Thanks!
msgctxt "1959:462"
msgid "<$cdef(27)><$comeff(1,5)></color><$voicel(1,10)><$motion(1,803)>¡Oye! Esta casa lo peta... ¿Me la has preparado tú?<br><$comeff(1,21)><$voicel(1,9)><$facial(1,5)><$motion(1,801)>¡Pues me mudo ahora mismo! <$voicel(1,8)>¡Gracias, <gen;-2(tío,tía)>!"
msgstr "<$cdef(27)><$comeff(1,5)></color><$voicel(1,10)><$motion(1,803)>¡Oye! Esta casa es increíble... ¿Me la preparaste tú?<br><$comeff(1,21)><$voicel(1,9)><$facial(1,5)><$motion(1,801)>¡Pues me mudo ahora mismo! <$voicel(1,8)>¡Gracias, <gen;-2(tío,tía)>!"

#. en: <oneline><$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Wha—? You got<br><iart;0()><$cdef(27)><fqty(1)><class><stfrevp;0></color><slide><br>for me?!<clear><br><$voicel(1,10)><$motion(1,803)>That’s awesome! Thanks! I’ll check it out!
msgctxt "1959:463"
msgid "<oneline><$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¿Me has puesto<br><iart;0()><fqty(1)><class><$cdef(27)><stfrevp;0></color>?<slide><br>¿En serio?<slide><br><$voicel(1,10)><$motion(1,803)>¡Mis dieces!<slide><br>Voy a ir a verl<genqty;0(o,a,os,as)> ahora mismo."
msgstr "<oneline><$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¿Me pusiste<br><iart;0()><fqty(1)><class><$cdef(27)><stfrevp;0></color>?<slide><br>¿En serio?<slide><br><$voicel(1,10)><$motion(1,803)>¡Lo máximo!<slide><br>Voy a ir a verl<genqty;0(o,a,os,as)> ahora mismo."

#. en: <$comeff(1,21)><$facial(1,4)><$motion(1,661)><$voicel(1,7)>I get to live in this super-cool house! And it’s all thanks to<br>you, <$cdef(27)><pname;0></color>!
msgctxt "1959:464"
msgid "<$comeff(1,21)><$facial(1,4)><$motion(1,661)><$voicel(1,7)>¡Gracias a ti voy a vivir en una casa muy top! ¡Qué hype!"
msgstr ""

#. en: <oneline><$comeff(1,6)><$facial(1,1)><$motion(1,661)><$voicel(1,6)>Yo, could you give this to <$cdef(27)><refpname;0> </color>for<br>me?<slide><br><$comeff(1,3)><$voicel(1,8)>They<slide><br>asked<slide><br>for<slide><br>it!
msgctxt "1959:465"
msgid "<oneline><$facial(1,1)><$motion(1,661)><$voicel(1,6)>Oye, tí<gen;-2(o,a)>, <$comeff(1,6)>¿le podrías dar esto a<br><$cdef(27)><refpname;0></color>?<slide><br><$comeff(1,3)><$voicel(1,8)>Es algo que me pidió."
msgstr "<oneline><$facial(1,1)><$motion(1,661)><$voicel(1,6)>Oye, amig<gen;-2(o,a)>, <$comeff(1,6)>¿le podrías dar esto a<br><$cdef(27)><refpname;0></color>?<slide><br><$comeff(1,3)><$voicel(1,8)>Es algo que me pidió."

#. en: Yo, <$cdef(27)><$voicel(1,6)><$comeff(1,6)><$motion(1,803)><$motion(1,827)><pname;0></color>! Wanna try a quiz real quick?
msgctxt "1959:466"
msgid "<oneline><$voicel(1,6)><$motion(1,803)><$motion(1,827)>Ey, <$cdef(27)><pname;0></color>, <$comeff(1,6)>¿a que no aciertas<br>mi pregunta?"
msgstr ""

#. en: <oneline><$motion(1,801)><$comeff(1,10)><$facial(1,4)><$voicel(1,7)>Sweet! OK, here we go!<clear><br>Comparing my height and <sizecmppk;1>’s, <$voicel(1,10)>which of us<br>is bigger?!
msgctxt "1959:467"
msgid "<oneline><$motion(1,801)><$comeff(1,10)><$facial(1,4)><$voicel(1,7)>Vale, atent<gen;-2(o,a)>, que va.<clear><br>Entre <dart;1()><$cdef(27)><sizecmppk;1></color> y yo, <$voicel(1,10)>¿quién crees que mide<br>más?"
msgstr "<oneline><$motion(1,801)><$comeff(1,10)><$facial(1,4)><$voicel(1,7)>Bueno, atent<gen;-2(o,a)>, que ahí va.<clear><br>Entre <dart;1()><$cdef(27)><sizecmppk;1></color> y yo, <$voicel(1,10)>¿quién crees que mide<br>más?"

#. en: <$comeff(1,1)><$voicel(1,8)>Yo, I feel ya! Maybe next time, then!
msgctxt "1959:468"
msgid "<$comeff(1,1)><$voicel(1,8)>Okey, otro día jugamos pues."
msgstr ""

#. en: ...<wait(0.4)><$comeff(1,20)><$facial(1,5)><$voicel(1,10)>Yep! That’s right!<clear><br><$voicel(1,9)><$motion(1,801)><$comeff(1,21)>Yo, you’re really observant of all the Pokémon here, aren’t<br>you, <$cdef(27)><pname;0></color>. Nice!
msgctxt "1959:469"
msgid "...<wait(0.4)><$comeff(1,20)><$facial(1,5)><$voicel(1,10)> ¡Cooorrecto! Muy bien, ¿eh?<clear><br><$cdef(27)><$voicel(1,9)><$motion(1,801)><$comeff(1,21)></color>Te fijas mucho en los Pokémon, por lo que veo."
msgstr ""

#. en: ...<wait(0.8)><$comeff(1,5)><$voicel(1,8)>Oooh! Nope! Wrong answer!<clear><br><$voicel(1,7)><$facial(1,4)><$motion(1,803)><$comeff(1,10)>It’s actually the opposite, yo! Maybe that question was a<br>little too difficult?<clear><br>I’ll think up a different quiz later, yo. Hope you’ll come<br>play again!
msgctxt "1959:470"
msgid "...<wait(0.8)> ...<wait(0.8)><$comeff(1,5)><$voicel(1,8)> Pueees me temo que no. ¡Mala suerte!<clear><br><$voicel(1,7)><$facial(1,4)><$motion(1,803)><$comeff(1,10)>Igual me he pasado un poco y te lo he puesto dificilillo...<br>Cuando tenga otra preguntita, te aviso."
msgstr "...<wait(0.8)> ...<wait(0.8)><$comeff(1,5)><$voicel(1,8)> Pueees me temo que no. ¡Mala suerte!<clear><br><$voicel(1,7)><$facial(1,4)><$motion(1,803)><$comeff(1,10)>A lo mejor me pasé un poco y te lo puse difícil...<br>Cuando tenga otra preguntita, te aviso."

#. en: <$comeff(1,5)><$voicel(1,10)><$motion(1,803)>Whoooaaa. You got this place ready just for me?!<clear><br><$comeff(1,13)><$voicel(1,7)><$facial(1,5)><$motion(1,801)>That’s wild. Thank you so much! Guess I’ll move right in!
msgctxt "1959:471"
msgid "<$comeff(1,5)><$voicel(1,10)><$motion(1,803)>¡¿Eh?! ¡No me digas que has preparado este lugar para mí!<br><$comeff(1,13)><$voicel(1,7)><$facial(1,5)><$motion(1,801)>¡Lo cuidaré muy bien! Te debo una, <gen;-2(tío,tía)>."
msgstr "<$comeff(1,5)><$voicel(1,10)><$motion(1,803)>¡¿Eh?! ¡No me digas que preparaste este lugar para mí!<br><$comeff(1,13)><$voicel(1,7)><$facial(1,5)><$motion(1,801)>¡Lo cuidaré muy bien! Te debo una, <gen;-2(tío,tía)>."

#. en: <$voicel(1,7)><$comeff(1,14)>Huh... Wait...<wait(0.8)><$cdef(27)><pname;1></color>?!<wait(0.7)><clear><br><$comeff(1,10)><$motion(1,801)><$facial(1,4)>Yooo! That’s one awesome <$cdef(27)><$spwfull(36)>ation</color>!
msgctxt "1959:472"
msgid "<oneline><$voicel(1,7)><$comeff(1,14)>Hmm... Espera un segundo...<br><wait(0.8)>¿Eres... <$cdef(27)><pname;1></color>?<slide><br><$cdef(27)><wait(0.7)></color><$comeff(1,10)><$motion(1,801)><$facial(1,4)>¡La leche!<slide><br>¡Qué bien <$cdef(27)>transformad<gen;-2(o,a)></color><nbs2><$spwicon(36)> vas!"
msgstr "<oneline><$voicel(1,7)><$comeff(1,14)>Hmm... Espera un segundo...<br><wait(0.8)>¿Eres... <$cdef(27)><pname;1></color>?<slide><br><$cdef(27)><wait(0.7)></color><$comeff(1,10)><$motion(1,801)><$facial(1,4)>¡Increíble!<slide><br>¡Qué bien <$cdef(27)>transformad<gen;-2(o,a)></color><nbs2><$spwicon(36)> vas!"

#. en: <$voicel(1,3)><$emotion(1,14)>Oh, but yo... There’s not enough space near the <$cdef(27)>Pokémon<br>Center </color>to play. <$voicel(1,6)><$motion(1,805)><$comeff(1,6)>Can you do anything about that?
msgctxt "1959:476"
msgid "<$voicel(1,3)><$emotion(1,14)>Parece que no hay suficiente espacio para jugar cerca<br>del <$cdef(27)>Centro Pokémon</color>.<slide><br><$voicel(1,6)><$motion(1,805)><$comeff(1,6)>¿Puedes solucionarlo?"
msgstr ""

#. en: <$comeff(1,7)><$facial(1,9)><$motion(1,802)><$voicel(1,3)>Ohhh, I’m super sorry, yo, but this doesn’t seem like a<br>place I can live...
msgctxt "1959:477"
msgid "<$comeff(1,7)><$facial(1,9)><$motion(1,802)><$voicel(1,3)>Lo siento, <gen;-2(tío,tía)>, pero no puedo vivir aquí..."
msgstr ""

#. en: <$comeff(1,6)><$voicel(1,5)><$motion(1,827)>What? I can have that?!<clear><br><$comeff(1,10)><$voicel(1,7)><$motion(1,803)><$facial(1,4)>Yooo, but...I’m kinda full right now. Maybe next time!
msgctxt "1959:478"
msgid "<$comeff(1,6)><$voicel(1,5)><$motion(1,827)>¿Es para mí?<$comeff(1,10)><$voicel(1,7)><$motion(1,803)><$facial(1,4)> Gracias, pero es que estoy llen<gen;-3(o,a)>. Otro día."
msgstr ""

#. en: <$emotion(1,29)><$voicel(1,6)>Where we talkin’ about livin’, yo?
msgctxt "1959:481"
msgid "<$emotion(1,29)><$voicel(1,6)>¿Mudarme? Tú dirás adónde."
msgstr ""

#. en: <$emotion(1,60)><$voicel(1,9)>Yooo! So that’s gonna be my new home?!
msgctxt "1959:482"
msgid "<$emotion(1,60)><$voicel(1,9)>¡Uoh! ¿Esta es mi nueva casa?"
msgstr ""

#. en: <$motion(1,801)><$comeff(1,10)><$facial(1,4)><$voicel(1,7)>Sweet! All right, here we go!<clear><br>Say you’ve got me and <$cdef(27)><weightcmppk;1></color>—<$voicel(1,10)>who’s heavier?!
msgctxt "1959:484"
msgid "<oneline><$motion(1,801)><$comeff(1,10)><$facial(1,4)><$voicel(1,7)>Venga, venga, que va.<clear><br>Entre <dart;1()><$cdef(27)><weightcmppk;1></color> y yo, <$voicel(1,10)>¿quién crees que pesa<br>más?"
msgstr "<oneline><$motion(1,801)><$comeff(1,10)><$facial(1,4)><$voicel(1,7)>Vamos, vamos, que ahí va.<clear><br>Entre <dart;1()><$cdef(27)><weightcmppk;1></color> y yo, <$voicel(1,10)>¿quién crees que pesa<br>más?"

#. en: <oneline><$comeff(1,1)><$voicel(1,7)>Hey, <$cdef(27)><pname;0></color>! What’s up, yo? You<br>need this?
msgctxt "1959:489"
msgid "<$comeff(1,1)><$voicel(1,7)>¿Qué pasa, <$cdef(27)><pname;0></color>? ¿Quieres eso?"
msgstr ""

#. en: <$comeff(1,9)><$facial(1,4)><$voicel(1,9)>You bet! What do you wanna trade me?
msgctxt "1959:490"
msgid "<$comeff(1,9)><$facial(1,4)><$voicel(1,9)>¡Tomaaa! ¿Y qué me llevo yo a cambio...?"
msgstr "<$comeff(1,9)><$facial(1,4)><$voicel(1,9)>¡Claaaro! ¿Y qué me llevo yo a cambio...?"

#. en: <$comeff(1,9)><$motion(1,803)><$voicel(1,7)>OK! Lemme know anytime if you end up wantin’ it!
msgctxt "1959:491"
msgid "<$comeff(1,9)><$motion(1,803)><$voicel(1,7)>¡Tú sabrás! Si cambias de opinión, me dices."
msgstr ""

#. en: <$voicel(1,9)><$comeff(1,21)><$motion(1,801)><$facial(1,5)>Heck yeah! <$cdef(27)><fcap><$spwfull(12)></color> successful!
msgctxt "1959:492"
msgid "<$voicel(1,9)><$comeff(1,21)><$motion(1,801)><$facial(1,5)>¡Pues ya está, <$cdef(27)>negociación</color><nbs2><$spwicon(12)> finiquitada!"
msgstr ""

#. en: <$comeff(1,1)><$motion(1,803)><$voicel(1,7)>You don’t want it after all, yo? I guess lemme know if you<br>change your mind!
msgctxt "1959:493"
msgid "<$comeff(1,1)><$motion(1,803)><$voicel(1,7)>¿Qué pasa, que ya no te interesa? Bueno, pues si cambias<br>de opinión, aquí estoy."
msgstr ""

#. en: <$voicel(1,7)>Thanks for the <$cdef(27)><$spwfull(12)></color>, yo! I’m all out of tradable stuff<br>for today. <$voicel(1,8)><$comeff(1,13)><$motion(1,803)>Should have some more sometime soon!
msgctxt "1959:494"
msgid "<$cdef(27)><$voicel(1,7)></color>¡Gracias, <gen;-2(tío,tía)>! Hoy ya no me queda nada en la tienda.<br><$voicel(1,8)><$comeff(1,13)><$motion(1,803)>Voy a empezar a reponer para la próxima, ¿ok?"
msgstr ""

#. en: <$voicel(1,5)><$comeff(1,9)>I’m headed to the <$cdef(27)><fqty(1)><$ifull(1325)></color> right now! <$voicel(1,10)><$comeff(1,10)><$facial(1,4)><$motion(1,803)>Come on<br>over and <$cdef(27)><$spwfull(12)></color> with me, yo!
msgctxt "1959:495"
msgid "<$voicel(1,5)><$comeff(1,9)>Me pillas yendo a la <$cdef(27)><fqty(1)><$ifull(1325)></color>, que me toca.<br><$voicel(1,10)><$comeff(1,10)><$facial(1,4)><$motion(1,803)>¡Pásate cuando quieras y <$cdef(27)>negociamos<nbs2><$spwicon(12)></color>!"
msgstr "<$voicel(1,5)><$comeff(1,9)>Voy de camino a la <$cdef(27)><fqty(1)><$ifull(1325)></color>, que me toca.<br><$voicel(1,10)><$comeff(1,10)><$facial(1,4)><$motion(1,803)>¡Pásate cuando quieras y <$cdef(27)>negociamos<nbs2><$spwicon(12)></color>!"

#. en: <$comeff(1,1)><$voicel(1,7)>Yooo, sorry. I’m all outta stuff to trade today! <$comeff(1,10)><$voicel(1,10)><$facial(1,4)>I’ll most<br>definitely have some more later if you wanna come<slide><br>back, though!
msgctxt "1959:496"
msgid "<$comeff(1,1)><$voicel(1,7)>Ya lo siento, pero hoy no me queda nada de nada.<br><$comeff(1,10)><$voicel(1,10)><$facial(1,4)>¡Vuelve otro día!"
msgstr "<$comeff(1,1)><$voicel(1,7)>Lo siento, pero hoy no me queda nada de nada.<br><$comeff(1,10)><$voicel(1,10)><$facial(1,4)>¡Vuelve otro día!"

#. en: <$voicel(1,6)><$comeff(1,6)><$motion(1,827)>Yo, what could this be for?
msgctxt "1959:497"
msgid "<$voicel(1,6)><$comeff(1,6)><$motion(1,827)>¿Esto pa qué sirve?"
msgstr ""

#. en: <$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>You got me some food? Yo, I’m stoked for this!
msgctxt "1959:500"
msgid "<$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¿Me has traído algo para matar el hambre? ¡Qué hype!"
msgstr "<$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¿Me trajiste algo para matar el hambre? ¡Qué hype!"

#. en: <$voicel(1,5)><$comeff(1,14)><$motion(1,805)>The air just feels nice in the morning, y’know?<clear><br><$voicel(1,3)>I dunno if that’s the reason, but, uh...<clear><br><$voicel(1,7)><$comeff(1,10)><$motion(1,803)><$facial(1,4)>Seems like a lot of Pokémon wake up and get movin’<br>around this time!
msgctxt "1959:501"
msgid "<$voicel(1,5)><$comeff(1,14)><$motion(1,805)>¿A que el aire por la mañana es más puro? ¡Da gusto!<clear><br><$voicel(1,3)>No sé si será por eso, pero... <$voicel(1,7)><$comeff(1,10)><$motion(1,803)><$facial(1,4)>como que muchos Pokémon<br>se levantan a esta hora, ¿no?"
msgstr "<$voicel(1,5)><$comeff(1,14)><$motion(1,805)>El aire por la mañana es más puro, ¿no? ¡Da gusto!<clear><br><$voicel(1,3)>No sé si será por eso, pero... <$voicel(1,7)><$comeff(1,10)><$motion(1,803)><$facial(1,4)>como que muchos Pokémon<br>se levantan a esta hora, ¿no?"

#. en: <$voicel(1,9)><$comeff(1,8)><$motion(1,801)><$facial(1,4)>Yooo, this time of day is all warm and bright!<clear><br><$voicel(1,7)><$facial(1,1)>Kinda makes me wanna take advantage by going for a<br>long walk, y’know?<clear><br><$voicel(1,5)><$comeff(1,7)><$motion(1,807)>Buuut part of me also wants to take advantage by having a<br>nice nap. Can’t decide, yo!
msgctxt "1959:502"
msgid "<$voicel(1,9)><$comeff(1,8)><$motion(1,801)><$facial(1,4)>A estas horas hace un calorcito que da gusto.<clear><br><$voicel(1,7)><$facial(1,1)>La cosa sería aprovechar para irme de excursión a algún<br>sitio pero que bien lejos...<clear><br><$voicel(1,5)><$comeff(1,7)><$motion(1,807)>Peeero también es un tiempo perfe para una siestecilla.<br>¡Qué indecisión!"
msgstr "<$voicel(1,9)><$comeff(1,8)><$motion(1,801)><$facial(1,4)>A estas horas hace un calorcito que da gusto.<clear><br><$voicel(1,7)><$facial(1,1)>La cosa sería aprovechar para irme de excursión a algún<br>lugar pero que bien lejos...<clear><br><$voicel(1,5)><$comeff(1,7)><$motion(1,807)>Peeero también es un tiempo perfe para una siestita.<br>¡Qué indecisión!"

#. en: <$voicel(1,7)><$comeff(1,14)><$motion(1,803)>I like watchin’ the orange sun sink down out of the sky...<clear><br><$voicel(1,5)>But then it’s dark before you know it! Gotta be careful, yo.
msgctxt "1959:503"
msgid "<$voicel(1,7)><$comeff(1,14)><$motion(1,803)>Si te quedas mirando el color naranja de la puesta de sol<br>como un pasmarote... <$voicel(1,5)>de repente ya es de noche y ni te<slide><br>has enterao."
msgstr "<$voicel(1,7)><$comeff(1,14)><$motion(1,803)>Si te quedas mirando el color naranja de la puesta de sol<br>como una estatua... <$voicel(1,5)>de repente ya es de noche y ni te<slide><br>diste cuenta."

#. en: <$voicel(1,7)>Did you know there are a lot of Pokémon who’re <$voicel(1,6)>just<br>gettin’ started around this time of day?<clear><br><$voicel(1,7)><$comeff(1,10)><$motion(1,803)><$facial(1,4)>You can maybe become friends with ’em if you’re up late.
msgctxt "1959:504"
msgid "<$voicel(1,7)>Hay Pokémon que empiezan el día ahora, <$voicel(1,6)>cuando hay<br>menos luz.<clear><br><$voicel(1,7)><$comeff(1,10)><$motion(1,803)><$facial(1,4)>Si te quedas despiert<gen;-2(o,a)> hasta tarde, igual haces algún<br>amigo nuevo y todo."
msgstr "<$voicel(1,7)>Hay Pokémon que empiezan el día ahora, <$voicel(1,6)>cuando hay<br>menos luz.<clear><br><$voicel(1,7)><$comeff(1,10)><$motion(1,803)><$facial(1,4)>Si te quedas despiert<gen;-2(o,a)> hasta tarde, quizás hagas algún<br>amigo nuevo y todo."

#. en: <$voicel(1,7)><$comeff(1,6)><$motion(1,803)>Yo, you’ve always got a kinda weird transformation goin’<br>on, don’t you, <$cdef(27)><pname;0></color>?<clear><br><$voicel(1,6)><$comeff(1,3)>Oh, you’re lookin’ for humans?<clear><br><$voicel(1,3)><$comeff(1,14)><$motion(1,807)>Come to think of it, I haven’t seen any humans around<br>recently. Huh...
msgctxt "1959:507"
msgid "<$cdef(27)><$voicel(1,7)></color><$comeff(1,6)><$motion(1,803)>Siempre llevas unas pintas rarísimas así transformad<gen;-2(o,a)>, <gen;-2(tío,tía)>.<clear><br><$voicel(1,6)><$comeff(1,3)>¿Es porque estás buscando a los humanos?<clear><br><$voicel(1,3)><$comeff(1,14)><$motion(1,807)>Pues, ahora que lo dices, hace mil que no veo a<br>ninguno..."
msgstr "<$cdef(27)><$voicel(1,7)></color><$comeff(1,6)><$motion(1,803)>Siempre tienes un aspecto rarísimo así transformad<gen;-2(o,a)>, <gen;-2(tío,tía)>.<clear><br><$voicel(1,6)><$comeff(1,3)>¿Es porque estás buscando a los humanos?<clear><br><$voicel(1,3)><$comeff(1,14)><$motion(1,807)>Pues, ahora que lo dices, hace mucho que no veo a<br>ninguno..."

#. en: <$voicel(1,9)><$comeff(1,10)><$motion(1,801)><$facial(1,4)>Yooo, this is such a nice place to live! I feel like I’ve been<br>here for, like...forever, y’know?<clear><br><$voicel(1,3)><$comeff(1,5)><$facial(1,9)>Wait... Where did I live before I came here? <$voicel(1,6)><$motion(1,803)><$facial(1,1)>I can’t<br>remember, yo.
msgctxt "1959:508"
msgid "<$voicel(1,9)><$comeff(1,10)><$motion(1,801)><$facial(1,4)>¡Este lugar es una pasada, se está muy bien! Es como si<br>llevara siglos viviendo aquí.<clear><br><$voicel(1,3)><$comeff(1,5)><$facial(1,9)>Un momento... ¿Dónde vivía yo antes?<clear><br><$voicel(1,6)><$motion(1,803)><$facial(1,1)>Pues no me acuerdo..."
msgstr "<$voicel(1,9)><$comeff(1,10)><$motion(1,801)><$facial(1,4)>¡Este lugar es increíble, se está muy bien! Es como si<br>llevara siglos viviendo aquí.<clear><br><$voicel(1,3)><$comeff(1,5)><$facial(1,9)>Un momento... ¿Dónde vivía yo antes?<clear><br><$voicel(1,6)><$motion(1,803)><$facial(1,1)>Pues no me acuerdo..."

#. en: <$voicel(1,7)><$comeff(1,9)><$motion(1,801)><$facial(1,4)>Yo, I’m so happy to see new friends around!<clear><br><$voicel(1,3)><$comeff(1,7)><$motion(1,807)><$facial(1,9)>Sometimes we have little fights and stuff, but...<clear><br><$voicel(1,9)><$comeff(1,10)><$motion(1,803)><$facial(1,4)>I’m sure everyone else is happy about new friends<br>too! <$pkcry;1(1,2)>!
msgctxt "1959:509"
msgid "<oneline><$voicel(1,7)><$comeff(1,9)><$motion(1,801)><$facial(1,4)>Cada vez hay más Pokémon viviendo por aquí, ¡qué hype!<clear><br><$voicel(1,3)><$comeff(1,7)><$motion(1,807)><$facial(1,9)>Aunque a veces haya alguna que otra peleílla...<clear><br><$voicel(1,9)><$comeff(1,10)><$motion(1,803)><$facial(1,4)>Pero aun y todo, creo que la gente está contenta.<br>¡<$pkcry;1(1,2)>!"
msgstr "<oneline><$voicel(1,7)><$comeff(1,9)><$motion(1,801)><$facial(1,4)>Cada vez hay más Pokémon viviendo por aquí, ¡qué hype!<clear><br><$voicel(1,3)><$comeff(1,7)><$motion(1,807)><$facial(1,9)>Aunque a veces haya alguna que otra peleíta...<clear><br><$voicel(1,9)><$comeff(1,10)><$motion(1,803)><$facial(1,4)>Pero aun así, creo que la gente está contenta.<br>¡<$pkcry;1(1,2)>!"

#. en: <$voicel(1,6)><$emotion(1,14)>No more <$cdef(27)><$spwfull(12)>s </color>today, yo?<clear><br><$voicel(1,7)><$emotion(1,8)>I’m totally down to do it again sometime, though, so be<br>sure to come see me when I do!
msgctxt "1959:516"
msgid "<$voicel(1,6)><$emotion(1,14)>¡Se acabó el <$cdef(27)><$spwfull(12)></color> por hoy pues!<clear><br><$voicel(1,7)><$emotion(1,8)>¡La próxima vez que me toque a mí, espero que te pases!"
msgstr ""

#. en: <$comeff(1,3)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Hey, <$cdef(27)><pname;0></color>! <$cdef(27)><fcap><$spwfull(12)></color> with me, yo!
msgctxt "1959:517"
msgid "<$comeff(1,3)><$facial(1,4)><$motion(1,803)><$cdef(27)><$voicel(1,7)></color>¡Holiii! ¿Te apetece <$cdef(27)><$spwfull(12)></color> un poco conmigo?"
msgstr "<$comeff(1,3)><$facial(1,4)><$motion(1,803)><$cdef(27)><$voicel(1,7)></color>¡Holiii! ¿Quieres <$cdef(27)><$spwfull(12)></color> un poco conmigo?"

#. en: <oneline><$voicel(1,7)><$comeff(1,3)><$motion(1,801)><$facial(1,4)>Yo, did you hear? <$cdef(27)><shoppk;0> </color>is over at the<br><$cdef(27)><fqty(1)><$ifull(1325)></color><slide><$cdef(27)><br></color>today!
msgctxt "1959:518"
msgid "<oneline><$voicel(1,7)><$comeff(1,3)><$motion(1,801)><$facial(1,4)>¡Hoy está <dart;0()><$cdef(27)><shoppk;0></color> dándole<br>a la <$cdef(27)><fqty(1)><$ifull(1325)></color>!"
msgstr ""

#. en: <$emotion(1,59)><$voicel(1,3)>On super rainy days, the currents get so fast it can make<br>swimmin’ kinda difficult, yo.<clear><br><$comeff(1,9)><$facial(1,4)><$voicel(1,7)>But then I sometimes find pretty rocks and stuff the next<br>morning, so it’s not all bad!
msgctxt "1959:520"
msgid "<$emotion(1,59)><$voicel(1,3)>Cuando llueve mil, la corriente va con fuerza y la cosa<br>se complica tela.<clear><br><$comeff(1,9)><$facial(1,4)><$voicel(1,7)>Pero bueno, al menos a veces te encuentras rocas chulas<br>y otras cosas curiosas a la mañana siguiente."
msgstr "<$emotion(1,59)><$voicel(1,3)>Cuando llueve mucho, la corriente va con fuerza y la cosa<br>se complica bastante.<clear><br><$comeff(1,9)><$facial(1,4)><$voicel(1,7)>Pero bueno, al menos a veces te encuentras rocas bonitas<br>y otras cosas curiosas a la mañana siguiente."

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>There’s a lot more grass and stuff around here thanks<br>to you, <$cdef(27)><pname;0></color>! <$voicel(1,10)><$emotion(1,8)>It’s really nice, yo!
msgctxt "1959:521"
msgid "<oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¡Pero qué fantasía todo esto verde gracias a ti,<br><$cdef(27)><pname;0></color>!<slide><br><$voicel(1,10)><$emotion(1,8)>¡Se está mucho más a gusto!"
msgstr "<oneline><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¡Pero qué maravilla todo esto verde gracias a ti,<br><$cdef(27)><pname;0></color>!<slide><br><$voicel(1,10)><$emotion(1,8)>¡Se está mucho más a gusto!"

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>I know this is kinda outta nowhere, yo, but here’s a present<br>for you!
msgctxt "1959:522"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¡Sorpresa! ¡Tengo un regalo para mi Pokémon fav!"
msgstr ""

#. en: <$voicel(1,7)><$motion(1,803)><$cdef(27)><nlpairpk;1> </color>and I get along, like, suuuper well!<clear><br><$voicel(1,9)><$comeff(1,10)><$facial(1,4)>We’ve been talkin’ together forever, yo.<clear><br><$voicel(1,5)><$motion(1,807)><$facial(1,1)>Can’t tell you what about, though!
msgctxt "1959:523"
msgid "<oneline><$voicel(1,7)><$motion(1,803)>Te lo creas o no, me llevo genial con <dart;1()><$cdef(27)><nlpairpk;1></color>.<clear><br><$voicel(1,9)><$comeff(1,10)><$facial(1,4)>¡Llevamos un buen rato aquí de charleta!<clear><br><$voicel(1,5)><$motion(1,807)><$facial(1,1)>Te diría de qué hemos hablado pero... es un secreto."
msgstr "<oneline><$voicel(1,7)><$motion(1,803)>Te lo creas o no, me llevo genial con <dart;1()><$cdef(27)><nlpairpk;1></color>.<clear><br><$voicel(1,9)><$comeff(1,10)><$facial(1,4)>¡Llevamos un buen rato aquí charlando!<clear><br><$voicel(1,5)><$motion(1,807)><$facial(1,1)>Te diría de qué hablamos pero... es un secreto."

#. en: <oneline><$voicel(1,7)>Yo, <$cdef(27)><pname;0></color>! About <qty;1(that,those)><br><$cdef(27)><fqty(1)><class><nlqueitem;1></color><slide><br>I got<slide><br>from you...<clear><br><$voicel(1,7)><$comeff(1,21)><$motion(1,801)><$facial(1,4)>That made me so happy, yo! <$voicel(1,10)>I’ll treasure <qty;1(it,them)> forever!
msgctxt "1959:524"
msgid "<oneline><$cdef(27)><$voicel(1,7)></color><genqty;1(El,La,Los,Las)> <fqty(1)><class><nlqueitem;1><br><genqty;1(ese,esa,esos,esas)><slide><br>que me<slide><br>diste...<slide><br><wait(0.9)><$voicel(1,7)><$comeff(1,21)><$motion(1,801)><$facial(1,4)>me hi<qty;1(zo,cieron)> mucha ilusión,<slide><br>que lo sepas.<slide><br><$voicel(1,10)>¡Muchas gracias!"
msgstr "<oneline><$cdef(27)><$voicel(1,7)></color><genqty;1(El,La,Los,Las)> <fqty(1)><class><nlqueitem;1><br><genqty;1(ese,esa,esos,esas)><slide><br>que me<slide><br>diste...<slide><br><wait(0.9)><$voicel(1,7)><$comeff(1,21)><$motion(1,801)><$facial(1,4)>me hi<qty;1(zo,cieron)> muy feliz,<slide><br>que lo sepas.<slide><br><$voicel(1,10)>¡Muchas gracias!"

#. en: <$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,5)>Yooo! You can make human houses too? <$voicel(1,8)>That’s super<br>amazing, <$cdef(27)><pname;0></color>!<clear><br><$comeff(1,13)><$motion(1,801)><$voicel(1,9)>I’d kinda like to try living in a human house, if you had<br>one available!
msgctxt "1959:525"
msgid "<$cdef(27)><$comeff(1,1)></color><$facial(1,4)><$motion(1,803)><$voicel(1,5)><gen;-2(Tío,Tía)>, ¿tú sabes construir casas humanas? <$voicel(1,8)>¡Qué nivel!<clear><br><$comeff(1,13)><$motion(1,801)><$voicel(1,9)>Si pudiera, me encantaría vivir en una casa de esas."
msgstr ""

#. en: <oneline><$voicel(1,3)><$comeff(1,16)>*yawn* It’s pretty dark out... <$voicel(1,4)><$motion(1,807)>I’m startin’ to get sleepy, yo...<clear><br><$voicel(1,7)><$comeff(1,10)><$motion(1,803)>It’s good to sleep when you’re<br>sleepy, <$cdef(27)><pname;0></color>.
msgctxt "1959:526"
msgid "<$cdef(27)><$voicel(1,3)></color><$comeff(1,16)>Así, a lo tonto, ya está muy oscuro...<clear><br><$voicel(1,4)><$motion(1,807)>Creo que ya va tocando irse a dormir.<clear><br><$voicel(1,7)><$comeff(1,10)><$motion(1,803)>Oye, tú también deberías irte a la cama cuando te entre<br>el sueño."
msgstr "<$cdef(27)><$voicel(1,3)></color><$comeff(1,16)>Así, sin darme cuenta, ya está muy oscuro...<clear><br><$voicel(1,4)><$motion(1,807)>Creo que ya va tocando irse a dormir.<clear><br><$voicel(1,7)><$comeff(1,10)><$motion(1,803)>Oye, tú también deberías irte a la cama cuando te entre<br>el sueño."

#. en: <oneline><$voicel(1,7)><$comeff(1,16)><$motion(1,807)>Yooo, the sky’s so bright... This is about the time I like to<br>go to sleep, y’know?<clear><br><oneline><$voicel(1,5)><$comeff(1,3)><$motion(1,805)>You still good, <$cdef(27)><pname;1></color>? I always like to<br>just<slide><br>go<slide><br>to<slide><br>sleep<slide><br>when<slide><br>I’m sleepy.
msgctxt "1959:527"
msgid "<$cdef(27)><$voicel(1,7)></color><$comeff(1,16)><$motion(1,807)>Aaah... El sol me ciega, literal. Pa mí es hora de dormir.<clear><br><$voicel(1,5)><$comeff(1,3)><$motion(1,805)>¿Tú todavía aguantas? Si te entra el sueño, échate un rato."
msgstr ""

#. en: <$voicel(1,5)><$comeff(1,14)>When you see me and other Pokémon flying, you might<br>think we look like we’re just glidin’ carefree, right?<clear><br><$voicel(1,7)>But, like, the wind could be blowin’ really hard up or down<br>or backward or forward... <$voicel(1,6)><$comeff(1,10)><$motion(1,801)>It’s actually kinda tough, yo!<clear><br><$voicel(1,7)><$comeff(1,9)><$motion(1,803)><$facial(1,4)>We all practice flying from the time we’re little kids<br>and gradually learn to fly all graceful-like.
msgctxt "1959:528"
msgid "<$voicel(1,5)><$comeff(1,14)>Cuando nos ves volar, igual te parece que vamos sobraos,<br><$voicel(1,7)>pero que si viento de frente, de cola, cruzado...<clear><br><$voicel(1,6)><$comeff(1,10)><$motion(1,801)>¡Hay un millón de cosas que tener en cuenta!<clear><br><$voicel(1,7)><$comeff(1,9)><$motion(1,803)><$facial(1,4)>Tenemos que practicar un montón desde niños para volar<br>con tanto estilazo, que lo sepas."
msgstr "<$voicel(1,5)><$comeff(1,14)>Cuando nos ves volar, a lo mejor te parece muy fácil,<br><$voicel(1,7)>pero que si viento de frente, de cola, cruzado...<clear><br><$voicel(1,6)><$comeff(1,10)><$motion(1,801)>¡Hay un millón de cosas que tener en cuenta!<clear><br><$voicel(1,7)><$comeff(1,9)><$motion(1,803)><$facial(1,4)>Tenemos que practicar un montón desde niños para volar<br>con tanto estilazo, que lo sepas."

#. en: <$voicel(1,7)><$comeff(1,14)><$motion(1,803)>Y’know how some Pokémon get all relaxed starin’ out<br>at the ocean? <$voicel(1,6)><$motion(1,806)>I don’t get that at all, yo.<clear><br><$voicel(1,3)><$comeff(1,4)><$motion(1,802)><$facial(1,9)>I mean...what if I slipped and fell in the ocean, right?<clear><br><$voicel(1,1)><$comeff(1,23)>I’d just bloop-bloop down to the bottom and rust away!<br><$voicel(1,7)><$comeff(1,17)><$motion(1,803)>Yo, just thinkin’ about it makes me anxious!
msgctxt "1959:529"
msgid "<$voicel(1,7)><$comeff(1,14)><$motion(1,803)>Hay gente que puede estar de chill mirando el mar como<br>si nada, relajándose con el sonido de las olas...<clear><br><$voicel(1,6)><$motion(1,806)>¡Yo ni aunque me pagaran!<clear><br><$voicel(1,3)><$comeff(1,4)><$motion(1,802)><$facial(1,9)>Es que, imagínate que me caigo al agua por error...<br><wait(0.9)><$voicel(1,1)><$comeff(1,23)>me hundiría hasta el fondo y hasta luego...<clear><br><$voicel(1,7)><$comeff(1,17)><$motion(1,803)>Solo con pensarlo me oxido, literal."
msgstr ""

#. en: <$voicel(1,7)><$motion(1,803)><$comeff(1,10)>I have poison in my body, y’know? So if anyone comes and<br>attacks me, <$voicel(1,6)><$facial(1,4)>I can shoot it out to fight back.<clear><br><$voicel(1,7)><$comeff(1,14)><$facial(1,1)>But sometimes I wonder...<clear><br><$voicel(1,7)><$comeff(1,23)><$motion(1,806)><$facial(1,9)>Like...why doesn’t that poison do anything to me?<clear><br><$voicel(1,2)>Sometimes I think too much about it and get anxious...
msgctxt "1959:530"
msgid "<$voicel(1,7)><$motion(1,803)><$comeff(1,10)>¿Sabes qué? Almaceno veneno en el cuerpo, así que si<br>alguien me ataca, me defiendo <$voicel(1,6)><$facial(1,4)>tirándoselo por encima.<clear><br><$voicel(1,7)><$comeff(1,14)><$facial(1,1)>A veces eso me hace comerme el coco...<clear><br><$voicel(1,7)><$comeff(1,23)><$motion(1,806)><$facial(1,9)>¿Por qué a mí no me afecta ese veneno si, literalmente,<br>está dentro de mí?<clear><br><$voicel(1,2)>Pero mejor no pensar demasiado en estas cosas, o acabo<br>rayad<gen;-3(o,a)>..."
msgstr "<$voicel(1,7)><$motion(1,803)><$comeff(1,10)>¿Sabes qué? Almaceno veneno en el cuerpo, así que si<br>alguien me ataca, me defiendo <$voicel(1,6)><$facial(1,4)>tirándoselo por encima.<clear><br><$voicel(1,7)><$comeff(1,14)><$facial(1,1)>A veces eso me hace pensar de más...<clear><br><$voicel(1,7)><$comeff(1,23)><$motion(1,806)><$facial(1,9)>¿Por qué a mí no me afecta ese veneno si, literalmente,<br>está dentro de mí?<clear><br><$voicel(1,2)>Pero mejor no pensar demasiado en estas cosas, o acabo<br>confundid<gen;-3(o,a)>..."

#. en: <oneline><$voicel(1,5)><$comeff(1,14)><$motion(1,803)>Yooo, I bet it would be so fun and convenient <$voicel(1,6)>if I could<br>transform into other Pokémon like<slide><br>you, <$cdef(27)><pname;1></color>!<clear><br><$voicel(1,7)><$comeff(1,17)><$motion(1,802)>But I guess I need a soft body like yours for that, huh?<clear><br><$voicel(1,7)><$comeff(1,6)><$motion(1,805)>Yo, I wonder if there’s any way to soften up but keep<br>my toughness?
msgctxt "1959:532"
msgid "<$voicel(1,5)><$cdef(27)><$comeff(1,14)></color><$motion(1,803)>Sería una pasada poder transformarme como lo haces tú.<br><$voicel(1,6)>Además de ser supermegaútil, nos echaríamos unas risas.<clear><br><$voicel(1,7)><$comeff(1,17)><$motion(1,802)>Para eso hace falta un cuerpo flexible como el tuyo, ¿no?<clear><br><$voicel(1,7)><$comeff(1,6)><$cdef(27)><$motion(1,805)></color>¿Habrá alguna forma de volverse flexible pero sin perder<br>dureza?"
msgstr "<$voicel(1,5)><$cdef(27)><$comeff(1,14)></color><$motion(1,803)>Sería increíble poder transformarme como lo haces tú.<br><$voicel(1,6)>Además de ser supermegaútil, nos echaríamos unas risas.<clear><br><$voicel(1,7)><$comeff(1,17)><$motion(1,802)>Para eso hace falta un cuerpo flexible como el tuyo, ¿no?<clear><br><$voicel(1,7)><$comeff(1,6)><$cdef(27)><$motion(1,805)></color>¿Habrá alguna forma de volverse flexible pero sin perder<br>dureza?"

#. en: <oneline><$voicel(1,7)>What kind of stuff do you like to do for<br>fun, <$cdef(27)><pname;0></color>?<clear><br><$voicel(1,9)><$comeff(1,21)><$motion(1,801)><$facial(1,1)>I prefer hide-and-seek myself, yo! I’m real little, so I can<br>always find places to hide!<clear><br><$voicel(1,7)><$comeff(1,10)><$motion(1,803)><$facial(1,4)>But sometimes I’m so hard to spot that I get kinda worried<br>no one ever will find me!
msgctxt "1959:533"
msgid "<$cdef(27)><$voicel(1,7)></color>¿A ti qué juegos te gustan?<clear><br><$voicel(1,9)><$comeff(1,21)><$motion(1,801)><$facial(1,1)>A mí me mola jugar al escondite. Como soy pequeñaj<gen;-3(o,a)>,<br>¡me escondo en cualquier sitio!<clear><br><$voicel(1,7)><$comeff(1,10)><$motion(1,803)><$facial(1,4)>Aunque, a veces, no me encuentra nadie y me rayo...<br>¡Se me da demasiado bien!"
msgstr "<$cdef(27)><$voicel(1,7)></color>¿A ti qué juegos te gustan?<clear><br><$voicel(1,9)><$comeff(1,21)><$motion(1,801)><$facial(1,1)>Me encanta jugar a las escondidas. Como soy chiquit<gen;-3(o,a)>,<br>¡me escondo en cualquier lugar!<clear><br><$voicel(1,7)><$comeff(1,10)><$motion(1,803)><$facial(1,4)>Aunque, a veces, no me encuentra nadie y me frustro...<br>¡Se me da demasiado bien!"

#. en: <$voicel(1,7)><$comeff(1,3)><$motion(1,803)>Whenever you take me places with you, <$voicel(1,8)>it’d be cool if<br>you could turn around to check on me from time to time.<clear><br><$voicel(1,5)><$comeff(1,14)>’Cause, y’know, there’re some smaller holes and stuff that<br>are just big enough for you to squeeze through...<clear><br><$voicel(1,7)><$comeff(1,23)><$motion(1,807)>And I might get stuck in those kinds of places...
msgctxt "1959:534"
msgid "<$voicel(1,7)><$comeff(1,3)><$motion(1,803)>Cuando vayamos a algún sitio tú y yo, <$voicel(1,8)>¿puedes mirar atrás<br>de vez en cuando, por si aca?<clear><br><$voicel(1,5)><$comeff(1,14)>Es que, si te metes por un agujero o un camino estrecho...<br><$voicel(1,7)><$comeff(1,23)><$motion(1,807)>es muy probable que me quede atascad<gen;-3(o,a)>."
msgstr "<$voicel(1,7)><$comeff(1,3)><$motion(1,803)>Cuando vayamos a algún lugar tú y yo, <$voicel(1,8)>¿puedes mirar atrás<br>de vez en cuando, por si acaso?<clear><br><$voicel(1,5)><$comeff(1,14)>Es que, si te metes por un agujero o un camino estrecho...<br><$voicel(1,7)><$comeff(1,23)><$motion(1,807)>es muy probable que me quede atascad<gen;-3(o,a)>."

#. en: <$voicel(1,7)><$comeff(1,9)>I’m happiest when I can live in a place with a lot of<br>water, yo. <$voicel(1,6)><$motion(1,803)>But I know some Pokémon don’t like water...<clear><br><$voicel(1,7)><$comeff(1,14)>So, like, maybe if we set up bridges in places split up by<br>rivers or oceans...<clear><br><$voicel(1,9)><$comeff(1,8)><$motion(1,801)><$facial(1,4)>Then maybe all Pokémon can get around freely and<br>everybody will be happy!
msgctxt "1959:536"
msgid "<$voicel(1,7)><$comeff(1,9)>A mí me encanta vivir en un sitio lleno de agua por todas<br>partes, <$voicel(1,6)><$motion(1,803)>pero creo que hay otros que no son muy fans.<clear><br><$voicel(1,7)><$comeff(1,14)>Por eso, si encuentras alguna zona separada por el mar<br>o un río, enróllate y ponle un puente o algo.<clear><br><$voicel(1,9)><$comeff(1,8)><$motion(1,801)><$facial(1,4)>Fijo que todos se alegrarían un montón de poder ir y<br>venir por ahí a sus anchas."
msgstr "<$voicel(1,7)><$comeff(1,9)>A mí me encanta vivir en un lugar lleno de agua por todas<br>partes, <$voicel(1,6)><$motion(1,803)>pero creo que hay otros que no son muy fans.<clear><br><$voicel(1,7)><$comeff(1,14)>Por eso, si encuentras alguna zona separada por el mar<br>o un río, anímate y ponle un puente o algo.<clear><br><$voicel(1,9)><$comeff(1,8)><$motion(1,801)><$facial(1,4)>Seguro que todos se alegrarían un montón de poder ir y<br>venir por ahí a sus anchas."

#. en: <$voicel(1,5)><$comeff(1,14)><$motion(1,807)>I really like it when it’s all sunny and bright out, y’know?<br><$voicel(1,8)><$comeff(1,8)><$facial(1,4)>But I totally love a good rainstorm too!<clear><br><$voicel(1,9)><$comeff(1,10)><$motion(1,801)><$facial(1,4)>I kinda get the feelin’ I need both to really thrive!
msgctxt "1959:537"
msgid "<$voicel(1,5)><$comeff(1,14)><$motion(1,807)>Los días calentitos donde pega el solazo son una pasada.<clear><br><$voicel(1,8)><$comeff(1,8)><$facial(1,4)>¡Aunque también me gusta cuando llueve con ganas, eh!<clear><br><$voicel(1,9)><$comeff(1,10)><$motion(1,801)><$facial(1,4)>Me da la sensación de que necesito una mezcla de ambas<br>cosas para vivir bien."
msgstr "<$voicel(1,5)><$comeff(1,14)><$motion(1,807)>Los días calentitos donde pega el solazo son increíbles.<clear><br><$voicel(1,8)><$comeff(1,8)><$facial(1,4)>¡Aunque también me gusta cuando llueve con ganas, eh!<clear><br><$voicel(1,9)><$comeff(1,10)><$motion(1,801)><$facial(1,4)>Me da la sensación de que necesito una mezcla de ambas<br>cosas para vivir bien."

#. en: <$voicel(1,5)><$motion(1,807)>Yo, you see the human gadgets around here? They’re all<br>over the place!<clear><br><$voicel(1,7)><$comeff(1,9)><$motion(1,803)><$facial(1,4)>I dunno why, but that makes me feel weirdly at ease.<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,827)><$facial(1,1)>I know some of those things need electricity to run...<clear><br><$voicel(1,9)><$comeff(1,10)><$motion(1,801)><$facial(1,4)>So just gimme a yell if there’s anything I can help out with!
msgctxt "1959:538"
msgid "<$voicel(1,5)><$motion(1,807)>No paro de ver un montón de máquinas fabricadas por<br>los humanos desperdigadas por ahí.<clear><br><$voicel(1,7)><$comeff(1,9)><$motion(1,803)><$facial(1,4)>Aunque suene raro, a mí me calman un montón, la verdad.<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,827)><$facial(1,1)>Para hacerlas funcionar, necesitarás electricidad...<br><wait(0.9)><$voicel(1,9)><$comeff(1,10)><$motion(1,801)><$facial(1,4)>Así que si te puedo echar un cable, me lo dices."
msgstr "<$voicel(1,5)><$motion(1,807)>No paro de ver un montón de máquinas fabricadas por<br>los humanos desperdigadas por ahí.<clear><br><$voicel(1,7)><$comeff(1,9)><$motion(1,803)><$facial(1,4)>Aunque suene raro, a mí me calman un montón, la verdad.<clear><br><$voicel(1,5)><$comeff(1,14)><$motion(1,827)><$facial(1,1)>Para hacerlas funcionar, necesitarás electricidad...<br><wait(0.9)><$voicel(1,9)><$comeff(1,10)><$motion(1,801)><$facial(1,4)>Así que si te puedo echar una mano, me lo dices."

#. en: <$comeff(1,6)><$motion(1,805)><$voicel(1,5)>Yo, do you ever get so busy doin’ something that you<br>forget to eat, <$cdef(27)><pname;0></color>?<clear><br><$comeff(1,14)><$voicel(1,7)>I was concentratin’ real hard on psychic stuff the other day,<br>and my stomach growled SO LOUD...<clear><br><$comeff(1,21)><$facial(1,4)><$motion(1,803)><$voicel(1,6)>It was suuuper embarrassing!
msgctxt "1959:539"
msgid "<$motion(1,805)><$voicel(1,5)>Oye, bestie, <$comeff(1,6)>¿a ti se te olvida comer a veces cuando estás<br>concentrad<gen;-2(o,a)> a full?<clear><br><$comeff(1,14)><$voicel(1,7)>Es que el otro día estaba yo meditando y... del hambre<br>que tenía me empezaron a rugir las tripas que parecía<slide><br>un concierto aquello... Vaya fail.<clear><br><$comeff(1,21)><$facial(1,4)><$motion(1,803)><$voicel(1,6)>¡Me río por no llorar!"
msgstr ""

#. en: <oneline><$voicel(1,7)><$comeff(1,6)>Yo, you’re searching for a human,<br>right, <$cdef(27)><pname;0></color>?<clear><br><$voicel(1,3)><$comeff(1,14)><$motion(1,807)>I haven’t seen any humans myself while wandering<br>around this area...<clear><br><$voicel(1,5)><$comeff(1,3)><$motion(1,801)>But I get a faint feeling human emotions or somethin’<br>are lingerin’ here.
msgctxt "1959:541"
msgid "<$cdef(27)><$voicel(1,7)></color><$comeff(1,6)>Estás buscando a los humanos, ¿verdad?<clear><br><$voicel(1,3)><$comeff(1,14)><$motion(1,807)>Pues he estado vagando por esta zona, pero no he visto<br>ninguno.<clear><br><$voicel(1,5)><$comeff(1,3)><$motion(1,801)>Aunque noto algo, como si sus emociones aún flotaran<br>en el aire..."
msgstr ""

#. en: <$voicel(1,5)><$comeff(1,14)><$motion(1,806)>Yooo, so, like...I have no idea where all the humans<br>are, but...<clear><br><$voicel(1,9)><$comeff(1,10)><$motion(1,801)><$facial(1,4)>I get the feelin’ that if anyone can find ’em, it’ll be you!<br><$voicel(1,8)><$comeff(1,9)><$motion(1,803)><$facial(1,1)>That’s just what my intuition tells me!
msgctxt "1959:542"
msgid "<$voicel(1,5)><$comeff(1,14)><$motion(1,806)>No se me ocurre adónde han podido irse los humanos...<br><$voicel(1,9)><$comeff(1,10)><$motion(1,801)><$facial(1,4)>Pero, conociéndote, seguro que tú los encuentras en na.<clear><br><$voicel(1,8)><$comeff(1,9)><$motion(1,803)><$facial(1,1)>Tengo una corazonada."
msgstr ""

#. en: <$voicel(1,7)><$comeff(1,21)><$motion(1,806)>Yooo, I bet it’d be so fun if I could make a bunch of<br>different tools like you can, <$cdef(27)><pname;0></color>!<clear><br><$voicel(1,5)><$comeff(1,17)><$motion(1,802)>I’m kinda jealous, to be honest. I’m not very good with my<br>hands like that, y’know?
msgctxt "1959:543"
msgid "<$cdef(27)><$voicel(1,7)></color><$comeff(1,21)><$motion(1,806)>Me molaría fabricar mil cosas como tú, parece divertido.<clear><br><$voicel(1,5)><$comeff(1,17)><$motion(1,802)>Yo es que soy bastante torpe para este tipo de cosas...<br>¡Qué envidia me das!"
msgstr "<$cdef(27)><$voicel(1,7)></color><$comeff(1,21)><$motion(1,806)>Me gustaría fabricar mil cosas como tú, parece divertido.<clear><br><$voicel(1,5)><$comeff(1,17)><$motion(1,802)>Yo es que soy bastante torpe para este tipo de cosas...<br>¡Qué envidia me das!"

#. en: <$voicel(1,7)><$comeff(1,3)><$motion(1,806)>Y’know, you’ve got a real interesting air about<br>you, <$cdef(27)><pname;0></color>.<clear><br><$voicel(1,7)><$comeff(1,14)><$motion(1,827)>Like, maybe it’s how you don’t let little things get to you...<br><$voicel(1,6)>Or like how I can never tell what you’re thinkin’, yo.<slide><br><$voicel(1,9)><$comeff(1,4)><$motion(1,807)><$facial(1,13)>Uhhh...I meant all that in a good way!
msgctxt "1959:544"
msgid "<$voicel(1,7)><$comeff(1,3)><$motion(1,806)>Siempre me ha parecido que tienes un aire así como...<br>misterioso, <$cdef(27)><pname;0></color>.<clear><br><$voicel(1,7)><$comeff(1,14)><$motion(1,827)>No sé, es como si no dejaras que ninguna tontería<br>te quitase el sueño...<clear><br><$voicel(1,6)>Nunca sé lo que se te pasa por la cabeza tampoco...<br><$voicel(1,9)><$comeff(1,4)><$motion(1,807)><$facial(1,13)>Bueno, ¡pero no te lo digo a malas, eeeh!"
msgstr "<$voicel(1,7)><$comeff(1,3)><$motion(1,806)>Siempre me ha parecido que tienes un aire así como...<br>misterioso, <$cdef(27)><pname;0></color>.<clear><br><$voicel(1,7)><$comeff(1,14)><$motion(1,827)>No sé, es como si no dejaras que ninguna tontería<br>te quitase el sueño...<clear><br><$voicel(1,6)>Nunca sé lo que se te pasa por la cabeza tampoco...<br><$voicel(1,9)><$comeff(1,4)><$motion(1,807)><$facial(1,13)>Bueno, ¡pero no lo digo con mala intención, eeeh!"

#. en: <$voicel(1,5)><$motion(1,805)><$comeff(1,14)>As time goes by, I feel this area’s changing bit by bit.<br><$voicel(1,7)><$emotion(1,8)>Every time I go for a walk I find somethin’ new. It kinda<slide><br>makes every day a little more fun, y’know?
msgctxt "1959:545"
msgid "<$voicel(1,5)><$motion(1,805)><$comeff(1,14)>O estoy delulu, o esta zona ha cambiado a lo bestia.<clear><br><$voicel(1,7)><$emotion(1,8)>Cada vez que doy una vuelta, descubro cosas nuevas.<br>¡Qué hype!"
msgstr "<$voicel(1,5)><$motion(1,805)><$comeff(1,14)>O estoy delulu, o esta zona cambió un montón.<clear><br><$voicel(1,7)><$emotion(1,8)>Cada vez que doy una vuelta, descubro cosas nuevas.<br>¡Qué hype!"

#. en: <oneline><$comeff(1,1)><$voicel(1,7)>Yo, I was just playin’ with <$cdef(27)><nlpairpk;1></color>. <$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>It was<br>super fun!<clear><br><oneline><$comeff(1,6)><$motion(1,803)><$voicel(1,8)>What’re some of your favorite<br>games, <$cdef(27)><pname;2></color>?
msgctxt "1959:546"
msgid "<oneline><$cdef(27)><$comeff(1,1)></color><$voicel(1,7)>He estado jugando un buen rato con <dart;1()><$cdef(27)><nlpairpk;1></color>.<br><$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Ha sido la caña!<clear><br><$comeff(1,6)><$motion(1,803)><$voicel(1,8)>¿A ti qué juegos te gustan más?"
msgstr "<oneline><$cdef(27)><$comeff(1,1)></color><$voicel(1,7)>Estuve jugando un buen rato con <dart;1()><$cdef(27)><nlpairpk;1></color>.<br><$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Fue lo máximo!<clear><br><$comeff(1,6)><$motion(1,803)><$voicel(1,8)>¿A ti qué juegos te gustan más?"

#. en: <oneline><$comeff(1,10)><$facial(1,4)><$motion(1,803)><$voicel(1,10)>Yo, remember <qty;1(that,those)><br><$cdef(27)><fqty(1)><class><nlqueitem;1></color><slide><br>you<slide><br>gave<slide><br>me, <$cdef(27)><pname;0></color>?<clear><br><$comeff(1,21)><$motion(1,801)><$voicel(1,9)><qty;1(That was,They were)> super good! I totally wouldn’t turn down more!
msgctxt "1959:547"
msgid "<oneline><$cdef(27)><$comeff(1,10)></color><$facial(1,4)><$motion(1,803)><$voicel(1,10)>Oye, ¿te acuerdas<br><esde;1()><$cdef(27)><fqty(1)><nlqueitem;1></color><slide><br>que me diste?...<clear><br><$comeff(1,21)><$motion(1,801)><$voicel(1,9)>¡Estab<qty;1(a,an)> riquísim<genqty;1(o,a,os,as)>! Si te sobr<qty;1(a,an)> más, ya sabes."
msgstr ""

#. en: <oneline><$comeff(1,3)><$motion(1,803)><$voicel(1,7)>I kinda wanna talk more with<br><$cdef(27)><crstlktar;1></color>, y’know?<clear><br><$comeff(1,14)><$motion(1,805)><$voicel(1,5)>It’d be nice if our homes were closer together...
msgctxt "1959:548"
msgid "<oneline><$comeff(1,3)><$motion(1,803)><$voicel(1,7)>Me gustaría estar más de palique con<br><dart;1()><$cdef(27)><crstlktar;1></color>.<clear><br><$comeff(1,14)><$motion(1,805)><$voicel(1,5)>Si tan solo nuestras casas estuvieran más cerca..."
msgstr "<oneline><$comeff(1,3)><$motion(1,803)><$voicel(1,7)>Me gustaría charlar más con<br><dart;1()><$cdef(27)><crstlktar;1></color>.<clear><br><$comeff(1,14)><$motion(1,805)><$voicel(1,5)>Si tan solo nuestras casas estuvieran más cerca..."

#. en: <oneline><$voicel(1,7)><$emotion(1,14)>Yooo, <$cdef(27)><pname;0></color>! Any idea where<br><$voicel(1,6)><$motion(1,805)><$comeff(1,6)><$cdef(27)><crstlktar;1> </color>is?<clear><br><$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,10)>I just really wanna have a chat with them, y’know? Maybe<br>if we lived closer, we could.
msgctxt "1959:549"
msgid "<oneline><$voicel(1,7)><$emotion(1,14)>Oye, tí<gen;-2(o,a)>, ¿no sabrás dónde está<br><dart;1()><$cdef(27)><crstlktar;1></color>?<clear><br><$voicel(1,6)><$motion(1,805)><$comeff(1,6)>¿No te suena? <$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,10)>Es que me gustaría charlar con <gen;1(él,ella)>.<br>Molaría que se mudase a esta zona."
msgstr "<oneline><$voicel(1,7)><$emotion(1,14)>Oye, amig<gen;-2(o,a)>, ¿no sabrás dónde está<br><dart;1()><$cdef(27)><crstlktar;1></color>?<clear><br><$voicel(1,6)><$motion(1,805)><$comeff(1,6)>¿No te suena? <$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,10)>Es que me gustaría charlar con <gen;1(él,ella)>.<br>Estaría genial que se mudara a esta zona."

#. en: <$comeff(1,1)><$voicel(1,9)><$facial(1,4)><$motion(1,801)>And since you got it right, I think you deserve a present!<br>Here ya go, <$cdef(27)><pname;0></color>!
msgctxt "1959:550"
msgid "<$cdef(27)><$comeff(1,1)></color><$voicel(1,9)><$facial(1,4)><$motion(1,801)>¡Aquí está tu premio!"
msgstr ""

#. en: <$voicel(1,6)><$motion(1,805)><$comeff(1,10)>Yooo, I really like this house!<clear><br><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>It’s mad relaxin’ and just perfect for me, y’know? <$voicel(1,8)><$emotion(1,8)>Thanks<br>so much for makin’ it!
msgctxt "1959:551"
msgid "<$voicel(1,6)><$motion(1,805)><$comeff(1,10)>Me da muy buenas vibras mi casa.<clear><br><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>Hay un ambiente superchill. ¡Es literalmente perfecta!<br><$voicel(1,8)><$emotion(1,8)>¡Gracias por construirla!"
msgstr ""

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,8)>Sweet! OK, yo, here’s a question!<clear><br><$comeff(1,14)><$motion(1,827)><$voicel(1,9)>What is <$cdef(27)><qtargetpk;0></color>’s favorite flavor?
msgctxt "1959:552"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,8)>¡Bueno, pues ahí va!<clear><br><$comeff(1,14)><$motion(1,827)><$voicel(1,9)>¿Qué sabor es el preferido <esde;0()><$cdef(27)><qtargetpk;0></color>?"
msgstr ""

#. en: <oneline>That’s...<wait(0.4)><$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>correct! I knew you’d figure it<br>out, <$cdef(27)><pname;0></color>!
msgctxt "1959:554"
msgid "La respuesta es...<wait(0.4)><$comeff(1,13)><$cdef(27)><$facial(1,4)></color><$motion(1,801)><$voicel(1,9)> ¡correcta! Mis dieces."
msgstr "La respuesta es...<wait(0.4)><$comeff(1,13)><$cdef(27)><$facial(1,4)></color><$motion(1,801)><$voicel(1,9)> ¡correcta! Diez de diez."

#. en: That’s...<wait(0.4)><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>not it! Too bad, yo!<clear><br><$voicel(1,9)>The correct answer is <$cdef(27)><ltasteq;0></color>!<clear><br><$comeff(1,13)><$motion(1,803)><$voicel(1,9)>I’ll think up some more questions for you, so I hope you<br>try again sometime!
msgctxt "1959:555"
msgid "La respuesta es... <wait(0.4)><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡incorrecta! ¡Menudo fail!<clear><br><$voicel(1,9)>¡Era el <$cdef(27)><ltasteq;0></color>, que lo sepas!<clear><br><$comeff(1,13)><$motion(1,803)><$voicel(1,9)>Voy a ir pensando otra pregunta. Si te ape, ya sabes."
msgstr "La respuesta es... <wait(0.4)><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡incorrecta! ¡Qué fail!<clear><br><$voicel(1,9)>¡Era el <$cdef(27)><ltasteq;0></color>, que lo sepas!<clear><br><$comeff(1,13)><$motion(1,803)><$voicel(1,9)>Voy a ir pensando otra pregunta. Si quieres, ya sabes."

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,8)>Sweet! OK, here’s a question!<clear><br><$comeff(1,14)><$motion(1,827)><$voicel(1,9)>What is <$cdef(27)><qtargetpk;0></color>’s LEAST favorite flavor?
msgctxt "1959:557"
msgid "<oneline><$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,8)>¡Qué hype! ¡Pues ahí va la pregunta!<clear><br><$comeff(1,14)><$motion(1,827)><$voicel(1,9)>¿Cuál es el sabor que menos le gusta<br><esa;0()><$cdef(27)><qtargetpk;0></color>?"
msgstr ""

#. en: <oneline>That’s...<wait(0.4)><$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>correct! I knew you’d get that one<br>right, <$cdef(27)><pname;0></color>!
msgctxt "1959:559"
msgid "La respuesta es... <wait(0.4)><$cdef(27)><$comeff(1,13)></color><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡correcta! Mucho sabes tú."
msgstr ""

#. en: That’s...<wait(0.4)><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>not it! Too bad, yo!<clear><br><$voicel(1,9)>The correct answer is <$cdef(27)><htasteq;0></color>!<clear><br><$comeff(1,13)><$motion(1,803)><$voicel(1,9)>I’ll think up some more questions for you, so I hope you<br>try again sometime!
msgctxt "1959:560"
msgid "La respuesta es... <wait(0.4)><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡incorrecta! ¡Vaya fail!<clear><br><$voicel(1,9)>¡Era <dart;0()><$cdef(27)><htasteq;0></color>, que lo sepas!<clear><br><$comeff(1,13)><$motion(1,803)><$voicel(1,9)>Voy a ir pensando otra pregunta. Si te ape, ya sabes."
msgstr "La respuesta es... <wait(0.4)><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡incorrecta! ¡Vaya fail!<clear><br><$voicel(1,9)>¡Era <dart;0()><$cdef(27)><htasteq;0></color>, que lo sepas!<clear><br><$comeff(1,13)><$motion(1,803)><$voicel(1,9)>Voy a ir pensando otra pregunta. Si quieres, ya sabes."

#. en: <$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>Yooo! All right, here’s a question!<clear><br><$comeff(1,6)><$motion(1,805)><$facial(1,1)><$voicel(1,7)>What’s <$cdef(27)><qtargetpk;0></color>’s favorite thing?!
msgctxt "1959:562"
msgid "<$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>¡Venga, pues allá va!<clear><br><$comeff(1,6)><$motion(1,805)><$facial(1,1)><$voicel(1,7)>¿Qué es lo que más le gusta <esa;0()><$cdef(27)><qtargetpk;0></color>?"
msgstr "<$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>¡Bueno, pues allá va!<clear><br><$comeff(1,6)><$motion(1,805)><$facial(1,1)><$voicel(1,7)>¿Qué es lo que más le gusta <esa;0()><$cdef(27)><qtargetpk;0></color>?"

#. en: That’s...<wait(0.4)><$comeff(1,20)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>correct! Awesome, <$cdef(27)><pname;0></color>!
msgctxt "1959:564"
msgid "La respuesta es...<wait(0.4)><$comeff(1,20)><$cdef(27)><$facial(1,4)></color><$motion(1,801)><$voicel(1,9)> ¡correcta! Eres la leche, <gen;-2(tío,tía)>."
msgstr "La respuesta es...<wait(0.4)><$comeff(1,20)><$cdef(27)><$facial(1,4)></color><$motion(1,801)><$voicel(1,9)> ¡correcta! Eres lo máximo, <gen;-2(tío,tía)>."

#. en: That’s...<wait(0.4)><$comeff(1,10)><$facial(1,4)><$motionoff(1,804)><$voicel(1,7)>not correct! Too bad!<clear><br><$voicel(1,5)><$motion(1,803)><$comeff(1,3)>The correct answer is <$cdef(27)><likemtag;0></color>!<clear><br><$voicel(1,9)><$emotion(1,8)>I’ll think up some more questions for you, yo. I hope you’ll<br>come try again sometime!
msgctxt "1959:565"
msgid "La respuesta es... <wait(0.4)><$comeff(1,10)><$facial(1,4)><$motionoff(1,804)><$voicel(1,7)>¡incorrecta! ¡Qué fail!<clear><br><$voicel(1,5)><$motion(1,803)><$comeff(1,3)>¡Lo que le encanta <qty;0(es,son)> <dart;0()><$cdef(27)><likemtag;0></color>!<clear><br><$voicel(1,9)><$emotion(1,8)>Voy a ir pensando otra pregunta. Si te ape repetir<br>otro día, ya sabes."
msgstr "La respuesta es... <wait(0.4)><$comeff(1,10)><$facial(1,4)><$motionoff(1,804)><$voicel(1,7)>¡incorrecta! ¡Qué fail!<clear><br><$voicel(1,5)><$motion(1,803)><$comeff(1,3)>¡Lo que le encanta <qty;0(es,son)> <dart;0()><$cdef(27)><likemtag;0></color>!<clear><br><$voicel(1,9)><$emotion(1,8)>Voy a ir pensando otra pregunta. Si quieres<br>repetir otro día, ya sabes."

#. en: <oneline><$comeff(1,1)><$facial(1,4)><$motionoff(1,804)><$voicel(1,9)>Well cool, <$cdef(27)><pname;0></color>! Hope we can play<br>together<slide><br>again<slide><br>sometime, yo!
msgctxt "1959:566"
msgid "<$comeff(1,1)><$facial(1,4)><$motionoff(1,804)><$voicel(1,9)>Bueno, ya repetiremos otro día. ¡Bye, bye!"
msgstr ""

#. en: <oneline><$voicel(1,7)><$motion(1,805)><$comeff(1,6)>Yo, <$cdef(27)><pname;0></color>! You’ve got some<br><$cdef(27)><fqty(2)><class><refmateid;1></color>,<slide><br>right?<clear><br><$voicel(1,5)><$comeff(1,14)>If you give ’em to me, I can turn ’em into<br><$cdef(27)><fqty(2)><class><reftarid;3></color><slide><br><$voicel(1,8)><$motion(1,803)><$comeff(1,10)>for you!
msgctxt "1959:569"
msgid "<oneline><$voicel(1,7)><$motion(1,805)><$comeff(1,6)>¿Te sobr<qty;1(a,an)> alg<genqty;1(ún,una,unos,unas)><br><$cdef(27)><fqty(1)><class><refmateid;1></color>?<clear><br><$voicel(1,5)><$comeff(1,14)>Si me <genqty;1(lo,la,los,las)> das, te <genqty;1(lo,la,los,las)> puedo convertir en<$voicel(1,8)><$motion(1,803)><$comeff(1,10)><br><$cdef(27)><fqty(2)><class><reftarid;3></color>."
msgstr ""

#. en: <oneline><$voicel(1,3)><$motion(1,807)><$comeff(1,4)>Yooo, sorry... I can’t do anything with<br><$cdef(27)><fqty(2)><class><referrmate;0></color>.<clear><br><$voicel(1,5)><$motion(1,803)><$comeff(1,10)>I bet <$cdef(27)><referrpk;2> </color>can, though! Maybe check<br>with them?
msgctxt "1959:570"
msgid "<oneline><$voicel(1,3)><$motion(1,807)><$comeff(1,4)>Lo siento, tí<gen;-2(o,a)>, pero yo no puedo ayudarte con<br><dart;0()><$cdef(27)><fqty(1)><class><referrmate;0></color>.<slide><br><$voicel(1,5)><$motion(1,803)><$comeff(1,10)>¡Pregúntale <esa;2()><$cdef(27)><referrpk;2></color>,<slide><br>que tal vez<slide><br>pueda hacer algo!"
msgstr "<oneline><$voicel(1,3)><$motion(1,807)><$comeff(1,4)>Lo siento, amig<gen;-2(o,a)>, pero yo no puedo ayudarte con<br><dart;0()><$cdef(27)><fqty(1)><class><referrmate;0></color>.<slide><br><$voicel(1,5)><$motion(1,803)><$comeff(1,10)>¡Pregúntale <esa;2()><$cdef(27)><referrpk;2></color>,<slide><br>que tal vez<slide><br>pueda hacer algo!"

#. en: <oneline><$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>Yooo, sorry... I can’t do anything with<br><$cdef(27)><fqty(2)><class><referrmate;0></color>.<clear><br><$voicel(1,1)><$motion(1,805)><$comeff(1,7)>I dunno if I know anyone who can either...
msgctxt "1959:571"
msgid "<oneline><$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>Pues... No tengo ni idea de qué hacer con<br><dart;0()><$cdef(27)><fqty(2)><class><referrmate;0></color><slide><br><genqty;0(este,esta,estos,estas)>.<clear><br><$voicel(1,1)><$motion(1,805)><$comeff(1,7)>Tampoco se me ocurre quién podría echarte una mano..."
msgstr ""

#. en: <oneline><$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>Sorry, yo! I don’t know much about<br><$voicel(1,2)><$comeff(1,7)><$cdef(27)><fqty(2)><class><referrmate;0></color>.<clear><br><$voicel(1,5)><$emotion(1,14)><$facial(1,1)>Oh! You got any<br><$cdef(27)><fqty(2)><class><refmateid;2></color>,<slide><br>though?<slide><br><$voicel(1,6)><$comeff(1,14)>I<slide><br>can<slide><br>turn<slide><br>those<slide><br>into<slide><br><$cdef(27)><fqty(2)><class><reftarid;3></color>!<clear><br><$voicel(1,8)><$motion(1,805)><$comeff(1,6)>What do ya say?!
msgctxt "1959:572"
msgid "<oneline><$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>¡Lo siento, no te puedo ayudar con <qty;0(tu,tus)><br><$cdef(27)><fqty(1)><referrmate;0></color>!<slide><br><wait(0.4)><$voicel(1,2)><$comeff(1,7)>Menudo fail...<clear><br><$voicel(1,5)><$emotion(1,14)><$facial(1,1)>Ah, pero veo que llevas alg<genqty;2(ún,una,unos,unas)><br><$cdef(27)><fqty(1)><class><refmateid;2></color><slide><br>encima.<clear><br><$voicel(1,6)><$comeff(1,14)>Si quieres te <gen;2(los,las)> convierto en<br><$cdef(27)><fqty(2)><class><reftarid;3></color>...<slide><br><$voicel(1,8)><$motion(1,805)><$comeff(1,6)>¿Qué me dices?"
msgstr "<oneline><$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>¡Lo siento, no te puedo ayudar con <qty;0(tu,tus)><br><$cdef(27)><fqty(1)><referrmate;0></color>!<slide><br><wait(0.4)><$voicel(1,2)><$comeff(1,7)>Qué fail...<clear><br><$voicel(1,5)><$emotion(1,14)><$facial(1,1)>Ah, pero veo que llevas alg<genqty;2(ún,una,unos,unas)><br><$cdef(27)><fqty(1)><class><refmateid;2></color><slide><br>encima.<clear><br><$voicel(1,6)><$comeff(1,14)>Si quieres te <gen;2(los,las)> convierto en<br><$cdef(27)><fqty(2)><class><reftarid;3></color>...<slide><br><$voicel(1,8)><$motion(1,805)><$comeff(1,6)>¿Qué me dices?"

#. en: <oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,6)>You need<br><$cdef(27)><fqty(2)><class><reftarid;0></color>?<clear><br><$voicel(1,7)><$emotion(1,14)>In that case, just put<br><$cdef(27)><fqty(2)><class><refmateid;2></color><slide><br><$voicel(1,6)><$comeff(1,10)>in<slide><br>the<slide><br><$cdef(27)><fqty(1)><reftable;1></color>, yo!<clear><br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>I’ll process ’em for you later!
msgctxt "1959:573"
msgid "<oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,6)>¿Necesitas<br><$cdef(27)><fqty(2)><class><reftarid;0></color>?<clear><br><$voicel(1,7)><$emotion(1,14)>Entonces deja<br><dart;2()><$cdef(27)><fqty(1)><class><refmateid;2><slide><br></color>en<slide><br><dart;1()><fqty(1)><class><$cdef(27)><reftable;1></color>...<slide><br><$voicel(1,6)><$comeff(1,10)>¡y listo!<clear><br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>¡Del resto me encargo yo!"
msgstr ""

#. en: <oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,14)>I can’t make<br><$cdef(27)><fqty(2)><class><reftarid;0></color><slide><br>without<slide><br><$voicel(1,4)><$emotion(1,14)><iart;1()><$cdef(27)><fqty(1)><reftable;1></color>, yo!<clear><br><$voicel(1,7)><$motion(1,803)><$comeff(1,10)>Set me up <iart;2()><$cdef(27)><fqty(1)><reftable;2><br></color>someplace<slide><br>first.<slide><br>Then<slide><br>I’d<slide><br>totally<slide><br>be<slide><br>happy<slide><br>to help!
msgctxt "1959:574"
msgid "<$cdef(27)><oneline></color><$voicel(1,5)><$motion(1,805)><$comeff(1,14)>Hmm... Para hacer<br><$cdef(27)><fqty(2)><class><reftarid;0></color>,<slide><br>necesito<slide><br><$voicel(1,4)><$emotion(1,14)><iart;1()><$cdef(27)><fqty(1)><class><reftable;1></color>.<clear><br><$voicel(1,7)><$motion(1,803)><$comeff(1,10)>¡Cuando est<genqty;0(é listo,é lista,én listos,én listas)>, avisa!"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,39)>Check this out, yo... I think I made somethin’ kinda<br>awesome too! <$voicel(1,6)><$motion(1,803)><$comeff(1,10)>Here ya go!
msgctxt "1959:575"
msgid "<$voicel(1,7)><$emotion(1,39)>¡Ah, y mira esto! De regalo te llevas algo aún más top<br>que de costumbre. <wait(0.5)><$voicel(1,6)><$motion(1,803)><$comeff(1,10)>¡Toma!"
msgstr ""

#. en: <$comeff(1,3)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Yooo, I found this on the way here! <$comeff(1,10)><$motion(1,801)><$voicel(1,10)>You can have it if you<br>want, <$cdef(27)><pname;0></color>!
msgctxt "1959:576"
msgid "<$cdef(27)><$comeff(1,3)></color><$facial(1,4)><$motion(1,803)><$voicel(1,7)>¡Ah, se me olvidaba! He encontrado esto por ahí.<clear><br><$comeff(1,10)><$motion(1,801)><$voicel(1,10)>Toma, pa ti."
msgstr "<$cdef(27)><$comeff(1,3)></color><$facial(1,4)><$motion(1,803)><$voicel(1,7)>¡Ah, se me olvidaba! Encontré esto por ahí.<clear><br><$comeff(1,10)><$motion(1,801)><$voicel(1,10)>Toma, pa ti."

#. en: <$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Yooo! Sorry for the wait, <$cdef(27)><pname;0></color>!<clear><br><oneline><$comeff(1,13)><$motion(1,801)><$voicel(1,9)>The <$cdef(27)><cdirbname;1> </color>is done!<br>Go<slide><br>take<slide><br>a<slide><br>look, yo!
msgctxt "1959:585"
msgid "<oneline><$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>¡<$cdef(27)><pname;0></color>!<clear><br><$comeff(1,13)><$motion(1,801)><$voicel(1,9)>¡Mira qué guapada,<br><dart;1()><$cdef(27)><cdirbname;1></color><slide><br>est<qty;1(á,án)> terminad<genqty;1(o,a,os,as)>!"
msgstr "<oneline><$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>¡<$cdef(27)><pname;0></color>!<clear><br><$comeff(1,13)><$motion(1,801)><$voicel(1,9)>¡Mira qué maravilla,<br><dart;1()><$cdef(27)><cdirbname;1></color><slide><br>est<qty;1(á,án)> terminad<genqty;1(o,a,os,as)>!"

#. en: <$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Time to show off my handiwork! Ta-daaa!
msgctxt "1959:586"
msgid "<$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¿List<gen;-2(o,a)>? ¡Tacháaan!"
msgstr ""

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Yooo, I think I did a pretty good job!<clear><br><$comeff(1,13)><$motion(1,824)><$voicel(1,7)>I’ll definitely wanna help out anytime you <$cdef(27)><$spwfull(1)></color> stuff!
msgctxt "1959:587"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Hemos hecho lo que hemos podido, pero creo que nos<br>ha quedado bastante bien.<clear><br><$comeff(1,13)><$motion(1,824)><$voicel(1,7)>¡Si necesitas <$cdef(27)><$spwfull(1)> </color>algo más, yo encantad<gen;-3(o,a)><br>de ayudar!"
msgstr "<$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Hicimos lo que pudimos, pero creo que nos<br>quedó bastante bien.<clear><br><$comeff(1,13)><$motion(1,824)><$voicel(1,7)>¡Si necesitas <$cdef(27)><$spwfull(1)> </color>algo más, yo encantad<gen;-3(o,a)><br>de ayudar!"

#. en: <oneline><$voicel(1,5)><$emotion(1,14)>Hey, <$cdef(27)><pname;0></color>! Yo, I know this is kinda<br>random,<slide><br><$voicel(1,8)><$motion(1,805)><$comeff(1,6)><$facial(1,4)>but<slide><br>do<slide><br>you<slide><br>wanna<slide><br>play<slide><br>a<slide><br>game<slide><br>of<slide><br>“look<slide><br>that way”?!
msgctxt "1959:593"
msgid "<oneline><$voicel(1,5)><$emotion(1,14)>¡Oye, <$cdef(27)><pname;0></color>! <$voicel(1,8)><$motion(1,805)><$comeff(1,6)><$facial(1,4)>¿Quieres jugar conmigo<br>a \"esquiva la baya\"?"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,8)>Yayyy! OK, let’s do it!
msgctxt "1959:594"
msgid "<$voicel(1,7)><$emotion(1,8)>¡Yasss! ¡Venga, va!"
msgstr "<$voicel(1,7)><$emotion(1,8)>¡Yasss! ¡Vamos!"

#. en: <$voicel(1,5)><$emotion(1,14)>OK! Maybe some other time, yo!
msgctxt "1959:595"
msgid "<$voicel(1,5)><$emotion(1,14)>¡Vale, pero otro rato sí jugamos!"
msgstr "<$voicel(1,5)><$emotion(1,14)>¡Bueno, pero otro rato sí jugamos!"

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Yooo! You win! You’re pretty good at this, huh?!<clear><br><$voicel(1,9)><$emotion(1,8)>Thanks for playin’ with me! I won’t lose next time, yo!
msgctxt "1959:596"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¡Me has ganado! ¡Si es que estás chetadísim<gen;-2(o,a)>! <$voicel(1,9)><$emotion(1,8)>Me lo<br>he pasado de diez, ¡pero a la próxima gano yo fijo!"
msgstr "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¡Me ganaste! ¡Si es que estás chetadísim<gen;-2(o,a)>! <$voicel(1,9)><$emotion(1,8)>Me la<br>pasé genial, ¡pero a la próxima gano yo seguro!"

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Too bad! You lose! It was fun, though, right?<clear><br><$voicel(1,9)><$emotion(1,8)>Thanks for playin’ with me! I’m never gonna lose this<br>game, yo!
msgctxt "1959:597"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¡Te he ganado! ¡Viva yooo! <$voicel(1,9)><$emotion(1,8)>Me lo he pasado superbién.<br>¡Cuando quieras, te gano otra vez!"
msgstr "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¡Te gané! ¡Viva yooo! <$voicel(1,9)><$emotion(1,8)>Me la pasé superbién.<br>¡Cuando quieras, te gano otra vez!"

#. en: <oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,6)>Yooo, <$cdef(27)><pname;0></color>! Wanna play a game of<br>hide-and-sneak?!<clear><br><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>You can do the hidin’ and the sneakin’, and I’ll be the one<br>that runs around lookin’ for you!
msgctxt "1959:610"
msgid "<oneline><$voicel(1,5)><$motion(1,805)>¡Oyeee! Vamos a jugar un rato al escondite camuflado.<br><$comeff(1,6)>¿Te apuntas, <$cdef(27)><pname;0></color>?<clear><br><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¡Tú te escondes y yo te busco!"
msgstr "<oneline><$voicel(1,5)><$motion(1,805)>¡Oyeee! Vamos a jugar un rato al escondite camuflado.<br><$comeff(1,6)>¿Te animas, <$cdef(27)><pname;0></color>?<clear><br><$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¡Tú te escondes y yo te busco!"

#. en: <$voicel(1,7)><$emotion(1,8)>Heck yeah! OK, I’ll get ready!
msgctxt "1959:611"
msgid "<$voicel(1,7)><$emotion(1,8)>¡Yasss! Voy a prepararme."
msgstr ""

#. en: <$voicel(1,5)><$emotion(1,14)>OK! Maybe some other time, yo!
msgctxt "1959:612"
msgid "<$voicel(1,5)><$emotion(1,14)>¡Ok, pues otro día jugamos!"
msgstr ""

#. en: <$voicel(1,4)><$motion(1,807)><$comeff(1,4)><$facial(1,9)>Yooo! No way! I lost?!
msgctxt "1959:617"
msgid "<$voicel(1,4)><$motion(1,807)><$comeff(1,4)><$facial(1,9)>¡Menud<gen;-3(o,a)> noob estoy hech<gen;-3(o,a)>! ¡Me he tilteado y todo!"
msgstr "<$voicel(1,4)><$motion(1,807)><$comeff(1,4)><$facial(1,9)>¡Tremend<gen;-3(o,a)> noob estoy hech<gen;-3(o,a)>! ¡Me tilteé y todo!"

#. en: <oneline><$voicel(1,9)><$emotion(1,39)>You’re a hidin’ and sneakin’ MASTER,<br><$cdef(27)><pname;0></color>!<clear><br><$voicel(1,8)><$motion(1,803)><$comeff(1,10)>Here’s a prize for bein’ so awesome, yo!
msgctxt "1959:618"
msgid "<$cdef(27)><$voicel(1,9)></color><$emotion(1,39)>¡Eres tod<gen;-2(o,a)> u<gen;-2(n,na)> pro del escondite! <$voicel(1,8)><$motion(1,803)><$cdef(27)><$comeff(1,10)></color>¡Toma, tu premio!"
msgstr ""

#. en: <$voicel(1,7)><$emotion(1,8)>Thanks for playin’ with me! I’m totally gonna find you<br>next time!
msgctxt "1959:619"
msgid "<$voicel(1,7)><$emotion(1,8)>Gracias por jugar. ¡La siguiente seguro que te encuentro!"
msgstr ""

#. en: <$voicel(1,8)><$motion(1,805)><$facial(1,4)><$comeff(1,6)>Yo, did I surprise you?<clear><br><$voicel(1,5)><$motion(1,803)><$comeff(1,10)>I’m gonna call you <$cdef(27)><pname;2></color> from now on!<clear><br><$voicel(1,7)><$motion(1,806)><$comeff(1,9)>It just doesn’t feel right to call you <$cdef(27)>Ditto </color>now that we’re<br>such good friends! <$voicel(1,10)><$emotion(1,39)>Here’s to a lasting and awesome<slide><br>friendship, <$cdef(27)><pname;3></color>!
msgctxt "1959:620"
msgid "<$cdef(27)><oneline></color><$voicel(1,8)><$motion(1,805)><$facial(1,4)><$comeff(1,6)>Qué, ¿te ha sorprendido que me sepa tu lore?<clear><br><$voicel(1,5)><$motion(1,803)><$comeff(1,10)>¡Me parecía de ma<gen;-3(l,la)> amig<gen;-3(o,a)> seguir llamándote <$cdef(27)>Ditto</color> y ya!<br><$voicel(1,7)><$motion(1,806)><$comeff(1,9)>¡Que por algo eres mi bestie!<clear><br><$voicel(1,10)><$emotion(1,39)>¡Nos vemos, <$cdef(27)><pname;3></color>!"
msgstr "<$cdef(27)><oneline></color><$voicel(1,8)><$motion(1,805)><$facial(1,4)><$comeff(1,6)>Qué, ¿te sorprendió que me sepa tu lore?<clear><br><$voicel(1,5)><$motion(1,803)><$comeff(1,10)>¡Me parecía de ma<gen;-3(l,la)> amig<gen;-3(o,a)> seguir llamándote <$cdef(27)>Ditto</color> y ya!<br><$voicel(1,7)><$motion(1,806)><$comeff(1,9)>¡Que por algo eres mi bestie!<clear><br><$voicel(1,10)><$emotion(1,39)>¡Nos vemos, <$cdef(27)><pname;3></color>!"

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>Today was so much fun, yo! Thanks for playin’ with me!
msgctxt "1959:622"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>¡Me lo he pasado bomba!"
msgstr "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>¡Me la pasé bomba!"

#. en: <$emotion(1,8)><$voicel(1,9)>Sweet! OK, I’ll go get ready!
msgctxt "1959:623"
msgid "<$emotion(1,8)><$voicel(1,9)>¡Tomaaa! ¡Voy a prepararme!"
msgstr "<$emotion(1,8)><$voicel(1,9)>¡Bieeen! ¡Voy a prepararme!"

#. en: <$emotion(1,37)><$voicel(1,7)>OK! Hope we can play some other time, yo!
msgctxt "1959:624"
msgid "<$emotion(1,37)><$voicel(1,7)>¡Vale! ¡Otro día entonces!"
msgstr "<$emotion(1,37)><$voicel(1,7)>¡Bueno! ¡Otro día entonces!"

#. en: <oneline><$comeff(1,5)><$facial(1,9)><$motion(1,803)><$voicel(1,7)><$cdef(27)><pname;0></color>! Yooo, looks like the<br><$cdef(27)><fqty(1)><$ifull(1325)></color><slide><br>stopped<slide><br>workin’!<slide><br><$comeff(1,6)><$motion(1,827)><$voicel(1,3)>Maybe<slide><br>it’s<slide><br>not<slide><br>gettin’<slide><br>any<slide><br>electricity<slide><br>or somethin’?<clear><br><$comeff(1,18)><$motion(1,802)><$voicel(1,1)>I can’t do any <$cdef(27)><$spwfull(12)>s</color> with the <$cdef(27)><fqty(1)><$ifull(1325)> </color>out of<br>commission, yo...
msgctxt "1959:667"
msgid "<oneline><$comeff(1,5)><$facial(1,9)><$motion(1,803)><$voicel(1,7)>¡Ey, <$cdef(27)><pname;0></color>! ¡Parece que<br>la <$cdef(27)><fqty(1)><$ifull(1325)></color><slide><br>no funciona!<clear><br><$comeff(1,6)><$motion(1,827)><$voicel(1,3)>¿Igual se ha ido la luz?<clear><br><$comeff(1,18)><$motion(1,802)><$voicel(1,1)>Sin la <$cdef(27)><fqty(1)><$ifull(1325)></color> no podemos <$cdef(27)><$spwfull(12)></color>...<br>¡Menudo fail!"
msgstr "<oneline><$comeff(1,5)><$facial(1,9)><$motion(1,803)><$voicel(1,7)>¡Ey, <$cdef(27)><pname;0></color>! ¡Parece que<br>la <$cdef(27)><fqty(1)><$ifull(1325)></color><slide><br>no funciona!<clear><br><$comeff(1,6)><$motion(1,827)><$voicel(1,3)>¿Tal vez se fue la luz?<clear><br><$comeff(1,18)><$motion(1,802)><$voicel(1,1)>Sin la <$cdef(27)><fqty(1)><$ifull(1325)></color> no podemos <$cdef(27)><$spwfull(12)></color>...<br>¡Qué fail!"

#. en: <oneline><$voicel(1,7)><$emotion(1,14)>Yo, I’m partially done with those<br><$cdef(27)><fqty(2)><class><reftarid;0></color><slide><br>you<slide><br>asked<slide><br>me<slide><br>to<slide><br>work on!<clear><br><$voicel(1,6)><$motion(1,807)><$comeff(1,10)>I need just a little more time for the rest!
msgctxt "1959:670"
msgid "<oneline><$voicel(1,7)><$emotion(1,14)>Tienes prisa, ¿eh? Anda, toma <genqty;0(un,una,algunos,algunas)><br><$cdef(27)><class><reftarid;0></color>.<slide><br><$voicel(1,6)><$motion(1,807)><$comeff(1,10)>¡Cuando termine el resto hablamos!"
msgstr "<oneline><$voicel(1,7)><$emotion(1,14)>Tienes prisa, ¿eh? Bueno, toma <genqty;0(un,una,algunos,algunas)><br><$cdef(27)><class><reftarid;0></color>.<slide><br><$voicel(1,6)><$motion(1,807)><$comeff(1,10)>¡Cuando termine el resto hablamos!"

#. en: <oneline><$emotion(1,38)><$voicel(1,9)>Oh, yeah! I know where <$cdef(27)><pksrchtar;0></color> is!<br>Want<slide><br>me<slide><br>to<slide><br>take<slide><br>you there?<clear><br><$emotion(1,29)><$voicel(1,7)>We can get there super fast if we fly!
msgctxt "1959:680"
msgid "<$cdef(27)><$emotion(1,38)></color><$voicel(1,9)>Ah, pues quizá sepa dónde está. ¿Quieres que te lleve?<br><$emotion(1,29)><$voicel(1,7)>¡Volando llegamos en cero coma!"
msgstr "<$cdef(27)><$emotion(1,38)></color><$voicel(1,9)>Ah, pues quizás sepa dónde está. ¿Quieres que te lleve?<br><$emotion(1,29)><$voicel(1,7)>¡Volando llegamos en un segundo!"

#. en: <oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,6)>Oh, I think <$cdef(27)><pksrchtar;0></color>’s at home right<br>now, yo!<clear><br>Want me to take you there? <$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>We can get there super fast if<br>we fly!
msgctxt "1959:681"
msgid "<$voicel(1,5)><$motion(1,805)>¡Creo que está en su casa! <$comeff(1,6)>¿Quieres que te lleve volando?<br><$cdef(27)><$voicel(1,8)></color><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¡Iremos a toda mecha!"
msgstr "<$voicel(1,5)><$motion(1,805)>¡Creo que está en su casa! <$comeff(1,6)>¿Quieres que te lleve volando?<br><$cdef(27)><$voicel(1,8)></color><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¡Iremos a toda velocidad!"

#. en: <$voicel(1,5)><$motion(1,805)><$comeff(1,6)>Hm... I haven’t seen <$cdef(27)><pksrchtar;0></color> today...<clear><br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>But I can take you to their home! We can get there super<br>fast if we fly!
msgctxt "1959:682"
msgid "<oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,6)>Hoy no me he cruzado con<br><dart;0()><$cdef(27)><pksrchtar;0></color>,<slide><br>que yo sepa...<clear><br>Si quieres te llevo a su casa, a ver si hay suerte y está.<br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¡Volando llegamos en cero coma!"
msgstr "<oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,6)>Hoy no me crucé con<br><dart;0()><$cdef(27)><pksrchtar;0></color>,<slide><br>que yo sepa...<clear><br>Si quieres te llevo a su casa, a ver si hay suerte y está.<br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¡Volando llegamos en un segundo!"

#. en: <oneline><$voicel(1,3)><$motion(1,805)><$comeff(1,14)>Hm... I haven’t seen <$cdef(27)><pksrchtar;0><br></color>around here...<clear><br><$voicel(1,6)><$motion(1,803)><$comeff(1,6)>They might live, like, REALLY far away from here.
msgctxt "1959:683"
msgid "<$cdef(27)><$voicel(1,3)></color><$motion(1,805)><$comeff(1,14)>Pues por aquí no está, eso fijísimo. <$comeff(1,6)><$voicel(1,6)><$motion(1,803)>¿Será que vive lejos<br>de esta zona?"
msgstr "<$cdef(27)><$voicel(1,3)></color><$motion(1,805)><$comeff(1,14)>Pues por aquí no está, eso segurísimo. <$comeff(1,6)><$voicel(1,6)><$motion(1,803)>¿Será que vive lejos<br>de esta zona?"

#. en: <$voicel(1,7)><$motionoff(1,804)><$facial(1,4)><$comeff(1,9)>Leave it to me, yo! I’ll make sure you get there!
msgctxt "1959:684"
msgid "<$voicel(1,7)><$motionoff(1,804)><$facial(1,4)><$comeff(1,9)>¡Di que sí! ¡Pues ahora mismo te llevo! ¡Despeguemos!"
msgstr "<$voicel(1,7)><$motionoff(1,804)><$facial(1,4)><$comeff(1,9)>¡Así se habla! ¡Pues ahora mismo te llevo! ¡Despeguemos!"

#. en: <$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,10)>We made it, yo! Feel free to call on me anytime!
msgctxt "1959:685"
msgid "<$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,10)>¡Ya hemos llegado! ¡Si necesitas que te lleve a algún<br>otro sitio, me avisas!"
msgstr "<$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,10)>¡Ya llegamos! ¡Si necesitas que te lleve a algún<br>otro lugar, me avisas!"

#. en: <oneline><$voicel(1,3)><$motion(1,805)><$comeff(1,14)>We made it! But, uh...I guess <$cdef(27)><pksrchtar;0></color><br>isn’t<slide><br>here, yo...
msgctxt "1959:686"
msgid "<oneline><$voicel(1,3)><$motion(1,805)><$comeff(1,14)>Pues era aquí, pero <dart;0()><$cdef(27)><pksrchtar;0></color><br>ni está<slide><br>ni se l<gen;0(o,a)> espera..."
msgstr ""

#. en: <$voicel(1,5)><$emotion(1,14)>OK, yo! Just lemme know if you change your mind!
msgctxt "1959:687"
msgid "<$voicel(1,5)><$emotion(1,14)>¡Ok! ¡Si cambias de opinión, aquí estaré!"
msgstr ""

#. en: <oneline><$emotion(1,38)><$voicel(1,7)>Oh, yeah! I know where <$cdef(27)><pksrchtar;0> </color>is!<clear><br><$emotion(1,29)><$voicel(1,10)>Want me to <$cdef(27)><$spwfull(35)> </color>you over there?
msgctxt "1959:688"
msgid "<$cdef(27)><$emotion(1,38)></color><$voicel(1,7)>¡Igual sé dónde está! <$emotion(1,29)><$voicel(1,10)>¿Quieres que te <$cdef(27)>teletransporte<nbs2><$spwicon(35)><br></color>hasta allí?"
msgstr "<$cdef(27)><$emotion(1,38)></color><$voicel(1,7)>¡Tal vez sé dónde está! <$emotion(1,29)><$voicel(1,10)>¿Quieres que te <$cdef(27)>teletransporte<nbs2><$spwicon(35)><br></color>hasta allá?"

#. en: <oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,6)>Oh, I think <$cdef(27)><pksrchtar;0></color>’s at home right<br>now, yo.<clear><br>Want me to <$cdef(27)><$spwfull(35)></color><$cdef(27)> </color>you over there?
msgctxt "1959:689"
msgid "<$cdef(27)><$voicel(1,5)></color><$motion(1,805)>¡Creo que está en su casa! <$comeff(1,6)>¿Te <$cdef(27)>teletransporto<nbs2><$spwicon(35)></color> allí?<br>Tardamos cero coma."
msgstr "<$cdef(27)><$voicel(1,5)></color><$motion(1,805)>¡Creo que está en su casa! <$comeff(1,6)>¿Te <$cdef(27)>teletransporto<nbs2><$spwicon(35)></color> allá?<br>Llegamos en un segundo."

#. en: <$voicel(1,3)><$motion(1,803)><$comeff(1,14)>Hm... I haven’t seen <$cdef(27)><pksrchtar;0></color> today...<clear><br><$voicel(1,5)><$motion(1,805)><$comeff(1,6)>But we could try <$cdef(27)><$spwfull(35)>ing </color>over to their home<br>together if you want!
msgctxt "1959:690"
msgid "<$voicel(1,3)><$motion(1,803)><$comeff(1,14)>Pues hoy debe de haberse vuelto invisible, porque ni idea<br>de dónde anda...<clear><br><$cdef(27)><$voicel(1,5)></color><$motion(1,805)><$comeff(1,6)>¿Te <$cdef(27)>teletransporto<nbs2><$spwicon(35)></color> a su casa a ver?"
msgstr ""

#. en: <oneline><$voicel(1,3)><$motion(1,805)><$comeff(1,14)>Hm... I haven’t seen <$cdef(27)><pksrchtar;0><br></color>around here...<clear><br><$voicel(1,6)><$motion(1,803)><$comeff(1,6)>They might live, like, REALLY far away from here.
msgctxt "1959:691"
msgid "<oneline><$voicel(1,3)><$motion(1,805)><$comeff(1,14)>¿<fcap><dart;0()><$cdef(27)><pksrchtar;0></color>? Por aquí no está,<br>eso fijo.<slide><br><$voicel(1,6)><$motion(1,803)><$comeff(1,6)>¿Será que vive lejos de esta zona?"
msgstr "<oneline><$voicel(1,3)><$motion(1,805)><$comeff(1,14)>¿<fcap><dart;0()><$cdef(27)><pksrchtar;0></color>? Por aquí no está,<br>eso seguro.<slide><br><$voicel(1,6)><$motion(1,803)><$comeff(1,6)>¿Será que vive lejos de esta zona?"

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>OK! You’ll get there in NO TIME with my help, yo!
msgctxt "1959:692"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¡Ok! ¡En un segundo estamos ahí!"
msgstr ""

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>We made it, yo! Feel free to call on me anytime!
msgctxt "1959:693"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>¡Ya hemos llegado! Si necesitas que te lleve a algún<br>otro sitio, me avisas."
msgstr "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>¡Ya llegamos! Si necesitas que te lleve a algún<br>otro lugar, me avisas."

#. en: <oneline><$voicel(1,3)><$motion(1,805)><$comeff(1,14)>We made it! But, uh...I guess <$cdef(27)><pksrchtar;0></color><br>isn’t<slide><br>here, yo...
msgctxt "1959:694"
msgid "<oneline><$voicel(1,3)><$motion(1,805)><$comeff(1,14)>Ya hemos llegado, pero <dart;0()><$cdef(27)><pksrchtar;0></color><br>ni está<slide><br>ni se l<gen;0(o,a)> espera..."
msgstr "<oneline><$voicel(1,3)><$motion(1,805)><$comeff(1,14)>Ya llegamos, pero <dart;0()><$cdef(27)><pksrchtar;0></color><br>ni está<slide><br>ni se l<gen;0(o,a)> espera..."

#. en: <$voicel(1,5)><$motion(1,803)><$comeff(1,3)>OK! Just lemme know if you change your mind!
msgctxt "1959:695"
msgid "<$voicel(1,5)><$motion(1,803)><$comeff(1,3)>¡Ok! Si cambias de opinión, aquí estaré."
msgstr ""

#. en: <oneline><$comeff(1,3)><$motion(1,803)><$voicel(1,7)>Oh, yeah! I think <$cdef(27)><pksrchtar;0></color>’s over<br>that<slide><br>way, yo!
msgctxt "1959:696"
msgid "<$cdef(27)><$comeff(1,3)></color><$motion(1,803)><$voicel(1,7)>¡Sí, está por allí! ¡Casi seguro!"
msgstr "<$cdef(27)><$comeff(1,3)></color><$motion(1,803)><$voicel(1,7)>¡Sí, está por allá! ¡Casi seguro!"

#. en: <oneline><$comeff(1,3)><$motion(1,803)><$voicel(1,7)>Oh, I think <$cdef(27)><pksrchtar;0></color>’s at home right<br>now, yo!
msgctxt "1959:697"
msgid "<$cdef(27)><$comeff(1,3)></color><$motion(1,803)><$voicel(1,7)>¡Pues creeeo que está en su casa!"
msgstr ""

#. en: <oneline><$comeff(1,3)><$motion(1,805)><$voicel(1,5)><$cdef(27)><pksrchtar;0></color>? I don’t think I’ve seen<br>’em today...
msgctxt "1959:698"
msgid "<$comeff(1,3)><$motion(1,805)><$voicel(1,5)>¿<fcap><dart;0()><$cdef(27)><pksrchtar;0></color>? Hoy no l<gen;0(o,a)> he visto."
msgstr "<$comeff(1,3)><$motion(1,805)><$voicel(1,5)>¿<fcap><dart;0()><$cdef(27)><pksrchtar;0></color>? Hoy no l<gen;0(o,a)> vi."

#. en: <oneline><$voicel(1,3)><$motion(1,805)><$comeff(1,14)>Hm... I haven’t seen <$cdef(27)><pksrchtar;0><br></color>around here...<clear><br><$voicel(1,6)><$motion(1,803)><$comeff(1,6)>They might live, like, REALLY far away from here.
msgctxt "1959:699"
msgid "<$cdef(27)><$voicel(1,3)></color><$motion(1,805)><$comeff(1,14)>¿Hmm? Pues por aquí no ha pasado, eso segurísimo.<br><$voicel(1,6)><$motion(1,803)><$comeff(1,6)>¿No será que no vive por esta zona?"
msgstr "<$cdef(27)><$voicel(1,3)></color><$motion(1,805)><$comeff(1,14)>¿Hmm? Pues por aquí no pasó, eso segurísimo.<br><$voicel(1,6)><$motion(1,803)><$comeff(1,6)>¿No será que no vive por esta zona?"

#. en: <oneline><$voicel(1,5)><$motion(1,805)><$comeff(1,6)>Hm? Yo, are you lookin’ for someone,<br><$cdef(27)><pname;0></color>?
msgctxt "1959:700"
msgid "<oneline><$voicel(1,5)><$motion(1,805)>¡Holiwis, <$cdef(27)><pname;0></color>! <$comeff(1,6)>¿Estás buscando a<br>alguien?"
msgstr ""

#. en: <$voicel(1,5)><$motion(1,807)><$comeff(1,10)>Oh... Not sure what made me think that, yo!
msgctxt "1959:701"
msgid "<$voicel(1,5)><$motion(1,807)><$comeff(1,10)>¡Menudo fail! Pensaba que sí."
msgstr "<$voicel(1,5)><$motion(1,807)><$comeff(1,10)>¡Qué fail! Pensaba que sí."

#. en: <oneline><$emotion(1,41)><$voicel(1,3)>I dunno where to find <$cdef(27)><pksrchtar;0></color>, yo...<br><$emotion(1,37)><$voicel(1,8)>Sorry<slide><br>I<slide><br>can’t help!
msgctxt "1959:702"
msgid "<$cdef(27)><$emotion(1,41)></color><$voicel(1,3)>Pues no tengo ni flowers de dónde puede estar.<br><$emotion(1,37)><$voicel(1,8)>¡Siento no poder ayudar a mi bestie!"
msgstr "<$cdef(27)><$emotion(1,41)></color><$voicel(1,3)>Pues no tengo ni idea de dónde puede estar.<br><$emotion(1,37)><$voicel(1,8)>¡Siento no poder ayudar a mi bestie!"

#. en: <$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>How’s my comfort level? Uhhh... <$cdef(27)><$stflevel;0(1)></color>, honestly!
msgctxt "1959:750"
msgid "<$voicel(1,3)><$motion(1,807)><$facial(1,9)><$comeff(1,7)>Pues a ver... <wait(1.0)>Es <$cdef(27)><$stflevel;0(1)></color>, sin más..."
msgstr ""

#. en: <$voicel(1,7)><$comeff(1,3)><$facial(1,1)><$motion(1,661)>How’s my comfort level? <$cdef(27)><$stflevel;0(2)></color>, yo!
msgctxt "1959:751"
msgid "<oneline><$voicel(1,7)><$comeff(1,3)><$facial(1,1)><$motion(1,661)>¡Pues es <$cdef(27)><$stflevel;0(2)></color>!"
msgstr ""

#. en: <$voicel(1,5)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>How’s my comfort level? Kinda <$cdef(27)><flow><$stflevel;0(3)></color> recently!
msgctxt "1959:752"
msgid "<$voicel(1,5)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>¡Oye, pues ahora mismo es <$cdef(27)><$stflevel;0(3)></color>!"
msgstr ""

#. en: <$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,21)>How’s my comfort level? Pretty dang <$cdef(27)><flow><$stflevel;0(4)></color>, yo!
msgctxt "1959:753"
msgid "<$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,21)>¡Ey, es <$cdef(27)><$stflevel;0(4)></color>, tí<gen;-2(o,a)>!"
msgstr "<$voicel(1,7)><$motion(1,801)><$facial(1,4)><$comeff(1,21)>¡Ey, es <$cdef(27)><$stflevel;0(4)></color>, amig<gen;-2(o,a)>!"

#. en: <$voicel(1,9)><$motion(1,801)><$facial(1,5)><$comeff(1,8)>How’s my comfort level? Heckin’ <$cdef(27)><flow><$stflevel;0(5)></color>! <$voicel(1,8)><$motion(1,803)><$comeff(1,9)>I wanna live<br>here forever, yo!
msgctxt "1959:754"
msgid "<oneline><$voicel(1,9)><$motion(1,801)><$facial(1,5)><$comeff(1,8)>¡Living estoy! ¡Es <$cdef(27)><$stflevel;0(5)></color>, tí<gen;-2(o,a)>! <$voicel(1,8)><$motion(1,803)><$comeff(1,9)>¡Quiero quedarme<br>a vivir<slide><br>aquí forever!"
msgstr "<oneline><$voicel(1,9)><$motion(1,801)><$facial(1,5)><$comeff(1,8)>¡Living estoy! ¡Es <$cdef(27)><$stflevel;0(5)></color>, amig<gen;-2(o,a)>! <$voicel(1,8)><$motion(1,803)><$comeff(1,9)>¡Quiero quedarme<br>a vivir<slide><br>aquí forever!"

#. en: <$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>I think things’re better than they were before, though!
msgctxt "1959:756"
msgid "<$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¡Mejor que antes está! ¡Mis dieces!"
msgstr ""

#. en: <oneline><$voicel(1,9)><$emotion(1,8)>Things’re way better now thanks to you,<br><$cdef(27)><pname;0></color>!<slide><br><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>You ROCK!
msgctxt "1959:757"
msgid "<$voicel(1,9)><$emotion(1,8)>¡Ahora es muy top! <$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Te lo has currado mil."
msgstr "<$voicel(1,9)><$emotion(1,8)>¡Ahora es muy top! <$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>Te esforzaste mil."

#. en: <oneline><$comeff(1,7)><$facial(1,9)><$motion(1,802)><$voicel(1,3)>Yooo... Sorry, but this<br><$cdef(27)><fqty(1)><class><aireactp;0></color><slide><$cdef(27)><br></color>is<slide><br>a<slide><br>little<slide><br>too<slide><br>small<slide><br>for me.<clear><br><$voicel(1,6)>It’d be super great if I could get something slightly bigger!
msgctxt "1959:758"
msgid "<oneline><$comeff(1,7)><$facial(1,9)><$motion(1,802)><$voicel(1,3)>Lo siento, pero est<genqty;0(e,a,os,as)><br><$cdef(27)><fqty(1)><aireactp;0></color><slide><br><qty;0(es,son)> un poco<slide><br>pequeñ<genqty;0(o,a,os,as)> para mí...<clear><br><$voicel(1,6)>¿No tendrás algo más grande?"
msgstr ""

#. en: <oneline><$voicel(1,7)><$emotion(1,8)>Yo, thanks for bringin’ me<br><iart;0()><$cdef(27)><fqty(1)><class><aireactp;0></color>!
msgctxt "1959:761"
msgid "<oneline><$voicel(1,7)><$emotion(1,8)>¡<fcap><iart;0()><$cdef(27)><fqty(1)><class><aireactp;0></color>!<br>¡Muchas gracias, tí<gen;-2(o,a)>!"
msgstr "<oneline><$voicel(1,7)><$emotion(1,8)>¡<fcap><iart;0()><$cdef(27)><fqty(1)><class><aireactp;0></color>!<br>¡Muchas gracias, amig<gen;-2(o,a)>!"

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>How’s my comfort level? Hm... It’s hard to say since I’m<br>not home right now, yo... <$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,4)>But kinda <$cdef(27)><flow><$stflevel;0(1)></color>, I guess.
msgctxt "1959:762"
msgid "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Uf, me pillas fuera de casa... No te quiero funar, tí<gen;-2(o,a)>,<br>pero... <wait(1.0)><$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,4)>¿<$cdef(27)><$stflevel;0(1)></color>, y ya?"
msgstr "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Uf, ando fuera de casa... No te quiero funar, amig<gen;-2(o,a)>,<br>pero... <wait(1.0)><$comeff(1,7)><$facial(1,9)><$motion(1,807)><$voicel(1,4)>¿<$cdef(27)><$stflevel;0(1)></color>, y ya?"

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>How’s my comfort level? Hm... It’s hard to say since I’m<br>not home right now, yo... <$comeff(1,3)><$motion(1,803)><$voicel(1,6)>But maybe <$cdef(27)><flow><$stflevel;0(2)></color>.
msgctxt "1959:763"
msgid "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Cómo me troleas preguntándome esto fuera de casa, ¿eh?<br><wait(1.0)><$comeff(1,3)><$motion(1,803)><$voicel(1,6)>Yo creo que es <$cdef(27)><$stflevel;0(2)></color>."
msgstr ""

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>How’s my comfort level? Hm... It’s hard to say since I’m<br>not home right now, yo... <$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,8)>But kinda <$cdef(27)><flow><$stflevel;0(3)></color>, I think.
msgctxt "1959:764"
msgid "<oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>¿En mi casa? A ver que me ubique...<wait(1.0)><br><$comeff(1,9)><$facial(1,4)><$motion(1,803)><$voicel(1,8)>¡Se está <$cdef(27)><$stflevel;0(3)></color>!"
msgstr ""

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>How’s my comfort level? Hm... It’s hard to say since I’m<br>not home right now...<$comeff(1,21)><$motion(1,801)><$voicel(1,10)>but pretty sure it’s <$cdef(27)><flow><$stflevel;0(4)></color>, yo!
msgctxt "1959:765"
msgid "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Muy random lo tuyo, preguntándome sin estar allí, pero...<br><wait(1.0)><$comeff(1,21)><$motion(1,801)><$voicel(1,10)>¡es <$cdef(27)><$stflevel;0(4)></color>!"
msgstr "<$comeff(1,14)><$motion(1,666)><$voicel(1,5)>Muy random lo tuyo, preguntándome sin estar ahí, pero...<br><wait(1.0)><$comeff(1,21)><$motion(1,801)><$voicel(1,10)>¡es <$cdef(27)><$stflevel;0(4)></color>!"

#. en: <$comeff(1,14)><$motion(1,666)><$voicel(1,5)>How’s my comfort level? Hm... It’s hard to say since I’m<br>not home right now...<$comeff(1,8)><$motion(1,801)><$voicel(1,10)>but I think it’s <$cdef(27)><flow><$stflevel;0(5)></color>, yo!<clear><br><$comeff(1,9)><$motion(1,803)><$voicel(1,8)>I’m havin’ SO much fun every single day!
msgctxt "1959:766"
msgid "<oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>¿En casa? <wait(1.0)>No me hace ni falta estar allí, <$comeff(1,8)><$motion(1,801)><$voicel(1,10)>¡ya te digo que<br><$cdef(27)><$stflevel;0(5)></color>, tí<gen;-2(o,a)>!<clear><br><$comeff(1,9)><$motion(1,803)><$voicel(1,8)>¡Literal que no podría estar más a gusto!"
msgstr "<oneline><$comeff(1,14)><$motion(1,666)><$voicel(1,5)>¿En casa? <wait(1.0)>Ni siquiera necesito estar ahí, <$comeff(1,8)><$motion(1,801)><$voicel(1,10)>¡ya te digo que<br><$cdef(27)><$stflevel;0(5)></color>, amig<gen;-2(o,a)>!<clear><br><$comeff(1,9)><$motion(1,803)><$voicel(1,8)>¡Literal que no podría estar más a gusto!"

#. en: <$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>I’m pretty sure it’s gotten better!
msgctxt "1959:767"
msgid "<$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¡Diría que la casa está más chetada ahora!"
msgstr "<$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¡Diría que la casa está más pro ahora!"

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>I think it’s a lot better now! And it’s all because of you,<br><$cdef(27)><pname;0></color>! <$voicel(1,10)><$emotion(1,39)>Thanks, yo!
msgctxt "1959:768"
msgid "<$cdef(27)><$voicel(1,7)></color><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¡Gracias a ti, se está de lujo! <$voicel(1,10)><$emotion(1,39)>¡Mis dieces!"
msgstr ""

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>My home? It’s over this way, yo! Follow me, I’ll take<br>you there!
msgctxt "1959:769"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¿Mi casa, dices? Está por aquí. ¡Sígueme!"
msgstr ""

#. en: <$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>My home? It’s over that way! I’d love to take you there...<br><$voicel(1,4)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>But I’m kinda busy right now! Sorry, yo!
msgctxt "1959:770"
msgid "<$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¿Mi casa? ¡Está por allí, pero no puedo llevarte ahora!<br><$voicel(1,4)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>Ya lo siento, tí<gen;-2(o,a)>, pero me pillas liad<gen;-3(o,a)>, no, lo siguiente..."
msgstr "<$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,10)>¿Mi casa? ¡Está por allá, pero no puedo llevarte ahora!<br><$voicel(1,4)><$motion(1,807)><$facial(1,9)><$comeff(1,4)>Lo siento mucho, amig<gen;-2(o,a)>, pero ando ocupadísim<gen;-3(o,a)>..."

#. en: <oneline><$voicel(1,7)><$emotion(1,8)>You put <iart;1()><$cdef(27)><fqty(1)><class><stfrevp;1></color><br>in<slide><br>my<slide><br>home?<slide><br>Awesome,<slide><br>yo! Thanks!
msgctxt "1959:771"
msgid "<oneline><$voicel(1,7)><$emotion(1,8)>¿Me has puesto<br><iart;1()><fqty(1)><class><$cdef(27)><stfrevp;1></color><slide><br>en casa? ¡Te sales, tí<gen;-2(o,a)>!"
msgstr "<oneline><$voicel(1,7)><$emotion(1,8)>¿Me pusiste<br><iart;1()><fqty(1)><class><$cdef(27)><stfrevp;1></color><slide><br>en casa? ¡Genial, amig<gen;-2(o,a)>!"

#. en: <oneline><$emotion(1,8)><$voicel(1,9)>You put <iart;0()><$cdef(27)><fqty(1)><class><stfrevp;0><br></color>outside<slide><br>for<slide><br>me?<slide><br>Awesome,<slide><br>yo!<slide><br>Thanks<slide><br>so much!
msgctxt "1959:772"
msgid "<oneline><$emotion(1,8)><$voicel(1,9)>¡Me has puesto<br><iart;0()><$cdef(27)><fqty(1)><class><stfrevp;0><slide><br></color>fuera!<slide><br>¡Gracias, tí<gen;-2(o,a)>!"
msgstr "<oneline><$emotion(1,8)><$voicel(1,9)>¡Me pusiste<br><iart;0()><$cdef(27)><fqty(1)><class><stfrevp;0><slide><br></color>afuera!<slide><br>¡Gracias, amig<gen;-2(o,a)>!"

#. en: <$comeff(1,6)><$motion(1,666)><$voicel(1,5)>How’s my comfort level? Hm... I JUST moved in, so I don’t<br>really know yet, yo! <$comeff(1,3)><$motion(1,803)><$voicel(1,8)>Maybe ask me again after I’ve had<slide><br>time to settle in!
msgctxt "1959:773"
msgid "<$comeff(1,6)><$motion(1,666)><$voicel(1,5)>¿Cómo saberlo si me acabo de mudar? Ja, ja.<br><$comeff(1,3)><$motion(1,803)><$voicel(1,8)>¡Pregúntame cuando lleve más tiempo!"
msgstr ""

#. en: <$emotion(1,1)><$voicel(1,8)>Thanks, yo!<clear><br><$comeff(1,14)><$facial(1,9)><$motion(1,805)><$voicel(1,5)>Oh, but...uh...I’m actually not really a fan of <$emotion(1,41)><$voicel(1,4)>stuff like<br><$cdef(27)><fqty(2)><class><stfrevp;1></color>...<clear><br><$emotion(1,29)><$voicel(1,6)>You wouldn’t happen to have anything else cool,<br>would ya?
msgctxt "1959:774"
msgid "<oneline><$emotion(1,1)><$voicel(1,8)>Mis dieces, tí<gen;-2(o,a)>.<clear><br><$comeff(1,14)><$facial(1,9)><$motion(1,805)><$voicel(1,5)>Aunque... <wait(1.0)>Respeto a full, pero es que...<br><$emotion(1,41)><$voicel(1,4)><dart;1()><$cdef(27)><fqty(2)><class><stfrevp;1></color> son<slide><br>un poco cringe para mí.<clear><br><$emotion(1,29)><$voicel(1,6)>¿No tendrás otra cosa?"
msgstr "<oneline><$emotion(1,1)><$voicel(1,8)>Mis dieces, amig<gen;-2(o,a)>.<clear><br><$comeff(1,14)><$facial(1,9)><$motion(1,805)><$voicel(1,5)>Aunque... <wait(1.0)>Respeto a full, pero es que...<br><$emotion(1,41)><$voicel(1,4)><dart;1()><$cdef(27)><fqty(2)><class><stfrevp;1></color> son<slide><br>un poco cringe para mí.<clear><br><$emotion(1,29)><$voicel(1,6)>¿No tendrás otra cosa?"

#. en: <oneline><$comeff(1,7)><$facial(1,9)><$motion(1,802)><$voicel(1,3)>Yooo... Sorry, but that<br><$cdef(27)><fqty(1)><class><stfrevp;0></color><slide><$cdef(27)><br></color>is<slide><br>a<slide><br>little<slide><br>too<slide><br>small<slide><br>for me.<clear><br><$voicel(1,6)>It’d be super great if I could get something slightly bigger!
msgctxt "1959:775"
msgid "<oneline><$comeff(1,7)><$facial(1,9)><$motion(1,802)><$voicel(1,3)>No es por hacerte spoiler, pero<br><dart;0()><fqty(1)><class><$cdef(27)><stfrevp;0><slide><br></color><qty;0(es,son)> algo<slide><br>pequeñ<genqty;0(o,a,os,as)><slide><br>para mí, ¿no?<clear><br><$voicel(1,6)>Algo más grande sería muy top."
msgstr ""

#. en: <oneline><$comeff(1,1)><$voicel(1,5)>Yooo, <$cdef(27)><pname;0></color>! You’re always pickin’ up<br>rocks<slide><br>and<slide><br>sticks<slide><br>and<slide><br>stuff.<slide><br><$comeff(1,6)><$motion(1,803)><$voicel(1,8)>You<slide><br>make<slide><br>tools<slide><br>with<slide><br>all that?<clear><br><$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>It makes the area nice and pretty and clean too. Good<br>stuff all around, yo!
msgctxt "1959:801"
msgid "<$cdef(27)><$comeff(1,1)></color><$voicel(1,5)>Te suelo ver por ahí recogiendo piedras, palos y demás.<br><$comeff(1,6)><$motion(1,803)><$voicel(1,8)>¿Con eso luego fabricas otras cosas, supongo?<clear><br><$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Además, así el suelo está más limpio que nunca.<br>¡Son todo ventajas!"
msgstr ""

#. en: <$comeff(1,10)><$motion(1,803)><$voicel(1,7)>Yo, I feel like I’ve seen you around here a lot<br>recently, <$cdef(27)><pname;0></color>.<clear><br><$motion(1,805)><$voicel(1,6)>I bet you’re hard at work making this area a better place<br>to live for all of us! <$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Thanks so much!
msgctxt "1959:802"
msgid "<$cdef(27)><$comeff(1,10)></color><$motion(1,803)><$voicel(1,7)>Te veo mucho por aquí últimamente. <$motion(1,805)><$voicel(1,6)>¡Seguro que es para<br>hacer que la zona sea incluso más habitable!<clear><br>¡Si es que eres la leche! <$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Mis dieces!"
msgstr "<$cdef(27)><$comeff(1,10)></color><$motion(1,803)><$voicel(1,7)>Te veo mucho por aquí últimamente. <$motion(1,805)><$voicel(1,6)>¡Seguro que es para<br>hacer que la zona sea incluso más habitable!<clear><br>¡Es que eres lo máximo! <$comeff(1,9)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Mis dieces!"

#. en: <oneline><$comeff(1,9)><$motion(1,806)><$voicel(1,7)>Yooo, it was hard work but also a lot of fun makin’ that<br><$cdef(27)><asnbname;0></color>! <$comeff(1,21)><$motion(1,803)><$voicel(1,8)>Gave me a<slide><br>real<slide><br>sense of<slide><br>accomplishment,<slide><br>y’know?!<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>I’d love to help out again, if you’ll have me, yo!
msgctxt "1959:803"
msgid "<oneline><$comeff(1,9)><$motion(1,806)><$voicel(1,7)>Fue duro construir<br><dart;0()><$cdef(27)><asnbname;0></color>,<slide><br>pero me lo pasé<slide><br>demasiado bien.<clear><br><$comeff(1,21)><$motion(1,803)><$voicel(1,8)>¡Siento que fue todo un logro para mí, pero literal!<br><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>Si necesitas ayuda de nuevo, dime."
msgstr "<oneline><$comeff(1,9)><$motion(1,806)><$voicel(1,7)>Fue duro construir<br><dart;0()><$cdef(27)><asnbname;0></color>,<slide><br>pero me la pasé<slide><br>demasiado bien.<clear><br><$comeff(1,21)><$motion(1,803)><$voicel(1,8)>¡Siento que fue todo un logro para mí, pero literal!<br><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,10)>Si necesitas ayuda de nuevo, dime."

#. en: <oneline><$comeff(1,6)><$motion(1,803)><$voicel(1,7)>Yooo... How did you make that<br><$cdef(27)><rctbname;0></color>?<clear><br><$comeff(1,10)><$motion(1,801)><$voicel(1,9)>If you ever think about makin’ another, please let me help<br>out too!
msgctxt "1959:804"
msgid "<oneline><$comeff(1,6)><$motion(1,803)><$voicel(1,7)>¿Cómo habéis construido<br><dart;0()><$cdef(27)><rctbname;0></color>?<slide><br><$comeff(1,10)><$motion(1,801)><$voicel(1,9)>¡Si volvéis a hacer algo así, quiero echar una mano!"
msgstr "<oneline><$comeff(1,6)><$motion(1,803)><$voicel(1,7)>¿Cómo construyeron<br><dart;0()><$cdef(27)><rctbname;0></color>?<slide><br><$comeff(1,10)><$motion(1,801)><$voicel(1,9)>¡Si vuelven a hacer algo así, quiero echar una mano!"

#. en: <oneline><$comeff(1,14)><$voicel(1,5)>Yo, <$cdef(27)><pname;0></color>! Seein’ you just<br>reminded me...<clear><br><$comeff(1,6)><$motion(1,803)><$voicel(1,7)>Have you seen <$cdef(27)><acqpname;1> </color>lately?<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>I wonder how they’re doin’. I sure would like to pal around<br>with them again!
msgctxt "1959:805"
msgid "<$cdef(27)><$comeff(1,14)></color><$voicel(1,5)>Ahora que te he visto me he acordado de una cosa...<br><$comeff(1,6)><$motion(1,803)><$voicel(1,7)>¿Has visto a <$cdef(27)><acqpname;1></color> últimamente?<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Me pregunto qué tal estará. Molaría volver a vernos."
msgstr "<$cdef(27)><$comeff(1,14)></color><$voicel(1,5)>Ahora que te vi me acordé de una cosa...<br><$comeff(1,6)><$motion(1,803)><$voicel(1,7)>¿Has visto a <$cdef(27)><acqpname;1></color> últimamente?<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Me pregunto qué tal estará. Ojalá volvamos a vernos."

#. en: <oneline><$comeff(1,6)><$motion(1,803)><$voicel(1,5)>Whoa, <$cdef(27)><pname;0></color>... You’ve changed some<br>things<slide><br>up,<slide><br>huh?<slide><br><$comeff(1,5)><$facial(1,4)><$motion(1,806)><$voicel(1,10)>Lookin’ good!<clear><br><$comeff(1,21)><$motion(1,801)><$voicel(1,7)>Yooo, I bet it’s fun to be able to <$cdef(27)><$spwfull(36)></color> into a<br>human, huh?
msgctxt "1959:806"
msgid "<$motion(1,803)><$voicel(1,5)>Oye, te noto distint<gen;-2(o,a)>. <$comeff(1,6)>¿Has cambiado de modelito?<br><$comeff(1,5)><$facial(1,4)><$motion(1,806)><$voicel(1,10)>¡Me encanta, tí<gen;-2(ooo,aaa)>, tú siempre sirviendo lookazos!<clear><br><$comeff(1,21)><$motion(1,801)><$voicel(1,7)>Tiene que ser una guapada <$cdef(27)><$spwfull(36)></color> en human<gen;-2(o,a)>."
msgstr "<$motion(1,803)><$voicel(1,5)>Oye, te noto distint<gen;-2(o,a)>. <$comeff(1,6)>¿Cambiaste de modelito?<br><$comeff(1,5)><$facial(1,4)><$motion(1,806)><$voicel(1,10)>¡Me encanta, amig<gen;-2(ooo,aaa)>, tú siempre sirviendo lookazos!<clear><br><$comeff(1,21)><$motion(1,801)><$voicel(1,7)>Tiene que ser increíble <$cdef(27)><$spwfull(36)></color> en human<gen;-2(o,a)>."

#. en: <oneline><$comeff(1,6)><$motion(1,803)><$voicel(1,5)>Huh? Hmmm... Somethin’ looks different about<br>you, <$cdef(27)><pname;0></color>.<clear><br><$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>You’re just, like...slightly different from the last time I saw<br>you, yo!
msgctxt "1959:807"
msgid "<$cdef(27)><$comeff(1,6)></color><$motion(1,803)><$voicel(1,5)>Ey, ¿te has hecho algo? Te noto un poco distint<gen;-2(o,a)>...<clear><br><$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>La última vez que te vi tenías otras pintas."
msgstr "<$cdef(27)><$comeff(1,6)></color><$motion(1,803)><$voicel(1,5)>Ey, ¿te hiciste algo? Te noto un poco distint<gen;-2(o,a)>...<clear><br><$comeff(1,13)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>La última vez que te vi tenías otro look."

#. en: <$comeff(1,1)><$voicel(1,7)>Yooo, I’m so grateful to you for makin’ a home for<br>me, <$cdef(27)><pname;1></color>!<clear><br><$comeff(1,14)><$motion(1,807)><$voicel(1,5)>I just remember suddenly findin’ myself right near my new<br>home, but I can’t really remember anything before that...<clear><br><$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>Anyway! I’m just glad I got to meet you!
msgctxt "1959:808"
msgid "<$cdef(27)><$comeff(1,1)></color><$voicel(1,7)>¡Gracias por conseguirme un lugar donde vivir! ¡Te sales!<clear><br><$cdef(27)><$comeff(1,14)></color><$motion(1,807)><$voicel(1,5)>Me he dado cuenta de que no tengo muchos recuerdos<br>de antes de mudarme aquí... ¿Por qué será?<clear><br><$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡En cualquier caso, me alegro de haberte conocido!"
msgstr "<$cdef(27)><$comeff(1,1)></color><$voicel(1,7)>¡Gracias por conseguirme un lugar donde vivir! ¡Eres top!<clear><br><$cdef(27)><$comeff(1,14)></color><$motion(1,807)><$voicel(1,5)>Me di cuenta de que no tengo muchos recuerdos<br>de antes de mudarme aquí... ¿Por qué será?<clear><br><$comeff(1,21)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡En cualquier caso, me alegro de haberte conocido!"

#. en: <$comeff(1,1)><$motion(1,803)><$voicel(1,7)><$cdef(27)>Professor Tangrowth</color> really knows a lot of stuff. It’s pretty<br>amazing, yo!<clear><br><$comeff(1,14)><$voicel(1,6)>I think they said they grew up living with a human.<clear><br><$comeff(1,13)><$facial(1,4)><$motion(1,807)><$voicel(1,9)>I bet they really watched that human closely and learned a<br>bunch of stuff from ’em, huh?!
msgctxt "1959:809"
msgid "<$comeff(1,1)><$motion(1,803)><$voicel(1,7)>¡El <$cdef(27)>Profesor Tangrowth </color>lo sabe todo, es una pasada!<clear><br><$comeff(1,14)><$voicel(1,6)>Al parecer vivió entre humanos desde que era pequeño.<clear><br><$comeff(1,13)><$facial(1,4)><$motion(1,807)><$voicel(1,9)>¡Seguro que aprendió un montón de ellos durante todos<br>esos años!"
msgstr "<$comeff(1,1)><$motion(1,803)><$voicel(1,7)>¡El <$cdef(27)>Profesor Tangrowth </color>lo sabe todo, es increíble!<clear><br><$comeff(1,14)><$voicel(1,6)>Al parecer vivió entre humanos desde que era pequeño.<clear><br><$comeff(1,13)><$facial(1,4)><$motion(1,807)><$voicel(1,9)>¡Seguro que aprendió un montón de ellos durante todos<br>esos años!"

#. en: <$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>Every day’s super fun when I’m livin’ with my best friend!<br>That’s you, <$cdef(27)><pname;0></color>!<clear><br><$voicel(1,9)><$motion(1,801)><$facial(1,5)><$comeff(1,21)>Yooo, I hope this lasts forever!
msgctxt "1959:810"
msgid "<$voicel(1,7)><$motion(1,803)><$facial(1,4)><$comeff(1,9)>¡Estoy living de poder vivir con mi bestie! Contigo aquí,<br>todos los días son icónicos.<clear><br><$voicel(1,9)><$motion(1,801)><$facial(1,5)><$comeff(1,21)>¡Y espero que dure para siempre!"
msgstr ""

#. en: <oneline><$voicel(1,7)><$emotion(1,8)><$pkcry;0(1,2)>... <$pkcry;1(1,3)> <flow><$pkcry;2(1,1)>! ♪<br>I’m<slide><br>always<slide><br>practicin’<slide><br>my<slide><br>singing<slide><br>like<slide><br>this, yo.<clear><br><$voicel(1,9)><$motion(1,803)><$facial(1,1)><$comeff(1,10)>I lose my skill real fast if I don’t practice. Gotta keep it<br>goin’, y’know!
msgctxt "1959:811"
msgid "<oneline><$voicel(1,7)><$emotion(1,8)>♪<$pkcry;0(1,2)>... <$pkcry;1(1,3)>,<br><flow>¡<$pkcry;2(1,1)>!♪<slide><br>Así es como suelo<slide><br>entrenar la voz.<clear><br><$voicel(1,9)><$motion(1,803)><$facial(1,1)><$comeff(1,10)>Hay que ser consistente, si no enseguida pierdo el nivel."
msgstr ""

#. en: <$voicel(1,7)><$motion(1,805)><$comeff(1,6)>Hey, <$cdef(27)><pname;0></color>! Did you know...<clear><br><$voicel(1,6)><$motion(1,803)><$comeff(1,10)>Strength training is good and all, but <$voicel(1,8)><$motion(1,801)><$facial(1,4)><$comeff(1,21)>you also gotta eat<br>well and sleep well to really grow your muscles!
msgctxt "1959:812"
msgid "<$voicel(1,7)><$motion(1,805)><$comeff(1,6)>¿Sabes qué? Dicen que no llega con entrenar duro,<br><$voicel(1,6)><$motion(1,803)><$comeff(1,10)>hay que comer y dormir bien <$voicel(1,8)><$motion(1,801)><$facial(1,4)><$comeff(1,21)>para ganar músculo."
msgstr "<$voicel(1,7)><$motion(1,805)><$comeff(1,6)>¿Sabes qué? Dicen que no basta con entrenar duro,<br><$voicel(1,6)><$motion(1,803)><$comeff(1,10)>hay que comer y dormir bien <$voicel(1,8)><$motion(1,801)><$facial(1,4)><$comeff(1,21)>para ganar músculo."

#. en: <$voicel(1,9)><$motion(1,801)><$comeff(1,10)>Hey, <$cdef(27)><pname;0></color>! Hey! Yo, check this out.<clear><br>...<wait(0.5)><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,1)>Bwahaha!<clear><br><$voicel(1,5)><$motion(1,806)><$facial(1,1)><$comeff(1,6)>Whatcha think? I tried to grin and laugh in, like...a tough<br>and cool and kinda scary way. How’d I do?!
msgctxt "1959:813"
msgid "<oneline><$voicel(1,9)><$motion(1,801)><$comeff(1,10)>¡<$cdef(27)><pname;0></color>, <$cdef(27)><pname;1></color>!<clear><br>... <wait(0.5)><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,1)>¡Muaaa, ja, ja, ja, ja!<clear><br><$voicel(1,5)><$motion(1,806)><$facial(1,1)>Dime, dime: <$comeff(1,6)>¿qué te ha parecido mi risotada de malot<gen;-3(e,a)>?<br>¿Verdad que es maligna y una guapada al mismo tiempo?"
msgstr "<oneline><$voicel(1,9)><$motion(1,801)><$comeff(1,10)>¡<$cdef(27)><pname;0></color>, <$cdef(27)><pname;1></color>!<clear><br>... <wait(0.5)><$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,1)>¡Muaaa, ja, ja, ja, ja!<clear><br><$voicel(1,5)><$motion(1,806)><$facial(1,1)>Dime, dime: <$comeff(1,6)>¿qué te pareció mi risotada de malot<gen;-3(e,a)>?<br>¿Verdad que es maligna y genial al mismo tiempo?"

#. en: <$voicel(1,5)><$motion(1,805)><$comeff(1,14)>Yo, I dunno why, but I have this feeling that I’m gonna be,<br>like...<$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>a LOT cooler one day when I grow bigger!<clear><br><$voicel(1,10)><$motion(1,801)><$comeff(1,10)>Just thinking about it gets me all excited, yo!
msgctxt "1959:817"
msgid "<$voicel(1,5)><$motion(1,805)><$comeff(1,14)>Igual estoy delulu, pero me da la impresión de que,<br>cuando sea mayor, <$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>seré mil veces más fuerte y cool.<slide><br><$voicel(1,10)><$motion(1,801)><$comeff(1,10)>¡Solo con pensarlo, me entra un hype!..."
msgstr "<$voicel(1,5)><$motion(1,805)><$comeff(1,14)>Tal vez estoy delulu, pero me da la impresión de que,<br>cuando sea mayor, <$voicel(1,8)><$motion(1,803)><$facial(1,4)><$comeff(1,21)>seré mil veces más fuerte y cool.<slide><br><$voicel(1,10)><$motion(1,801)><$comeff(1,10)>¡Solo con pensarlo, me entra un hype!..."

#. en: <oneline><$voicel(1,7)><$emotion(1,39)><$cdef(27)><$tonepk;0(14)> </color>has a kinda grown-up vibe,<br>don’t<slide><br>you<slide><br>think?<slide><br>It’s<slide><br>pretty cool...<clear><br><$voicel(1,3)><$motion(1,807)><$comeff(1,4)><$facial(1,1)>I get so nervous when we talk, yo. I hope I never<br>say anything weird or embarrassing...
msgctxt "1959:831"
msgid "<oneline><$voicel(1,7)><$emotion(1,39)><fcap><dart;0()><$cdef(27)><$tonepk;0(14)></color> es icónic<gen;0(o,a)>... L<gen;0(o,a)> seguiría<br>al fin del mundo.<clear><br><$voicel(1,3)><$motion(1,807)><$comeff(1,4)><$facial(1,1)>Cuando hablo con <gen;0(él,ella)>, me pongo nervios<gen;-3(o,a)> y todo...<br>¿Y si se piensa que doy cringe?"
msgstr "<oneline><$voicel(1,7)><$emotion(1,39)><fcap><dart;0()><$cdef(27)><$tonepk;0(14)></color> es icónic<gen;0(o,a)>... L<gen;0(o,a)> seguiría<br>al fin del mundo.<clear><br><$voicel(1,3)><$motion(1,807)><$comeff(1,4)><$facial(1,1)>Cuando hablo con <gen;0(él,ella)>, me pongo nervios<gen;-3(o,a)> y todo...<br>¿Y si piensa que doy cringe?"

#. en: <$cdef(27)><oneline><$voicel(1,9)><$emotion(1,39)><$tonepk;0(16)> </color>is so cool, yo! And powerful<br>and<slide><br>kind<slide><br>and<slide><br>everything<slide><br>I<slide><br>wanna be!<clear><br><$voicel(1,7)><$motion(1,803)><$comeff(1,10)>I’m gonna be like that one day too! Just watch!
msgctxt "1959:833"
msgid "<oneline><$voicel(1,9)><$emotion(1,39)>¡<fcap><dart;0()><$cdef(27)><$tonepk;0(16)></color> se sale! Es tan noble<br>y tan amable...<slide><br><$voicel(1,7)><$motion(1,803)><$comeff(1,10)>¡Yo también quiero ser así de mayor, cienpor!"
msgstr "<oneline><$voicel(1,9)><$emotion(1,39)>¡<fcap><dart;0()><$cdef(27)><$tonepk;0(16)></color> es lo máximo! Es tan noble<br>y tan amable...<slide><br><$voicel(1,7)><$motion(1,803)><$comeff(1,10)>¡Yo también quiero ser así de mayor, en serio!"

#. en: <$comeff(1,6)><$motion(1,666)><$voicel(1,7)><$cdef(27)><gevcmainpk;0></color> seems real excited about somethin’, yo. What<br>do you think they’re up to?!
msgctxt "1959:851"
msgid "<$motion(1,666)><$voicel(1,7)>¡<fcap><dart;0()><$cdef(27)><gevcmainpk;0></color> está hypeadísim<gen;0(o,a)> últimamente!<br><$comeff(1,6)>¿Qué estará tramando?"
msgstr ""

#. en: <$emotion(1,8)><$voicel(1,8)>Phew, OK, can’t talk like that anymore, yo!<clear><br><$emotion(1,60)><$voicel(1,9)>It was a pretty good imitation though, right?!<br><$comeff(1,6)><$facial(1,1)><$motion(1,805)><$voicel(1,8)>Could you tell who I was?
msgctxt "1959:853"
msgid "...<clear><br><$emotion(1,8)><$voicel(1,8)>¡Pfff! ¡Menud<gen;-3(o,a)> trol estoy hech<gen;-3(o,a)>! Ja, ja.<clear><br><$emotion(1,60)><$voicel(1,9)>¿Cómo te quedas? Soy superpró en esto de las bromas,<br>¿eh? A ver, <$comeff(1,6)><$facial(1,1)><$motion(1,805)><$voicel(1,8)>¿a quién estaba imitando?"
msgstr "...<clear><br><$emotion(1,8)><$voicel(1,8)>¡Pfff! ¡Tremend<gen;-3(o,a)> trol estoy hech<gen;-3(o,a)>! Ja, ja.<clear><br><$emotion(1,60)><$voicel(1,9)>¿Qué te parece? Soy superpró en esto de las bromas,<br>¿eh? A ver, <$comeff(1,6)><$facial(1,1)><$motion(1,805)><$voicel(1,8)>¿a quién estaba imitando?"

#. en: <$comeff(1,20)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>That’s SUPER CORRECT! I shoulda known you’d get it<br>right, <$cdef(27)><pname;0></color>.
msgctxt "1959:854"
msgid "<$comeff(1,20)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Sí, era! ¡Has acertado, tí<gen;-2(o,a)>! Te lo he puesto demasiado<br>fácil, ¿eh?"
msgstr "<$comeff(1,20)><$facial(1,4)><$motion(1,801)><$voicel(1,9)>¡Sí, era! ¡Acertaste, amig<gen;-2(o,a)>! Te lo puse demasiado<br>fácil, ¿eh?"

#. en: <oneline><$emotion(1,60)><$voicel(1,9)>Awww... Nope! I was tryin’ to sound like<br><$cdef(27)><apfquizpk;0(0)></color>, yo!<clear><br><$comeff(1,9)><$motion(1,806)><$voicel(1,8)>Guess I gotta work on my imitating skills so it’ll be easier<br>to guess next time!
msgctxt "1959:855"
msgid "<oneline><$emotion(1,60)><$voicel(1,9)>¡Patinazo histórico! ¡Tendrías que haber dicho<br><dart;0()><$cdef(27)><apfquizpk;0(0)></color>!<clear><br>Pues nada, tendré que practicar más mis imitaciones.<br><$comeff(1,9)><$motion(1,806)><$voicel(1,8)>¡Fijo que la próxima vez aciertas! Confío."
msgstr "<oneline><$emotion(1,60)><$voicel(1,9)>¡Patinazo histórico! ¡Tendrías que haber dicho<br><dart;0()><$cdef(27)><apfquizpk;0(0)></color>!<clear><br>Pues nada, tendré que practicar más mis imitaciones.<br><$comeff(1,9)><$motion(1,806)><$voicel(1,8)>¡Seguro que la próxima vez aciertas! Confío."

#. en: <$emotion(1,14)><$voicel(1,5)>Yooo! You want me to hold on to that <$cdef(27)><fqty(1)><$ifull(432)> </color>for<br>you, huh? <$voicel(1,8)><$facial(1,4)><$comeff(1,10)>Yeah, I can totally do that!
msgctxt "1959:859"
msgid "<$emotion(1,14)><$voicel(1,5)>¿Que quieres que me quede ese <$cdef(27)><fqty(1)><$ifull(432)></color>?<br><$voicel(1,8)><$facial(1,4)><$comeff(1,10)>¡Sin problema, tí<gen;-2(o,a)>!"
msgstr "<$emotion(1,14)><$voicel(1,5)>¿Que quieres que me quede ese <$cdef(27)><fqty(1)><$ifull(432)></color>?<br><$voicel(1,8)><$facial(1,4)><$comeff(1,10)>¡Sin problema, amig<gen;-2(o,a)>!"

#. en: <$emotion(1,15)><$voicel(1,10)>Whoa! Why’s it shining?!<clear><br><$emotion(1,55)><$voicel(1,5)>I think this might be a super special <$cdef(27)><fqty(1)><$ifull(432)></color> or<br>somethin’, yo!<clear><br><$emotion(1,60)><$voicel(1,7)>You can have it back, <$cdef(27)><pname;0></color>!
msgctxt "1959:860"
msgid "<$emotion(1,15)><$voicel(1,10)>¡Pero si se ha puesto a brillar! ¡Qué heavy!<clear><br><$emotion(1,55)><$voicel(1,5)>Menuda locura de <$cdef(27)><fqty(1)><$ifull(432)></color>, ¿no?<br><$emotion(1,60)><$voicel(1,7)>En fin, te lo devuelvo."
msgstr "<$emotion(1,15)><$voicel(1,10)>¡Pero si se puso a brillar! ¡Increíble!<clear><br><$emotion(1,55)><$voicel(1,5)>Qué locura de <$cdef(27)><fqty(1)><$ifull(432)></color>, ¿no?<br><$emotion(1,60)><$voicel(1,7)>En fin, te lo devuelvo."

#. en: <oneline><$comeff(1,11)><$facial(1,13)><$motionoff(1,804)><$voicel(1,9)><$pkcry;0(1,3)>?! Yooo... My heart’s thumpin’!<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>That was a pretty good trick, <$cdef(27)><pname;1></color>!<br>So good,<slide><br>I think<slide><br>you<slide><br>deserve<slide><br>a li’l<slide><br><$cdef(27)><fqty(1)><$ifull(532)></color>!
msgctxt "1959:862"
msgid "<oneline><$comeff(1,11)><$facial(1,13)><$motionoff(1,804)><$voicel(1,9)>¡<$pkcry;0(1,3)>! ¡Tí<gen;-2(ooo,aaa)>, literal que casi me debilito<br>del susto<slide><br>que me<slide><br>has pegado!<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Conque esta es tu era de dar sustos, ¿no,<br><$cdef(27)><pname;1></color>?<slide><br>¡Mis dieces!<slide><br>Toma, te llevas<slide><br>una <$cdef(27)><fqty(1)><$ifull(532)></color>."
msgstr "<oneline><$comeff(1,11)><$facial(1,13)><$motionoff(1,804)><$voicel(1,9)>¡<$pkcry;0(1,3)>! ¡Amig<gen;-2(ooo,aaa)>, literal que casi me debilito<br>del susto<slide><br>que me<slide><br>diste!<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Conque esta es tu era de dar sustos, ¿no,<br><$cdef(27)><pname;1></color>?<slide><br>¡Mis dieces!<slide><br>Toma, te llevas<slide><br>una <$cdef(27)><fqty(1)><$ifull(532)></color>."

#. en: <oneline><$comeff(1,11)><$facial(1,13)><$motionoff(1,804)><$voicel(1,9)><$pkcry;0(1,3)>?! Yooo... My heart’s thumpin’!<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>That was a pretty good trick, <$cdef(27)><pname;1></color>!<br>So good,<slide><br>I think<slide><br>you<slide><br>deserve<slide><br>a li’l<slide><br><$cdef(27)><fqty(1)><$ifull(532)></color>!
msgctxt "1959:863"
msgid "<oneline><$comeff(1,11)><$facial(1,13)><$motionoff(1,804)><$voicel(1,9)>¡<$pkcry;0(1,3)>! ¡Tí<gen;-2(ooo,aaa)>, literal que casi me debilito<br>del susto<slide><br>que me<slide><br>has pegado!<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Conque esta es tu era de dar sustos, ¿no,<br><$cdef(27)><pname;1></color>?<slide><br>¡Mis dieces!<slide><br>Toma, te llevas<slide><br>unas <$cdef(27)><fqty(2)><$ifull(532)></color>."
msgstr "<oneline><$comeff(1,11)><$facial(1,13)><$motionoff(1,804)><$voicel(1,9)>¡<$pkcry;0(1,3)>! ¡Amig<gen;-2(ooo,aaa)>, literal que casi me debilito<br>del susto<slide><br>que me<slide><br>diste!<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>Conque esta es tu era de dar sustos, ¿no,<br><$cdef(27)><pname;1></color>?<slide><br>¡Mis dieces!<slide><br>Toma, te llevas<slide><br>unas <$cdef(27)><fqty(2)><$ifull(532)></color>."

#. en: <$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,10)>I’d love to go, yo!<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,827)><$voicel(1,5)>But...it looks like you’ve got a lot of other Pokémon<br>who want to visit too, <$voicel(1,3)><$cdef(27)><pname;1></color>...<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>I’d love it if you’d invite me again next time, though!
msgctxt "1959:902"
msgid "<$cdef(27)><$comeff(1,1)></color><$facial(1,4)><$motion(1,803)><$voicel(1,10)>¡Ey, me encantaría ir!<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,827)><$voicel(1,5)>La cosa es que ya hay muchos Pokémon <$voicel(1,3)>que quieren ir<br>a visitarte, así que lo veo un poco chungo...<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>¡La próxima vez será! Ya me invitarás otro día."
msgstr "<$cdef(27)><$comeff(1,1)></color><$facial(1,4)><$motion(1,803)><$voicel(1,10)>¡Ey, me encantaría ir!<clear><br><$comeff(1,14)><$facial(1,1)><$motion(1,827)><$voicel(1,5)>La cosa es que ya hay muchos Pokémon <$voicel(1,3)>que quieren ir<br>a visitarte, así que lo veo un poco complicado...<clear><br><$comeff(1,10)><$facial(1,4)><$motion(1,801)><$voicel(1,7)>¡La próxima vez será! Ya me invitarás otro día."

#. en: <$comeff(1,10)><$facial(1,4)><$motion(1,824)><$voicel(1,7)>Yooo, that was fun! I’m headed back now, <$comeff(1,13)><$motion(1,801)><$voicel(1,10)>but I hope we<br>can hang out again some other time!
msgctxt "1959:903"
msgid "<$comeff(1,10)><$facial(1,4)><$motion(1,824)><$voicel(1,7)>¡Qué pasada de día! ¡Ha sido un evento canónico!<clear><br>Ahora toca volver a casa... <$comeff(1,13)><$motion(1,801)><$voicel(1,10)>pero ya quedaremos otra vez."
msgstr "<$comeff(1,10)><$facial(1,4)><$motion(1,824)><$voicel(1,7)>¡Qué día tan increíble! ¡Fue un evento canónico!<clear><br>Ahora toca volver a casa... <$comeff(1,13)><$motion(1,801)><$voicel(1,10)>pero ya nos veremos otra vez."

#. en: <$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>Really?! I’d love to visit, yo!<clear><br><$comeff(1,13)><$motion(1,801)><$voicel(1,9)>I’ll head over in a bit! I’m really lookin’ forward to it!
msgctxt "1959:904"
msgid "<$comeff(1,1)><$facial(1,4)><$motion(1,803)><$voicel(1,7)>¿En serio? Me encantaría ir, <gen;-2(tío,tía)>.<clear><br><$comeff(1,13)><$motion(1,801)><$voicel(1,9)>¡Pues luego me paso! ¡Qué hype!"
msgstr ""

#. en: <$voicel(1,7)><$motion(1,805)><$facial(1,4)><$comeff(1,6)>Are you headed off to somewhere cool today? I wanna go<br>too, yo! Can I go too?!
msgctxt "1959:905"
msgid "<$voicel(1,7)><$motion(1,805)><$facial(1,4)><$comeff(1,6)>¿Te vas de excursión? ¡Qué pasada! ¿Me puedo acoplar?"
msgstr "<$voicel(1,7)><$motion(1,805)><$facial(1,4)><$comeff(1,6)>¿Te vas de excursión? ¡Qué genial! ¿Me puedo unir?"

#. en: <$voicel(1,7)><$motion(1,803)><$comeff(1,10)>Aww, OK! Have fun, yo!
msgctxt "1959:906"
msgid "<$voicel(1,7)><$motion(1,803)><$comeff(1,10)>¡Ok! ¡Pásalo bien!"
msgstr "<$voicel(1,7)><$motion(1,803)><$comeff(1,10)>¡Ok! ¡Pásala bien!"

#. en: <$voicel(1,9)><$emotion(1,8)>Yooo! That was so much fun! Thanks for takin’ me with you.<br><$voicel(1,8)><$motion(1,803)><$comeff(1,10)>I hope we can go somewhere together again sometime!
msgctxt "1959:907"
msgid "<$voicel(1,9)><$emotion(1,8)>¡Ha sido la leche! ¡Gracias por llevarme contigo, tí<gen;-2(o,a)>!<br><$voicel(1,8)><$motion(1,803)><$comeff(1,10)>¡Habrá que repetir!"
msgstr "<$voicel(1,9)><$emotion(1,8)>¡Fue increíble! ¡Gracias por llevarme contigo, amig<gen;-2(o,a)>!<br><$voicel(1,8)><$motion(1,803)><$comeff(1,10)>¡Habrá que repetir!"

#. en: <oneline><$comeff(1,10)><$motionoff(1,804)><$voicel(1,9)>Hey, <$cdef(27)><pname;0></color>! What’s up? <$comeff(1,6)>Do you<br>remember<slide><br>me?<slide><br><$motion(1,666)><$voicel(1,8)>I’m<slide><br><$cdef(27)><nowner;2></color>’s friend!<clear><br><$comeff(1,3)><$motion(1,806)><$voicel(1,10)>I’ve come to hang out, yo!<clear><br><$comeff(1,14)><$motion(1,805)><$voicel(1,7)>So you live around here, huh? <$comeff(1,9)><$motion(1,801)><$voicel(1,10)>It’s a pretty cool place!
msgctxt "1959:921"
msgid "<oneline><$comeff(1,10)><$motionoff(1,804)><$voicel(1,9)>¡Holi, <$cdef(27)><pname;0></color>! ¡He venido a verte!<clear><br><$motion(1,666)><$voicel(1,8)>Soy colega de <$cdef(27)><nowner;2></color>, <$comeff(1,6)>¿te acuerdas?<br><$comeff(1,3)><$motion(1,806)><$voicel(1,10)>Menudo viajecito<slide><br>me he pegado para llegar hasta aquí.<clear><br><$comeff(1,14)><$motion(1,805)><$voicel(1,7)>Entonces vives por esta zona, ¿no? <$comeff(1,9)><$motion(1,801)><$voicel(1,10)>¡Qué buen sitio!"
msgstr "<oneline><$comeff(1,10)><$motionoff(1,804)><$voicel(1,9)>¡Holi, <$cdef(27)><pname;0></color>! ¡Vine a verte!<clear><br><$motion(1,666)><$voicel(1,8)>Soy compa de <$cdef(27)><nowner;2></color>, <$comeff(1,6)>¿te acuerdas?<br><$comeff(1,3)><$motion(1,806)><$voicel(1,10)>Qué viajecito<slide><br>me tocó hacer para llegar hasta aquí.<clear><br><$comeff(1,14)><$motion(1,805)><$voicel(1,7)>Entonces vives por esta zona, ¿no? <$comeff(1,9)><$motion(1,801)><$voicel(1,10)>¡Qué buen lugar!"
