#. en: <oneline><$voicel(4,3)><$emotion(4,14)>Yooo! <$cdef(27)><pname;0></color>! I’ve been meanin’ to tell<br>you<slide><br>somethin’!
msgctxt "3561:0"
msgid "<oneline><$voicel(4,3)><$emotion(4,14)>¡<$cdef(27)><pname;0></color>! Mira, ven, que te explico<br>un poco<slide><br>de lore."
msgstr ""

#. en: <$voicel(4,7)><$emotion(4,39)>Did you know that the humans could make houses for<br>living UNDERWATER?!
msgctxt "3561:1"
msgid "<$voicel(4,7)><$emotion(4,39)>¿Sabías que los humanos podían construir casas para vivir<br>hasta debajo del agua? ¡Qué fantasía!"
msgstr ""

#. en: <$voicel(4,5)><$motion(4,827)><$comeff(4,5)>I’m bein’ serious, yo! They looked just like <$cdef(27)><$cname(572)></color>!<clear><br><$voicel(4,9)><$emotion(4,14)>So, like...I bet <$cdef(27)><$cname(572)> </color>would know how to make ’em!
msgctxt "3561:2"
msgid "<$voicel(4,5)><$motion(4,827)><$comeff(4,5)>¡Que sí, que no te estoy troleando! Literal que tenían<br>forma de <$cdef(27)><$cname(572)></color>.<clear><br><$voicel(4,9)><$emotion(4,14)>Si diéramos con un <$cdef(27)><$cname(572)></color>, podríamos preguntarle si<br>sabe cómo se construyen, me da a mí."
msgstr "<$voicel(4,5)><$motion(4,827)><$comeff(4,5)>¡Que sí, que no te estoy troleando! Literal que tenían<br>forma de <$cdef(27)><$cname(572)></color>.<clear><br><$voicel(4,9)><$emotion(4,14)>Si diéramos con un <$cdef(27)><$cname(572)></color>, podríamos preguntarle si<br>sabe cómo se construyen, creo yo."

#. en: <$voicel(4,5)><$emotion(4,38)>I’d love to help make one if you can figure out how!<clear><br><$voicel(4,7)><$motion(4,644)><$comeff(4,3)><$facial(4,7)>You maybe wouldn’t guess it by lookin’ at me, but I’m<br>actually pretty good at makin’ stuff!
msgctxt "3561:3"
msgid "<$cdef(27)><$voicel(4,5)></color><$emotion(4,38)>Si te enteras de cómo va la cosa, me molaría probar<br>a construir una contigo.<clear><br><$voicel(4,7)><$motion(4,644)><$comeff(4,3)><$facial(4,7)>Aunque no lo parezca, me lo curro que flipas con estas<br>pinzas."
msgstr "<$cdef(27)><$voicel(4,5)></color><$emotion(4,38)>Si te enteras de cómo va la cosa, me encantaría intentar<br>construir una contigo.<clear><br><$voicel(4,7)><$motion(4,644)><$comeff(4,3)><$facial(4,7)>Aunque no lo parezca, hago maravillas con estas<br>pinzas."

#. en: <$voicel(4,3)><$emotion(4,27)>But uh... For now, I guess just try to find <$cdef(27)><$cname(572)></color>, yo!
msgctxt "3561:4"
msgid "<$voicel(4,3)><$emotion(4,27)>Pero bueno, antes de nada, tienes que encontrar a algún<br><$cdef(27)><$cname(572)></color> de verdad."
msgstr ""

#. en: <$voicel(4,3)><$emotion(4,13)>I bet <$cdef(27)><$cname(572)> </color>would know how to make an underwater<br>house, yo!
msgctxt "3561:13"
msgid "<$voicel(4,3)><$emotion(4,13)>Fijo que un <$cdef(27)><$cname(572)></color> sabría cómo construir casas debajo<br>del agua, te lo digo yo."
msgstr "<$voicel(4,3)><$emotion(4,13)>Seguro que un <$cdef(27)><$cname(572)></color> sabría cómo construir casas debajo<br>del agua, te lo digo yo."

#. en: <$voicel(4,2)><$emotion(4,66)><$facial(4,9)><$cdef(27)><$cname(572)> </color>didn’t know how to make one, huh... <wait(1.2)><$voicel(4,10)><$facial(4,4)>But they<br>gave us SOME good info, at least!
msgctxt "3561:19"
msgid "<$voicel(4,2)><$emotion(4,66)><$facial(4,9)>Así que <$cdef(27)><$cname(572)> </color>no sabe cómo construir casas debajo<br>del agua, ¿eh? <wait(1.2)>Pues qué fail...<clear><br><$voicel(4,10)><$facial(4,4)>¡Pero al menos hemos obtenido buena info!"
msgstr "<$voicel(4,2)><$emotion(4,66)><$facial(4,9)>Así que <$cdef(27)><$cname(572)> </color>no sabe cómo construir casas debajo<br>del agua, ¿eh? <wait(1.2)>Pues qué fail...<clear><br><$voicel(4,10)><$facial(4,4)>¡Pero al menos obtuvimos buena info!"

#. en: <oneline><$voicel(4,7)><$emotion(4,14)>You gotta check out that cave, <$cdef(27)><pname;0></color>!
msgctxt "3561:20"
msgid "<$voicel(4,7)><$emotion(4,14)>Ya qué estás, ¿qué tal si vas a la cueva?"
msgstr ""

#. en: <$voicel(4,4)><$emotion(4,16)>You wanna know how to make a house that looks just like<br>me?<wait(1.2)> <$voicel(4,8)><$emotion(4,38)>Hahaha! That’s an interesting idea, bud! But, uh...<clear><br><$voicel(4,6)><$facial(4,4)><$comeff(4,9)>I have no idea how to do that!
msgctxt "3561:26"
msgid "<$voicel(4,4)><$emotion(4,16)>¿Casas con un careto como el mío, dices? <wait(1.2)><$voicel(4,8)><$emotion(4,38)>Ja, ja, ¡pero<br>qué ocurrencias tan graciosas tienes, niñ<gen;-2(o,a)>!<clear><br><$voicel(4,6)><$facial(4,4)><$comeff(4,9)>Que me parta un rayo si he visto algo así."
msgstr "<$voicel(4,4)><$emotion(4,16)>¿Casas con una cara como la mía, dices? <wait(1.2)><$voicel(4,8)><$emotion(4,38)>Ja, ja, ¡pero<br>qué ocurrencias tan graciosas tienes, niñ<gen;-2(o,a)>!<clear><br><$voicel(4,6)><$facial(4,4)><$comeff(4,9)>Que me parta un rayo si he visto algo así."

#. en: <$voicel(4,1)><$emotion(4,66)>Hang on a sec! Don’t get all sad on me just yet.<br>Hmmm... Ah-ha!
msgctxt "3561:27"
msgid "<$voicel(4,1)><$emotion(4,66)>Anda, anda, no pongas esa cara tan larga. A ver... <wait(1.0)>¡Ya sé!"
msgstr "<$voicel(4,1)><$emotion(4,66)>Vamos, vamos, no pongas esa cara tan larga. A ver... <wait(1.0)>¡Ya sé!"

#. en: <$voicel(4,6)><$comeff(4,3)>There’s a cave over that way, right?<clear><br><$voicel(4,7)><$comeff(4,10)>Sometimes you can find stuff the humans made lyin’<br>around in places like that!
msgctxt "3561:28"
msgid "<$voicel(4,6)><$comeff(4,3)>¿Ves la cueva en aquella dirección?<clear><br><$voicel(4,7)><$comeff(4,10)>Pues en sitios así se pueden hallar a veces cachivaches y<br>demás cosas rarunas de las que empleaban los humanos."
msgstr "<$voicel(4,6)><$comeff(4,3)>¿Ves la cueva en aquella dirección?<clear><br><$voicel(4,7)><$comeff(4,10)>Pues en lugares así se pueden hallar a veces cachivaches y<br>demás cosas raras de las que empleaban los humanos."

#. en: <$voicel(4,5)><$emotion(4,65)>I bet you could find a clue or somethin’ in that cave!
msgctxt "3561:29"
msgid "<$voicel(4,5)><$emotion(4,65)>Quién sabe, a lo mejor das con alguna pista allí."
msgstr "<$voicel(4,5)><$emotion(4,65)>Quién sabe, a lo mejor das con alguna pista allá."

#. en: <$voicel(4,3)><$emotion(4,29)>You figure out how to make that house that looks just like<br>me yet?
msgctxt "3561:35"
msgid "<$voicel(4,3)><$emotion(4,29)>¿Has aprendido ya a construir una casa con mis pintas?"
msgstr "<$voicel(4,3)><$emotion(4,29)>¿Ya aprendiste a construir una casa con mi aspecto?"

#. en: <$voicel(4,5)><$emotion(4,65)>I bet you could find a clue or somethin’ in that cave!
msgctxt "3561:36"
msgid "<$voicel(4,5)><$emotion(4,65)>A lo mejor das con alguna pista en la cueva esa."
msgstr ""

#. en: <$voicel(4,4)><$emotion(4,16)>You wanna know how to make a house that looks just like<br>me? <wait(1.2)><$voicel(4,8)><$emotion(4,38)>Hahaha! That’s an interesting idea, bud! But, uh...<clear><br><$voicel(4,6)><$facial(4,4)><$comeff(4,9)>I have no idea how to do that!
msgctxt "3561:41"
msgid "<$voicel(4,4)><$emotion(4,16)>¿Casas con un careto como el mío, dices? <wait(1.2)><$voicel(4,8)><$emotion(4,38)>Ja, ja, ¡pero<br>qué ocurrencias tan graciosas tienes, niñ<gen;-2(o,a)>!<clear><br><$voicel(4,6)><$facial(4,4)><$comeff(4,9)>Que me parta un rayo si he visto algo así."
msgstr "<$voicel(4,4)><$emotion(4,16)>¿Casas con una cara como la mía, dices? <wait(1.2)><$voicel(4,8)><$emotion(4,38)>Ja, ja, ¡pero<br>qué ocurrencias tan graciosas tienes, niñ<gen;-2(o,a)>!<clear><br><$voicel(4,6)><$facial(4,4)><$comeff(4,9)>Que me parta un rayo si he visto algo así."

#. en: <$voicel(4,7)><$emotion(4,65)>Hold up just one second... What about that<br><$cdef(27)><fqty(1)><$ifull(516)> </color>ya got there? <$voicel(4,4)><$comeff(4,6)>I bet that’d help ya make<slide><br>what you’re lookin’ to make!
msgctxt "3561:42"
msgid "<$voicel(4,4)><$comeff(4,6)>¿Y eso? ¿Un <$cdef(27)><fqty(1)><$ifull(516)></color>? <wait(1.0)><$voicel(4,7)><$emotion(4,65)>Corrígeme si<br>me equivoco, pero con eso podrías construirla, ¿no crees?"
msgstr ""

#. en: <$voicel(4,9)><$emotion(4,40)>You know <$cdef(27)><$cname(573)></color>? You should get ’em to help ya!<br><$voicel(4,6)><$facial(4,4)><$comeff(4,10)><$motion(4,806)>They’re surprisingly good at makin’ things, y’know.
msgctxt "3561:43"
msgid "<$voicel(4,9)><$emotion(4,40)>Si conoces a algún <$cdef(27)><$cname(573)></color>, aprovecha pa que te eche<br>una pinza... <wait(1.0)><$voicel(4,6)><$facial(4,4)><$comeff(4,10)><$motion(4,806)>¡No veas lo bien que se les da construir cosas!"
msgstr "<$voicel(4,9)><$emotion(4,40)>Si conoces a algún <$cdef(27)><$cname(573)></color>, aprovecha pa que te eche<br>una pinza... <wait(1.0)><$voicel(4,6)><$facial(4,4)><$comeff(4,10)><$motion(4,806)>¡No sabes lo bien que se les da construir cosas!"

#. en: <$voicel(4,7)><$emotion(4,65)>Hm? Is that <$cdef(27)><fqty(1)><$ifull(516)> </color>what you were lookin’ for?<clear><br><$voicel(4,6)><$emotion(4,38)>I bet you could use it to make that house with help from<br><$cdef(27)><$cname(573)> </color>or other Pokémon who’re good at makin’ stuff!
msgctxt "3561:49"
msgid "<$voicel(4,7)><$emotion(4,65)>¿Ese <$cdef(27)><fqty(1)><$ifull(516)> </color>es lo que andabas<br>buscando?<clear><br><$voicel(4,6)><$emotion(4,38)>Pues si conoces a algún <$cdef(27)><$cname(573)></color>, aprovecha pa que te<br>ayude a construirlo, que son muy apañaos."
msgstr "<$voicel(4,7)><$emotion(4,65)>¿Ese <$cdef(27)><fqty(1)><$ifull(516)> </color>es lo que andabas<br>buscando?<clear><br><$voicel(4,6)><$emotion(4,38)>Pues si conoces a algún <$cdef(27)><$cname(573)></color>, aprovecha pa que te<br>ayude a construirlo, que son muy habilidosos."

#. en: <oneline><$voicel(4,7)><$emotion(4,65)><$cdef(27)><pname;0></color>! Yooo! You found a<br><$cdef(27)><fqty(1)><$ifull(516)></color>?!<clear><br><$voicel(4,9)><$emotion(4,40)>I bet we could make a <$cdef(27)><$cname(572)></color>-y house with that!
msgctxt "3561:55"
msgid "<$voicel(4,9)><$emotion(4,40)>¡Qué heavyyy! ¡Un <$cdef(27)><fqty(1)><$ifull(516)></color>!<br>¡Choca esas pinzas, <$cdef(27)><pname;0></color>!<clear><br><$voicel(4,7)><$emotion(4,65)>Digo yo que con esto podremos construir una de esas<br>casas que son clavaditas a un <$cdef(27)><$cname(572)></color>, ¿que no?"
msgstr "<$voicel(4,9)><$emotion(4,40)>¡Qué geniaaal! ¡Un <$cdef(27)><fqty(1)><$ifull(516)></color>!<br>¡Choca esas pinzas, <$cdef(27)><pname;0></color>!<clear><br><$voicel(4,7)><$emotion(4,65)>Digo yo que con esto podremos construir una de esas<br>casas que son clavaditas a un <$cdef(27)><$cname(572)></color>, ¿no?"

#. en: <$voicel(4,5)><$motion(4,814)><$facial(4,4)><$comeff(4,10)>Lemme know when you’re ready to <$cdef(27)><$spwfull(1)></color>! I can totally<br>help ya!
msgctxt "3561:56"
msgid "<$voicel(4,5)><$motion(4,814)><$facial(4,4)><$comeff(4,10)>Venga, que yo te ayudo a <$cdef(27)>construirla</color><nbs2><$spwicon(1)>."
msgstr "<$voicel(4,5)><$motion(4,814)><$facial(4,4)><$comeff(4,10)>Vamos, que yo te ayudo a <$cdef(27)>construirla</color><nbs2><$spwicon(1)>."

#. en: <oneline><$voicel(4,3)><$emotion(4,14)>Yooo! <$cdef(27)><pname;0></color>! I’ve been meanin’ to tell<br>you<slide><br>somethin’!
msgctxt "3561:62"
msgid "<oneline><$voicel(4,3)><$emotion(4,14)>¡<$cdef(27)><pname;0></color>! Mira, ven, que te explico<br>un poco<slide><br>de lore."
msgstr ""

#. en: <$voicel(4,7)><$emotion(4,39)>Did you know that the humans could make houses for<br>living UNDERWATER?!
msgctxt "3561:63"
msgid "<$voicel(4,7)><$emotion(4,39)>¿Sabías que los humanos podían construir casas para vivir<br>hasta debajo del agua? ¡Qué fantasía!"
msgstr ""

#. en: <$voicel(4,5)><$motion(4,827)><$comeff(4,5)>I’m bein’ serious, yo! They looked just like <$cdef(27)><$cname(572)></color>!
msgctxt "3561:64"
msgid "<$voicel(4,5)><$motion(4,827)><$comeff(4,5)>Que sí, ¡que no te estoy troleando! Literal que tenían<br>forma de <$cdef(27)><$cname(572)></color>."
msgstr ""

#. en: <$voicel(4,7)><$emotion(4,14)>They were big and solid like metal and had, like, a<br>propeller or somethin’ on the back and...
msgctxt "3561:65"
msgid "<$voicel(4,7)><$emotion(4,14)>¡Eran enormes y más duras que una roca! Ah, y detrás<br>tenían una especie de ventilador o algo así..."
msgstr ""

#. en: <$voicel(4,9)><$facial(4,4)><$comeff(4,10)><$motion(4,814)>Yooo! Yeah! That’s EXACTLY what we need to make one of<br>those houses!<clear><br><$voicel(4,7)><$comeff(4,9)>And ya didn’t even need my help to find it! You’re so cool,<br><$cdef(27)><pname;0></color>.
msgctxt "3561:66"
msgid "<oneline><$voicel(4,9)><$facial(4,4)><$comeff(4,10)><$motion(4,814)>¡Ualaaa, eres la leche, <$cdef(27)><pname;0></color>!<br><wait(1.0)><$voicel(4,7)><$comeff(4,9)>Ni ha hecho<slide><br>falta<slide><br>que te echara un cable."
msgstr "<oneline><$voicel(4,9)><$facial(4,4)><$comeff(4,10)><$motion(4,814)>¡Guaaau, eres lo máximo, <$cdef(27)><pname;0></color>!<br><wait(1.0)><$voicel(4,7)><$comeff(4,9)>Ni hizo<slide><br>falta<slide><br>que te echara una mano."

#. en: <$voicel(4,9)><$facial(4,4)><$comeff(4,10)><$motion(4,814)>Yooo! Yeah! That’s EXACTLY what we need to make one of<br>those houses!<clear><br><$voicel(4,7)><$comeff(4,9)>And ya didn’t even need my help to find it! You’re so cool,<br><$cdef(27)><pname;0></color>.
msgctxt "3561:67"
msgid "<oneline><$voicel(4,9)><$facial(4,4)><$comeff(4,10)><$motion(4,814)>¡Ualaaa, eres la leche, <$cdef(27)><pname;0></color>!<br><wait(1.0)><$voicel(4,7)><$comeff(4,9)>Ni ha hecho<slide><br>falta<slide><br>que te echara un cable."
msgstr "<oneline><$voicel(4,9)><$facial(4,4)><$comeff(4,10)><$motion(4,814)>¡Guaaau, eres lo máximo, <$cdef(27)><pname;0></color>!<br><wait(1.0)><$voicel(4,7)><$comeff(4,9)>Ni hizo<slide><br>falta<slide><br>que te echara una mano."

#. en: <oneline><$voicel(4,3)><$emotion(4,29)><$cdef(27)><pname;0></color>! You ready to build a house<br>usin’<slide><br>that<slide><br><$cdef(27)><fqty(1)><$ifull(516)></color>?
msgctxt "3561:73"
msgid "<oneline><$voicel(4,3)><$emotion(4,29)>¿Qué te parece si nos ponemos pinzas a la obra con<br>el <$cdef(27)><fqty(1)><$ifull(516)></color>,<slide><br><$cdef(27)><pname;0></color>?"
msgstr ""

#. en: <$voicel(4,9)><$facial(4,4)><$comeff(4,10)><$motion(4,814)>I’ll totally help you do it! C’mon, let’s get to buildin’!
msgctxt "3561:75"
msgid "<$voicel(4,9)><$facial(4,4)><$comeff(4,10)><$motion(4,814)>¡Déjame que te ayude, porfaplís!"
msgstr ""

#. en: <$voicel(4,9)><$facial(4,4)><$comeff(4,10)><$motion(4,814)>We’re gonna make a house with that <$cdef(27)><fqty(1)><$ifull(516)></color>!
msgctxt "3561:85"
msgid "<$voicel(4,9)><$facial(4,4)><$comeff(4,10)><$motion(4,814)>¡Venga, que ese <$cdef(27)><fqty(1)><$ifull(516)></color> no se va<br>a construir solo!"
msgstr "<$voicel(4,9)><$facial(4,4)><$comeff(4,10)><$motion(4,814)>¡Vamos, que ese <$cdef(27)><fqty(1)><$ifull(516)></color> no se va<br>a construir solo!"

#. en: <$voicel(4,7)><$motion(4,802)><$facial(4,4)><$comeff(4,10)>The <$cdef(27)><$spwfull(1)></color>’s goin’ well, yo!
msgctxt "3561:92"
msgid "<$voicel(4,7)><$motion(4,802)><$facial(4,4)><$comeff(4,10)>La <$cdef(27)>construcción</color><nbs2><$spwicon(1)> va de lujo."
msgstr ""

#. en: <$voicel(4,9)><$facial(4,4)><$comeff(4,9)><$motion(4,814)>It’ll probably take a little while longer to finish. I’m excited<br>to see how it turns out!
msgctxt "3561:93"
msgid "<$voicel(4,9)><$facial(4,4)><$comeff(4,9)><$motion(4,814)>Ya te avisaré cuando esté, tranqui. ¡Anda que no tengo<br>ganas de finiquitarla para ver cómo queda!"
msgstr "<$voicel(4,9)><$facial(4,4)><$comeff(4,9)><$motion(4,814)>Ya te avisaré cuando esté, tranqui. ¡Tengo muchísimas<br>ganas de terminarla para ver cómo queda!"

#. en: <$voicel(4,5)><$facial(4,4)><$comeff(4,10)><$motion(4,666)>Thanks so much, <$cdef(27)><pname;0></color>!<clear><br><$voicel(4,7)><$emotion(4,27)>The <$cdef(27)><$cname(572)></color>-y house is super awesome!
msgctxt "3561:100"
msgid "<$voicel(4,5)><$facial(4,4)><$comeff(4,10)><$motion(4,666)>¡Muchas gracias, bestie! <wait(1.0)><$voicel(4,7)><$emotion(4,27)>La casa al estilo <$cdef(27)><$cname(572)> </color>es<br>cremita de la buena."
msgstr "<$voicel(4,5)><$facial(4,4)><$comeff(4,10)><$motion(4,666)>¡Muchas gracias, bestie! <wait(1.0)><$voicel(4,7)><$emotion(4,27)>La casa al estilo <$cdef(27)><$cname(572)> </color>es<br>increíble."

#. en: <$voicel(4,4)><$emotion(4,39)>It sure is nice to see new stuff get built around here!
msgctxt "3561:101"
msgid "<$voicel(4,4)><$emotion(4,39)>¡Anda que no mola construir cosas! Es mi nueva obsesión."
msgstr "<$voicel(4,4)><$emotion(4,39)>¡Me encanta construir cosas! Es mi nueva obsesión."

#. en: <$voicel(4,9)><$facial(4,4)><$comeff(4,9)><$motion(4,814)>Oooh! I dunno, but I’m here for it, yo! I’ll help in any way<br>I can!
msgctxt "3561:102"
