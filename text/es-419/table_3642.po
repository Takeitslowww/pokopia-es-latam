#. en: <$emotion(2,13)><$voicel(2,4)>That Pokémon loves to explore!
msgctxt "3642:0"
msgid "<$emotion(2,13)><$voicel(2,4)>A ella le encantaba explorar..."
msgstr ""

#. en: <$voicel(2,7)>Maybe they’re in the cave back there or something? It<br>looks like a fun place to explore!
msgctxt "3642:1"
msgid "<$voicel(2,7)>¿Y si está en aquella cueva de allí? ¡Parece buen lugar<br>para explorar!"
msgstr "<$voicel(2,7)>¿Y si está en aquella cueva de allá? ¡Parece buen lugar<br>para explorar!"

#. en: <$voicel(2,10)><$facial(2,5)><$motion(2,661)><$comeff(2,21)>Oooh, you met <$cdef(27)><$cname(580)></color>? YAY! If they need anything, make<br>sure to help ’em out!
msgctxt "3642:8"
msgid "<$voicel(2,10)><$facial(2,5)><$motion(2,661)><$comeff(2,21)>¡Oh, oh, oooh! ¡Qué chachi que hayas encontrado<br>a <$cdef(27)><$cname(580)></color>! Si necesita ayuda, échale una manitaaa."
msgstr "<$voicel(2,10)><$facial(2,5)><$motion(2,661)><$comeff(2,21)>¡Oh, oh, oooh! ¡Qué genial que hayas encontrado<br>a <$cdef(27)><$cname(580)></color>! Si necesita ayuda, échale una manitaaa."

#. en: <$voicel(2,10)><$facial(2,5)><$motion(2,668)><$comeff(2,9)>You went exploring with <$cdef(27)><$cname(580)></color>? That sounds SO FUN!<wait(2.3)> <$voicel(2,4)><$facial(2,2)><$motion(2,805)><$comeff(2,14)>If<br>they’ve still got any problems, <$voicel(2,10)><$facial(2,4)><$motion(2,661)><$comeff(2,10)>make sure to hear ’em out!
msgctxt "3642:14"
msgid "<$voicel(2,10)><$facial(2,5)><$motion(2,668)><$comeff(2,9)>¿Te has ido a explorar con <$cdef(27)><$cname(580)></color>? ¡Halaaa, qué chuli!<clear><br><$voicel(2,4)><$facial(2,2)><$motion(2,805)><$comeff(2,14)>Si ves que necesita alguna otra cosa, ayúdala, ¿vale?<br><$cdef(27)><wait(1.0)></color><$voicel(2,10)><$facial(2,4)><$motion(2,661)><$comeff(2,10)>¡Gracias, graciaaas!"
msgstr "<$voicel(2,10)><$facial(2,5)><$motion(2,668)><$comeff(2,9)>¿Fuiste a explorar con <$cdef(27)><$cname(580)></color>? ¡Guaaau, qué genial!<clear><br><$voicel(2,4)><$facial(2,2)><$motion(2,805)><$comeff(2,14)>Si ves que necesita alguna otra cosa, ayúdala, ¿sí?<br><$cdef(27)><wait(1.0)></color><$voicel(2,10)><$facial(2,4)><$motion(2,661)><$comeff(2,10)>¡Gracias, graciaaas!"
